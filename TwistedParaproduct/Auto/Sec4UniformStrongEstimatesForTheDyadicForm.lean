private theorem restricted_when_tester_is_smallest {d : ℕ} (hd : 2 ≤ d)
    (t : Option (Fin d) → ℝ) (ht : ∀ i, 0 < t i) (hs : ∑ i, t i = 1)
    {m K : ℝ} (hm : 0 < m) (hmt : ∀ i, m ≤ t (some i)) (hK : 1 < K) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (b : Fin d) (u : ℤ) (T : ℕ) (c : ℕ → ℝ) (_ : ∀ k, |c k| ≤ 1)
      (A : Option (Fin d) → Set (Fin d → ℝ)) (f : Option (Fin d) → (Fin d → ℝ) → ℝ),
      DyadicSupported A f → 0 < volume.real (A none) →
      (∀ i : Fin d, volume.real (A none) ≤ volume.real (A (some i))) →
      |dyadicForm b u T c (f none) (fun i => f (some i))| ≤
        (C + d*K^(-m)*dyadicFormConstant b u T t) * dyadicSupportWeight t A := by
  classical
  let q := 2 + 2/m
  have hq : 1 < q := by dsimp [q]; linarith [div_pos (by norm_num : (0:ℝ) < 2) hm]
  have hqm : 1/q < m := by
    apply (div_lt_iff₀ (by linarith : 0 < q)).mpr
    have h : m * (2/m) = 2 := by field_simp
    dsimp [q]
    rw [mul_add, h]
    linarith
  obtain ⟨B, hB, hScale⟩ := choose_recording_scale d hqm
  let C₁ := (3 : ℝ)^(d-1) * (6 + 2 * (3 * ((d-1 : ℕ) : ℝ) + 1) *
      recordingVariationConstant q) + (2 + ((d-1 : ℕ) : ℝ) * recordingVariationConstant q)
  have hC₁ : 0 ≤ C₁ := by dsimp [C₁]; positivity [recordingVariationConstant_pos q]
  let C₂ := (2:ℝ)^d * (2*residualBoundConstant d K)
  have hResC : 0 ≤ residualBoundConstant d K := zero_le_one.trans (residualBoundConstant_ge_one d K)
  have hC₂ : 0 ≤ C₂ := by dsimp [C₂]; positivity
  refine ⟨C₁*B+C₂, by positivity, ?_⟩
  intro b u T c hc A f hf hh ha
  let h := (volume : Measure (Fin d → ℝ)).real (A none)
  let a (i : Fin d) := (volume : Measure (Fin d → ℝ)).real (A (some i))
  let r (i : Fin d) := a i / h
  let R := Finset.univ.sup' ⟨b, Finset.mem_univ _⟩ r
  have hr i : 1 ≤ r i := (one_le_div hh).mpr (ha i)
  have hrR i : r i ≤ R := Finset.le_sup' r (Finset.mem_univ i)
  have hR : 1 ≤ R := (hr b).trans (hrR b)
  have hArea (i : Fin d) : a i ≤ R*h := (div_le_iff₀ hh).mp (hrR i)
  have hApos (i : Option (Fin d)) : 0 < volume.real (A i) := by
    cases i with
    | none => exact hh
    | some i => exact hh.trans_le (ha i)
  have hhW : h*R^m ≤ dyadicSupportWeight t A := by
    have hfact : dyadicSupportWeight t A = h * ∏ i : Fin d, r i ^ t (some i) := by
      let r' (i : Option (Fin d)) := i.elim 1 r
      have hv (i : Option (Fin d)) : volume.real (A i) = h*r' i := by
        cases i with
        | none => simp [r', h]
        | some i =>
          change a i = h*(a i/h)
          rw [← mul_div_assoc, mul_comm h, mul_div_cancel_right₀ _ (show h ≠ 0 from hh.ne')]
      have hr' (i : Option (Fin d)) : 0 ≤ r' i := by
        cases i with
        | none => exact zero_le_one
        | some i => exact zero_le_one.trans (hr i)
      have hvpow (i : Option (Fin d)) : volume.real (A i) ^ t i = h ^ t i * r' i ^ t i := by
        rw [hv i, Real.mul_rpow hh.le (hr' i)]
      unfold dyadicSupportWeight
      simp_rw [hvpow]
      rw [Finset.prod_mul_distrib, ← Real.rpow_sum_of_pos hh, hs, Real.rpow_one, Fintype.prod_option]
      simp [r', h]
    obtain ⟨j, _, hj⟩ := Finset.exists_mem_eq_sup' ⟨b, Finset.mem_univ b⟩ r
    rw [hfact]
    refine mul_le_mul_of_nonneg_left ?_ hh.le
    rw [show R = r j from hj]
    apply (Real.rpow_le_rpow_of_exponent_le (hr j) (hmt j)).trans
    rw [← Finset.prod_singleton (f := fun i => r i ^ t (some i))]
    apply Finset.prod_le_prod_of_subset_of_one_le₀ (Finset.subset_univ _)
    · exact fun i _ => Real.rpow_nonneg (zero_le_one.trans (hr i)) _
    · exact fun i _ _ => Real.one_le_rpow (hr i) (ht (some i)).le
  have hhW' : h ≤ dyadicSupportWeight t A :=
    (le_mul_of_one_le_right hh.le (Real.one_le_rpow hR hm.le)).trans hhW
  obtain ⟨N, _, hSmall, hPoly⟩ := hScale hR
  let δ := ((2:ℝ)^N)⁻¹
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hδ1 : δ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ (by norm_num))
  let τ (i : Fin d) := K*h/a i
  let G (i : Fin d) := prunedInput i (A none) (τ i) (f (some i))
  let H := f none
  obtain ⟨hG, hPrune⟩ := prune b u T c hc t ht hs hf hK hmt hh (fun j => hApos (some j))
  change DyadicSupported A (fun i => i.elim H G) at hG
  have hHs := lpNorm_le_of_indicator (hG none).1 (hG none).2.1 (hG none).2.2.1
    (hG none).2.2.2.1 (hG none).2.2.2.2 (p := 1) (by norm_num)
  have hHp : MemLp H (ENNReal.ofReal 1) volume := hHs.1
  have hHI : Integrable H := memLp_one_iff_integrable.mp
    (by simpa only [ENNReal.ofReal_one] using hHp)
  have hCG (i : Fin d) (x : Fin d → ℝ) : |G i x| ≤ 1 := by
    have hn : 0 ≤ G i x := (hG (some i)).2.2.2.1 x
    rw [abs_of_nonneg hn]
    exact ((hG (some i)).2.2.2.2 x).trans (by by_cases hx : x ∈ A (some i) <;> simp [hx])
  have hExp := pruned_recording_expansion b u T c (A none) τ hδ.le H (fun i => f (some i))
    hHI (fun i => (hf (some i)).2.2.1) hCG (hG none).1
  dsimp only at hExp
  let Y := coordinateMartingalePath b u 0 c (G b)
  let F (x : Fin d → ℝ) := H x * pathPairing
    (fun k => ∏ i : {i : Fin d // i ≠ b}, recordedPath (coordinateLowPath i u (G i)) δ true k x)
    (fun k => Y k x) T
  let I := ({b} : Finset (Fin d))ᶜ
  let H' := pruningTester u T (A none) τ H
  let J (D : Finset (Fin d)) := maskedMixedDyadicForm b u T c H' G δ D
  change dyadicForm b u T c H G = (∫ x, F x) +
    ∑ D ∈ I.powerset.erase ∅, (-1:ℝ)^(D.card+1)*J D at hExp
  have hCoarse := (allCoarse hd b u T N c hc hq (fun i => A (some i))
    (hG none).1 (hG none).2.1 (fun i => (hG (some i)).1) (fun i => (hG (some i)).2.1)
    G H (fun i => (hG (some i)).2.2.1) (fun i => (hG (some i)).2.2.2.1)
    (fun i => (hG (some i)).2.2.2.2) (hG none).2.2.1 (hG none).2.2.2.1
    (hG none).2.2.2.2 hh hR hArea).2
  have hMain : |∫ x, F x| ≤ (C₁*B) * dyadicSupportWeight t A := by
    change |∫ x, F x| ≤ C₁*((N+1 : ℕ) : ℝ)^d*h*R^(1/q) at hCoarse
    calc
      _ ≤ C₁*(h*(((N+1 : ℕ) : ℝ)^d * R^(1/q))) := hCoarse.trans_eq (by ring)
      _ ≤ C₁*(h*(B*R^m)) := mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hPoly hh.le) hC₁
      _ = (C₁*B)*(h*R^m) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hhW (mul_nonneg hC₁ hB)
  have hRsmall : (R*h)*δ^((1/2:ℝ)^d) ≤ h := by
    calc
      _ = (R*δ^((1/2:ℝ)^d))*h := by ring
      _ ≤ 1*h := mul_le_mul_of_nonneg_right hSmall hh.le
      _ = h := one_mul _
  have hJ (D : Finset (Fin d)) (hD : D ∈ I.powerset.erase ∅) :
      |(-1:ℝ)^(D.card+1)*J D| ≤ 2*residualBoundConstant d K*h := by
    have hDsub := Finset.mem_powerset.mp (Finset.mem_of_mem_erase hD)
    have hDb : b ∉ D := fun hb => by simpa [I] using hDsub hb
    have hDne : D.Nonempty := Finset.nonempty_iff_ne_empty.mpr (Finset.ne_of_mem_erase hD)
    have hVol (i : Option (Fin d)) : volume.real (A i) ≤ R*h := by
      cases i with
      | none => exact le_mul_of_one_le_left hh.le hR
      | some i => exact hArea i
    have hres := residual hd b u T c hc A H G hG hApos hVol (zero_lt_one.trans hK) hδ hδ1 D hDne hDb
    change |J D| ≤ residualBoundConstant d K * (h + R*h*δ^((1/2:ℝ)^d)) at hres
    rw [abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul]
    refine hres.trans ((mul_le_mul_of_nonneg_left (add_le_add le_rfl hRsmall) hResC).trans_eq ?_)
    ring
  have hSum : |∑ D ∈ I.powerset.erase ∅, (-1:ℝ)^(D.card+1)*J D| ≤
      C₂ * dyadicSupportWeight t A := by
    have hcard : (I.powerset.erase ∅).card ≤ 2^d := by
      refine (Finset.card_erase_le).trans ?_
      rw [Finset.card_powerset]
      exact Nat.pow_le_pow_right (by decide) (by simpa using Finset.card_le_univ I)
    refine (Finset.abs_sum_le_sum_abs _ _).trans ((Finset.sum_le_sum hJ).trans ?_)
    rw [Finset.sum_const, nsmul_eq_mul]
    calc
      _ ≤ (2:ℝ)^d * (2 * residualBoundConstant d K * h) :=
        mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) (by positivity)
      _ = C₂*h := by dsimp [C₂]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hhW' hC₂
  have hGood : |dyadicForm b u T c H G| ≤ (C₁*B+C₂)*dyadicSupportWeight t A := by
    rw [hExp]
    exact (abs_add_le _ _).trans ((add_le_add hMain hSum).trans_eq (by ring))
  have h := (abs_add_le (dyadicForm b u T c H (fun i => f (some i)) - dyadicForm b u T c H G)
    (dyadicForm b u T c H G)).trans (add_le_add hPrune hGood)
  rw [sub_add_cancel] at h
  exact h.trans_eq (by ring)

/-- Almost-everywhere equality on the product gives equality on almost every fiber. -/
theorem coordinateFiber_congr_ae {d : ℕ} {E : Type*} (i : Fin d)
    {f g : (Fin d → ℝ) → E} (h : f =ᵐ[volume] g) :
    ∀ᵐ x ∂volume, (fun y => f (Function.update x i y)) =ᵐ[volume]
      (fun y => g (Function.update x i y)) := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n+1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n+1) => ℝ) i).symm _
    have hcomp := he.quasiMeasurePreserving.ae h
    rw [Measure.volume_eq_prod] at hcomp
    have hsw := (Measure.measurePreserving_swap (μ := (volume : Measure (Fin n → ℝ)))
      (ν := (volume : Measure ℝ))).quasiMeasurePreserving.ae hcomp
    have hline := Measure.ae_ae_of_ae_prod hsw
    have hgood : ∀ᵐ z ∂(volume : Measure (ℝ × (Fin n → ℝ))),
        (fun y => f (Function.update (e z) i y)) =ᵐ[volume]
          (fun y => g (Function.update (e z) i y)) := by
      rw [Measure.volume_eq_prod]
      filter_upwards [(Measure.quasiMeasurePreserving_snd (μ := (volume : Measure ℝ))
        (ν := (volume : Measure (Fin n → ℝ)))).ae hline] with z hz
      rcases z with ⟨x,y⟩
      change (fun t => f (i.insertNth t y)) =ᵐ[volume] (fun t => g (i.insertNth t y)) at hz
      change (fun t => f (Function.update (i.insertNth x y) i t)) =ᵐ[volume]
        (fun t => g (Function.update (i.insertNth x y) i t))
      simpa only [Fin.update_insertNth, Fin.insertNth_apply_same] using hz
    filter_upwards [(he.symm e).quasiMeasurePreserving.ae hgood] with x hx
    simpa only [MeasurableEquiv.apply_symm_apply] using hx

private theorem coordinateAverage_ae_congr {d : ℕ} (i : Fin d)
    {f g : (Fin d → ℝ) → ℝ} (h : f =ᵐ[volume] g) :
    ∀ᵐ x ∂volume, ∀ k : ℤ, coordinateAverage i k f x = coordinateAverage i k g x := by
  filter_upwards [coordinateFiber_congr_ae i h] with x hx
  intro k
  unfold coordinateAverage
  rw [integral_congr_ae (ae_restrict_of_ae hx)]

private theorem coordinateAverage_mul_const {d : ℕ} (i : Fin d) (k : ℤ) (a : ℝ)
    (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ) :
    coordinateAverage i k (fun y => a*f y) x = a * coordinateAverage i k f x := by
  unfold coordinateAverage
  rw [integral_const_mul, mul_left_comm]

private theorem coordinateDifference_mul_const {d : ℕ} (i : Fin d) (k : ℤ) (a : ℝ)
    (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ) :
    coordinateDifference i k (fun y => a*f y) x = a * coordinateDifference i k f x := by
  simp only [coordinateDifference, coordinateAverage_mul_const, mul_sub]

private def balanceExceptional {d : ℕ} (i : Fin d) (A : Set (Fin d → ℝ)) (L h : ℝ) :
    Set (Fin d → ℝ) :=
  if (volume : Measure (Fin d → ℝ)).real A < h/L then
    pruningSet i A (L * volume.real A / h) else ∅

private theorem balanceExceptional_control {d : ℕ} (i : Fin d) {A : Set (Fin d → ℝ)}
    (hA : MeasurableSet A) (hAf : volume A ≠ ∞) (ha : 0 < volume.real A)
    {L h : ℝ} (hL : 1 ≤ L) (hh : 0 < h) :
    MeasurableSet (balanceExceptional i A L h) ∧ volume (balanceExceptional i A L h) ≠ ∞ ∧
      volume.real (balanceExceptional i A L h) ≤ h/L := by
  have hL₀ : 0 < L := zero_lt_one.trans_le hL
  unfold balanceExceptional
  split
  · let a := (volume : Measure (Fin d → ℝ)).real A
    let τ := L*a/h
    have hτ : 0 < τ := div_pos (mul_pos hL₀ ha) hh
    have hm := volume_pruningSet_le i hA hAf hτ
    have hf : (ENNReal.ofReal τ)⁻¹ * volume A ≠ ∞ :=
      ENNReal.mul_ne_top (ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hτ)) hAf
    have hr := ENNReal.toReal_mono hf hm
    rw [ENNReal.toReal_mul, ENNReal.toReal_inv, ENNReal.toReal_ofReal hτ.le] at hr
    refine ⟨measurableSet_coordinateMaxLevel i (measurable_const.indicator hA) _, 
      (hm.trans_lt hf.lt_top).ne, hr.trans_eq ?_⟩
    change (L*a/h)⁻¹ * a = h/L
    field_simp [ha.ne', hh.ne', hL₀.ne']
    exact div_self ha.ne'
  · simp [div_nonneg hh.le hL₀.le]

set_option maxHeartbeats 700000 in
private theorem balanceInput {d : ℕ} (i : Fin d) {A : Set (Fin d → ℝ)}
    (hA : MeasurableSet A) (hAf : volume A ≠ ∞) (ha : 0 < volume.real A)
    {f : (Fin d → ℝ) → ℝ} (hf : Measurable f) (hf₀ : ∀ x, 0 ≤ f x)
    (hf₁ : ∀ x, f x ≤ A.indicator (fun _ => 1) x)
    {L h t : ℝ} (hL : 1 ≤ L) (hh : 0 < h) (ht : 0 ≤ t) (ht₁ : t ≤ 1) :
    ∃ (B : Set (Fin d → ℝ)) (g : (Fin d → ℝ) → ℝ) (α : ℝ),
      MeasurableSet B ∧ volume B ≠ ∞ ∧ Measurable g ∧
      (∀ x, 0 ≤ g x) ∧ (∀ x, g x ≤ B.indicator (fun _ => 1) x) ∧
      0 < α ∧ h ≤ volume.real B ∧ α * (volume.real B)^t ≤ 2*L*(volume.real A)^t ∧
      (∀ᵐ x ∂volume, x ∉ balanceExceptional i A L h → ∀ k : ℤ,
        coordinateAverage i k f x = α * coordinateAverage i k g x ∧
          coordinateDifference i k f x = α * coordinateDifference i k g x) := by
  let a := (volume : Measure (Fin d → ℝ)).real A
  have hL₀ : 0 < L := zero_lt_one.trans_le hL
  have hL₂ : 1 ≤ 2*L := by linarith
  have hsmall : h/L ≤ h := div_le_self hh.le hL
  by_cases hst : a < h/L
  · let τ := L*a/h
    have hτ : 0 < τ := div_pos (mul_pos hL₀ ha) hh
    have hτ₁ : τ < 1 := by
      apply (div_lt_iff₀ hh).mpr
      simpa [mul_comm L] using (lt_div_iff₀ hL₀).mp hst
    let r := coordinateReplacement i A τ f
    let α := 2*τ
    have hα : 0 < α := by dsimp [α]; positivity
    obtain ⟨hr, hrb, hrV, hcoord⟩ := dyadicCz i hA hAf hτ hτ₁ hf hf₀ hf₁
    change Measurable r at hr
    change (∀ᵐ x ∂volume, 0 ≤ r x ∧ r x ≤ α) at hrb
    change volume {x | r x ≠ 0} ≤ (ENNReal.ofReal τ)⁻¹ * volume A at hrV
    let g (x : Fin d → ℝ) := if 0 ≤ r x ∧ r x ≤ α then r x / α else 0
    have hg : Measurable g := Measurable.ite
      ((measurableSet_le measurable_const hr).inter (measurableSet_le hr measurable_const))
      (hr.div_const _) measurable_const
    have hg₀ (x : Fin d → ℝ) : 0 ≤ g x := by
      dsimp [g]
      split
      · rename_i hp
        exact div_nonneg hp.1 hα.le
      · exact le_rfl
    have hg₁ (x : Fin d → ℝ) : g x ≤ 1 := by
      dsimp [g]
      split
      · rename_i hp
        exact (div_le_one hα).mpr hp.2
      · exact zero_le_one
    let S := {x | g x ≠ 0}
    have hSm : MeasurableSet S := (measurableSet_eq_fun hg measurable_const).compl
    have hVS : volume S ≤ (ENNReal.ofReal τ)⁻¹ * volume A := by
      refine (measure_mono ?_).trans hrV
      intro x hx
      by_contra hn
      have hz : r x = 0 := not_not.mp hn
      exact hx (by simp [g, hz])
    have htop : (ENNReal.ofReal τ)⁻¹ * volume A ≠ ∞ :=
      ENNReal.mul_ne_top (ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hτ)) hAf
    have hSf : volume S ≠ ∞ := (hVS.trans_lt htop.lt_top).ne
    have hSv : volume.real S ≤ h/L := by
      have hb := ENNReal.toReal_mono htop hVS
      rw [ENNReal.toReal_mul, ENNReal.toReal_inv, ENNReal.toReal_ofReal hτ.le] at hb
      refine hb.trans_eq ?_
      change (L*a/h)⁻¹*a = h/L
      field_simp [hh.ne', ha.ne', hL₀.ne']
      exact div_self ha.ne'
    obtain ⟨B,hBm,hSB,hBf,hBv⟩ := pad i hSm hSf (hSv.trans hsmall)
    refine ⟨B,g,α,hBm,hBf,hg,hg₀,?_,hα,hBv.ge,?_,?_⟩
    · intro x
      by_cases hx : x ∈ B
      · simpa [hx] using hg₁ x
      · have hz : g x = 0 := by by_contra hn; exact hx (hSB hn)
        simp [hx, hz]
    · rw [hBv]
      have hratio : a/h ≤ 1 := (div_le_one hh).mpr (hst.le.trans hsmall)
      have hr₀ : 0 < a/h := div_pos ha hh
      have hp : a/h ≤ (a/h)^t := by
        simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_ge hr₀ hratio ht₁
      have he : (a / h) * h = a := div_mul_cancel₀ _ hh.ne'
      calc
        α*h^t = (2*L)*((a/h)*h^t) := by dsimp [α,τ]; ring
        _ ≤ (2*L)*((a/h)^t*h^t) := mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right hp (Real.rpow_nonneg hh.le _)) (by positivity)
        _ = _ := by rw [← Real.mul_rpow hr₀.le hh.le, he]
    · have hae : r =ᵐ[volume] fun x => α*g x := by
        filter_upwards [hrb] with x hx
        dsimp [g]
        rw [ite_eq_left hx, ← mul_div_assoc, mul_comm α, mul_div_cancel_right₀ _ hα.ne']
      filter_upwards [hcoord, coordinateAverage_ae_congr i hae] with x hx hxg
      intro hV k
      have hv : x ∉ pruningSet i A τ := by simpa [balanceExceptional, hst, τ, a] using hV
      have havg (k : ℤ) : coordinateAverage i k f x = α*coordinateAverage i k g x :=
        ((hx hv k).1.symm.trans (hxg k)).trans (coordinateAverage_mul_const i k α g x)
      exact ⟨havg k, by simp only [coordinateDifference, havg, mul_sub]⟩
  · have hpres : ∀ᵐ x ∂volume, x ∉ balanceExceptional i A L h → ∀ k : ℤ,
        coordinateAverage i k f x = (1:ℝ)*coordinateAverage i k f x ∧
          coordinateDifference i k f x = (1:ℝ)*coordinateDifference i k f x :=
      Filter.Eventually.of_forall fun _ _ _ => by simp
    by_cases hle : h ≤ a
    · refine ⟨A,f,1,hA,hAf,hf,hf₀,hf₁,zero_lt_one,hle,?_,hpres⟩
      rw [one_mul]
      exact le_mul_of_one_le_left (Real.rpow_nonneg ha.le _) hL₂
    · obtain ⟨B,hBm,hAB,hBf,hBv⟩ := pad i hA hAf (le_of_not_ge hle)
      refine ⟨B,f,1,hBm,hBf,hf,hf₀,?_,zero_lt_one,hBv.ge,?_,hpres⟩
      · intro x
        refine (hf₁ x).trans ?_
        by_cases hx : x ∈ A
        · simp [hx, hAB hx]
        · by_cases hy : x ∈ B <;> simp [hx, hy]
      · rw [one_mul, hBv]
        have hv : h ≤ L*a := by simpa [mul_comm L] using (div_le_iff₀ hL₀).mp (le_of_not_gt hst)
        have hLp : L^t ≤ L := by
          simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hL ht₁
        calc
          _ ≤ (L*a)^t := Real.rpow_le_rpow hh.le hv ht
          _ = L^t*a^t := Real.mul_rpow hL₀.le ha.le
          _ ≤ (2*L)*a^t := mul_le_mul_of_nonneg_right (hLp.trans (by linarith))
            (Real.rpow_nonneg ha.le _)

private theorem exists_rpow_neg_lt {p ε l : ℝ} (hp : 0 < p) (hε : 0 < ε) :
    ∃ r : ℝ, l < r ∧ r^(-p) < ε := by
  have h := (tendsto_rpow_neg_atTop hp).eventually (gt_mem_nhds hε)
  exact (h.and (Filter.eventually_gt_atTop l)).exists.imp (fun _ h => ⟨h.2,h.1⟩)

private theorem supportWeight_positive {d : ℕ} {A : Option (Fin d) → Set (Fin d → ℝ)}
    (t : Option (Fin d) → ℝ) (h : ∀ i, 0 < volume.real (A i)) :
    0 < dyadicSupportWeight t A :=
  Finset.prod_pos (fun i _ => Real.rpow_pos_of_pos (h i) _)

private theorem supportWeight_zero_of {d : ℕ} {A : Option (Fin d) → Set (Fin d → ℝ)}
    (t : Option (Fin d) → ℝ) (ht : ∀ i, 0 < t i) (j : Option (Fin d))
    (hj : volume.real (A j) = 0) : dyadicSupportWeight t A = 0 := by
  unfold dyadicSupportWeight
  apply Finset.prod_eq_zero (Finset.mem_univ j)
  rw [hj, Real.zero_rpow (ht j).ne']

private theorem dyadicForm_tester_split {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) {V : Set (Fin d → ℝ)} (hV : MeasurableSet V)
    (H : (Fin d → ℝ) → ℝ) (hHm : Measurable H) (hHI : Integrable H)
    (hH₁ : ∀ x, |H x| ≤ 1)
    (F : Fin d → (Fin d → ℝ) → ℝ) (hFm : ∀ i, Measurable (F i))
    (hF₁ : ∀ i x, |F i x| ≤ 1) :
    dyadicForm b u T c H F = dyadicForm b u T c (Vᶜ.indicator H) F +
      dyadicForm b u T c (V.indicator H) F := by
  classical
  have hI (k : ℤ) (S : Set (Fin d → ℝ)) (hS : MeasurableSet S) :
      Integrable (fun x => S.indicator H x * coordinateDifference b k (F b) x *
        ∏ i : {i : Fin d // i ≠ b}, coordinateAverage i k (F i) x) := by
    let f (i : Option (Fin d)) := i.elim (S.indicator H) F
    have hf (i : Option (Fin d)) : Measurable (f i) := by
      cases i with
      | none => exact hHm.indicator hS
      | some i => exact hFm i
    have hf₁ (i : Option (Fin d)) (x : Fin d → ℝ) : |f i x| ≤ 1 := by
      cases i with
      | some i => exact hF₁ i x
      | none => by_cases hx : x ∈ S <;> simp [f, hx, hH₁ x]
    have hi := dyadicForm_integrand_integrable b k f hf hf₁ (hHI.indicator hS)
    simpa only [dyadicSlot_product, f, Option.elim_none, Option.elim_some] using hi
  unfold dyadicForm
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k _
  rw [← mul_add, ← integral_add (hI (u+k) Vᶜ hV.compl) (hI (u+k) V hV)]
  apply congrArg (fun v : ℝ => c k * v)
  apply integral_congr_ae
  filter_upwards [] with x
  by_cases hx : x ∈ V <;> simp [hx]

private theorem dyadicForm_tester_balance {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) {V : Set (Fin d → ℝ)} (H : (Fin d → ℝ) → ℝ)
    (F G : Fin d → (Fin d → ℝ) → ℝ) (α : Fin d → ℝ)
    (he : ∀ i, ∀ᵐ x ∂volume, x ∉ V → ∀ k : ℤ,
      coordinateAverage i k (F i) x = α i * coordinateAverage i k (G i) x ∧
      coordinateDifference i k (F i) x = α i * coordinateDifference i k (G i) x) :
    dyadicForm b u T c (Vᶜ.indicator H) F =
      (∏ i, α i) * dyadicForm b u T c (Vᶜ.indicator H) G := by
  classical
  unfold dyadicForm
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k _
  rw [mul_left_comm]
  congr 1
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [ae_all_iff.mpr he] with x hx
  by_cases hV : x ∈ V
  · simp [hV]
  · simp only [Set.indicator_of_mem (show x ∈ Vᶜ from hV)]
    have hh i := (hx i hV (u+k)).1
    rw [(hx b hV (u+k)).2]
    have hlow :
        (∏ i : {i : Fin d // i ≠ b}, coordinateAverage i (u+k) (F i) x) =
          ∏ i : {i : Fin d // i ≠ b}, α i * coordinateAverage i (u+k) (G i) x :=
      Finset.prod_congr rfl fun i _ => hh i
    rw [hlow, Finset.prod_mul_distrib, Fintype.prod_eq_mul_prod_subtype_ne α b]
    ring

set_option maxHeartbeats 1300000 in
/-- The restricted constant for nonnegative real inputs is uniform over finite scale windows. -/
theorem restrictedReal {d : ℕ} (hd : 2 ≤ d)
    (t : Option (Fin d) → ℝ) (ht : ∀ i, 0 < t i) (hs : ∑ i, t i = 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ b : Fin d, ∀ u : ℤ, ∀ T : ℕ, dyadicFormConstant b u T t ≤ C := by
  classical
  let b₀ : Fin d := ⟨0, by omega⟩
  let hne : (Finset.univ : Finset (Fin d)).Nonempty := ⟨b₀, Finset.mem_univ b₀⟩
  let m := Finset.univ.inf' hne (fun i => t (some i))
  have hm : 0 < m := by
    obtain ⟨i, _, hi⟩ := Finset.exists_mem_eq_inf' hne (fun i => t (some i))
    rw [show m = t (some i) from hi]
    exact ht _
  have hmt i : m ≤ t (some i) := Finset.inf'_le _ (Finset.mem_univ i)
  have ht₁ i : t i ≤ 1 := by
    rw [← hs]
    exact Finset.single_le_sum (fun j _ => (ht j).le) (Finset.mem_univ i)
  have hd₀ : (0:ℝ) < d := by exact_mod_cast (show 0 < d by omega)
  have hd₁ : (1:ℝ) ≤ d := by exact_mod_cast (show 1 ≤ d by omega)
  have hdp : 0 < (d:ℝ)^t none := Real.rpow_pos_of_pos hd₀ _
  obtain ⟨L, hL, hLsmall⟩ := exists_rpow_neg_lt (l := (d:ℝ)) (ht none)
    (div_pos (by norm_num : (0:ℝ) < 1/4) hdp)
  have hL₁ := hd₁.trans hL.le
  have hL₀ := hd₀.trans hL
  have hLoss : ((d:ℝ)/L)^t none ≤ 1/4 := by
    rw [Real.div_rpow hd₀.le hL₀.le, div_eq_mul_inv, ← Real.rpow_neg hL₀.le]
    exact ((lt_div_iff₀ hdp).mp hLsmall).le.trans_eq' (mul_comm _ _)
  let P := (2*L)^d
  have hP : 0 < P := pow_pos (by positivity) _
  obtain ⟨K, hK, hKsmall⟩ := exists_rpow_neg_lt (l := 1) hm
    (div_pos (by norm_num : (0:ℝ) < 1/4) (mul_pos (show 0 < P from hP) hd₀))
  have hDiscard : P*d*K^(-m) ≤ 1/4 := by
    have h := ((lt_div_iff₀ (mul_pos (show 0 < P from hP) hd₀)).mp hKsmall).le
    simpa only [mul_comm (K^(-m))] using h
  obtain ⟨C, hC, hsmall⟩ := restricted_when_tester_is_smallest hd t ht hs hm hmt hK
  refine ⟨2*P*C, by positivity, ?_⟩
  intro b u T
  let X := dyadicFormConstant b u T t
  have hX : 0 ≤ X := (dyadicFormConstant_bounds b u T t ht hs).1
  have hbnd : X ≤ P*C + (1/2:ℝ)*X := by
    unfold X dyadicFormConstant
    apply csSup_le
    · exact ⟨0, fun _ => 0, fun _ => ∅, fun _ _ => 0, by simp,
        by intro i; simp, by simp [dyadicForm]⟩
    rintro r ⟨c,A,f,hc,hf,rfl⟩
    let h := (volume : Measure (Fin d → ℝ)).real (A none)
    let a (i : Fin d) := (volume : Measure (Fin d → ℝ)).real (A (some i))
    let W := dyadicSupportWeight t A
    change |dyadicForm b u T c (f none) (fun i => f (some i))| / W ≤ P*C + (1/2:ℝ)*X
    by_cases ha : ∀ i, 0 < volume.real (A i)
    swap
    · push Not at ha
      obtain ⟨j,hj⟩ := ha
      have hW : W = 0 := supportWeight_zero_of t ht j (le_antisymm hj measureReal_nonneg)
      rw [hW, div_zero]
      positivity
    have hh : 0 < h := ha none
    have hW : 0 < W := supportWeight_positive t ha
    let U (i : Fin d) := balanceExceptional i (A (some i)) L h
    let V := ⋃ i, U i
    have hU i := balanceExceptional_control i (hf (some i)).1 (hf (some i)).2.1
      (ha (some i)) hL₁ hh
    have hVm : MeasurableSet V := MeasurableSet.iUnion fun i => (hU i).1
    have hVarea : volume.real V ≤ (d:ℝ)*h/L := by
      refine (measureReal_iUnion_fintype_le U).trans ?_
      calc
        _ ≤ ∑ _i : Fin d, h/L := Finset.sum_le_sum fun i _ => (hU i).2.2
        _ = _ := by simp [mul_div_assoc]
    let V' := A none ∩ V
    let H := f none
    let H₀ := Vᶜ.indicator H
    let H₁ := V.indicator H
    let A₁ (i : Option (Fin d)) := i.elim V' (fun j => A (some j))
    let f₁ (i : Option (Fin d)) := i.elim H₁ (fun j => f (some j))
    have hSupp₁ : DyadicSupported A₁ f₁ := by
      intro i
      cases i with
      | some i => exact hf (some i)
      | none =>
        refine ⟨(hf none).1.inter hVm, measure_ne_top_of_subset inter_subset_left (hf none).2.1,
          (hf none).2.2.1.indicator hVm, ?_, ?_⟩
        · intro x
          by_cases hx : x ∈ V <;> simp [f₁,H₁,hx,(hf none).2.2.2.1 x,H]
        · intro x
          have hh := (hf none).2.2.2.2 x
          by_cases hx : x ∈ V
          · by_cases ha' : x ∈ A none <;> simpa [A₁,f₁,H₁,V',H,hx,ha'] using hh
          · simp [A₁,f₁,H₁,V',hx]
    have hBad : |dyadicForm b u T c H₁ (fun i => f (some i))| ≤ (1/4:ℝ)*X*W := by
      have hform := dyadicForm_le_constant b u T c hc t ht hs hSupp₁
      change |dyadicForm b u T c H₁ (fun i => f (some i))| ≤ X*dyadicSupportWeight t A₁ at hform
      have hVf : volume V ≠ ∞ := by
        unfold V
        refine ((measure_iUnion_le U).trans_lt ?_).ne
        rw [tsum_fintype]
        exact ENNReal.sum_lt_top.mpr (fun i _ => (hU i).2.1.lt_top)
      have hV' : volume.real V' ≤ ((d:ℝ)/L)*h :=
        (measureReal_mono inter_subset_right hVf).trans (hVarea.trans_eq (by ring))
      have hW₁ : dyadicSupportWeight t A₁ ≤ (1/4:ℝ)*W := by
        unfold W dyadicSupportWeight
        rw [Fintype.prod_option, Fintype.prod_option]
        change volume.real V'^t none * (∏ i : Fin d, a i^t (some i)) ≤
          1/4 * (h^t none * ∏ i : Fin d, a i^t (some i))
        have hstep := Real.rpow_le_rpow measureReal_nonneg hV' (ht none).le
        rw [Real.mul_rpow (div_nonneg hd₀.le hL₀.le) hh.le] at hstep
        rw [← mul_assoc]
        exact mul_le_mul_of_nonneg_right (hstep.trans
          (mul_le_mul_of_nonneg_right hLoss (Real.rpow_nonneg hh.le _)))
          (Finset.prod_nonneg fun _ _ => Real.rpow_nonneg measureReal_nonneg _)
      exact hform.trans ((mul_le_mul_of_nonneg_left hW₁ hX).trans_eq (by ring))
    have hdata i := balanceInput i (hf (some i)).1 (hf (some i)).2.1 (ha (some i))
      (hf (some i)).2.2.1 (hf (some i)).2.2.2.1 (hf (some i)).2.2.2.2
      hL₁ hh (ht (some i)).le (ht₁ (some i))
    choose B G α hBm hBf hGm hG₀ hG₁ hα hBh hBweight hGcoord using hdata
    let A₂ (i : Option (Fin d)) := i.elim (A none) B
    let f₂ (i : Option (Fin d)) := i.elim H₀ G
    have hSupp₂ : DyadicSupported A₂ f₂ := by
      intro i
      cases i with
      | some i => exact ⟨hBm i, hBf i, hGm i, hG₀ i, hG₁ i⟩
      | none =>
        refine ⟨(hf none).1, (hf none).2.1, (hf none).2.2.1.indicator hVm.compl, ?_, ?_⟩
        · intro x
          by_cases hx : x ∈ V <;> simp [f₂,H₀,hx,(hf none).2.2.2.1 x,H]
        · intro x
          have hh := (hf none).2.2.2.2 x
          by_cases hx : x ∈ V
          · simpa [A₂,f₂,H₀,hx] using
              (show 0 ≤ (A none).indicator (fun _ => (1:ℝ)) x from
                indicator_nonneg (fun _ _ => zero_le_one) x)
          · simpa [A₂,f₂,H₀,H,hx] using hh
    have hbalance := dyadicForm_tester_balance b u T c H (fun i => f (some i)) G α (V := V)
      (fun i => (hGcoord i).mono fun x hx hv k =>
        hx (fun hi => hv (Set.mem_iUnion.mpr ⟨i,hi⟩)) k)
    have hfactor : (∏ i, α i) * dyadicSupportWeight t A₂ ≤ P * W := by
      unfold W dyadicSupportWeight
      rw [Fintype.prod_option, Fintype.prod_option]
      change (∏ i, α i) * (h^t none * ∏ i, volume.real (B i)^t (some i)) ≤
        P * (h^t none * ∏ i, a i^t (some i))
      rw [mul_left_comm, mul_left_comm P, ← Finset.prod_mul_distrib]
      apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg hh.le _)
      calc
        _ ≤ ∏ i : Fin d, (2*L)*a i^t (some i) := Finset.prod_le_prod₀
          (fun i _ => mul_nonneg (hα i).le (Real.rpow_nonneg measureReal_nonneg _))
          (fun i _ => hBweight i)
        _ = _ := by rw [Finset.prod_mul_distrib]; simp [P]
    have hGood : |dyadicForm b u T c H₀ (fun i => f (some i))| ≤
        (P*C + (1/4:ℝ)*X)*W := by
      change dyadicForm b u T c H₀ (fun i => f (some i)) =
        (∏ i, α i)*dyadicForm b u T c H₀ G at hbalance
      rw [hbalance, abs_mul, abs_of_nonneg (Finset.prod_nonneg fun i _ => (hα i).le)]
      have hb := hsmall b u T c hc A₂ f₂ hSupp₂ hh hBh
      change |dyadicForm b u T c H₀ G| ≤ (C+d*K^(-m)*X)*dyadicSupportWeight t A₂ at hb
      have hn : 0 ≤ C+d*K^(-m)*X := by positivity
      calc
        _ ≤ (∏ i, α i)*((C+d*K^(-m)*X)*dyadicSupportWeight t A₂) :=
          mul_le_mul_of_nonneg_left hb (Finset.prod_nonneg fun i _ => (hα i).le)
        _ = (C+d*K^(-m)*X)*((∏ i, α i)*dyadicSupportWeight t A₂) := by ring
        _ ≤ (C+d*K^(-m)*X)*(P*W) := mul_le_mul_of_nonneg_left hfactor hn
        _ = (P*C+(P*d*K^(-m))*X)*W := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_right
          (add_le_add le_rfl (mul_le_mul_of_nonneg_right hDiscard hX)) hW.le
    have hmH := lpNorm_le_of_indicator (hf none).1 (hf none).2.1 (hf none).2.2.1
      (hf none).2.2.2.1 (hf none).2.2.2.2 (p := 1) (by norm_num)
    have hHI : Integrable H :=
      memLp_one_iff_integrable.mp (by simpa only [ENNReal.ofReal_one] using hmH.1)
    have hF₁ i x : |f (some i) x| ≤ 1 := by
      rw [abs_of_nonneg ((hf (some i)).2.2.2.1 x)]
      exact ((hf (some i)).2.2.2.2 x).trans (by by_cases hx : x ∈ A (some i) <;> simp [hx])
    have hH₁ x : |H x| ≤ 1 := by
      have hH₀ : 0 ≤ H x := (hf none).2.2.2.1 x
      rw [abs_of_nonneg hH₀]
      exact ((hf none).2.2.2.2 x).trans (by by_cases hx : x ∈ A none <;> simp [hx])
    rw [dyadicForm_tester_split b u T c hVm H (hf none).2.2.1 hHI hH₁ (fun i => f (some i))
      (fun i => (hf (some i)).2.2.1) hF₁]
    apply (div_le_iff₀ hW).mpr
    exact (abs_add_le _ _).trans ((add_le_add hGood hBad).trans_eq (by ring))
  change X ≤ 2*P*C
  linarith

/-- Directional dyadic averaging of a complex-valued function on a standard grid. -/
noncomputable def complexCoordinateAverage {d : ℕ} (i : Fin d) (k : ℤ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) : ℂ :=
  (((2 : ℝ) ^ (-k))⁻¹ : ℝ) *
    ∫ y in dyadicInterval k (dyadicIndex k (x i)), f (Function.update x i y)

/-- Directional dyadic differencing of a complex-valued function. -/
noncomputable def complexCoordinateDifference {d : ℕ} (i : Fin d) (k : ℤ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) : ℂ :=
  complexCoordinateAverage i (k+1) f x - complexCoordinateAverage i k f x

/-- The complex tester, difference, or average for a slot of the dyadic form. -/
noncomputable def complexDyadicSlot {d : ℕ} (b : Fin d) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℂ) : Option (Fin d) → (Fin d → ℝ) → ℂ
  | none => f none
  | some i => if i = b then complexCoordinateDifference i k (f (some i))
      else complexCoordinateAverage i k (f (some i))

/-- The complex finite dyadic form, with its tester in slot `none`. -/
noncomputable def complexDyadicForm {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℂ) (f : Option (Fin d) → (Fin d → ℝ) → ℂ) : ℂ :=
  ∑ k ∈ Finset.range T, c k * ∫ x, ∏ i, complexDyadicSlot b (u+k) f i x

private noncomputable def signedComplexPart (j : Fin 4) (z : ℂ) : ℝ :=
  ![max z.re 0, max (-z.re) 0, max z.im 0, max (-z.im) 0] j

private noncomputable def complexPartSign (j : Fin 4) : ℂ := ![1,-1,Complex.I,-Complex.I] j

private noncomputable def binaryComplexPart (j : Fin 2) (z : ℂ) : ℝ := ![z.re,z.im] j

private noncomputable def complexCoefficientSign (j : Fin 2) : ℂ := ![1,Complex.I] j

private theorem signedComplexPart_nonneg (j : Fin 4) (z : ℂ) : 0 ≤ signedComplexPart j z := by
  fin_cases j <;> exact le_max_right _ _

private theorem signedComplexPart_le (j : Fin 4) (z : ℂ) : signedComplexPart j z ≤ ‖z‖ := by
  fin_cases j
  · exact max_le ((le_abs_self _).trans (Complex.abs_re_le_norm _)) (norm_nonneg _)
  · exact max_le ((neg_le_abs _).trans (Complex.abs_re_le_norm _)) (norm_nonneg _)
  · exact max_le ((le_abs_self _).trans (Complex.abs_im_le_norm _)) (norm_nonneg _)
  · exact max_le ((neg_le_abs _).trans (Complex.abs_im_le_norm _)) (norm_nonneg _)

private theorem measurable_signedComplexPart (j : Fin 4) : Measurable (signedComplexPart j) := by
  fin_cases j
  · exact Complex.continuous_re.measurable.max measurable_const
  · exact Complex.continuous_re.measurable.neg.max measurable_const
  · exact Complex.continuous_im.measurable.max measurable_const
  · exact Complex.continuous_im.measurable.neg.max measurable_const

private theorem signedComplexPart_sum (z : ℂ) :
    (∑ j : Fin 4, complexPartSign j * (signedComplexPart j z : ℂ)) = z := by
  rw [Fin.sum_univ_four]
  change (1:ℂ)*↑(max z.re 0)+(-1:ℂ)*↑(max (-z.re) 0) +
    Complex.I*↑(max z.im 0)+(-Complex.I)*↑(max (-z.im) 0) = z
  have hr : max z.re 0 - max (-z.re) 0 = z.re := by
    rcases le_total 0 z.re with h | h
    · rw [max_eq_left h, max_eq_right (neg_nonpos.mpr h), sub_zero]
    · rw [max_eq_right h, max_eq_left (neg_nonneg.mpr h), zero_sub, neg_neg]
  have hi : max z.im 0 - max (-z.im) 0 = z.im := by
    rcases le_total 0 z.im with h | h
    · rw [max_eq_left h, max_eq_right (neg_nonpos.mpr h), sub_zero]
    · rw [max_eq_right h, max_eq_left (neg_nonneg.mpr h), zero_sub, neg_neg]
  calc
    _ = Complex.ofReal (max z.re 0 - max (-z.re) 0) +
        Complex.ofReal (max z.im 0 - max (-z.im) 0) * Complex.I := by push_cast; ring
    _ = z := by rw [hr, hi]; exact Complex.re_add_im z

private theorem complexPartSign_norm (j : Fin 4) : ‖complexPartSign j‖ = 1 := by
  fin_cases j <;> simp [complexPartSign]

private theorem binaryComplexPart_sum (z : ℂ) :
    (∑ j : Fin 2, complexCoefficientSign j * (binaryComplexPart j z : ℂ)) = z := by
  rw [Fin.sum_univ_two]
  change (1:ℂ)*z.re+Complex.I*z.im = z
  rw [one_mul, mul_comm Complex.I]
  exact Complex.re_add_im z

private theorem binaryComplexPart_le (j : Fin 2) (z : ℂ) : |binaryComplexPart j z| ≤ ‖z‖ := by
  fin_cases j
  · exact Complex.abs_re_le_norm _
  · exact Complex.abs_im_le_norm _

private theorem complexCoefficientSign_norm (j : Fin 2) : ‖complexCoefficientSign j‖ = 1 := by
  fin_cases j <;> simp [complexCoefficientSign]

private theorem complexCoordinateAverage_sum {d : ℕ} (i : Fin d) (k : ℤ)
    {ι : Type*} [Fintype ι] (e : ι → ℂ) (F : ι → (Fin d → ℝ) → ℝ)
    (hFm : ∀ j, Measurable (F j)) (hF₁ : ∀ j x, |F j x| ≤ 1)
    (x : Fin d → ℝ) :
    complexCoordinateAverage i k (fun y => ∑ j, e j * (F j y : ℂ)) x =
      ∑ j, e j * (coordinateAverage i k (F j) x : ℂ) := by
  unfold complexCoordinateAverage coordinateAverage
  dsimp only
  rw [integral_finsetSum (f := fun j y => e j * (F j (Function.update x i y) : ℂ)) Finset.univ
    (fun j _ => (boundedFiber_integrable i (hFm j) (hF₁ j) x k _).ofReal.const_mul (e j)),
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  rw [integral_const_mul, integral_complex_ofReal, Complex.ofReal_mul, mul_left_comm]

private theorem complexDyadicSlot_parts {d : ℕ} (b : Fin d) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℂ)
    (hfm : ∀ i, Measurable (f i)) (hf₁ : ∀ i x, ‖f i x‖ ≤ 1)
    (i : Option (Fin d)) (x : Fin d → ℝ) :
    complexDyadicSlot b k f i x =
      ∑ j : Fin 4, complexPartSign j *
        (dyadicSlot b k (fun l y => signedComplexPart j (f l y)) i x : ℂ) := by
  have ha (a : Fin d) (n : ℤ) :
      complexCoordinateAverage a n (f (some a)) x =
        ∑ j : Fin 4, complexPartSign j *
          (coordinateAverage a n (fun y => signedComplexPart j (f (some a) y)) x : ℂ) := by
    conv_lhs => rw [show f (some a) = (fun y => ∑ j : Fin 4, complexPartSign j *
        (signedComplexPart j (f (some a) y) : ℂ)) by funext y; exact (signedComplexPart_sum _).symm]
    exact complexCoordinateAverage_sum a n _ _ (fun j => (measurable_signedComplexPart j).comp (hfm _))
      (fun j y => by
        change |signedComplexPart j (f (some a) y)| ≤ 1
        rw [abs_of_nonneg (signedComplexPart_nonneg _ _)]
        exact (signedComplexPart_le _ _).trans (hf₁ _ _)) x
  cases i with
  | none => exact (signedComplexPart_sum _).symm
  | some a =>
    by_cases hab : a = b
    · simp only [complexDyadicSlot, dyadicSlot, ite_eq_left hab, complexCoordinateDifference,
        coordinateDifference, ha, Complex.ofReal_sub, mul_sub, Finset.sum_sub_distrib]
    · simp only [complexDyadicSlot, dyadicSlot, ite_eq_right hab, ha]

set_option maxHeartbeats 1200000 in
/-- Uniform restricted estimates with complex coefficients and complex inputs. -/
theorem restricted {d : ℕ} (hd : 2 ≤ d)
    (t : Option (Fin d) → ℝ) (ht : ∀ i, 0 < t i) (hs : ∑ i, t i = 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (b : Fin d) (u : ℤ) (T : ℕ) (c : ℕ → ℂ) (_ : ∀ k, ‖c k‖ ≤ 1)
      (A : Option (Fin d) → Set (Fin d → ℝ)) (f : Option (Fin d) → (Fin d → ℝ) → ℂ),
      (∀ i, MeasurableSet (A i) ∧ volume (A i) ≠ ∞ ∧ Measurable (f i) ∧
        ∀ x, ‖f i x‖ ≤ (A i).indicator (fun _ => (1:ℝ)) x) →
      ‖complexDyadicForm b u T c f‖ ≤ C*dyadicSupportWeight t A := by
  classical
  obtain ⟨C,hC,hUniform⟩ := restrictedReal hd t ht hs
  refine ⟨2*4^(d+1)*C, by positivity, ?_⟩
  intro b u T c hc A f hf
  let θ := Option (Fin d) → Fin 4
  let g (j : θ) (i : Option (Fin d)) (x : Fin d → ℝ) := signedComplexPart (j i) (f i x)
  let e (j : θ) := ∏ i, complexPartSign (j i)
  let a (j : Fin 2) (k : ℕ) := binaryComplexPart j (c k)
  have hW : 0 ≤ dyadicSupportWeight t A :=
    Finset.prod_nonneg (fun _ _ => Real.rpow_nonneg measureReal_nonneg _)
  have hFm i : Measurable (f i) := (hf i).2.2.1
  have hF₁ i x : ‖f i x‖ ≤ 1 := ((hf i).2.2.2 x).trans (by by_cases hx : x ∈ A i <;> simp [hx])
  have hg (j : θ) : DyadicSupported A (g j) := fun i =>
    ⟨(hf i).1, (hf i).2.1, (measurable_signedComplexPart _).comp (hFm i),
      fun _ => signedComplexPart_nonneg _ _,
      fun x => (signedComplexPart_le _ _).trans ((hf i).2.2.2 x)⟩
  have hg₁ j i x : |g j i x| ≤ 1 := by
    rw [abs_of_nonneg ((hg j i).2.2.2.1 x)]
    exact (signedComplexPart_le _ _).trans (hF₁ i x)
  have hgi j : Integrable (g j none) := by
    have h := lpNorm_le_of_indicator (hg j none).1 (hg j none).2.1 (hg j none).2.2.1
      (hg j none).2.2.2.1 (hg j none).2.2.2.2 (p := 1) (by norm_num)
    exact memLp_one_iff_integrable.mp (by simpa only [ENNReal.ofReal_one] using h.1)
  have ha j k : |a j k| ≤ 1 := (binaryComplexPart_le j _).trans (hc k)
  have he j : ‖e j‖ = 1 := by simp [e, norm_prod, complexPartSign_norm]
  let R (j : θ) (k : ℕ) := ∫ x, ∏ i, dyadicSlot b (u+k) (g j) i x
  have hIntegral (k : ℕ) :
      (∫ x, ∏ i, complexDyadicSlot b (u+k) f i x) =
        ∑ j : θ, e j * (R j k : ℂ) := by
    have hpt (x : Fin d → ℝ) :
        (∏ i, complexDyadicSlot b (u+k) f i x) =
        ∑ j : θ, e j * Complex.ofReal (∏ i, dyadicSlot b (u+k) (g j) i x) := by
      simp_rw [complexDyadicSlot_parts b (u+k) f hFm hF₁, Fintype.prod_sum]
      apply Finset.sum_congr rfl
      intro j _
      simp only [g, e, Finset.prod_mul_distrib, Complex.ofReal_prod]
      congr 1
      apply Finset.prod_congr rfl
      intro i _
      cases i with
      | none => rfl
      | some i => rfl
    simp_rw [hpt]
    rw [integral_finsetSum (f := fun j x => e j * Complex.ofReal
      (∏ i, dyadicSlot b (u+k) (g j) i x)) Finset.univ
      (fun j _ => ((dyadicForm_integrand_integrable b (u+k) (g j)
        (fun i => (hg j i).2.2.1) (hg₁ j) (hgi j)).ofReal).const_mul (e j))]
    simp only [R, integral_const_mul, integral_complex_ofReal]
  have hForm :
      complexDyadicForm b u T c f = ∑ l : Fin 2, ∑ j : θ,
        complexCoefficientSign l * e j *
          (dyadicForm b u T (a l) (g j none) (fun i => g j (some i)) : ℂ) := by
    unfold complexDyadicForm dyadicForm
    have hSplit (k : ℕ) : c k * (∑ j : θ, e j * (R j k : ℂ)) =
        (∑ l : Fin 2, complexCoefficientSign l * (a l k : ℂ)) *
          (∑ j : θ, e j * (R j k : ℂ)) :=
      congrArg (· * (∑ j : θ, e j * (R j k : ℂ))) (binaryComplexPart_sum (c k)).symm
    simp_rw [hIntegral, hSplit, Finset.sum_mul, Finset.mul_sum,
      Complex.ofReal_sum, Complex.ofReal_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro l _
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k _
    dsimp only [a, R]
    simp_rw [dyadicSlot_product]
    ring
  rw [hForm]
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ _l : Fin 2, ∑ _j : θ, C*dyadicSupportWeight t A := by
      apply Finset.sum_le_sum
      intro l _
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => ?_)
      rw [norm_mul, norm_mul, complexCoefficientSign_norm, he j, one_mul, one_mul,
        Complex.norm_real, Real.norm_eq_abs]
      exact (dyadicForm_le_constant b u T (a l) (ha l) t ht hs (hg j)).trans
        (mul_le_mul_of_nonneg_right (hUniform b u T) hW)
    _ = _ := by simp [θ, Fintype.card_option]; ring

private theorem finite_product_holder {ι α : Type*} [Fintype ι] (S : Finset α)
    (w : ι → ℝ) (hw : ∀ i, 0 < w i) (hw₁ : ∑ i, w i = 1)
    (v : ι → α → ℝ) (hv : ∀ i x, 0 ≤ v i x)
    (M : ι → ℝ) (hM : ∀ i, 0 ≤ M i) (hSum : ∀ i, ∑ x ∈ S, v i x ≤ M i) :
    (∑ x ∈ S, ∏ i, v i x ^ w i) ≤ ∏ i, M i ^ w i := by
  classical
  by_cases hMp : ∀ i, 0 < M i
  · let V (i : ι) (x : α) := v i x / M i
    have hV i x : 0 ≤ V i x := div_nonneg (hv i x) (hM i)
    have hn (i : ι) : ∑ x ∈ S, V i x ≤ 1 := by
      dsimp [V]
      rw [← Finset.sum_div]
      exact (div_le_one (hMp i)).mpr (hSum i)
    have h : (∑ x ∈ S, ∏ i, V i x ^ w i) ≤ 1 := by
      calc
        _ ≤ ∑ x ∈ S, ∑ i, w i * V i x :=
          Finset.sum_le_sum fun x _ => Real.geom_mean_le_arith_mean_weighted Finset.univ
            w (fun i => V i x) (fun i _ => (hw i).le) hw₁ (fun i _ => hV i x)
        _ = ∑ i, w i * ∑ x ∈ S, V i x := by rw [Finset.sum_comm]; simp_rw [Finset.mul_sum]
        _ ≤ ∑ i, w i := Finset.sum_le_sum fun i _ => by
          simpa only [mul_one] using mul_le_mul_of_nonneg_left (hn i) (hw i).le
        _ = 1 := hw₁
    have hscale (i : ι) (x : α) : v i x ^ w i = M i ^ w i * V i x ^ w i := by
      rw [← Real.mul_rpow (hM i) (hV i x)]
      dsimp [V]
      rw [mul_comm, div_mul_cancel₀ _ (hMp i).ne']
    simp_rw [hscale, Finset.prod_mul_distrib, ← Finset.mul_sum]
    simpa only [mul_one] using mul_le_mul_of_nonneg_left h
      (Finset.prod_nonneg fun i _ => Real.rpow_nonneg (hM i) _)
  · push Not at hMp
    obtain ⟨i,hi⟩ := hMp
    have hMi : M i = 0 := le_antisymm hi (hM i)
    have hz (x : α) (hx : x ∈ S) : v i x = 0 :=
      le_antisymm ((Finset.single_le_sum (fun y _ => hv i y) hx).trans
        ((hSum i).trans_eq hMi)) (hv i x)
    have hProd (x : α) (hx : x ∈ S) : (∏ j, v j x ^ w j) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ i)
      rw [hz x hx, Real.zero_rpow (hw i).ne']
    have hProd' : (∏ j, M j ^ w j) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ i)
      rw [hMi, Real.zero_rpow (hw i).ne']
    rw [Finset.sum_eq_zero hProd, hProd']

