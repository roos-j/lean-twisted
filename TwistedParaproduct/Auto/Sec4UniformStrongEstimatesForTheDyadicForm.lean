private theorem sum_int_geometric_le (S : Finset ℤ) {r : ℝ} (hr : 0 ≤ r) (hr₁ : r < 1) :
    (∑ l ∈ S, r^l.natAbs) ≤ 2*(1-r)⁻¹ := by
  let f (n : ℤ) := r^n.natAbs
  have he (n : ℕ) : f (-((n:ℤ)+1)) = r^n*r := by
    dsimp [f]
    rw [← Nat.cast_succ, Int.natAbs_neg, Int.natAbs_natCast, pow_succ]
  have h₀ : Summable (fun n : ℕ => r^((n : ℤ).natAbs)) := by
    simpa only [Int.natAbs_natCast] using summable_geometric_of_lt_one hr hr₁
  have h₁ : Summable (fun n : ℕ => f (-((n:ℤ)+1))) := by
    simpa only [he] using (summable_geometric_of_lt_one hr hr₁).mul_right r
  have hsf : Summable f := Summable.of_nat_of_neg_add_one (f := f) h₀ h₁
  have hSum : (∑ l ∈ S, f l) ≤ ∑' l, f l :=
    Summable.sum_le_tsum S (fun l _ => pow_nonneg hr l.natAbs) hsf
  refine hSum.trans ?_
  rw [tsum_of_nat_of_neg_add_one (f := f) h₀ h₁]
  simp_rw [he]
  dsimp only [f]
  simp_rw [Int.natAbs_natCast, tsum_mul_right, tsum_geometric_of_lt_one hr hr₁]
  have h : 0 ≤ (1-r)⁻¹ := inv_nonneg.mpr (sub_nonneg.mpr hr₁.le)
  linarith [mul_le_mul_of_nonneg_left hr₁.le h]

set_option maxHeartbeats 700000 in
private theorem weighted_bin_sum_le {ι : Type*} [Fintype ι] [DecidableEq ι] (i₀ : ι)
    (B : ι → Finset ℤ) (t : ι → ℝ) (ht : ∀ i, 0 < t i) (ht₁ : ∑ i, t i = 1)
    (v : ι → ℤ → ℝ) (hv : ∀ i k, 0 ≤ v i k) (M : ι → ℝ) (hM : ∀ i, 0 ≤ M i)
    (hSum : ∀ i (S : Finset ℤ), ∑ k ∈ S, v i k ≤ M i) {r : ℝ} (hr : 0 ≤ r) (hr₁ : r < 1) :
    (∑ k ∈ Fintype.piFinset B,
      (∏ i, r^((k i-k i₀).natAbs)) * ∏ i, v i (k i)^t i) ≤
      (2*(1-r)⁻¹)^(Fintype.card ι) * ∏ i, M i ^ t i := by
  classical
  let D (i : ι) := ((B i).product (B i₀)).image (fun p => p.1-p.2)
  let E (k : ι → ℤ) : (ι → ℤ) × ℤ := (fun i => k i-k i₀, k i₀)
  let G (l : ι → ℤ) := ∏ i, r^(l i).natAbs
  let H (l : ι → ℤ) (k : ℤ) := ∏ i, v i (k+l i)^t i
  have hG l : 0 ≤ G l := Finset.prod_nonneg fun i _ => pow_nonneg hr _
  have hH l k : 0 ≤ H l k := Finset.prod_nonneg fun i _ => Real.rpow_nonneg (hv i _) _
  have hE : Set.InjOn E ↑(Fintype.piFinset B) := by
    intro k _ l _ hh
    have h₀ := congrArg Prod.snd hh
    have h₁ := congrArg Prod.fst hh
    dsimp [E] at h₀ h₁
    funext i
    have he := congrFun h₁ i
    omega
  have hEi : (Fintype.piFinset B).image E ⊆ (Fintype.piFinset D).product (B i₀) := by
    intro p hp
    obtain ⟨k,hk,rfl⟩ := Finset.mem_image.mp hp
    have hk' := Fintype.mem_piFinset.mp hk
    exact Finset.mem_product.mpr ⟨Fintype.mem_piFinset.mpr fun i =>
      Finset.mem_image.mpr ⟨(k i,k i₀),Finset.mem_product.mpr ⟨hk' i,hk' i₀⟩,rfl⟩,hk' i₀⟩
  have hReindex := Finset.sum_le_sum_of_injOn E hE hEi
    (f := fun k => (∏ i, r^((k i-k i₀).natAbs)) * ∏ i, v i (k i)^t i)
    (g := fun p => G p.1*H p.1 p.2)
    (fun k _ => by
      have h : H (E k).1 (E k).2 = ∏ i, v i (k i)^t i := by
        apply Finset.prod_congr rfl
        intro i _
        have he : (E k).2+(E k).1 i = k i := by dsimp [E]; omega
        rw [he]
      rw [h]
      )
    (fun p _ _ => mul_nonneg (hG _) (hH _ _))
  have hShift (l : ι → ℤ) (i : ι) : (∑ k ∈ B i₀, v i (k+l i)) ≤ M i := by
    have h := hSum i ((B i₀).image (fun k => k+l i))
    rw [Finset.sum_image (by intro x _ y _ hxy; dsimp at hxy; omega)] at h
    exact h
  have hHold l : (∑ k ∈ B i₀, H l k) ≤ ∏ i, M i ^ t i :=
    finite_product_holder (B i₀) t ht ht₁ (fun i k => v i (k+l i))
      (fun i k => hv i _) M hM (fun i => hShift l i)
  have hGeo : (∑ l ∈ Fintype.piFinset D, G l) ≤ (2*(1-r)⁻¹)^(Fintype.card ι) := by
    dsimp only [G]
    rw [← Finset.prod_univ_sum D (fun _ (l : ℤ) => r^l.natAbs),
      ← Finset.card_univ, ← Finset.prod_const]
    exact Finset.prod_le_prod₀ (fun _ _ => Finset.sum_nonneg fun _ _ => pow_nonneg hr _)
      (fun i _ => sum_int_geometric_le (D i) hr hr₁)
  refine hReindex.trans ?_
  calc
    _ = ∑ l ∈ Fintype.piFinset D, ∑ k ∈ B i₀, G l * H l k :=
      Finset.sum_product (Fintype.piFinset D) (B i₀) (fun p => G p.1*H p.1 p.2)
    _ = ∑ l ∈ Fintype.piFinset D, G l * ∑ k ∈ B i₀, H l k := by simp_rw [Finset.mul_sum]
    _ ≤ ∑ l ∈ Fintype.piFinset D, G l * ∏ i, M i ^ t i :=
      Finset.sum_le_sum fun l _ => mul_le_mul_of_nonneg_left (hHold l) (hG l)
    _ = (∑ l ∈ Fintype.piFinset D, G l) * ∏ i, M i ^ t i := by rw [Finset.sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right hGeo (Finset.prod_nonneg fun i _ => Real.rpow_nonneg (hM i) _)

private theorem sum_zpow_le_double_at_max (S : Finset ℤ) (j₀ : ℤ)
    (hj : ∀ j ∈ S, j ≤ j₀) :
    (∑ j ∈ S, (2:ℝ)^j) ≤ 2*(2:ℝ)^j₀ := by
  let n (j : ℤ) := (j₀-j).toNat
  have hn (j : ℤ) (h : j ∈ S) : (n j : ℤ) = j₀-j := Int.toNat_of_nonneg (sub_nonneg.mpr (hj j h))
  have hinj : Set.InjOn n ↑S := by
    intro j hj' k hk' h
    have e := congrArg (fun n : ℕ => (n : ℤ)) h
    rw [hn j hj', hn k hk'] at e
    omega
  have hstep (j : ℤ) (h : j ∈ S) : (2:ℝ)^j = (2:ℝ)^j₀ * (1/2:ℝ)^(n j) := by
    rw [one_div, inv_pow, ← zpow_natCast, ← zpow_neg, ← zpow_add₀ (by norm_num : (2:ℝ) ≠ 0), hn j h]
    congr 1
    omega
  calc
    _ = (2:ℝ)^j₀ * (∑ n ∈ S.image n, (1/2:ℝ)^n) := by
      rw [Finset.sum_image hinj, Finset.mul_sum]
      exact Finset.sum_congr rfl hstep
    _ ≤ (2:ℝ)^j₀ * 2 := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact (Summable.sum_le_tsum _ (fun _ _ => by positivity) summable_geometric_two).trans_eq
        tsum_geometric_two
    _ = _ := mul_comm _ _

private theorem grouped_amplitude_le (S : Finset ℤ) (k : ℤ) {t : ℝ} (ht : 0 < t) :
    (∑ j ∈ S, (2:ℝ)^j * (2:ℝ)^((k:ℝ)*t)) ≤
      2 * (∑ j ∈ S, (2:ℝ)^((j:ℝ)/t+k))^t := by
  rcases S.eq_empty_or_nonempty with rfl | hS
  · simp [Real.zero_rpow ht.ne']
  let j₀ := S.max' hS
  have hj₀ : j₀ ∈ S := S.max'_mem hS
  have hin : (2:ℝ)^((j₀:ℝ)/t+k) ≤ ∑ j ∈ S, (2:ℝ)^((j:ℝ)/t+k) :=
    Finset.single_le_sum (f := fun j : ℤ => (2:ℝ)^((j:ℝ)/t+k)) (fun _ _ => by positivity) hj₀
  have hp : ((2:ℝ)^((j₀:ℝ)/t+k))^t = (2:ℝ)^j₀*(2:ℝ)^((k:ℝ)*t) := by
    rw [← Real.rpow_mul (by norm_num), add_mul, div_mul_cancel₀ _ ht.ne',
      Real.rpow_add (by norm_num), Real.rpow_intCast]
  rw [← Finset.sum_mul]
  calc
    _ ≤ (2*(2:ℝ)^j₀)*(2:ℝ)^((k:ℝ)*t) :=
      mul_le_mul_of_nonneg_right (sum_zpow_le_double_at_max S j₀ (fun j hj =>
        S.le_max' j hj)) (by positivity)
    _ = 2 * ((2:ℝ)^((j₀:ℝ)/t+k))^t := by rw [hp, mul_assoc]
    _ ≤ _ := mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (by positivity) hin ht.le) (by norm_num)

/-- Transfer an exponent increment from slot `b` to slot `a`. -/
def shiftExponent {ι : Type*} [DecidableEq ι] (t : ι → ℝ) (ρ : ℝ)
    (a b i : ι) : ℝ :=
  t i + ρ * ((if i = a then 1 else 0) - (if i = b then 1 else 0))

private theorem shiftExponent_pos {ι : Type*} [DecidableEq ι] {t : ι → ℝ} {ρ : ℝ}
    (hρ : 0 ≤ ρ) (ht : ∀ i, ρ < t i) (a b i : ι) :
    0 < shiftExponent t ρ a b i := by
  unfold shiftExponent
  split <;> split <;> linarith [ht i]

private theorem shiftExponent_sum {ι : Type*} [Fintype ι] [DecidableEq ι] {t : ι → ℝ}
    (ht : ∑ i, t i = 1) (ρ : ℝ) (a b : ι) :
    ∑ i, shiftExponent t ρ a b i = 1 := by
  simp [shiftExponent, Finset.sum_add_distrib, mul_sub, Finset.sum_sub_distrib, ht]

private theorem bin_weight_shift_bound {ι : Type*} [Fintype ι] [DecidableEq ι] (o : ι)
    (t : ι → ℝ) (ht : ∑ i, t i = 1) {ρ : ℝ} (hρ : 0 < ρ)
    (htρ : ∀ i, ρ < t i) (k : ι → ℤ) (A : ι → ℝ) (hA : ∀ i, 0 ≤ A i)
    (hBin : ∀ i, A i ≤ (2:ℝ)^((k i:ℝ)+1)) :
    ∃ a b : ι, (∏ i, A i ^ shiftExponent t ρ a b i) ≤
      2 * (∏ i, ((2:ℝ)^(-ρ/Fintype.card ι))^((k i-k o).natAbs)) *
        ∏ i, (2:ℝ)^((k i:ℝ)*t i) := by
  classical
  let hNE : (Finset.univ : Finset ι).Nonempty := ⟨o,Finset.mem_univ _⟩
  obtain ⟨a,_,ha⟩ := Finset.exists_mem_eq_inf' hNE k
  obtain ⟨b,_,hb⟩ := Finset.exists_mem_eq_sup' hNE k
  have hin (i : ι) : k a ≤ k i := ha ▸ Finset.inf'_le k (Finset.mem_univ i)
  have hsu (i : ι) : k i ≤ k b := hb ▸ Finset.le_sup' k (Finset.mem_univ i)
  let s := shiftExponent t ρ a b
  have hs : ∑ i, s i = 1 := shiftExponent_sum ht ρ a b
  have hss i : 0 ≤ s i := (shiftExponent_pos hρ.le htρ a b i).le
  have h2 : (0:ℝ) < 2 := by norm_num
  have hc : 0 < (Fintype.card ι : ℝ) := by
    letI : Nonempty ι := ⟨o⟩
    exact_mod_cast Fintype.card_pos
  have hdiff (i : ι) : ((k i-k o).natAbs : ℝ) ≤ (k b:ℝ)-k a := by
    have he : (((k i-k o).natAbs : ℕ) : ℤ) ≤ k b-k a := by
      rw [Int.natCast_natAbs]
      exact abs_le.mpr ⟨by linarith [hin i, hsu o], by linarith [hin o, hsu i]⟩
    have hcast := Int.cast_le (R := ℝ) |>.mpr he
    simp only [Int.cast_sub, Int.cast_natCast] at hcast
    exact hcast
  have hdecay :
      (2:ℝ)^(-ρ*((k b:ℝ)-k a)) ≤ ∏ i, ((2:ℝ)^(-ρ/Fintype.card ι))^((k i-k o).natAbs) := by
    have hconst : (∏ _i : ι, (2:ℝ)^((-ρ/Fintype.card ι)*((k b:ℝ)-k a))) =
        (2:ℝ)^(-ρ*((k b:ℝ)-k a)) := by
      rw [Finset.prod_const, Finset.card_univ, ← Real.rpow_mul_natCast h2.le]
      congr 1
      field_simp [hc.ne']
    rw [← hconst]
    apply Finset.prod_le_prod₀ (fun _ _ => by positivity)
    intro i _
    rw [← Real.rpow_mul_natCast h2.le]
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num)
      (mul_le_mul_of_nonpos_left (hdiff i) (div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hρ.le) hc.le))
  have hsum : (∑ i, ((k i:ℝ)+1)*s i) =
      (∑ i, (k i:ℝ)*t i) + (-ρ*((k b:ℝ)-k a)) + 1 := by
    simp only [add_mul, one_mul, Finset.sum_add_distrib, hs]
    congr 1
    have hsplit (i : ι) : (k i:ℝ)*s i = (k i:ℝ)*t i +
        (if i=a then (k i:ℝ)*ρ else 0) - (if i=b then (k i:ℝ)*ρ else 0) := by
      dsimp [s, shiftExponent]
      split <;> split <;> ring
    simp_rw [hsplit, Finset.sum_sub_distrib, Finset.sum_add_distrib]
    simp
    ring
  refine ⟨a,b,?_⟩
  calc
    _ ≤ ∏ i, ((2:ℝ)^((k i:ℝ)+1)) ^ s i := Finset.prod_le_prod₀
      (fun i _ => Real.rpow_nonneg (hA i) _) (fun i _ => Real.rpow_le_rpow (hA i) (hBin i) (hss i))
    _ = 2 * (2:ℝ)^(-ρ*((k b:ℝ)-k a)) * ∏ i, (2:ℝ)^((k i:ℝ)*t i) := by
      simp_rw [← Real.rpow_mul h2.le]
      rw [← Real.rpow_sum_of_pos h2, hsum, Real.rpow_add h2, Real.rpow_add h2,
        Real.rpow_one, Real.rpow_sum_of_pos h2]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hdecay (by norm_num))
      (Finset.prod_nonneg fun _ _ => by positivity)

private theorem sum_grouped_by_bin {ι : Type*} [Fintype ι] [DecidableEq ι]
    (J : ι → Finset ℤ) (κ : ι → ℤ → ℤ) (f : ι → ℤ → ℝ) (g : (ι → ℤ) → ℝ) :
    (∑ j ∈ Fintype.piFinset J, g (fun i => κ i (j i)) * ∏ i, f i (j i)) =
      ∑ k ∈ Fintype.piFinset (fun i => (J i).image (κ i)),
        g k * ∏ i, ∑ j ∈ (J i).filter (fun j => κ i j = k i), f i j := by
  classical
  let B (i : ι) := (J i).image (κ i)
  let p (j : ι → ℤ) := fun i => κ i (j i)
  have hp (j : ι → ℤ) (hj : j ∈ Fintype.piFinset J) : p j ∈ Fintype.piFinset B :=
    Fintype.mem_piFinset.mpr (fun i => Finset.mem_image_of_mem _ (Fintype.mem_piFinset.mp hj i))
  rw [← Finset.sum_fiberwise_of_maps_to hp (fun j => g (p j) * ∏ i, f i (j i))]
  apply Finset.sum_congr rfl
  intro k _
  have hset : (Fintype.piFinset J).filter (fun j => p j = k) =
      Fintype.piFinset (fun i => (J i).filter (fun j => κ i j = k i)) := by
    ext j
    simp only [Finset.mem_filter, Fintype.mem_piFinset, funext_iff, p, forall_and]
  calc
    _ = ∑ j ∈ (Fintype.piFinset J).filter (fun j => p j = k), g k * ∏ i, f i (j i) :=
      Finset.sum_congr rfl (fun j hj => by rw [(Finset.mem_filter.mp hj).2])
    _ = _ := by rw [hset, ← Finset.mul_sum, Finset.prod_univ_sum]

