/-- A finite measurable supporting set can be enlarged to any prescribed finite volume. -/
theorem pad {d : ℕ} (b : Fin d) {A : Set (Fin d → ℝ)} (hA : MeasurableSet A)
    (hAfin : volume A ≠ ∞) {h : ℝ} (hh : volume.real A ≤ h) :
    ∃ B : Set (Fin d → ℝ), MeasurableSet B ∧ A ⊆ B ∧ volume B ≠ ∞ ∧ volume.real B = h := by
  classical
  let upper (r : ℝ) (i : Fin d) := if i = b then max r 0 else 1
  let S (r : ℝ) : Set (Fin d → ℝ) := Icc 0 (upper r)
  have hSm (r : ℝ) : MeasurableSet (S r) := isClosed_Icc.measurableSet
  have hSf (r : ℝ) : volume (S r) ≠ ∞ := isCompact_Icc.measure_lt_top.ne
  have hSv (r : ℝ) : volume.real (S r) = max r 0 := by
    change volume.real (Icc 0 (upper r)) = _
    rw [measureReal_def,
      Real.volume_Icc_pi_toReal (show 0 ≤ upper r by intro i; dsimp [upper]; split <;> positivity)]
    simp only [Pi.zero_apply, sub_zero, upper, Finset.prod_ite, Finset.prod_const_one, mul_one]
    rw [show Finset.univ.filter (fun i : Fin d => i = b) = {b} by ext i; simp]
    simp
  have hSs : Monotone S := by
    intro r s hrs x hx
    refine ⟨hx.1, fun i => (hx.2 i).trans ?_⟩
    dsimp [upper]
    split
    · exact max_le_max_right _ hrs
    · rfl
  let F (r : ℝ) := (volume : Measure (Fin d → ℝ)).real (S r \ A)
  have hFf (r : ℝ) : volume (S r \ A) ≠ ∞ :=
    measure_ne_top_of_subset sdiff_subset (hSf r)
  have hFstep (r s : ℝ) (hrs : r ≤ s) : 0 ≤ F s - F r ∧ F s - F r ≤ s - r := by
    have hsub : S r \ A ⊆ S s \ A := fun x hx => ⟨hSs hrs hx.1, hx.2⟩
    refine ⟨sub_nonneg.mpr (measureReal_mono hsub (hFf s)), ?_⟩
    have hdiff : (S s \ A) \ (S r \ A) ⊆ S s \ S r := by
      intro x hx
      exact ⟨hx.1.1, fun hr => hx.2 ⟨hr, hx.1.2⟩⟩
    have hm := measureReal_mono (μ := volume) hdiff
      (measure_ne_top_of_subset sdiff_subset (hSf s))
    rw [measureReal_sdiff hsub ((hSm r).diff hA) (hFf s),
      measureReal_sdiff (hSs hrs) (hSm r) (hSf s), hSv, hSv] at hm
    change F s - F r ≤ _ at hm
    refine hm.trans ?_
    rcases le_total 0 r with hr | hr
    · rw [max_eq_left hr, max_eq_left (hr.trans hrs)]
    · rw [max_eq_right hr, sub_zero]
      exact max_le (by linarith) (sub_nonneg.mpr hrs)
  have hFc : Continuous F := by
    apply (LipschitzWith.of_dist_le_mul (K := 1) ?_).continuous
    intro r s
    simp only [NNReal.coe_one, one_mul]
    rcases le_total r s with hrs | hrs
    · rw [dist_comm r s, dist_comm (F r) (F s), Real.dist_eq, Real.dist_eq,
        abs_of_nonneg (hFstep r s hrs).1, abs_of_nonneg (sub_nonneg.mpr hrs)]
      exact (hFstep r s hrs).2
    · rw [Real.dist_eq, Real.dist_eq,
        abs_of_nonneg (hFstep s r hrs).1, abs_of_nonneg (sub_nonneg.mpr hrs)]
      exact (hFstep s r hrs).2
  have hF0 : F 0 = 0 :=
    le_antisymm ((measureReal_mono sdiff_subset (hSf 0)).trans_eq (by rw [hSv, max_self]))
      measureReal_nonneg
  have hh0 : 0 ≤ h := measureReal_nonneg.trans hh
  have hFh : h - volume.real A ≤ F h := by
    have hm := le_measureReal_sdiff (μ := volume) (s₁ := S h) hAfin
    rwa [hSv, max_eq_left hh0] at hm
  obtain ⟨r, _, hr⟩ := intermediate_value_Icc hh0 hFc.continuousOn
    (show h - volume.real A ∈ Icc (F 0) (F h) from ⟨hF0.trans_le (sub_nonneg.mpr hh), hFh⟩)
  refine ⟨A ∪ (S r \ A), hA.union ((hSm r).diff hA), subset_union_left, ?_, ?_⟩
  · exact ne_top_of_le_ne_top (ENNReal.add_ne_top.mpr ⟨hAfin, hFf r⟩) (measure_union_le _ _)
  · rw [measureReal_union disjoint_sdiff_right ((hSm r).diff hA) hAfin (hFf r)]
    change volume.real A + F r = h
    rw [hr]
    ring

private theorem prod_sub_recorded {ι : Type*} [DecidableEq ι]
    (I : Finset ι) (X e : ι → ℝ) :
    (∏ i ∈ I, X i) = (∏ i ∈ I, (X i - e i)) +
      ∑ D ∈ I.powerset.erase ∅, (-1 : ℝ)^(D.card+1) *
        ∏ i ∈ I, (if i ∈ D then e i else X i) := by
  classical
  have hm (D : Finset ι) (hD : D ⊆ I) :
      (∏ i ∈ I, (if i ∈ D then e i else X i)) =
        (∏ i ∈ I \ D, X i) * ∏ i ∈ D, e i := by
    rw [Finset.prod_ite, mul_comm]
    congr 1
    · apply Finset.prod_congr _ (fun _ _ => rfl)
      ext i
      simp
    · apply Finset.prod_congr _ (fun _ _ => rfl)
      ext i
      simp only [Finset.mem_filter, and_iff_right_iff_imp]
      exact fun hi => hD hi
  rw [Finset.prod_sub X e I, ← Finset.sum_erase_add _ _ (Finset.empty_mem_powerset I)]
  simp only [Finset.card_empty, pow_zero, one_mul, Finset.sdiff_empty, Finset.prod_empty, mul_one]
  have hz : (∑ D ∈ I.powerset.erase ∅, (-1 : ℝ)^D.card *
      (∏ i ∈ I \ D, X i) * ∏ i ∈ D, e i) +
      (∑ D ∈ I.powerset.erase ∅, (-1 : ℝ)^(D.card+1) *
        ∏ i ∈ I, (if i ∈ D then e i else X i)) = 0 := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_eq_zero
    intro D hD
    rw [hm D (Finset.mem_powerset.mp (Finset.mem_of_mem_erase hD)), pow_succ]
    ring
  linarith

private theorem mixedLowPath_at_time {d : ℕ} (u : ℤ) (δ : ℝ) (D : Finset (Fin d))
    (f : Fin d → (Fin d → ℝ) → ℝ) (i : Fin d) (k : ℕ) (x : Fin d → ℝ) :
    mixedLowPath u δ D f i (u+k) x =
      if i ∈ D then coordinateResidual i u δ (f i) k x else coordinateLowPath i u (f i) k x := by
  by_cases hi : i ∈ D <;> simp [mixedLowPath, coordinateLowPath, hi]

private theorem coordinateMartingalePath_increment {d : ℕ} (b : Fin d) (u : ℤ)
    (c : ℕ → ℝ) (f : (Fin d → ℝ) → ℝ) (k : ℕ) (x : Fin d → ℝ) :
    coordinateMartingalePath b u 0 c f (k+1) x -
        coordinateMartingalePath b u 0 c f k x =
      c k * coordinateDifference b (u+k) f x := by
  simp [coordinateMartingalePath, coordinateTransform, Finset.sum_range_succ]

private theorem choose_recording_scale (d : ℕ) {m q : ℝ} (hm : 1/q < m) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {R : ℝ}, 1 ≤ R →
      ∃ N : ℕ, 1 ≤ N ∧ R * (((2 : ℝ)^N)⁻¹)^((1/2 : ℝ)^d) ≤ 1 ∧
        ((N+1 : ℕ) : ℝ)^d * R^(1/q) ≤ C * R^m := by
  let P := (2:ℝ)^d / Real.log 2
  let a := m-1/q
  let D := max 2 (P/a)
  have ha : 0 < a := sub_pos.mpr hm
  have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hP : 0 < P := div_pos (by positivity) hlog
  have hD : 0 < D := (by norm_num : (0:ℝ) < 2).trans_le (le_max_left _ _)
  refine ⟨D^d * (d.factorial : ℝ) * Real.exp 1, by positivity, ?_⟩
  intro R hR
  let x := Real.log R
  have hx : 0 ≤ x := Real.log_nonneg hR
  have hR₀ : 0 < R := zero_lt_one.trans_le hR
  let N := max 1 ⌈P*x⌉₊
  have hNx : P*x ≤ (N : ℝ) := (Nat.le_ceil _).trans (Nat.cast_le.mpr (le_max_right _ _))
  have hN : (N : ℝ) ≤ P*x+1 := by
    dsimp [N]
    rw [Nat.cast_max, Nat.cast_one]
    apply max_le (le_add_of_nonneg_left (mul_nonneg hP.le hx))
    have h := (abs_le.mp (Nat.abs_sub_ceil_le (mul_nonneg hP.le hx))).1
    linarith
  refine ⟨N, le_max_left _ _, ?_, ?_⟩
  · have h2 : (0:ℝ) < 2 := by norm_num
    have hz : (0:ℝ) < (2:ℝ)^d := pow_pos h2 _
    have hNx' : x ≤ (N : ℝ) * Real.log 2 / (2:ℝ)^d := by
      apply (le_div_iff₀ hz).mpr
      have h := (div_le_iff₀ hlog).mp (show ((2:ℝ)^d*x)/Real.log 2 ≤ (N:ℝ) by
        simpa only [P, div_mul_eq_mul_div] using hNx)
      simpa only [mul_comm x] using h
    have hδ : (((2 : ℝ)^N)⁻¹)^((1/2 : ℝ)^d) =
        Real.exp (-((N : ℝ) * Real.log 2 / (2:ℝ)^d)) := by
      rw [Real.rpow_def_of_pos (inv_pos.mpr (pow_pos h2 _)), Real.log_inv, Real.log_pow,
        one_div, inv_pow, div_eq_mul_inv]
      ring
    rw [hδ, ← Real.exp_log hR₀, ← Real.exp_add, ← Real.exp_zero, Real.exp_le_exp]
    change x + -((N : ℝ) * Real.log 2 / (2:ℝ)^d) ≤ 0
    linarith
  · have hPa : P ≤ D*a := (div_le_iff₀ ha).mp (le_max_right _ _)
    have hNx' : ((N+1 : ℕ) : ℝ) ≤ D*(a*x+1) := by
      have h := mul_le_mul_of_nonneg_right hPa hx
      have hD₂ : 2 ≤ D := le_max_left _ _
      push_cast
      nlinarith
    have hax : 0 ≤ a*x+1 := by positivity
    have hT := (div_le_iff₀ (by positivity : 0 < (d.factorial : ℝ))).mp
      (Real.pow_div_factorial_le_exp _ hax d)
    have hpow : ((N+1 : ℕ) : ℝ)^d ≤ D^d * (Real.exp (a*x+1) * d.factorial) := by
      calc
        _ ≤ (D*(a*x+1))^d := pow_le_pow_left₀ (by positivity) hNx' _
        _ = D^d * (a*x+1)^d := mul_pow _ _ _
        _ ≤ _ := mul_le_mul_of_nonneg_left hT (by positivity)
    refine (mul_le_mul_of_nonneg_right hpow (Real.rpow_nonneg hR₀.le _)).trans_eq ?_
    rw [Real.rpow_def_of_pos hR₀, Real.rpow_def_of_pos hR₀]
    change D^d * (Real.exp (a*x+1) * d.factorial) * Real.exp (x*(1/q)) =
      D^d * d.factorial * Real.exp 1 * Real.exp (x*m)
    have he : a*x+1 + x*(1/q) = 1 + x*m := by dsimp [a]; ring
    calc
      _ = D^d * d.factorial * (Real.exp (a*x+1) * Real.exp (x*(1/q))) := by ring
      _ = _ := by rw [← Real.exp_add, he, Real.exp_add]; ring

private theorem pruned_recording_expansion {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) (A₀ : Set (Fin d → ℝ)) (τ : Fin d → ℝ) {δ : ℝ} (hδ : 0 ≤ δ)
    (H : (Fin d → ℝ) → ℝ) (f : Fin d → (Fin d → ℝ) → ℝ)
    (hHI : Integrable H) (hf : ∀ i, Measurable (f i))
    (hG : ∀ i x, |prunedInput i A₀ (τ i) (f i) x| ≤ 1)
    (hA₀ : MeasurableSet A₀) :
    let G i := prunedInput i A₀ (τ i) (f i)
    let Y := coordinateMartingalePath b u 0 c (G b)
    dyadicForm b u T c H G =
      (∫ x, H x * pathPairing
        (fun k => ∏ i : {i : Fin d // i ≠ b},
          recordedPath (coordinateLowPath i u (G i)) δ true k x)
        (fun k => Y k x) T) +
      ∑ D ∈ (({b} : Finset (Fin d))ᶜ.powerset.erase ∅), (-1 : ℝ)^(D.card+1) *
        maskedMixedDyadicForm b u T c (pruningTester u T A₀ τ H) G δ D := by
  classical
  dsimp only
  let G i := prunedInput i A₀ (τ i) (f i)
  let I := ({b} : Finset (Fin d))ᶜ
  let X i k x := coordinateLowPath i u (G i) k x
  let e i k x := coordinateResidual i u δ (G i) k x
  let L (D : Finset (Fin d)) i k x := if i ∈ D then e i k x else X i k x
  let high (k : ℕ) := coordinateDifference b (u+k) (G b)
  let P k x := ∏ i ∈ I, (X i k x - e i k x)
  let Q (D : Finset (Fin d)) k x := ∏ i ∈ I, L D i k x
  let s (D : Finset (Fin d)) := (-1:ℝ)^(D.card+1)
  have hsub (g : Fin d → ℝ) : (∏ i : {i : Fin d // i ≠ b}, g i) = ∏ i ∈ I, g i :=
    (Finset.prod_subtype I (by simp [I]) g).symm
  have hGm (i : Fin d) : Measurable (G i) := by
    refine (hf i).indicator (MeasurableSet.compl ?_)
    exact measurableSet_coordinateMaxLevel i (measurable_const.indicator hA₀) (τ i)
  have hXm i k : Measurable (X i k) := measurable_coordinateAverage i _ (hGm i)
  have hem i k : Measurable (e i k) := measurable_coordinateResidual i u δ (hGm i) k
  have hQm D k : Measurable (Q D k) :=
    Finset.measurable_fun_prod I fun i _ => by by_cases hi : i ∈ D <;> simp [L, hi, hem, hXm]
  have hPm k : Measurable (P k) :=
    Finset.measurable_fun_prod I fun i _ => (hXm i k).sub (hem i k)
  have hhighm k : Measurable (high k) :=
    (measurable_coordinateAverage b _ (hGm b)).sub (measurable_coordinateAverage b _ (hGm b))
  have hX i k x : |X i k x| ≤ 1 := abs_coordinateAverage_le i _ (hG i) x
  have he i k x : |e i k x| ≤ δ :=
    recordedPath_tracking (coordinateLowPath i u (G i)) hδ true k x
  have hhigh k x : |high k x| ≤ 2 := by
    refine (abs_sub _ _).trans ?_
    simpa only [one_add_one_eq_two] using add_le_add
      (abs_coordinateAverage_le b (u+k+1) (hG b) x) (abs_coordinateAverage_le b (u+k) (hG b) x)
  have hint (k : ℕ) (p : (Fin d → ℝ) → ℝ) (hp : Measurable p) (C : ℝ)
      (hC : ∀ x, |p x| ≤ C) : Integrable (fun x => H x * (high k x * p x)) := by
    apply hHI.mul_bdd (c := 2*C) (hhighm k |>.mul hp).aestronglyMeasurable
    filter_upwards [] with x
    change ‖high k x * p x‖ ≤ 2 * C
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul (hhigh k x) (hC x) (abs_nonneg _) (by norm_num)
  have hPi k : Integrable (fun x => H x * (high k x * P k x)) := by
    refine hint k _ (hPm k) ((1+δ)^I.card) (fun x => ?_)
    rw [Finset.abs_prod, ← Finset.prod_const]
    exact Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _) (fun i _ =>
      (abs_sub _ _).trans (add_le_add (hX i k x) (he i k x)))
  have hQi D k : Integrable (fun x => H x * (high k x * Q D k x)) := by
    refine hint k _ (hQm D k) ((max 1 δ)^I.card) (fun x => ?_)
    rw [Finset.abs_prod, ← Finset.prod_const]
    apply Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _)
    intro i _
    by_cases hi : i ∈ D
    · exact (by simpa only [L, ite_eq_left hi] using he i k x : |L D i k x| ≤ δ).trans (le_max_right _ _)
    · exact (by simpa only [L, ite_eq_right hi] using hX i k x : |L D i k x| ≤ 1).trans (le_max_left _ _)
  have htest (k : ℕ) (hk : k ∈ Finset.range T) (D : Finset (Fin d)) (x : Fin d → ℝ) :
      H x * (high k x * Q D k x) =
        pruningTester u T A₀ τ H k x *
          (∏ i ∈ I, mixedLowPath u δ D G i (u+k) x) * high k x := by
    have h := pruningTester_mul_eq b u (Finset.mem_range.mp hk) A₀ τ δ H f D x
    dsimp only at h
    simp_rw [mixedLowPath_at_time]
    rw [hsub (fun i => L D i k x)] at h
    change H x * (high k x * Q D k x) =
      pruningTester u T A₀ τ H k x * (high k x * Q D k x) at h
    rw [h]
    dsimp only [Q, L, e, X]
    ring
  have hrecord :
      (∫ x, H x * pathPairing (fun k => ∏ i : {i : Fin d // i ≠ b},
        recordedPath (coordinateLowPath i u (G i)) δ true k x)
        (fun k => coordinateMartingalePath b u 0 c (G b) k x) T) =
      ∑ k ∈ Finset.range T, c k * ∫ x, H x * (high k x * P k x) := by
    unfold pathPairing
    have hrecprod (k : ℕ) (x : Fin d → ℝ) :
        (∏ i : {i : Fin d // i ≠ b}, recordedPath (coordinateLowPath i u (G i)) δ true k x) =
          ∏ i ∈ I, recordedPath (coordinateLowPath i u (G i)) δ true k x :=
      hsub (fun i => recordedPath (coordinateLowPath i u (G i)) δ true k x)
    simp_rw [coordinateMartingalePath_increment, hrecprod, Finset.mul_sum]
    have heq (k : ℕ) (x : Fin d → ℝ) :
        H x * ((∏ i ∈ I, recordedPath (coordinateLowPath i u (G i)) δ true k x) *
          (c k * high k x)) = c k * (H x * (high k x * P k x)) := by
      have hp : P k x = ∏ i ∈ I, recordedPath (coordinateLowPath i u (G i)) δ true k x := by
        simp [P, X, e, coordinateResidual]
      rw [hp]
      ring
    rw [show (fun x => ∑ k ∈ Finset.range T,
      H x * ((∏ i ∈ I, recordedPath (coordinateLowPath i u (G i)) δ true k x) *
        (c k * high k x))) = (fun x => ∑ k ∈ Finset.range T,
          c k * (H x * (high k x * P k x))) by
      funext x
      exact Finset.sum_congr rfl (fun k _ => heq k x)]
    rw [integral_finsetSum _ (fun k _ => (hPi k).const_mul (c k))]
    simp_rw [integral_const_mul]
  rw [hrecord]
  unfold dyadicForm maskedMixedDyadicForm
  simp_rw [Finset.mul_sum]
  have hprod (k : ℕ) (x : Fin d → ℝ) :
      (∏ i : {i : Fin d // i ≠ b}, coordinateAverage i (u+k) (G i) x) = ∏ i ∈ I, X i k x :=
    hsub (fun i => X i k x)
  rw [Finset.sum_comm (s := I.powerset.erase ∅), ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k hk
  rw [show (fun x => H x * high k x *
      ∏ i : {i : Fin d // i ≠ b}, coordinateAverage i (u+k) (G i) x) =
      (fun x => H x * high k x * ∏ i ∈ I, X i k x) by funext x; rw [hprod k x]]
  have htestInt (D : Finset (Fin d)) :
      (∫ x, pruningTester u T A₀ τ H k x *
        (∏ i ∈ I, mixedLowPath u δ D G i (u+k) x) * high k x) =
      ∫ x, H x * (high k x * Q D k x) :=
    integral_congr_ae (Filter.Eventually.of_forall fun x => (htest k hk D x).symm)
  have hmask :
      (∑ D ∈ I.powerset.erase ∅, s D * (c k * ∫ x, pruningTester u T A₀ τ H k x *
          (∏ i ∈ I, mixedLowPath u δ D G i (u+k) x) * high k x)) =
        ∑ D ∈ I.powerset.erase ∅, s D * (c k * ∫ x, H x * (high k x * Q D k x)) :=
    Finset.sum_congr rfl (fun D _ => congrArg (fun v => s D * (c k * v)) (htestInt D))
  change c k * (∫ x, H x * high k x * ∏ i ∈ I, X i k x) =
    c k * (∫ x, H x * (high k x * P k x)) +
      (∑ D ∈ I.powerset.erase ∅, s D * (c k * ∫ x, pruningTester u T A₀ τ H k x *
        (∏ i ∈ I, mixedLowPath u δ D G i (u+k) x) * high k x))
  rw [hmask]
  have hstep : (∫ x, H x * high k x * ∏ i ∈ I, X i k x) =
      (∫ x, H x * (high k x * P k x)) +
        ∑ D ∈ I.powerset.erase ∅, s D * ∫ x, H x * (high k x * Q D k x) := by
    simp_rw [← integral_const_mul]
    rw [← integral_finsetSum _ (fun D _ => (hQi D k).const_mul (s D)),
      ← integral_add (hPi k) (integrable_finsetSum _ fun D _ => (hQi D k).const_mul (s D))]
