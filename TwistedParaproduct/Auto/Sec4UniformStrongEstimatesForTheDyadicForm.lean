private theorem combined_layer_sum {ι : Type*} [Fintype ι] [DecidableEq ι] (o : ι)
    (t : ι → ℝ) (ht : ∀ i, 0 < t i) (ht₁ : ∑ i, t i = 1)
    {ρ : ℝ} (hρ : 0 < ρ) (htρ : ∀ i, ρ < t i)
    (J : ι → Finset ℤ) (κ : ι → ℤ → ℤ) (A : ι → ℤ → ℝ)
    (hA : ∀ i j, 0 ≤ A i j)
    (hBin : ∀ i j, j ∈ J i → A i j ≤ (2:ℝ)^((κ i j:ℝ)+1))
    (M : ι → ℝ) (hM : ∀ i, 0 ≤ M i)
    (hMass : ∀ i, ∑ j ∈ J i, (2:ℝ)^((j:ℝ)/t i+κ i j) ≤ M i)
    {C : ℝ} (hC : 0 ≤ C) (F : (ι → ℤ) → ℝ)
    (hF : ∀ j ∈ Fintype.piFinset J, ∀ a b,
      F j ≤ C * (∏ i, (2:ℝ)^(j i+1 : ℤ)) * ∏ i, A i (j i)^shiftExponent t ρ a b i) :
    let r := (2:ℝ)^(-ρ/Fintype.card ι)
    (∑ j ∈ Fintype.piFinset J, F j) ≤
      (2 * (4:ℝ)^(Fintype.card ι) * (2*(1-r)⁻¹)^(Fintype.card ι) * C) *
        ∏ i, M i ^ t i := by
  classical
  dsimp only
  let n := Fintype.card ι
  let r := (2:ℝ)^(-ρ/n)
  let B (i : ι) := (J i).image (κ i)
  let D (k : ι → ℤ) := ∏ i, r^((k i-k o).natAbs)
  let V (i : ι) (k : ℤ) := ∑ j ∈ (J i).filter (fun j => κ i j = k), (2:ℝ)^((j:ℝ)/t i+k)
  let W (i : ι) (j : ℤ) := (2:ℝ)^j*(2:ℝ)^((κ i j:ℝ)*t i)
  have hn : 0 < (n:ℝ) := by
    haveI : Nonempty ι := ⟨o⟩
    exact_mod_cast Fintype.card_pos
  have hr : 0 ≤ r := by dsimp [r]; positivity
  have hr₁ : r < 1 := by
    dsimp [r]
    rw [← Real.rpow_zero (2:ℝ), Real.rpow_lt_rpow_left_iff (by norm_num)]
    exact div_neg_of_neg_of_pos (neg_neg_of_pos hρ) hn
  have hv i k : 0 ≤ V i k := Finset.sum_nonneg (fun _ _ => by positivity)
  have hD k : 0 ≤ D k := Finset.prod_nonneg (fun _ _ => pow_nonneg hr _)
  have hVsum i (S : Finset ℤ) : ∑ k ∈ S, V i k ≤ M i := by
    have hEq (k : ℤ) :
        V i k = ∑ j ∈ (J i).filter (fun j => κ i j = k), (2:ℝ)^((j:ℝ)/t i+κ i j) := by
      dsimp only [V]
      apply Finset.sum_congr rfl
      intro j hj
      rw [(Finset.mem_filter.mp hj).2]
    simp_rw [hEq]
    rw [Finset.sum_fiberwise_eq_sum_filter]
    exact (Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
      (fun _ _ _ => by positivity)).trans (hMass i)
  have hGrouped (i : ι) (k : ℤ) :
      (∑ j ∈ (J i).filter (fun j => κ i j = k), W i j) ≤ 2 * V i k ^ t i := by
    have hx : (∑ j ∈ (J i).filter (fun j => κ i j = k), W i j) =
        ∑ j ∈ (J i).filter (fun j => κ i j = k), (2:ℝ)^j * (2:ℝ)^((k:ℝ)*t i) := by
      apply Finset.sum_congr rfl
      intro j hj
      dsimp only [W]
      rw [(Finset.mem_filter.mp hj).2]
    rw [hx]
    exact grouped_amplitude_le _ _ (ht i)
  have hper (j : ι → ℤ) (hj : j ∈ Fintype.piFinset J) :
      F j ≤ (2*(2:ℝ)^n*C) * (D (fun i => κ i (j i))*∏ i, W i (j i)) := by
    obtain ⟨a,b,hb⟩ := bin_weight_shift_bound o t ht₁ hρ htρ (fun i => κ i (j i))
      (fun i => A i (j i)) (fun i => hA i _) (fun i => hBin i _ (Fintype.mem_piFinset.mp hj i))
    refine (hF j hj a b).trans ((mul_le_mul_of_nonneg_left hb (by positivity)).trans_eq ?_)
    have hz (i : ι) : (2:ℝ)^(j i+1 : ℤ) = 2*(2:ℝ)^(j i) := by
      rw [zpow_add₀ (by norm_num : (2:ℝ) ≠ 0), zpow_one, mul_comm]
    simp_rw [hz, W, Finset.prod_mul_distrib]
    simp [D, r, n]
    ring
  change (∑ j ∈ Fintype.piFinset J, F j) ≤ _
  refine (Finset.sum_le_sum hper).trans ?_
  rw [← Finset.mul_sum, sum_grouped_by_bin J κ W D]
  have hgroup : (∑ k ∈ Fintype.piFinset B, D k *
      ∏ i, ∑ j ∈ (J i).filter (fun j => κ i j = k i), W i j) ≤
      (2:ℝ)^n * ∑ k ∈ Fintype.piFinset B, D k * ∏ i, V i (k i)^t i := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro k _
    have hf := Finset.prod_le_prod₀ (s := (Finset.univ : Finset ι))
      (fun i _ => show 0 ≤ ∑ j ∈ (J i).filter (fun j => κ i j = k i), W i j from
        Finset.sum_nonneg (fun j _ => by dsimp [W]; positivity)) (fun i _ => hGrouped i (k i))
    refine (mul_le_mul_of_nonneg_left hf (hD k)).trans_eq ?_
    rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, mul_left_comm]
  refine (mul_le_mul_of_nonneg_left hgroup (by positivity)).trans ?_
  have hconv := weighted_bin_sum_le o B t ht ht₁ V hv M hM hVsum hr hr₁
  change (∑ k ∈ Fintype.piFinset B, D k * ∏ i, V i (k i)^t i) ≤
    (2*(1-r)⁻¹)^n * ∏ i, M i ^ t i at hconv
  refine (mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_left hconv (by positivity)) (by positivity)).trans_eq ?_
  change (2*2^n*C)*((2:ℝ)^n*((2*(1-r)⁻¹)^n * ∏ i, M i ^ t i)) =
    (2*(4:ℝ)^n*(2*(1-r)⁻¹)^n*C) * ∏ i, M i ^ t i
  rw [show (4:ℝ)^n = 2^n*2^n by rw [← mul_pow]; norm_num]
  ring

/-- Simple functions whose support has finite measure. -/
def finiteSimpleFunctions {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) :
    Submodule ℂ (SimpleFunc Ω ℂ) where
  carrier := {f | Integrable (⇑f) μ}
  zero_mem' := by simp
  add_mem' {f g} hf hg := by
    change Integrable (⇑(f+g)) μ
    simpa only [SimpleFunc.coe_add] using (show Integrable (⇑f) μ from hf).add
      (show Integrable (⇑g) μ from hg)
  smul_mem' c f hf := by
    change Integrable (⇑(c • f)) μ
    simpa only [SimpleFunc.coe_smul] using (show Integrable (⇑f) μ from hf).smul c

private noncomputable def dyadicLogFloor (r : ℝ) : ℤ := ⌊Real.logb 2 r⌋

private theorem dyadicLogFloor_bounds {r : ℝ} (hr : 0 < r) :
    (2:ℝ)^dyadicLogFloor r ≤ r ∧ r < (2:ℝ)^(dyadicLogFloor r+1 : ℤ) := by
  have h2 : (1:ℝ) < 2 := by norm_num
  have h := Int.floor_le (Real.logb 2 r)
  have h' := Int.lt_floor_add_one (Real.logb 2 r)
  unfold dyadicLogFloor
  constructor
  · rw [← Real.rpow_intCast, ← Real.le_logb_iff_rpow_le h2 hr]
    exact h
  · rw [← Real.rpow_intCast, ← Real.logb_lt_iff_lt_rpow h2 hr, Int.cast_add, Int.cast_one]
    exact h'

private noncomputable def simpleAmplitudes {Ω : Type*} [MeasurableSpace Ω]
    (f : SimpleFunc Ω ℂ) : Finset ℤ :=
  (f.range.erase 0).image fun z => dyadicLogFloor ‖z‖

private def simpleLayerSet {Ω : Type*} [MeasurableSpace Ω]
    (f : SimpleFunc Ω ℂ) (j : ℤ) : Set Ω :=
  {x | f x ≠ 0 ∧ dyadicLogFloor ‖f x‖ = j}

private theorem simpleLayerSet_measurable {Ω : Type*} [MeasurableSpace Ω]
    (f : SimpleFunc Ω ℂ) (j : ℤ) : MeasurableSet (simpleLayerSet f j) :=
  f.measurableSet_preimage {z | z ≠ 0 ∧ dyadicLogFloor ‖z‖ = j}

private theorem simpleLayerSet_finite {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (f : finiteSimpleFunctions μ) (j : ℤ) : μ (simpleLayerSet f.1 j) ≠ ∞ := by
  have hf : Integrable (⇑f.1) μ := f.2
  exact measure_ne_top_of_subset (fun x hx => hx.1)
    (SimpleFunc.finMeasSupp_iff_support.mp (SimpleFunc.integrable_iff_finMeasSupp.mp hf)).ne

private noncomputable def simpleNormalizedLayer {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (f : finiteSimpleFunctions μ) (j : ℤ) : finiteSimpleFunctions μ := by
  let c : ℂ := (((2:ℝ)^(j+1 : ℤ))⁻¹ : ℝ)
  refine ⟨c • f.1.restrict (simpleLayerSet f.1 j), ?_⟩
  have hf : Integrable (⇑f.1) μ := f.2
  change Integrable (⇑(c • f.1.restrict (simpleLayerSet f.1 j))) μ
  rw [SimpleFunc.coe_smul, f.1.coe_restrict (simpleLayerSet_measurable f.1 j)]
  exact (hf.indicator (simpleLayerSet_measurable f.1 j)).smul c

private theorem simpleNormalizedLayer_apply {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (f : finiteSimpleFunctions μ) (j : ℤ) (x : Ω) :
    (simpleNormalizedLayer f j).1 x = (((2:ℝ)^(j+1:ℤ))⁻¹ : ℝ) *
      (simpleLayerSet f.1 j).indicator (⇑f.1) x := by
  simp only [simpleNormalizedLayer, SimpleFunc.coe_smul, Pi.smul_apply, smul_eq_mul,
    SimpleFunc.restrict_apply f.1 (simpleLayerSet_measurable f.1 j)]

private theorem simpleNormalizedLayer_norm {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (f : finiteSimpleFunctions μ) (j : ℤ) (x : Ω) :
    ‖(simpleNormalizedLayer f j).1 x‖ ≤ (simpleLayerSet f.1 j).indicator (fun _ => (1:ℝ)) x := by
  rw [simpleNormalizedLayer_apply]
  by_cases hx : x ∈ simpleLayerSet f.1 j
  · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    have hv : ‖f.1 x‖ < (2:ℝ)^(j+1 : ℤ) := by
      obtain ⟨hx₀,hbin⟩ := hx
      exact hbin ▸ (dyadicLogFloor_bounds (norm_pos_iff.mpr hx₀)).2
    exact (inv_mul_le_one₀ (by positivity)).mpr hv.le
  · simp [hx]

private theorem simple_amplitude_decomposition {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (f : finiteSimpleFunctions μ) :
    (∑ j ∈ simpleAmplitudes f.1, (((2:ℝ)^(j+1:ℤ) : ℝ) : ℂ) • simpleNormalizedLayer f j) = f := by
  classical
  apply Subtype.ext
  apply SimpleFunc.ext
  intro x
  let L : finiteSimpleFunctions μ →+ ℂ :=
    ⟨⟨fun g => g.1 x, rfl⟩, fun _ _ => rfl⟩
  change L (∑ j ∈ simpleAmplitudes f.1, (((2:ℝ)^(j+1:ℤ) : ℝ) : ℂ) •
    (simpleNormalizedLayer f j)) = f.1 x
  rw [map_sum]
  have hterm (j : ℤ) :
      L ((((2:ℝ)^(j+1:ℤ) : ℝ) : ℂ) • simpleNormalizedLayer f j) =
      (simpleLayerSet f.1 j).indicator (⇑f.1) x := by
    change (((2:ℝ)^(j+1:ℤ) : ℝ) : ℂ) * (simpleNormalizedLayer f j).1 x = _
    rw [simpleNormalizedLayer_apply, ← mul_assoc,
      ← Complex.ofReal_mul, mul_inv_cancel₀ (by positivity : (2:ℝ)^(j+1:ℤ) ≠ 0),
      Complex.ofReal_one, one_mul]
  simp_rw [hterm]
  by_cases hfx : f.1 x = 0
  · simp [hfx, simpleLayerSet]
  · let j₀ := dyadicLogFloor ‖f.1 x‖
    have hj₀ : j₀ ∈ simpleAmplitudes f.1 :=
      Finset.mem_image_of_mem _ (Finset.mem_erase.mpr ⟨hfx, f.1.mem_range_self x⟩)
    rw [Finset.sum_eq_single j₀]
    · exact Set.indicator_of_mem (show x ∈ simpleLayerSet f.1 j₀ from ⟨hfx,rfl⟩) _
    · intro j _ hj
      exact Set.indicator_of_notMem (fun h => hj h.2.symm) _
    · exact fun h => False.elim (h hj₀)

private theorem amplitude_layer_energy {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (f : finiteSimpleFunctions μ) (J : Finset ℤ) {t : ℝ} (ht : 0 < t)
    (hJ : ∀ j ∈ J, 0 < μ.real (simpleLayerSet f.1 j)) :
    (∑ j ∈ J, (2:ℝ)^((j:ℝ)/t+dyadicLogFloor (μ.real (simpleLayerSet f.1 j)))) ≤
      ∫ x, ‖f.1 x‖^(1/t) ∂μ := by
  classical
  let B := simpleLayerSet f.1
  let U (j : ℤ) := (2:ℝ)^((j:ℝ)/t)
  let h (j : ℤ) := (B j).indicator (fun _ : Ω => U j)
  have hU j : 0 ≤ U j := by dsimp [U]; positivity
  have hInt j : Integrable (h j) μ := by
    change Integrable ((B j).indicator (fun _ => U j)) μ
    rw [integrable_indicator_iff (simpleLayerSet_measurable f.1 j)]
    let : IsFiniteMeasure (μ.restrict (B j)) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact (simpleLayerSet_finite f j).lt_top⟩
    exact integrable_const _
  have hIntf : Integrable (fun x => ‖f.1 x‖^(1/t)) μ := by
    let g := f.1.map (fun z => ‖z‖^(1/t))
    have hf : Integrable (⇑f.1) μ := f.2
    have h := (SimpleFunc.integrable_iff_finMeasSupp.mp hf).map
      (g := fun z : ℂ => ‖z‖^(1/t)) (by
        rw [norm_zero, Real.zero_rpow (by positivity : 1/t ≠ 0)])
    exact SimpleFunc.integrable_iff_finMeasSupp.mpr (show g.FinMeasSupp μ from h)
  have hPt (x : Ω) : (∑ j ∈ J, h j x) ≤ ‖f.1 x‖^(1/t) := by
    by_cases hx : f.1 x = 0
    · have hz (j : ℤ) : h j x = 0 := by simp [h, B, simpleLayerSet, hx]
      simp only [hz, Finset.sum_const_zero]
      positivity
    · let j₀ := dyadicLogFloor ‖f.1 x‖
      have ho (j : ℤ) (hj : j ≠ j₀) : h j x = 0 :=
        Set.indicator_of_notMem (fun hh => hj hh.2.symm) _
      by_cases hj₀ : j₀ ∈ J
      · rw [Finset.sum_eq_single_of_mem j₀ hj₀ (fun j _ hj => ho j hj)]
        change (B j₀).indicator (fun _ => U j₀) x ≤ _
        rw [Set.indicator_of_mem (show x ∈ B j₀ from ⟨hx,rfl⟩)]
        unfold U
        rw [show (j₀:ℝ)/t = (j₀:ℝ)*(1/t) by ring]
        exact (Real.rpow_intCast_mul (by norm_num : 0 ≤ (2:ℝ)) j₀ (1/t)).le.trans
          (Real.rpow_le_rpow (by positivity) (dyadicLogFloor_bounds (norm_pos_iff.mpr hx)).1 (by positivity))
      · have hz (j : ℤ) (hj : j ∈ J) : h j x = 0 := ho j (fun he => hj₀ (he ▸ hj))
        rw [Finset.sum_eq_zero hz]
        positivity
  calc
    _ ≤ ∑ j ∈ J, U j * μ.real (B j) := by
      apply Finset.sum_le_sum
      intro j hj
      rw [Real.rpow_add (by norm_num), Real.rpow_intCast]
      exact mul_le_mul_of_nonneg_left (dyadicLogFloor_bounds (hJ j hj)).1 (hU j)
    _ = ∑ j ∈ J, ∫ x, h j x ∂μ := by
      apply Finset.sum_congr rfl
      intro j _
      change U j * μ.real (B j) = ∫ x, (B j).indicator (fun _ => U j) x ∂μ
      rw [integral_indicator (simpleLayerSet_measurable f.1 j), setIntegral_const, smul_eq_mul, mul_comm]
    _ = ∫ x, ∑ j ∈ J, h j x ∂μ := (integral_finsetSum J (fun j _ => hInt j)).symm
    _ ≤ _ := integral_mono (integrable_finsetSum J (fun j _ => hInt j)) hIntf hPt

set_option maxHeartbeats 1000000 in
/-- Restricted interpolation at the finitely many shifts of a positive Hölder tuple. -/
theorem interp {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι] [DecidableEq ι]
    (μ : Measure Ω) (o : ι) (t : ι → ℝ) (ht : ∀ i, 0 < t i) (ht₁ : ∑ i, t i = 1)
    {ρ : ℝ} (hρ : 0 < ρ) (htρ : ∀ i, ρ < t i)
    (C : ℝ) (hC : 0 ≤ C)
    (Λ : MultilinearMap ℂ (fun _ : ι => finiteSimpleFunctions μ) ℂ)
    (hR : ∀ (a b : ι) (B : ι → Set Ω) (f : ι → finiteSimpleFunctions μ),
      (∀ i, MeasurableSet (B i) ∧ μ (B i) ≠ ∞ ∧
        ∀ x, ‖(f i).1 x‖ ≤ (B i).indicator (fun _ => (1:ℝ)) x) →
      ‖Λ f‖ ≤ C * ∏ i, μ.real (B i) ^ shiftExponent t ρ a b i) :
    let r := (2:ℝ)^(-ρ/Fintype.card ι)
    let C' := 2*(4:ℝ)^(Fintype.card ι)*(2*(1-r)⁻¹)^(Fintype.card ι)*C
    ∀ f : ι → finiteSimpleFunctions μ,
      ‖Λ f‖ ≤ C'*∏ i, lpNorm (⇑(f i).1) (ENNReal.ofReal (1/t i)) μ := by
  classical
  dsimp only
  let r := (2:ℝ)^(-ρ/Fintype.card ι)
  let C' := 2*(4:ℝ)^(Fintype.card ι)*(2*(1-r)⁻¹)^(Fintype.card ι)*C
  intro f
  let J₀ (i : ι) := simpleAmplitudes (f i).1
  let B (i : ι) (j : ℤ) := simpleLayerSet (f i).1 j
  let A (i : ι) (j : ℤ) := μ.real (B i j)
  let J (i : ι) := (J₀ i).filter (fun j => 0 < A i j)
  let κ (i : ι) (j : ℤ) := dyadicLogFloor (A i j)
  let M (i : ι) := ∫ x, ‖(f i).1 x‖^(1/t i) ∂μ
  let L (i : ι) (j : ℤ) := simpleNormalizedLayer (f i) j
  let a (j : ℤ) : ℂ := ((2:ℝ)^(j+1 : ℤ) : ℝ)
  let F (j : ι → ℤ) := ‖Λ (fun i => a (j i) • L i (j i))‖
  have hR' (j : ι → ℤ) (u v : ι) :
      F j ≤ C * (∏ i, (2:ℝ)^(j i+1 : ℤ)) *
        ∏ i, A i (j i) ^ shiftExponent t ρ u v i := by
    have hcoeff (i : ι) : ‖a (j i)‖ = (2:ℝ)^(j i+1 : ℤ) := by
      dsimp [a]
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    have hbound := hR u v (fun i => B i (j i)) (fun i => L i (j i))
      (fun i => ⟨simpleLayerSet_measurable _ _, simpleLayerSet_finite _ _,
        simpleNormalizedLayer_norm _ _⟩)
    dsimp only [F]
    rw [Λ.map_smul_univ, norm_smul, norm_prod]
    simp_rw [hcoeff]
    exact (mul_le_mul_of_nonneg_left hbound (Finset.prod_nonneg fun _ _ => by positivity)).trans_eq (by
      change (∏ i, (2:ℝ)^(j i+1 : ℤ))*(C*∏ i, A i (j i)^shiftExponent t ρ u v i) = _
      ring)
  have hSubset : Fintype.piFinset J ⊆ Fintype.piFinset J₀ :=
    fun j hj => Fintype.mem_piFinset.mpr fun i => (Finset.mem_filter.mp (Fintype.mem_piFinset.mp hj i)).1
  have hNull (j : ι → ℤ) (hj : j ∈ Fintype.piFinset J₀) (hn : j ∉ Fintype.piFinset J) :
      F j = 0 := by
    simp only [Fintype.mem_piFinset, J, Finset.mem_filter] at hn
    push Not at hn
    obtain ⟨i,hi⟩ := hn
    have hzero : A i (j i) = 0 :=
      le_antisymm (hi (Fintype.mem_piFinset.mp hj i)) measureReal_nonneg
    have hz : (∏ i, A i (j i) ^ shiftExponent t ρ o o i) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ i)
      rw [hzero, Real.zero_rpow (shiftExponent_pos hρ.le htρ o o i).ne']
    have h := hR' j o o
    rw [hz, mul_zero] at h
    exact le_antisymm h (norm_nonneg _)
  have hDec (i : ι) : (∑ j ∈ J₀ i, a j • L i j) = f i :=
    simple_amplitude_decomposition (f i)
  have hExpansion : Λ f = ∑ j ∈ Fintype.piFinset J₀, Λ (fun i => a (j i) • L i (j i)) := by
    exact (congrArg Λ (funext fun i => (hDec i).symm)).trans
      (Λ.map_sum_finset (g := fun i j => a j • L i j) (A := J₀))
  have hNorm i : lpNorm (⇑(f i).1) (ENNReal.ofReal (1/t i)) μ = M i ^ t i := by
    have hti : 0 < 1/t i := div_pos one_pos (ht i)
    rw [lpNorm_eq_integral_norm_rpow_toReal (ENNReal.ofReal_ne_zero_iff.mpr hti)
      ENNReal.ofReal_ne_top (f i).1.measurable.aestronglyMeasurable, ENNReal.toReal_ofReal hti.le]
    simp [M, one_div]
  calc
    ‖Λ f‖ ≤ ∑ j ∈ Fintype.piFinset J₀, F j := by
      rw [hExpansion]
      exact norm_sum_le _ _
    _ = ∑ j ∈ Fintype.piFinset J, F j := (Finset.sum_subset hSubset hNull).symm
    _ ≤ C' * ∏ i, M i ^ t i := by
      exact combined_layer_sum o t ht ht₁ hρ htρ J κ A (fun _ _ => measureReal_nonneg)
        (fun i j hj => by
          have h := (dyadicLogFloor_bounds (Finset.mem_filter.mp hj).2).2.le
          simpa only [κ, ← Real.rpow_intCast, Int.cast_add, Int.cast_one] using h)
        M (fun i => integral_nonneg fun _ => by positivity)
        (fun i => amplitude_layer_energy (f i) (J i) (ht i) (fun _ hj => (Finset.mem_filter.mp hj).2))
        hC F (fun j _ => hR' j)
    _ = _ := by simp only [hNorm, C', r]

private theorem complexCoordinateAverage_measurable {d : ℕ} (i : Fin d) (k : ℤ)
    {f : (Fin d → ℝ) → ℂ} (hf : Measurable f) :
    Measurable (complexCoordinateAverage i k f) := by
  let A : Set ((Fin d → ℝ) × ℝ) := {z | dyadicIndex k z.2 = dyadicIndex k (z.1 i)}
  have hInd : Measurable (dyadicIndex k) :=
    Int.measurable_floor.comp (measurable_id.div_const ((2:ℝ)^(-k)))
  have hA : MeasurableSet A := measurableSet_eq_fun (hInd.comp measurable_snd)
    (hInd.comp ((measurable_pi_apply i).comp measurable_fst))
  have hu : Measurable (fun z : (Fin d → ℝ) × ℝ => Function.update z.1 i z.2) := measurable_update'
  have hi := ((hf.comp hu).indicator hA).stronglyMeasurable.integral_prod_right'
    (ν := (volume : Measure ℝ))
  apply Measurable.const_mul _ ((((2:ℝ)^(-k))⁻¹ : ℝ) : ℂ)
  convert hi.measurable using 1
  funext x
  have hcell : MeasurableSet (dyadicInterval k (dyadicIndex k (x i))) := measurableSet_Ico
  rw [← integral_indicator hcell]
  congr 1
  funext y
  simp only [Set.indicator, mem_dyadicInterval_iff, A, mem_ofPred_eq, Function.comp_apply]

private theorem complexCoordinateAverage_norm_le {d : ℕ} (i : Fin d) (k : ℤ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) :
    ‖complexCoordinateAverage i k f x‖ ≤ coordinateAverage i k (fun y => ‖f y‖) x := by
  unfold complexCoordinateAverage coordinateAverage
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  exact mul_le_mul_of_nonneg_left (norm_integral_le_integral_norm _) (by positivity)

private theorem complexCoordinateAverage_memLp {d : ℕ} (i : Fin d) (k : ℤ) {p : ℝ}
    (hp : 1 ≤ p) {f : (Fin d → ℝ) → ℂ} (hm : Measurable f)
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (complexCoordinateAverage i k f) (ENNReal.ofReal p) volume ∧
      lpNorm (complexCoordinateAverage i k f) (ENNReal.ofReal p) volume ≤
        lpNorm f (ENNReal.ofReal p) volume := by
  have hgm : AEStronglyMeasurable (complexCoordinateAverage i k f) volume :=
    (complexCoordinateAverage_measurable i k hm).aestronglyMeasurable
  have h := coordinateAverage_eLpNorm_le i k hp hm.norm hf.norm
  rw [eLpNorm_norm _ hf.aestronglyMeasurable] at h
  have hg := (eLpNorm_mono_ae_real hgm (Filter.Eventually.of_forall
    (complexCoordinateAverage_norm_le i k f))).trans h
  have hMem : MemLp (complexCoordinateAverage i k f) (ENNReal.ofReal p) volume :=
    hg.trans_lt hf.eLpNorm_lt_top
  exact And.intro hMem (ENNReal.toReal_mono hf.eLpNorm_lt_top.ne hg)

private theorem complexCoordinateAverage_congr_ae {d : ℕ} (i : Fin d)
    {f g : (Fin d → ℝ) → ℂ} (h : f =ᵐ[volume] g) :
    ∀ᵐ x ∂volume, ∀ k : ℤ, complexCoordinateAverage i k f x = complexCoordinateAverage i k g x := by
  filter_upwards [coordinateFiber_congr_ae i h] with x hx
  intro k
  unfold complexCoordinateAverage
  rw [integral_congr_ae (ae_restrict_of_ae hx)]

private theorem coordinateFiber_integrableOn_ae {d : ℕ} (i : Fin d) {p : ℝ} (hp : 1 ≤ p)
    {f : (Fin d → ℝ) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    ∀ᵐ x ∂volume, ∀ k n : ℤ,
      IntegrableOn (fun y => f (Function.update x i y)) (dyadicInterval k n) := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ m =>
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (m+1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (m+1) => ℝ) i).symm _
    let g := f ∘ e
    have hg : MemLp g (ENNReal.ofReal p) volume := hf.comp_measurePreserving he
    have hp₀ : 0 < p := zero_lt_one.trans_le hp
    have hpn : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp₀
    have hprod : MemLp g (ENNReal.ofReal p) ((volume : Measure ℝ).prod volume) := by
      rw [← Measure.volume_eq_prod]
      exact hg
    have hpow := hprod.integrable_norm_rpow hpn ENNReal.ofReal_ne_top
    have hslice : ∀ᵐ y ∂(volume : Measure (Fin m → ℝ)),
        MemLp (fun x : ℝ => g (x,y)) (ENNReal.ofReal p) volume := by
      filter_upwards [hpow.prod_left_ae, hprod.aestronglyMeasurable.prodMk_right] with y hy hm
      exact (integrable_norm_rpow_iff hm hpn ENNReal.ofReal_ne_top).mp hy
    have hgood : ∀ᵐ z ∂(volume : Measure (ℝ × (Fin m → ℝ))), ∀ k n : ℤ,
        IntegrableOn (fun y => f (Function.update (e z) i y)) (dyadicInterval k n) := by
      rw [Measure.volume_eq_prod]
      filter_upwards [(Measure.quasiMeasurePreserving_snd (μ := (volume : Measure ℝ))
        (ν := (volume : Measure (Fin m → ℝ)))).ae hslice] with z hz k n
      rcases z with ⟨x,y⟩
      have hfin : IsFiniteMeasure ((volume : Measure ℝ).restrict (dyadicInterval k n)) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
      have hlocal := (hz.restrict (dyadicInterval k n)).integrable
        (by simpa using ENNReal.ofReal_le_ofReal hp)
      change IntegrableOn (fun t => f (i.insertNth t y)) (dyadicInterval k n) at hlocal
      change IntegrableOn (fun t => f (Function.update (i.insertNth x y) i t)) (dyadicInterval k n)
      simpa only [Fin.update_insertNth, Fin.insertNth_apply_same] using hlocal
    filter_upwards [(he.symm e).quasiMeasurePreserving.ae hgood] with x hx
    simpa only [MeasurableEquiv.apply_symm_apply] using hx

private theorem complexCoordinateAverage_add_ae {d : ℕ} (i : Fin d) {p : ℝ} (hp : 1 ≤ p)
    {f g : (Fin d → ℝ) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume)
    (hg : MemLp g (ENNReal.ofReal p) volume) :
    ∀ᵐ x ∂volume, ∀ k : ℤ, complexCoordinateAverage i k (f+g) x =
      complexCoordinateAverage i k f x + complexCoordinateAverage i k g x := by
  filter_upwards [coordinateFiber_integrableOn_ae i hp hf, coordinateFiber_integrableOn_ae i hp hg]
    with x hfx hgx k
  unfold complexCoordinateAverage
  simp only [Pi.add_apply, integral_add (hfx k _) (hgx k _), mul_add]

private theorem complexCoordinateAverage_const_mul {d : ℕ} (i : Fin d) (k : ℤ)
    (c : ℂ) (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) :
    complexCoordinateAverage i k (fun y => c*f y) x = c*complexCoordinateAverage i k f x := by
  unfold complexCoordinateAverage
  rw [integral_const_mul, mul_left_comm]

private noncomputable def complexSlotAction {d : ℕ} (b : Fin d) (k : ℤ)
    (i : Option (Fin d)) (g : (Fin d → ℝ) → ℂ) : (Fin d → ℝ) → ℂ :=
  match i with
  | none => g
  | some j => if j = b then complexCoordinateDifference j k g else complexCoordinateAverage j k g

private theorem complexDyadicSlot_eq_action {d : ℕ} (b : Fin d) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℂ) (i : Option (Fin d)) :
    complexDyadicSlot b k f i = complexSlotAction b k i (f i) := by cases i <;> rfl

private theorem complexSlotAction_measurable {d : ℕ} (b : Fin d) (k : ℤ)
    (i : Option (Fin d)) {f : (Fin d → ℝ) → ℂ} (hm : Measurable f) :
    Measurable (complexSlotAction b k i f) := by
  cases i with
  | none => exact hm
  | some j =>
    by_cases hj : j = b
    · simp only [complexSlotAction, ite_eq_left hj, complexCoordinateDifference]
      exact (complexCoordinateAverage_measurable j (k+1) hm).sub
        (complexCoordinateAverage_measurable j k hm)
    · simp only [complexSlotAction, ite_eq_right hj]
      exact complexCoordinateAverage_measurable j k hm

private theorem complexSlotAction_memLp {d : ℕ} (b : Fin d) (k : ℤ) (i : Option (Fin d))
    {p : ℝ} (hp : 1 ≤ p) {f : (Fin d → ℝ) → ℂ} (hm : Measurable f)
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (complexSlotAction b k i f) (ENNReal.ofReal p) volume ∧
      lpNorm (complexSlotAction b k i f) (ENNReal.ofReal p) volume ≤
        (if i = some b then 2 else 1) * lpNorm f (ENNReal.ofReal p) volume := by
  cases i with
  | none => simpa [complexSlotAction] using hf
  | some j =>
    by_cases hj : j = b
    · have hg₁ := complexCoordinateAverage_memLp j (k+1) hp hm hf
      have hg₂ := complexCoordinateAverage_memLp j k hp hm hf
      simp only [complexSlotAction, ite_eq_left hj, Option.some.injEq]
      refine ⟨hg₁.1.sub hg₂.1, ?_⟩
      change lpNorm ((complexCoordinateAverage j (k+1) f) - (complexCoordinateAverage j k f))
        (ENNReal.ofReal p) volume ≤ _
      have hp' : 1 ≤ ENNReal.ofReal p := by simpa using ENNReal.ofReal_le_ofReal hp
      exact (lpNorm_sub_le hg₁.1 hp').trans
        ((add_le_add hg₁.2 hg₂.2).trans_eq (by ring))
    · simpa only [complexSlotAction, ite_eq_right hj, Option.some.injEq, one_mul] using
        complexCoordinateAverage_memLp j k hp hm hf

private theorem complexSlotAction_congr_ae {d : ℕ} (b : Fin d) (k : ℤ) (i : Option (Fin d))
    {f g : (Fin d → ℝ) → ℂ} (h : f =ᵐ[volume] g) :
    complexSlotAction b k i f =ᵐ[volume] complexSlotAction b k i g := by
  cases i with
  | none => exact h
  | some j =>
    filter_upwards [complexCoordinateAverage_congr_ae j h] with x hx
    by_cases hj : j = b
    · simp only [complexSlotAction, ite_eq_left hj, complexCoordinateDifference, hx]
    · simp only [complexSlotAction, ite_eq_right hj, hx]

private theorem complexSlotAction_add_ae {d : ℕ} (b : Fin d) (k : ℤ) (i : Option (Fin d))
    {p : ℝ} (hp : 1 ≤ p) {f g : (Fin d → ℝ) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume)
    (hg : MemLp g (ENNReal.ofReal p) volume) :
    complexSlotAction b k i (f+g) =ᵐ[volume] complexSlotAction b k i f + complexSlotAction b k i g := by
  cases i with
  | none => rfl
  | some j =>
    filter_upwards [complexCoordinateAverage_add_ae j hp hf hg] with x hx
    by_cases hj : j = b
    · simp only [complexSlotAction, ite_eq_left hj, Pi.add_apply, complexCoordinateDifference, hx]
      ring
    · simp only [complexSlotAction, ite_eq_right hj, Pi.add_apply, hx]

private theorem complexSlotAction_smul {d : ℕ} (b : Fin d) (k : ℤ) (i : Option (Fin d))
    (a : ℂ) (f : (Fin d → ℝ) → ℂ) :
    complexSlotAction b k i (a • f) = a • complexSlotAction b k i f := by
  funext x
  cases i with
  | none => rfl
  | some j =>
    change complexSlotAction b k (some j) (fun y => a*f y) x =
      a*complexSlotAction b k (some j) f x
    by_cases hj : j = b
    · simp only [complexSlotAction, ite_eq_left hj, complexCoordinateDifference,
        complexCoordinateAverage_const_mul, mul_sub]
    · simp only [complexSlotAction, ite_eq_right hj, complexCoordinateAverage_const_mul]

private theorem complexDyadicForm_congr_ae {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ) (c : ℕ → ℂ)
    {f g : Option (Fin d) → (Fin d → ℝ) → ℂ} (h : ∀ i, f i =ᵐ[volume] g i) :
    complexDyadicForm b u T c f = complexDyadicForm b u T c g := by
  unfold complexDyadicForm
  apply Finset.sum_congr rfl
  intro k _
  apply congrArg (fun a : ℂ => c k * a)
  apply integral_congr_ae
  filter_upwards [ae_all_iff.mpr (fun i => complexSlotAction_congr_ae b (u+k) i (h i))] with x hx
  simp_rw [complexDyadicSlot_eq_action]
  exact Finset.prod_congr rfl fun i _ => hx i

private theorem complexDyadicIntegrand_bound {d : ℕ} (b : Fin d) (k : ℤ)
    (p : Option (Fin d) → ℝ) (hp : ∀ i, 1 ≤ p i) (hP : ∑ i, (ENNReal.ofReal (p i))⁻¹ = 1)
    (f : Option (Fin d) → (Fin d → ℝ) → ℂ) (hm : ∀ i, Measurable (f i))
    (hf : ∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume) :
    let g x := ∏ i, complexDyadicSlot b k f i x
    Integrable g ∧ ‖∫ x, g x‖ ≤ 2*∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  classical
  dsimp only
  simp_rw [complexDyadicSlot_eq_action]
  let g (i : Option (Fin d)) := complexSlotAction b k i (f i)
  let w i := (if i = some b then 2 else 1)*lpNorm (f i) (ENNReal.ofReal (p i)) volume
  have hgm i := complexSlotAction_measurable b k i (hm i)
  have hG i := complexSlotAction_memLp b k i (hp i) (hm i) (hf i)
  have hgi : Integrable (fun x => ∏ i, g i x) := by
    have h := MemLp.fun_prod (s := (Finset.univ : Finset (Option (Fin d)))) (f := g)
      (p := fun i => ENNReal.ofReal (p i)) (fun i _ => (hG i).1)
    rwa [hP, inv_one, memLp_one_iff_integrable] at h
  refine ⟨hgi, ?_⟩
  have hbound := (integral_product_le (fun i => ENNReal.ofReal (p i)) (fun i x => ‖g i x‖)
    w (fun i => by dsimp [w]; exact mul_nonneg (by split <;> norm_num) lpNorm_nonneg)
    hP (fun i => (hgm i).norm)
    (fun i => (hG i).1.norm) (fun i => (lpNorm_norm ((hG i).1.aestronglyMeasurable) _).trans_le (hG i).2)).2
  have hW : (∏ i, w i) = 2*∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume := by
    dsimp only [w]
    rw [Finset.prod_mul_distrib]
    congr 1
    rw [Fintype.prod_eq_mul_prod_subtype_ne _ (some b)]
    have hi (i : {i : Option (Fin d) // i ≠ some b}) : (if (i : Option (Fin d)) = some b then
        (2:ℝ) else 1) = 1 := ite_eq_right i.2
    simp only [ite_true, hi, Finset.prod_const_one, mul_one]
  change ‖∫ x, ∏ i, g i x‖ ≤ _
  refine (norm_integral_le_integral_norm _).trans ?_
  simp_rw [norm_prod]
  exact (le_abs_self _).trans (hbound.trans_eq hW)

private noncomputable def dyadicLpMultilinear {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℂ) (p : Option (Fin d) → ℝ) (hp : ∀ i, 1 ≤ p i)
    (hP : ∑ i, (ENNReal.ofReal (p i))⁻¹ = 1) :
    MultilinearMap ℂ (fun i : Option (Fin d) =>
      Lp ℂ (ENNReal.ofReal (p i)) (volume : Measure (Fin d → ℝ))) ℂ := by
  classical
  let X := Fin d → ℝ
  let V (i : Option (Fin d)) := Lp ℂ (ENNReal.ofReal (p i)) (volume : Measure X)
  let P (k : ℕ) (F : ∀ i, V i) (x : X) :=
    ∏ j, complexDyadicSlot b (u+k) (fun l => ⇑(F l)) j x
  have hProd [DecidableEq (Option (Fin d))] (k : ℕ) (F : ∀ i, V i) (i : Option (Fin d))
      (v : V i) (x : X) :
      P k (Function.update F i v) x =
        complexSlotAction b (u+k) i (⇑v) x *
          ∏ j : {j : Option (Fin d) // j ≠ i}, complexSlotAction b (u+k) j (⇑(F j)) x := by
    dsimp only [P]
    simp_rw [complexDyadicSlot_eq_action]
    rw [Fintype.prod_eq_mul_prod_subtype_ne _ i, Function.update_self]
    congr 1
    apply Finset.prod_congr rfl
    intro j _
    rw [Function.update_of_ne j.2]
  have hI (k : ℕ) (F : ∀ i, V i) : Integrable (P k F) := by
    exact (complexDyadicIntegrand_bound b (u+k) p hp hP (fun i => ⇑(F i))
      (fun i => (Lp.stronglyMeasurable (F i)).measurable) (fun i => Lp.memLp (F i))).1
  refine
    { toFun := fun F => complexDyadicForm b u T c (fun i => ⇑(F i))
      map_update_add' := ?_
      map_update_smul' := ?_ }
  · intro _ F i f g
    unfold complexDyadicForm
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro k _
    change c k*(∫ x, P k (Function.update F i (f+g)) x) =
      c k*(∫ x, P k (Function.update F i f) x) + c k*(∫ x, P k (Function.update F i g) x)
    rw [← mul_add, ← integral_add (hI k _) (hI k _)]
    apply congrArg (fun z : ℂ => c k*z)
    apply integral_congr_ae
    filter_upwards [complexSlotAction_congr_ae b (u+k) i (Lp.coeFn_add f g),
      complexSlotAction_add_ae b (u+k) i (hp i) (Lp.memLp f) (Lp.memLp g)] with x h₀ h₁
    change P k (Function.update F i (f+g)) x =
      P k (Function.update F i f) x + P k (Function.update F i g) x
    rw [hProd k F i (f+g) x, hProd k F i f x, hProd k F i g x]
    have he := h₀.trans h₁
    change complexSlotAction b (u+k) i (⇑(f+g)) x =
      complexSlotAction b (u+k) i (⇑f) x + complexSlotAction b (u+k) i (⇑g) x at he
    rw [he, add_mul]
  · intro _ F i a f
    unfold complexDyadicForm
    change (∑ k ∈ Finset.range T, c k*(∫ x, P k (Function.update F i (a • f)) x)) =
      a*(∑ k ∈ Finset.range T, c k*(∫ x, P k (Function.update F i f) x))
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k _
    rw [mul_left_comm a]
    apply congrArg (fun z : ℂ => c k*z)
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [complexSlotAction_congr_ae b (u+k) i (Lp.coeFn_smul a f)] with x hx
    change P k (Function.update F i (a • f)) x = a * P k (Function.update F i f) x
    rw [hProd k F i (a • f) x, hProd k F i f x]
    change complexSlotAction b (u+k) i (⇑(a • f)) x =
      complexSlotAction b (u+k) i (a • ⇑f) x at hx
    rw [hx, complexSlotAction_smul, Pi.smul_apply, smul_eq_mul, mul_assoc]

private theorem dyadicLpMultilinear_crude {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℂ) (hc : ∀ k, ‖c k‖ ≤ 1) (p : Option (Fin d) → ℝ) (hp : ∀ i, 1 ≤ p i)
    (hP : ∑ i, (ENNReal.ofReal (p i))⁻¹ = 1)
    (F : ∀ i : Option (Fin d), Lp ℂ (ENNReal.ofReal (p i)) (volume : Measure (Fin d → ℝ))) :
    ‖dyadicLpMultilinear b u T c p hp hP F‖ ≤ (2*T) * ∏ i, ‖F i‖ := by
  change ‖complexDyadicForm b u T c (fun i => F i)‖ ≤ _
  unfold complexDyadicForm
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ _k ∈ Finset.range T, 2 * ∏ i, ‖F i‖ := by
      apply Finset.sum_le_sum
      intro k _
      rw [norm_mul]
      have h := (complexDyadicIntegrand_bound b (u+k) p hp hP (fun i => ⇑(F i))
        (fun i => (Lp.stronglyMeasurable (F i)).measurable) (fun i => Lp.memLp (F i))).2
      have h' (i : Option (Fin d)) : lpNorm (⇑(F i)) (ENNReal.ofReal (p i)) volume = ‖F i‖ := rfl
      simp_rw [h'] at h
      exact (mul_le_mul_of_nonneg_right (hc k) (norm_nonneg _)).trans
        ((one_mul _).le.trans h)
    _ = _ := by simp; ring

private theorem finiteSimple_memLp {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {p : ℝ≥0∞}
    (hp₀ : p ≠ 0) (hpTop : p ≠ ∞) (f : finiteSimpleFunctions μ) :
    MemLp (⇑f.1) p μ :=
  (SimpleFunc.memLp_iff_integrable hp₀ hpTop).mpr f.2

private noncomputable def finiteSimpleToLp {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (p : ℝ≥0∞) (hp₀ : p ≠ 0) (hpTop : p ≠ ∞) : finiteSimpleFunctions μ →ₗ[ℂ] Lp ℂ p μ where
  toFun f := (finiteSimple_memLp hp₀ hpTop f).toLp (⇑f.1)
  map_add' f g := by
    change (finiteSimple_memLp hp₀ hpTop (f+g)).toLp (⇑(f+g).1) =
      (finiteSimple_memLp hp₀ hpTop f).toLp (⇑f.1) + (finiteSimple_memLp hp₀ hpTop g).toLp (⇑g.1)
    exact MemLp.toLp_add _ _
  map_smul' a f := by
    apply Lp.ext
    exact (MemLp.coeFn_toLp (finiteSimple_memLp hp₀ hpTop (a • f))).trans
      ((Lp.coeFn_smul a _).trans
        (Filter.EventuallyEq.fun_comp (MemLp.coeFn_toLp (finiteSimple_memLp hp₀ hpTop f)) (a • ·))).symm

private theorem finiteSimpleToLp_dense {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp₀ : p ≠ 0) (hpTop : p ≠ ∞) :
    Dense (Set.range (finiteSimpleToLp (μ := μ) p hp₀ hpTop)) := by
  apply (Lp.simpleFunc.dense (E := ℂ) (μ := μ) hpTop).mono
  intro f hf
  let g : Lp.simpleFunc ℂ p μ := ⟨f,hf⟩
  let s := Lp.simpleFunc.toSimpleFunc g
  have hs : Integrable (⇑s) μ :=
    (SimpleFunc.memLp_iff_integrable hp₀ hpTop).mp (Lp.simpleFunc.memLp g)
  let v : finiteSimpleFunctions μ := ⟨s,hs⟩
  refine ⟨v, Lp.ext ?_⟩
  exact (MemLp.coeFn_toLp (finiteSimple_memLp hp₀ hpTop v)).trans
    (Lp.simpleFunc.toSimpleFunc_eq_toFun g)

set_option maxHeartbeats 1200000 in
private theorem dyadic_standard {d : ℕ} (hd : 2 ≤ d)
    (p : Option (Fin d) → ℝ) (hp : ∀ i, 1 < p i) (hP : ∑ i, 1/p i = 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (b : Fin d) (u : ℤ) (T : ℕ) (c : ℕ → ℂ) (_ : ∀ k, ‖c k‖ ≤ 1)
      (f : Option (Fin d) → (Fin d → ℝ) → ℂ),
      (∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume) →
      ‖complexDyadicForm b u T c f‖ ≤ C * ∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  classical
  let t (i : Option (Fin d)) := 1/p i
  have ht (i : Option (Fin d)) : 0 < t i := div_pos one_pos (zero_lt_one.trans (hp i))
  have htinv i : 1/t i = p i := by simp [t, one_div]
  have ht₁ : ∑ i, t i = 1 := hP
  have hNE : (Finset.univ : Finset (Option (Fin d))).Nonempty := ⟨none, Finset.mem_univ _⟩
  let m := Finset.univ.inf' hNE t
  have hm : 0 < m := by
    obtain ⟨i,_,hi⟩ := Finset.exists_mem_eq_inf' hNE t
    rw [show m = t i from hi]
    exact ht i
  let ρ := m/2
  have hρ : 0 < ρ := by dsimp [ρ]; positivity
  have htρ i : ρ < t i := (show ρ < m by dsimp [ρ]; linarith).trans_le
    (Finset.inf'_le t (Finset.mem_univ i))
  have hshift (a b : Option (Fin d)) := restricted hd (shiftExponent t ρ a b)
    (shiftExponent_pos hρ.le htρ a b) (shiftExponent_sum ht₁ ρ a b)
  choose Q hQ hR using hshift
  let C := ∑ u : Option (Fin d) × Option (Fin d), Q u.1 u.2
  have hC : 0 ≤ C := Finset.sum_nonneg fun u _ => hQ u.1 u.2
  have hQle (a b : Option (Fin d)) : Q a b ≤ C :=
    Finset.single_le_sum (f := fun u : Option (Fin d) × Option (Fin d) => Q u.1 u.2)
      (fun u _ => hQ u.1 u.2) (Finset.mem_univ (a,b))
  let r := (2:ℝ)^(-ρ/Fintype.card (Option (Fin d)))
  let C' := 2*(4:ℝ)^(Fintype.card (Option (Fin d)))*(2*(1-r)⁻¹)^(Fintype.card (Option (Fin d)))*C
  have hr : r < 1 := by
    dsimp [r]
    rw [← Real.rpow_zero (2:ℝ), Real.rpow_lt_rpow_left_iff (by norm_num)]
    exact div_neg_of_neg_of_pos (neg_neg_of_pos hρ) (by simp; positivity)
  have hC' : 0 ≤ C' := by dsimp only [C']; positivity [sub_nonneg.mpr hr.le]
  refine ⟨C',hC',?_⟩
  intro b u T c hc f hf
  let P (i : Option (Fin d)) := ENNReal.ofReal (p i)
  have hP₀ i : P i ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr (zero_lt_one.trans (hp i))
  have hPTop i : P i ≠ ∞ := ENNReal.ofReal_ne_top
  have hP' : ∑ i, (P i)⁻¹ = 1 := by
    have hi i : (P i)⁻¹ = ENNReal.ofReal (t i) := by
      simpa only [P,t,one_div] using (ENNReal.ofReal_inv_of_pos (zero_lt_one.trans (hp i))).symm
    simp_rw [hi]
    rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => (ht i).le), ht₁, ENNReal.ofReal_one]
  letI (i : Option (Fin d)) : Fact (1 ≤ P i) :=
    ⟨by simpa only [P, ENNReal.ofReal_one] using ENNReal.ofReal_le_ofReal (hp i).le⟩
  let S (i : Option (Fin d)) := finiteSimpleToLp (μ := (volume : Measure (Fin d → ℝ))) (P i) (hP₀ i) (hPTop i)
  let Λ := dyadicLpMultilinear b u T c p (fun i => (hp i).le) hP'
  have hΛ : Continuous Λ := Λ.continuous_of_bound (2*T)
    (dyadicLpMultilinear_crude b u T c hc p (fun i => (hp i).le) hP')
  have hSimple (g : Option (Fin d) → finiteSimpleFunctions (volume : Measure (Fin d → ℝ))) :
      ‖Λ (fun i => S i (g i))‖ ≤ C' * ∏ i, ‖S i (g i)‖ := by
    have hpoint (g' : Option (Fin d) → finiteSimpleFunctions (volume : Measure (Fin d → ℝ))) :
        (Λ.compLinearMap S) g' = complexDyadicForm b u T c (fun i => ⇑(g' i).1) := by
      change complexDyadicForm b u T c (fun i => ⇑(S i (g' i))) = _
      exact complexDyadicForm_congr_ae b u T c (fun i =>
        MemLp.coeFn_toLp (finiteSimple_memLp (hP₀ i) (hPTop i) (g' i)))
    have hb := interp volume (none : Option (Fin d)) t ht ht₁ hρ htρ C hC (Λ.compLinearMap S)
      (fun i j B g' hg' => by
        rw [hpoint g']
        have h := hR i j b u T c hc B (fun k => ⇑(g' k).1) (fun k =>
          ⟨(hg' k).1, (hg' k).2.1, (g' k).1.measurable, (hg' k).2.2⟩)
        exact h.trans (mul_le_mul_of_nonneg_right (hQle i j)
          (Finset.prod_nonneg fun _ _ => Real.rpow_nonneg measureReal_nonneg _))) g
    have hNorm i : lpNorm (⇑(g i).1) (ENNReal.ofReal (1/t i)) volume = ‖S i (g i)‖ := by
      rw [htinv i]
      exact (Lp.norm_toLp _ (finiteSimple_memLp (hP₀ i) (hPTop i) (g i))).symm
    simp_rw [hNorm] at hb
    exact hb
  let V (i : Option (Fin d)) := Lp ℂ (P i) (volume : Measure (Fin d → ℝ))
  let U : Set (∀ i, V i) := {F | ‖Λ F‖ ≤ C' * ∏ i, ‖F i‖}
  have hClosed : IsClosed U := isClosed_le hΛ.norm
    (continuous_const.mul (continuous_finsetProd _ (fun i _ => (continuous_apply i).norm)))
  have hDense : Dense (Set.pi Set.univ (fun i => Set.range (S i))) :=
    dense_pi Set.univ fun i _ => finiteSimpleToLp_dense (P i) (hP₀ i) (hPTop i)
  have hSubset : Set.pi Set.univ (fun i => Set.range (S i)) ⊆ U := by
    intro F hF
    have h (i : Option (Fin d)) : ∃ g, S i g = F i := hF i (Set.mem_univ i)
    choose g hg using h
    have he : (fun i => S i (g i)) = F := funext hg
    rw [← he]
    exact hSimple g
  let F (i : Option (Fin d)) : V i := (hf i).toLp (f i)
  have hb : F ∈ U := (hClosed.closure_subset_iff.mpr hSubset) (hDense F)
  change ‖complexDyadicForm b u T c (fun i => ⇑(F i))‖ ≤ C' * ∏ i, ‖F i‖ at hb
  have he := complexDyadicForm_congr_ae b u T c (fun i => (hf i).coeFn_toLp)
  rw [he] at hb
  have hNorm i : ‖F i‖ = lpNorm (f i) (P i) volume := Lp.norm_toLp _ _
  simpa only [hNorm] using hb

/-- The diagonal affine map that transports the standard coordinate grids. -/
def coordinateAffine {d : ℕ} (a scale : Fin d → ℝ) (x : Fin d → ℝ) : Fin d → ℝ :=
  fun i => a i + scale i*x i

theorem coordinateAffine_measurable {d : ℕ} (a scale : Fin d → ℝ) :
    Measurable (coordinateAffine a scale) :=
  measurable_pi_iff.mpr fun i => measurable_const.add (measurable_const.mul (measurable_pi_apply i))

theorem coordinateAffine_map_volume {d : ℕ} (a scale : Fin d → ℝ) (hscale : ∀ i, 0 < scale i) :
    Measure.map (coordinateAffine a scale) volume =
      ENNReal.ofReal (∏ i, scale i)⁻¹ • (volume : Measure (Fin d → ℝ)) := by
  classical
  let M := Matrix.diagonal scale
  have hJ : 0 < ∏ i, scale i := Finset.prod_pos (fun i _ => hscale i)
  have hdet : M.det ≠ 0 := by
    change (Matrix.diagonal scale).det ≠ 0
    rw [Matrix.det_diagonal]
    exact hJ.ne'
  have hM := Real.map_matrix_volume_pi_eq_smul_volume_pi hdet
  have hdet' : M.det = ∏ i, scale i := Matrix.det_diagonal
  have hcomp : coordinateAffine a scale = (a + ·) ∘ (Matrix.toLin' M) := by
    funext x i
    simp [coordinateAffine, M, Matrix.diagonal_toLin']
  have hm : Measurable (Matrix.toLin' M) := (LinearMap.continuous_on_pi _).measurable
  have ha : Measurable (fun x : Fin d → ℝ => a+x) := measurable_const.add measurable_id
  rw [hcomp, ← Measure.map_map ha hm, hM, hdet', abs_of_nonneg (inv_nonneg.mpr hJ.le),
    Measure.map_smul, map_add_left_eq_self]
  exact ha.aemeasurable

private theorem coordinateAffine_lp {d : ℕ} (a scale : Fin d → ℝ) (hscale : ∀ i, 0 < scale i)
    {p : ℝ} (hp : 0 < p) {f : (Fin d → ℝ) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (f ∘ coordinateAffine a scale) (ENNReal.ofReal p) volume ∧
      lpNorm (f ∘ coordinateAffine a scale) (ENNReal.ofReal p) volume =
        ((∏ i, scale i)⁻¹)^(1/p) * lpNorm f (ENNReal.ofReal p) volume := by
  let J := ∏ i, scale i
  have hJ : 0 < J := Finset.prod_pos (fun i _ => hscale i)
  have hA := coordinateAffine_map_volume a scale hscale
  have hm := coordinateAffine_measurable a scale
  have hf' : MemLp f (ENNReal.ofReal p) (Measure.map (coordinateAffine a scale) volume) := by
    rw [hA]
    exact hf.smul_measure ENNReal.ofReal_ne_top
  refine ⟨hf'.comp_of_map hm.aemeasurable, ?_⟩
  have hn : lpNorm (f ∘ coordinateAffine a scale) (ENNReal.ofReal p) volume =
      lpNorm f (ENNReal.ofReal p) (Measure.map (coordinateAffine a scale) volume) :=
    congrArg ENNReal.toReal (eLpNorm_map_measure hf'.aestronglyMeasurable hm.aemeasurable).symm
  rw [hn, hA]
  let j := (J⁻¹).toNNReal
  change lpNorm f (ENNReal.ofReal p) (j • volume) = _
  rw [lpNorm_smul_measure_of_ne_top (f := f) ENNReal.ofReal_ne_top j, NNReal.smul_def,
    NNReal.coe_rpow, smul_eq_mul]
  have hj : (j : ℝ) = J⁻¹ := Real.coe_toNNReal _ (inv_nonneg.mpr hJ.le)
  rw [hj, ENNReal.toReal_ofReal hp.le, one_div]

/-- The finite dyadic form in the grid obtained by translating and dilating
each coordinate, expressed by pullback and the volume Jacobian. -/
noncomputable def affineDyadicForm {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ) (c : ℕ → ℂ)
    (a scale : Fin d → ℝ) (f : Option (Fin d) → (Fin d → ℝ) → ℂ) : ℂ :=
  ((∏ i, scale i : ℝ) : ℂ) * complexDyadicForm b u T c (fun i => f i ∘ coordinateAffine a scale)

/-- The uniform strong \(L^p\) estimate for finite dyadic windows, including
independently translated and dilated coordinate grids. -/
theorem dyadic {d : ℕ} (hd : 2 ≤ d)
    (p : Option (Fin d) → ℝ) (hp : ∀ i, 1 < p i) (hP : ∑ i, 1/p i = 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (b : Fin d) (u : ℤ) (T : ℕ) (c : ℕ → ℂ) (_ : ∀ k, ‖c k‖ ≤ 1)
      (f : Option (Fin d) → (Fin d → ℝ) → ℂ),
      (∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume) →
      ‖complexDyadicForm b u T c f‖ ≤ C * (∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume) ∧
      ∀ (a scale : Fin d → ℝ), (∀ i, 0 < scale i) →
        ‖affineDyadicForm b u T c a scale f‖ ≤ C * ∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  obtain ⟨C,hC,h⟩ := dyadic_standard hd p hp hP
  refine ⟨C,hC,?_⟩
  intro b u T c hc f hf
  refine ⟨h b u T c hc f hf, ?_⟩
  intro a scale hscale
  let J := ∏ i, scale i
  have hJ : 0 < J := Finset.prod_pos (fun i _ => hscale i)
  have hLp i := coordinateAffine_lp a scale hscale (zero_lt_one.trans (hp i)) (hf i)
  have hh := h b u T c hc (fun i => f i ∘ coordinateAffine a scale) (fun i => (hLp i).1)
  have hnorm i := (hLp i).2
  simp_rw [hnorm, Finset.prod_mul_distrib] at hh
  have hprod : (∏ i : Option (Fin d), (J⁻¹)^(1/p i)) = J⁻¹ := by
    rw [← Real.rpow_sum_of_pos (inv_pos.mpr hJ), hP, Real.rpow_one]
  unfold affineDyadicForm
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hJ.le]
  refine (mul_le_mul_of_nonneg_left hh hJ.le).trans_eq ?_
  change J*(C*((∏ i : Option (Fin d), J⁻¹^(1/p i)) *
    ∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume)) = _
  rw [hprod, mul_left_comm J, ← mul_assoc J, mul_inv_cancel₀ hJ.ne', one_mul]

