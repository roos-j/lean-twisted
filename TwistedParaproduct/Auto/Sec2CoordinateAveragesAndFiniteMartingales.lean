/-- On the line, averaging at two levels in either order retains the coarser
average, as required by `bp:haar-square`. -/
theorem dyadicAverage_tower {j k : ℤ} {f : ℝ → ℝ} (hf : Integrable f) :
    dyadicAverage j (dyadicAverage k f) = dyadicAverage (min j k) f := by
  have ordered (j : ℤ) (n : ℕ) (g : ℝ → ℝ) (hg : Integrable g) :
      dyadicAverage j (dyadicAverage (j + n) g) = dyadicAverage j g ∧
        dyadicAverage (j + n) (dyadicAverage j g) = dyadicAverage j g := by
    induction n generalizing g with
    | zero =>
      simp only [Nat.cast_zero, add_zero, and_self]
      ext x
      change _ * (∫ y in dyadicInterval j (dyadicIndex j x), dyadicAverage j g y) = _
      rw [integral_dyadicAverage_cell]
      rfl
    | succ n ih =>
      rw [Nat.cast_succ, ← add_assoc]
      have hdown (h : ℝ → ℝ) (hh : Integrable h) :
          dyadicAverage (j + n) (dyadicAverage (j + n + 1) h) =
            dyadicAverage (j + n) h := funext (dyadicAverage_tower_succ _ hh)
      constructor
      · rw [← (ih _ (integrable_dyadicAverage _ hg)).1, hdown _ hg, (ih _ hg).1]
      · calc
          dyadicAverage (j + n + 1) (dyadicAverage j g) =
              dyadicAverage (j + n + 1) (dyadicAverage (j + n) (dyadicAverage j g)) :=
            congrArg (dyadicAverage (j + n + 1)) (ih _ hg).2.symm
          _ = dyadicAverage (j + n) (dyadicAverage j g) :=
            funext (dyadicAverage_succ_tower (j + n) (dyadicAverage j g))
          _ = dyadicAverage j g := (ih _ hg).2
