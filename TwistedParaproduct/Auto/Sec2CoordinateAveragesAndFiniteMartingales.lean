/-- Normalized integral on a half-open interval of positive length. -/
noncomputable def intervalAverage (a b : ℝ) (f : ℝ → ℝ) : ℝ :=
  (b - a)⁻¹ * ∫ x in Ico a b, f x

/-- The parent average is the mean of its two child averages (`bp:haar-square`). -/
theorem intervalAverage_children {a b : ℝ} (hab : a < b) {f : ℝ → ℝ}
    (hf : IntegrableOn f (Ico a b)) :
    let c := (a + b) / 2
    intervalAverage a b f = (intervalAverage a c f + intervalAverage c b f) / 2 := by
  dsimp only
  let c := (a + b) / 2
  change intervalAverage a b f = (intervalAverage a c f + intervalAverage c b f) / 2
  have hac : a < c := by dsimp [c]; linarith
  have hcb : c < b := by dsimp [c]; linarith
  have hu := Ico_union_Ico_eq_Ico hac.le hcb.le
  have hsplit : (∫ x in Ico a b, f x) =
      (∫ x in Ico a c, f x) + ∫ x in Ico c b, f x := by
    rw [← hu]
    refine setIntegral_union ?_ measurableSet_Ico ?_ ?_
    · exact Set.disjoint_left.mpr fun x hx hy => (not_lt_of_ge hy.1) hx.2
    · exact hf.mono_set fun x hx => ⟨hx.1, hx.2.trans hcb⟩
    · exact hf.mono_set fun x hx => ⟨hac.le.trans hx.1, hx.2⟩
  have hl : c - a = (b - a) / 2 := by dsimp [c]; ring
  have hr : b - c = (b - a) / 2 := by dsimp [c]; ring
  unfold intervalAverage
  rw [hsplit, hl, hr]
  have hne : b - a ≠ 0 := sub_ne_zero.mpr hab.ne'
  field_simp

/-- The mean squared child averages minus the squared parent average equals
the squared half difference of the child averages (`bp:haar-square`). -/
theorem haarSquare_children {a b : ℝ} (hab : a < b) {f : ℝ → ℝ}
    (hf : IntegrableOn f (Ico a b)) :
    let c := (a + b) / 2
    ((intervalAverage a c f)^2 + (intervalAverage c b f)^2) / 2 -
      (intervalAverage a b f)^2 =
        ((intervalAverage a c f - intervalAverage c b f) / 2)^2 := by
  dsimp only
  rw [intervalAverage_children hab hf]
  ring

