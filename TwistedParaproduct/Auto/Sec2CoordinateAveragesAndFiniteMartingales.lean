  · have he : j + ((k - j).toNat : ℤ) = k := by omega
    simpa only [he, min_eq_left hjk] using (ordered j (k - j).toNat f hf).1
  · have he : k + ((j - k).toNat : ℤ) = j := by omega
    simpa only [he, min_eq_right hkj] using (ordered k (j - k).toNat f hf).2

/-- The directional average reduces to the one-dimensional average on each fiber. -/
theorem coordinateAverage_eq_dyadicAverage {d : ℕ} (i : Fin d) (k : ℤ)
    (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ) :
    coordinateAverage i k f x =
      dyadicAverage k (fun y => f (Function.update x i y)) (x i) :=
  rfl

/-- Directional averages compose by retaining the coarser level, on every
integrable fiber (`bp:haar-square`). -/
theorem coordinateAverage_tower {d : ℕ} (i : Fin d) (j k : ℤ)
    {f : (Fin d → ℝ) → ℝ} {x : Fin d → ℝ}
    (hf : Integrable (fun y => f (Function.update x i y))) :
    coordinateAverage i j (coordinateAverage i k f) x = coordinateAverage i (min j k) f x := by
  rw [coordinateAverage_eq_dyadicAverage, coordinateAverage_eq_dyadicAverage]
  have hfiber :
      (fun y => coordinateAverage i k f (Function.update x i y)) =
        dyadicAverage k (fun y => f (Function.update x i y)) := by
    funext y
    rw [coordinateAverage_eq_dyadicAverage, Function.update_self]
    simp only [Function.update_idem]
  rw [hfiber, dyadicAverage_tower hf]

private theorem measurable_dyadicIndex (k : ℤ) : Measurable (dyadicIndex k) :=
  Int.measurable_floor.comp (measurable_id.div_const ((2 : ℝ) ^ (-k)))

/-- Directional averaging preserves measurability. -/
theorem measurable_coordinateAverage {d : ℕ} (i : Fin d) (k : ℤ)
    {f : (Fin d → ℝ) → ℝ} (hf : Measurable f) :
    Measurable (coordinateAverage i k f) := by
  let A : Set ((Fin d → ℝ) × ℝ) :=
    {z | dyadicIndex k z.2 = dyadicIndex k (z.1 i)}
  have hA : MeasurableSet A :=
    measurableSet_eq_fun ((measurable_dyadicIndex k).comp measurable_snd)
      ((measurable_dyadicIndex k).comp ((measurable_pi_apply i).comp measurable_fst))
  have hu : Measurable (fun z : (Fin d → ℝ) × ℝ => Function.update z.1 i z.2) :=
    measurable_update'
  have h := ((hf.comp hu).indicator hA).stronglyMeasurable.integral_prod_right'
    (ν := (volume : Measure ℝ))
  apply Measurable.const_mul _ (((2 : ℝ) ^ (-k))⁻¹)
  convert h.measurable using 1
  ext x
  have hcell : MeasurableSet (dyadicInterval k (dyadicIndex k (x i))) := measurableSet_Ico
  rw [← integral_indicator hcell]
  congr 1
  funext y
  simp only [Set.indicator, mem_dyadicInterval_iff, A, mem_ofPred_eq, Function.comp_apply]

/-- The directional (L^p) contraction of `bp:haar-square` for measurable
real representatives in the product-coordinate model. -/
theorem coordinateAverage_eLpNorm_le {d : ℕ} (i : Fin d) (k : ℤ) {p : ℝ}
    (hp : 1 ≤ p) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (coordinateAverage i k f) (ENNReal.ofReal p) volume ≤
      eLpNorm f (ENNReal.ofReal p) volume := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm _
    let g := f ∘ e
    let a := coordinateAverage i k f ∘ e
    have hg : Measurable g := hm.comp e.measurable
    have ha : Measurable a := (measurable_coordinateAverage i k hm).comp e.measurable
    have hgLp : MemLp g (ENNReal.ofReal p) volume := hf.comp_measurePreserving he
    have hslice (s : ℝ) (y : Fin n → ℝ) : a (s, y) = dyadicAverage k (fun t => g (t, y)) s := by
      change coordinateAverage i k f (i.insertNth s y) =
        dyadicAverage k (fun t => f (i.insertNth t y)) s
      simp only [coordinateAverage_eq_dyadicAverage, Fin.insertNth_apply_same,
        Fin.update_insertNth]
    have hp0 : 0 < p := zero_lt_one.trans_le hp
    have hpz := ENNReal.ofReal_ne_zero_iff.mpr hp0
    have hpt : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
    have hrpow (x : ℝ) : ENNReal.ofReal (‖x‖ ^ p) = ‖x‖ₑ ^ p := by
      rw [← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg x) hp0.le, Real.norm_eq_abs,
        ← Real.enorm_eq_ofReal_abs]
    have hpower : Integrable (fun z => ‖g z‖ ^ p) volume := by
      simpa only [ENNReal.toReal_ofReal hp0.le] using hgLp.integrable_norm_rpow hpz hpt
    rw [Measure.volume_eq_prod] at hpower
    have hs := hpower.prod_left_ae
    have hmoment :
        (∫⁻ z, ‖a z‖ₑ ^ p ∂volume) ≤ ∫⁻ z, ‖g z‖ₑ ^ p ∂volume := by
      rw [Measure.volume_eq_prod, lintegral_prod_symm' _ (ha.enorm.pow_const _),
        lintegral_prod_symm' _ (hg.enorm.pow_const _)]
      apply lintegral_mono_ae
      filter_upwards [hs] with y hy
      have hmy : Measurable (fun x => g (x, y)) := hg.comp (measurable_id.prodMk measurable_const)
      have hLpy : MemLp (fun x => g (x, y)) (ENNReal.ofReal p) volume := by
        apply (integrable_norm_rpow_iff hmy.aestronglyMeasurable hpz hpt).mp
        simpa only [ENNReal.toReal_ofReal hp0.le] using hy
      have hlocal (j : ℤ) : IntegrableOn (fun x => g (x, y)) (dyadicInterval k j) := by
        let : IsFiniteMeasure (volume.restrict (dyadicInterval k j)) :=
          ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
        exact (hLpy.restrict _).integrable (by simpa using ENNReal.ofReal_le_ofReal hp)
      simp only [hslice]
      simpa only [hrpow] using dyadicAverage_moment_le k hp hlocal (fun _ => hy.integrableOn)
    rw [← eLpNorm_comp_measurePreserving (measurable_coordinateAverage i k hm).aestronglyMeasurable he,
      ← eLpNorm_comp_measurePreserving hm.aestronglyMeasurable he]
    change eLpNorm a _ _ ≤ eLpNorm g _ _
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hpz hpt ha.aestronglyMeasurable,
      eLpNorm_eq_lintegral_rpow_enorm_toReal hpz hpt hg.aestronglyMeasurable,
      ENNReal.toReal_ofReal hp0.le]
    exact ENNReal.rpow_le_rpow hmoment (by positivity)

/-- The dyadic Haar function, positive on the left and negative on the right. -/
noncomputable def dyadicHaar (k n : ℤ) (x : ℝ) : ℝ :=
  (dyadicInterval (k + 1) (2 * n)).indicator (fun _ => 1) x -
    (dyadicInterval (k + 1) (2 * n + 1)).indicator (fun _ => 1) x

/-- The difference of successive averages is the Haar function times the
normalized Haar coefficient, on the parent interval. -/
theorem dyadicAverage_difference_eq_haar (k n : ℤ) {f : ℝ → ℝ} {x : ℝ}
    (hx : x ∈ dyadicInterval k n) (hf : IntegrableOn f (dyadicInterval k n)) :
    dyadicAverage (k + 1) f x - dyadicAverage k f x =
      dyadicHaar k n x * (((2 : ℝ) ^ (-k))⁻¹ *
        ∫ y in dyadicInterval k n, dyadicHaar k n y * f y) := by
  let L := dyadicInterval (k + 1) (2 * n)
  let R := dyadicInterval (k + 1) (2 * n + 1)
  have hLR : L ∪ R = dyadicInterval k n := dyadicInterval_children k n
  have hdis : Disjoint L R := pairwiseDisjoint_dyadicInterval _ (by omega)
  have hLm : MeasurableSet L := measurableSet_Ico
  have hRm : MeasurableSet R := measurableSet_Ico
  have hfL := hf.mono_set (show L ⊆ dyadicInterval k n from hLR ▸ subset_union_left)
  have hfR := hf.mono_set (show R ⊆ dyadicInterval k n from hLR ▸ subset_union_right)
  have hi : (∫ y in dyadicInterval k n, f y) = (∫ y in L, f y) + ∫ y in R, f y := by
    rw [← hLR, setIntegral_union hdis hRm hfL hfR]
  have hcoeff : (∫ y in dyadicInterval k n, dyadicHaar k n y * f y) =
      (∫ y in L, f y) - ∫ y in R, f y := by
    have heq (y : ℝ) : dyadicHaar k n y * f y =
        L.indicator f y - R.indicator f y := by
      change (L.indicator (fun _ => 1) y - R.indicator (fun _ => 1) y) * f y = _
      rw [sub_mul]
      simp only [indicator, ite_mul, one_mul, zero_mul]
    simp_rw [heq]
    rw [integral_sub, integral_indicator hLm, integral_indicator hRm,
      Measure.restrict_restrict hLm, Measure.restrict_restrict hRm, inter_eq_left.mpr,
      inter_eq_left.mpr]
    · exact hLR ▸ subset_union_right
    · exact hLR ▸ subset_union_left
    · rw [integrable_indicator_iff hLm, IntegrableOn, Measure.restrict_restrict hLm,
        inter_eq_left.mpr (hLR ▸ subset_union_left)]
      exact hfL
    · rw [integrable_indicator_iff hRm, IntegrableOn, Measure.restrict_restrict hRm,
        inter_eq_left.mpr (hLR ▸ subset_union_right)]
      exact hfR
  have hscale : ((2 : ℝ) ^ (-(k + 1)))⁻¹ = 2 * ((2 : ℝ) ^ (-k))⁻¹ := by
    rw [neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_neg_one,
      mul_inv_rev, inv_inv]
  have hx' : x ∈ L ∪ R := hLR ▸ hx
  rw [hcoeff]
  unfold dyadicAverage
  rw [mem_dyadicInterval_iff.mp hx, hi, hscale]
  change _ = (L.indicator (fun _ => 1) x - R.indicator (fun _ => 1) x) * _
  rcases hx' with hxL | hxR
  · have hnot : x ∉ R := fun h => Set.disjoint_left.mp hdis hxL h
    rw [mem_dyadicInterval_iff.mp hxL, indicator_of_mem hxL, indicator_of_notMem hnot]
    change 2 * _ * (∫ y in L, f y) - _ = _
    ring
  · have hnot : x ∉ L := fun h => Set.disjoint_left.mp hdis h hxR
    rw [mem_dyadicInterval_iff.mp hxR, indicator_of_mem hxR, indicator_of_notMem hnot]
    change 2 * _ * (∫ y in R, f y) - _ = _
    ring

private theorem ae_dyadicAverage_eq_cell (k n : ℤ) (f : ℝ → ℝ) :
    dyadicAverage k f =ᵐ[volume.restrict (dyadicInterval k n)]
      fun _ => ((2 : ℝ) ^ (-k))⁻¹ * ∫ y in dyadicInterval k n, f y := by
  have hcell : MeasurableSet (dyadicInterval k n) := measurableSet_Ico
  filter_upwards [ae_restrict_mem (μ := (volume : Measure ℝ)) hcell] with x hx
  simp only [dyadicAverage, mem_dyadicInterval_iff.mp hx]

private theorem integral_dyadicAverage_succ_cell (k n : ℤ) {f : ℝ → ℝ}
    (hf : IntegrableOn f (dyadicInterval k n)) :
    (∫ y in dyadicInterval k n, dyadicAverage (k + 1) f y) =
      ∫ y in dyadicInterval k n, f y := by
  have hu := dyadicInterval_children k n
  have hd : Disjoint (dyadicInterval (k + 1) (2 * n)) (dyadicInterval (k + 1) (2 * n + 1)) :=
    pairwiseDisjoint_dyadicInterval _ (by omega)
  have hright : MeasurableSet (dyadicInterval (k + 1) (2 * n + 1)) := measurableSet_Ico
  have hlocal (m : ℤ) : IntegrableOn (dyadicAverage (k + 1) f) (dyadicInterval (k + 1) m) := by
    let : IsFiniteMeasure (volume.restrict (dyadicInterval (k + 1) m)) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
    exact (integrable_const _).congr (ae_dyadicAverage_eq_cell _ m f).symm
  rw [← hu, setIntegral_union hd hright (hlocal _) (hlocal _),
    integral_dyadicAverage_cell, integral_dyadicAverage_cell,
    setIntegral_union hd hright (hf.mono_set (hu ▸ subset_union_left))
      (hf.mono_set (hu ▸ subset_union_right))]

/-- The integrated Haar square is the difference of the squared norms of
successive averages on the line. -/
theorem dyadicAverage_integral_sq_difference (k : ℤ) {f : ℝ → ℝ}
    (hf : MemLp f 2 volume) :
    (∫ x, (dyadicAverage (k + 1) f x - dyadicAverage k f x)^2) =
      (∫ x, (dyadicAverage (k + 1) f x)^2) - ∫ x, (dyadicAverage k f x)^2 := by
  have hLp (j : ℤ) : MemLp (dyadicAverage j f) 2 volume := by
    have h := dyadicAverage_eLpNorm_le j (p := 2) (by norm_num) (by simpa using hf)
    exact (by simpa using h : eLpNorm (dyadicAverage j f) 2 volume ≤ eLpNorm f 2 volume)
      |>.trans_lt hf.eLpNorm_lt_top
  have hfine := hLp (k + 1)
  have hcoarse := hLp k
  have hmul : Integrable (fun x => dyadicAverage (k + 1) f x * dyadicAverage k f x) :=
    hfine.integrable_mul hcoarse
  have hcross : (∫ x, dyadicAverage (k + 1) f x * dyadicAverage k f x) =
      ∫ x, (dyadicAverage k f x)^2 := by
    have hsplit {g : ℝ → ℝ} (hg : Integrable g) :
        (∫ x, g x) = ∑' n, ∫ x in dyadicInterval k n, g x := by
      simpa only [iUnion_dyadicInterval, Measure.restrict_univ] using
        integral_iUnion (s := dyadicInterval k)
          (fun _ => measurableSet_Ico) (pairwiseDisjoint_dyadicInterval k)
          (by simpa only [iUnion_dyadicInterval, integrableOn_univ] using hg)
    rw [hsplit hmul, hsplit hcoarse.integrable_sq]
    congr 1
    funext n
    let C := ((2 : ℝ) ^ (-k))⁻¹ * ∫ y in dyadicInterval k n, f y
    have hC : dyadicAverage k f =ᵐ[volume.restrict (dyadicInterval k n)] fun _ => C :=
      ae_dyadicAverage_eq_cell k n f
    have hlocal : IntegrableOn f (dyadicInterval k n) := by
      let : IsFiniteMeasure (volume.restrict (dyadicInterval k n)) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
      exact (hf.restrict _).integrable (by norm_num)
    have hprod : (fun x => dyadicAverage (k + 1) f x * dyadicAverage k f x) =ᵐ[
        volume.restrict (dyadicInterval k n)] fun x => dyadicAverage (k + 1) f x * C :=
      hC.mono fun x hx => congrArg (dyadicAverage (k + 1) f x * ·) hx
    have hsq : (fun x => (dyadicAverage k f x)^2) =ᵐ[
        volume.restrict (dyadicInterval k n)] fun _ => C^2 :=
      hC.mono fun _ hx => congrArg (· ^ 2) hx
    rw [integral_congr_ae hprod, integral_congr_ae hsq]
    rw [integral_mul_const, integral_dyadicAverage_succ_cell k n hlocal]
    have hconst : (∫ x in dyadicInterval k n, C) = ∫ x in dyadicInterval k n, f x :=
      (integral_congr_ae hC).symm.trans (integral_dyadicAverage_cell k n f)
    rw [pow_two, integral_mul_const, hconst]
  simp_rw [sub_sq, mul_assoc]
  have hadd := integral_add (hfine.integrable_sq.sub (hmul.const_mul 2)) hcoarse.integrable_sq
  have hsub := integral_sub hfine.integrable_sq (hmul.const_mul 2)
  simp only [Pi.sub_apply] at hadd hsub
  rw [hadd, hsub, integral_const_mul, hcross]
  ring

/-- The directional Haar square identity after integration in all coordinates. -/
theorem coordinateDifference_integral_sq {d : ℕ} (i : Fin d) (k : ℤ)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (hf : MemLp f 2 volume) :
    (∫ x, (coordinateDifference i k f x)^2) =
      (∫ x, (coordinateAverage i (k + 1) f x)^2) -
        ∫ x, (coordinateAverage i k f x)^2 := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm _
    let g := f ∘ e
    let a (j : ℤ) := coordinateAverage i j f ∘ e
    have hg : Measurable g := hm.comp e.measurable
    have hgLp : MemLp g 2 volume := hf.comp_measurePreserving he
    have hslice (j : ℤ) (s : ℝ) (y : Fin n → ℝ) :
        a j (s, y) = dyadicAverage j (fun t => g (t, y)) s := by
      change coordinateAverage i j f (i.insertNth s y) =
        dyadicAverage j (fun t => f (i.insertNth t y)) s
      simp only [coordinateAverage_eq_dyadicAverage, Fin.insertNth_apply_same,
        Fin.update_insertNth]
    have haLp (j : ℤ) : MemLp (a j) 2 volume := by
      have h := coordinateAverage_eLpNorm_le i j (p := 2) (by norm_num) hm (by simpa using hf)
      have h' : MemLp (coordinateAverage i j f) 2 volume :=
        (by simpa using h : eLpNorm (coordinateAverage i j f) 2 volume ≤ eLpNorm f 2 volume)
          |>.trans_lt hf.eLpNorm_lt_top
      exact h'.comp_measurePreserving he
    have hgSq := hgLp.integrable_sq
    have haSq (j : ℤ) := (haLp j).integrable_sq
    have hdSq := ((haLp (k + 1)).sub (haLp k)).integrable_sq
    rw [Measure.volume_eq_prod] at hgSq hdSq
    simp_rw [Measure.volume_eq_prod] at haSq
    simp_rw [← he.integral_comp']
    change (∫ z, (a (k + 1) z - a k z)^2) =
      (∫ z, (a (k + 1) z)^2) - ∫ z, (a k z)^2
    simp only [Measure.volume_eq_prod]
    have hd : Integrable (fun z => (a (k + 1) z - a k z)^2)
        ((volume : Measure ℝ).prod (volume : Measure (Fin n → ℝ))) := hdSq
    rw [integral_prod_symm _ hd, integral_prod_symm _ (haSq _),
      integral_prod_symm _ (haSq _), ← integral_sub (haSq _).integral_prod_right
        (haSq _).integral_prod_right]
    apply integral_congr_ae
    filter_upwards [hgSq.prod_left_ae] with y hy
    have hmy : Measurable (fun x => g (x, y)) := hg.comp (measurable_id.prodMk measurable_const)
    have hLpy := (memLp_two_iff_integrable_sq hmy.aestronglyMeasurable).mpr hy
    simpa only [hslice] using dyadicAverage_integral_sq_difference k hLpy

/-- The pointwise coordinate Haar formula on the parent cell. -/
theorem coordinateDifference_eq_haar {d : ℕ} (i : Fin d) (k n : ℤ)
    {f : (Fin d → ℝ) → ℝ} {x : Fin d → ℝ}
    (hx : x i ∈ dyadicInterval k n)
    (hf : IntegrableOn (fun y => f (Function.update x i y)) (dyadicInterval k n)) :
    coordinateDifference i k f x =
      dyadicHaar k n (x i) * (((2 : ℝ) ^ (-k))⁻¹ *
        ∫ y in dyadicInterval k n, dyadicHaar k n y * f (Function.update x i y)) := by
  simpa only [coordinateDifference, coordinateAverage_eq_dyadicAverage] using
    dyadicAverage_difference_eq_haar k n hx hf

private theorem lpNorm_two_sq_eq_integral_sq {α : Type*} [MeasureSpace α]
    {f : α → ℝ} (hf : AEStronglyMeasurable f volume) :
    (lpNorm f 2 volume)^2 = ∫ x, (f x)^2 := by
  have htwo : (2 : ℝ≥0∞).toReal = 2 := by norm_num
  rw [lpNorm_eq_integral_norm_rpow_toReal (by norm_num) (by simp) hf, htwo]
  simp only [Real.rpow_two, sq_abs, Real.norm_eq_abs]
  rw [← Real.rpow_natCast, ← Real.rpow_mul (integral_nonneg (fun _ => sq_nonneg _))]
  norm_num

/-- Summing the finite directional square function over consecutive levels
costs at most the squared (L^2) norm of the input. -/
theorem coordinateDifference_sum_integral_sq_le {d : ℕ} (i : Fin d) (u : ℤ) (N : ℕ)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (hf : MemLp f 2 volume) :
    ∑ n ∈ Finset.range N, ∫ x, (coordinateDifference i (u + n) f x)^2 ≤
      ∫ x, (f x)^2 := by
  let Q (j : ℤ) := ∫ x, (coordinateAverage i j f x)^2
  have hsucc (n : ℕ) :
      (∫ x, (coordinateDifference i (u + n) f x)^2) = Q (u + (n + 1 : ℕ)) - Q (u + n) := by
    simpa only [Q, Nat.cast_add, Nat.cast_one, add_assoc] using
      coordinateDifference_integral_sq i (u + n) hm hf
  simp_rw [hsucc]
  rw [Finset.sum_range_sub (fun n : ℕ => Q (u + n))]
  have hnonneg : 0 ≤ Q u := integral_nonneg fun _ => sq_nonneg _
  have hcontraction := coordinateAverage_eLpNorm_le i (u + N) (p := 2) (by norm_num) hm
    (by simpa using hf)
  have hle : eLpNorm (coordinateAverage i (u + N) f) 2 volume ≤ eLpNorm f 2 volume := by
    simpa using hcontraction
  have hre : lpNorm (coordinateAverage i (u + N) f) 2 volume ≤ lpNorm f 2 volume :=
    ENNReal.toReal_mono hf.eLpNorm_lt_top.ne hle
  have hq : Q (u + N) ≤ ∫ x, (f x)^2 := by
    change (∫ x, (coordinateAverage i (u + N) f x)^2) ≤ ∫ x, (f x)^2
    rw [← lpNorm_two_sq_eq_integral_sq
      (measurable_coordinateAverage i _ hm).aestronglyMeasurable,
      ← lpNorm_two_sq_eq_integral_sq hm.aestronglyMeasurable]
    exact pow_le_pow_left₀ lpNorm_nonneg hre 2
  simpa only [Nat.cast_zero, add_zero] using (sub_le_self _ hnonneg).trans hq

/-- Two dyadic cells containing a common point are nested in level order. -/
theorem dyadicInterval_subset_of_mem {k j : ℤ} (hkj : k ≤ j) {m n : ℤ} {x : ℝ}
    (hxj : x ∈ dyadicInterval j n) (hxk : x ∈ dyadicInterval k m) :
    dyadicInterval j n ⊆ dyadicInterval k m := by
  have hs (l : ℤ) :
      dyadicInterval (l + 1) (dyadicIndex (l + 1) x) ⊆ dyadicInterval l (dyadicIndex l x) := by
    rw [← dyadicInterval_children l (dyadicIndex l x)]
    rcases dyadicIndex_succ (k := l) (x := x) with h | h
    · rw [h]
      exact subset_union_left
    · rw [h]
      exact subset_union_right
  have hiter (r : ℕ) :
      dyadicInterval (k + r) (dyadicIndex (k + r) x) ⊆ dyadicInterval k (dyadicIndex k x) := by
    induction r with
    | zero => simp
    | succ r ih =>
      rw [Nat.cast_succ, ← add_assoc]
      exact (hs (k + r)).trans ih
  have he : k + ((j - k).toNat : ℤ) = j := by omega
  simpa only [he, mem_dyadicInterval_iff.mp hxj, mem_dyadicInterval_iff.mp hxk] using
    hiter (j - k).toNat

/-- The strict superlevel set of the one-dimensional dyadic maximal average. -/
def dyadicMaxLevel (f : ℝ → ℝ) (threshold : ℝ) : Set ℝ :=
  {x | ∃ k : ℤ, threshold < dyadicAverage k (fun y => |f y|) x}

/-- A dyadic interval whose average exceeds the threshold. -/
def dyadicCellBad (f : ℝ → ℝ) (threshold : ℝ) (c : ℤ × ℤ) : Prop :=
  threshold < ((2 : ℝ) ^ (-c.1))⁻¹ * ∫ y in dyadicInterval c.1 c.2, |f y|

/-- A bad dyadic interval without a strictly larger bad dyadic ancestor. -/
def dyadicMaximalCell (f : ℝ → ℝ) (threshold : ℝ) (c : ℤ × ℤ) : Prop :=
  dyadicCellBad f threshold c ∧
    ∀ b : ℤ × ℤ, b.1 < c.1 → dyadicInterval c.1 c.2 ⊆ dyadicInterval b.1 b.2 →
      ¬ dyadicCellBad f threshold b

theorem disjoint_dyadicMaximalCells {f : ℝ → ℝ} {threshold : ℝ} :
    Pairwise (Disjoint on fun c : {c : ℤ × ℤ // dyadicMaximalCell f threshold c} =>
      dyadicInterval c.val.1 c.val.2) := by
  intro a b hab
  refine disjoint_left.mpr fun x hxa hxb => ?_
  rcases lt_trichotomy a.val.1 b.val.1 with h | h | h
  · exact b.property.2 a.val h (dyadicInterval_subset_of_mem h.le hxb hxa) a.property.1
  · apply hab
    apply Subtype.ext
    apply Prod.ext h
    exact (mem_dyadicInterval_iff.mp hxa).symm.trans
      ((congrArg (fun k => dyadicIndex k x) h).trans (mem_dyadicInterval_iff.mp hxb))
  · exact a.property.2 b.val h (dyadicInterval_subset_of_mem h.le hxa hxb) b.property.1

theorem dyadicMaxLevel_eq_union {f : ℝ → ℝ} (hf : Integrable f)
    {threshold : ℝ} (ht : 0 < threshold) :
    dyadicMaxLevel f threshold =
      ⋃ c : {c : ℤ × ℤ // dyadicMaximalCell f threshold c},
        dyadicInterval c.val.1 c.val.2 := by
  let M := ∫ x, |f x|
  obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt (M / threshold) (show (1 : ℝ) < 2 by norm_num)
  have hbound (c : ℤ × ℤ) (hc : dyadicCellBad f threshold c) : -(N : ℤ) ≤ c.1 := by
    by_contra! h
    have hlen : (2 : ℝ) ^ N ≤ (2 : ℝ) ^ (-c.1) := by
      rw [← zpow_natCast]
      exact zpow_le_zpow_right₀ (by norm_num) (by omega)
    have hbad := (lt_inv_mul_iff₀ (zpow_pos (by norm_num : (0 : ℝ) < 2) _)).mp hc
    have hmass : (∫ y in dyadicInterval c.1 c.2, |f y|) ≤ M :=
      setIntegral_le_integral (by simpa only [Real.norm_eq_abs] using hf.norm)
        (Filter.Eventually.of_forall fun x => abs_nonneg (f x))
    have hM := (div_lt_iff₀ ht).mp hN
    exact (not_lt_of_ge (hmass.trans (hM.le.trans (mul_le_mul_of_nonneg_right hlen ht.le)))) hbad
  ext x
  constructor
  · rintro ⟨k, hk⟩
    let P (j : ℤ) := dyadicCellBad f threshold (j, dyadicIndex j x)
    obtain ⟨j, hj, hmin⟩ := Int.exists_least_of_bdd
      (P := P) ⟨-(N : ℤ), fun j hj => hbound (j, dyadicIndex j x) hj⟩ ⟨k, hk⟩
    have hx : x ∈ dyadicInterval j (dyadicIndex j x) := mem_dyadicInterval_iff.mpr rfl
    have hmax : dyadicMaximalCell f threshold (j, dyadicIndex j x) := by
      refine ⟨hj, fun b hbj hsubset hb => ?_⟩
      have he := mem_dyadicInterval_iff.mp (hsubset hx)
      apply (not_le_of_gt hbj)
      apply hmin b.1
      change dyadicCellBad f threshold (b.1, dyadicIndex b.1 x)
      rw [he]
      exact hb
    exact mem_iUnion.mpr ⟨⟨_, hmax⟩, hx⟩
  · intro hx
    obtain ⟨c, hc⟩ := mem_iUnion.mp hx
    refine ⟨c.val.1, ?_⟩
    unfold dyadicAverage
    rw [mem_dyadicInterval_iff.mp hc]
    exact c.property.1

/-- Measurability of the strict dyadic maximal superlevel set. -/
theorem measurableSet_dyadicMaxLevel (f : ℝ → ℝ) (threshold : ℝ) :
    MeasurableSet (dyadicMaxLevel f threshold) := by
  rw [show dyadicMaxLevel f threshold =
    ⋃ k : ℤ, {x | threshold < dyadicAverage k (fun y => |f y|) x} by
      ext x
      simp only [dyadicMaxLevel, mem_ofPred_eq, mem_iUnion]]
  exact MeasurableSet.iUnion fun k =>
    measurableSet_lt measurable_const (measurable_dyadicAverage k _)

/-- The weak (L^1) bound on the line in `bp:dyadic-max`. -/
theorem volume_dyadicMaxLevel_le {f : ℝ → ℝ} (hf : Integrable f)
    {threshold : ℝ} (ht : 0 < threshold) :
    volume (dyadicMaxLevel f threshold) ≤
      (ENNReal.ofReal threshold)⁻¹ * ∫⁻ x, ‖f x‖ₑ := by
  let Cells := {c : ℤ × ℤ // dyadicMaximalCell f threshold c}
  let I (c : Cells) := dyadicInterval c.val.1 c.val.2
  have hI (c : Cells) : MeasurableSet (I c) := measurableSet_Ico
  have hlocal (c : Cells) :
      volume (I c) ≤ (ENNReal.ofReal threshold)⁻¹ * ∫⁻ x in I c, ‖f x‖ₑ := by
    let L := (2 : ℝ) ^ (-c.val.1)
    have hL : 0 < L := zpow_pos (by norm_num) _
    have hv : volume (I c) = ENNReal.ofReal L := by
      unfold I dyadicInterval
      rw [Real.volume_Ico]
      congr 1
      ring
    have hlt : threshold < L⁻¹ * ∫ y in I c, |f y| := c.property.1
    have hreal : L ≤ threshold⁻¹ * ∫ x in I c, |f x| := by
      apply (le_inv_mul_iff₀ ht).mpr
      rw [mul_comm]
      exact ((lt_inv_mul_iff₀ hL).mp hlt).le
    rw [hv]
    have habs : IntegrableOn (fun x => |f x|) (I c) := by
      simpa only [Real.norm_eq_abs] using hf.norm.integrableOn (s := I c)
    have hinner : ENNReal.ofReal (∫ x in I c, |f x|) = ∫⁻ x in I c, ‖f x‖ₑ := by
      rw [ofReal_integral_eq_lintegral_ofReal habs
        (Filter.Eventually.of_forall fun x => abs_nonneg (f x))]
      simp only [← Real.enorm_eq_ofReal_abs]
    simpa only [ENNReal.ofReal_mul (inv_nonneg.mpr ht.le), ENNReal.ofReal_inv_of_pos ht, hinner]
      using ENNReal.ofReal_le_ofReal hreal
  rw [dyadicMaxLevel_eq_union hf ht]
  change volume (⋃ c, I c) ≤ _
  calc
    _ ≤ ∑' c, volume (I c) := measure_iUnion_le I
    _ ≤ ∑' c, (ENNReal.ofReal threshold)⁻¹ * ∫⁻ x in I c, ‖f x‖ₑ :=
      ENNReal.tsum_le_tsum hlocal
    _ = (ENNReal.ofReal threshold)⁻¹ * ∫⁻ x in ⋃ c, I c, ‖f x‖ₑ := by
      rw [ENNReal.tsum_mul_left, lintegral_iUnion hI disjoint_dyadicMaximalCells]
    _ ≤ _ := by
      gcongr
      exact Measure.restrict_le_self

/-- The strict superlevel set of the directional dyadic maximal average. -/
def coordinateMaxLevel {d : ℕ} (i : Fin d) (f : (Fin d → ℝ) → ℝ)
    (threshold : ℝ) : Set (Fin d → ℝ) :=
  {x | ∃ k : ℤ, threshold < coordinateAverage i k (fun y => |f y|) x}

theorem measurableSet_coordinateMaxLevel {d : ℕ} (i : Fin d)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (threshold : ℝ) :
    MeasurableSet (coordinateMaxLevel i f threshold) := by
  rw [show coordinateMaxLevel i f threshold =
    ⋃ k : ℤ, {x | threshold < coordinateAverage i k (fun y => |f y|) x} by
      ext x
      simp only [coordinateMaxLevel, mem_ofPred_eq, mem_iUnion]]
  exact MeasurableSet.iUnion fun k =>
    measurableSet_lt measurable_const
      (measurable_coordinateAverage i k (continuous_abs.measurable.comp hm))

/-- The directional weak (L^1) maximal inequality of `bp:dyadic-max`. -/
theorem volume_coordinateMaxLevel_le {d : ℕ} (i : Fin d) {f : (Fin d → ℝ) → ℝ}
    (hm : Measurable f) (hf : Integrable f) {threshold : ℝ} (ht : 0 < threshold) :
    volume (coordinateMaxLevel i f threshold) ≤
      (ENNReal.ofReal threshold)⁻¹ * ∫⁻ x, ‖f x‖ₑ := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm _
    let A := coordinateMaxLevel i f threshold
    let g := f ∘ e
    have hA : MeasurableSet A := measurableSet_coordinateMaxLevel i hm threshold
    have hg : Measurable g := hm.comp e.measurable
    have hgi : Integrable g ((volume : Measure ℝ).prod (volume : Measure (Fin n → ℝ))) := by
      rw [← Measure.volume_eq_prod]
      exact (he.integrable_comp_emb e.measurableEmbedding).mpr hf
    have heA (y : Fin n → ℝ) :
        (fun x : ℝ => (x, y)) ⁻¹' (e ⁻¹' A) = dyadicMaxLevel (fun x => g (x, y)) threshold := by
      ext x
      change (∃ k : ℤ, threshold < coordinateAverage i k (fun z => |f z|) (i.insertNth x y)) ↔
        ∃ k : ℤ, threshold < dyadicAverage k (fun t => |f (i.insertNth t y)|) x
      simp only [coordinateAverage_eq_dyadicAverage, Fin.update_insertNth, Fin.insertNth_apply_same]
    change volume A ≤ _
    nth_rw 1 [← he.map_eq]
    rw [Measure.map_apply e.measurable hA]
    rw [← he.lintegral_comp_emb e.measurableEmbedding (fun x => ‖f x‖ₑ)]
    change volume (e ⁻¹' A) ≤ _ * ∫⁻ z, ‖g z‖ₑ
    rw [Measure.volume_eq_prod, Measure.prod_apply_symm (hA.preimage e.measurable),
      lintegral_prod_symm' _ hg.enorm, ← lintegral_const_mul]
    · apply lintegral_mono_ae
      filter_upwards [hgi.prod_left_ae] with y hy
      rw [heA y]
      exact volume_dyadicMaxLevel_le hy ht
    · exact hg.enorm.lintegral_prod_left' (μ := (volume : Measure ℝ))

/-- Dyadic differentiation on the line, using the Lebesgue differentiation
theorem on the closed intervals with the same endpoints. -/
theorem ae_tendsto_dyadicAverage {f : ℝ → ℝ} (hf : Integrable f) :
    ∀ᵐ x ∂(volume : Measure ℝ),
      Filter.Tendsto (fun k : ℤ => dyadicAverage k f x) Filter.atTop (nhds (f x)) := by
  filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_average
    (volume : Measure ℝ) hf.locallyIntegrable 1] with x hx
  let L (k : ℤ) := (2 : ℝ) ^ (-k)
  let a (k : ℤ) := (dyadicIndex k x : ℝ) * L k
  let b (k : ℤ) := ((dyadicIndex k x : ℝ) + 1) * L k
  let center (k : ℤ) := (a k + b k) / 2
  let radius (k : ℤ) := L k / 2
  have hL (k : ℤ) : 0 < L k := zpow_pos (by norm_num) _
  have hlen (k : ℤ) : b k - a k = L k := by dsimp [a, b]; ring
  have hball (k : ℤ) : Metric.closedBall (center k) (radius k) = Icc (a k) (b k) := by
    rw [Real.closedBall_eq_Icc]
    have h := hlen k
    dsimp only [center, radius]
    congr 1 <;> linarith
  have hnat : Filter.Tendsto (fun n : ℕ => radius n) Filter.atTop (nhds 0) := by
    have h := tendsto_pow_atTop_nhds_zero_of_lt_one (r := ((2 : ℝ)⁻¹)) (by norm_num) (by norm_num)
    simpa only [radius, L, zpow_neg, zpow_natCast, inv_pow, zero_div] using h.div_const 2
  have hrad : Filter.Tendsto radius Filter.atTop (nhdsWithin 0 (Ioi 0)) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨Metric.tendsto_nhds.mpr fun ε hε => ?_, Filter.Eventually.of_forall fun k => ?_⟩
    · obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp (Metric.tendsto_nhds.mp hnat ε hε)
      apply Filter.eventually_atTop.mpr
      refine ⟨(N : ℤ), fun k hk => ?_⟩
      have hk0 : 0 ≤ k := by omega
      have hNk : N ≤ k.toNat := by omega
      simpa only [Int.toNat_of_nonneg hk0] using hN k.toNat hNk
    · exact div_pos (hL k) (by norm_num)
  have hmem : ∀ᶠ k in (Filter.atTop : Filter ℤ),
      x ∈ Metric.closedBall (center k) (1 * radius k) :=
    Filter.Eventually.of_forall fun k => by
      rw [one_mul, hball]
      exact Ico_subset_Icc_self (mem_dyadicInterval_iff.mpr rfl)
  refine (hx center radius hrad hmem).congr' (Filter.Eventually.of_forall fun k => ?_)
  rw [hball, setAverage_eq, measureReal_def, Real.volume_Icc, hlen,
    ENNReal.toReal_ofReal (hL k).le, smul_eq_mul, ← setIntegral_congr_set Ico_ae_eq_Icc]
  rfl

/-- Directional dyadic averages converge almost everywhere for integrable
measurable inputs, as asserted in `bp:dyadic-max`. -/
theorem ae_tendsto_coordinateAverage {d : ℕ} (i : Fin d) {f : (Fin d → ℝ) → ℝ}
    (hm : Measurable f) (hf : Integrable f) :
    ∀ᵐ x ∂(volume : Measure (Fin d → ℝ)),
      Filter.Tendsto (fun k : ℤ => coordinateAverage i k f x) Filter.atTop (nhds (f x)) := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm _
    let g := f ∘ e
    let P (z : ℝ × (Fin n → ℝ)) :=
      Filter.Tendsto (fun k : ℤ => coordinateAverage i k f (e z))
        Filter.atTop (nhds (g z))
    have hP : MeasurableSet {z | P z} :=
      measurableSet_tendsto_fun (fun k => (measurable_coordinateAverage i k hm).comp e.measurable)
        (hm.comp e.measurable)
    have hgi : Integrable g ((volume : Measure ℝ).prod (volume : Measure (Fin n → ℝ))) := by
      rw [← Measure.volume_eq_prod]
      exact (he.integrable_comp_emb e.measurableEmbedding).mpr hf
    have hprod : ∀ᵐ z ∂(volume : Measure (ℝ × (Fin n → ℝ))), P z := by
      rw [Measure.volume_eq_prod, Measure.ae_prod_iff_ae_ae hP, Measure.ae_ae_comm hP]
      filter_upwards [hgi.prod_left_ae] with y hy
      filter_upwards [ae_tendsto_dyadicAverage hy] with x hx
      change Filter.Tendsto (fun k : ℤ => coordinateAverage i k f (i.insertNth x y))
        Filter.atTop (nhds (f (i.insertNth x y)))
      change Filter.Tendsto (fun k : ℤ =>
        dyadicAverage k (fun t => f (i.insertNth t y)) x)
        Filter.atTop (nhds (f (i.insertNth x y))) at hx
      simpa only [coordinateAverage_eq_dyadicAverage, Fin.update_insertNth,
        Fin.insertNth_apply_same] using hx
    filter_upwards [(he.symm e).quasiMeasurePreserving.ae hprod] with x hx
    simpa only [P, g, Function.comp_apply, MeasurableEquiv.apply_symm_apply] using hx

/-- Replace a function by its average on each maximal exceptional interval. -/
noncomputable def dyadicReplacement (A : Set ℝ) (threshold : ℝ)
    (f : ℝ → ℝ) (x : ℝ) : ℝ := by
  classical
  exact if x ∈ dyadicMaxLevel (A.indicator fun _ => 1) threshold then
    dyadicAverage (sInf {k : ℤ | threshold < dyadicAverage k (A.indicator fun _ => 1) x}) f x
    else f x

private theorem dyadicReplacement_eq_on_cell {A : Set ℝ} {threshold : ℝ}
    {f : ℝ → ℝ} {c : ℤ × ℤ}
    (hc : dyadicMaximalCell (A.indicator fun _ => 1) threshold c)
    {x : ℝ} (hx : x ∈ dyadicInterval c.1 c.2) :
    dyadicReplacement A threshold f x = dyadicAverage c.1 f x := by
  classical
  let h : ℝ → ℝ := A.indicator fun _ => 1
  have habs : (fun y => |h y|) = h := by
    funext y
    apply abs_of_nonneg
    by_cases hy : y ∈ A <;> simp [h, hy]
  have hbad : threshold < dyadicAverage c.1 h x := by
    have hb := hc.1
    change threshold < ((2 : ℝ) ^ (-c.1))⁻¹ *
      ∫ y in dyadicInterval c.1 c.2, |h y| at hb
    rw [habs] at hb
    simpa only [dyadicAverage, mem_dyadicInterval_iff.mp hx] using hb
  have hxD : x ∈ dyadicMaxLevel h threshold := ⟨c.1, habs.symm ▸ hbad⟩
  let levels : Set ℤ := {k | threshold < dyadicAverage k h x}
  have hmin : IsLeast levels c.1 := by
    refine ⟨hbad, fun j hj => ?_⟩
    by_contra! hjc
    have hxj : x ∈ dyadicInterval j (dyadicIndex j x) := mem_dyadicInterval_iff.mpr rfl
    apply hc.2 (j, dyadicIndex j x) hjc (dyadicInterval_subset_of_mem hjc.le hx hxj)
    change threshold < ((2 : ℝ) ^ (-j))⁻¹ *
      ∫ y in dyadicInterval j (dyadicIndex j x), |h y|
    rw [show (fun y => |h y|) = h from habs]
    exact hj
  unfold dyadicReplacement
  rw [ite_eq_left hxD]
  change dyadicAverage (sInf levels) f x = dyadicAverage c.1 f x
  rw [hmin.csInf_eq]

private theorem dyadicMaximalCell_average_le {A : Set ℝ} (hA : MeasurableSet A)
    (hfin : volume A ≠ ⊤) {threshold : ℝ}
    {c : ℤ × ℤ} (hc : dyadicMaximalCell (A.indicator fun _ => 1) threshold c)
    {x : ℝ} (hx : x ∈ dyadicInterval c.1 c.2) :
    dyadicAverage c.1 (A.indicator fun _ => 1) x ≤ 2 * threshold := by
  let h : ℝ → ℝ := A.indicator fun _ => 1
  have hi : Integrable h := by
    rw [show h = A.indicator (fun _ => (1 : ℝ)) from rfl, integrable_indicator_iff hA]
    let : IsFiniteMeasure ((volume : Measure ℝ).restrict A) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact hfin.lt_top⟩
    exact integrable_const _
  have hnonneg : ∀ y, 0 ≤ h y := by
    intro y
    by_cases hy : y ∈ A <;> simp [h, hy]
  have habs : (fun y => |h y|) = h := funext fun y => abs_of_nonneg (hnonneg y)
  let j := c.1 - 1
  let m := dyadicIndex j x
  have hj : j < c.1 := by dsimp [j]; omega
  have hxj : x ∈ dyadicInterval j m := mem_dyadicInterval_iff.mpr rfl
  have hsub := dyadicInterval_subset_of_mem hj.le hx hxj
  have hparent := le_of_not_gt (hc.2 (j, m) hj hsub)
  change ((2 : ℝ) ^ (-j))⁻¹ * (∫ y in dyadicInterval j m, |h y|) ≤ threshold at hparent
  rw [habs] at hparent
  have hmass : (∫ y in dyadicInterval c.1 c.2, h y) ≤ ∫ y in dyadicInterval j m, h y :=
    setIntegral_mono_set hi.integrableOn (Filter.Eventually.of_forall hnonneg)
      (Filter.Eventually.of_forall hsub)
  have hscale : ((2 : ℝ) ^ (-c.1))⁻¹ = 2 * ((2 : ℝ) ^ (-j))⁻¹ := by
    have he : -c.1 = -j + (-1) := by dsimp [j]; omega
    rw [he, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_neg_one, mul_inv_rev, inv_inv]
  change dyadicAverage c.1 h x ≤ _
  unfold dyadicAverage
  rw [mem_dyadicInterval_iff.mp hx, hscale, mul_assoc]
  exact mul_le_mul_of_nonneg_left
    ((mul_le_mul_of_nonneg_left hmass (inv_nonneg.mpr (zpow_nonneg (by norm_num) _))).trans hparent)
    (by norm_num)

private theorem ae_zero_off_dyadicMaxLevel {A : Set ℝ} (hA : MeasurableSet A)
    (hfin : volume A ≠ ⊤) {threshold : ℝ} (ht : threshold < 1) :
    ∀ᵐ x ∂(volume : Measure ℝ),
      x ∉ dyadicMaxLevel (A.indicator fun _ => 1) threshold → x ∉ A := by
  let h : ℝ → ℝ := A.indicator fun _ => 1
  have hi : Integrable h := by
    rw [show h = A.indicator (fun _ => (1 : ℝ)) from rfl, integrable_indicator_iff hA]
    let : IsFiniteMeasure ((volume : Measure ℝ).restrict A) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact hfin.lt_top⟩
    exact integrable_const _
  have habs : (fun y => |h y|) = h := by
    funext x
    by_cases hx : x ∈ A <;> simp [h, hx]
  filter_upwards [ae_tendsto_dyadicAverage hi] with x hx hD hxA
  have hle (k : ℤ) : dyadicAverage k h x ≤ threshold := by
    apply le_of_not_gt
    intro hb
    exact hD ⟨k, habs.symm ▸ hb⟩
  have hlim : h x ≤ threshold :=
    le_of_tendsto hx (Filter.Eventually.of_forall hle)
  exact (not_le_of_gt ht) (by simpa only [h, indicator_of_mem hxA] using hlim)

private theorem measurable_dyadicReplacement {A : Set ℝ} (hA : MeasurableSet A)
    (hfin : volume A ≠ ⊤) {threshold : ℝ} (ht : 0 < threshold)
    {f : ℝ → ℝ} (hm : Measurable f) :
    Measurable (dyadicReplacement A threshold f) := by
  classical
  let h : ℝ → ℝ := A.indicator fun _ => 1
  let D := dyadicMaxLevel h threshold
  let Cells := {c : ℤ × ℤ // dyadicMaximalCell h threshold c}
  let I (c : Cells) := dyadicInterval c.val.1 c.val.2
  let C (c : Cells) := ((2 : ℝ) ^ (-c.val.1))⁻¹ * ∫ x in I c, f x
  have hi : Integrable h := by
    rw [show h = A.indicator (fun _ => (1 : ℝ)) from rfl, integrable_indicator_iff hA]
    let : IsFiniteMeasure ((volume : Measure ℝ).restrict A) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact hfin.lt_top⟩
    exact integrable_const _
  have hD : D = ⋃ c, I c := dyadicMaxLevel_eq_union hi ht
  have hout {x : ℝ} (hx : x ∉ D) : dyadicReplacement A threshold f x = f x := by
    unfold dyadicReplacement
    exact ite_eq_right hx
  have hin (c : Cells) {x : ℝ} (hx : x ∈ I c) :
      dyadicReplacement A threshold f x = C c := by
    rw [dyadicReplacement_eq_on_cell c.property hx, dyadicAverage, mem_dyadicInterval_iff.mp hx]
  intro s hs
  rw [show dyadicReplacement A threshold f ⁻¹' s =
    (Dᶜ ∩ f ⁻¹' s) ∪ ⋃ c : {c : Cells // C c ∈ s}, I c.val by
      ext x
      constructor
      · intro hx
        by_cases hxD : x ∈ D
        · obtain ⟨c, hc⟩ := mem_iUnion.mp (hD ▸ hxD)
          have hC : C c ∈ s := hin c hc ▸ hx
          exact Or.inr (mem_iUnion.mpr ⟨⟨c, hC⟩, hc⟩)
        · change dyadicReplacement A threshold f x ∈ s at hx
          rw [hout hxD] at hx
          exact Or.inl ⟨hxD, hx⟩
      · intro hx
        change dyadicReplacement A threshold f x ∈ s
        rcases hx with ⟨hxD, hxf⟩ | hx
        · exact (hout hxD).symm ▸ hxf
        · obtain ⟨c, hc⟩ := mem_iUnion.mp hx
          exact (hin c.val hc).symm ▸ c.property]
  exact ((measurableSet_dyadicMaxLevel h threshold).compl.inter (hm hs)).union
    (MeasurableSet.iUnion fun _ => measurableSet_Ico)

/-- The Calderón–Zygmund replacement on a single line. It has bounded
amplitude and support and preserves all averages off the exceptional set. -/
theorem dyadicCz_line {A : Set ℝ} (hA : MeasurableSet A) (hfin : volume A ≠ ⊤)
    {threshold : ℝ} (ht : 0 < threshold) (ht1 : threshold < 1)
    {f : ℝ → ℝ} (hm : Measurable f) (hf0 : ∀ x, 0 ≤ f x)
    (hf1 : ∀ x, f x ≤ A.indicator (fun _ => 1) x) :
    let D := dyadicMaxLevel (A.indicator fun _ => 1) threshold
    let g := dyadicReplacement A threshold f
    Measurable g ∧ Integrable g ∧
      (∀ᵐ x ∂(volume : Measure ℝ), 0 ≤ g x ∧ g x ≤ 2 * threshold) ∧
      (∀ᵐ x ∂(volume : Measure ℝ), x ∉ D → g x = 0) ∧
      volume {x | g x ≠ 0} ≤ (ENNReal.ofReal threshold)⁻¹ * volume A ∧
      ∀ x ∉ D, ∀ k : ℤ, dyadicAverage k g x = dyadicAverage k f x := by
  classical
  dsimp only
  let h : ℝ → ℝ := A.indicator fun _ => 1
  let D := dyadicMaxLevel h threshold
  let g := dyadicReplacement A threshold f
  let Cells := {c : ℤ × ℤ // dyadicMaximalCell h threshold c}
  let I (c : Cells) := dyadicInterval c.val.1 c.val.2
  have hi : Integrable h := by
    rw [show h = A.indicator (fun _ => (1 : ℝ)) from rfl, integrable_indicator_iff hA]
    let : IsFiniteMeasure ((volume : Measure ℝ).restrict A) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact hfin.lt_top⟩
    exact integrable_const _
  have hfi : Integrable f :=
    hi.mono_nonneg hm.aestronglyMeasurable (Filter.Eventually.of_forall hf0)
      (Filter.Eventually.of_forall hf1)
  have hD : D = ⋃ c, I c := dyadicMaxLevel_eq_union hi ht
  have hDm : MeasurableSet D := measurableSet_dyadicMaxLevel h threshold
  have hgm : Measurable g := measurable_dyadicReplacement hA hfin ht hm
  have hout {x : ℝ} (hx : x ∉ D) : g x = f x := by
    unfold g dyadicReplacement
    exact ite_eq_right hx
  have hz : ∀ᵐ x ∂(volume : Measure ℝ), x ∉ D → g x = 0 := by
    filter_upwards [ae_zero_off_dyadicMaxLevel hA hfin ht1] with x hx hxd
    rw [hout hxd]
    exact le_antisymm ((hf1 x).trans_eq (indicator_of_notMem (hx hxd) _)) (hf0 x)
  have hb : ∀ᵐ x ∂(volume : Measure ℝ), 0 ≤ g x ∧ g x ≤ 2 * threshold := by
    filter_upwards [hz] with x hx
    by_cases hxD : x ∈ D
    · obtain ⟨c, hc⟩ := mem_iUnion.mp (hD ▸ hxD)
      have hC : g x = dyadicAverage c.val.1 f x :=
        dyadicReplacement_eq_on_cell c.property hc
      have hcomp : dyadicAverage c.val.1 f x ≤ dyadicAverage c.val.1 h x := by
        unfold dyadicAverage
        exact mul_le_mul_of_nonneg_left
          (integral_mono hfi.integrableOn hi.integrableOn hf1) (by positivity)
      refine ⟨?_, hC ▸ hcomp.trans (dyadicMaximalCell_average_le hA hfin c.property hc)⟩
      rw [hC, dyadicAverage]
      exact mul_nonneg (by positivity) (integral_nonneg hf0)
    · rw [hx hxD]
      exact ⟨le_rfl, by positivity⟩
  have hweak : volume D ≤ (ENNReal.ofReal threshold)⁻¹ * volume A := by
    have he : (fun x => ‖h x‖ₑ) = A.indicator 1 := by
      funext x
      by_cases hx : x ∈ A <;> simp [h, hx]
    simpa only [he, lintegral_indicator_one hA] using volume_dyadicMaxLevel_le hi ht
  have hboundi : Integrable (D.indicator (fun _ => 2 * threshold)) := by
    rw [integrable_indicator_iff hDm]
    let : IsFiniteMeasure ((volume : Measure ℝ).restrict D) :=
      ⟨by
        rw [Measure.restrict_apply_univ]
        exact hweak.trans_lt (ENNReal.mul_lt_top
          (ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr ht)).lt_top hfin.lt_top)⟩
    exact integrable_const _
  have hgi : Integrable g := hboundi.mono_nonneg hgm.aestronglyMeasurable
    (hb.mono fun _ hx => hx.1) (by
      filter_upwards [hb, hz] with x hx hxz
      by_cases hxd : x ∈ D
      · rw [indicator_of_mem hxd]
        exact hx.2
      · rw [hxz hxd, indicator_of_notMem hxd])
  have hsupport : volume {x | g x ≠ 0} ≤ volume D := by
    apply measure_mono_ae
    filter_upwards [hz] with x hx hnx
    exact not_not.mp (fun hxd => hnx (hx hxd))
  refine ⟨hgm, hgi, hb, hz, hsupport.trans hweak, ?_⟩
  intro x hx k
  let J := dyadicInterval k (dyadicIndex k x)
  let q := fun x => g x - f x
  have hq : Integrable q := hgi.sub hfi
  have hlocal (c : Cells) : (∫ y in I c, q y) = 0 := by
    rw [show (∫ y in I c, q y) = (∫ y in I c, g y) - ∫ y in I c, f y from
      integral_sub hgi.integrableOn hfi.integrableOn]
    have he : g =ᵐ[volume.restrict (I c)] dyadicAverage c.val.1 f := by
      have hmI : MeasurableSet (I c) := measurableSet_Ico
      filter_upwards [ae_restrict_mem (μ := (volume : Measure ℝ)) hmI] with y hy
      exact dyadicReplacement_eq_on_cell c.property hy
    rw [integral_congr_ae he, integral_dyadicAverage_cell, sub_self]
  have hJm : MeasurableSet J := measurableSet_Ico
  have hJD : J ∩ D = ⋃ c, J ∩ I c := by rw [hD, inter_iUnion]
  have hdis : Pairwise (Disjoint on fun c : Cells => J ∩ I c) := by
    intro c b hcb
    exact (disjoint_dyadicMaximalCells hcb).mono inter_subset_right inter_subset_right
  have hzero (c : Cells) : (∫ y in J ∩ I c, q y) = 0 := by
    by_cases hempty : (J ∩ I c).Nonempty
    · obtain ⟨y, hyJ, hyI⟩ := hempty
      have hle : k ≤ c.val.1 := by
        by_contra! h
        have hjsub := dyadicInterval_subset_of_mem h.le hyJ hyI
        have hxJ : x ∈ J := mem_dyadicInterval_iff.mpr rfl
        apply hx
        change x ∈ D
        rw [hD]
        exact mem_iUnion.mpr ⟨c, hjsub hxJ⟩
      have hsub := dyadicInterval_subset_of_mem hle hyI hyJ
      rw [inter_eq_right.mpr hsub, hlocal]
    · rw [Set.not_nonempty_iff_eq_empty.mp hempty, setIntegral_empty]
  have hqJ : (∫ y in J, q y) = 0 := by
    have he : D.indicator q = q := by
      funext y
      by_cases hyd : y ∈ D
      · exact indicator_of_mem hyd _
      · rw [indicator_of_notMem hyd]
        exact (sub_eq_zero.mpr (hout hyd)).symm
    nth_rw 1 [← he]
    rw [setIntegral_indicator hDm, hJD,
      integral_iUnion (s := fun c => J ∩ I c)
        (fun _ => hJm.inter measurableSet_Ico) hdis hq.integrableOn]
    simp only [hzero, tsum_zero]
  unfold dyadicAverage
  change _ * (∫ y in J, g y) = _ * (∫ y in J, f y)
  have hsub : (∫ y in J, q y) = (∫ y in J, g y) - ∫ y in J, f y :=
    integral_sub hgi.integrableOn hfi.integrableOn
  rw [hsub] at hqJ
  rw [sub_eq_zero.mp hqJ]

private theorem measurable_sInf_levels {α : Type*} [MeasurableSpace α]
    {B : ℤ → Set α} (hB : ∀ k, MeasurableSet (B k)) :
    Measurable (fun x => sInf {k : ℤ | x ∈ B k}) := by
  classical
  let S (k : ℤ) := {x | IsLeast {j : ℤ | x ∈ B j} k}
  have hS (k : ℤ) : MeasurableSet (S k) := by
    have he : S k = B k ∩ ⋂ j : {j : ℤ // j < k}, (B j.val)ᶜ := by
      ext x
      simp only [S, IsLeast, mem_ofPred_eq, mem_lowerBounds, mem_inter_iff,
        mem_iInter, mem_compl_iff, Subtype.forall]
      exact and_congr_right fun _ =>
        ⟨fun h j hj hb => (not_le_of_gt hj) (h j hb),
          fun h j hb => le_of_not_gt (fun hj => h j hj hb)⟩
    rw [he]
    exact (hB _).inter (MeasurableSet.iInter fun j => (hB j.val).compl)
  let U := ⋃ k, S k
  have hU : MeasurableSet U := MeasurableSet.iUnion hS
  apply measurable_to_countable'
  intro k
  have he : (fun x => sInf {j : ℤ | x ∈ B j}) ⁻¹' {k} =
      S k ∪ (if k = 0 then Uᶜ else ∅) := by
    ext x
    by_cases hx : x ∈ U
    · obtain ⟨j, hj⟩ := mem_iUnion.mp hx
      have hleast : IsLeast {j : ℤ | x ∈ B j} j := hj
      have hs := hleast.csInf_eq
      simp only [mem_preimage, mem_singleton_iff, hs, mem_union]
      have hnot : x ∉ (if k = 0 then Uᶜ else ∅) := by
        split_ifs <;> simp [hx]
      rw [or_iff_left hnot]
      exact ⟨fun h => h ▸ hj, fun hk => hleast.unique hk⟩
    · have hval : sInf {j : ℤ | x ∈ B j} = 0 := by
        by_cases hb : BddBelow {j : ℤ | x ∈ B j}
        · by_cases hn : ({j : ℤ | x ∈ B j} : Set ℤ).Nonempty
          · exact False.elim (hx (mem_iUnion.mpr ⟨_, Int.csInf_mem hn hb, fun j hj => csInf_le hb hj⟩))
          · rw [Set.not_nonempty_iff_eq_empty.mp hn, Int.csInf_empty]
        · exact Int.csInf_of_not_bddBelow hb
      have hk : x ∉ S k := fun hk => hx (mem_iUnion.mpr ⟨k, hk⟩)
      by_cases h0 : k = 0
      · subst k
        simp [hval, hx]
      · simp [hval, h0, Ne.symm h0, hk]
  rw [he]
  apply (hS k).union
  split_ifs
  · exact hU.compl
  · exact MeasurableSet.empty

/-- Replace on maximal exceptional cells separately in direction `i`. -/
noncomputable def coordinateReplacement {d : ℕ} (i : Fin d) (A : Set (Fin d → ℝ))
    (threshold : ℝ) (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ) : ℝ := by
  classical
  let h : (Fin d → ℝ) → ℝ := A.indicator fun _ => 1
  exact if x ∈ coordinateMaxLevel i h threshold then
    coordinateAverage i (sInf {k : ℤ | threshold < coordinateAverage i k h x}) f x
    else f x

private theorem measurable_coordinateReplacement {d : ℕ} (i : Fin d)
    {A : Set (Fin d → ℝ)} (hA : MeasurableSet A) (threshold : ℝ)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) :
    Measurable (coordinateReplacement i A threshold f) := by
  classical
  let h : (Fin d → ℝ) → ℝ := A.indicator fun _ => 1
  let D := coordinateMaxLevel i h threshold
  let level (x : Fin d → ℝ) := sInf {k : ℤ | threshold < coordinateAverage i k h x}
  have hh : Measurable h := measurable_const.indicator hA
  have hlevel : Measurable level :=
    measurable_sInf_levels (B := fun k => {x | threshold < coordinateAverage i k h x})
      (fun k => measurableSet_lt measurable_const (measurable_coordinateAverage i k hh))
  have hselection : Measurable (fun x => coordinateAverage i (level x) f x) := by
    intro s hs
    rw [show (fun x => coordinateAverage i (level x) f x) ⁻¹' s =
      ⋃ k : ℤ, level ⁻¹' {k} ∩ coordinateAverage i k f ⁻¹' s by
        ext x
        simp only [mem_preimage, mem_iUnion, mem_inter_iff, mem_singleton_iff]
        exact ⟨fun hx => ⟨level x, rfl, hx⟩, fun ⟨k, e, hx⟩ => e ▸ hx⟩]
    exact MeasurableSet.iUnion fun k => (hlevel (measurableSet_singleton k)).inter
      (measurable_coordinateAverage i k hm hs)
  exact hselection.ite (measurableSet_coordinateMaxLevel i hh threshold) hm

/-- The directional Calderón–Zygmund replacement of `bp:dyadic-cz`. -/
theorem dyadicCz {d : ℕ} (i : Fin d) {A : Set (Fin d → ℝ)}
    (hA : MeasurableSet A) (hfin : volume A ≠ ⊤)
    {threshold : ℝ} (ht : 0 < threshold) (ht1 : threshold < 1)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (hf0 : ∀ x, 0 ≤ f x)
    (hf1 : ∀ x, f x ≤ A.indicator (fun _ => 1) x) :
    let D := coordinateMaxLevel i (A.indicator fun _ => 1) threshold
    let g := coordinateReplacement i A threshold f
    Measurable g ∧
      (∀ᵐ x ∂volume, 0 ≤ g x ∧ g x ≤ 2 * threshold) ∧
      volume {x | g x ≠ 0} ≤ (ENNReal.ofReal threshold)⁻¹ * volume A ∧
      ∀ᵐ x ∂volume, x ∉ D → ∀ k : ℤ,
        coordinateAverage i k g x = coordinateAverage i k f x ∧
          coordinateDifference i k g x = coordinateDifference i k f x := by
  classical
  dsimp only
  let h : (Fin d → ℝ) → ℝ := A.indicator fun _ => 1
  let D := coordinateMaxLevel i h threshold
  let g := coordinateReplacement i A threshold f
  have hh : Measurable h := measurable_const.indicator hA
  have hDm := measurableSet_coordinateMaxLevel i hh threshold
  have hgm := measurable_coordinateReplacement i hA threshold hm
  have hhi : Integrable h := by
    rw [show h = A.indicator (fun _ => (1 : ℝ)) from rfl, integrable_indicator_iff hA]
    let : IsFiniteMeasure (volume.restrict A) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact hfin.lt_top⟩
    exact integrable_const _
  let P (x : Fin d → ℝ) := (0 ≤ g x ∧ g x ≤ 2 * threshold) ∧
    (x ∉ D → g x = 0 ∧ ∀ k : ℤ, coordinateAverage i k g x = coordinateAverage i k f x)
  have hP : MeasurableSet {x | P x} := by
    change MeasurableSet
      ({x | 0 ≤ g x} ∩ {x | g x ≤ 2 * threshold} ∩
        {x | x ∉ D → g x = 0 ∧ ∀ k : ℤ, coordinateAverage i k g x = coordinateAverage i k f x})
    apply ((measurableSet_le measurable_const hgm).inter
      (measurableSet_le hgm measurable_const)).inter
    have he : {x | x ∉ D → g x = 0 ∧ ∀ k : ℤ, coordinateAverage i k g x = coordinateAverage i k f x} =
        D ∪ ({x | g x = 0} ∩ ⋂ k : ℤ,
          {x | coordinateAverage i k g x = coordinateAverage i k f x}) := by
      ext x
      simp only [mem_ofPred_eq, mem_union, mem_inter_iff, mem_iInter]
      tauto
    rw [he]
    exact hDm.union ((measurableSet_eq_fun hgm measurable_const).inter
      (MeasurableSet.iInter fun k => measurableSet_eq_fun
        (measurable_coordinateAverage i k hgm) (measurable_coordinateAverage i k hm)))
  have hPAE : ∀ᵐ x ∂volume, P x := by
    cases d with
    | zero => exact Fin.elim0 i
    | succ n =>
      let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm
      have he : MeasurePreserving e :=
        (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm _
      have hprod : Integrable (h ∘ e)
          ((volume : Measure ℝ).prod (volume : Measure (Fin n → ℝ))) := by
        rw [← Measure.volume_eq_prod]
        exact (he.integrable_comp_emb e.measurableEmbedding).mpr hhi
      have hPprod : ∀ᵐ z ∂(volume : Measure (ℝ × (Fin n → ℝ))), P (e z) := by
        have hPm : MeasurableSet {z | P (e z)} := hP.preimage e.measurable
        rw [Measure.volume_eq_prod, Measure.ae_prod_iff_ae_ae hPm, Measure.ae_ae_comm hPm]
        filter_upwards [hprod.prod_left_ae] with y hy
        let Ay := (fun t : ℝ => e (t, y)) ⁻¹' A
        let fy (t : ℝ) := f (e (t, y))
        have hmap : Measurable (fun t : ℝ => e (t, y)) :=
          e.measurable.comp (measurable_id.prodMk measurable_const)
        have hAy : MeasurableSet Ay := hA.preimage hmap
        have hhy : (fun t => (h ∘ e) (t, y)) = Ay.indicator (fun _ => 1) := by
          funext t
          rfl
        rw [hhy, integrable_indicator_iff hAy, IntegrableOn, integrable_const_iff] at hy
        have hfinite : IsFiniteMeasure ((volume : Measure ℝ).restrict Ay) := by simpa using hy
        have hfiny : volume Ay ≠ ⊤ := by
          simpa only [Measure.restrict_apply_univ] using hfinite.measure_univ_lt_top.ne
        have hy1 : ∀ t, fy t ≤ Ay.indicator (fun _ => 1) t := by
          intro t
          rw [← hhy]
          exact hf1 _
        have hcoord (F : (Fin (n + 1) → ℝ) → ℝ) (k : ℤ) (x : ℝ) :
            coordinateAverage i k F (e (x, y)) =
              dyadicAverage k (fun t => F (e (t, y))) x := by
          change coordinateAverage i k F (i.insertNth x y) =
            dyadicAverage k (fun t => F (i.insertNth t y)) x
          simp only [coordinateAverage_eq_dyadicAverage, Fin.update_insertNth,
            Fin.insertNth_apply_same]
        have hDslice (x : ℝ) : e (x, y) ∈ D ↔
            x ∈ dyadicMaxLevel (Ay.indicator fun _ => 1) threshold := by
          change (∃ k : ℤ, threshold < coordinateAverage i k (fun z => |h z|) (e (x, y))) ↔
            ∃ k : ℤ, threshold < dyadicAverage k (fun t => |(Ay.indicator fun _ => 1) t|) x
          simp_rw [hcoord]
          rfl
        have hgslice (x : ℝ) : g (e (x, y)) = dyadicReplacement Ay threshold fy x := by
          unfold g coordinateReplacement dyadicReplacement
          change (if e (x, y) ∈ D then _ else _) = _
          simp_rw [hDslice, hcoord]
          rfl
        have hline := dyadicCz_line hAy hfiny ht ht1 (f := fy) (hm.comp hmap) (fun _ => hf0 _) hy1
        dsimp only at hline
        filter_upwards [hline.2.2.1, hline.2.2.2.1] with x hbound hz
        refine ⟨by simpa only [hgslice] using hbound, fun hx => ?_⟩
        have hx' := fun hdx => hx ((hDslice x).mpr hdx)
        refine ⟨(hgslice x).trans (hz hx'), fun k => ?_⟩
        simp_rw [hcoord, hgslice]
        exact hline.2.2.2.2.2 x hx' k
      filter_upwards [(he.symm e).quasiMeasurePreserving.ae hPprod] with x hx
      simpa only [MeasurableEquiv.apply_symm_apply] using hx
  have hweak : volume D ≤ (ENNReal.ofReal threshold)⁻¹ * volume A := by
    have he : (fun x => ‖h x‖ₑ) = A.indicator 1 := by
      funext x
      by_cases hx : x ∈ A <;> simp [h, hx]
    simpa only [he, lintegral_indicator_one hA] using volume_coordinateMaxLevel_le i hh hhi ht
  have hsupport : volume {x | g x ≠ 0} ≤ volume D := by
    apply measure_mono_ae
    filter_upwards [hPAE] with x hx hnx
    exact not_not.mp (fun hxd => hnx (hx.2 hxd).1)
  refine ⟨hgm, hPAE.mono fun _ hx => hx.1, hsupport.trans hweak, ?_⟩
  filter_upwards [hPAE] with x hx hxd k
  have havg := (hx.2 hxd).2
  refine ⟨havg k, ?_⟩
  change coordinateAverage i (k + 1) g x - coordinateAverage i k g x = _
  rw [havg (k + 1), havg k]
  rfl

/-- Bounded optional sampling for real martingales on a finite measure
space, including measurability at the earlier stopping time. -/
theorem optional {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    [IsFiniteMeasure μ] {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ}
    (hM : Martingale M ℱ μ) {σ τ : Ω → WithTop ℕ}
    (hσ : IsStoppingTime ℱ σ) (hτ : IsStoppingTime ℱ τ)
    (hst : σ ≤ τ) {N : ℕ} (ht : ∀ x, τ x ≤ N) :
    Measurable[hσ.measurableSpace] (stoppedValue M σ) ∧
      stoppedValue M σ =ᵐ[μ] μ[stoppedValue M τ | hσ.measurableSpace] :=
  ⟨measurable_stoppedValue hM.stronglyAdapted.isStronglyProgressive_of_discrete hσ,
    hM.stoppedValue_ae_eq_condExp_of_le hτ hσ hst ht⟩

/-- The stopped sigma algebras of an ordered family form an increasing filtration. -/
def samplingFiltration {Ω : Type*} {m : MeasurableSpace Ω} {ι : Type*} [Preorder ι]
    {ℱ : Filtration ℕ m} {τ : ι → Ω → WithTop ℕ}
    (hτ : ∀ j, IsStoppingTime ℱ (τ j)) (hmono : Monotone τ) : Filtration ι m where
  seq j := (hτ j).measurableSpace
  mono' _ _ hjk := (hτ _).measurableSpace_mono (hτ _) (hmono hjk)
  le' j := (hτ j).measurableSpace_le

/-- Sampling along an increasing family of bounded stopping times preserves
martingality, in particular for a finite family. -/
theorem martingale_stoppedValue_family {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    [IsFiniteMeasure μ] {ι : Type*} [Preorder ι] {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ}
    (hM : Martingale M ℱ μ) {τ : ι → Ω → WithTop ℕ}
    (hτ : ∀ j, IsStoppingTime ℱ (τ j)) (hmono : Monotone τ)
    {N : ℕ} (hb : ∀ j x, τ j x ≤ N) :
    Martingale (fun j => stoppedValue M (τ j)) (samplingFiltration hτ hmono) μ := by
  constructor
  · intro j
    exact (measurable_stoppedValue hM.stronglyAdapted.isStronglyProgressive_of_discrete
      (hτ j)).stronglyMeasurable
  · intro j k hjk
    exact (optional hM (hτ j) (hτ k) (hmono hjk) (hb k)).2.symm

/-- The running maximum of the absolute values up to time `N`. -/
noncomputable def martingaleMax {Ω : Type*} (M : ℕ → Ω → ℝ) (N : ℕ) (x : Ω) : ℝ :=
  (Finset.range (N + 1)).sup' Finset.nonempty_range_add_one fun k => ‖M k x‖

private theorem martingaleMax_nonneg {Ω : Type*} (M : ℕ → Ω → ℝ) (N : ℕ) (x : Ω) :
    0 ≤ martingaleMax M N x :=
  (norm_nonneg (M 0 x)).trans (Finset.le_sup' (fun k => ‖M k x‖)
    (Finset.mem_range.mpr (Nat.zero_lt_succ N)))

private theorem measurable_martingaleMax {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ) (N : ℕ) :
    Measurable (martingaleMax M N) := by
  unfold martingaleMax
  convert (Finset.measurable_sup' (s := Finset.range (N + 1)) Finset.nonempty_range_add_one
    (f := fun k x => ‖M k x‖)
    (fun k _ => ((hM.stronglyAdapted k).mono (ℱ.le k)).measurable.norm)) using 1
  funext x
  rw [Finset.sup'_apply]

/-- The level-set estimate used to obtain the strong maximal inequality. -/
theorem martingaleMax_level {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    [IsFiniteMeasure μ] {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ}
    (hM : Martingale M ℱ μ) (N : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    ENNReal.ofReal t * μ {x | t ≤ martingaleMax M N x} ≤
      ∫⁻ x in {x | t ≤ martingaleMax M N x}, ‖M N x‖ₑ ∂μ := by
  have hsub : Submartingale (fun k x => ‖M k x‖) ℱ μ := by
    refine ⟨fun k => (hM.stronglyAdapted k).norm, fun j k hjk => ?_, fun k => (hM.integrable k).norm⟩
    filter_upwards [norm_condExp_le (m := ℱ j) (M k), hM.condExp_ae_eq hjk] with x hx he
    simpa only [he] using hx
  let ε : NNReal := ⟨t, ht⟩
  have hweak := maximal_ineq hsub (fun _ _ => norm_nonneg _) (ε := ε) N
  have he : ENNReal.ofReal t = (ε : ENNReal) := ENNReal.ofReal_eq_coe_nnreal _
  rw [he]
  refine hweak.trans_eq ?_
  rw [ofReal_integral_eq_lintegral_ofReal (hM.integrable N).norm.integrableOn
    (Filter.Eventually.of_forall fun _ => norm_nonneg _)]
  apply lintegral_congr
  intro x
  rw [Real.norm_eq_abs, Real.enorm_eq_ofReal_abs]

private theorem lintegral_rpow_Ioc {q z : ℝ} (hq : -1 < q) (hz : 0 ≤ z) :
    (∫⁻ t in Ioc 0 z, ENNReal.ofReal (t ^ q)) = ENNReal.ofReal (z ^ (q + 1) / (q + 1)) := by
  have hInt := (intervalIntegral.intervalIntegrable_rpow' hq :
    IntervalIntegrable (fun t : ℝ => t ^ q) volume 0 z).1
  have h0 : ∀ᵐ t ∂(volume : Measure ℝ).restrict (Ioc 0 z), 0 ≤ t ^ q := by
    filter_upwards [ae_restrict_mem (μ := (volume : Measure ℝ))
      (s := Ioc 0 z) measurableSet_Ioc] with t ht
    exact Real.rpow_nonneg ht.1.le _
  rw [← ofReal_integral_eq_lintegral_ofReal hInt h0,
    ← intervalIntegral.integral_of_le hz, integral_rpow (Or.inl hq),
    Real.zero_rpow (by linarith : q + 1 ≠ 0), sub_zero]

/-- The moment inequality obtained by integrating the martingale level-set
bound against the power weight in `bp:doob`. -/
theorem doob_moment {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    [IsFiniteMeasure μ] {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ}
    (hM : Martingale M ℱ μ) (N : ℕ) {p : ℝ} (hp : 1 < p) :
    (∫⁻ x, ENNReal.ofReal (martingaleMax M N x ^ p) ∂μ) ≤
      ENNReal.ofReal (p / (p - 1)) *
        ∫⁻ x, ‖M N x‖ₑ * ENNReal.ofReal (martingaleMax M N x ^ (p - 1)) ∂μ := by
  let H := martingaleMax M N
  let ν := (volume : Measure ℝ).restrict (Ioi 0)
  let W (t : ℝ) := ENNReal.ofReal (t ^ (p - 2))
  let A (t : ℝ) := {x | t ≤ H x}
  let K (t : ℝ) (x : Ω) := (A t).indicator (fun x => ‖M N x‖ₑ) x * W t
  have hH : Measurable H := measurable_martingaleMax hM N
  have hN : Measurable (fun x => ‖M N x‖ₑ) :=
    ((hM.stronglyAdapted N).mono (ℱ.le N)).measurable.enorm
  have hW : Measurable W := (measurable_id.pow_const _).ennreal_ofReal
  have hA (t : ℝ) : MeasurableSet (A t) := measurableSet_le measurable_const hH
  have hK : Measurable (Function.uncurry K) :=
    ((hN.comp measurable_snd).indicator
      (measurableSet_le measurable_fst (hH.comp measurable_snd))).mul (hW.comp measurable_fst)
  have hstep : (∫⁻ t, μ (A t) * ENNReal.ofReal (t ^ (p - 1)) ∂ν) ≤
      ∫⁻ t, ∫⁻ x, K t x ∂μ ∂ν := by
    apply lintegral_mono_ae
    filter_upwards [ae_restrict_mem (μ := (volume : Measure ℝ))
      (s := Ioi 0) measurableSet_Ioi] with t ht
    have ht0 : 0 < t := ht
    have hmul : ENNReal.ofReal (t ^ (p - 1)) = ENNReal.ofReal t * W t := by
      change _ = ENNReal.ofReal t * ENNReal.ofReal (t ^ (p - 2))
      rw [← ENNReal.ofReal_mul ht0.le, show p - 1 = 1 + (p - 2) by ring,
        Real.rpow_add ht0, Real.rpow_one]
    rw [hmul, ← mul_assoc, mul_comm (μ (A t)), show K t = (fun x =>
      (A t).indicator (fun x => ‖M N x‖ₑ) x * W t) from rfl,
      lintegral_mul_const _ (hN.indicator (hA t)), lintegral_indicator (hA t)]
    gcongr
    exact martingaleMax_level hM N ht0.le
  have hinner (x : Ω) :
      (∫⁻ t, K t x ∂ν) = ‖M N x‖ₑ *
        (ENNReal.ofReal (p - 1))⁻¹ * ENNReal.ofReal (H x ^ (p - 1)) := by
    let B := Iic (H x)
    have hB : MeasurableSet B := measurableSet_Iic
    have hfun : (fun t => K t x) = B.indicator (fun t => ‖M N x‖ₑ * W t) := by
      funext t
      by_cases ht : t ≤ H x <;> simp [K, A, B, ht]
    rw [hfun, lintegral_indicator hB, lintegral_const_mul _ hW]
    change ‖M N x‖ₑ * (∫⁻ t, W t ∂(volume.restrict (Ioi 0)).restrict B) = _
    rw [Measure.restrict_restrict hB, inter_comm, Ioi_inter_Iic]
    rw [lintegral_rpow_Ioc (q := p - 2) (z := H x) (by linarith) (martingaleMax_nonneg M N x),
      show p - 2 + 1 = p - 1 by ring, div_eq_inv_mul,
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_inv_of_pos (by linarith), mul_assoc]
  rw [lintegral_rpow_eq_lintegral_meas_le_mul μ
    (Filter.Eventually.of_forall (martingaleMax_nonneg M N)) hH.aemeasurable (by linarith : 0 < p)]
  have hswap : (∫⁻ t, ∫⁻ x, K t x ∂μ ∂ν) = ∫⁻ x, ∫⁻ t, K t x ∂ν ∂μ :=
    lintegral_lintegral_swap hK.aemeasurable
  have he : (∫⁻ t, ∫⁻ x, K t x ∂μ ∂ν) =
      (ENNReal.ofReal (p - 1))⁻¹ *
        ∫⁻ x, ‖M N x‖ₑ * ENNReal.ofReal (H x ^ (p - 1)) ∂μ := by
    rw [hswap]
    have hm : Measurable (fun x => ‖M N x‖ₑ * ENNReal.ofReal (H x ^ (p - 1))) :=
      hN.mul (hH.pow_const _).ennreal_ofReal
    rw [← lintegral_const_mul _ hm]
    apply lintegral_congr
    intro x
    rw [hinner, mul_comm (‖M N x‖ₑ) _, mul_assoc]
  change ENNReal.ofReal p * (∫⁻ t, μ (A t) * ENNReal.ofReal (t ^ (p - 1)) ∂ν) ≤ _
  calc
    _ ≤ ENNReal.ofReal p * (∫⁻ t, ∫⁻ x, K t x ∂μ ∂ν) := by gcongr
    _ = _ := by
      rw [he, ← mul_assoc, mul_comm (ENNReal.ofReal p), div_eq_inv_mul,
        ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_inv_of_pos (by linarith)]

/-- Doob's finite (L^p) maximal inequality (`bp:doob`). -/
theorem doob {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    [IsFiniteMeasure μ] {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ}
    (hM : Martingale M ℱ μ) (N : ℕ) {p : ℝ} (hp : 1 < p)
    (hMN : MemLp (M N) (ENNReal.ofReal p) μ) :
    eLpNorm (martingaleMax M N) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (p / (p - 1)) * eLpNorm (M N) (ENNReal.ofReal p) μ := by
  let H := martingaleMax M N
  let q := p / (p - 1)
  have hp0 : 0 < p := by linarith
  have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using ENNReal.ofReal_le_ofReal hp.le
  have hq : p.HolderConjugate q := (Real.holderConjugate_iff_eq_conjExponent hp).mpr rfl
  have hmH : Measurable H := measurable_martingaleMax hM N
  have hH (x : Ω) : 0 ≤ H x := martingaleMax_nonneg M N x
  have hLp (k : ℕ) (hk : k ∈ Finset.range (N + 1)) :
      MemLp (fun x => ‖M k x‖) (ENNReal.ofReal p) μ := by
    have hkN : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    exact ((hMN.condExp (m := ℱ k) hp1).ae_eq (hM.condExp_ae_eq hkN)).norm
  have hHlp : MemLp H (ENNReal.ofReal p) μ := by
    have hsum := memLp_finsetSum (Finset.range (N + 1)) hLp
    refine hsum.mono' hmH.aestronglyMeasurable (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_of_nonneg (hH x)]
    apply Finset.sup'_le
    intro k hk
    exact Finset.single_le_sum (fun j _ => norm_nonneg (M j x)) hk
  let A := ∫⁻ x, ENNReal.ofReal (H x ^ p) ∂μ
  let B := ∫⁻ x, ‖M N x‖ₑ ^ p ∂μ
  have hAterm (x : Ω) : ‖H x‖ₑ ^ p = ENNReal.ofReal (H x ^ p) := by
    rw [Real.enorm_eq_ofReal (hH x), ENNReal.ofReal_rpow_of_nonneg (hH x) hp0.le]
  have hnormH : eLpNorm H (ENNReal.ofReal p) μ = A ^ (1 / p) := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp0)
      ENNReal.ofReal_ne_top hmH.aestronglyMeasurable, ENNReal.toReal_ofReal hp0.le]
    simp_rw [hAterm]
    rfl
  have hnormM : eLpNorm (M N) (ENNReal.ofReal p) μ = B ^ (1 / p) := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp0)
      ENNReal.ofReal_ne_top hMN.aestronglyMeasurable, ENNReal.toReal_ofReal hp0.le]
  have hAfinite : A ≠ ⊤ := by
    have hf := hHlp.eLpNorm_lt_top
    rw [hnormH, ENNReal.rpow_lt_top_iff_of_pos (by positivity)] at hf
    exact hf.ne
  have hpow (x : Ω) :
      ENNReal.ofReal (H x ^ (p - 1)) ^ q = ENNReal.ofReal (H x ^ p) := by
    rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (hH x) (p - 1)) hq.symm.nonneg,
      ← Real.rpow_mul (hH x)]
    congr 2
    change (p - 1) * (p / (p - 1)) = p
    field_simp [sub_ne_zero.mpr hp.ne']
  have hg : Measurable (fun x => ENNReal.ofReal (H x ^ (p - 1))) :=
    (hmH.pow_const _).ennreal_ofReal
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hq hMN.aemeasurable.enorm hg.aemeasurable
  simp only [Pi.mul_apply, hpow] at hholder
  have hfinal : A ≤ ENNReal.ofReal q * (B ^ (1 / p) * A ^ (1 / q)) :=
    (doob_moment hM N hp).trans (by gcongr)
  change eLpNorm H _ _ ≤ ENNReal.ofReal q * eLpNorm (M N) _ _
  rw [hnormH, hnormM]
  by_cases ha : A = 0
  · rw [ha, ENNReal.zero_rpow_of_pos (by positivity)]
    exact zero_le
  have hs : 1 / p + 1 / q = 1 := by
    simpa only [one_div] using hq.inv_add_inv_eq_one
  have hfactor : A = A ^ (1 / p) * A ^ (1 / q) := by
    rw [← ENNReal.rpow_add _ _ ha hAfinite, hs, ENNReal.rpow_one]
  have hz : A ^ (1 / q) ≠ 0 :=
    fun h => ha ((ENNReal.rpow_eq_zero_iff_of_pos (by positivity)).mp h)
  have ht : A ^ (1 / q) ≠ ⊤ :=
    (ENNReal.rpow_lt_top_of_nonneg (by positivity) hAfinite).ne
  apply (ENNReal.mul_le_mul_iff_right hz ht).mp
  calc
    _ = A := (mul_comm _ _).trans hfactor.symm
    _ ≤ ENNReal.ofReal q * (B ^ (1 / p) * A ^ (1 / q)) := hfinal
    _ = _ := by ac_rfl

private theorem martingale_integral_mul_difference_eq_zero
    {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    [IsFiniteMeasure μ] {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ}
    (hM : Martingale M ℱ μ) (k : ℕ) {g : Ω → ℝ}
    (hg : StronglyMeasurable[ℱ k] g)
    (hi : Integrable (fun x => g x * (M (k + 1) x - M k x)) μ) :
    ∫ x, g x * (M (k + 1) x - M k x) ∂μ = 0 := by
  let D := fun x => M (k + 1) x - M k x
  have hD : Integrable D μ := (hM.integrable _).sub (hM.integrable _)
  have hzero : μ[D | ℱ k] =ᵐ[μ] 0 := by
    have hs := condExp_sub (m := ℱ k) (hM.integrable (k + 1)) (hM.integrable k)
    have hnext := hM.condExp_ae_eq (Nat.le_succ k)
    have hnow := hM.condExp_ae_eq (le_refl k)
    filter_upwards [hs, hnext, hnow] with x hx hy hz
    change μ[M (k + 1) - M k | ℱ k] x = 0
    change μ[M (k + 1) | ℱ k] x = _ at hy
    rw [hx]
    simp only [Pi.sub_apply, hy, hz, sub_self]
  rw [← integral_condExp (ℱ.le k)]
  have he := condExp_mul_of_stronglyMeasurable_left (μ := μ) (f := g) (g := D) hg hi hD
  change (∫ x, μ[(fun y => g y * D y) | ℱ k] x ∂μ) = _
  apply integral_eq_zero_of_ae
  filter_upwards [he, hzero] with x hx hy
  change μ[g * D | ℱ k] x = _
  rw [hx]
  simp only [Pi.mul_apply, hy, Pi.zero_apply, mul_zero]

/-- The (p=2) energy identity of `bp:mart-square`, retaining the initial term. -/
theorem martSquare_two {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    [IsFiniteMeasure μ] {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ}
    (hM : Martingale M ℱ μ) (N : ℕ) (hLp : MemLp (M N) 2 μ) :
    (∑ k ∈ Finset.range N, ∫ x, (M (k + 1) x - M k x)^2 ∂μ) =
      (∫ x, (M N x)^2 ∂μ) - ∫ x, (M 0 x)^2 ∂μ := by
  have hp (k : ℕ) (hk : k ≤ N) : MemLp (M k) 2 μ :=
    (hLp.condExp (m := ℱ k) (by norm_num)).ae_eq (hM.condExp_ae_eq hk)
  have hstep (k : ℕ) (hk : k ∈ Finset.range N) :
      (∫ x, (M (k + 1) x - M k x)^2 ∂μ) =
        (∫ x, (M (k + 1) x)^2 ∂μ) - ∫ x, (M k x)^2 ∂μ := by
    have hlt := Finset.mem_range.mp hk
    let D := fun x => M (k + 1) x - M k x
    have hm := hp k hlt.le
    have hn := hp (k + 1) hlt
    have hd : MemLp D 2 μ := hn.sub hm
    have hi : Integrable (fun x => M k x * D x) μ := hm.integrable_mul hd
    have hz := martingale_integral_mul_difference_eq_zero hM k (hM.stronglyAdapted k) hi
    have ha : (fun x => (M (k + 1) x)^2) =
        (fun x => (M k x)^2 + D x^2 + 2 * (M k x * D x)) := by
      funext x
      dsimp only [D]
      ring
    rw [ha]
    have hsum := integral_add (hm.integrable_sq.add hd.integrable_sq) (hi.const_mul 2)
    simp only [Pi.add_apply, integral_add hm.integrable_sq hd.integrable_sq,
      integral_const_mul] at hsum
    have he : ∫ x, M k x * D x ∂μ = 0 := hz
    change (∫ x, D x^2 ∂μ) = (∫ x, (M k x)^2 + D x^2 + 2 * (M k x * D x) ∂μ) - _
    rw [hsum, he]
    ring
  rw [Finset.sum_congr rfl hstep, Finset.sum_range_sub (fun k => ∫ x, (M k x)^2 ∂μ)]

private theorem rpow_add_increment_le {a t s : ℝ} (ha : 1 < a) (ht : 0 ≤ t) (hs : 0 ≤ s) :
    (t + s)^a - t^a ≤ a * 2^(a - 1) * (t^(a - 1) * s + s^a) := by
  rcases hs.eq_or_lt with hz | hs
  · simp [← hz, Real.zero_rpow (by linarith : a ≠ 0)]
  have hts : t < t + s := by linarith
  have hcont : ContinuousOn (fun x : ℝ => x ^ a) (Icc t (t + s)) :=
    (Real.continuous_rpow_const (by linarith)).continuousOn
  have hdiff : DifferentiableOn ℝ (fun x : ℝ => x ^ a) (Ioo t (t + s)) :=
    (Real.differentiable_rpow_const ha.le).differentiableOn
  obtain ⟨ξ, hξ, hderiv⟩ := exists_deriv_eq_slope _ hts hcont hdiff
  rw [(Real.hasDerivAt_rpow_const (x := ξ) (p := a) (Or.inr ha.le)).deriv] at hderiv
  have he : (t + s)^a - t^a = a * ξ^(a - 1) * s := by
    rw [show t + s - t = s by ring] at hderiv
    exact (div_eq_iff hs.ne').mp hderiv.symm
  have hξ0 : 0 ≤ ξ := ht.trans hξ.1.le
  have hpow : ξ^(a - 1) ≤ 2^(a - 1) * (t^(a - 1) + s^(a - 1)) := by
    have hmax : ξ ≤ 2 * max t s := hξ.2.le.trans (by
      have h1 : t ≤ max t s := le_max_left _ _
      have h2 : s ≤ max t s := le_max_right _ _
      linarith)
    have hp := Real.rpow_le_rpow hξ0 hmax (by linarith : 0 ≤ a - 1)
    rw [Real.mul_rpow (by norm_num) (ht.trans (le_max_left _ _))] at hp
    refine hp.trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
    rcases le_total t s with h | h
    · rw [max_eq_right h]
      exact le_add_of_nonneg_left (Real.rpow_nonneg ht _)
    · rw [max_eq_left h]
      exact le_add_of_nonneg_right (Real.rpow_nonneg hs.le _)
  have hsplit : s^(a - 1) * s = s^a := by
    calc
      _ = s^(a - 1) * s^(1 : ℝ) := by rw [Real.rpow_one]
      _ = s^a := by rw [← Real.rpow_add hs, sub_add_cancel]
  rw [he]
  calc
    _ ≤ (a * (2^(a - 1) * (t^(a - 1) + s^(a - 1)))) * s :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hpow (by linarith)) hs.le
    _ = _ := by rw [← hsplit]; ring

/-- The martingale difference from time `k` to time `k+1`. -/
def martingaleDifference {Ω : Type*} (M : ℕ → Ω → ℝ) (k : ℕ) (x : Ω) : ℝ :=
  M (k + 1) x - M k x

/-- Sum of squared increments through time `N`. -/
noncomputable def martingaleEnergy {Ω : Type*} (M : ℕ → Ω → ℝ) (N : ℕ) (x : Ω) : ℝ :=
  ∑ k ∈ Finset.range N, martingaleDifference M k x ^ 2

private theorem martingaleEnergy_nonneg {Ω : Type*} (M : ℕ → Ω → ℝ) (N : ℕ) (x : Ω) :
    0 ≤ martingaleEnergy M N x :=
  Finset.sum_nonneg fun _ _ => sq_nonneg _

private theorem martingaleEnergy_succ {Ω : Type*} (M : ℕ → Ω → ℝ) (k : ℕ) (x : Ω) :
    martingaleEnergy M (k + 1) x = martingaleEnergy M k x + martingaleDifference M k x ^ 2 :=
  Finset.sum_range_succ _ _

private theorem martingaleEnergy_adapted {Ω : Type*} {m : MeasurableSpace Ω}
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : StronglyAdapted ℱ M) (k : ℕ) :
    StronglyMeasurable[ℱ k] (martingaleEnergy M k) := by
  unfold martingaleEnergy
  exact (Finset.measurable_fun_sum _ fun j hj => by
    have hle : j + 1 ≤ k := (Finset.mem_range.mp hj)
    have h1 := ((hM (j + 1)).mono (ℱ.mono hle)).measurable
    have h0 := ((hM j).mono (ℱ.mono (Nat.le_of_succ_le hle))).measurable
    exact (h1.sub h0).pow_const (2 : ℕ)).stronglyMeasurable

private theorem weighted_sum_difference_le {w y : ℕ → ℝ} (hw : Monotone w)
    (hy : ∀ k, 0 ≤ y k) (N : ℕ) :
    ∑ k ∈ Finset.range N, w k * (y (k + 1) - y k) ≤ w N * y N - w 0 * y 0 := by
  induction N with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ]
    have hz := mul_le_mul_of_nonneg_right (hw (Nat.le_succ n)) (hy (n + 1))
    linarith

private theorem memLp_of_measurable_finite {Ω : Type*} [Finite Ω] [MeasurableSpace Ω]
    {μ : Measure Ω} [IsFiniteMeasure μ] {f : Ω → ℝ} (hm : Measurable f) (p : ℝ≥0∞) :
    MemLp f p μ := by
  obtain ⟨C, hC⟩ := (Set.finite_range (fun x => ‖f x‖)).bddAbove
  exact MemLp.of_bound hm.aestronglyMeasurable C (Filter.Eventually.of_forall
    fun x => hC (Set.mem_range_self x))

private theorem integrable_of_measurable_finite {Ω : Type*} [Finite Ω] [MeasurableSpace Ω]
    {μ : Measure Ω} [IsFiniteMeasure μ] {f : Ω → ℝ} (hm : Measurable f) :
    Integrable f μ :=
  memLp_one_iff_integrable.mp (memLp_of_measurable_finite hm 1)

/-- The integrated upper square-function recursion for moments above two. -/
theorem martingaleEnergy_moment_le {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    (N : ℕ) {a : ℝ} (ha : 1 < a) :
    (∫ x, martingaleEnergy M N x ^ a ∂μ) ≤ a * 2^(a - 1) *
      ((∫ x, martingaleEnergy M N x ^ (a - 1) * martingaleMax M N x ^ 2 ∂μ) +
        ∫ x, (2 * martingaleMax M N x) ^ (2 * (a - 1)) * martingaleEnergy M N x ∂μ) := by
  let T := martingaleEnergy M
  let D := martingaleDifference M
  let H := martingaleMax M N
  let C := a * 2^(a - 1)
  let w (k : ℕ) (x : Ω) := T k x ^ (a - 1)
  have hT (k : ℕ) (x : Ω) : 0 ≤ T k x := martingaleEnergy_nonneg M k x
  have hMa (k : ℕ) : Measurable (M k) :=
    ((hM.stronglyAdapted k).mono (ℱ.le k)).measurable
  have hTa (k : ℕ) : Measurable (T k) :=
    ((martingaleEnergy_adapted hM.stronglyAdapted k).mono (ℱ.le k)).measurable
  have hDa (k : ℕ) : Measurable (D k) := (hMa (k + 1)).sub (hMa k)
  have hwa (k : ℕ) : Measurable (w k) := (hTa k).pow_const _
  have hHa : Measurable H := measurable_martingaleMax hM N
  have hH (x : Ω) : 0 ≤ H x := martingaleMax_nonneg M N x
  have hC : 0 ≤ C := by dsimp [C]; positivity
  have hTs (k : ℕ) (x : Ω) : T (k + 1) x = T k x + D k x^2 :=
    martingaleEnergy_succ M k x
  have hsum (x : Ω) :
      T N x ^ a ≤ C * ∑ k ∈ Finset.range N, (w k x * D k x^2 + (D k x^2)^a) := by
    have hstep (k : ℕ) : T (k + 1) x ^ a - T k x ^ a ≤
        C * (w k x * D k x^2 + (D k x^2)^a) := by
      rw [hTs]
      exact rpow_add_increment_le ha (hT k x) (sq_nonneg _)
    have hh := Finset.sum_le_sum (s := Finset.range N) (fun k _ => hstep k)
    rw [Finset.sum_range_sub (fun k => T k x ^ a), ← Finset.mul_sum] at hh
    have hzero : T 0 x = 0 := Finset.sum_range_zero _
    simpa only [hzero, Real.zero_rpow (by linarith : a ≠ 0), sub_zero] using hh
  have hsq (k : ℕ) :
      (∫ x, w k x * D k x^2 ∂μ) =
        ∫ x, w k x * (M (k + 1) x^2 - M k x^2) ∂μ := by
    let G (x : Ω) := 2 * w k x * M k x
    have hG : StronglyMeasurable[ℱ k] G := by
      exact ((measurable_const.mul
        ((martingaleEnergy_adapted hM.stronglyAdapted k).measurable.pow_const (a - 1))).mul
        (hM.stronglyAdapted k).measurable).stronglyMeasurable
    have hGi : Integrable (fun x => G x * D k x) μ :=
      integrable_of_measurable_finite ((hG.mono (ℱ.le k)).measurable.mul (hDa k))
    have hz : (∫ x, G x * D k x ∂μ) = 0 :=
      martingale_integral_mul_difference_eq_zero hM k hG hGi
    have he : (fun x => w k x * (M (k + 1) x^2 - M k x^2)) =
        (fun x => w k x * D k x^2 + G x * D k x) := by
      funext x
      dsimp [G, D, martingaleDifference]
      ring
    have hi : Integrable (fun x => w k x * D k x^2) μ :=
      integrable_of_measurable_finite ((hwa k).mul ((hDa k).pow_const (2 : ℕ)))
    rw [he, integral_add hi hGi, hz, add_zero]
  have hwMono (x : Ω) : Monotone (fun k => w k x) := by
    apply monotone_nat_of_le_succ
    intro k
    apply Real.rpow_le_rpow (hT k x) _ (by linarith)
    rw [hTs]
    exact le_add_of_nonneg_right (sq_nonneg _)
  have hweighted (x : Ω) :
      ∑ k ∈ Finset.range N, w k x * (M (k + 1) x^2 - M k x^2) ≤
        w N x * H x^2 := by
    have hw := weighted_sum_difference_le (hwMono x) (fun k => sq_nonneg (M k x)) N
    have hm : ‖M N x‖ ≤ H x :=
      Finset.le_sup' (fun k => ‖M k x‖) (Finset.mem_range.mpr (Nat.lt_succ_self _))
    have hq : M N x^2 ≤ H x^2 := by
      rw [← sq_abs (M N x), ← Real.norm_eq_abs]
      exact pow_le_pow_left₀ (norm_nonneg _) hm 2
    exact hw.trans ((sub_le_self _ (mul_nonneg (Real.rpow_nonneg (hT 0 x) _) (sq_nonneg _))).trans
      (mul_le_mul_of_nonneg_left hq (Real.rpow_nonneg (hT N x) _)))
  have hhigh (x : Ω) :
      ∑ k ∈ Finset.range N, (D k x^2)^a ≤ (2 * H x)^(2 * (a - 1)) * T N x := by
    rw [show T N x = ∑ k ∈ Finset.range N, D k x^2 from rfl, Finset.mul_sum]
    apply Finset.sum_le_sum
    intro k hk
    have hkN := Finset.mem_range.mp hk
    have hsup (j : ℕ) (hj : j ≤ N) : ‖M j x‖ ≤ H x :=
      Finset.le_sup' (fun k => ‖M k x‖) (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))
    have hb : ‖D k x‖ ≤ 2 * H x :=
      (norm_sub_le _ _).trans (by linarith [hsup k hkN.le, hsup (k + 1) hkN])
    have hbase : D k x^2 ≤ (2 * H x)^2 := by
      rw [← sq_abs (D k x), ← Real.norm_eq_abs]
      exact pow_le_pow_left₀ (norm_nonneg _) hb 2
    have hpow := Real.rpow_le_rpow (sq_nonneg (D k x)) hbase (by linarith : 0 ≤ a - 1)
    have hpower : ((2 * H x)^2)^ (a - 1) = (2 * H x)^(2 * (a - 1)) := by
      rw [Real.rpow_mul (mul_nonneg (by norm_num) (hH x)), Real.rpow_two]
    rw [hpower] at hpow
    have hid : (D k x^2)^a = (D k x^2)^(a - 1) * D k x^2 := by
      calc
        _ = (D k x^2)^((a - 1) + 1) := by rw [sub_add_cancel]
        _ = _ := by rw [Real.rpow_add_of_nonneg (sq_nonneg _) (by linarith : 0 ≤ a - 1)
          zero_le_one, Real.rpow_one]
    rw [hid]
    exact mul_le_mul_of_nonneg_right hpow (sq_nonneg _)
  have h1 (k : ℕ) : Integrable (fun x => w k x * D k x^2) μ :=
    integrable_of_measurable_finite ((hwa k).mul ((hDa k).pow_const (2 : ℕ)))
  have h2 (k : ℕ) : Integrable (fun x => (D k x^2)^a) μ :=
    integrable_of_measurable_finite (((hDa k).pow_const (2 : ℕ)).pow_const a)
  have h3 (k : ℕ) : Integrable (fun x => w k x * (M (k + 1) x^2 - M k x^2)) μ :=
    integrable_of_measurable_finite ((hwa k).mul
      (((hMa (k + 1)).pow_const (2 : ℕ)).sub ((hMa k).pow_const (2 : ℕ))))
  have h4 : Integrable (fun x => w N x * H x^2) μ :=
    integrable_of_measurable_finite ((hwa N).mul (hHa.pow_const (2 : ℕ)))
  have h5 : Integrable (fun x => (2 * H x)^(2 * (a - 1)) * T N x) μ :=
    integrable_of_measurable_finite (((measurable_const.mul hHa).pow_const _).mul (hTa N))
  have hI := integral_mono (integrable_of_measurable_finite ((hTa N).pow_const a))
    ((integrable_finsetSum (Finset.range N) (fun k _ => (h1 k).add (h2 k))).const_mul C) hsum
  rw [integral_const_mul, integral_finsetSum _ (fun k _ => (h1 k).add (h2 k))] at hI
  change (∫ x, T N x ^ a ∂μ) ≤ C *
    ∑ k ∈ Finset.range N, ∫ x, w k x * D k x^2 + (D k x^2)^a ∂μ at hI
  have hadd (k : ℕ) :
      (∫ x, w k x * D k x^2 + (D k x^2)^a ∂μ) =
        (∫ x, w k x * (M (k + 1) x^2 - M k x^2) ∂μ) + ∫ x, (D k x^2)^a ∂μ := by
    rw [integral_add (h1 k) (h2 k), hsq]
  simp only [hadd, Finset.sum_add_distrib] at hI
  have hI1 := integral_mono (integrable_finsetSum (Finset.range N) (fun k _ => h3 k)) h4 hweighted
  have hI2 := integral_mono (integrable_finsetSum (Finset.range N) (fun k _ => h2 k)) h5 hhigh
  rw [integral_finsetSum _ (fun k _ => h3 k)] at hI1
  rw [integral_finsetSum _ (fun k _ => h2 k)] at hI2
  exact hI.trans (mul_le_mul_of_nonneg_left (add_le_add hI1 hI2) hC)

private theorem integral_mul_powers_le {Ω : Type*} [Finite Ω]
    [MeasurableSpace Ω] {μ : Measure Ω} [IsFiniteMeasure μ]
    {f g : Ω → ℝ} (hfm : Measurable f) (hgm : Measurable g)
    (hf : ∀ x, 0 ≤ f x) (hg : ∀ x, 0 ≤ g x)
    {b c : ℝ} (hb : 0 < b) (hc : 0 < c) :
    (∫ x, f x ^ b * g x ^ c ∂μ) ≤
      (∫ x, f x ^ (b + c) ∂μ) ^ (b / (b + c)) *
        (∫ x, g x ^ (b + c) ∂μ) ^ (c / (b + c)) := by
  let p := (b + c) / b
  let q := (b + c) / c
  have hbc : 0 < b + c := by linarith
  have hpq : p.HolderConjugate q := by
    apply Real.holderConjugate_iff.mpr
    constructor
    · change 1 < (b + c) / b
      exact (lt_div_iff₀ hb).mpr (by linarith)
    · change ((b + c) / b)⁻¹ + ((b + c) / c)⁻¹ = 1
      rw [inv_div, inv_div, ← add_div, div_self hbc.ne']
  have hfLp := memLp_of_measurable_finite (μ := μ) (hfm.pow_const b) (ENNReal.ofReal p)
  have hgLp := memLp_of_measurable_finite (μ := μ) (hgm.pow_const c) (ENNReal.ofReal q)
  have h := integral_mul_le_Lp_mul_Lq_of_nonneg hpq
    (Filter.Eventually.of_forall fun x => Real.rpow_nonneg (hf x) _)
    (Filter.Eventually.of_forall fun x => Real.rpow_nonneg (hg x) _) hfLp hgLp
  have hep : b * p = b + c := by dsimp [p]; field_simp
  have heq : c * q = b + c := by dsimp [q]; field_simp
  simp_rw [← Real.rpow_mul (hf _), ← Real.rpow_mul (hg _), hep, heq] at h
  simpa only [one_div, p, q, inv_div] using h

private theorem power_mixed_le_absorb {X Y C b c : ℝ}
    (hX : 0 ≤ X) (hY : 0 ≤ Y) (hC : 0 ≤ C) (hb : 0 < b) (hc : 0 < c)
    (h : X ≤ C * (X^(b / (b + c)) * Y^(c / (b + c)) +
      Y^(b / (b + c)) * X^(c / (b + c)))) :
    X ≤ (max 1 (2 * C))^((b + c) / min b c) * Y := by
  let P := b + c
  let θ := min b c / P
  let K := max 1 (2 * C)
  have hP : 0 < P := by dsimp [P]; linarith
  have hθ : 0 < θ := div_pos (lt_min hb hc) hP
  have hK : 0 < K := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  have hK1 : 1 ≤ K := le_max_left _ _
  have hθb : θ ≤ b / P := div_le_div_of_nonneg_right (min_le_left _ _) hP.le
  have hθc : θ ≤ c / P := div_le_div_of_nonneg_right (min_le_right _ _) hP.le
  have hsum : b / P + c / P = 1 := by rw [← add_div]; exact div_self hP.ne'
  have hpow : K^((b + c) / min b c) = K^(1 / θ) := by
    dsimp only [θ, P]
    rw [one_div, inv_div]
  rw [hpow]
  by_cases hXY : X ≤ Y
  · exact hXY.trans (le_mul_of_one_le_left hY (Real.one_le_rpow hK1 (by positivity)))
  have hX0 : 0 < X := hY.trans_lt (lt_of_not_ge hXY)
  let Z := Y / X
  have hZ0 : 0 ≤ Z := div_nonneg hY hX
  have hZ1 : Z ≤ 1 := (div_le_one₀ hX0).mpr (le_of_lt (lt_of_not_ge hXY))
  have hconvert (u v : ℝ) (huv : u + v = 1) :
      X^u * Y^v = X * Z^v := by
    have he : Y = X * Z := by dsimp [Z]; field_simp
    calc
      _ = X^u * (X * Z)^v := by rw [← he]
      _ = _ := by rw [Real.mul_rpow hX hZ0, ← mul_assoc, ← Real.rpow_add hX0, huv, Real.rpow_one]
  have hm₁ := hconvert (b / P) (c / P) hsum
  have hm₂ := hconvert (c / P) (b / P) (by rw [add_comm]; exact hsum)
  rw [hm₁, mul_comm (Y^_) _, hm₂, ← mul_add] at h
  have hdiv : 1 ≤ C * (Z^(c / P) + Z^(b / P)) := by
    rw [← mul_assoc, mul_right_comm C X] at h
    exact (le_of_mul_le_mul_right (by simpa only [one_mul] using h) hX0)
  have hzc := Real.rpow_le_rpow_of_exponent_ge' hZ0 hZ1 hθ.le hθc
  have hzb := Real.rpow_le_rpow_of_exponent_ge' hZ0 hZ1 hθ.le hθb
  have hle : 1 ≤ K * Z^θ := hdiv.trans (calc
    _ ≤ C * (Z^θ + Z^θ) := mul_le_mul_of_nonneg_left (add_le_add hzc hzb) hC
    _ = (2 * C) * Z^θ := by ring
    _ ≤ K * Z^θ := mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.rpow_nonneg hZ0 _))
  have hres := Real.rpow_le_rpow (by norm_num : (0 : ℝ) ≤ 1) hle
    (show 0 ≤ (1 / θ) by positivity)
  rw [Real.one_rpow, Real.mul_rpow hK.le (Real.rpow_nonneg hZ0 _),
    one_div, Real.rpow_rpow_inv hZ0 hθ.ne'] at hres
  have hmul := mul_le_mul_of_nonneg_right hres hX
  rw [one_mul, mul_assoc, show Z * X = Y by dsimp [Z]; field_simp] at hmul
  simpa only [one_div] using hmul

/-- The constant in the upper square-function moment estimate. -/
noncomputable def martingaleUpperMomentConstant (a : ℝ) : ℝ :=
  (max 1 (2 * (a * 2^(a - 1) * 2^(2 * (a - 1)))))^(a / min (a - 1) 1)

/-- Upper square-function moment estimate in terms of the running maximum. -/
theorem martingaleEnergy_moment_le_max {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    (N : ℕ) {a : ℝ} (ha : 1 < a) :
    (∫ x, martingaleEnergy M N x ^ a ∂μ) ≤
      martingaleUpperMomentConstant a * ∫ x, martingaleMax M N x ^ (2 * a) ∂μ := by
  let T := martingaleEnergy M N
  let H := martingaleMax M N
  let V (x : Ω) := H x^2
  let X := ∫ x, T x ^ a ∂μ
  let Y := ∫ x, V x ^ a ∂μ
  let D : ℝ := 2 ^ (2 * (a - 1))
  let C := a * 2^(a - 1) * D
  have hT (x : Ω) : 0 ≤ T x := martingaleEnergy_nonneg M N x
  have hH (x : Ω) : 0 ≤ H x := martingaleMax_nonneg M N x
  have hV (x : Ω) : 0 ≤ V x := sq_nonneg _
  have hX : 0 ≤ X := integral_nonneg fun x => Real.rpow_nonneg (hT x) _
  have hY : 0 ≤ Y := integral_nonneg fun x => Real.rpow_nonneg (hV x) _
  have hTm : Measurable T :=
    ((martingaleEnergy_adapted hM.stronglyAdapted N).mono (ℱ.le N)).measurable
  have hHm : Measurable H := measurable_martingaleMax hM N
  have hVm : Measurable V := hHm.pow_const (2 : ℕ)
  have h1 := integral_mul_powers_le (μ := μ) hTm hVm hT hV (b := a - 1) (c := 1)
    (by linarith) zero_lt_one
  have h2 := integral_mul_powers_le (μ := μ) hVm hTm hV hT (b := a - 1) (c := 1)
    (by linarith) zero_lt_one
  simp only [sub_add_cancel, Real.rpow_one] at h1 h2
  have hVpow (x : Ω) (r : ℝ) : V x ^ r = H x ^ (2 * r) := by
    change (H x^2)^r = _
    rw [Real.rpow_mul (hH x), Real.rpow_two]
  have hsplit (x : Ω) : (2 * H x)^(2 * (a - 1)) = D * V x ^ (a - 1) := by
    rw [hVpow, Real.mul_rpow (by norm_num) (hH x)]
  have hmom := martingaleEnergy_moment_le hM N ha
  change X ≤ a * 2^(a - 1) * ((∫ x, T x^(a - 1) * V x ∂μ) +
    ∫ x, (2 * H x)^(2 * (a - 1)) * T x ∂μ) at hmom
  simp_rw [hsplit, mul_assoc, integral_const_mul] at hmom
  rw [← mul_assoc a] at hmom
  have hD : 1 ≤ D := Real.one_le_rpow (by norm_num) (by linarith)
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  have htot : X ≤ C * (X^((a - 1) / a) * Y^(1 / a) + Y^((a - 1) / a) * X^(1 / a)) := by
    refine hmom.trans ?_
    change (∫ x, T x ^ (a - 1) * V x ∂μ) ≤ X^((a - 1) / a) * Y^(1 / a) at h1
    change (∫ x, V x ^ (a - 1) * T x ∂μ) ≤ Y^((a - 1) / a) * X^(1 / a) at h2
    have h1' := h1.trans (le_mul_of_one_le_left (by positivity) hD)
    have hs := add_le_add h1' (mul_le_mul_of_nonneg_left h2 (zero_le_one.trans hD))
    rw [← mul_add] at hs
    exact (mul_le_mul_of_nonneg_left hs (by positivity)).trans_eq (by simp only [C, mul_assoc])
  have h := power_mixed_le_absorb hX hY hC (by linarith : 0 < a - 1) zero_lt_one
    (by simpa only [sub_add_cancel] using htot)
  change X ≤ (max 1 (2 * C))^(a / min (a - 1) 1) * _
  have hy : Y = ∫ x, H x ^ (2 * a) ∂μ := by
    exact integral_congr_ae (Filter.Eventually.of_forall fun x => hVpow x a)
  simpa only [hy, sub_add_cancel] using h

private theorem hasDerivAt_abs_rpow_nonzero {p x : ℝ} (hx : x ≠ 0) :
    HasDerivAt (fun t : ℝ => |t|^p) (p * |x|^(p - 2) * x) x := by
  have hpow : |x|^(p - 1) = |x|^(p - 2) * |x| := by
    rw [show p - 1 = (p - 2) + 1 by ring, Real.rpow_add (abs_pos.mpr hx), Real.rpow_one]
  rcases lt_or_gt_of_ne hx with hx' | hx'
  · have h := (Real.hasDerivAt_rpow_const (x := |x|) (p := p)
      (Or.inl (abs_pos.mpr hx).ne')).comp x (hasDerivAt_abs_neg hx')
    change HasDerivAt (fun t : ℝ => |t|^p) _ x at h
    convert h using 1
    rw [hpow, abs_of_neg hx']
    ring
  · have h := (Real.hasDerivAt_rpow_const (x := |x|) (p := p)
      (Or.inl (abs_pos.mpr hx).ne')).comp x (hasDerivAt_abs_pos hx')
    change HasDerivAt (fun t : ℝ => |t|^p) _ x at h
    convert h using 1
    rw [hpow, abs_of_pos hx']
    ring

private theorem hasDerivAt_abs_rpow_gradient_nonzero {p x : ℝ} (hx : x ≠ 0) :
    HasDerivAt (fun t : ℝ => p * |t|^(p - 2) * t) (p * (p - 1) * |x|^(p - 2)) x := by
  have hrel (t : ℝ) (ht : t ≠ 0) :
      |t|^(p - 1) = |t|^(p - 2) * |t| := by
    rw [show p - 1 = (p - 2) + 1 by ring, Real.rpow_add (abs_pos.mpr ht), Real.rpow_one]
  rcases lt_or_gt_of_ne hx with hx' | hx'
  · have h := (Real.hasDerivAt_rpow_const (x := |x|) (p := p - 1)
      (Or.inl (abs_pos.mpr hx).ne')).comp x (hasDerivAt_abs_neg hx')
    have hh := h.const_mul (-p)
    convert hh.congr_of_eventuallyEq ?_ using 1
    · rw [show p - 1 - 1 = p - 2 by ring]
      ring
    · filter_upwards [eventually_lt_nhds hx'] with t ht
      change p * |t|^(p - 2) * t = -p * |t|^(p - 1)
      rw [hrel _ ht.ne, abs_of_neg ht]
      ring
  · have h := (Real.hasDerivAt_rpow_const (x := |x|) (p := p - 1)
      (Or.inl (abs_pos.mpr hx).ne')).comp x (hasDerivAt_abs_pos hx')
    have hh := h.const_mul p
    convert hh.congr_of_eventuallyEq ?_ using 1
    · rw [show p - 1 - 1 = p - 2 by ring]
      ring
    · filter_upwards [eventually_gt_nhds hx'] with t ht
      change p * |t|^(p - 2) * t = p * |t|^(p - 1)
      rw [hrel _ ht.ne', abs_of_pos ht]
      ring

private theorem hasDerivAt_abs_rpow {p x : ℝ} (hp : 1 < p) :
    HasDerivAt (fun t : ℝ => |t|^p) (p * |x|^(p - 2) * x) x := by
  by_cases hx : x = 0
  · subst x
    rw [mul_zero, hasDerivAt_iff_tendsto_slope_zero]
    simp only [zero_add, abs_zero, Real.zero_rpow (by linarith : p ≠ 0), sub_zero, smul_eq_mul]
    have hbase : Filter.Tendsto (fun t : ℝ => |t|^(p - 1)) (nhds 0) (nhds 0) := by
      have h := ((Real.continuous_rpow_const (by linarith : 0 ≤ p - 1)).comp
        continuous_abs).continuousAt (x := (0 : ℝ))
      change ContinuousAt (fun t : ℝ => |t|^(p - 1)) 0 at h
      simpa only [ContinuousAt, Function.comp_apply, abs_zero,
        Real.zero_rpow (by linarith : p - 1 ≠ 0)] using h
    apply squeeze_zero_norm' _ (hbase.mono_left nhdsWithin_le_nhds)
    filter_upwards [self_mem_nhdsWithin (s := ({0} : Set ℝ)ᶜ)] with t ht
    have ht0 : t ≠ 0 := ht
    rw [Real.norm_eq_abs, abs_mul, abs_inv, abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
    have he : |t|^p = |t| * |t|^(p - 1) := by
      calc
        _ = |t|^(1 + (p - 1)) := by rw [show 1 + (p - 1) = p by ring]
        _ = _ := by rw [Real.rpow_add (abs_pos.mpr ht0), Real.rpow_one]
    rw [he, ← mul_assoc, inv_mul_cancel₀ (abs_pos.mpr ht0).ne', one_mul]
  · exact hasDerivAt_abs_rpow_nonzero hx

private theorem hasDerivAt_abs_rpow_gradient {p x : ℝ} (hp : 2 < p) :
    HasDerivAt (fun t : ℝ => p * |t|^(p - 2) * t) (p * (p - 1) * |x|^(p - 2)) x := by
  by_cases hx : x = 0
  · subst x
    rw [abs_zero, Real.zero_rpow (by linarith : p - 2 ≠ 0), mul_zero,
      hasDerivAt_iff_tendsto_slope_zero]
    simp only [zero_add, mul_zero, sub_zero, smul_eq_mul]
    have hbase : Filter.Tendsto (fun t : ℝ => p * |t|^(p - 2)) (nhds 0) (nhds 0) := by
      have h := (((Real.continuous_rpow_const (by linarith : 0 ≤ p - 2)).comp
        continuous_abs).const_mul p).continuousAt (x := (0 : ℝ))
      simpa only [ContinuousAt, Function.comp_apply, abs_zero, Real.zero_rpow (by linarith : p - 2 ≠ 0),
        mul_zero] using h
    refine (hbase.mono_left nhdsWithin_le_nhds).congr' ?_
    filter_upwards [self_mem_nhdsWithin (s := ({0} : Set ℝ)ᶜ)] with t ht
    have ht0 : t ≠ 0 := ht
    rw [mul_left_comm t⁻¹, inv_mul_cancel₀ ht0, mul_one]
  · exact hasDerivAt_abs_rpow_gradient_nonzero hx

private theorem abs_rpow_taylor_le {p : ℝ} (hp : 2 < p) (a b : ℝ) :
    |a + b|^p - |a|^p - p * |a|^(p - 2) * a * b ≤
      p * (p - 1) * 2^(p - 2) * (|a|^(p - 2) * b^2 + |b|^p) := by
  let G (t : ℝ) := |a + t * b|^p - t * (p * |a|^(p - 2) * a * b)
  let D (t : ℝ) := p * |a + t * b|^(p - 2) * (a + t * b) * b
  let L := p * |a|^(p - 2) * a * b
  have hline (t : ℝ) : HasDerivAt (fun t => a + t * b) b t := by
    simpa only [id_eq, one_mul] using ((hasDerivAt_id t).mul_const b).const_add a
  have hG (t : ℝ) : HasDerivAt G (D t - L) t := by
    have h := ((hasDerivAt_abs_rpow (p := p) (x := a + t * b) (by linarith)).comp t
      (hline t)).sub ((hasDerivAt_id t).mul_const L)
    have he : (((fun t : ℝ => |t|^p) ∘ fun t => a + t * b) - fun y => id y * L) = G := rfl
    rw [he, one_mul] at h
    exact h
  have hD (t : ℝ) : HasDerivAt D (p * (p - 1) * |a + t * b|^(p - 2) * b^2) t := by
    convert (((hasDerivAt_abs_rpow_gradient (x := a + t * b) hp).comp t
      (hline t)).mul_const b) using 1
    · funext z
      rfl
    · ring
  obtain ⟨s, hs, hgs⟩ := exists_deriv_eq_slope G (by norm_num : (0 : ℝ) < 1)
    (fun t _ => (hG t).continuousAt.continuousWithinAt)
    (fun t _ => (hG t).differentiableAt.differentiableWithinAt)
  rw [(hG s).deriv, sub_zero, div_one] at hgs
  obtain ⟨t, ht, hdt⟩ := exists_deriv_eq_slope D hs.1
    (fun t _ => (hD t).continuousAt.continuousWithinAt)
    (fun t _ => (hD t).differentiableAt.differentiableWithinAt)
  rw [(hD t).deriv, sub_zero] at hdt
  have hD0 : D 0 = L := by simp only [D, L, zero_mul, add_zero]
  rw [hD0] at hdt
  have hrem : |a + b|^p - |a|^p - p * |a|^(p - 2) * a * b =
      s * (p * (p - 1) * |a + t * b|^(p - 2) * b^2) := by
    calc
      _ = G 1 - G 0 := by dsimp [G]; ring
      _ = D s - L := hgs.symm
      _ = _ := by rw [mul_comm]; exact (div_eq_iff hs.1.ne').mp hdt.symm
  have hbound : |a + t * b| ≤ (2 : ℝ) * max |a| |b| := by
    have htt : t ≤ 1 := ht.2.le.trans hs.2.le
    calc
      _ ≤ |a| + |t * b| := abs_add_le _ _
      _ ≤ |a| + |b| := by
        rw [abs_mul, abs_of_nonneg ht.1.le]
        exact add_le_add le_rfl (mul_le_of_le_one_left (abs_nonneg b) htt)
      _ ≤ _ := by linarith [le_max_left |a| |b|, le_max_right |a| |b|]
  have hpow := Real.rpow_le_rpow (abs_nonneg _) hbound (by linarith : 0 ≤ p - 2)
  rw [Real.mul_rpow (by norm_num) ((abs_nonneg a).trans (le_max_left _ _))] at hpow
  have hsum : |a + t * b|^(p - 2) ≤ 2^(p - 2) * (|a|^(p - 2) + |b|^(p - 2)) := by
    refine hpow.trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
    rcases le_total |a| |b| with h | h
    · rw [max_eq_right h]
      exact le_add_of_nonneg_left (Real.rpow_nonneg (abs_nonneg a) _)
    · rw [max_eq_left h]
      exact le_add_of_nonneg_right (Real.rpow_nonneg (abs_nonneg b) _)
  have hb : |b|^(p - 2) * b^2 = |b|^p := by
    calc
      _ = |b|^(p - 2) * |b|^(2 : ℝ) := by rw [Real.rpow_two, sq_abs]
      _ = _ := by rw [← Real.rpow_add_of_nonneg (abs_nonneg b) (by linarith : 0 ≤ p - 2)
        (by norm_num), sub_add_cancel]
  rw [hrem]
  have hpp : 0 ≤ p * (p - 1) := mul_nonneg (by linarith) (by linarith)
  calc
    _ ≤ p * (p - 1) * |a + t * b|^(p - 2) * b^2 :=
      mul_le_of_le_one_left
        (mul_nonneg (mul_nonneg hpp (Real.rpow_nonneg (abs_nonneg _) _)) (sq_nonneg _)) hs.2.le
    _ ≤ p * (p - 1) * (2^(p - 2) * (|a|^(p - 2) + |b|^(p - 2))) * b^2 := by gcongr
    _ = _ := by rw [← hb]; ring

private theorem abs_difference_moment_sum_le {Ω : Type*} (M : ℕ → Ω → ℝ)
    (N : ℕ) (x : Ω) {p : ℝ} (hp : 2 < p) :
    ∑ k ∈ Finset.range N, |martingaleDifference M k x|^p ≤
      martingaleEnergy M N x ^ (p / 2) := by
  let T := martingaleEnergy M N x
  let d (k : ℕ) := martingaleDifference M k x
  have hT : 0 ≤ T := martingaleEnergy_nonneg M N x
  have hsum : T = ∑ k ∈ Finset.range N, d k ^ 2 := rfl
  have hsplit (z : ℝ) : |z|^p = (z^2)^(p / 2 - 1) * z^2 := by
    calc
      _ = |z|^(2 * (p / 2)) := by rw [show 2 * (p / 2) = p by ring]
      _ = (z^2)^((p / 2 - 1) + 1) := by
        rw [Real.rpow_mul (abs_nonneg z), Real.rpow_two, sq_abs, sub_add_cancel]
      _ = _ := by
        rw [Real.rpow_add_of_nonneg (sq_nonneg z) (by linarith) zero_le_one, Real.rpow_one]
  have hl : (∑ k ∈ Finset.range N, |d k|^p) ≤
      ∑ k ∈ Finset.range N, T^(p / 2 - 1) * d k^2 := by
    apply Finset.sum_le_sum
    intro k hk
    rw [hsplit]
    apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
    exact Real.rpow_le_rpow (sq_nonneg _) (hsum.symm ▸
      Finset.single_le_sum (fun j _ => sq_nonneg (d j)) hk) (by linarith)
  change (∑ k ∈ Finset.range N, |d k|^p) ≤ T^(p / 2)
  refine hl.trans_eq ?_
  rw [← Finset.mul_sum, ← hsum]
  calc
    _ = T^(p / 2 - 1) * T^(1 : ℝ) := by rw [Real.rpow_one]
    _ = _ := by rw [← Real.rpow_add_of_nonneg hT
      (by linarith : 0 ≤ p / 2 - 1) zero_le_one, sub_add_cancel]

/-- The reverse square-function moment recursion, before applying Hölder. -/
theorem martingale_terminal_moment_le {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    (N : ℕ) {p : ℝ} (hp : 2 < p) (hinit : M 0 = 0) :
    (∫ x, |M N x|^p ∂μ) ≤ p * (p - 1) * 2^(p - 2) *
      ((∫ x, martingaleMax M N x ^ (p - 2) * martingaleEnergy M N x ∂μ) +
        ∫ x, martingaleEnergy M N x ^ (p / 2) ∂μ) := by
  let D := martingaleDifference M
  let T := martingaleEnergy M N
  let H := martingaleMax M N
  let C := p * (p - 1) * 2^(p - 2)
  let G (k : ℕ) (x : Ω) := p * |M k x|^(p - 2) * M k x
  have hp0 : 0 < p := by linarith
  have hC : 0 ≤ C :=
    mul_nonneg (mul_nonneg hp0.le (by linarith)) (Real.rpow_nonneg (by norm_num) _)
  have hMms (k : ℕ) : Measurable (M k) :=
    ((hM.stronglyAdapted k).mono (ℱ.le k)).measurable
  have hDm (k : ℕ) : Measurable (D k) := (hMms (k + 1)).sub (hMms k)
  have hHm : Measurable H := measurable_martingaleMax hM N
  have hTm : Measurable T :=
    ((martingaleEnergy_adapted hM.stronglyAdapted N).mono (ℱ.le N)).measurable
  have hG (k : ℕ) : StronglyMeasurable[ℱ k] (G k) := by
    have hm := (hM.stronglyAdapted k).measurable
    exact (((measurable_const.mul ((continuous_abs.measurable.comp hm).pow_const _)).mul
      hm)).stronglyMeasurable
  have hGi (k : ℕ) : Integrable (fun x => G k x * D k x) μ :=
    integrable_of_measurable_finite (((hG k).mono (ℱ.le k)).measurable.mul (hDm k))
  have hzero (k : ℕ) : (∫ x, G k x * D k x ∂μ) = 0 :=
    martingale_integral_mul_difference_eq_zero hM k (hG k) (hGi k)
  have hstep (k : ℕ) (hk : k < N) (x : Ω) :
      |M (k + 1) x|^p - |M k x|^p ≤ G k x * D k x +
        C * (H x^(p - 2) * D k x^2 + |D k x|^p) := by
    have h := abs_rpow_taylor_le hp (M k x) (D k x)
    have he : M k x + D k x = M (k + 1) x := by dsimp [D, martingaleDifference]; ring
    rw [he] at h
    have hsup : |M k x| ≤ H x := by
      rw [← Real.norm_eq_abs]
      exact Finset.le_sup' (fun j => ‖M j x‖)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hk.le))
    have hh := Real.rpow_le_rpow (abs_nonneg _) hsup (by linarith : 0 ≤ p - 2)
    have he' : G k x * D k x = p * |M k x|^(p - 2) * M k x * D k x := rfl
    rw [he']
    linarith [h.trans (mul_le_mul_of_nonneg_left
      (add_le_add (mul_le_mul_of_nonneg_right hh (sq_nonneg (D k x))) le_rfl) hC)]
  have hpoint (x : Ω) : |M N x|^p ≤
      (∑ k ∈ Finset.range N, G k x * D k x) +
        C * (H x^(p - 2) * T x + T x^(p / 2)) := by
    have h := Finset.sum_le_sum (s := Finset.range N) (fun k hk => hstep k (Finset.mem_range.mp hk) x)
    rw [Finset.sum_range_sub (fun k => |M k x|^p), Finset.sum_add_distrib, ← Finset.mul_sum,
      Finset.sum_add_distrib, ← Finset.mul_sum] at h
    simp only [hinit, Pi.zero_apply, abs_zero, Real.zero_rpow hp0.ne', sub_zero] at h
    exact h.trans (add_le_add le_rfl (mul_le_mul_of_nonneg_left
      (add_le_add le_rfl (abs_difference_moment_sum_le M N x hp)) hC))
  have hfirst : Integrable (fun x => ∑ k ∈ Finset.range N, G k x * D k x) μ :=
    integrable_finsetSum _ (fun k _ => hGi k)
  have hterm : Integrable (fun x => H x^(p - 2) * T x) μ :=
    integrable_of_measurable_finite ((hHm.pow_const _).mul hTm)
  have hlast : Integrable (fun x => T x^(p / 2)) μ :=
    integrable_of_measurable_finite (hTm.pow_const _)
  have hlhs : Integrable (fun x => |M N x|^p) μ :=
    integrable_of_measurable_finite ((continuous_abs.measurable.comp (hMms N)).pow_const _)
  have hi := integral_mono hlhs (hfirst.add ((hterm.add hlast).const_mul C)) hpoint
  have he := integral_add hfirst ((hterm.add hlast).const_mul C)
  have hsub := integral_add hterm hlast
  simp only [Pi.add_apply] at hi he hsub
  rw [he, integral_finsetSum _ (fun k _ => hGi k), integral_const_mul, hsub] at hi
  simp only [hzero, Finset.sum_const_zero, zero_add] at hi
  exact hi

private theorem integral_nonneg_rpow_eq_lpNorm_rpow {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} {f : Ω → ℝ} (hf : AEStronglyMeasurable f μ) (h0 : ∀ x, 0 ≤ f x)
    {p : ℝ} (hp : 0 < p) :
    (∫ x, f x ^ p ∂μ) = lpNorm f (ENNReal.ofReal p) μ ^ p := by
  rw [lpNorm_eq_integral_norm_rpow_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp)
    ENNReal.ofReal_ne_top hf, ENNReal.toReal_ofReal hp.le]
  simp_rw [Real.norm_of_nonneg (h0 _)]
  rw [Real.rpow_inv_rpow (integral_nonneg fun x => Real.rpow_nonneg (h0 x) _) hp.ne']

private theorem lpNorm_norm_eq_real {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} {f : Ω → ℝ} {p : ℝ} (hp : 0 < p) (hf : AEStronglyMeasurable f μ) :
    lpNorm (fun x => |f x|) (ENNReal.ofReal p) μ = lpNorm f (ENNReal.ofReal p) μ := by
  have habs : AEStronglyMeasurable (fun x => |f x|) μ :=
    (continuous_abs.measurable.comp_aemeasurable hf.aemeasurable).aestronglyMeasurable
  rw [lpNorm_eq_integral_norm_rpow_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp)
    ENNReal.ofReal_ne_top habs,
    lpNorm_eq_integral_norm_rpow_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top hf]
  simp only [Real.norm_eq_abs, abs_abs]

private theorem martingaleMax_moment_le {Ω : Type*} {m : MeasurableSpace Ω}
    {μ : Measure Ω} [IsFiniteMeasure μ] {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ}
    (hM : Martingale M ℱ μ) (N : ℕ) {p : ℝ} (hp : 1 < p)
    (hMN : MemLp (M N) (ENNReal.ofReal p) μ) :
    (∫ x, martingaleMax M N x ^ p ∂μ) ≤
      (p / (p - 1))^p * ∫ x, |M N x|^p ∂μ := by
  have hp0 : 0 < p := by linarith
  have hq : 0 ≤ p / (p - 1) := div_nonneg hp0.le (by linarith)
  have hD := doob hM N hp hMN
  have hfinite : ENNReal.ofReal (p / (p - 1)) * eLpNorm (M N) (ENNReal.ofReal p) μ ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top hMN.eLpNorm_lt_top.ne
  have hre := ENNReal.toReal_mono hfinite hD
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hq] at hre
  change lpNorm (martingaleMax M N) (ENNReal.ofReal p) μ ≤
    (p / (p - 1)) * lpNorm (M N) (ENNReal.ofReal p) μ at hre
  have hz := Real.rpow_le_rpow lpNorm_nonneg hre hp0.le
  rw [Real.mul_rpow hq lpNorm_nonneg] at hz
  have habs : AEStronglyMeasurable (fun x => |M N x|) μ :=
    (continuous_abs.measurable.comp_aemeasurable hMN.aemeasurable).aestronglyMeasurable
  rw [integral_nonneg_rpow_eq_lpNorm_rpow (measurable_martingaleMax hM N).aestronglyMeasurable
    (martingaleMax_nonneg M N) hp0,
    integral_nonneg_rpow_eq_lpNorm_rpow
      habs
      (fun x => abs_nonneg (M N x)) hp0,
    lpNorm_norm_eq_real hp0 hMN.aestronglyMeasurable]
  exact hz

/-- The constant in the reverse square-function moment estimate. -/
noncomputable def martingaleReverseMomentConstant (p : ℝ) : ℝ :=
  (max 1 (2 * (p * (p - 1) * 2^(p - 2) * (p / (p - 1))^(p - 2))))^
    (p / min (p - 2) 2)

/-- The terminal moment is controlled by the square function for a
martingale starting at zero and moment exponent above two. -/
theorem martingale_terminal_moment_le_energy {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    (N : ℕ) {p : ℝ} (hp : 2 < p) (hinit : M 0 = 0) :
    (∫ x, |M N x|^p ∂μ) ≤
      martingaleReverseMomentConstant p * ∫ x, martingaleEnergy M N x ^ (p / 2) ∂μ := by
  let T := martingaleEnergy M N
  let S (x : Ω) := Real.sqrt (T x)
  let H := martingaleMax M N
  let X := ∫ x, |M N x|^p ∂μ
  let Y := ∫ x, T x ^ (p / 2) ∂μ
  let Z := ∫ x, H x ^ p ∂μ
  let q := p / (p - 1)
  let C := p * (p - 1) * 2^(p - 2)
  let K := C * q^(p - 2)
  have hp0 : 0 < p := by linarith
  have hq : 1 ≤ q := (le_div_iff₀ (by linarith)).mpr (by linarith)
  have hT (x : Ω) : 0 ≤ T x := martingaleEnergy_nonneg M N x
  have hH (x : Ω) : 0 ≤ H x := martingaleMax_nonneg M N x
  have hX : 0 ≤ X := integral_nonneg fun x => Real.rpow_nonneg (abs_nonneg _) _
  have hY : 0 ≤ Y := integral_nonneg fun x => Real.rpow_nonneg (hT x) _
  have hZ : 0 ≤ Z := integral_nonneg fun x => Real.rpow_nonneg (hH x) _
  have hC : 0 ≤ C :=
    mul_nonneg (mul_nonneg hp0.le (by linarith)) (Real.rpow_nonneg (by norm_num) _)
  have hK : 0 ≤ K := mul_nonneg hC (Real.rpow_nonneg (zero_le_one.trans hq) _)
  have hTm : Measurable T :=
    ((martingaleEnergy_adapted hM.stronglyAdapted N).mono (ℱ.le N)).measurable
  have hSm : Measurable S := Real.continuous_sqrt.measurable.comp hTm
  have hHm : Measurable H := measurable_martingaleMax hM N
  have hpLp : MemLp (M N) (ENNReal.ofReal p) μ := memLp_of_measurable_finite
    ((hM.stronglyAdapted N).mono (ℱ.le N)).measurable _
  have hmax : Z ≤ q^p * X := martingaleMax_moment_le hM N (by linarith) hpLp
  have hholder := integral_mul_powers_le (μ := μ) hHm hSm hH (fun _ => Real.sqrt_nonneg _)
    (b := p - 2) (c := 2) (by linarith) (by norm_num)
  have hSpow (x : Ω) : S x ^ p = T x ^ (p / 2) :=
    (Real.rpow_div_two_eq_sqrt (r := p) (hT x)).symm
  have hSsq (x : Ω) : S x ^ (2 : ℝ) = T x := by
    rw [Real.rpow_two]
    exact Real.sq_sqrt (hT x)
  simp only [sub_add_cancel, hSpow, hSsq] at hholder
  have hZbound := Real.rpow_le_rpow hZ hmax (show 0 ≤ (p - 2) / p by positivity)
  rw [Real.mul_rpow (Real.rpow_nonneg (zero_le_one.trans hq) _) hX,
    ← Real.rpow_mul (zero_le_one.trans hq), show p * ((p - 2) / p) = p - 2 by
      field_simp] at hZbound
  have hin : (∫ x, H x ^ (p - 2) * T x ∂μ) ≤ q^(p - 2) *
      (X^((p - 2) / p) * Y^(2 / p)) := by
    change _ ≤ Z^((p - 2) / p) * Y^(2 / p) at hholder
    exact hholder.trans ((mul_le_mul_of_nonneg_right hZbound (Real.rpow_nonneg hY _)).trans_eq
      (by rw [mul_assoc]))
  have hqpow : 1 ≤ q^(p - 2) := Real.one_le_rpow hq (by linarith)
  have hbound : X ≤ K * (X^((p - 2) / p) * Y^(2 / p) + Y) := by
    have hin' := add_le_add hin (le_mul_of_one_le_left hY hqpow)
    rw [← mul_add] at hin'
    exact (martingale_terminal_moment_le hM N hp hinit).trans
      ((mul_le_mul_of_nonneg_left hin' hC).trans_eq (by simp only [K, mul_assoc]))
  change X ≤ (max 1 (2 * K))^(p / min (p - 2) 2) * Y
  by_cases hXY : X ≤ Y
  · exact hXY.trans (le_mul_of_one_le_left hY
      (Real.one_le_rpow (le_max_left _ _) (by positivity)))
  have hy : Y ≤ Y^((p - 2) / p) * X^(2 / p) := by
    have hs : (p - 2) / p + 2 / p = 1 := by field_simp; ring
    calc
      _ = Y^((p - 2) / p) * Y^(2 / p) := by
        rw [← Real.rpow_add_of_nonneg hY (by positivity) (by positivity), hs, Real.rpow_one]
      _ ≤ _ := mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow hY (le_of_lt (lt_of_not_ge hXY)) (by positivity))
        (Real.rpow_nonneg hY _)
  have hh := hbound.trans (mul_le_mul_of_nonneg_left (add_le_add le_rfl hy) hK)
  simpa only [sub_add_cancel] using power_mixed_le_absorb hX hY hK
    (by linarith : 0 < p - 2) (by norm_num : 0 < (2 : ℝ))
    (by simpa only [sub_add_cancel] using hh)

/-- Square function of a finite martingale path. -/
noncomputable def martingaleSquareFunction {Ω : Type*} (M : ℕ → Ω → ℝ)
    (N : ℕ) (x : Ω) : ℝ := Real.sqrt (martingaleEnergy M N x)

/-- A common moment constant for both directions of the square-function estimate. -/
noncomputable def martingaleSquareMomentConstant (p : ℝ) : ℝ :=
  if p = 2 then 1 else max
    (martingaleUpperMomentConstant (p / 2) * (p / (p - 1))^p)
    (martingaleReverseMomentConstant p)

private theorem martingaleSquareMomentConstant_pos (p : ℝ) :
    0 < martingaleSquareMomentConstant p := by
  unfold martingaleSquareMomentConstant
  split
  · exact zero_lt_one
  · exact (Real.rpow_pos_of_pos (zero_lt_one.trans_le (le_max_left _ _)) _).trans_le
      (le_max_right _ _)

private theorem martingaleSquare_moments {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    (N : ℕ) {p : ℝ} (hp : 2 ≤ p) :
    let C := martingaleSquareMomentConstant p
    ((∫ x, martingaleEnergy M N x ^ (p / 2) ∂μ) ≤ C * ∫ x, |M N x|^p ∂μ) ∧
      (M 0 = 0 → (∫ x, |M N x|^p ∂μ) ≤ C * ∫ x, martingaleEnergy M N x ^ (p / 2) ∂μ) := by
  have hm (k : ℕ) : Measurable (M k) :=
    ((hM.stronglyAdapted k).mono (ℱ.le k)).measurable
  rcases eq_or_lt_of_le hp with rfl | hp'
  · have hE := martSquare_two hM N (memLp_of_measurable_finite (hm N) 2)
    have hs :
        (∫ x, martingaleEnergy M N x ∂μ) =
          (∫ x, (M N x)^2 ∂μ) - ∫ x, (M 0 x)^2 ∂μ := by
      unfold martingaleEnergy
      have hi (k : ℕ) : Integrable (fun x => (martingaleDifference M k x)^2) μ :=
        integrable_of_measurable_finite (((hm (k + 1)).sub (hm k)).pow_const (2 : ℕ))
      rw [integral_finsetSum _ (fun k _ => hi k)]
      exact hE
    norm_num [martingaleSquareMomentConstant, Real.rpow_one, Real.rpow_two, sq_abs]
    rw [hs]
    constructor
    · exact sub_le_self _ (integral_nonneg fun _ => sq_nonneg _)
    · intro hz
      simp only [hz, Pi.zero_apply, zero_pow (by decide : (2 : ℕ) ≠ 0), integral_zero, sub_zero]
      exact le_rfl
  · dsimp only [martingaleSquareMomentConstant]
    rw [ite_eq_right hp'.ne']
    have hLp : MemLp (M N) (ENNReal.ofReal p) μ := memLp_of_measurable_finite (hm N) _
    have hmax := martingaleMax_moment_le hM N (by linarith) hLp
    have hu := martingaleEnergy_moment_le_max hM N (a := p / 2) (by linarith)
    rw [show 2 * (p / 2) = p by ring] at hu
    have hC : 0 ≤ martingaleUpperMomentConstant (p / 2) := by
      unfold martingaleUpperMomentConstant
      exact Real.rpow_nonneg (zero_le_one.trans (le_max_left _ _)) _
    constructor
    · refine hu.trans ((mul_le_mul_of_nonneg_left hmax hC).trans ?_)
      rw [← mul_assoc]
      exact mul_le_mul_of_nonneg_right (le_max_left _ _)
        (integral_nonneg fun _ => Real.rpow_nonneg (abs_nonneg _) _)
    · intro hz
      exact (martingale_terminal_moment_le_energy hM N hp' hz).trans
        (mul_le_mul_of_nonneg_right (le_max_right _ _)
          (integral_nonneg fun x => Real.rpow_nonneg (martingaleEnergy_nonneg M N x) _))

/-- The two square-function inequalities of `bp:mart-square` on finite
probability trees. The displayed constant depends only on the exponent. -/
theorem martSquare {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    (N : ℕ) {p : ℝ} (hp : 2 ≤ p) :
    let C := martingaleSquareMomentConstant p ^ (1 / p)
    let S := lpNorm (martingaleSquareFunction M N) (ENNReal.ofReal p) μ
    let T := lpNorm (M N) (ENNReal.ofReal p) μ
    S ≤ C * T ∧ (M 0 = 0 → T ≤ C * S) := by
  let C := martingaleSquareMomentConstant p
  let F := martingaleSquareFunction M N
  let S := lpNorm F (ENNReal.ofReal p) μ
  let T := lpNorm (M N) (ENNReal.ofReal p) μ
  have hp0 : 0 < p := by linarith
  have hC := (martingaleSquareMomentConstant_pos p).le
  have hSm : Measurable F := Real.continuous_sqrt.measurable.comp
    ((martingaleEnergy_adapted hM.stronglyAdapted N).mono (ℱ.le N)).measurable
  have hTm : AEStronglyMeasurable (M N) μ :=
    ((hM.stronglyAdapted N).mono (ℱ.le N)).aestronglyMeasurable
  have hTa : AEStronglyMeasurable (fun x => |M N x|) μ :=
    (continuous_abs.measurable.comp_aemeasurable hTm.aemeasurable).aestronglyMeasurable
  have hS :
      (∫ x, martingaleEnergy M N x ^ (p / 2) ∂μ) = S ^ p := by
    have he (x : Ω) : martingaleEnergy M N x ^ (p / 2) = F x ^ p :=
      Real.rpow_div_two_eq_sqrt (r := p) (martingaleEnergy_nonneg M N x)
    simp only [he]
    exact integral_nonneg_rpow_eq_lpNorm_rpow hSm.aestronglyMeasurable
      (fun _ => Real.sqrt_nonneg _) hp0
  have hT : (∫ x, |M N x|^p ∂μ) = T ^ p := by
    rw [integral_nonneg_rpow_eq_lpNorm_rpow hTa (fun _ => abs_nonneg _) hp0,
      lpNorm_norm_eq_real hp0 hTm]
  have h := martingaleSquare_moments hM N hp
  dsimp only at h
  rw [hS, hT] at h
  have hroot (r s : ℝ) (hr : 0 ≤ r) (hs : 0 ≤ s) (hrs : r^p ≤ C * s^p) :
      r ≤ C^(1 / p) * s := by
    have he := Real.rpow_le_rpow (Real.rpow_nonneg hr _) hrs (by positivity : 0 ≤ 1 / p)
    rw [Real.mul_rpow hC (Real.rpow_nonneg hs _), one_div, Real.rpow_rpow_inv hr hp0.ne',
      Real.rpow_rpow_inv hs hp0.ne'] at he
    simpa only [one_div] using he
  exact ⟨hroot S T lpNorm_nonneg lpNorm_nonneg h.1,
    fun hz => hroot T S lpNorm_nonneg lpNorm_nonneg (h.2 hz)⟩

/-- The finite martingale transform with predictable coefficients. -/
noncomputable def finiteMartingaleTransform {Ω : Type*} (M c : ℕ → Ω → ℝ)
    (N : ℕ) (x : Ω) : ℝ :=
  ∑ k ∈ Finset.range N, c k x * martingaleDifference M k x

private theorem finiteMartingaleTransform_difference {Ω : Type*}
    (M c : ℕ → Ω → ℝ) (k : ℕ) :
    finiteMartingaleTransform M c (k + 1) - finiteMartingaleTransform M c k =
      c k * (M (k + 1) - M k) := by
  funext x
  change finiteMartingaleTransform M c (k + 1) x - finiteMartingaleTransform M c k x = _
  unfold finiteMartingaleTransform
  rw [Finset.sum_range_succ, add_sub_cancel_left]
  rfl

/-- A predictable transform of a martingale on a finite tree is a martingale. -/
theorem martingale_finiteMartingaleTransform {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M c : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    (hc : StronglyAdapted ℱ c) :
    Martingale (finiteMartingaleTransform M c) ℱ μ := by
  have had : StronglyAdapted ℱ (finiteMartingaleTransform M c) := by
    intro n
    unfold finiteMartingaleTransform
    refine (Finset.measurable_fun_sum _ fun k hk => ?_).stronglyMeasurable
    have hkn : k + 1 ≤ n := Finset.mem_range.mp hk
    exact ((hc k).mono (ℱ.mono (Nat.le_of_succ_le hkn))).measurable.mul
      (((hM.stronglyAdapted (k + 1)).mono (ℱ.mono hkn)).measurable.sub
        ((hM.stronglyAdapted k).mono (ℱ.mono (Nat.le_of_succ_le hkn))).measurable)
  refine martingale_of_condExp_sub_eq_zero_nat had (fun n =>
    integrable_of_measurable_finite ((had n).mono (ℱ.le n)).measurable) fun k => ?_
  rw [finiteMartingaleTransform_difference]
  let D := M (k + 1) - M k
  have hd : Integrable D μ := (hM.integrable _).sub (hM.integrable _)
  have hmul : Integrable (c k * D) μ := integrable_of_measurable_finite
    (((hc k).mono (ℱ.le k)).measurable.mul
      (((hM.stronglyAdapted _).mono (ℱ.le _)).measurable.sub
        ((hM.stronglyAdapted _).mono (ℱ.le _)).measurable))
  have hcD := condExp_mul_of_stronglyMeasurable_left (hc k) hmul hd
  have hzero := condExp_sub (m := ℱ k) (hM.integrable (k + 1)) (hM.integrable k)
  filter_upwards [hcD, hzero, hM.condExp_ae_eq (Nat.le_succ k),
    hM.condExp_ae_eq (le_refl k)] with x hx hDx hnext hnow
  change μ[c k * D | ℱ k] x = 0
  rw [hx]
  change μ[M (k + 1) | ℱ k] x = _ at hnext
  change μ[D | ℱ k] x = _ at hDx
  simp only [Pi.mul_apply, hDx, Pi.sub_apply, hnext, hnow, sub_self, mul_zero]

/-- Uniform (L^p) bound for a predictable transform on a finite tree. -/
theorem martTransform_finite {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M c : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    (hc : StronglyAdapted ℱ c) (hc1 : ∀ k x, |c k x| ≤ 1)
    (N : ℕ) {p : ℝ} (hp : 2 ≤ p) :
    lpNorm (finiteMartingaleTransform M c N) (ENNReal.ofReal p) μ ≤
      (martingaleSquareMomentConstant p ^ (1 / p))^2 * lpNorm (M N) (ENNReal.ofReal p) μ := by
  let Y := finiteMartingaleTransform M c
  let C := martingaleSquareMomentConstant p ^ (1 / p)
  let e := ENNReal.ofReal p
  have hY := martingale_finiteMartingaleTransform hM hc
  have hz : Y 0 = 0 := by funext x; exact Finset.sum_range_zero _
  have hC : 0 ≤ C := Real.rpow_nonneg (martingaleSquareMomentConstant_pos p).le _
  have hEY (k : ℕ) (x : Ω) : martingaleDifference Y k x = c k x * martingaleDifference M k x :=
    congrFun (finiteMartingaleTransform_difference M c k) x
  have hS (x : Ω) : martingaleSquareFunction Y N x ≤ martingaleSquareFunction M N x := by
    apply Real.sqrt_le_sqrt
    unfold martingaleEnergy
    refine Finset.sum_le_sum fun k _ => ?_
    rw [hEY, mul_pow]
    have hsq : c k x^2 ≤ 1 := by
      rw [← sq_abs]
      exact (pow_le_pow_left₀ (abs_nonneg _) (hc1 k x) 2).trans_eq (one_pow _)
    exact mul_le_of_le_one_left (sq_nonneg _) hsq
  have hm : Measurable (martingaleSquareFunction M N) := Real.continuous_sqrt.measurable.comp
    ((martingaleEnergy_adapted hM.stronglyAdapted N).mono (ℱ.le N)).measurable
  have hSlp := lpNorm_mono_real (memLp_of_measurable_finite (μ := μ) hm e)
    (f := martingaleSquareFunction Y N) (fun x => by
      rw [Real.norm_of_nonneg (show 0 ≤ martingaleSquareFunction Y N x from Real.sqrt_nonneg _)]
      exact hS x)
  calc
    _ ≤ C * lpNorm (martingaleSquareFunction Y N) e μ := (martSquare hY N hp).2 hz
    _ ≤ C * (C * lpNorm (M N) e μ) :=
      mul_le_mul_of_nonneg_left (hSlp.trans (martSquare hM N hp).1) hC
    _ = _ := by rw [pow_two, mul_assoc]

private theorem dyadicIndex_mono (k : ℤ) : Monotone (dyadicIndex k) := by
  intro x y hxy
  exact Int.floor_mono (div_le_div_of_nonneg_right hxy (zpow_nonneg (by norm_num) _))

private theorem dyadicIndex_eq_of_later_eq {j k : ℤ} (hjk : j ≤ k)
    {x y : ℝ} (hxy : dyadicIndex k x = dyadicIndex k y) :
    dyadicIndex j x = dyadicIndex j y := by
  have h1 : x ∈ dyadicInterval k (dyadicIndex k y) := mem_dyadicInterval_iff.mpr hxy
  have h2 : x ∈ dyadicInterval j (dyadicIndex j x) := mem_dyadicInterval_iff.mpr rfl
  have h3 : y ∈ dyadicInterval k (dyadicIndex k y) := mem_dyadicInterval_iff.mpr rfl
  exact (mem_dyadicInterval_iff.mp ((dyadicInterval_subset_of_mem hjk h1 h2) h3)).symm

private theorem dyadicAverage_eq_of_index_eq (k : ℤ) (f : ℝ → ℝ)
    {x y : ℝ} (hxy : dyadicIndex k x = dyadicIndex k y) :
    dyadicAverage k f x = dyadicAverage k f y := by
  simp only [dyadicAverage, hxy]

private theorem integral_dyadicAverage_succ_eq_on_ancestor_event
    {u k n : ℤ} (huk : u ≤ k) {B : Set ℤ} {f : ℝ → ℝ} (hf : Integrable f) :
    (∫ x in dyadicInterval u n ∩ dyadicIndex k ⁻¹' B, dyadicAverage (k + 1) f x) =
      ∫ x in dyadicInterval u n ∩ dyadicIndex k ⁻¹' B, dyadicAverage k f x := by
  let J := dyadicInterval u n ∩ dyadicIndex k ⁻¹' B
  let A (m : ℤ) := J ∩ dyadicInterval k m
  have hJ : MeasurableSet J := measurableSet_Ico.inter
    (measurable_dyadicIndex k (Set.to_countable B).measurableSet)
  have hA (m : ℤ) : MeasurableSet (A m) := hJ.inter measurableSet_Ico
  have hdis : Pairwise (Disjoint on A) := fun i j hij =>
    (pairwiseDisjoint_dyadicInterval k hij).mono inter_subset_right inter_subset_right
  have hU : (⋃ m, A m) = J := by
    change (⋃ m, J ∩ dyadicInterval k m) = J
    rw [← inter_iUnion, iUnion_dyadicInterval, inter_univ]
  have he (m : ℤ) : (∫ x in A m, dyadicAverage (k + 1) f x) =
      ∫ x in A m, dyadicAverage k f x := by
    by_cases h : (A m).Nonempty
    · obtain ⟨x, ⟨hxU, hxB⟩, hxK⟩ := h
      have hsub : dyadicInterval k m ⊆ J := by
        refine subset_inter (dyadicInterval_subset_of_mem huk hxK hxU) ?_
        intro y hy
        change dyadicIndex k y ∈ B
        change dyadicIndex k x ∈ B at hxB
        rw [mem_dyadicInterval_iff.mp hy, ← mem_dyadicInterval_iff.mp hxK]
        exact hxB
      change (∫ x in J ∩ dyadicInterval k m, dyadicAverage (k + 1) f x) =
        ∫ x in J ∩ dyadicInterval k m, dyadicAverage k f x
      rw [inter_eq_right.mpr hsub, integral_dyadicAverage_succ_cell k m hf.integrableOn,
        integral_dyadicAverage_cell]
    · rw [Set.not_nonempty_iff_eq_empty.mp h, setIntegral_empty, setIntegral_empty]
  change (∫ x in J, dyadicAverage (k + 1) f x) = ∫ x in J, dyadicAverage k f x
  rw [← hU, integral_iUnion (s := A) hA hdis (integrable_dyadicAverage _ hf).integrableOn,
    integral_iUnion (s := A) hA hdis (integrable_dyadicAverage _ hf).integrableOn]
  simp only [he]

/-- Coordinate-line transform over a finite range of consecutive levels. -/
noncomputable def dyadicTransform (u : ℤ) (c : ℕ → ℝ) (N : ℕ)
    (f : ℝ → ℝ) (x : ℝ) : ℝ :=
  ∑ k ∈ Finset.range N, c k * (dyadicAverage (u + k + 1) f x - dyadicAverage (u + k) f x)

private theorem with_dyadicTree (u j : ℤ) (N : ℕ) {f : ℝ → ℝ} (hf : Integrable f)
    {P : Prop} (useTree : ∀ (Ω : Type) [Finite Ω] [MeasurableSpace Ω] [MeasurableSingletonClass Ω]
      (μ : Measure Ω) [IsFiniteMeasure μ] (φ : dyadicInterval u j → Ω), Measurable φ →
      μ = Measure.map φ ((volume : Measure ℝ).comap Subtype.val) →
      ∀ (ℱ : Filtration ℕ (inferInstance : MeasurableSpace Ω)) (M : ℕ → Ω → ℝ),
      Martingale M ℱ μ →
      (∀ (k : ℕ) (x : dyadicInterval u j),
        M k (φ x) = dyadicAverage (u + (min k N : ℕ)) f x) → P) :
    P := by
  classical
  let J := dyadicInterval u j
  let v : ℤ := u + N
  let φ₀ (x : J) := dyadicIndex v x
  let Ω := Set.range φ₀
  have hfin : Ω.Finite := by
    let a := (j : ℝ) * (2 : ℝ) ^ (-u)
    let b := ((j : ℝ) + 1) * (2 : ℝ) ^ (-u)
    refine (Set.finite_Icc (dyadicIndex v a) (dyadicIndex v b)).subset ?_
    rintro z ⟨x, rfl⟩
    have hx : (x : ℝ) ∈ Ico a b := x.property
    exact ⟨dyadicIndex_mono v hx.1, dyadicIndex_mono v hx.2.le⟩
  let : Finite Ω := hfin.to_subtype
  let φ (x : J) : Ω := ⟨φ₀ x, Set.mem_range_self x⟩
  let r (y : Ω) : J := y.property.choose
  have hr (y : Ω) : φ₀ (r y) = y.val := y.property.choose_spec
  have hφ : Measurable φ := ((measurable_dyadicIndex v).comp measurable_subtype_coe).subtype_mk
  have hJ : MeasurableSet J := measurableSet_Ico
  let ν : Measure J := (volume : Measure ℝ).comap Subtype.val
  have hSub : MeasurePreserving (Subtype.val : J → ℝ) ν (volume.restrict J) :=
    measurePreserving_subtype_coe hJ
  let : IsFiniteMeasure ν := by
    let : IsFiniteMeasure ((volume : Measure ℝ).restrict J) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
    have : IsFiniteMeasure (ν.map (Subtype.val : J → ℝ)) := hSub.map_eq ▸ inferInstance
    exact Measure.isFiniteMeasure_of_map hSub.aemeasurable
  let μ : Measure Ω := Measure.map φ ν
  let : IsFiniteMeasure μ := Measure.isFiniteMeasure_map _ _
  let klevel (k : ℕ) : ℤ := u + (min k N : ℕ)
  have hkle (k : ℕ) : klevel k ≤ v := by
    dsimp [klevel, v]
    exact add_le_add le_rfl (by exact_mod_cast min_le_right k N)
  have hkmono : Monotone klevel := by
    intro a b hab
    dsimp [klevel]
    exact add_le_add le_rfl (by exact_mod_cast min_le_min_right N hab)
  let I (k : ℕ) (y : Ω) := dyadicIndex (klevel k) (r y)
  have hIφ (k : ℕ) (x : J) : I k (φ x) = dyadicIndex (klevel k) x :=
    dyadicIndex_eq_of_later_eq (hkle k) (hr (φ x))
  let ℱ : Filtration ℕ (inferInstance : MeasurableSpace Ω) := {
    seq := fun k => (inferInstance : MeasurableSpace ℤ).comap (I k)
    mono' := by
      intro a b hab
      apply MeasurableSpace.comap_le_comap_of_eq_comp
        (h := fun z : ℤ => dyadicIndex (klevel a) ((z : ℝ) * (2 : ℝ)^(-klevel b)))
        (measurable_of_countable _)
      funext y
      apply dyadicIndex_eq_of_later_eq (hkmono hab)
      have hz : ((I b y : ℤ) : ℝ) * (2 : ℝ)^(-klevel b) ∈ dyadicInterval (klevel b) (I b y) := by
        refine ⟨le_rfl, ?_⟩
        exact mul_lt_mul_of_pos_right (by linarith) (zpow_pos (by norm_num) _)
      exact (mem_dyadicInterval_iff.mp hz).symm
    le' := fun _ => (measurable_of_countable _).comap_le }
  let M (k : ℕ) (y : Ω) := dyadicAverage (klevel k) f (r y)
  have hMφ (k : ℕ) (x : J) : M k (φ x) = dyadicAverage (klevel k) f x :=
    dyadicAverage_eq_of_index_eq _ _ (hIφ k x)
  have hM : Martingale M ℱ μ := by
    apply martingale_of_setIntegral_eq_succ
    · intro k
      have hi : Measurable[ℱ k] (I k) := Measurable.of_comap_le le_rfl
      exact ((measurable_of_countable (fun z : ℤ =>
        ((2 : ℝ)^(-klevel k))⁻¹ * ∫ x in dyadicInterval (klevel k) z, f x)).comp hi).stronglyMeasurable
    · exact fun k => integrable_of_measurable_finite (measurable_of_countable _)
    · intro k s hs
      have hsm : MeasurableSet s := ℱ.le k _ hs
      rw [setIntegral_map hsm (measurable_of_countable (M k)).aestronglyMeasurable hφ.aemeasurable,
        setIntegral_map hsm (measurable_of_countable (M (k + 1))).aestronglyMeasurable hφ.aemeasurable]
      change MeasurableSet[(inferInstance : MeasurableSpace ℤ).comap (I k)] s at hs
      obtain ⟨B, hB, rfl⟩ := hs
      simp_rw [hMφ]
      have he : φ ⁻¹' (I k ⁻¹' B) = Subtype.val ⁻¹' (dyadicIndex (klevel k) ⁻¹' B) := by
        ext x
        simp only [mem_preimage, hIφ]
      rw [he]
      have hmB : MeasurableSet (dyadicIndex (klevel k) ⁻¹' B) := measurable_dyadicIndex _ hB
      have htransfer (g : ℝ → ℝ) :
          (∫ x in Subtype.val ⁻¹' (dyadicIndex (klevel k) ⁻¹' B), g (x : ℝ) ∂ν) =
            ∫ x in J ∩ dyadicIndex (klevel k) ⁻¹' B, g x := by
        rw [← (MeasurableEmbedding.subtype_coe hJ).setIntegral_map, hSub.map_eq,
          Measure.restrict_restrict hmB, inter_comm]
      rw [htransfer, htransfer]
      by_cases hkn : k < N
      · have hnext : klevel (k + 1) = klevel k + 1 := by
          simp only [klevel, min_eq_left hkn.le, min_eq_left (Nat.succ_le_of_lt hkn),
            Int.natCast_succ, add_assoc]
        rw [hnext]
        exact (integral_dyadicAverage_succ_eq_on_ancestor_event
          (u := u) (n := j) (le_add_of_nonneg_right (by positivity)) hf).symm
      · have hkn' : N ≤ k := Nat.le_of_not_gt hkn
        rw [show klevel (k + 1) = klevel k by
          simp only [klevel, min_eq_right hkn', min_eq_right (hkn'.trans (Nat.le_succ k))]]
  exact useTree Ω μ φ hφ rfl ℱ M hM hMφ

private theorem dyadicTransform_cell_moment_le
    (u j : ℤ) (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1) (N : ℕ)
    {f : ℝ → ℝ} (hf : Integrable f) {p : ℝ} (hp : 2 ≤ p) :
    (∫ x in dyadicInterval u j, |dyadicTransform u c N f x|^p) ≤
      ((martingaleSquareMomentConstant p ^ (1 / p))^2)^p *
        ∫ x in dyadicInterval u j, |dyadicAverage (u + N) f x|^p := by
  apply with_dyadicTree u j N hf
  intro Ω _ _ _ μ _ φ hφ hmap ℱ M hM hMφ
  let J := dyadicInterval u j
  let v : ℤ := u + N
  have hJ : MeasurableSet J := measurableSet_Ico
  let C (k : ℕ) (_ : Ω) := c k
  let Y := finiteMartingaleTransform M C N
  have hYφ (x : J) : Y (φ x) = dyadicTransform u c N f x := by
    unfold Y finiteMartingaleTransform dyadicTransform
    refine Finset.sum_congr rfl fun k hk => ?_
    have hkn := Finset.mem_range.mp hk
    simp only [C, martingaleDifference, hMφ, min_eq_left hkn.le,
      min_eq_left (Nat.succ_le_of_lt hkn),
      Int.natCast_succ, add_assoc]
  have hMNφ (x : J) : M N (φ x) = dyadicAverage v f x := by
    simp only [hMφ, v, min_self]
  have hC : StronglyAdapted ℱ C := fun k => stronglyMeasurable_const
  have htr := martTransform_finite hM hC (fun k _ => hc k) N hp
  have hp0 : 0 < p := by linarith
  have hpow := Real.rpow_le_rpow lpNorm_nonneg htr hp0.le
  rw [Real.mul_rpow (sq_nonneg _) lpNorm_nonneg] at hpow
  have hmoment (F : Ω → ℝ) :
      lpNorm F (ENNReal.ofReal p) μ ^ p = ∫ y, |F y|^p ∂μ := by
    have hFm : AEStronglyMeasurable F μ := (measurable_of_countable F).aestronglyMeasurable
    have ha : AEStronglyMeasurable (fun y => |F y|) μ :=
      (measurable_of_countable _).aestronglyMeasurable
    rw [integral_nonneg_rpow_eq_lpNorm_rpow ha (fun _ => abs_nonneg _) hp0,
      lpNorm_norm_eq_real hp0 hFm]
  change lpNorm Y (ENNReal.ofReal p) μ ^ p ≤ _ * lpNorm (M N) (ENNReal.ofReal p) μ ^ p at hpow
  rw [hmoment, hmoment] at hpow
  have hmY : AEStronglyMeasurable (fun y => |Y y|^p) μ :=
    (measurable_of_countable _).aestronglyMeasurable
  have hmM : AEStronglyMeasurable (fun y => |M N y|^p) μ :=
    (measurable_of_countable _).aestronglyMeasurable
  rw [hmap] at hpow hmY hmM
  rw [integral_map hφ.aemeasurable hmY, integral_map hφ.aemeasurable hmM] at hpow
  simp only [hYφ, hMNφ] at hpow
  rw [integral_subtype_comap hJ (fun x => |dyadicTransform u c N f x|^p),
    integral_subtype_comap hJ (fun x => |dyadicAverage v f x|^p)] at hpow
  exact hpow

private theorem dyadicAverage_indicator_eq {u k j : ℤ} (huk : u ≤ k)
    {f : ℝ → ℝ} {x : ℝ} (hx : x ∈ dyadicInterval u j) :
    dyadicAverage k ((dyadicInterval u j).indicator f) x = dyadicAverage k f x := by
  unfold dyadicAverage
  congr 1
  have hxk : x ∈ dyadicInterval k (dyadicIndex k x) := mem_dyadicInterval_iff.mpr rfl
  have hin := dyadicInterval_subset_of_mem huk hxk hx
  have hm : MeasurableSet (dyadicInterval k (dyadicIndex k x)) := measurableSet_Ico
  exact setIntegral_congr_fun hm (fun _ hy => indicator_of_mem (hin hy) _)

private theorem dyadicTransform_cell_moment_le_local
    (u j : ℤ) (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1) (N : ℕ)
    {f : ℝ → ℝ} (hf : IntegrableOn f (dyadicInterval u j)) {p : ℝ} (hp : 2 ≤ p) :
    (∫ x in dyadicInterval u j, |dyadicTransform u c N f x|^p) ≤
      ((martingaleSquareMomentConstant p ^ (1 / p))^2)^p *
        ∫ x in dyadicInterval u j, |dyadicAverage (u + N) f x|^p := by
  have hm : MeasurableSet (dyadicInterval u j) := measurableSet_Ico
  have hi := (integrable_indicator_iff hm).mpr hf
  have h := dyadicTransform_cell_moment_le u j c hc N hi hp
  have hterm (x : ℝ) (hx : x ∈ dyadicInterval u j) :
      dyadicTransform u c N ((dyadicInterval u j).indicator f) x = dyadicTransform u c N f x := by
    unfold dyadicTransform
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [dyadicAverage_indicator_eq (by omega) hx, dyadicAverage_indicator_eq (by omega) hx]
  have hl : (∫ x in dyadicInterval u j,
      |dyadicTransform u c N ((dyadicInterval u j).indicator f) x|^p) =
      ∫ x in dyadicInterval u j, |dyadicTransform u c N f x|^p :=
    setIntegral_congr_fun hm fun x hx => by rw [hterm x hx]
  have hr : (∫ x in dyadicInterval u j,
      |dyadicAverage (u + N) ((dyadicInterval u j).indicator f) x|^p) =
      ∫ x in dyadicInterval u j, |dyadicAverage (u + N) f x|^p :=
    setIntegral_congr_fun hm fun x hx => by
      rw [dyadicAverage_indicator_eq (le_add_of_nonneg_right (by positivity)) hx]
  rw [hl, hr] at h
  exact h

private theorem dyadicTransform_measurable (u : ℤ) (c : ℕ → ℝ) (N : ℕ)
    (f : ℝ → ℝ) : Measurable (dyadicTransform u c N f) :=
  Finset.measurable_fun_sum _ fun _ _ => measurable_const.mul
    ((measurable_dyadicAverage _ f).sub (measurable_dyadicAverage _ f))

private theorem lpNorm_two_or_more_finite {p : ℝ} (hp : 2 ≤ p) : 1 ≤ ENNReal.ofReal p := by
  have h : 1 ≤ p := by linarith
  simpa using ENNReal.ofReal_le_ofReal h

private theorem dyadicTransform_memLp_of_memLp (u : ℤ) (c : ℕ → ℝ) (N : ℕ)
    {f : ℝ → ℝ} {p : ℝ} (hp : 2 ≤ p) (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (dyadicTransform u c N f) (ENNReal.ofReal p) volume := by
  have h (k : ℤ) : MemLp (dyadicAverage k f) (ENNReal.ofReal p) volume :=
    (dyadicAverage_eLpNorm_le k (by linarith) hf).trans_lt hf.eLpNorm_lt_top
  exact memLp_finsetSum (Finset.range N) (fun k _ =>
    ((h (u + k + 1)).sub (h (u + k))).const_mul (c k))

/-- The one-dimensional transform bound, after summing the finite trees
over all initial dyadic cells. -/
theorem dyadicTransform_moment_le (u : ℤ) (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1)
    (N : ℕ) {f : ℝ → ℝ} {p : ℝ} (hp : 2 ≤ p)
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    (∫ x, |dyadicTransform u c N f x|^p) ≤
      ((martingaleSquareMomentConstant p ^ (1 / p))^2)^p *
        ∫ x, |dyadicAverage (u + N) f x|^p := by
  let Y := dyadicTransform u c N f
  let V := dyadicAverage (u + N) f
  let C := ((martingaleSquareMomentConstant p ^ (1 / p))^2)^p
  have hp0 : 0 < p := by linarith
  have hpz := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpt : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hLpY : MemLp Y (ENNReal.ofReal p) volume := dyadicTransform_memLp_of_memLp u c N hp hf
  have hLpV : MemLp V (ENNReal.ofReal p) volume :=
    (dyadicAverage_eLpNorm_le (u + N) (by linarith) hf).trans_lt hf.eLpNorm_lt_top
  have hIY : Integrable (fun x => |Y x|^p) := by
    simpa only [ENNReal.toReal_ofReal hp0.le, Real.norm_eq_abs] using
      hLpY.integrable_norm_rpow hpz hpt
  have hIV : Integrable (fun x => |V x|^p) := by
    simpa only [ENNReal.toReal_ofReal hp0.le, Real.norm_eq_abs] using
      hLpV.integrable_norm_rpow hpz hpt
  have hsplit {g : ℝ → ℝ} (hg : Integrable g) :
      HasSum (fun j => ∫ x in dyadicInterval u j, g x) (∫ x, g x) := by
    simpa only [iUnion_dyadicInterval, Measure.restrict_univ] using
      hasSum_integral_iUnion (s := dyadicInterval u)
        (fun _ => measurableSet_Ico) (pairwiseDisjoint_dyadicInterval u)
        (by simpa only [iUnion_dyadicInterval, integrableOn_univ] using hg)
  have hcell (j : ℤ) : IntegrableOn f (dyadicInterval u j) := by
    let : IsFiniteMeasure (volume.restrict (dyadicInterval u j)) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
    exact (hf.restrict _).integrable (lpNorm_two_or_more_finite hp)
  have hY := hsplit hIY
  have hV := (hsplit hIV).mul_left C
  rw [← hY.tsum_eq, ← hV.tsum_eq]
  exact hY.summable.tsum_le_tsum (fun j =>
    dyadicTransform_cell_moment_le_local u j c hc N (hcell j) hp) hV.summable

/-- Finite coordinate martingale transform in the product model. -/
noncomputable def coordinateTransform {d : ℕ} (i : Fin d) (u : ℤ)
    (c : ℕ → ℝ) (N : ℕ) (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ) : ℝ :=
  ∑ k ∈ Finset.range N, c k * coordinateDifference i (u + k) f x

/-- The directional transform bound of `bp:mart-transform`, uniform in
dimension, direction, initial level and number of levels. -/
theorem martTransform {d : ℕ} (i : Fin d) (u : ℤ) (c : ℕ → ℝ)
    (hc : ∀ k, |c k| ≤ 1) (N : ℕ) {p : ℝ} (hp : 2 ≤ p)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    lpNorm (coordinateTransform i u c N f) (ENNReal.ofReal p) volume ≤
      (martingaleSquareMomentConstant p ^ (1 / p))^2 * lpNorm f (ENNReal.ofReal p) volume := by
  let Y := coordinateTransform i u c N f
  let V := coordinateAverage i (u + N) f
  let C := (martingaleSquareMomentConstant p ^ (1 / p))^2
  have hC : 0 ≤ C := sq_nonneg _
  have hp0 : 0 < p := by linarith
  have hpz := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpt : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hcontr (k : ℤ) := coordinateAverage_eLpNorm_le i k (by linarith : 1 ≤ p) hm hf
  have hLp (k : ℤ) : MemLp (coordinateAverage i k f) (ENNReal.ofReal p) volume :=
    (hcontr k).trans_lt hf.eLpNorm_lt_top
  have hY : MemLp Y (ENNReal.ofReal p) volume :=
    memLp_finsetSum _ (fun k _ => ((hLp (u + k + 1)).sub (hLp (u + k))).const_mul (c k))
  have hV : MemLp V (ENNReal.ofReal p) volume := hLp (u + N)
  have hmoment : (∫ x, |Y x|^p) ≤ C^p * ∫ x, |V x|^p := by
    cases d with
    | zero => exact Fin.elim0 i
    | succ n =>
      let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm
      have he : MeasurePreserving e :=
        (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm _
      let g := f ∘ e
      have hg : Measurable g := hm.comp e.measurable
      have hpInt {F : (Fin (n + 1) → ℝ) → ℝ}
          (hF : MemLp F (ENNReal.ofReal p) volume) :
          Integrable (fun z => |F (e z)|^p)
            ((volume : Measure ℝ).prod (volume : Measure (Fin n → ℝ))) := by
        rw [← Measure.volume_eq_prod]
        simpa only [ENNReal.toReal_ofReal hp0.le, Real.norm_eq_abs, Function.comp_apply] using
          (hF.comp_measurePreserving he).integrable_norm_rpow hpz hpt
      have hIY := hpInt hY
      have hIV := hpInt hV
      have hIg := hpInt hf
      have hslice (j : ℤ) (x : ℝ) (y : Fin n → ℝ) :
          coordinateAverage i j f (e (x, y)) = dyadicAverage j (fun t => g (t, y)) x := by
        change coordinateAverage i j f (i.insertNth x y) =
          dyadicAverage j (fun t => f (i.insertNth t y)) x
        simp only [coordinateAverage_eq_dyadicAverage, Fin.insertNth_apply_same, Fin.update_insertNth]
      have hYs (x : ℝ) (y : Fin n → ℝ) :
          Y (e (x, y)) = dyadicTransform u c N (fun t => g (t, y)) x := by
        simp only [Y, coordinateTransform, coordinateDifference, dyadicTransform, hslice]
      simp_rw [← he.integral_comp']
      change (∫ z, |Y (e z)|^p) ≤ C^p * ∫ z, |V (e z)|^p
      rw [Measure.volume_eq_prod, integral_prod_symm _ hIY, integral_prod_symm _ hIV,
        ← integral_const_mul]
      apply integral_mono_ae hIY.integral_prod_right (hIV.integral_prod_right.const_mul _)
      filter_upwards [hIg.prod_left_ae] with y hy
      have hmy : Measurable (fun x => g (x, y)) := hg.comp (measurable_id.prodMk measurable_const)
      have hyLp : MemLp (fun x => g (x, y)) (ENNReal.ofReal p) volume := by
        apply (integrable_norm_rpow_iff hmy.aestronglyMeasurable hpz hpt).mp
        change Integrable (fun x : ℝ => |g (x, y)|^p) volume at hy
        simpa only [ENNReal.toReal_ofReal hp0.le, Real.norm_eq_abs] using hy
      dsimp only [V]
      simpa only [hYs, hslice] using dyadicTransform_moment_le u c hc N hp hyLp
  have hrew {F : (Fin d → ℝ) → ℝ} (hF : MemLp F (ENNReal.ofReal p) volume) :
      (∫ x, |F x|^p) = lpNorm F (ENNReal.ofReal p) volume ^ p := by
    have hFa : AEStronglyMeasurable (fun x => |F x|) volume :=
      (continuous_abs.measurable.comp_aemeasurable hF.aemeasurable).aestronglyMeasurable
    rw [integral_nonneg_rpow_eq_lpNorm_rpow hFa (fun _ => abs_nonneg _) hp0,
      lpNorm_norm_eq_real hp0 hF.aestronglyMeasurable]
  rw [hrew hY, hrew hV, ← Real.mul_rpow hC lpNorm_nonneg] at hmoment
  have hbound := (Real.rpow_le_rpow_iff lpNorm_nonneg (mul_nonneg hC lpNorm_nonneg) hp0).mp hmoment
  have hVf : lpNorm V (ENNReal.ofReal p) volume ≤ lpNorm f (ENNReal.ofReal p) volume :=
    ENNReal.toReal_mono hf.eLpNorm_lt_top.ne (hcontr (u + N))
  exact hbound.trans (mul_le_mul_of_nonneg_left hVf hC)

/-- Record the current value when it differs from the last record by at
least the threshold. With extinction enabled, also record a new zero. -/
noncomputable def recordedPath {Ω : Type*} (M : ℕ → Ω → ℝ)
    (threshold : ℝ) (extinction : Bool) : ℕ → Ω → ℝ
  | 0 => M 0
  | k + 1 => fun x => by
      classical
      exact if threshold ≤ |M (k + 1) x - recordedPath M threshold extinction k x| ∨
          (extinction = true ∧ M (k + 1) x = 0) then
        M (k + 1) x
      else recordedPath M threshold extinction k x

/-- The recorded path tracks the original path within the threshold. -/
theorem recordedPath_tracking {Ω : Type*} (M : ℕ → Ω → ℝ) {threshold : ℝ}
    (ht : 0 ≤ threshold) (extinction : Bool) (k : ℕ) (x : Ω) :
    |M k x - recordedPath M threshold extinction k x| ≤ threshold := by
  cases k with
  | zero => simpa only [recordedPath, sub_self, abs_zero] using ht
  | succ k =>
    dsimp only [recordedPath]
    split
    · simpa only [sub_self, abs_zero] using ht
    · rename_i h
      exact le_of_not_ge fun h' => h (Or.inl h')

/-- If all input values lie in an interval, all records lie there as well. -/
theorem recordedPath_mem_Icc {Ω : Type*} (M : ℕ → Ω → ℝ) (threshold : ℝ)
    (extinction : Bool) {a b : ℝ} (hM : ∀ k x, M k x ∈ Icc a b) (k : ℕ) (x : Ω) :
    recordedPath M threshold extinction k x ∈ Icc a b := by
  induction k with
  | zero => exact hM 0 x
  | succ k ih =>
    dsimp only [recordedPath]
    split
    · exact hM (k + 1) x
    · exact ih

/-- With the extinction rule, the record is zero whenever the input is zero. -/
theorem recordedPath_zero {Ω : Type*} {M : ℕ → Ω → ℝ} {threshold : ℝ}
    {k : ℕ} {x : Ω} (hx : M k x = 0) : recordedPath M threshold true k x = 0 := by
  cases k with
  | zero => exact hx
  | succ k =>
    dsimp only [recordedPath]
    rw [ite_eq_left (Or.inr ⟨rfl, hx⟩)]
    exact hx

/-- The recording rule uses only information available at the recording time. -/
theorem stronglyAdapted_recordedPath {Ω : Type*} {m : MeasurableSpace Ω}
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ}
    (hM : StronglyAdapted ℱ M) (threshold : ℝ) (extinction : Bool) :
    StronglyAdapted ℱ (recordedPath M threshold extinction) := by
  intro n
  induction n with
  | zero => exact hM 0
  | succ k ih =>
    let P := recordedPath M threshold extinction k
    let E := {x | threshold ≤ |M (k + 1) x - P x| ∨
      (extinction = true ∧ M (k + 1) x = 0)}
    have hP : Measurable[ℱ (k + 1)] P := (ih.mono (ℱ.mono (Nat.le_succ k))).measurable
    have hN : Measurable[ℱ (k + 1)] (M (k + 1)) := (hM (k + 1)).measurable
    have hE : MeasurableSet[ℱ (k + 1)] E := by
      change MeasurableSet[ℱ (k + 1)] ({x | threshold ≤ |M (k + 1) x - P x|} ∪
        ({_x : Ω | extinction = true} ∩ {x | M (k + 1) x = 0}))
      exact (measurableSet_le measurable_const
        (continuous_abs.measurable.comp (hN.sub hP))).union
        ((MeasurableSet.const _).inter (measurableSet_eq_fun hN measurable_const))
    classical
    have he : recordedPath M threshold extinction (k + 1) = E.piecewise (M (k + 1)) P := rfl
    rw [he]
    exact (hN.piecewise hE hP).stronglyMeasurable

/-- Total variation of a finite real path through time `N`. -/
noncomputable def pathVariation {Ω : Type*} (Z : ℕ → Ω → ℝ) (N : ℕ) (x : Ω) : ℝ :=
  ∑ k ∈ Finset.range N, |martingaleDifference Z k x|

/-- The deterministic variation bound for threshold recordings. A short
reset is paid for by the drop in the absolute recorded amplitude. -/
theorem threshold_mul_recordedVariation_le {Ω : Type*} (M : ℕ → Ω → ℝ)
    {threshold : ℝ} (ht : 0 ≤ threshold) (extinction : Bool) (N : ℕ) (x : Ω) :
    threshold * pathVariation (recordedPath M threshold extinction) N x ≤
      2 * martingaleEnergy (recordedPath M threshold extinction) N x + threshold * |M 0 x| := by
  let Z := recordedPath M threshold extinction
  have hstep (k : ℕ) :
      threshold * |Z (k + 1) x - Z k x| +
        threshold * (|Z (k + 1) x| - |Z k x|) ≤ 2 * (Z (k + 1) x - Z k x)^2 := by
    classical
    by_cases hreg : threshold ≤ |M (k + 1) x - Z k x|
    · have hz : Z (k + 1) x = M (k + 1) x := by
        dsimp only [Z, recordedPath]
        exact ite_eq_left (Or.inl hreg)
      have hlarge : threshold ≤ |Z (k + 1) x - Z k x| := hz ▸ hreg
      have htri : |Z (k + 1) x| - |Z k x| ≤ |Z (k + 1) x - Z k x| := by
        have h := abs_add_le (Z (k + 1) x - Z k x) (Z k x)
        rw [sub_add_cancel] at h
        linarith
      have ha := mul_le_mul_of_nonneg_left htri ht
      have hb := mul_le_mul_of_nonneg_right hlarge (abs_nonneg (Z (k + 1) x - Z k x))
      rw [← pow_two, sq_abs] at hb
      linarith
    · by_cases he : extinction = true ∧ M (k + 1) x = 0
      · have hz : Z (k + 1) x = 0 := by
          dsimp only [Z, recordedPath]
          rw [ite_eq_left (Or.inr he), he.2]
        rw [hz, zero_sub, abs_neg, abs_zero, zero_sub]
        linarith [sq_nonneg (Z k x)]
      · have hz : Z (k + 1) x = Z k x := by
          dsimp only [Z, recordedPath]
          exact ite_eq_right (not_or.mpr ⟨hreg, he⟩)
        simp only [hz, sub_self, abs_zero, mul_zero, add_zero, zero_pow (by decide : (2 : ℕ) ≠ 0)]
        exact le_rfl
  have h := Finset.sum_le_sum (s := Finset.range N) (fun k _ => hstep k)
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum,
    Finset.sum_range_sub (fun k => |Z k x|)] at h
  change threshold * pathVariation Z N x + threshold * (|Z N x| - |Z 0 x|) ≤
    2 * martingaleEnergy Z N x at h
  have hz0 : Z 0 x = M 0 x := rfl
  rw [hz0] at h
  have hn := mul_nonneg ht (abs_nonneg (Z N x))
  linarith

/-- Number of changes in the held path up to the given time. -/
noncomputable def recordingCount {Ω : Type*} (Z : ℕ → Ω → ℝ) (k : ℕ) (x : Ω) : ℕ := by
  classical
  exact ∑ j ∈ Finset.range k, if Z (j + 1) x = Z j x then 0 else 1

private theorem recordingCount_succ {Ω : Type*} (Z : ℕ → Ω → ℝ) (k : ℕ) (x : Ω) :
    recordingCount Z (k + 1) x = recordingCount Z k x +
      (if Z (k + 1) x = Z k x then 0 else 1) := by
  classical
  exact Finset.sum_range_succ _ _

private theorem recordingCount_mono {Ω : Type*} (Z : ℕ → Ω → ℝ) (x : Ω) :
    Monotone (fun k => recordingCount Z k x) := by
  apply monotone_nat_of_le_succ
  intro k
  rw [recordingCount_succ]
  exact Nat.le_add_right _ _

private theorem recordingCount_le {Ω : Type*} (Z : ℕ → Ω → ℝ) (k : ℕ) (x : Ω) :
    recordingCount Z k x ≤ k := by
  induction k with
  | zero => simp [recordingCount]
  | succ k ih =>
    rw [recordingCount_succ]
    split <;> omega

private theorem recordingCount_eq_imp_record_eq {Ω : Type*} (Z : ℕ → Ω → ℝ) (x : Ω)
    {j k : ℕ} (hjk : j ≤ k) (he : recordingCount Z j x = recordingCount Z k x) :
    Z j x = Z k x := by
  induction k, hjk using Nat.le_induction with
  | base => rfl
  | succ k hk ih =>
    have hmid : recordingCount Z k x = recordingCount Z j x :=
      le_antisymm ((recordingCount_mono Z x (Nat.le_succ k)).trans_eq he.symm)
        (recordingCount_mono Z x hk)
    have hstep : Z (k + 1) x = Z k x := by
      by_contra h
      rw [recordingCount_succ, ite_eq_right h, hmid] at he
      omega
    rw [hstep]
    exact ih hmid.symm

private theorem adapted_recordingCount {Ω : Type*} {m : MeasurableSpace Ω}
    {ℱ : Filtration ℕ m} {Z : ℕ → Ω → ℝ} (hz : StronglyAdapted ℱ Z) :
    Adapted ℱ (recordingCount Z) := by
  intro k
  unfold recordingCount
  apply Finset.measurable_fun_sum
  intro j hj
  have hjk : j + 1 ≤ k := Finset.mem_range.mp hj
  exact measurable_const.ite
    (measurableSet_eq_fun ((hz (j + 1)).mono (ℱ.mono hjk)).measurable
      ((hz j).mono (ℱ.mono (Nat.le_of_succ_le hjk))).measurable) measurable_const

/-- The time of the (j)-th change, with time zero as the initial sample
and the terminal time used to pad the list. -/
noncomputable def recordingTime {Ω : Type*} (Z : ℕ → Ω → ℝ)
    (N j : ℕ) (x : Ω) : ℕ :=
  hittingBtwn (recordingCount Z) (Ici j) 0 N x

private theorem recordingTime_le {Ω : Type*} (Z : ℕ → Ω → ℝ) (N j : ℕ) (x : Ω) :
    recordingTime Z N j x ≤ N := hittingBtwn_le x

private theorem recordingTime_le_of_le_count {Ω : Type*} (Z : ℕ → Ω → ℝ)
    {N k j : ℕ} {x : Ω} (hk : k ≤ N) (hj : j ≤ recordingCount Z k x) :
    recordingTime Z N j x ≤ k := hittingBtwn_le_of_mem (Nat.zero_le _) hk hj

private theorem le_count_at_recordingTime {Ω : Type*} (Z : ℕ → Ω → ℝ)
    {N j : ℕ} {x : Ω} (hj : j ≤ recordingCount Z N x) :
    j ≤ recordingCount Z (recordingTime Z N j x) x :=
  hittingBtwn_mem_set ⟨N, ⟨Nat.zero_le _, le_rfl⟩, hj⟩

/-- The sampled times used for threshold recordings are bounded stopping times. -/
theorem isStoppingTime_recordingTime {Ω : Type*} {m : MeasurableSpace Ω}
    {ℱ : Filtration ℕ m} {Z : ℕ → Ω → ℝ} (hz : StronglyAdapted ℱ Z) (N j : ℕ) :
    IsStoppingTime ℱ (fun x => (recordingTime Z N j x : WithTop ℕ)) :=
  (adapted_recordingCount hz).isStoppingTime_hittingBtwn measurableSet_Ici

private theorem recordingTime_mono {Ω : Type*} (Z : ℕ → Ω → ℝ) (N : ℕ) (x : Ω) :
    Monotone (fun j => recordingTime Z N j x) := by
  intro i j hij
  by_contra! h
  have hlt : recordingTime Z N j x < N := h.trans_le (recordingTime_le Z N i x)
  have hj : j ≤ recordingCount Z (recordingTime Z N j x) x :=
    hittingBtwn_mem_set_of_hittingBtwn_lt hlt
  exact (not_le_of_gt h) (recordingTime_le_of_le_count Z hlt.le (hij.trans hj))

private theorem count_at_recordingTime {Ω : Type*} (Z : ℕ → Ω → ℝ)
    {N j : ℕ} {x : Ω} (hj : j ≤ recordingCount Z N x) :
    recordingCount Z (recordingTime Z N j x) x = j := by
  have hreach := le_count_at_recordingTime Z hj
  have hle := recordingTime_le Z N j x
  generalize he : recordingTime Z N j x = k at hreach hle ⊢
  cases k with
  | zero => simpa only [recordingCount, Finset.sum_range_zero] using (le_antisymm hreach (Nat.zero_le j)).symm
  | succ k =>
    have hprev : recordingCount Z k x < j := by
      by_contra! h
      have hl := recordingTime_le_of_le_count Z ((Nat.le_succ k).trans hle) h
      omega
    have hstep := recordingCount_succ Z k x
    classical
    split at hstep <;> omega

private theorem recordedPath_eq_input_at_change {Ω : Type*} (M : ℕ → Ω → ℝ)
    (threshold : ℝ) (extinction : Bool) {k : ℕ} {x : Ω}
    (h : recordedPath M threshold extinction (k + 1) x ≠
      recordedPath M threshold extinction k x) :
    recordedPath M threshold extinction (k + 1) x = M (k + 1) x := by
  dsimp only [recordedPath] at h ⊢
  split
  · rfl
  · rename_i hn
    exact False.elim (h (ite_eq_right hn))

private theorem recordedPath_eq_input_at_recordingTime {Ω : Type*} (M : ℕ → Ω → ℝ)
    (threshold : ℝ) (extinction : Bool) {N j : ℕ} {x : Ω}
    (hj : j ≤ recordingCount (recordedPath M threshold extinction) N x) :
    let Z := recordedPath M threshold extinction
    Z (recordingTime Z N j x) x = M (recordingTime Z N j x) x := by
  let Z := recordedPath M threshold extinction
  have hcount := count_at_recordingTime Z hj
  have hle := recordingTime_le Z N j x
  change Z (recordingTime Z N j x) x = M (recordingTime Z N j x) x
  generalize he : recordingTime Z N j x = k at hcount hle ⊢
  cases k with
  | zero => rfl
  | succ k =>
    apply recordedPath_eq_input_at_change
    intro hno
    rw [recordingCount_succ, ite_eq_left hno, add_zero] at hcount
    have hb := recordingTime_le_of_le_count Z ((Nat.le_succ k).trans hle) hcount.ge
    omega

private theorem recordingTime_of_change {Ω : Type*} (Z : ℕ → Ω → ℝ)
    {N k : ℕ} {x : Ω} (hk : k < N) (h : Z (k + 1) x ≠ Z k x) :
    recordingTime Z N (recordingCount Z k x + 1) x = k + 1 := by
  classical
  have hn : recordingCount Z (k + 1) x = recordingCount Z k x + 1 := by
    rw [recordingCount_succ, ite_eq_right h]
  have hr := recordingTime_le_of_le_count Z (Nat.succ_le_of_lt hk) hn.ge
  have hle := (hn.symm.le.trans (recordingCount_mono Z x (Nat.succ_le_of_lt hk)))
  have hl := le_count_at_recordingTime Z hle
  by_contra hn'
  have hh : recordingTime Z N (recordingCount Z k x + 1) x ≤ k := by omega
  have hm := recordingCount_mono Z x hh
  change recordingCount Z (recordingTime Z N (recordingCount Z k x + 1) x) x ≤
    recordingCount Z k x at hm
  omega

/-- The squared recorded jumps are bounded by the square function of the
martingale sampled at its successive recording times. -/
theorem recordedEnergy_le_sampledEnergy {Ω : Type*} (M : ℕ → Ω → ℝ)
    (threshold : ℝ) (extinction : Bool) (N : ℕ) (x : Ω) :
    let Z := recordedPath M threshold extinction
    let X (j : ℕ) := stoppedValue M (fun y => (recordingTime Z N j y : WithTop ℕ))
    martingaleEnergy Z N x ≤ martingaleEnergy X N x := by
  classical
  dsimp only
  let Z := recordedPath M threshold extinction
  let X (j : ℕ) := stoppedValue M (fun y => (recordingTime Z N j y : WithTop ℕ))
  let K := (Finset.range N).filter (fun k => Z (k + 1) x ≠ Z k x)
  let C (k : ℕ) := recordingCount Z k x
  have hK (k : ℕ) (hk : k ∈ K) : k < N ∧ Z (k + 1) x ≠ Z k x :=
    ⟨Finset.mem_range.mp (Finset.mem_filter.mp hk).1, (Finset.mem_filter.mp hk).2⟩
  have hCinc (k : ℕ) (hk : k ∈ K) : C (k + 1) = C k + 1 := by
    change recordingCount Z (k + 1) x = _
    rw [recordingCount_succ, ite_eq_right (hK k hk).2]
  have hCinj : Set.InjOn C ↑K := by
    intro i hi j hj he
    rcases lt_trichotomy i j with h | h | h
    · have hh : C (i + 1) ≤ C j := recordingCount_mono Z x (Nat.succ_le_of_lt h)
      rw [hCinc i hi, he] at hh
      omega
    · exact h
    · have hh : C (j + 1) ≤ C i := recordingCount_mono Z x (Nat.succ_le_of_lt h)
      rw [hCinc j hj, ← he] at hh
      omega
  have hsub : K.image C ⊆ Finset.range N := by
    intro j hj
    obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp hj
    exact Finset.mem_range.mpr ((recordingCount_le Z k x).trans_lt (hK k hk).1)
  have heq (k : ℕ) (hk : k ∈ K) :
      martingaleDifference X (C k) x = martingaleDifference Z k x := by
    have ht := recordingTime_of_change Z (hK k hk).1 (hK k hk).2
    have hreach : C k ≤ recordingCount Z N x := recordingCount_mono Z x (hK k hk).1.le
    have hl := recordingTime_le_of_le_count Z (hK k hk).1.le (show C k ≤ recordingCount Z k x from le_rfl)
    have he := count_at_recordingTime Z hreach
    have hz := recordingCount_eq_imp_record_eq Z x hl he
    have hx : Z (recordingTime Z N (C k) x) x = M (recordingTime Z N (C k) x) x :=
      recordedPath_eq_input_at_recordingTime M threshold extinction hreach
    have hnext : Z (k + 1) x = M (k + 1) x :=
      recordedPath_eq_input_at_change M threshold extinction (hK k hk).2
    change M (recordingTime Z N (C k + 1) x) x - M (recordingTime Z N (C k) x) x =
      Z (k + 1) x - Z k x
    rw [show recordingTime Z N (C k + 1) x = k + 1 from ht, ← hx, hz, hnext]
  change martingaleEnergy Z N x ≤ martingaleEnergy X N x
  unfold martingaleEnergy
  calc
    _ = ∑ k ∈ K, martingaleDifference Z k x ^ 2 := by
      unfold K
      rw [Finset.sum_filter]
      refine Finset.sum_congr rfl fun k _ => ?_
      split
      · rfl
      · rename_i h
        simp only [not_not.mp h, martingaleDifference, sub_self, zero_pow (by decide : (2 : ℕ) ≠ 0)]
    _ = ∑ k ∈ K, martingaleDifference X (C k) x ^ 2 := by
      exact Finset.sum_congr rfl fun k hk => by rw [heq k hk]
    _ = ∑ j ∈ K.image C, martingaleDifference X j x ^ 2 := by
      rw [Finset.sum_image hCinj]
    _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => sq_nonneg _

private theorem recordingTime_terminal {Ω : Type*} (Z : ℕ → Ω → ℝ) (N : ℕ) (x : Ω) :
    recordingTime Z N N x = N := by
  apply le_antisymm (recordingTime_le Z N N x)
  by_contra! h
  have hn : N ≤ recordingCount Z (recordingTime Z N N x) x :=
    hittingBtwn_mem_set_of_hittingBtwn_lt h
  exact (not_le_of_gt h) (hn.trans (recordingCount_le Z _ x))

private theorem recordedPath_measurable_energy {Ω : Type*} {m : MeasurableSpace Ω}
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : StronglyAdapted ℱ M)
    (threshold : ℝ) (extinction : Bool) (N : ℕ) :
    Measurable (martingaleEnergy (recordedPath M threshold extinction) N) :=
  ((martingaleEnergy_adapted (stronglyAdapted_recordedPath hM threshold extinction) N).mono
    (ℱ.le N)).measurable

/-- Recorded square energy in (L^q), uniformly in the recording threshold
and the number of time steps, on a finite probability tree. -/
theorem stoppedVar_energy_finite {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    (threshold : ℝ) (extinction : Bool) (N : ℕ) {q : ℝ} (hq : 1 ≤ q) :
    lpNorm (martingaleEnergy (recordedPath M threshold extinction) N) (ENNReal.ofReal q) μ ≤
      martingaleSquareMomentConstant (2 * q) ^ (1 / q) *
        (lpNorm (M N) (ENNReal.ofReal (2 * q)) μ)^2 := by
  let Z := recordedPath M threshold extinction
  let τ (j : ℕ) (x : Ω) : WithTop ℕ := recordingTime Z N j x
  let X (j : ℕ) := stoppedValue M (τ j)
  let E := martingaleEnergy Z N
  let F := martingaleEnergy X N
  let C := martingaleSquareMomentConstant (2 * q)
  have hq0 : 0 < q := by linarith
  have hC : 0 ≤ C := (martingaleSquareMomentConstant_pos _).le
  have hτ (j : ℕ) : IsStoppingTime ℱ (τ j) :=
    isStoppingTime_recordingTime (stronglyAdapted_recordedPath hM.stronglyAdapted _ _) N j
  have hmono : Monotone τ := fun i j hij x => by
    change (recordingTime Z N i x : WithTop ℕ) ≤ (recordingTime Z N j x : WithTop ℕ)
    exact_mod_cast recordingTime_mono Z N x hij
  have hτN (j : ℕ) (x : Ω) : τ j x ≤ N := by
    change (recordingTime Z N j x : WithTop ℕ) ≤ (N : WithTop ℕ)
    exact_mod_cast recordingTime_le Z N j x
  have hX : Martingale X (samplingFiltration hτ hmono) μ :=
    martingale_stoppedValue_family hM hτ hmono hτN
  have hterm : X N = M N := by
    funext x
    change M (recordingTime Z N N x) x = M N x
    rw [recordingTime_terminal]
  have hEF (x : Ω) : E x ≤ F x := recordedEnergy_le_sampledEnergy M threshold extinction N x
  have hEm : Measurable E := recordedPath_measurable_energy hM.stronglyAdapted _ _ _
  have hFm : Measurable F := ((martingaleEnergy_adapted hX.stronglyAdapted N).mono
    ((samplingFiltration hτ hmono).le N)).measurable
  have h0 (x : Ω) : 0 ≤ E x := martingaleEnergy_nonneg Z N x
  have hmoment : (∫ x, E x ^ q ∂μ) ≤ C * ∫ x, |M N x|^(2 * q) ∂μ := by
    have h := (martingaleSquare_moments hX N (p := 2 * q) (by linarith)).1
    change (∫ x, F x ^ ((2 * q) / 2) ∂μ) ≤ C * ∫ x, |X N x|^(2 * q) ∂μ at h
    rw [hterm, show 2 * q / 2 = q by ring] at h
    exact (integral_mono (integrable_of_measurable_finite (hEm.pow_const _))
      (integrable_of_measurable_finite (hFm.pow_const _)) (fun x =>
        Real.rpow_le_rpow (h0 x) (hEF x) hq0.le)).trans h
  have hMN : AEStronglyMeasurable (M N) μ :=
    ((hM.stronglyAdapted N).mono (ℱ.le N)).aestronglyMeasurable
  have habs : AEStronglyMeasurable (fun x => |M N x|) μ :=
    (continuous_abs.measurable.comp_aemeasurable hMN.aemeasurable).aestronglyMeasurable
  rw [integral_nonneg_rpow_eq_lpNorm_rpow hEm.aestronglyMeasurable h0 hq0,
    integral_nonneg_rpow_eq_lpNorm_rpow habs (fun _ => abs_nonneg _) (by linarith : 0 < 2 * q),
    lpNorm_norm_eq_real (by linarith : 0 < 2 * q) hMN] at hmoment
  have he := Real.rpow_le_rpow (Real.rpow_nonneg lpNorm_nonneg _) hmoment
    (show 0 ≤ 1 / q by positivity)
  rw [Real.mul_rpow hC (Real.rpow_nonneg lpNorm_nonneg _), one_div,
    Real.rpow_rpow_inv lpNorm_nonneg hq0.ne', ← Real.rpow_mul lpNorm_nonneg,
    show (2 * q) * q⁻¹ = 2 by field_simp, Real.rpow_two] at he
  simpa only [one_div] using he

/-- The variation estimate on a finite tree, expressed in terms of the
terminal (2q)-moment and the initial (q)-moment. -/
theorem stoppedVar_finite {Ω : Type*} [Finite Ω]
    {m : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ m} {M : ℕ → Ω → ℝ} (hM : Martingale M ℱ μ)
    {threshold : ℝ} (ht : 0 ≤ threshold) (extinction : Bool) (N : ℕ) {q : ℝ} (hq : 1 ≤ q) :
    lpNorm (fun x => threshold *
      pathVariation (recordedPath M threshold extinction) N x) (ENNReal.ofReal q) μ ≤
      2 * (martingaleSquareMomentConstant (2 * q) ^ (1 / q) *
        (lpNorm (M N) (ENNReal.ofReal (2 * q)) μ)^2) +
        threshold * lpNorm (M 0) (ENNReal.ofReal q) μ := by
  let Z := recordedPath M threshold extinction
  let E := martingaleEnergy Z N
  let A (x : Ω) := 2 * E x
  let B (x : Ω) := threshold * |M 0 x|
  let p := ENNReal.ofReal q
  have hEm : Measurable E := recordedPath_measurable_energy hM.stronglyAdapted _ _ _
  have h0m : Measurable (fun x => |M 0 x|) :=
    continuous_abs.measurable.comp ((hM.stronglyAdapted 0).mono (ℱ.le 0)).measurable
  have hAm : Measurable A := measurable_const.mul hEm
  have hBm : Measurable B := measurable_const.mul h0m
  have hA : MemLp A p μ := memLp_of_measurable_finite hAm _
  have hB : MemLp B p μ := memLp_of_measurable_finite hBm _
  have hle := lpNorm_mono_real (hA.add hB)
    (f := fun x => threshold * pathVariation Z N x) (fun x => by
      have hpos : 0 ≤ pathVariation Z N x := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
      rw [Real.norm_of_nonneg (mul_nonneg ht hpos)]
      exact threshold_mul_recordedVariation_le M ht extinction N x)
  have hnormA : lpNorm A p μ = 2 * lpNorm E p μ := by
    simpa only [A, Nat.cast_ofNat] using lpNorm_fun_natCast_mul 2 E p μ
  have hnormB : lpNorm B p μ = threshold * lpNorm (M 0) p μ := by
    have he := lpNorm_const_smul (p := p) threshold (fun x => |M 0 x|) μ
    rw [coe_nnnorm, Real.norm_of_nonneg ht, lpNorm_norm_eq_real (by linarith : 0 < q)
      ((hM.stronglyAdapted 0).mono (ℱ.le 0)).aestronglyMeasurable] at he
    exact he
  have hp : 1 ≤ p := by simpa only [p, ENNReal.ofReal_one] using ENNReal.ofReal_le_ofReal hq
  have htri := lpNorm_add_le hA (g := B) hp
  rw [hnormA, hnormB] at htri
  exact hle.trans (htri.trans (add_le_add
    (mul_le_mul_of_nonneg_left (stoppedVar_energy_finite hM threshold extinction N hq) (by norm_num))
    le_rfl))

private theorem recordedPath_congr_up_to {Ω Ξ : Type*}
    {M : ℕ → Ω → ℝ} {P : ℕ → Ξ → ℝ} {x : Ω} {y : Ξ}
    (threshold : ℝ) (extinction : Bool) (N : ℕ)
    (h : ∀ k ≤ N, M k x = P k y) : ∀ k ≤ N,
    recordedPath M threshold extinction k x = recordedPath P threshold extinction k y := by
  intro k
  induction k with
  | zero => exact h 0
  | succ k ih =>
    intro hk
    dsimp only [recordedPath]
    rw [h _ hk, ih ((Nat.le_succ k).trans hk)]

/-- A dyadic martingale path initialized with a multiple of its initial
average, with each subsequent increment multiplied by the given coefficient. -/
noncomputable def dyadicMartingalePath (u : ℤ) (β : ℝ) (c : ℕ → ℝ)
    (f : ℝ → ℝ) (k : ℕ) (x : ℝ) : ℝ :=
  β * dyadicAverage u f x + dyadicTransform u c k f x

private theorem dyadicMartingalePath_recordedEnergy_cell_le
    (u j : ℤ) (β : ℝ) (c : ℕ → ℝ) (N : ℕ)
    {f : ℝ → ℝ} (hf : Integrable f) (threshold : ℝ) (extinction : Bool)
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ x in dyadicInterval u j, ENNReal.ofReal
      (martingaleEnergy (recordedPath (dyadicMartingalePath u β c f) threshold extinction) N x ^ q)) ≤
      ENNReal.ofReal (martingaleSquareMomentConstant (2 * q)) *
        ∫⁻ x in dyadicInterval u j, ENNReal.ofReal (|dyadicMartingalePath u β c f N x|^(2 * q)) := by
  apply with_dyadicTree u j N hf
  intro Ω _ _ _ μ _ φ hφ hmap ℱ M hM hMφ
  let J := dyadicInterval u j
  let ν : Measure J := (volume : Measure ℝ).comap Subtype.val
  have hJ : MeasurableSet J := measurableSet_Ico
  let P := dyadicMartingalePath u β c f
  let Y (k : ℕ) (y : Ω) := β * M 0 y + finiteMartingaleTransform M (fun j _ => c j) k y
  have hY : Martingale Y ℱ μ := by
    have h0 : Martingale (fun _ : ℕ => M 0) ℱ μ :=
      martingale_const_fun ℱ μ (hM.stronglyAdapted 0) (hM.integrable 0)
    exact (h0.smul β).add (martingale_finiteMartingaleTransform hM fun _ => stronglyMeasurable_const)
  have hYφ (k : ℕ) (hk : k ≤ N) (x : J) : Y k (φ x) = P k x := by
    unfold Y P dyadicMartingalePath dyadicTransform finiteMartingaleTransform
    rw [hMφ, Nat.zero_min, Nat.cast_zero, add_zero]
    congr 1
    apply Finset.sum_congr rfl
    intro l hl
    have hlt := Finset.mem_range.mp hl
    have hlN : l + 1 ≤ N := (Nat.succ_le_of_lt hlt).trans hk
    simp only [martingaleDifference, hMφ, min_eq_left hlN, min_eq_left ((Nat.le_succ l).trans hlN),
      Nat.cast_add, Nat.cast_one, add_assoc]
  let E := martingaleEnergy (recordedPath Y threshold extinction) N
  let e := martingaleEnergy (recordedPath P threshold extinction) N
  let C := martingaleSquareMomentConstant (2 * q)
  have hC : 0 ≤ C := (martingaleSquareMomentConstant_pos _).le
  have hq0 : 0 < q := by linarith
  have hEφ (x : J) : E (φ x) = e x := by
    unfold E e martingaleEnergy martingaleDifference
    refine Finset.sum_congr rfl fun k hk => ?_
    have hlt := Finset.mem_range.mp hk
    have hr := recordedPath_congr_up_to threshold extinction N (fun l hl => hYφ l hl x)
    rw [hr (k + 1) (Nat.succ_le_of_lt hlt), hr k hlt.le]
  have hEm : AEStronglyMeasurable E μ := (measurable_of_countable E).aestronglyMeasurable
  have hYm : AEStronglyMeasurable (fun y => |Y N y|) μ :=
    (measurable_of_countable _).aestronglyMeasurable
  have hYa : AEStronglyMeasurable (Y N) μ := (measurable_of_countable _).aestronglyMeasurable
  have hn := stoppedVar_energy_finite hY threshold extinction N hq
  change lpNorm E (ENNReal.ofReal q) μ ≤ C^(1 / q) * (lpNorm (Y N) (ENNReal.ofReal (2*q)) μ)^2 at hn
  have hr := Real.rpow_le_rpow lpNorm_nonneg hn hq0.le
  rw [Real.mul_rpow (Real.rpow_nonneg hC _) (sq_nonneg _), one_div,
    Real.rpow_inv_rpow hC hq0.ne'] at hr
  have hR (z : ℝ) (hz : 0 ≤ z) : (z^2)^q = z^(2*q) := by
    rw [Real.rpow_mul hz, Real.rpow_two]
  rw [hR _ lpNorm_nonneg, ← lpNorm_norm_eq_real (by linarith : 0 < 2*q) hYa,
    ← integral_nonneg_rpow_eq_lpNorm_rpow hEm (martingaleEnergy_nonneg _ _) hq0,
    ← integral_nonneg_rpow_eq_lpNorm_rpow hYm (fun _ => abs_nonneg _) (by linarith : 0 < 2*q)] at hr
  have hEint : Integrable (fun y => E y ^ q) μ :=
    integrable_of_measurable_finite ((measurable_of_countable E).pow_const _)
  have hYint : Integrable (fun y => |Y N y|^(2*q)) μ :=
    integrable_of_measurable_finite (measurable_of_countable _)
  have h := ENNReal.ofReal_le_ofReal hr
  rw [ENNReal.ofReal_mul hC,
    ofReal_integral_eq_lintegral_ofReal hEint (Filter.Eventually.of_forall fun y =>
      Real.rpow_nonneg (martingaleEnergy_nonneg _ _ _) _),
    ofReal_integral_eq_lintegral_ofReal hYint (Filter.Eventually.of_forall fun y =>
      Real.rpow_nonneg (abs_nonneg _) _)] at h
  have hφmp : MeasurePreserving φ ν μ := ⟨hφ, hmap.symm⟩
  rw [← hφmp.lintegral_comp (measurable_of_countable (fun x => ENNReal.ofReal (E x ^ q))),
    ← hφmp.lintegral_comp (measurable_of_countable (fun x => ENNReal.ofReal (|Y N x|^(2*q))))] at h
  simp only [hEφ, hYφ N le_rfl] at h
  dsimp only [ν] at h
  rw [lintegral_subtype_comap hJ (fun x => ENNReal.ofReal (e x^q)),
    lintegral_subtype_comap hJ (fun x => ENNReal.ofReal (|P N x|^(2*q)))] at h
  exact h

private theorem dyadicMartingalePath_recordedEnergy_cell_le_local
    (u j : ℤ) (β : ℝ) (c : ℕ → ℝ) (N : ℕ)
    {f : ℝ → ℝ} (hf : IntegrableOn f (dyadicInterval u j)) (threshold : ℝ) (extinction : Bool)
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ x in dyadicInterval u j, ENNReal.ofReal
      (martingaleEnergy (recordedPath (dyadicMartingalePath u β c f) threshold extinction) N x ^ q)) ≤
      ENNReal.ofReal (martingaleSquareMomentConstant (2 * q)) *
        ∫⁻ x in dyadicInterval u j, ENNReal.ofReal (|dyadicMartingalePath u β c f N x|^(2 * q)) := by
  let J := dyadicInterval u j
  let P := dyadicMartingalePath u β c (J.indicator f)
  let Q := dyadicMartingalePath u β c f
  have hJ : MeasurableSet J := measurableSet_Ico
  have hF : Integrable (J.indicator f) := (integrable_indicator_iff hJ).mpr hf
  have hp (x : ℝ) (hx : x ∈ J) (k : ℕ) : P k x = Q k x := by
    have hA (l : ℕ) : dyadicAverage (u + l) (J.indicator f) x = dyadicAverage (u + l) f x :=
      dyadicAverage_indicator_eq (le_add_of_nonneg_right (by positivity)) hx
    have hA' (l : ℕ) : dyadicAverage (u + l + 1) (J.indicator f) x =
        dyadicAverage (u + l + 1) f x := dyadicAverage_indicator_eq (by omega) hx
    have h0 : dyadicAverage u (J.indicator f) x = dyadicAverage u f x :=
      dyadicAverage_indicator_eq le_rfl hx
    simp only [P, Q, dyadicMartingalePath, dyadicTransform, h0, hA, hA']
  have he (x : ℝ) (hx : x ∈ J) :
      martingaleEnergy (recordedPath P threshold extinction) N x =
        martingaleEnergy (recordedPath Q threshold extinction) N x := by
    unfold martingaleEnergy martingaleDifference
    refine Finset.sum_congr rfl fun k hk => ?_
    have hlt := Finset.mem_range.mp hk
    have hrec := recordedPath_congr_up_to threshold extinction N (fun l _ => hp x hx l)
    rw [hrec (k + 1) hlt, hrec k hlt.le]
  have h := dyadicMartingalePath_recordedEnergy_cell_le u j β c N hF threshold extinction hq
  have hE : (fun x => ENNReal.ofReal (martingaleEnergy (recordedPath P threshold extinction) N x^q))
      =ᵐ[volume.restrict J]
      fun x => ENNReal.ofReal (martingaleEnergy (recordedPath Q threshold extinction) N x^q) := by
    filter_upwards [ae_restrict_mem (μ := (volume : Measure ℝ)) hJ] with x hx
    rw [he x hx]
  have hQ : (fun x => ENNReal.ofReal (|P N x|^(2*q))) =ᵐ[volume.restrict J]
      fun x => ENNReal.ofReal (|Q N x|^(2*q)) := by
    filter_upwards [ae_restrict_mem (μ := (volume : Measure ℝ)) hJ] with x hx
    rw [hp x hx N]
  change (∫⁻ x in J, ENNReal.ofReal (martingaleEnergy (recordedPath P threshold extinction) N x^q)) ≤
    _ * ∫⁻ x in J, ENNReal.ofReal (|P N x|^(2*q)) at h
  simpa only [lintegral_congr_ae hE, lintegral_congr_ae hQ] using h

/-- The recorded energy estimate on the line, after summing over the initial cells. -/
theorem dyadicMartingalePath_recordedEnergy_le
    (u : ℤ) (β : ℝ) (c : ℕ → ℝ) (N : ℕ)
    {f : ℝ → ℝ} (hf : ∀ j, IntegrableOn f (dyadicInterval u j))
    (threshold : ℝ) (extinction : Bool) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ x, ENNReal.ofReal
      (martingaleEnergy (recordedPath (dyadicMartingalePath u β c f) threshold extinction) N x ^ q)) ≤
      ENNReal.ofReal (martingaleSquareMomentConstant (2 * q)) *
        ∫⁻ x, ENNReal.ofReal (|dyadicMartingalePath u β c f N x|^(2 * q)) := by
  have hsplit (g : ℝ → ℝ≥0∞) : (∫⁻ x, g x) = ∑' j, ∫⁻ x in dyadicInterval u j, g x := by
    simpa only [iUnion_dyadicInterval, Measure.restrict_univ] using
      lintegral_iUnion (μ := (volume : Measure ℝ)) (s := dyadicInterval u)
        (fun j => (measurableSet_Ico : MeasurableSet (dyadicInterval u j)))
        (pairwiseDisjoint_dyadicInterval u) g
  rw [hsplit, hsplit, ← ENNReal.tsum_mul_left]
  exact ENNReal.tsum_le_tsum fun j =>
    dyadicMartingalePath_recordedEnergy_cell_le_local u j β c N (hf j) threshold extinction hq

/-- The coordinate form of the finite dyadic martingale path. -/
noncomputable def coordinateMartingalePath {d : ℕ} (i : Fin d) (u : ℤ) (β : ℝ)
    (c : ℕ → ℝ) (f : (Fin d → ℝ) → ℝ) (k : ℕ) (x : Fin d → ℝ) : ℝ :=
  β * coordinateAverage i u f x + coordinateTransform i u c k f x

private theorem measurable_coordinateMartingalePath {d : ℕ} (i : Fin d)
    (u : ℤ) (β : ℝ) (c : ℕ → ℝ) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    (k : ℕ) : Measurable (coordinateMartingalePath i u β c f k) :=
  (measurable_const.mul (measurable_coordinateAverage i u hm)).add
    (Finset.measurable_fun_sum _ fun _ _ => measurable_const.mul
      ((measurable_coordinateAverage i _ hm).sub (measurable_coordinateAverage i _ hm)))

private theorem memLp_coordinateMartingalePath {d : ℕ} (i : Fin d)
    (u : ℤ) (β : ℝ) (c : ℕ → ℝ) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    {p : ℝ} (hp : 1 ≤ p) (hf : MemLp f (ENNReal.ofReal p) volume) (k : ℕ) :
    MemLp (coordinateMartingalePath i u β c f k) (ENNReal.ofReal p) volume := by
  have h (j : ℤ) : MemLp (coordinateAverage i j f) (ENNReal.ofReal p) volume :=
    (coordinateAverage_eLpNorm_le i j hp hm hf).trans_lt hf.eLpNorm_lt_top
  exact ((h u).const_mul β).add
    (memLp_finsetSum _ fun l _ => ((h (u + l + 1)).sub (h (u + l))).const_mul (c l))

/-- The recorded square-energy estimate in product coordinates. -/
theorem coordinateRecordedEnergy_lintegral_le {d : ℕ} (i : Fin d) (u : ℤ)
    (β : ℝ) (c : ℕ → ℝ) (N : ℕ) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    (threshold : ℝ) (extinction : Bool) {q : ℝ} (hq : 1 ≤ q)
    (hf : MemLp f (ENNReal.ofReal (2 * q)) volume) :
    let P := coordinateMartingalePath i u β c f
    (∫⁻ x, ENNReal.ofReal (martingaleEnergy (recordedPath P threshold extinction) N x ^ q)) ≤
      ENNReal.ofReal (martingaleSquareMomentConstant (2 * q)) *
        ∫⁻ x, ENNReal.ofReal (|P N x|^(2 * q)) := by
  let P := coordinateMartingalePath i u β c f
  let E := martingaleEnergy (recordedPath P threshold extinction) N
  let C := ENNReal.ofReal (martingaleSquareMomentConstant (2*q))
  have hp (k : ℕ) : Measurable (P k) := measurable_coordinateMartingalePath i u β c hm k
  let ℱ : Filtration ℕ (inferInstance : MeasurableSpace (Fin d → ℝ)) :=
    Filtration.const ℕ _ le_rfl
  have hP : StronglyAdapted ℱ P := fun k => (hp k).stronglyMeasurable
  have hE : Measurable E := recordedPath_measurable_energy hP _ _ _
  change (∫⁻ x, ENNReal.ofReal (E x^q)) ≤ C * ∫⁻ x, ENNReal.ofReal (|P N x|^(2*q))
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm _
    let g := f ∘ e
    have hg : Measurable g := hm.comp e.measurable
    have hfg := hf.comp_measurePreserving he
    have hpow : Integrable (fun z => |g z|^(2*q))
        ((volume : Measure ℝ).prod (volume : Measure (Fin n → ℝ))) := by
      rw [← Measure.volume_eq_prod]
      simpa only [Real.norm_eq_abs, ENNReal.toReal_ofReal (by linarith : 0 ≤ 2*q)] using
        hfg.integrable_norm_rpow (by positivity) ENNReal.ofReal_ne_top
    have hs (k : ℤ) (x : ℝ) (y : Fin n → ℝ) :
        coordinateAverage i k f (e (x, y)) =
          dyadicAverage k (fun t => g (t, y)) x := by
      change coordinateAverage i k f (i.insertNth x y) =
        dyadicAverage k (fun t => f (i.insertNth t y)) x
      simp only [coordinateAverage_eq_dyadicAverage, Fin.update_insertNth, Fin.insertNth_apply_same]
    have hPs (k : ℕ) (x : ℝ) (y : Fin n → ℝ) :
        P k (e (x, y)) = dyadicMartingalePath u β c (fun t => g (t, y)) k x := by
      simp only [P, coordinateMartingalePath, coordinateTransform, coordinateDifference,
        dyadicMartingalePath, dyadicTransform, hs]
    have hEs (x : ℝ) (y : Fin n → ℝ) :
        E (e (x, y)) =
          martingaleEnergy (recordedPath (dyadicMartingalePath u β c (fun t => g (t, y)))
            threshold extinction) N x := by
      unfold E martingaleEnergy martingaleDifference
      refine Finset.sum_congr rfl fun k hk => ?_
      have hlt := Finset.mem_range.mp hk
      have hr := recordedPath_congr_up_to threshold extinction N (fun l _ => hPs l x y)
      rw [hr (k + 1) hlt, hr k hlt.le]
    have he1 : Measurable (fun z => ENNReal.ofReal (E (e z)^q)) :=
      ((hE.comp e.measurable).pow_const _).ennreal_ofReal
    have he2 : Measurable (fun z => ENNReal.ofReal (|P N (e z)|^(2*q))) :=
      ((continuous_abs.measurable.comp ((hp N).comp e.measurable)).pow_const _).ennreal_ofReal
    have hm1 : Measurable (fun x => ENNReal.ofReal (E x^q)) := (hE.pow_const _).ennreal_ofReal
    have hm2 : Measurable (fun x => ENNReal.ofReal (|P N x|^(2*q))) :=
      ((continuous_abs.measurable.comp (hp N)).pow_const _).ennreal_ofReal
    rw [← he.lintegral_comp hm1, ← he.lintegral_comp hm2, Measure.volume_eq_prod,
      lintegral_prod_symm' _ he1, lintegral_prod_symm' _ he2,
      ← lintegral_const_mul _ (he2.lintegral_prod_left' (μ := (volume : Measure ℝ)))]
    apply lintegral_mono_ae
    filter_upwards [hpow.prod_left_ae] with y hy
    have hmy : Measurable (fun x => g (x, y)) := hg.comp (measurable_id.prodMk measurable_const)
    have hyLp : MemLp (fun x => g (x, y)) (ENNReal.ofReal (2*q)) volume := by
      apply (integrable_norm_rpow_iff hmy.aestronglyMeasurable (by positivity)
        ENNReal.ofReal_ne_top).mp
      simpa only [ENNReal.toReal_ofReal (by linarith : 0 ≤ 2*q), Real.norm_eq_abs] using hy
    have hlocal (j : ℤ) : IntegrableOn (fun x => g (x, y)) (dyadicInterval u j) := by
      let : IsFiniteMeasure (volume.restrict (dyadicInterval u j)) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
      exact (hyLp.restrict _).integrable (lpNorm_two_or_more_finite (by linarith))
    simpa only [hEs, hPs] using
      dyadicMartingalePath_recordedEnergy_le u β c N hlocal threshold extinction hq

private theorem eLpNorm_eq_abs_moment {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} {F : Ω → ℝ} (hF : AEStronglyMeasurable F μ) {p : ℝ} (hp : 0 < p) :
    eLpNorm F (ENNReal.ofReal p) μ =
      (∫⁻ x, ENNReal.ofReal (|F x|^p) ∂μ)^(1 / p) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp)
    ENNReal.ofReal_ne_top hF, ENNReal.toReal_ofReal hp.le]
  simp_rw [Real.enorm_eq_ofReal_abs,
    ← ENNReal.ofReal_rpow_of_nonneg (abs_nonneg (F _)) hp.le]

/-- The coordinate recorded energy in (L^q), controlled by the terminal (L^{2q}) norm. -/
theorem coordinateRecordedEnergy_lpNorm_le {d : ℕ} (i : Fin d) (u : ℤ)
    (β : ℝ) (c : ℕ → ℝ) (N : ℕ) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    (threshold : ℝ) (extinction : Bool) {q : ℝ} (hq : 1 ≤ q)
    (hf : MemLp f (ENNReal.ofReal (2 * q)) volume) :
    let P := coordinateMartingalePath i u β c f
    let E := martingaleEnergy (recordedPath P threshold extinction) N
    MemLp E (ENNReal.ofReal q) volume ∧
      lpNorm E (ENNReal.ofReal q) volume ≤ martingaleSquareMomentConstant (2*q)^(1/q) *
        (lpNorm (P N) (ENNReal.ofReal (2*q)) volume)^2 := by
  let P := coordinateMartingalePath i u β c f
  let E := martingaleEnergy (recordedPath P threshold extinction) N
  let C := martingaleSquareMomentConstant (2*q)
  have hC : 0 ≤ C := (martingaleSquareMomentConstant_pos (2*q)).le
  have hq0 : 0 < q := by linarith
  have hp (k : ℕ) : Measurable (P k) := measurable_coordinateMartingalePath i u β c hm k
  let ℱ : Filtration ℕ (inferInstance : MeasurableSpace (Fin d → ℝ)) :=
    Filtration.const ℕ _ le_rfl
  have hP : StronglyAdapted ℱ P := fun k => (hp k).stronglyMeasurable
  have hE : Measurable E := recordedPath_measurable_energy hP _ _ _
  have h0 (x : Fin d → ℝ) : 0 ≤ E x := martingaleEnergy_nonneg _ _ _
  have hN : MemLp (P N) (ENNReal.ofReal (2*q)) volume :=
    memLp_coordinateMartingalePath i u β c hm (by linarith) hf N
  have hnormE := eLpNorm_eq_abs_moment (μ := volume) hE.aestronglyMeasurable hq0
  have hnormP := eLpNorm_eq_abs_moment hN.aestronglyMeasurable (by linarith : 0 < 2*q)
  have hAbs (x : Fin d → ℝ) : |E x| = E x := abs_of_nonneg (h0 x)
  simp only [hAbs] at hnormE
  have h := coordinateRecordedEnergy_lintegral_le i u β c N hm threshold extinction hq hf
  change (∫⁻ x, ENNReal.ofReal (E x ^ q)) ≤ ENNReal.ofReal C *
    ∫⁻ x, ENNReal.ofReal (|P N x| ^ (2*q)) at h
  have hpow := ENNReal.rpow_le_rpow h (show 0 ≤ 1 / q by positivity)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← hnormE] at hpow
  have hlast :
      (∫⁻ x, ENNReal.ofReal (|P N x|^(2*q)))^(1/q) =
        eLpNorm (P N) (ENNReal.ofReal (2*q)) volume ^ (2 : ℝ) := by
    rw [hnormP, ← ENNReal.rpow_mul, show 1 / (2*q) * 2 = 1/q by field_simp]
  rw [hlast, ENNReal.ofReal_rpow_of_nonneg hC (by positivity)] at hpow
  have hpow' : eLpNorm E (ENNReal.ofReal q) volume ≤
      ENNReal.ofReal (C^(1/q)) * eLpNorm (P N) (ENNReal.ofReal (2*q)) volume ^ (2 : ℕ) := by
    simpa only [ENNReal.rpow_two] using hpow
  have htop : ENNReal.ofReal (C^(1/q)) *
      eLpNorm (P N) (ENNReal.ofReal (2*q)) volume ^ (2 : ℕ) < ⊤ :=
    ENNReal.mul_lt_top ENNReal.ofReal_lt_top (ENNReal.pow_lt_top hN.eLpNorm_lt_top)
  refine ⟨hpow'.trans_lt htop, ?_⟩
  have hre := ENNReal.toReal_mono htop.ne hpow'
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (Real.rpow_nonneg hC _), ENNReal.toReal_pow] at hre
  exact hre

/-- Coordinate variation estimate for threshold recordings. The bound is
uniform in the finite time interval and includes the initial-value term. -/
theorem stoppedVar {d : ℕ} (i : Fin d) (u : ℤ)
    (β : ℝ) (c : ℕ → ℝ) (N : ℕ) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    {threshold : ℝ} (ht : 0 ≤ threshold) (extinction : Bool) {q : ℝ} (hq : 1 ≤ q)
    (hf : MemLp f (ENNReal.ofReal (2 * q)) volume)
    (hfq : MemLp f (ENNReal.ofReal q) volume) :
    let P := coordinateMartingalePath i u β c f
    let Z := recordedPath P threshold extinction
    lpNorm (fun x => threshold * pathVariation Z N x) (ENNReal.ofReal q) volume ≤
      2 * (martingaleSquareMomentConstant (2*q)^(1/q) *
        (lpNorm (P N) (ENNReal.ofReal (2*q)) volume)^2) +
        threshold * lpNorm (P 0) (ENNReal.ofReal q) volume := by
  let P := coordinateMartingalePath i u β c f
  let Z := recordedPath P threshold extinction
  let E := martingaleEnergy Z N
  let A (x : Fin d → ℝ) := 2 * E x
  let B (x : Fin d → ℝ) := threshold * |P 0 x|
  let p := ENNReal.ofReal q
  have hE := coordinateRecordedEnergy_lpNorm_le i u β c N hm threshold extinction hq hf
  have hE' : MemLp E p volume := hE.1
  have h0 := memLp_coordinateMartingalePath i u β c hm hq hfq 0
  have hA : MemLp A p volume := hE'.const_mul 2
  have hB : MemLp B p volume := by
    simpa only [B, Real.norm_eq_abs] using (h0.norm).const_mul threshold
  have hle := lpNorm_mono_real (hA.add hB)
    (f := fun x => threshold * pathVariation Z N x) (fun x => by
      have hpos : 0 ≤ pathVariation Z N x := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
      rw [Real.norm_of_nonneg (mul_nonneg ht hpos)]
      exact threshold_mul_recordedVariation_le P ht extinction N x)
  have hnormA : lpNorm A p volume = 2 * lpNorm E p volume := by
    simpa only [A, Nat.cast_ofNat] using lpNorm_fun_natCast_mul 2 E p volume
  have hnormB : lpNorm B p volume = threshold * lpNorm (P 0) p volume := by
    have he := lpNorm_const_smul (p := p) threshold (fun x => |P 0 x|) volume
    rw [coe_nnnorm, Real.norm_of_nonneg ht, lpNorm_norm_eq_real (by linarith : 0 < q)
      h0.aestronglyMeasurable] at he
    exact he
  have hp : 1 ≤ p := by simpa only [p, ENNReal.ofReal_one] using ENNReal.ofReal_le_ofReal hq
  have htri := lpNorm_add_le hA (g := B) hp
  rw [hnormA, hnormB] at htri
  exact hle.trans (htri.trans (add_le_add (mul_le_mul_of_nonneg_left hE.2 (by norm_num)) le_rfl))

/-- With unit increments and the original initial value the coordinate path
is precisely the sequence of dyadic averages. -/
theorem coordinateMartingalePath_average {d : ℕ} (i : Fin d) (u : ℤ)
    (f : (Fin d → ℝ) → ℝ) (k : ℕ) (x : Fin d → ℝ) :
    coordinateMartingalePath i u 1 (fun _ => 1) f k x = coordinateAverage i (u + k) f x := by
  unfold coordinateMartingalePath coordinateTransform coordinateDifference
  simp only [one_mul]
  have he (l : ℕ) : u + ↑l + 1 = u + (↑(l + 1) : ℤ) := by omega
  simp_rw [he]
  rw [Finset.sum_range_sub (fun l : ℕ => coordinateAverage i (u + l) f x)]
  simp

/-- Coordinate averages preserve the interval ([0,1]) on measurable inputs. -/
theorem coordinateAverage_mem_Icc {d : ℕ} (i : Fin d) (k : ℤ)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (hf : ∀ x, f x ∈ Icc (0 : ℝ) 1)
    (x : Fin d → ℝ) : coordinateAverage i k f x ∈ Icc (0 : ℝ) 1 := by
  let L := (2 : ℝ)^(-k)
  let I := dyadicInterval k (dyadicIndex k (x i))
  have hL : 0 < L := zpow_pos (by norm_num) _
  have hμ : volume I = ENNReal.ofReal L := by
    unfold I dyadicInterval
    rw [Real.volume_Ico]
    congr 1
    ring
  let μ := (volume : Measure ℝ).restrict I
  let : IsFiniteMeasure μ := ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
  let g (y : ℝ) := f (Function.update x i y)
  have hgm : Measurable g := hm.comp (measurable_update x)
  have hgi : Integrable g μ := MemLp.integrable (q := 1) le_rfl
    (memLp_of_bounded (Filter.Eventually.of_forall fun y => hf (Function.update x i y))
      hgm.aestronglyMeasurable 1)
  have hconst : (∫ y, (1 : ℝ) ∂μ) = L := by
    rw [integral_const, measureReal_def, Measure.restrict_apply_univ, hμ,
      ENNReal.toReal_ofReal hL.le, smul_eq_mul, mul_one]
  change L⁻¹ * (∫ y, g y ∂μ) ∈ Icc (0 : ℝ) 1
  refine ⟨mul_nonneg (inv_nonneg.mpr hL.le) (integral_nonneg fun y => (hf _).1), ?_⟩
  apply (inv_mul_le_iff₀ hL).mpr
  rw [mul_one, ← hconst]
  exact integral_mono hgi (integrable_const 1) fun y => (hf _).2

/-- A nonnegative function bounded by an indicator has its supporting-set norm bound. -/
theorem lpNorm_le_of_indicator {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {A : Set Ω} (hA : MeasurableSet A) (hfin : μ A ≠ ⊤) {f : Ω → ℝ} (hm : Measurable f)
    (h0 : ∀ x, 0 ≤ f x) (h1 : ∀ x, f x ≤ A.indicator (fun _ => 1) x)
    {p : ℝ} (hp : 0 < p) :
    MemLp f (ENNReal.ofReal p) μ ∧ lpNorm f (ENNReal.ofReal p) μ ≤ (μ.real A)^(1/p) := by
  let g : Ω → ℝ := A.indicator fun _ => 1
  have hgm : Measurable g := measurable_const.indicator hA
  have hgi : MemLp g (ENNReal.ofReal p) μ :=
    memLp_indicator_const _ hA 1 (Or.inr hfin)
  have hbound (x : Ω) : ‖f x‖ ≤ g x := by rw [Real.norm_of_nonneg (h0 x)]; exact h1 x
  have hLp : MemLp f (ENNReal.ofReal p) μ :=
    hgi.mono' hm.aestronglyMeasurable (Filter.Eventually.of_forall hbound)
  have hge (x : Ω) : |g x|^p = g x := by
    by_cases hx : x ∈ A
    · simp only [g, indicator_of_mem hx, abs_one, Real.one_rpow]
    · simp only [g, indicator_of_notMem hx, abs_zero, Real.zero_rpow hp.ne']
  have hgnorm := eLpNorm_eq_abs_moment (μ := μ) hgm.aestronglyMeasurable hp
  have hgmass : (fun x => ENNReal.ofReal (g x)) = A.indicator 1 := by
    funext x
    by_cases hx : x ∈ A <;> simp [g, hx]
  have he : lpNorm g (ENNReal.ofReal p) μ = (μ.real A)^(1/p) := by
    rw [lpNorm, hgnorm]
    simp only [hge, hgmass, lintegral_indicator_one hA, ENNReal.toReal_rpow, measureReal_def]
  exact ⟨hLp, (lpNorm_mono_real hgi hbound).trans_eq he⟩

/-- Recorded variation and energy for inputs bounded by a supporting
indicator, uniformly in the initial level, length, and recording threshold. -/
theorem stoppedVar_supported {d : ℕ} (i : Fin d) (u : ℤ)
    (β : ℝ) (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1) (N : ℕ)
    {A : Set (Fin d → ℝ)} (hA : MeasurableSet A) (hfin : volume A ≠ ⊤)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (h0 : ∀ x, 0 ≤ f x)
    (h1 : ∀ x, f x ≤ A.indicator (fun _ => 1) x)
    {threshold : ℝ} (ht : 0 ≤ threshold) (ht1 : threshold ≤ 1)
    (extinction : Bool) {q : ℝ} (hq : 1 ≤ q) :
    let P := coordinateMartingalePath i u β c f
    let Z := recordedPath P threshold extinction
    let C := martingaleSquareMomentConstant (2*q)^(1/q)
    let K := |β| + (martingaleSquareMomentConstant (2*q)^(1/(2*q)))^2
    let a := (volume : Measure (Fin d → ℝ)).real A
    lpNorm (martingaleEnergy Z N) (ENNReal.ofReal q) volume ≤ C * K^2 * a^(1/q) ∧
      lpNorm (fun x => threshold * pathVariation Z N x) (ENNReal.ofReal q) volume ≤
        (2 * C * K^2 + |β|) * a^(1/q) := by
  let P := coordinateMartingalePath i u β c f
  let Z := recordedPath P threshold extinction
  let C := martingaleSquareMomentConstant (2*q)^(1/q)
  let D := (martingaleSquareMomentConstant (2*q)^(1/(2*q)))^2
  let K := |β| + D
  let a := (volume : Measure (Fin d → ℝ)).real A
  have ha : 0 ≤ a := ENNReal.toReal_nonneg
  have hq0 : 0 < q := by linarith
  have hC : 0 ≤ C := Real.rpow_nonneg (martingaleSquareMomentConstant_pos _).le _
  have hD : 0 ≤ D := sq_nonneg _
  have hK : 0 ≤ K := add_nonneg (abs_nonneg _) hD
  have hfq := lpNorm_le_of_indicator hA hfin hm h0 h1 hq0
  have hf2q := lpNorm_le_of_indicator hA hfin hm h0 h1 (by linarith : 0 < 2*q)
  have hAverage {p : ℝ} (hp : 1 ≤ p) (hf : MemLp f (ENNReal.ofReal p) volume) :
      lpNorm (coordinateAverage i u f) (ENNReal.ofReal p) volume ≤
        lpNorm f (ENNReal.ofReal p) volume :=
    ENNReal.toReal_mono hf.eLpNorm_lt_top.ne (coordinateAverage_eLpNorm_le i u hp hm hf)
  have hScale (p : ℝ) :
      lpNorm (fun x => β * coordinateAverage i u f x) (ENNReal.ofReal p) volume =
        |β| * lpNorm (coordinateAverage i u f) (ENNReal.ofReal p) volume := by
    have he := lpNorm_const_smul (p := ENNReal.ofReal p) β (coordinateAverage i u f) volume
    rw [coe_nnnorm, Real.norm_eq_abs] at he
    exact he
  have hPN : lpNorm (P N) (ENNReal.ofReal (2*q)) volume ≤ K * a^(1/(2*q)) := by
    have hmemAvg : MemLp (coordinateAverage i u f) (ENNReal.ofReal (2*q)) volume :=
      (coordinateAverage_eLpNorm_le i u (by linarith) hm hf2q.1).trans_lt hf2q.1.eLpNorm_lt_top
    have hmem : MemLp (fun x => β * coordinateAverage i u f x) (ENNReal.ofReal (2*q)) volume :=
      hmemAvg.const_mul β
    have he : 1 ≤ ENNReal.ofReal (2*q) := lpNorm_two_or_more_finite (by linarith)
    have ht := lpNorm_add_le hmem (g := coordinateTransform i u c N f) he
    rw [hScale] at ht
    refine ht.trans ?_
    rw [add_mul]
    exact add_le_add (mul_le_mul_of_nonneg_left ((hAverage (by linarith) hf2q.1).trans hf2q.2)
      (abs_nonneg _)) ((martTransform i u c hc N (by linarith) hm hf2q.1).trans
        (mul_le_mul_of_nonneg_left hf2q.2 hD))
  have hP0 : lpNorm (P 0) (ENNReal.ofReal q) volume ≤ |β| * a^(1/q) := by
    have hzero : P 0 = fun x => β * coordinateAverage i u f x := by
      funext x
      simp [P, coordinateMartingalePath, coordinateTransform]
    rw [hzero, hScale]
    exact mul_le_mul_of_nonneg_left ((hAverage hq hfq.1).trans hfq.2) (abs_nonneg _)
  have hpower : (K * a^(1/(2*q)))^2 = K^2 * a^(1/q) := by
    rw [mul_pow]
    congr 1
    calc
      _ = (a^(1/(2*q)))^(2 : ℝ) := (Real.rpow_two _).symm
      _ = _ := by rw [← Real.rpow_mul ha, show 1 / (2*q) * 2 = 1/q by field_simp]
  have hP2 := pow_le_pow_left₀ lpNorm_nonneg hPN 2
  rw [hpower] at hP2
  have henergy := (coordinateRecordedEnergy_lpNorm_le i u β c N hm threshold extinction hq hf2q.1).2
  have hvariation := stoppedVar i u β c N hm ht extinction hq hf2q.1 hfq.1
  dsimp only at henergy hvariation
  change _ ≤ C * (lpNorm (P N) (ENNReal.ofReal (2*q)) volume)^2 at henergy
  change _ ≤ 2 * (C * (lpNorm (P N) (ENNReal.ofReal (2*q)) volume)^2) +
    threshold * lpNorm (P 0) (ENNReal.ofReal q) volume at hvariation
  constructor
  · exact henergy.trans ((mul_le_mul_of_nonneg_left hP2 hC).trans_eq (by rw [mul_assoc]))
  · refine hvariation.trans ?_
    have hinit := (mul_le_mul_of_nonneg_left hP0 ht).trans
      (mul_le_of_le_one_left (mul_nonneg (abs_nonneg _) (Real.rpow_nonneg ha _)) ht1)
    exact (add_le_add (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hP2 hC)
      (by norm_num)) hinit).trans_eq (by ring)

/-- A function constant on the dyadic cells of one coordinate, with the
other coordinates held fixed. -/
def constantOnCoordinateCells {d : ℕ} (i : Fin d) (k : ℤ)
    (f : (Fin d → ℝ) → ℝ) : Prop :=
  ∀ x t, dyadicIndex k t = dyadicIndex k (x i) → f (Function.update x i t) = f x

theorem coordinateAverage_constantOnCells {d : ℕ} (i : Fin d) (k : ℤ)
    (f : (Fin d → ℝ) → ℝ) :
    constantOnCoordinateCells i k (coordinateAverage i k f) := by
  intro x t ht
  simp only [coordinateAverage, Function.update_self, Function.update_idem, ht]

private theorem constantOnCoordinateCells_mono {d : ℕ} {i : Fin d} {j k : ℤ}
    (hjk : j ≤ k) {f : (Fin d → ℝ) → ℝ}
    (hf : constantOnCoordinateCells i j f) : constantOnCoordinateCells i k f :=
  fun x t ht => hf x t (dyadicIndex_eq_of_later_eq hjk ht)

/-- Coordinate averaging fixes a function constant on the averaging cells. -/
theorem coordinateAverage_eq_self {d : ℕ} {i : Fin d} {k : ℤ}
    {f : (Fin d → ℝ) → ℝ} (hf : constantOnCoordinateCells i k f) (x : Fin d → ℝ) :
    coordinateAverage i k f x = f x := by
  let L := (2 : ℝ)^(-k)
  let n := dyadicIndex k (x i)
  let J := dyadicInterval k n
  have hL : 0 < L := zpow_pos (by norm_num) _
  have hJ : MeasurableSet J := measurableSet_Ico
  have hvol : volume J = ENNReal.ofReal L := by
    unfold J dyadicInterval
    rw [Real.volume_Ico]
    congr 1
    ring
  have he : (∫ y in J, f (Function.update x i y)) = ∫ _y in J, f x :=
    setIntegral_congr_fun hJ fun y hy => hf x y (mem_dyadicInterval_iff.mp hy)
  change L⁻¹ * (∫ y in J, f (Function.update x i y)) = _
  rw [he, setIntegral_const, measureReal_def, hvol, ENNReal.toReal_ofReal hL.le,
    smul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hL.ne', one_mul]

/-- The true low path at time `k`. -/
noncomputable def coordinateLowPath {d : ℕ} (i : Fin d) (u : ℤ)
    (f : (Fin d → ℝ) → ℝ) (k : ℕ) := coordinateAverage i (u + k) f

/-- The residual after recording the low path, with zero reset enabled. -/
noncomputable def coordinateResidual {d : ℕ} (i : Fin d) (u : ℤ) (threshold : ℝ)
    (f : (Fin d → ℝ) → ℝ) (k : ℕ) (x : Fin d → ℝ) : ℝ :=
  coordinateLowPath i u f k x - recordedPath (coordinateLowPath i u f) threshold true k x

/-- Residuals are constant on their own coordinate cells. -/
theorem coordinateResidual_constantOnCells {d : ℕ} (i : Fin d) (u : ℤ)
    (threshold : ℝ) (f : (Fin d → ℝ) → ℝ) (k : ℕ) :
    constantOnCoordinateCells i (u + k) (coordinateResidual i u threshold f k) := by
  intro x t ht
  let P := coordinateLowPath i u f
  have hp (j : ℕ) (hj : j ≤ k) : P j (Function.update x i t) = P j x := by
    have hij : u + (j : ℤ) ≤ u + (k : ℤ) := by omega
    exact (constantOnCoordinateCells_mono hij (coordinateAverage_constantOnCells i _ f)) x t ht
  change P k (Function.update x i t) - recordedPath P threshold true k (Function.update x i t) =
    P k x - recordedPath P threshold true k x
  rw [hp k le_rfl, recordedPath_congr_up_to threshold true k hp k le_rfl]

/-- Drift of the residual on a parent interval. -/
noncomputable def coordinateResidualDrift {d : ℕ} (i : Fin d) (u : ℤ) (threshold : ℝ)
    (f : (Fin d → ℝ) → ℝ) (k : ℕ) (x : Fin d → ℝ) : ℝ :=
  coordinateAverage i (u + k) (coordinateResidual i u threshold f (k + 1)) x -
    coordinateResidual i u threshold f k x

/-- Normalized Haar coefficient on the parent cell, with spectators fixed. -/
noncomputable def coordinateHaarCoefficient {d : ℕ} (i : Fin d) (k : ℤ)
    (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ) : ℝ :=
  let n := dyadicIndex k (x i)
  ((2 : ℝ)^(-k))⁻¹ * ∫ y in dyadicInterval k n,
    dyadicHaar k n y * f (Function.update x i y)

/-- The pointwise child expansion for the residual in `bp:residual-drift`. -/
theorem residualDrift_expansion {d : ℕ} (i : Fin d) (u : ℤ) (threshold : ℝ)
    (f : (Fin d → ℝ) → ℝ) (k : ℕ) (x : Fin d → ℝ)
    (hf : IntegrableOn (fun y => coordinateResidual i u threshold f (k + 1)
      (Function.update x i y)) (dyadicInterval (u + k) (dyadicIndex (u + k) (x i)))) :
    coordinateResidual i u threshold f (k + 1) x =
      coordinateResidual i u threshold f k x + coordinateResidualDrift i u threshold f k x +
        dyadicHaar (u + k) (dyadicIndex (u + k) (x i)) (x i) *
          coordinateHaarCoefficient i (u + k) (coordinateResidual i u threshold f (k + 1)) x := by
  let R := coordinateResidual i u threshold f (k + 1)
  have hi : coordinateAverage i (u + k + 1) R x = R x := by
    rw [show u + (k : ℤ) + 1 = u + (↑(k + 1) : ℤ) by omega]
    exact coordinateAverage_eq_self (coordinateResidual_constantOnCells i u threshold f (k + 1)) x
  have hh := coordinateDifference_eq_haar i (u + k) (dyadicIndex (u + k) (x i))
    (mem_dyadicInterval_iff.mpr rfl) hf
  change coordinateAverage i (u + k + 1) R x - coordinateAverage i (u + k) R x =
    _ * coordinateHaarCoefficient i (u + k) R x at hh
  rw [hi] at hh
  unfold coordinateResidualDrift
  linarith

private theorem abs_dyadicHaar_eq_one {k n : ℤ} {x : ℝ} (hx : x ∈ dyadicInterval k n) :
    |dyadicHaar k n x| = 1 := by
  rw [← dyadicInterval_children k n] at hx
  have hd : Disjoint (dyadicInterval (k + 1) (2*n))
    (dyadicInterval (k + 1) (2*n+1)) := pairwiseDisjoint_dyadicInterval _ (by omega)
  rcases hx with hl | hr
  · have hn := fun h => Set.disjoint_left.mp hd hl h
    norm_num [dyadicHaar, indicator_of_mem hl, indicator_of_notMem hn]
  · have hn := fun h => Set.disjoint_left.mp hd h hr
    norm_num [dyadicHaar, indicator_of_mem hr, indicator_of_notMem hn]

private theorem normalized_dyadicIntegral_abs_le {k n : ℤ} {g : ℝ → ℝ} {C : ℝ}
    (hg : ∀ x ∈ dyadicInterval k n, |g x| ≤ C) :
    |((2 : ℝ)^(-k))⁻¹ * ∫ y in dyadicInterval k n, g y| ≤ C := by
  let L := (2 : ℝ)^(-k)
  let J := dyadicInterval k n
  have hL : 0 < L := zpow_pos (by norm_num) _
  have hJ : MeasurableSet J := measurableSet_Ico
  let μ := (volume : Measure ℝ).restrict J
  let : IsFiniteMeasure μ := ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
  have hvol : volume J = ENNReal.ofReal L := by
    unfold J dyadicInterval
    rw [Real.volume_Ico]
    congr 1
    ring
  have h := norm_integral_le_of_norm_le_const (μ := μ) (C := C) (f := g) (by
    filter_upwards [ae_restrict_mem (μ := (volume : Measure ℝ)) hJ] with x hx
    rw [Real.norm_eq_abs]
    exact hg x hx)
  rw [measureReal_def, Measure.restrict_apply_univ, hvol, ENNReal.toReal_ofReal hL.le,
    Real.norm_eq_abs, mul_comm C L] at h
  change |L⁻¹ * ∫ y, g y ∂μ| ≤ C
  rw [abs_mul, abs_of_nonneg (inv_nonneg.mpr hL.le), inv_mul_le_iff₀ hL]
  exact h

/-- Bounds for the residual drift and Haar coefficient at every point. -/
theorem residualDrift_pointwise_bounds {d : ℕ} (i : Fin d) (u : ℤ)
    {threshold : ℝ} (ht : 0 ≤ threshold) (f : (Fin d → ℝ) → ℝ) (k : ℕ) (x : Fin d → ℝ) :
    |coordinateResidualDrift i u threshold f k x| ≤ 2 * threshold ∧
      |coordinateHaarCoefficient i (u+k) (coordinateResidual i u threshold f (k+1)) x| ≤
        threshold := by
  let R := coordinateResidual i u threshold f
  have hR (k : ℕ) (x : Fin d → ℝ) : |R k x| ≤ threshold :=
    recordedPath_tracking (coordinateLowPath i u f) ht true k x
  have hAvg : |coordinateAverage i (u+k) (R (k+1)) x| ≤ threshold :=
    normalized_dyadicIntegral_abs_le fun y _ => hR (k+1) (Function.update x i y)
  constructor
  · unfold coordinateResidualDrift
    change |coordinateAverage i (u+k) (R (k+1)) x - R k x| ≤ _
    have he := abs_add_le (coordinateAverage i (u+k) (R (k+1)) x) (-R k x)
    rw [abs_neg] at he
    exact he.trans (by linarith [hR k x])
  · apply normalized_dyadicIntegral_abs_le
    intro y hy
    rw [abs_mul, abs_dyadicHaar_eq_one hy, one_mul]
    exact hR (k+1) (Function.update x i y)

/-- A bounded measurable input is integrable on each bounded fiber cell. -/
theorem boundedFiber_integrable {d : ℕ} (i : Fin d) {f : (Fin d → ℝ) → ℝ}
    (hm : Measurable f) {C : ℝ} (hC : ∀ x, |f x| ≤ C) (x : Fin d → ℝ) (k n : ℤ) :
    IntegrableOn (fun y => f (Function.update x i y)) (dyadicInterval k n) := by
  let μ := (volume : Measure ℝ).restrict (dyadicInterval k n)
  let : IsFiniteMeasure μ := ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
  apply MemLp.integrable (q := 1) le_rfl
  exact MemLp.of_bound (hm.comp (measurable_update x)).aestronglyMeasurable C
    (Filter.Eventually.of_forall fun y => by rw [Real.norm_eq_abs]; exact hC _)

/-- A coordinate average of a uniformly bounded function has the same absolute bound. -/
theorem abs_coordinateAverage_le {d : ℕ} (i : Fin d) (k : ℤ)
    {f : (Fin d → ℝ) → ℝ} {C : ℝ} (hC : ∀ x, |f x| ≤ C) (x : Fin d → ℝ) :
    |coordinateAverage i k f x| ≤ C :=
  normalized_dyadicIntegral_abs_le (fun y _ => hC (Function.update x i y))

/-- Coordinate averaging is additive on bounded measurable functions. -/
theorem coordinateAverage_add_of_bounded {d : ℕ} (i : Fin d) (k : ℤ)
    {f g : (Fin d → ℝ) → ℝ} (hf : Measurable f) (hg : Measurable g)
    {C D : ℝ} (hfC : ∀ x, |f x| ≤ C) (hgD : ∀ x, |g x| ≤ D) (x : Fin d → ℝ) :
    coordinateAverage i k (fun y => f y + g y) x =
      coordinateAverage i k f x + coordinateAverage i k g x := by
  unfold coordinateAverage
  rw [integral_add (boundedFiber_integrable i hf hfC x k _) (boundedFiber_integrable i hg hgD x k _),
    mul_add]

private theorem coordinateAverage_sub_of_bounded {d : ℕ} (i : Fin d) (k : ℤ)
    {f g : (Fin d → ℝ) → ℝ} (hf : Measurable f) (hg : Measurable g)
    {F G : ℝ} (hF : ∀ x, |f x| ≤ F) (hG : ∀ x, |g x| ≤ G) (x : Fin d → ℝ) :
    coordinateAverage i k (fun x => f x - g x) x =
      coordinateAverage i k f x - coordinateAverage i k g x := by
  unfold coordinateAverage
  rw [integral_sub (boundedFiber_integrable i hf hF x k _) (boundedFiber_integrable i hg hG x k _),
    mul_sub]

private theorem coordinateAverage_succ_tower_of_bounded {d : ℕ}
    (i : Fin d) (k : ℤ) {f : (Fin d → ℝ) → ℝ}
    (hm : Measurable f) {C : ℝ} (hC : ∀ x, |f x| ≤ C) (x : Fin d → ℝ) :
    coordinateAverage i k (coordinateAverage i (k+1) f) x = coordinateAverage i k f x := by
  let g := fun y => f (Function.update x i y)
  have he (y : ℝ) : coordinateAverage i (k + 1) f (Function.update x i y) =
      dyadicAverage (k + 1) g y := by
    rw [coordinateAverage_eq_dyadicAverage, Function.update_self]
    simp only [g, Function.update_idem]
  change _ * (∫ y in dyadicInterval k (dyadicIndex k (x i)),
    coordinateAverage i (k+1) f (Function.update x i y)) =
    _ * ∫ y in dyadicInterval k (dyadicIndex k (x i)), g y
  simp only [he]
  rw [integral_dyadicAverage_succ_cell k _ (boundedFiber_integrable i hm hC x _ _)]

private theorem measurable_recordedPath {Ω : Type*} [MeasurableSpace Ω]
    {M : ℕ → Ω → ℝ} (hm : ∀ k, Measurable (M k)) (threshold : ℝ) (extinction : Bool)
    (k : ℕ) : Measurable (recordedPath M threshold extinction k) :=
  (stronglyAdapted_recordedPath (ℱ := Filtration.const ℕ _ le_rfl)
    (fun k => (hm k).stronglyMeasurable) threshold extinction k).measurable

private theorem memLp_recordedPath {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} {p : ℝ≥0∞} {M : ℕ → Ω → ℝ} (hm : ∀ k, Measurable (M k))
    (hLp : ∀ k, MemLp (M k) p μ) (threshold : ℝ) (extinction : Bool)
    (k : ℕ) : MemLp (recordedPath M threshold extinction k) p μ := by
  induction k with
  | zero => exact hLp 0
  | succ k ih =>
    classical
    let P := recordedPath M threshold extinction k
    let E := {x | threshold ≤ |M (k + 1) x - P x| ∨
      (extinction = true ∧ M (k + 1) x = 0)}
    have hP := measurable_recordedPath hm threshold extinction k
    have hE : MeasurableSet E := by
      change MeasurableSet ({x | threshold ≤ |M (k + 1) x - P x|} ∪
        ({_x : Ω | extinction = true} ∩ {x | M (k + 1) x = 0}))
      exact (measurableSet_le measurable_const
        (continuous_abs.measurable.comp ((hm (k+1)).sub hP))).union
        ((MeasurableSet.const _).inter (measurableSet_eq_fun (hm _) measurable_const))
    exact MemLp.piecewise hE ((hLp (k+1)).restrict E) (ih.restrict Eᶜ)

private theorem recordedLow_constantOnCells {d : ℕ} (i : Fin d) (u : ℤ)
    (threshold : ℝ) (f : (Fin d → ℝ) → ℝ) (k : ℕ) :
    constantOnCoordinateCells i (u + k) (recordedPath (coordinateLowPath i u f) threshold true k) := by
  intro x t ht
  apply recordedPath_congr_up_to threshold true k _ k le_rfl
  intro j hj
  have hij : u + (j : ℤ) ≤ u + (k : ℤ) := by omega
  exact (constantOnCoordinateCells_mono hij (coordinateAverage_constantOnCells i _ f)) x t ht

private theorem residualDrift_eq_negAverage {d : ℕ} (i : Fin d) (u : ℤ)
    (threshold : ℝ) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    (hf : ∀ x, f x ∈ Icc (0 : ℝ) 1) (k : ℕ) (x : Fin d → ℝ) :
    coordinateResidualDrift i u threshold f k x =
      -coordinateAverage i (u+k)
        (martingaleDifference (recordedPath (coordinateLowPath i u f) threshold true) k) x := by
  let P := coordinateLowPath i u f
  let Z := recordedPath P threshold true
  have hPm (k : ℕ) : Measurable (P k) := measurable_coordinateAverage i _ hm
  have hZm (k : ℕ) : Measurable (Z k) := measurable_recordedPath hPm threshold true k
  have hP01 (k : ℕ) (x : Fin d → ℝ) : P k x ∈ Icc (0 : ℝ) 1 :=
    coordinateAverage_mem_Icc i _ hm hf x
  have hZ01 (k : ℕ) (x : Fin d → ℝ) : Z k x ∈ Icc (0 : ℝ) 1 :=
    recordedPath_mem_Icc P threshold true hP01 k x
  have hP1 (k : ℕ) (x : Fin d → ℝ) : |P k x| ≤ 1 :=
    (abs_of_nonneg (hP01 k x).1).symm ▸ (hP01 k x).2
  have hZ1 (k : ℕ) (x : Fin d → ℝ) : |Z k x| ≤ 1 :=
    (abs_of_nonneg (hZ01 k x).1).symm ▸ (hZ01 k x).2
  have hTower : coordinateAverage i (u+k) (P (k+1)) x = P k x := by
    change coordinateAverage i (u+k) (coordinateAverage i (u+(↑(k+1) : ℤ)) f) x =
      coordinateAverage i (u+k) f x
    rw [show u + (↑(k+1) : ℤ) = u + ↑k + 1 by omega]
    exact coordinateAverage_succ_tower_of_bounded i _ hm
      (fun y => (abs_of_nonneg (hf y).1).symm ▸ (hf y).2) x
  have hZ : coordinateAverage i (u+k) (Z k) x = Z k x :=
    coordinateAverage_eq_self (recordedLow_constantOnCells i u threshold f k) x
  change coordinateAverage i (u+k) (fun y => P (k+1) y - Z (k+1) y) x - (P k x - Z k x) =
    -coordinateAverage i (u+k) (fun y => Z (k+1) y - Z k y) x
  rw [coordinateAverage_sub_of_bounded i _ (hPm _) (hZm _) (hP1 _) (hZ1 _),
    coordinateAverage_sub_of_bounded i _ (hZm _) (hZm _) (hZ1 _) (hZ1 _), hTower, hZ]
  ring

/-- Summed (L^1) drift is controlled by the variation of the recorded path. -/
theorem residualDrift_sum_lpNorm_le {d : ℕ} (i : Fin d) (u : ℤ)
    (threshold : ℝ) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    (hf : ∀ x, f x ∈ Icc (0 : ℝ) 1) (hLp : MemLp f 1 volume) (N : ℕ) :
    ∑ k ∈ Finset.range N, lpNorm (coordinateResidualDrift i u threshold f k) 1 volume ≤
      lpNorm (pathVariation (recordedPath (coordinateLowPath i u f) threshold true) N) 1 volume := by
  let P := coordinateLowPath i u f
  let Z := recordedPath P threshold true
  have hPm (k : ℕ) : Measurable (P k) := measurable_coordinateAverage i _ hm
  have hPm1 (k : ℕ) : MemLp (P k) 1 volume := by
    have h := coordinateAverage_eLpNorm_le i (u + k) (p := 1) le_rfl (f := f) hm (by simpa using hLp)
    have h' : eLpNorm (P k) 1 volume ≤ eLpNorm f 1 volume := by
      simpa only [P, coordinateLowPath, ENNReal.ofReal_one] using h
    exact h'.trans_lt hLp.eLpNorm_lt_top
  have hZ1 (k : ℕ) : MemLp (Z k) 1 volume :=
    memLp_recordedPath hPm hPm1 threshold true k
  have hZm (k : ℕ) : Measurable (Z k) := measurable_recordedPath hPm threshold true k
  have hD1 (k : ℕ) : MemLp (martingaleDifference Z k) 1 volume := (hZ1 (k+1)).sub (hZ1 k)
  have hDm (k : ℕ) : Measurable (martingaleDifference Z k) := (hZm (k+1)).sub (hZm k)
  have hstep (k : ℕ) :
      lpNorm (coordinateResidualDrift i u threshold f k) 1 volume ≤
        lpNorm (martingaleDifference Z k) 1 volume := by
    have he := funext (residualDrift_eq_negAverage i u threshold hm hf k)
    change coordinateResidualDrift i u threshold f k =
      -coordinateAverage i (u+k) (martingaleDifference Z k) at he
    rw [he, lpNorm_neg]
    have h := coordinateAverage_eLpNorm_le i (u+k) (p := 1) le_rfl (hDm k)
      (by simpa using hD1 k)
    exact ENNReal.toReal_mono (hD1 k).eLpNorm_lt_top.ne (by simpa using h)
  have hE (k : ℕ) :
      lpNorm (martingaleDifference Z k) 1 volume = ∫ x, |martingaleDifference Z k x| := by
    rw [lpNorm_one_eq_integral_norm (hD1 k).aestronglyMeasurable]
    rfl
  have hI (k : ℕ) : Integrable (fun x => |martingaleDifference Z k x|) :=
    (memLp_one_iff_integrable.mp (hD1 k)).norm
  have hmV : Measurable (pathVariation Z N) := Finset.measurable_fun_sum _ fun k _ =>
    continuous_abs.measurable.comp (hDm k)
  refine (Finset.sum_le_sum (fun k _ => hstep k)).trans_eq ?_
  rw [lpNorm_one_eq_integral_norm hmV.aestronglyMeasurable]
  simp_rw [hE]
  rw [← integral_finsetSum _ (fun k _ => hI k)]
  apply integral_congr_ae
  filter_upwards with x
  have hp : 0 ≤ pathVariation Z N x := Finset.sum_nonneg fun _ _ => abs_nonneg _
  rw [Real.norm_of_nonneg hp]
  rfl

/-- The squared residual Haar coefficients are controlled by the energies
of the original and recorded paths. -/
theorem residualDrift_sum_integral_sq_le {d : ℕ} (i : Fin d) (u : ℤ)
    {threshold : ℝ} (ht : 0 ≤ threshold) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f)
    (hLp : MemLp f 2 volume) (N : ℕ) :
    (∑ k ∈ Finset.range N, ∫ x,
      coordinateHaarCoefficient i (u+k) (coordinateResidual i u threshold f (k+1)) x ^ 2) ≤
      2 * ((∫ x, f x^2) +
        ∫ x, martingaleEnergy (recordedPath (coordinateLowPath i u f) threshold true) N x) := by
  let P := coordinateLowPath i u f
  let Z := recordedPath P threshold true
  let R := coordinateResidual i u threshold f
  have hPm (k : ℕ) : Measurable (P k) := measurable_coordinateAverage i _ hm
  have hZm (k : ℕ) : Measurable (Z k) := measurable_recordedPath hPm threshold true k
  have hRm (k : ℕ) : Measurable (R k) := (hPm k).sub (hZm k)
  have hP2 (k : ℕ) : MemLp (P k) 2 volume := by
    have h := coordinateAverage_eLpNorm_le i (u+k) (p := 2) (by norm_num) hm (by simpa using hLp)
    have htwo : ENNReal.ofReal 2 = 2 := by norm_num
    have he : eLpNorm (P k) 2 volume ≤ eLpNorm f 2 volume := by
      simpa only [P, coordinateLowPath, htwo] using h
    exact he.trans_lt hLp.eLpNorm_lt_top
  have hZ2 (k : ℕ) : MemLp (Z k) 2 volume := memLp_recordedPath hPm hP2 threshold true k
  have hR2 (k : ℕ) : MemLp (R k) 2 volume := (hP2 k).sub (hZ2 k)
  have hR (k : ℕ) (x : Fin d → ℝ) : |R k x| ≤ threshold :=
    recordedPath_tracking P ht true k x
  have hstep (k : ℕ) :
      (∫ x, coordinateHaarCoefficient i (u+k) (R (k+1)) x ^ 2) ≤
        2 * ((∫ x, (coordinateDifference i (u+k) f x)^2) +
          ∫ x, martingaleDifference Z k x ^ 2) := by
    let h (x : Fin d → ℝ) := R (k+1) x - R k x
    let l : ℤ := u+k
    have hl : l + 1 = u + (↑(k+1) : ℤ) := by dsimp [l]; omega
    have hRm' : Measurable h := (hRm (k+1)).sub (hRm k)
    have hLp' : MemLp h 2 volume := (hR2 (k+1)).sub (hR2 k)
    have hfixed (x : Fin d → ℝ) : coordinateAverage i (l+1) h x = h x := by
      apply coordinateAverage_eq_self
      intro x t ht
      have h1 := coordinateResidual_constantOnCells i u threshold f (k+1)
      have h0 := constantOnCoordinateCells_mono (show l ≤ l+1 by omega)
        (coordinateResidual_constantOnCells i u threshold f k)
      rw [hl] at ht
      have h' : dyadicIndex (l+1) t = dyadicIndex (l+1) (x i) := by rw [hl]; exact ht
      exact congrArg₂ (· - ·) (h1 x t ht) (h0 x t h')
    have hD (x : Fin d → ℝ) :
        (coordinateHaarCoefficient i l (R (k+1)) x)^2 = (coordinateDifference i l h x)^2 := by
      have hfixed0 : coordinateAverage i l (R k) x = R k x :=
        coordinateAverage_eq_self (coordinateResidual_constantOnCells i u threshold f k) x
      have he : coordinateAverage i l h x =
          coordinateAverage i l (R (k+1)) x - coordinateAverage i l (R k) x :=
        coordinateAverage_sub_of_bounded i l (hRm _) (hRm _) (hR _) (hR _) x
      have hexp := residualDrift_expansion i u threshold f k x
        (boundedFiber_integrable i (hRm _) (hR _) x _ _)
      have hf' : dyadicHaar l (dyadicIndex l (x i)) (x i) ^
          (2 : ℕ) = 1 := by
        rw [← sq_abs, abs_dyadicHaar_eq_one (mem_dyadicInterval_iff.mpr rfl), one_pow]
      have heq : coordinateDifference i l h x =
          dyadicHaar l (dyadicIndex l (x i)) (x i) * coordinateHaarCoefficient i l (R (k+1)) x := by
        unfold coordinateDifference
        rw [hfixed, he, hfixed0]
        change R (k+1) x - R k x - (coordinateAverage i l (R (k+1)) x - R k x) = _
        change R (k+1) x = R k x + (coordinateAverage i l (R (k+1)) x - R k x) + _ at hexp
        linarith
      rw [heq, mul_pow, hf', one_mul]
    have hDint : (∫ x, (coordinateDifference i l h x)^2) ≤ ∫ x, (h x)^2 := by
      rw [coordinateDifference_integral_sq i l hRm' hLp']
      simp_rw [hfixed]
      exact sub_le_self _ (integral_nonneg fun _ => sq_nonneg _)
    rw [show u + (k : ℤ) = l from rfl]
    simp_rw [hD]
    refine hDint.trans ?_
    have hDiff2 : MemLp (coordinateDifference i l f) 2 volume := by
      have hnext : coordinateAverage i (l+1) f = P (k+1) := by rw [hl]; rfl
      unfold coordinateDifference
      simp only [hnext]
      exact (hP2 (k+1)).sub (hP2 k)
    have hZDiff2 : MemLp (martingaleDifference Z k) 2 volume := (hZ2 _).sub (hZ2 _)
    have hRhs : Integrable (fun x => 2 * ((coordinateDifference i l f x)^2 +
        (martingaleDifference Z k x)^2)) :=
      (hDiff2.integrable_sq.add hZDiff2.integrable_sq).const_mul 2
    have hh := integral_mono hLp'.integrable_sq hRhs (fun x => by
      have hz : h x = coordinateDifference i l f x - martingaleDifference Z k x := by
        have hs : coordinateDifference i l f x = P (k+1) x - P k x := by
          unfold coordinateDifference
          rw [hl]
          rfl
        rw [hs]
        change (P (k+1) x - Z (k+1) x) - (P k x - Z k x) =
          P (k+1) x - P k x - (Z (k+1) x - Z k x)
        ring
      rw [hz]
      nlinarith [sq_nonneg (coordinateDifference i l f x + martingaleDifference Z k x)])
    rw [integral_const_mul] at hh
    have hadd := integral_add hDiff2.integrable_sq hZDiff2.integrable_sq
    rw [hadd] at hh
    exact hh
  have hsum := Finset.sum_le_sum (s := Finset.range N) (fun k _ => hstep k)
  rw [← Finset.mul_sum, Finset.sum_add_distrib] at hsum
  have hZsum : (∑ k ∈ Finset.range N, ∫ x, martingaleDifference Z k x ^ 2) =
      ∫ x, martingaleEnergy Z N x := by
    unfold martingaleEnergy
    have hi (k : ℕ) : Integrable (fun x => martingaleDifference Z k x ^ 2) :=
      ((hZ2 (k+1)).sub (hZ2 k)).integrable_sq
    rw [integral_finsetSum _ (fun k _ => hi k)]
  rw [hZsum] at hsum
  exact hsum.trans (mul_le_mul_of_nonneg_left
    (add_le_add (coordinateDifference_sum_integral_sq_le i u N hm hLp) le_rfl) (by norm_num))

/-- The true-path Haar coefficients have no drift and satisfy the unit
amplitude and total square bounds. -/
theorem truePath_haar_bounds {d : ℕ} (i : Fin d) (u : ℤ)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (hf : ∀ x, |f x| ≤ 1)
    (hLp : MemLp f 2 volume) (N : ℕ) :
    (∀ k : ℤ, ∀ x, |coordinateHaarCoefficient i k f x| ≤ 1) ∧
      (∑ k ∈ Finset.range N, ∫ x, (coordinateHaarCoefficient i (u+k) f x)^2) ≤
        ∫ x, (f x)^2 := by
  constructor
  · intro k x
    apply normalized_dyadicIntegral_abs_le
    intro y hy
    rw [abs_mul, abs_dyadicHaar_eq_one hy, one_mul]
    exact hf _
  · have hd (k : ℤ) (x : Fin d → ℝ) :
        (coordinateHaarCoefficient i k f x)^2 = (coordinateDifference i k f x)^2 := by
      have h := coordinateDifference_eq_haar i k (dyadicIndex k (x i))
        (mem_dyadicInterval_iff.mpr rfl) (boundedFiber_integrable i hm hf x k _)
      rw [h, mul_pow, ← sq_abs (dyadicHaar k (dyadicIndex k (x i)) (x i)),
        abs_dyadicHaar_eq_one (mem_dyadicInterval_iff.mpr rfl), one_pow, one_mul]
      rfl
    simp only [hd]
    exact coordinateDifference_sum_integral_sq_le i u N hm hLp

/-- The parent and two child values determine the drift and the signed
half-difference uniquely. -/
theorem haar_coefficients_unique {a b c p d p' d' : ℝ}
    (hl : a = c + p + d) (hr : b = c + p - d)
    (hl' : a = c + p' + d') (hr' : b = c + p' - d') : p = p' ∧ d = d' :=
  ⟨by linarith, by linarith⟩

/-- Difference between successive dyadic recording thresholds, with the
initial layer given by the recording at threshold one. -/
noncomputable def recordedLayer {Ω : Type*} (M : ℕ → Ω → ℝ) (extinction : Bool)
    (j : ℕ) (k : ℕ) (x : Ω) : ℝ :=
  match j with
  | 0 => recordedPath M 1 extinction k x
  | j + 1 => recordedPath M ((2 : ℝ)^(j+1))⁻¹ extinction k x -
      recordedPath M ((2 : ℝ)^j)⁻¹ extinction k x

/-- The recording layers telescope at the chosen threshold. -/
theorem sum_recordedLayer {Ω : Type*} (M : ℕ → Ω → ℝ) (extinction : Bool)
    (J k : ℕ) (x : Ω) :
    ∑ j ∈ Finset.range (J+1), recordedLayer M extinction j k x =
      recordedPath M ((2 : ℝ)^J)⁻¹ extinction k x := by
  induction J with
  | zero => simp [recordedLayer]
  | succ J ih =>
    rw [Finset.sum_range_succ, ih]
    simp only [recordedLayer]
    ring

/-- Each positive recording layer has amplitude at most three times its
threshold. -/
theorem abs_recordedLayer_succ_le {Ω : Type*} (M : ℕ → Ω → ℝ) (extinction : Bool)
    (j k : ℕ) (x : Ω) :
    |recordedLayer M extinction (j+1) k x| ≤ 3 * ((2 : ℝ)^(j+1))⁻¹ := by
  let a := ((2 : ℝ)^(j+1))⁻¹
  let b := ((2 : ℝ)^j)⁻¹
  have ha := recordedPath_tracking M (threshold := a) (by positivity) extinction k x
  have hb := recordedPath_tracking M (threshold := b) (by positivity) extinction k x
  have he : b = 2 * a := by
    dsimp [a, b]
    rw [pow_succ, mul_inv_rev]
    ring
  let A := recordedPath M a extinction k x
  let B := recordedPath M b extinction k x
  change |A - B| ≤ 3 * a
  exact (abs_sub_le A (M k x) B).trans (by
    rw [abs_sub_comm A (M k x)]
    linarith)

/-- The finite pairing of a low path with the increments of a high path. -/
noncomputable def pathPairing (L W : ℕ → ℝ) (T : ℕ) : ℝ :=
  ∑ k ∈ Finset.range T, L k * (W (k+1) - W k)

private theorem abs_pathPairing_le_variation (L W : ℕ → ℝ) (T : ℕ)
    {a : ℝ} (hL : ∀ k ≤ T, |L k| ≤ a) :
    |pathPairing L W T| ≤ a * ∑ k ∈ Finset.range T, |W (k+1) - W k| := by
  unfold pathPairing
  calc
    _ ≤ ∑ k ∈ Finset.range T, |L k * (W (k+1) - W k)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ k ∈ Finset.range T, a * |W (k+1) - W k| := by
      apply Finset.sum_le_sum
      intro k hk
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_right (hL k (Finset.mem_range.mp hk).le) (abs_nonneg _)
    _ = _ := (Finset.mul_sum ..).symm

private theorem abs_pathPairing_le_parts (L W : ℕ → ℝ) (T : ℕ)
    {a b : ℝ} (ha : 0 ≤ a) (_hb : 0 ≤ b)
    (hL : ∀ k ≤ T, |L k| ≤ a) (hW : ∀ k ≤ T, |W k| ≤ b) :
    |pathPairing L W T| ≤ b * (2*a + ∑ k ∈ Finset.range T, |L (k+1) - L k|) := by
  have he : pathPairing L W T = L T * W T - L 0 * W 0 -
      ∑ k ∈ Finset.range T, W (k+1) * (L (k+1) - L k) := by
    unfold pathPairing
    rw [← Finset.sum_range_sub (fun k => L k * W k), ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  have h1 : |L T * W T| ≤ a*b := by
    rw [abs_mul]
    exact mul_le_mul (hL T le_rfl) (hW T le_rfl) (abs_nonneg _) ha
  have h0 : |L 0 * W 0| ≤ a*b := by
    rw [abs_mul]
    exact mul_le_mul (hL 0 (Nat.zero_le _)) (hW 0 (Nat.zero_le _)) (abs_nonneg _) ha
  have hs : |∑ k ∈ Finset.range T, W (k+1) * (L (k+1) - L k)| ≤
      b * ∑ k ∈ Finset.range T, |L (k+1) - L k| := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro k hk
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right (hW (k+1) (Finset.mem_range.mp hk)) (abs_nonneg _)
  rw [he]
  have habs := abs_add_le (L T * W T - L 0 * W 0)
    (-(∑ k ∈ Finset.range T, W (k+1) * (L (k+1) - L k)))
  rw [abs_neg] at habs
  have hend := abs_add_le (L T * W T) (-(L 0 * W 0))
  rw [abs_neg] at hend
  simp only [← sub_eq_add_neg] at habs hend
  linarith

private theorem abs_prod_le_pow {ι : Type*} (s : Finset ι) (f : ι → ℝ) {C : ℝ}
    (_hC : 0 ≤ C) (hf : ∀ i ∈ s, |f i| ≤ C) : |∏ i ∈ s, f i| ≤ C^s.card := by
  rw [Finset.abs_prod]
  simpa only [Finset.prod_const] using Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _) hf

private theorem abs_prod_sub_prod_le_sum {ι : Type*} (s : Finset ι) (f g : ι → ℝ) {C : ℝ}
    (hC : 1 ≤ C) (hf : ∀ i ∈ s, |f i| ≤ C) (hg : ∀ i ∈ s, |g i| ≤ C) :
    |(∏ i ∈ s, f i) - ∏ i ∈ s, g i| ≤ C^s.card * ∑ i ∈ s, |f i - g i| := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.prod_insert hi, Finset.sum_insert hi,
      Finset.card_insert_of_notMem hi, pow_succ]
    let F := ∏ j ∈ s, f j
    let G := ∏ j ∈ s, g j
    have he : f i * F - g i * G = (f i - g i) * F + g i * (F - G) := by ring
    change |f i * F - g i * G| ≤ _
    rw [he]
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul, abs_mul]
    have hF : |F| ≤ C^s.card := abs_prod_le_pow s f (zero_le_one.trans hC)
      (fun j hj => hf j (Finset.mem_insert_of_mem hj))
    have hdiff : |F - G| ≤ C^s.card * ∑ j ∈ s, |f j - g j| :=
      ih (fun j hj => hf j (Finset.mem_insert_of_mem hj))
        (fun j hj => hg j (Finset.mem_insert_of_mem hj))
    have hFi := mul_le_mul_of_nonneg_left hF (abs_nonneg (f i - g i))
    have hgi := mul_le_mul (hg i (Finset.mem_insert_self _ _)) hdiff
      (abs_nonneg (F - G)) (zero_le_one.trans hC)
    have he' : |f i - g i| * C^s.card ≤ C^s.card * C * |f i - g i| := by
      rw [mul_comm (|f i - g i|)]
      gcongr
      exact le_mul_of_one_le_right (pow_nonneg (zero_le_one.trans hC) _) hC
    exact (add_le_add (hFi.trans he') hgi).trans_eq (by ring)

private theorem pathVariation_product_le {ι Ω : Type*} (s : Finset ι)
    (L : ι → ℕ → Ω → ℝ) (T : ℕ) (x : Ω) {C : ℝ} (hC : 1 ≤ C)
    (hL : ∀ i ∈ s, ∀ k ≤ T, |L i k x| ≤ C) :
    pathVariation (fun k x => ∏ i ∈ s, L i k x) T x ≤
      C^s.card * ∑ i ∈ s, pathVariation (L i) T x := by
  unfold pathVariation martingaleDifference
  calc
    _ ≤ ∑ k ∈ Finset.range T, C^s.card * ∑ i ∈ s, |L i (k+1) x - L i k x| := by
      apply Finset.sum_le_sum
      intro k hk
      have hs := Finset.mem_range.mp hk
      exact abs_prod_sub_prod_le_sum s (fun i => L i (k+1) x) (fun i => L i k x) hC
        (fun i hi => hL i hi _ hs) (fun i hi => hL i hi _ hs.le)
    _ = _ := by
      rw [← Finset.mul_sum, Finset.sum_comm]

private theorem abs_prod_le_one_small {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (F : ι → ℝ) {i : ι} (hi : i ∈ s) {δ : ℝ} (hδ : 0 ≤ δ)
    (hF : ∀ j ∈ s, |F j| ≤ 3) (hsmall : |F i| ≤ 3 * δ) :
    |∏ j ∈ s, F j| ≤ (3 : ℝ)^s.card * δ := by
  rw [← Finset.mul_prod_erase s F hi, abs_mul]
  have hp : |∏ j ∈ s.erase i, F j| ≤ (3 : ℝ)^(s.erase i).card :=
    abs_prod_le_pow _ F (by norm_num) (fun j hj => hF j (Finset.mem_of_mem_erase hj))
  have hmul := mul_le_mul hsmall hp (abs_nonneg _) (mul_nonneg (by norm_num) hδ)
  have hcard : s.card = (s.erase i).card + 1 := by
    rw [Finset.card_erase_of_mem hi]
    have hh := Finset.card_pos.mpr ⟨i, hi⟩
    omega
  rw [hcard, pow_succ]
  exact hmul.trans_eq (by ring)

private theorem integrable_and_abs_integral_le_of_abs_le {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} {F B : Ω → ℝ} (hF : Measurable F) (hB : Integrable B μ)
    (h : ∀ x, |F x| ≤ B x) : Integrable F μ ∧ |∫ x, F x ∂μ| ≤ ∫ x, B x ∂μ := by
  have hnorm : ∀ᵐ x ∂μ, ‖F x‖ ≤ B x :=
    Filter.Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact h x
  exact ⟨hB.mono' hF.aestronglyMeasurable hnorm, by
    rw [← Real.norm_eq_abs]
    exact norm_integral_le_of_norm_le hB hnorm⟩

private theorem measurable_pathPairing {Ω : Type*} [MeasurableSpace Ω]
    {L W : ℕ → Ω → ℝ} (hL : ∀ k, Measurable (L k)) (hW : ∀ k, Measurable (W k)) (T : ℕ) :
    Measurable (fun x => pathPairing (fun k => L k x) (fun k => W k x) T) :=
  Finset.measurable_fun_sum _ fun k _ => (hL k).mul ((hW (k+1)).sub (hW k))

private theorem scale_inverse_mul_pow_le {n m : ℕ} (h : n ≤ m) :
    ((2 : ℝ)^m)⁻¹ * (2 : ℝ)^n ≤ 1 := by
  have hp : (2 : ℝ)^n ≤ (2 : ℝ)^m := pow_le_pow_right₀ (by norm_num) h
  exact (inv_mul_le_one₀ (by positivity)).mpr hp

private theorem scale_inverse_le {n m : ℕ} (h : n ≤ m) :
    ((2 : ℝ)^m)⁻¹ ≤ ((2 : ℝ)^n)⁻¹ :=
  inv_anti₀ (by positivity) (pow_le_pow_right₀ (by norm_num) h)

private theorem weighted_layer_pairing_le {ι Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} (s : Finset ι) (H : Ω → ℝ) (hH : Measurable H)
    (hH0 : ∀ x, 0 ≤ H x) (hHi : Integrable H μ) (L : ι → ℕ → Ω → ℝ) (W : ℕ → Ω → ℝ)
    (T : ℕ) (n : ι → ℕ) (m : ℕ) {B : ℝ} (hB : 0 ≤ B)
    (hLm : ∀ i k, Measurable (L i k)) (hWm : ∀ k, Measurable (W k))
    (hL : ∀ i ∈ s, ∀ k ≤ T, ∀ x, |L i k x| ≤ 3 * ((2 : ℝ)^(n i))⁻¹)
    (hW : 0 < m → ∀ k ≤ T, ∀ x, |W k x| ≤ 3 * ((2 : ℝ)^m)⁻¹)
    (hLi : ∀ i ∈ s, Integrable (fun x => H x * pathVariation (L i) T x) μ)
    (hWi : Integrable (fun x => H x * pathVariation W T x) μ)
    (hLv : ∀ i ∈ s, (∫ x, H x * pathVariation (L i) T x ∂μ) ≤ B * (2 : ℝ)^(n i))
    (hWv : (∫ x, H x * pathVariation W T x ∂μ) ≤ B * (2 : ℝ)^m)
    (hs : s.Nonempty) :
    let F (x : Ω) := H x * pathPairing (fun k => ∏ i ∈ s, L i k x) (fun k => W k x) T
    Integrable F μ ∧ |∫ x, F x ∂μ| ≤
      (3 : ℝ)^s.card * (6 * (∫ x, H x ∂μ) + (3 * (s.card : ℝ) + 1) * B) := by
  classical
  dsimp only
  let A := (3 : ℝ)^s.card
  let δ := ((2 : ℝ)^m)⁻¹
  let U (k : ℕ) (x : Ω) := ∏ i ∈ s, L i k x
  let F (x : Ω) := H x * pathPairing (fun k => U k x) (fun k => W k x) T
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hδ : 0 ≤ δ := by dsimp [δ]; positivity
  have hδ1 : δ ≤ 1 := by
    simpa only [pow_zero, inv_one] using (scale_inverse_le (n := 0) (Nat.zero_le m))
  have hFm : Measurable F := hH.mul (measurable_pathPairing
    (fun k => Finset.measurable_fun_prod _ (fun i _ => hLm i k)) hWm T)
  have h3 (i : ι) (hi : i ∈ s) (k : ℕ) (hk : k ≤ T) (x : Ω) : |L i k x| ≤ 3 :=
    (hL i hi k hk x).trans (by
      have he : ((2 : ℝ)^(n i))⁻¹ ≤ 1 := by
        simpa only [pow_zero, inv_one] using scale_inverse_le (n := 0) (Nat.zero_le (n i))
      linarith)
  have hHnn : 0 ≤ ∫ x, H x ∂μ := integral_nonneg hH0
  by_cases hsmall : ∃ i ∈ s, m ≤ n i
  · obtain ⟨i, hi, him⟩ := hsmall
    have hU (k : ℕ) (hk : k ≤ T) (x : Ω) : |U k x| ≤ A * δ :=
      abs_prod_le_one_small s (fun i => L i k x) hi hδ (fun j hj => h3 j hj k hk x)
        ((hL i hi k hk x).trans (mul_le_mul_of_nonneg_left (scale_inverse_le him) (by norm_num)))
    let G (x : Ω) := A * δ * (H x * pathVariation W T x)
    have hb (x : Ω) : |F x| ≤ G x := by
      unfold F G
      rw [abs_mul, abs_of_nonneg (hH0 x)]
      have he := mul_le_mul_of_nonneg_left
        (abs_pathPairing_le_variation (fun k => U k x) (fun k => W k x) T
          (fun k hk => hU k hk x)) (hH0 x)
      exact he.trans_eq (by dsimp [pathVariation, martingaleDifference]; ring)
    have h := integrable_and_abs_integral_le_of_abs_le hFm (hWi.const_mul (A*δ)) hb
    refine ⟨h.1, h.2.trans ?_⟩
    change (∫ x, A * δ * (H x * pathVariation W T x) ∂μ) ≤ _
    rw [integral_const_mul]
    have ht := mul_le_mul_of_nonneg_left hWv (mul_nonneg hA hδ)
    have he : A * δ * (B * (2 : ℝ)^m) = A * B := by
      calc
        _ = A * B * (δ * (2 : ℝ)^m) := by ring
        _ = _ := by rw [show δ * (2 : ℝ)^m = 1 from inv_mul_cancel₀ (by positivity), mul_one]
    exact ht.trans (he.le.trans (mul_le_mul_of_nonneg_left (by nlinarith [mul_nonneg (show 0 ≤ (s.card : ℝ) by positivity) hB]) hA))
  · have hn (i : ι) (hi : i ∈ s) : n i < m :=
      lt_of_not_ge fun h => hsmall ⟨i, hi, h⟩
    have hm0 : 0 < m := by
      obtain ⟨i, hi⟩ := hs
      exact (Nat.zero_le _).trans_lt (hn i hi)
    have hU (k : ℕ) (hk : k ≤ T) (x : Ω) : |U k x| ≤ A :=
      abs_prod_le_pow _ _ (by norm_num) (fun i hi => h3 i hi k hk x)
    let G (x : Ω) := A * (6 * H x + 3 * ∑ i ∈ s, δ * (H x * pathVariation (L i) T x))
    have hG : Integrable G μ :=
      ((hHi.const_mul 6).add ((integrable_finsetSum s (fun i hi => (hLi i hi).const_mul δ)).const_mul 3)).const_mul A
    have hb (x : Ω) : |F x| ≤ G x := by
      unfold F G
      rw [abs_mul, abs_of_nonneg (hH0 x)]
      have hparts := abs_pathPairing_le_parts (fun k => U k x) (fun k => W k x) T
        hA (mul_nonneg (by norm_num) hδ) (fun k hk => hU k hk x) (fun k hk => hW hm0 k hk x)
      have hV := pathVariation_product_le s L T x (C := 3) (by norm_num)
        (fun i hi k hk => h3 i hi k hk x)
      have hparts' := hparts.trans (mul_le_mul_of_nonneg_left
        (add_le_add le_rfl hV) (mul_nonneg (by norm_num) hδ))
      refine (mul_le_mul_of_nonneg_left hparts' (hH0 x)).trans ?_
      have he : H x * (3 * δ * (2*A + A * ∑ i ∈ s, pathVariation (L i) T x)) =
          A * (6 * (δ * H x) + 3 * ∑ i ∈ s, δ * (H x * pathVariation (L i) T x)) := by
        simp only [← Finset.mul_sum, mul_assoc]
        ring
      rw [he]
      have hδH := mul_le_of_le_one_left (hH0 x) hδ1
      gcongr
    have h := integrable_and_abs_integral_le_of_abs_le hFm hG hb
    refine ⟨h.1, h.2.trans ?_⟩
    unfold G
    rw [integral_const_mul]
    have hterm (i : ι) (hi : i ∈ s) :
        (∫ x, δ * (H x * pathVariation (L i) T x) ∂μ) ≤ B := by
      rw [integral_const_mul]
      exact (mul_le_mul_of_nonneg_left (hLv i hi) hδ).trans (by
        rw [mul_left_comm]
        exact mul_le_of_le_one_right hB (scale_inverse_mul_pow_le (hn i hi).le))
    have hIntA : Integrable (fun x => 6 * H x) μ := hHi.const_mul 6
    have hIntB : Integrable (fun x => 3 * ∑ i ∈ s, δ * (H x * pathVariation (L i) T x)) μ :=
      (integrable_finsetSum _ (fun i hi => (hLi i hi).const_mul δ)).const_mul 3
    rw [integral_add hIntA hIntB, integral_const_mul, integral_const_mul,
      integral_finsetSum _ (fun i hi => (hLi i hi).const_mul δ)]
    have hsum := Finset.sum_le_sum (fun i hi => hterm i hi)
    rw [Finset.sum_const, nsmul_eq_mul] at hsum
    exact mul_le_mul_of_nonneg_left (by linarith) hA


private theorem weighted_recorded_sum_le {ι Ω : Type*} [Fintype ι] [Nonempty ι]
    [MeasurableSpace Ω] (μ : Measure Ω) (H : Ω → ℝ)
    (L : ι → Fin (N+1) → ℕ → Ω → ℝ) (W : Fin (N+1) → ℕ → Ω → ℝ)
    (T : ℕ) (B : ℝ) (hB : 0 ≤ B) (hH : Measurable H) (hHi : Integrable H μ)
    (hH0 : ∀ x, 0 ≤ H x) (hLm : ∀ i n k, Measurable (L i n k))
    (hWm : ∀ m k, Measurable (W m k))
    (hL : ∀ i n k, k ≤ T → ∀ x, |L i n k x| ≤ 3 * ((2 : ℝ)^(n : ℕ))⁻¹)
    (hW : ∀ m : Fin (N+1), 0 < (m : ℕ) → ∀ k, k ≤ T → ∀ x,
      |W m k x| ≤ 3 * ((2 : ℝ)^(m : ℕ))⁻¹)
    (hLi : ∀ i n, Integrable (fun x => H x * pathVariation (L i n) T x) μ)
    (hWi : ∀ m, Integrable (fun x => H x * pathVariation (W m) T x) μ)
    (hLv : ∀ i n, (∫ x, H x * pathVariation (L i n) T x ∂μ) ≤ B * (2 : ℝ)^(n : ℕ))
    (hWv : ∀ m, (∫ x, H x * pathVariation (W m) T x ∂μ) ≤ B * (2 : ℝ)^(m : ℕ)) :
    let F (x : Ω) := H x * pathPairing (fun k => ∏ i, ∑ n, L i n k x)
      (fun k => ∑ m, W m k x) T
    Integrable F μ ∧ |∫ x, F x ∂μ| ≤
      ((N+1 : ℕ) : ℝ) ^ (Fintype.card ι + 1) *
        3 ^ Fintype.card ι * (6 * (∫ x, H x ∂μ) + (3 * Fintype.card ι + 1) * B) := by
  classical
  dsimp only
  let G (n : ι → Fin (N+1)) (m : Fin (N+1)) (x : Ω) :=
    H x * pathPairing (fun k => ∏ i, L i (n i) k x) (fun k => W m k x) T
  have hG (n : ι → Fin (N+1)) (m : Fin (N+1)) :=
    weighted_layer_pairing_le (μ := μ) Finset.univ H hH hH0 hHi
      (fun i => L i (n i)) (W m) T (fun i => (n i : ℕ)) (m : ℕ) hB
      (fun i => hLm i (n i)) (hWm m) (fun i _ => hL i (n i)) (hW m)
      (fun i _ => hLi i (n i)) (hWi m) (fun i _ => hLv i (n i)) (hWv m) Finset.univ_nonempty
  have hexpand (x : Ω) :
      H x * pathPairing (fun k => ∏ i, ∑ n, L i n k x) (fun k => ∑ m, W m k x) T =
        ∑ n, ∑ m, G n m x := by
    simp only [G, pathPairing, ← Finset.sum_sub_distrib, Fintype.prod_sum, Finset.sum_mul,
      Finset.mul_sum]
    rw [Finset.sum_comm]
    rw [Finset.sum_congr rfl (fun m _ => Finset.sum_comm)]
    rw [Finset.sum_comm]
  have hi (n : ι → Fin (N+1)) (m : Fin (N+1)) : Integrable (G n m) μ := (hG n m).1
  simp_rw [hexpand]
  refine ⟨integrable_finsetSum _ (fun n _ => integrable_finsetSum _ (fun m _ => hi n m)), ?_⟩
  rw [integral_finsetSum _ (fun n _ => integrable_finsetSum _ (fun m _ => hi n m))]
  simp_rw [integral_finsetSum _ (fun m _ => hi _ m)]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  refine (Finset.sum_le_sum (fun n _ => Finset.abs_sum_le_sum_abs _ _)).trans ?_
  refine (Finset.sum_le_sum (fun n _ => Finset.sum_le_sum (fun m _ => (hG n m).2))).trans_eq ?_
  simp [Finset.sum_const, nsmul_eq_mul, Fintype.card_pi, pow_succ]
  ring


private theorem weighted_recording_error_le {ι Ω : Type*} [Fintype ι]
    [MeasurableSpace Ω] {μ : Measure Ω} (H : Ω → ℝ) (hH : Measurable H)
    (hHi : Integrable H μ) (hH0 : ∀ x, 0 ≤ H x)
    (L : ι → ℕ → Ω → ℝ) (W : ℕ → Ω → ℝ) (T N : ℕ) (B : ℝ)
    (hLm : ∀ i k, Measurable (L i k)) (hWm : ∀ k, Measurable (W k))
    (hL : ∀ i k x, |L i k x| ≤ 1)
    (hW : ∀ k x, |W k x| ≤ ((2 : ℝ)^N)⁻¹)
    (hLi : ∀ i, Integrable (fun x => H x * pathVariation (L i) T x) μ)
    (hLv : ∀ i, (∫ x, H x * pathVariation (L i) T x ∂μ) ≤ B * (2 : ℝ)^N) :
    let F (x : Ω) := H x * pathPairing (fun k => ∏ i, L i k x) (fun k => W k x) T
    Integrable F μ ∧ |∫ x, F x ∂μ| ≤ 2 * (∫ x, H x ∂μ) + Fintype.card ι * B := by
  classical
  dsimp only
  let δ := ((2 : ℝ)^N)⁻¹
  let G (x : Ω) := δ * (2 * H x + ∑ i, H x * pathVariation (L i) T x)
  have hδ : 0 ≤ δ := by dsimp [δ]; positivity
  have hδ1 : δ ≤ 1 := by
    simpa only [pow_zero, inv_one] using scale_inverse_le (n := 0) (Nat.zero_le N)
  have hU (k : ℕ) (x : Ω) : |∏ i, L i k x| ≤ 1 := by
    simpa only [one_pow] using
      abs_prod_le_pow Finset.univ (fun i => L i k x) zero_le_one (fun i _ => hL i k x)
  have hGi : Integrable G μ :=
    ((hHi.const_mul 2).add (integrable_finsetSum _ (fun i _ => hLi i))).const_mul δ
  have hb (x : Ω) :
      |H x * pathPairing (fun k => ∏ i, L i k x) (fun k => W k x) T| ≤ G x := by
    rw [abs_mul, abs_of_nonneg (hH0 x)]
    have hvar := pathVariation_product_le Finset.univ L T x le_rfl (fun i _ k _ => hL i k x)
    rw [one_pow, one_mul] at hvar
    have hp := abs_pathPairing_le_parts (fun k => ∏ i, L i k x) (fun k => W k x) T
      zero_le_one hδ (fun k _ => hU k x) (fun k _ => hW k x)
    have hs := mul_le_mul_of_nonneg_left (add_le_add_right hvar (2*1)) hδ
    exact (mul_le_mul_of_nonneg_left (hp.trans hs) (hH0 x)).trans_eq
        (by unfold G; rw [← Finset.mul_sum]; ring)
  have h := integrable_and_abs_integral_le_of_abs_le
    (hH.mul (measurable_pathPairing (fun k => Finset.measurable_fun_prod _ (fun i _ => hLm i k))
      hWm T)) hGi hb
  refine ⟨h.1, h.2.trans ?_⟩
  unfold G
  rw [integral_const_mul, integral_add (hHi.const_mul 2)
    (integrable_finsetSum _ (fun i _ => hLi i)), integral_const_mul,
    integral_finsetSum _ (fun i _ => hLi i), mul_add, Finset.mul_sum]
  apply add_le_add
  · exact mul_le_of_le_one_left (mul_nonneg (by norm_num) (integral_nonneg hH0)) hδ1
  · have hterm (i : ι) : δ * (∫ x, H x * pathVariation (L i) T x ∂μ) ≤ B := by
      refine (mul_le_mul_of_nonneg_left (hLv i) hδ).trans_eq ?_
      rw [← mul_left_comm B, show δ * (2 : ℝ)^N = 1 from inv_mul_cancel₀ (by positivity), mul_one]
    simpa only [Finset.sum_const, nsmul_eq_mul, Finset.card_univ] using
      Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hterm i)


private theorem weighted_recordedLayer_le {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (H : Ω → ℝ) (hH : Measurable H) (hH0 : ∀ x, 0 ≤ H x)
    (M : ℕ → Ω → ℝ) (hm : ∀ k, Measurable (M k)) (extinction : Bool) (T : ℕ)
    (B : ℝ) (hB : 0 ≤ B)
    (hI : ∀ j : ℕ, Integrable (fun x => H x *
      pathVariation (recordedPath M ((2 : ℝ)^j)⁻¹ extinction) T x) μ)
    (hV : ∀ j : ℕ, (∫ x, H x *
      pathVariation (recordedPath M ((2 : ℝ)^j)⁻¹ extinction) T x ∂μ) ≤ B * (2 : ℝ)^j)
    (j : ℕ) :
    Integrable (fun x => H x * pathVariation (recordedLayer M extinction j) T x) μ ∧
      (∫ x, H x * pathVariation (recordedLayer M extinction j) T x ∂μ) ≤
        (2 * B) * (2 : ℝ)^j := by
  cases j with
  | zero =>
    refine ⟨?_, ?_⟩
    · change Integrable (fun x => H x * pathVariation (recordedPath M 1 extinction) T x) μ
      simpa using hI 0
    · have h := hV 0
      change (∫ x, H x * pathVariation (recordedPath M 1 extinction) T x ∂μ) ≤ _
      simp only [pow_zero, inv_one, mul_one] at h ⊢
      linarith
  | succ j =>
    let A := recordedPath M ((2 : ℝ)^(j+1))⁻¹ extinction
    let C := recordedPath M ((2 : ℝ)^j)⁻¹ extinction
    let F (x : Ω) := H x * pathVariation (recordedLayer M extinction (j+1)) T x
    let G (x : Ω) := H x * pathVariation A T x + H x * pathVariation C T x
    have hF : Measurable F := hH.mul (Finset.measurable_fun_sum _ fun k _ =>
      continuous_abs.measurable.comp
        ((((measurable_recordedPath hm _ extinction (k+1)).sub
          (measurable_recordedPath hm _ extinction (k+1))).sub
          ((measurable_recordedPath hm _ extinction k).sub
          (measurable_recordedPath hm _ extinction k)))))
    have hG : Integrable G μ := (hI (j+1)).add (hI j)
    have hF0 (x : Ω) : 0 ≤ F x :=
      mul_nonneg (hH0 x) (Finset.sum_nonneg fun _ _ => abs_nonneg _)
    have hb (x : Ω) : F x ≤ G x := by
      unfold F G
      rw [← mul_add]
      apply mul_le_mul_of_nonneg_left _ (hH0 x)
      unfold pathVariation martingaleDifference
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_le_sum
      intro k _
      change |(A (k+1) x - C (k+1) x) - (A k x - C k x)| ≤ _
      rw [show (A (k+1) x - C (k+1) x) - (A k x - C k x) =
        (A (k+1) x - A k x) - (C (k+1) x - C k x) by ring]
      exact abs_sub _ _
    have h := integrable_and_abs_integral_le_of_abs_le hF hG
      (fun x => (abs_of_nonneg (hF0 x)).le.trans (hb x))
    refine ⟨h.1, (le_abs_self _).trans (h.2.trans ?_)⟩
    unfold G
    rw [integral_add (hI (j+1)) (hI j)]
    refine (add_le_add (hV (j+1)) (hV j)).trans ?_
    rw [pow_succ]
    nlinarith [mul_nonneg hB (show 0 ≤ (2 : ℝ)^j by positivity)]


/-- The pairing estimate for recorded low paths, in terms of their weighted variations. -/
theorem allCoarse_of_weightedVariation {ι Ω : Type*} [Fintype ι] [Nonempty ι]
    [MeasurableSpace Ω] {μ : Measure Ω} (H : Ω → ℝ) (hH : Measurable H)
    (hHi : Integrable H μ) (hH0 : ∀ x, 0 ≤ H x)
    (X : ι → ℕ → Ω → ℝ) (Y : ℕ → Ω → ℝ) (T N : ℕ) {B : ℝ} (hB : 0 ≤ B)
    (hXm : ∀ i k, Measurable (X i k)) (hYm : ∀ k, Measurable (Y k))
    (hX : ∀ i k x, X i k x ∈ Set.Icc (0 : ℝ) 1)
    (hXi : ∀ (i : ι) (j : ℕ), Integrable (fun x => H x *
      pathVariation (recordedPath (X i) ((2 : ℝ)^j)⁻¹ true) T x) μ)
    (hYi : ∀ j : ℕ, Integrable (fun x => H x *
      pathVariation (recordedPath Y ((2 : ℝ)^j)⁻¹ false) T x) μ)
    (hXv : ∀ (i : ι) (j : ℕ), (∫ x, H x *
      pathVariation (recordedPath (X i) ((2 : ℝ)^j)⁻¹ true) T x ∂μ) ≤ B * (2 : ℝ)^j)
    (hYv : ∀ j : ℕ, (∫ x, H x *
      pathVariation (recordedPath Y ((2 : ℝ)^j)⁻¹ false) T x ∂μ) ≤ B * (2 : ℝ)^j) :
    let δ := ((2 : ℝ)^N)⁻¹
    let F (x : Ω) := H x * pathPairing (fun k => ∏ i, recordedPath (X i) δ true k x)
      (fun k => Y k x) T
    Integrable F μ ∧ |∫ x, F x ∂μ| ≤
      ((N+1 : ℕ) : ℝ) ^ (Fintype.card ι + 1) * 3 ^ Fintype.card ι *
        (6 * (∫ x, H x ∂μ) + (3 * Fintype.card ι + 1) * (2 * B)) +
        (2 * (∫ x, H x ∂μ) + Fintype.card ι * B) := by
  classical
  dsimp only
  let δ := ((2 : ℝ)^N)⁻¹
  let Z (i : ι) := recordedPath (X i) δ true
  let W := recordedPath Y δ false
  let E (k : ℕ) (x : Ω) := Y k x - W k x
  have hZ (i : ι) (j k : ℕ) (x : Ω) :
      |recordedPath (X i) ((2 : ℝ)^j)⁻¹ true k x| ≤ 1 := by
    have h := recordedPath_mem_Icc (X i) ((2 : ℝ)^j)⁻¹ true (hX i) k x
    exact (abs_of_nonneg h.1).trans_le h.2
  have hLayerM (P : ℕ → Ω → ℝ) (hP : ∀ k, Measurable (P k)) (e : Bool) (j k : ℕ) :
      Measurable (recordedLayer P e j k) := by
    cases j with
    | zero => exact measurable_recordedPath hP 1 e k
    | succ j => exact (measurable_recordedPath hP _ e k).sub (measurable_recordedPath hP _ e k)
  have hLayerA (i : ι) (j k : ℕ) (x : Ω) :
      |recordedLayer (X i) true j k x| ≤ 3 * ((2 : ℝ)^j)⁻¹ := by
    cases j with
    | zero =>
      change |recordedPath (X i) 1 true k x| ≤ _
      simpa using (show |recordedPath (X i) ((2 : ℝ)^0)⁻¹ true k x| ≤ 3 from
        (hZ i 0 k x).trans (by norm_num))
    | succ j => exact abs_recordedLayer_succ_le (X i) true j k x
  have hLayerY (j : ℕ) (hj : 0 < j) (k : ℕ) (x : Ω) :
      |recordedLayer Y false j k x| ≤ 3 * ((2 : ℝ)^j)⁻¹ := by
    obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj.ne'
    exact abs_recordedLayer_succ_le Y false j k x
  have hL i j := weighted_recordedLayer_le H hH hH0 (X i) (hXm i) true T B hB (hXi i) (hXv i) j
  have hY j := weighted_recordedLayer_le H hH hH0 Y hYm false T B hB hYi hYv j
  have hr := weighted_recorded_sum_le μ H
    (fun i (j : Fin (N+1)) => recordedLayer (X i) true j)
    (fun (j : Fin (N+1)) => recordedLayer Y false j) T (2 * B) (by positivity)
    hH hHi hH0 (fun i j => hLayerM (X i) (hXm i) true j) (fun j => hLayerM Y hYm false j)
    (fun i j k _ => hLayerA i j k) (fun j hj k _ => hLayerY j hj k)
    (fun i j => (hL i j).1) (fun j => (hY j).1) (fun i j => (hL i j).2) (fun j => (hY j).2)
  dsimp only at hr
  have hlayerSum (P : ℕ → Ω → ℝ) (e : Bool) (k : ℕ) (x : Ω) :
      (∑ j : Fin (N+1), recordedLayer P e j k x) =
        recordedPath P δ e k x := by
    exact (Fin.sum_univ_eq_sum_range (fun j => recordedLayer P e j k x) (N+1)).trans
      (sum_recordedLayer P e N k x)
  simp_rw [hlayerSum] at hr
  have he := weighted_recording_error_le H hH hHi hH0 Z E T N B
    (fun i => measurable_recordedPath (hXm i) δ true)
    (fun k => (hYm k).sub (measurable_recordedPath hYm δ false k))
    (fun i => hZ i N) (fun k x => recordedPath_tracking Y (threshold := δ) (by dsimp [δ]; positivity) false k x)
    (fun i => hXi i N) (fun i => hXv i N)
  dsimp only at he
  let A (x : Ω) := H x * pathPairing (fun k => ∏ i, Z i k x) (fun k => W k x) T
  let D (x : Ω) := H x * pathPairing (fun k => ∏ i, Z i k x) (fun k => E k x) T
  have hsum (x : Ω) :
      H x * pathPairing (fun k => ∏ i, Z i k x) (fun k => Y k x) T = A x + D x := by
    unfold A D pathPairing
    rw [← mul_add, ← Finset.sum_add_distrib]
    congr 1
    apply Finset.sum_congr rfl
    intro k _
    dsimp [E]
    ring
  change Integrable A μ ∧ _ at hr
  change Integrable D μ ∧ _ at he
  change Integrable (fun x => H x * pathPairing (fun k => ∏ i, Z i k x) (fun k => Y k x) T) μ ∧ _
  rw [funext hsum]
  refine ⟨hr.1.add he.1, ?_⟩
  rw [integral_add hr.1 he.1]
  exact (abs_add_le _ _).trans (add_le_add hr.2 he.2)


noncomputable def recordingVariationConstant (q : ℝ) : ℝ :=
  2 * martingaleSquareMomentConstant (2*q)^(1/q) *
    (1 + (martingaleSquareMomentConstant (2*q)^(1/(2*q)))^2)^2 + 1

/-- The recording variation constant is positive. -/
theorem recordingVariationConstant_pos (q : ℝ) : 0 < recordingVariationConstant q := by
  unfold recordingVariationConstant
  positivity [martingaleSquareMomentConstant_pos (2*q)]

private theorem weighted_coordinateRecording_le {d : ℕ} (i : Fin d) (u : ℤ)
    (β : ℝ) (hβ : |β| ≤ 1) (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1)
    (T j : ℕ) (extinction : Bool) {q : ℝ} (hq : 1 < q)
    {A A₀ : Set (Fin d → ℝ)} (hA : MeasurableSet A) (hAf : volume A ≠ ⊤)
    (hA₀ : MeasurableSet A₀) (hA₀f : volume A₀ ≠ ⊤)
    {f H : (Fin d → ℝ) → ℝ} (hm : Measurable f) (h0 : ∀ x, 0 ≤ f x)
    (h1 : ∀ x, f x ≤ A.indicator (fun _ => 1) x)
    (hHm : Measurable H) (hH0 : ∀ x, 0 ≤ H x)
    (hH1 : ∀ x, H x ≤ A₀.indicator (fun _ => 1) x) :
    let P := coordinateMartingalePath i u β c f
    let Z := recordedPath P ((2 : ℝ)^j)⁻¹ extinction
    let F (x : Fin d → ℝ) := H x * pathVariation Z T x
    Integrable F volume ∧
      (∫ x, F x) ≤ recordingVariationConstant q *
        ((volume : Measure (Fin d → ℝ)).real A₀)^(1-1/q) *
        ((volume : Measure (Fin d → ℝ)).real A)^(1/q) * (2 : ℝ)^j := by
  dsimp only
  let δ := ((2 : ℝ)^j)⁻¹
  let P := coordinateMartingalePath i u β c f
  let Z := recordedPath P δ extinction
  let V := pathVariation Z T
  let r := Real.conjExponent q
  have hqr : q.HolderConjugate r := Real.HolderConjugate.conjExponent hq
  have hq0 : 0 < q := hqr.pos
  have hr0 : 0 < r := hqr.symm.pos
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hδ1 : δ ≤ 1 := by
    simpa only [pow_zero, inv_one] using scale_inverse_le (n := 0) (Nat.zero_le j)
  have hVp : MemLp V (ENNReal.ofReal q) volume := by
    have hf := (lpNorm_le_of_indicator hA hAf hm h0 h1 hq0).1
    have hZ (k : ℕ) : MemLp (Z k) (ENNReal.ofReal q) volume :=
      memLp_recordedPath (measurable_coordinateMartingalePath i u β c hm)
        (memLp_coordinateMartingalePath i u β c hm hq.le hf) δ extinction k
    exact memLp_finsetSum _ (fun k _ => ((hZ (k+1)).sub (hZ k)).norm)
  have hHp := lpNorm_le_of_indicator hA₀ hA₀f hHm hH0 hH1 hr0
  let _ := hqr.symm.ennrealOfReal
  have hi : Integrable (fun x => H x * V x) volume := hHp.1.integrable_mul hVp
  have hV0 (x : Fin d → ℝ) : 0 ≤ V x := Finset.sum_nonneg fun _ _ => abs_nonneg _
  have hVr : lpNorm V (ENNReal.ofReal q) volume ≤ recordingVariationConstant q *
      ((volume : Measure (Fin d → ℝ)).real A)^(1/q) * (2 : ℝ)^j := by
    have hs := (stoppedVar_supported i u β c hc T hA hAf hm h0 h1
      hδ.le hδ1 extinction hq.le).2
    change lpNorm (fun x => δ * V x) (ENNReal.ofReal q) volume ≤ _ at hs
    have hscale := lpNorm_const_smul (p := ENNReal.ofReal q) δ V volume
    rw [coe_nnnorm, Real.norm_of_nonneg hδ.le] at hscale
    change lpNorm (fun x => δ * V x) (ENNReal.ofReal q) volume = _ at hscale
    rw [hscale, ← le_div_iff₀' hδ, div_eq_mul_inv, show δ⁻¹ = (2 : ℝ)^j by simp [δ]] at hs
    refine hs.trans ?_
    gcongr
    unfold recordingVariationConstant
    gcongr
    positivity [martingaleSquareMomentConstant_pos (2*q)]
  have hnorm {g : (Fin d → ℝ) → ℝ} {p : ℝ} (hp : 0 < p)
      (hg : MemLp g (ENNReal.ofReal p) volume) (hg0 : ∀ x, 0 ≤ g x) :
      lpNorm g (ENNReal.ofReal p) volume = (∫ x, g x ^ p) ^ (1/p) := by
    rw [lpNorm_eq_integral_norm_rpow_toReal (by positivity) ENNReal.ofReal_ne_top
      hg.aestronglyMeasurable, ENNReal.toReal_ofReal hp.le]
    simp_rw [Real.norm_of_nonneg (hg0 _), one_div]
  have hholder := integral_mul_le_Lp_mul_Lq_of_nonneg hqr.symm
    (Filter.Eventually.of_forall hH0) (Filter.Eventually.of_forall hV0) hHp.1 hVp
  rw [← hnorm hr0 hHp.1 hH0, ← hnorm hq0 hVp hV0] at hholder
  have hexp : 1/r = 1-1/q := by
    have h := hqr.inv_add_inv_eq_one
    simp only [one_div]
    linarith
  refine ⟨hi, hholder.trans ?_⟩
  rw [hexp] at hHp
  exact (mul_le_mul hHp.2 hVr lpNorm_nonneg
    (Real.rpow_nonneg ENNReal.toReal_nonneg _)).trans_eq (by ring)


private theorem recording_weight_le {h R q K a : ℝ} (hh : 0 < h) (hR : 0 ≤ R)
    (hq : 0 < q) (hK : 0 ≤ K) (ha : a ≤ R*h) (ha0 : 0 ≤ a) (j : ℕ) :
    K * h^(1-1/q) * a^(1/q) * (2 : ℝ)^j ≤
      (K * (h * R^(1/q))) * (2 : ℝ)^j := by
  have hp := Real.rpow_le_rpow ha0 ha (by positivity : 0 ≤ 1/q)
  have he : K * h^(1-1/q) * (R*h)^(1/q) = K * (h * R^(1/q)) := by
    rw [Real.mul_rpow hR hh.le]
    calc
      _ = K * (h^(1-1/q) * h^(1/q)) * R^(1/q) := by ring
      _ = _ := by rw [← Real.rpow_add hh, sub_add_cancel, Real.rpow_one, mul_assoc]
  exact mul_le_mul_of_nonneg_right
    ((mul_le_mul_of_nonneg_left hp (mul_nonneg hK (Real.rpow_nonneg hh.le _))).trans_eq he)
    (by positivity)

set_option maxHeartbeats 700000 in
/-- The all-recorded term of the twisted dyadic form (blueprint `bp:all-coarse`). -/
theorem allCoarse {d : ℕ} (hd : 2 ≤ d) (b : Fin d) (u : ℤ)
    (T N : ℕ) (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1)
    {q : ℝ} (hq : 1 < q) {A₀ : Set (Fin d → ℝ)} (A : Fin d → Set (Fin d → ℝ))
    (hA₀ : MeasurableSet A₀) (hA₀f : volume A₀ ≠ ⊤)
    (hA : ∀ i, MeasurableSet (A i)) (hAf : ∀ i, volume (A i) ≠ ⊤)
    (f : Fin d → (Fin d → ℝ) → ℝ) (H : (Fin d → ℝ) → ℝ)
    (hf : ∀ i, Measurable (f i)) (hf0 : ∀ i x, 0 ≤ f i x)
    (hf1 : ∀ i x, f i x ≤ (A i).indicator (fun _ => 1) x)
    (hHm : Measurable H) (hH0 : ∀ x, 0 ≤ H x)
    (hH1 : ∀ x, H x ≤ A₀.indicator (fun _ => 1) x)
    (hpos : 0 < (volume : Measure (Fin d → ℝ)).real A₀)
    {R : ℝ} (hR : 1 ≤ R)
    (harea : ∀ i, (volume : Measure (Fin d → ℝ)).real (A i) ≤ R * volume.real A₀) :
    let δ := ((2 : ℝ)^N)⁻¹
    let Y := coordinateMartingalePath b u 0 c (f b)
    let F (x : Fin d → ℝ) := H x * pathPairing
      (fun k => ∏ i : {i : Fin d // i ≠ b}, recordedPath (coordinateLowPath i u (f i)) δ true k x)
      (fun k => Y k x) T
    let C := (3 : ℝ)^(d-1) * (6 + 2 * (3 * ((d-1 : ℕ) : ℝ) + 1) *
      recordingVariationConstant q) + (2 + ((d-1 : ℕ) : ℝ) * recordingVariationConstant q)
    Integrable F volume ∧
      |∫ x, F x| ≤ C * ((N+1 : ℕ) : ℝ)^d * volume.real A₀ * R^(1/q) := by
  classical
  dsimp only
  let ι := {i : Fin d // i ≠ b}
  let Y := coordinateMartingalePath b u 0 c (f b)
  let X (i : ι) := coordinateMartingalePath i u 1 (fun _ => 1) (f i)
  let h := (volume : Measure (Fin d → ℝ)).real A₀
  let S := h * R^(1/q)
  let K := recordingVariationConstant q
  let B := K * S
  have hK : 0 ≤ K := (recordingVariationConstant_pos q).le
  have hR0 : 0 ≤ R := zero_le_one.trans hR
  have hq0 : 0 < q := zero_lt_one.trans hq
  have hS : 0 ≤ S := mul_nonneg hpos.le (Real.rpow_nonneg hR0 _)
  have hB : 0 ≤ B := mul_nonneg hK hS
  have hcard : Fintype.card ι = d-1 := by
    change Fintype.card {i : Fin d // i ≠ b} = d-1
    rw [Fintype.card_subtype_compl (fun i : Fin d => i = b)]
    simp
  have : Nonempty ι := Fintype.card_pos_iff.mp (by rw [hcard]; omega)
  have hHi : Integrable H volume :=
    memLp_one_iff_integrable.mp (by simpa using
      (lpNorm_le_of_indicator hA₀ hA₀f hHm hH0 hH1 (show (0 : ℝ) < 1 by norm_num)).1)
  have hHbound : (∫ x, H x) ≤ S := by
    have hHle := integral_mono hHi (integrable_indicator_iff hA₀ |>.mpr
      (integrableOn_const hA₀f)) hH1
    have hpow : 1 ≤ R^(1/q) := Real.one_le_rpow hR (by positivity)
    exact (hHle.trans_eq (by rw [integral_indicator hA₀]; simp [h])).trans
      (le_mul_of_one_le_right hpos.le hpow)
  have hscale (i : Fin d) (j : ℕ) :
      K * h^(1-1/q) * volume.real (A i)^(1/q) * (2 : ℝ)^j ≤ B * (2 : ℝ)^j :=
    recording_weight_le hpos hR0 hq0 hK (harea i) ENNReal.toReal_nonneg j
  have hx (i : ι) (j : ℕ) := weighted_coordinateRecording_le (↑i) u 1 (by norm_num)
    (fun _ => 1) (by norm_num) T j true hq (hA i) (hAf i) hA₀ hA₀f
    (hf i) (hf0 i) (hf1 i) hHm hH0 hH1
  have hy (j : ℕ) := weighted_coordinateRecording_le b u 0 (by norm_num)
    c hc T j false hq (hA b) (hAf b) hA₀ hA₀f
    (hf b) (hf0 b) (hf1 b) hHm hH0 hH1
  have hX : X = fun (i : ι) => coordinateLowPath i u (f i) := by
    funext i k x
    change coordinateMartingalePath (i : Fin d) u 1 (fun _ => 1) (f i) k x =
      coordinateAverage (i : Fin d) (u + (k : ℤ)) (f i) x
    exact coordinateMartingalePath_average (i : Fin d) u (f i) k x
  have hXm (i : ι) (k : ℕ) : Measurable (X i k) :=
    measurable_coordinateMartingalePath (i : Fin d) u 1 (fun _ => 1) (hf i) k
  have hYm (k : ℕ) : Measurable (Y k) := measurable_coordinateMartingalePath b u 0 c (hf b) k
  have hX01 (i : ι) (k : ℕ) (x : Fin d → ℝ) : X i k x ∈ Icc (0 : ℝ) 1 := by
    rw [hX]
    change coordinateAverage (i : Fin d) (u + (k : ℤ)) (f i) x ∈ Icc (0 : ℝ) 1
    apply coordinateAverage_mem_Icc (i : Fin d) _ (hf i) _ x
    intro y
    refine ⟨hf0 i y, (hf1 i y).trans ?_⟩
    by_cases hm : y ∈ A i <;> simp [hm]
  have hXi (i : ι) (j : ℕ) : Integrable (fun x => H x *
      pathVariation (recordedPath (X i) ((2 : ℝ)^j)⁻¹ true) T x) volume := (hx i j).1
  have hYi (j : ℕ) : Integrable (fun x => H x *
      pathVariation (recordedPath Y ((2 : ℝ)^j)⁻¹ false) T x) volume := (hy j).1
  have hXv (i : ι) (j : ℕ) : (∫ x, H x *
      pathVariation (recordedPath (X i) ((2 : ℝ)^j)⁻¹ true) T x) ≤ B * (2 : ℝ)^j :=
    (hx i j).2.trans (hscale i j)
  have hYv (j : ℕ) : (∫ x, H x *
      pathVariation (recordedPath Y ((2 : ℝ)^j)⁻¹ false) T x) ≤ B * (2 : ℝ)^j :=
    (hy j).2.trans (hscale b j)
  have ha := allCoarse_of_weightedVariation H hHm hHi hH0 X Y T N hB
    hXm hYm hX01 hXi hYi hXv hYv
  dsimp only at ha
  rw [hX] at ha
  refine ⟨ha.1, ha.2.trans ?_⟩
  rw [hcard, show d-1+1 = d by omega]
  let P : ℝ := ((N+1 : ℕ) : ℝ)^d
  have hP : 1 ≤ P := by unfold P; exact one_le_pow₀ (by exact_mod_cast Nat.succ_pos N)
  have hcard0 : 0 ≤ ((d-1 : ℕ) : ℝ) := by positivity
  calc
    _ ≤ P * 3^(d-1) * (6 * S + (3 * ((d-1 : ℕ) : ℝ) + 1) * (2 * B)) +
        P * (2 * S + ((d-1 : ℕ) : ℝ) * B) := by
      refine add_le_add ?_ ?_
      · exact mul_le_mul_of_nonneg_left
          (add_le_add (mul_le_mul_of_nonneg_left hHbound (by norm_num)) le_rfl) (by positivity)
      · exact (add_le_add (mul_le_mul_of_nonneg_left hHbound (by norm_num)) le_rfl).trans
          (le_mul_of_one_le_left (by positivity) hP)
    _ = _ := by
      change P * 3^(d-1) * (6*S + (3 * ((d-1 : ℕ) : ℝ) + 1) * (2*B)) +
        P * (2*S + ((d-1 : ℕ) : ℝ)*B) =
          (3^(d-1) * (6 + 2 * (3 * ((d-1 : ℕ) : ℝ) + 1) * K) +
            (2 + ((d-1 : ℕ) : ℝ)*K)) * P * h * R^(1/q)
      unfold B S
      ring


/-- The drift is constant on each parent interval with transverse variables fixed. -/
theorem coordinateResidualDrift_constantOnCells {d : ℕ} (i : Fin d) (u : ℤ)
    (threshold : ℝ) (f : (Fin d → ℝ) → ℝ) (k : ℕ) :
    constantOnCoordinateCells i (u+k) (coordinateResidualDrift i u threshold f k) := by
  intro x t ht
  unfold coordinateResidualDrift
  rw [coordinateAverage_constantOnCells i (u+k) _ x t ht,
    coordinateResidual_constantOnCells i u threshold f k x t ht]

/-- The signed half-difference is constant on the parent intervals. -/
theorem coordinateHaarCoefficient_constantOnCells {d : ℕ} (i : Fin d) (k : ℤ)
    (f : (Fin d → ℝ) → ℝ) :
    constantOnCoordinateCells i k (coordinateHaarCoefficient i k f) := by
  intro x t ht
  simp only [coordinateHaarCoefficient, Function.update_self, Function.update_idem, ht]

/-- The integrated residual drift and Haar energy are controlled by the supporting area. -/
theorem residualDrift {d : ℕ} (i : Fin d) (u : ℤ) (T : ℕ)
    {A : Set (Fin d → ℝ)} (hA : MeasurableSet A) (hAf : volume A ≠ ⊤)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (hf0 : ∀ x, 0 ≤ f x)
    (hf1 : ∀ x, f x ≤ A.indicator (fun _ => 1) x)
    {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1) :
    let a := (volume : Measure (Fin d → ℝ)).real A
    let C := recordingVariationConstant 1
    (∑ k ∈ Finset.range T, lpNorm (coordinateResidualDrift i u δ f k) 1 volume) ≤ C * a / δ ∧
    (∑ k ∈ Finset.range T, ∫ x,
      coordinateHaarCoefficient i (u+k) (coordinateResidual i u δ f (k+1)) x ^ 2) ≤
        (2 + C) * a := by
  dsimp only
  let P := coordinateLowPath i u f
  let Z := recordedPath P δ true
  let a := (volume : Measure (Fin d → ℝ)).real A
  let K := martingaleSquareMomentConstant 2 * (1 + ((martingaleSquareMomentConstant 2)^(1/(2 : ℝ)))^2)^2
  have hpath : coordinateMartingalePath i u 1 (fun _ => 1) f = P := by
    funext k x
    change _ = coordinateAverage i (u + (k : ℤ)) f x
    exact coordinateMartingalePath_average i u f k x
  have h01 (x : Fin d → ℝ) : f x ∈ Icc (0 : ℝ) 1 := by
    refine ⟨hf0 x, (hf1 x).trans ?_⟩
    by_cases hx : x ∈ A <;> simp [hx]
  have hfL1 := lpNorm_le_of_indicator hA hAf hm hf0 hf1 (show (0 : ℝ) < 1 by norm_num)
  have hfL2 := lpNorm_le_of_indicator hA hAf hm hf0 hf1 (show (0 : ℝ) < 2 by norm_num)
  have hf1p : MemLp f 1 volume := by simpa using hfL1.1
  have hf2p : MemLp f 2 volume := by norm_num at hfL2; exact hfL2.1
  have h := stoppedVar_supported i u 1 (fun _ => 1) (by norm_num) T hA hAf hm hf0 hf1
    hδ.le hδ1 true (q := 1) le_rfl
  dsimp only at h
  rw [hpath] at h
  have hE : lpNorm (martingaleEnergy Z T) 1 volume ≤ K * a := by
    simpa [K, a] using h.1
  have hV : lpNorm (fun x => δ * pathVariation Z T x) 1 volume ≤ recordingVariationConstant 1 * a := by
    simpa [recordingVariationConstant, a] using h.2
  constructor
  · refine (residualDrift_sum_lpNorm_le i u δ hm h01 hf1p T).trans ?_
    have hs := lpNorm_const_smul (p := 1) δ (pathVariation Z T) volume
    rw [coe_nnnorm, Real.norm_of_nonneg hδ.le] at hs
    change lpNorm (fun x => δ * pathVariation Z T x) 1 volume = _ at hs
    rw [hs] at hV
    exact (le_div_iff₀' hδ).mpr hV
  · have hM (k : ℕ) : Measurable (P k) := measurable_coordinateAverage i _ hm
    have hZm := measurable_recordedPath hM δ true
    have hEm : Measurable (martingaleEnergy Z T) :=
      Finset.measurable_fun_sum _ (fun k _ => ((hZm (k+1)).sub (hZm k)).pow_const 2)
    have hEintegral : (∫ x, martingaleEnergy Z T x) ≤ K * a := by
      rw [lpNorm_one_eq_integral_norm hEm.aestronglyMeasurable] at hE
      simpa only [Real.norm_of_nonneg (martingaleEnergy_nonneg _ _ _)] using hE
    have hfSq : (∫ x, f x^2) ≤ a := by
      rw [← lpNorm_two_sq_eq_integral_sq hm.aestronglyMeasurable]
      have hL : lpNorm f 2 volume ≤ a^(1/(2 : ℝ)) := by exact_mod_cast hfL2.2
      refine (pow_le_pow_left₀ lpNorm_nonneg hL 2).trans_eq ?_
      rw [← Real.rpow_two, ← Real.rpow_mul (show 0 ≤ a from ENNReal.toReal_nonneg)]
      norm_num
    refine (residualDrift_sum_integral_sq_le i u hδ.le hm hf2p T).trans ?_
    have hb := mul_le_mul_of_nonneg_left (add_le_add hfSq hEintegral) (by norm_num : (0 : ℝ) ≤ 2)
    refine hb.trans ?_
    have hC : recordingVariationConstant 1 = 2*K+1 := by
      unfold recordingVariationConstant K
      simp [mul_assoc]
    rw [hC]
    linarith [show 0 ≤ a from ENNReal.toReal_nonneg]


/-- The residual is a measurable function on each level. -/
theorem measurable_coordinateResidual {d : ℕ} (i : Fin d) (u : ℤ)
    (δ : ℝ) {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (k : ℕ) :
    Measurable (coordinateResidual i u δ f k) :=
  (measurable_coordinateAverage i _ hm).sub
    (measurable_recordedPath (fun l => measurable_coordinateAverage i (u+l) hm) δ true k)

private theorem coordinateAverage_memLp {d : ℕ} (i : Fin d) (k : ℤ)
    {p : ℝ} (hp : 1 ≤ p) {f : (Fin d → ℝ) → ℝ}
    (hm : Measurable f) (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (coordinateAverage i k f) (ENNReal.ofReal p) volume :=
  (coordinateAverage_eLpNorm_le i k hp hm hf).trans_lt hf.eLpNorm_lt_top

/-- Each recorded residual is in the same directional (L^p) space as its input. -/
theorem memLp_coordinateResidual {d : ℕ} (i : Fin d) (u : ℤ) (δ : ℝ)
    {p : ℝ} (hp : 1 ≤ p) {f : (Fin d → ℝ) → ℝ}
    (hm : Measurable f) (hf : MemLp f (ENNReal.ofReal p) volume) (k : ℕ) :
    MemLp (coordinateResidual i u δ f k) (ENNReal.ofReal p) volume := by
  let X := coordinateLowPath i u f
  have hX (k : ℕ) : MemLp (X k) (ENNReal.ofReal p) volume := coordinateAverage_memLp i _ hp hm hf
  have hXm (k : ℕ) : Measurable (X k) := measurable_coordinateAverage i _ hm
  exact (hX k).sub (memLp_recordedPath hXm hX δ true k)

/-- The ordinary residual drift is measurable and integrable for integrable inputs. -/
theorem coordinateResidualDrift_regular {d : ℕ} (i : Fin d) (u : ℤ) (δ : ℝ)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (hf : Integrable f) (k : ℕ) :
    Measurable (coordinateResidualDrift i u δ f k) ∧ Integrable (coordinateResidualDrift i u δ f k) := by
  have hR := measurable_coordinateResidual i u δ hm
  have hLp := memLp_coordinateResidual i u δ (p := 1) le_rfl hm (by
    simpa only [ENNReal.ofReal_one] using memLp_one_iff_integrable.mpr hf)
  refine ⟨(measurable_coordinateAverage i _ (hR (k+1))).sub (hR k), ?_⟩
  apply memLp_one_iff_integrable.mp
  have he := (coordinateAverage_memLp i (u+k) le_rfl (hR (k+1)) (hLp (k+1))).sub (hLp k)
  rw [ENNReal.ofReal_one] at he
  exact he

private theorem measurable_own_dyadicHaar (k : ℤ) :
    Measurable (fun x : ℝ => dyadicHaar k (dyadicIndex k x) x) := by
  have h₀ : MeasurableSet {x : ℝ | dyadicIndex (k+1) x = 2 * dyadicIndex k x} :=
    measurableSet_eq_fun (measurable_dyadicIndex _) (measurable_const.mul (measurable_dyadicIndex _))
  have h₁ : MeasurableSet {x : ℝ | dyadicIndex (k+1) x = 2 * dyadicIndex k x+1} :=
    measurableSet_eq_fun (measurable_dyadicIndex _)
      ((measurable_const.mul (measurable_dyadicIndex _)).add_const 1)
  have hm : Measurable (({x : ℝ | dyadicIndex (k+1) x = 2 * dyadicIndex k x}).indicator (fun _ => (1 : ℝ)) -
      ({x : ℝ | dyadicIndex (k+1) x = 2 * dyadicIndex k x+1}).indicator (fun _ => (1 : ℝ))) :=
    (measurable_const.indicator h₀).sub (measurable_const.indicator h₁)
  convert hm using 1
  funext x
  simp only [dyadicHaar, Set.indicator, mem_dyadicInterval_iff, mem_ofPred_eq, Pi.sub_apply]

/-- A bounded measurable input has measurable Haar coefficients, and their squares are
integrable when the input is square-integrable. -/
theorem coordinateHaarCoefficient_regular {d : ℕ} (i : Fin d) (k : ℤ)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) {C : ℝ} (hf : ∀ x, |f x| ≤ C)
    (hLp : MemLp f 2 volume) :
    Measurable (coordinateHaarCoefficient i k f) ∧
      Integrable (fun x => (coordinateHaarCoefficient i k f x)^2) := by
  let H (x : Fin d → ℝ) := dyadicHaar k (dyadicIndex k (x i)) (x i)
  let D := coordinateDifference i k f
  have hH (x : Fin d → ℝ) : (H x)^2 = 1 := by
    rw [← sq_abs, abs_dyadicHaar_eq_one (mem_dyadicInterval_iff.mpr rfl), one_pow]
  have he (x : Fin d → ℝ) : coordinateHaarCoefficient i k f x = H x * D x := by
    have h := coordinateDifference_eq_haar i k (dyadicIndex k (x i))
      (mem_dyadicInterval_iff.mpr rfl) (boundedFiber_integrable i hm hf x k _)
    change D x = H x * coordinateHaarCoefficient i k f x at h
    rw [h, ← mul_assoc, ← pow_two, hH, one_mul]
  constructor
  · have hHm : Measurable H :=
      (measurable_own_dyadicHaar k).comp (measurable_pi_apply i)
    have hDm : Measurable D :=
      (measurable_coordinateAverage i (k+1) hm).sub (measurable_coordinateAverage i k hm)
    rw [funext he]
    exact hHm.mul hDm
  · have hAvg (l : ℤ) : MemLp (coordinateAverage i l f) 2 volume := by
      have h := coordinateAverage_memLp i l (p := 2) (by norm_num) hm (by simpa using hLp)
      simpa using h
    have hD : MemLp D 2 volume := (hAvg (k+1)).sub (hAvg k)
    simpa only [he, mul_pow, hH, one_mul] using hD.integrable_sq

/-- The contraction, tower, Haar representation, and square estimates for coordinate averages. -/
theorem haarSquare {d : ℕ} (i : Fin d) :
    (∀ (k : ℤ) (p : ℝ), 1 ≤ p → ∀ f : (Fin d → ℝ) → ℝ, Measurable f →
      MemLp f (ENNReal.ofReal p) volume →
      eLpNorm (coordinateAverage i k f) (ENNReal.ofReal p) volume ≤ eLpNorm f (ENNReal.ofReal p) volume) ∧
    (∀ (j k : ℤ) (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ),
      Integrable (fun y => f (Function.update x i y)) →
      coordinateAverage i j (coordinateAverage i k f) x = coordinateAverage i (min j k) f x) ∧
    (∀ (k n : ℤ) (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ), x i ∈ dyadicInterval k n →
      IntegrableOn (fun y => f (Function.update x i y)) (dyadicInterval k n) →
      coordinateDifference i k f x =
        dyadicHaar k n (x i) * (((2 : ℝ)^(-k))⁻¹ *
          ∫ y in dyadicInterval k n, dyadicHaar k n y * f (Function.update x i y))) ∧
    (∀ (u : ℤ) (N : ℕ) (f : (Fin d → ℝ) → ℝ), Measurable f → MemLp f 2 volume →
      (∑ n ∈ Finset.range N, ∫ x, (coordinateDifference i (u+n) f x)^2) ≤ ∫ x, (f x)^2) ∧
    ∀ (a b : ℝ), a < b → ∀ f : ℝ → ℝ, IntegrableOn f (Ico a b) →
      let c := (a+b)/2
      ((intervalAverage a c f)^2+(intervalAverage c b f)^2)/2-(intervalAverage a b f)^2 =
        ((intervalAverage a c f-intervalAverage c b f)/2)^2 :=
  ⟨fun k _ hp _ hm hf => coordinateAverage_eLpNorm_le i k hp hm hf,
    fun j k _ _ hf => coordinateAverage_tower i j k hf,
    fun k n _ _ hx hf => coordinateDifference_eq_haar i k n hx hf,
    fun u N _ hm hf => coordinateDifference_sum_integral_sq_le i u N hm hf,
    fun _ _ hab _ hf => haarSquare_children hab hf⟩

/-- The directional weak maximal bound and almost-everywhere dyadic differentiation. -/
theorem dyadicMax {d : ℕ} (i : Fin d) {f : (Fin d → ℝ) → ℝ}
    (hm : Measurable f) (hf : Integrable f) :
    (∀ t : ℝ, 0 < t →
      volume (coordinateMaxLevel i f t) ≤ (ENNReal.ofReal t)⁻¹ * ∫⁻ x, ‖f x‖ₑ) ∧
    ∀ᵐ x ∂(volume : Measure (Fin d → ℝ)),
      Filter.Tendsto (fun k : ℤ => coordinateAverage i k f x) Filter.atTop (nhds (f x)) :=
  ⟨fun _ ht => volume_coordinateMaxLevel_le i hm hf ht, ae_tendsto_coordinateAverage i hm hf⟩

