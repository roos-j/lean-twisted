theorem physicalIntegrable_fourier {d : ℕ} {L : E d → ℂ} (hL : Integrable L)
    (hLm : Measurable L) (f : Fin d → SchwartzMap (E d) ℂ) (x : E d) :
    physicalKernelApply L (fun i => f i) x = twisted (𝓕 L) f x := by
  let X (y : E d) (i : Fin d) := x - y i • EuclideanSpace.single i 1
  let F (i : Fin d) := (𝓕 (f i) : SchwartzMap (E d) ℂ)
  let H (z : E d × (Fin d → E d)) :=
    L z.1 * ∏ i, (inverseFourierPhase (z.2 i) (X z.1 i) * F i (z.2 i))
  have hX (i : Fin d) : Continuous (fun y => X y i) :=
    continuous_const.sub ((EuclideanSpace.proj (𝕜 := ℝ) i).continuous.smul continuous_const)
  have hPh (i : Fin d) : Continuous
      (fun z : E d × (Fin d → E d) => inverseFourierPhase (z.2 i) (X z.1 i)) := by
    unfold inverseFourierPhase
    have hin : Continuous (fun z : E d × (Fin d → E d) => inner ℝ (z.2 i) (X z.1 i)) :=
      ((continuous_apply i).comp continuous_snd).inner ((hX i).comp continuous_fst)
    fun_prop
  have hH : Measurable H := (hLm.comp measurable_fst).mul
    (Finset.measurable_prod _ fun i _ => (hPh i).measurable.mul
      ((F i).continuous.measurable.comp ((measurable_pi_apply i).comp measurable_snd)))
  have hI : Integrable H (volume.prod volume) := by
    have hF : Integrable (fun ξ : Fin d → E d => ∏ i, ‖F i (ξ i)‖) :=
      Integrable.fintype_prod (μ := fun _ : Fin d => (volume : Measure (E d)))
        fun i => (F i).integrable.norm
    apply (hL.norm.mul_prod hF).mono' hH.aestronglyMeasurable
    filter_upwards [] with z
    change ‖L z.1 * ∏ i, (inverseFourierPhase (z.2 i) (X z.1 i) * F i (z.2 i))‖ ≤ _
    simp only [norm_mul, norm_prod, inverseFourierPhase_norm, one_mul]
    rfl
  have hInv (y : E d) (i : Fin d) : f i (X y i) = ∫ ξ, inverseFourierPhase ξ (X y i)*F i ξ := by
    have he : 𝓕⁻ (F i : E d → ℂ) = (f i : E d → ℂ) :=
      (f i).continuous.fourierInv_fourier_eq (f i).integrable (F i).integrable
    exact (congrFun he (X y i)).symm.trans (Real.fourierInv_eq' _ _)
  change (∫ y, L y * ∏ i, f i (X y i)) = _
  simp_rw [hInv, ← integral_fintype_prod_volume_eq_prod, ← integral_const_mul]
  change (∫ y, ∫ ξ, H (y,ξ)) = _
  rw [integral_integral_swap hI]
  simp only [twisted_eq_integral]
  apply integral_congr_ae
  filter_upwards [] with ξ
  let e (y : E d) := Complex.exp ((↑(-2*Real.pi*inner ℝ (diagonalFrequency ξ) y):ℂ)*Complex.I)
  have hFourier : (∫ y, L y * e y) = 𝓕 L (diagonalFrequency ξ) := by
    rw [Real.fourier_eq']
    simp_rw [smul_eq_mul]
    apply integral_congr_ae
    filter_upwards [] with y
    unfold e
    rw [real_inner_comm, mul_comm (L y)]
  have hPhase (y : E d) :
      (∏ i, inverseFourierPhase (ξ i) (X y i)) =
        (∏ i, inverseFourierPhase (ξ i) x) * e y := by
    unfold inverseFourierPhase e
    rw [← Complex.exp_sum, ← Complex.exp_sum, ← Complex.exp_add]
    congr 1
    simp only [X, physical_shift_inner]
    rw [PiLp.inner_apply (𝕜 := ℝ)]
    simp only [diagonalFrequency, WithLp.ofLp_toLp]
    push_cast
    simp only [Finset.mul_sum, Finset.sum_mul, mul_sub, Finset.sum_sub_distrib]
    simp only [RCLike.inner_apply, conj_trivial, Complex.ofReal_mul, sub_eq_add_neg]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  have hH' (y : E d) : H (y,ξ) =
      (L y * e y) * (∏ i, inverseFourierPhase (ξ i) x) * (∏ i, F i (ξ i)) := by
    change L y * (∏ i, (inverseFourierPhase (ξ i) (X y i) * F i (ξ i))) = _
    rw [Finset.prod_mul_distrib, hPhase]
    ring
  simp_rw [hH', integral_mul_const, hFourier, ← separated_fourierPhase]
  unfold fourierIntegrand F
  ring

private theorem physical_weighted_moment {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {r : ℝ} (hr : 1 < r) {L V : α → ℂ} (hL : Measurable L) (hV : Measurable V) :
    ‖∫ y, L y * V y ∂μ‖ₑ ^ r ≤
      (∫⁻ y, ‖L y‖ₑ ∂μ) ^ (r-1) * ∫⁻ y, ‖L y‖ₑ * ‖V y‖ₑ ^ r ∂μ := by
  let q := Real.conjExponent r
  have hc : q.HolderConjugate r := (Real.HolderConjugate.conjExponent hr).symm
  have hr₀ := hc.symm.pos
  have hq₀ := hc.pos
  have hsplit (y : α) : ‖L y‖ₑ * ‖V y‖ₑ =
      ‖L y‖ₑ ^ (1/q) * (‖L y‖ₑ ^ (1/r) * ‖V y‖ₑ) := by
    rw [← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity),
      hc.one_div_add_one_div, div_one, ENNReal.rpow_one]
  have hh := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hc
    (hL.enorm.pow_const (1/q)).aemeasurable
    ((hL.enorm.pow_const (1/r)).mul hV.enorm).aemeasurable
  have he₁ (y : α) : (‖L y‖ₑ ^ (1/q))^q = ‖L y‖ₑ := by
    rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq₀.ne', ENNReal.rpow_one]
  have he₂ (y : α) : (‖L y‖ₑ ^ (1/r) * ‖V y‖ₑ)^r = ‖L y‖ₑ * ‖V y‖ₑ^r := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hr₀.le, ← ENNReal.rpow_mul, one_div,
      inv_mul_cancel₀ hr₀.ne', ENNReal.rpow_one]
  simp_rw [Pi.mul_apply, he₁, he₂] at hh
  have hnorm := enorm_integral_le_lintegral_enorm (μ := μ) (fun y => L y * V y)
  simp_rw [enorm_mul, hsplit] at hnorm
  have hh' := ENNReal.rpow_le_rpow (hnorm.trans hh) hr₀.le
  rw [ENNReal.mul_rpow_of_nonneg _ _ hr₀.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
    show 1/r*r = 1 by field_simp, ENNReal.rpow_one] at hh'
  have he : 1/q*r = r-1 := by
    have h := hc.one_div_add_one_div
    have h' : 1/q = 1-1/r := by linarith
    rw [h']
    field_simp
  rwa [he] at hh'

set_option maxHeartbeats 900000 in
theorem physicalIntegrable {d : ℕ} {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hs : r⁻¹ = ∑ i, (p i)⁻¹)
    {L : E d → ℂ} (hL : Integrable L) (hLm : Measurable L)
    (f : Fin d → E d → ℂ) (hf : ∀ i, Measurable (f i)) :
    eLpNorm (physicalKernelApply L f) (ENNReal.ofReal r) volume ≤
      eLpNorm L 1 volume * ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  let V (x y : E d) := ∏ i, f i (x-y i • EuclideanSpace.single i 1)
  let A := ∫⁻ y, ‖L y‖ₑ
  let B := ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume
  have hV : Measurable (Function.uncurry V) := by
    apply Finset.measurable_prod
    intro i _
    exact (hf i).comp (measurable_fst.sub
      (((EuclideanSpace.proj (𝕜 := ℝ) i).continuous.measurable.comp measurable_snd).smul measurable_const))
  have hA : A ≠ ∞ := hL.hasFiniteIntegral.ne
  have hr₀ : 0 < r := zero_lt_one.trans hr
  have hE (y : E d) : eLpNorm (fun x => V x y) (ENNReal.ofReal r) volume ≤ B := by
    let G (i : Fin d) (x : E d) := ‖f i (x-y i • EuclideanSpace.single i 1)‖
    have hG (i : Fin d) : Measurable (G i) := (hf i).norm.comp (measurable_id.sub measurable_const)
    have hB (i : Fin d) :
        eLpNorm (G i) (ENNReal.ofReal (p i)) volume =
          eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
      rw [← eLpNorm_norm (f i) (hf i).aestronglyMeasurable]
      have he : G i = (fun x => ‖f i x‖) ∘ (fun x => x + -(y i • EuclideanSpace.single i 1)) := by
        funext x
        simp [G, sub_eq_add_neg]
      rw [he]
      exact eLpNorm_comp_measurePreserving (hf i).norm.aestronglyMeasurable
        (measurePreserving_add_right (volume : Measure (E d)) (-(y i • EuclideanSpace.single i 1)))
    have h := eLpNorm_finite_product_le (μ := volume) Finset.univ
      (fun i => ENNReal.ofReal (p i)) G hG
    rw [finiteProfileExponent hp hr hs] at h
    rw [← eLpNorm_norm (fun x => V x y)
      (hV.comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable]
    simpa only [V, norm_prod, G, hB] using h
  have hm : AEStronglyMeasurable (physicalKernelApply L f) volume :=
    (hLm.comp measurable_snd).stronglyMeasurable.mul hV.stronglyMeasurable |>.integral_prod_right.aestronglyMeasurable
  have hR := ENNReal.ofReal_ne_zero_iff.mpr hr₀
  have hPow (y : E d) : (∫⁻ x, ‖V x y‖ₑ^r) ≤ B^r := by
    have h := ENNReal.rpow_le_rpow (hE y) hr₀.le
    have hM : Measurable (fun x => V x y) := hV.comp (measurable_id.prodMk measurable_const)
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hR ENNReal.ofReal_ne_top hM.aestronglyMeasurable,
      ENNReal.toReal_ofReal hr₀.le, ← ENNReal.rpow_mul,
      show 1/r*r = 1 by field_simp, ENNReal.rpow_one] at h
    exact h
  have hMoment : (∫⁻ x, ‖physicalKernelApply L f x‖ₑ^r) ≤ (A*B)^r := by
    calc
      _ ≤ ∫⁻ x, A^(r-1) * ∫⁻ y, ‖L y‖ₑ * ‖V x y‖ₑ^r :=
        lintegral_mono fun x => physical_weighted_moment hr hLm
          (hV.comp (measurable_const.prodMk measurable_id))
      _ = A^(r-1) * ∫⁻ y, ‖L y‖ₑ * ∫⁻ x, ‖V x y‖ₑ^r := by
        rw [lintegral_const_mul' _ _ (ENNReal.rpow_lt_top_of_nonneg (by linarith) hA).ne,
          lintegral_lintegral_swap ((hLm.comp measurable_snd).enorm.mul
            (hV.enorm.pow_const r)).aemeasurable]
        congr 1
        apply lintegral_congr
        intro y
        have hM : Measurable (fun x => ‖V x y‖ₑ^r) :=
          ((hV.comp (measurable_id.prodMk measurable_const)).enorm.pow_const r)
        exact lintegral_const_mul _ hM
      _ ≤ A^(r-1) * (A*B^r) := by
        apply mul_le_mul_right
        rw [← lintegral_mul_const _ hLm.enorm]
        exact lintegral_mono fun y => mul_le_mul_right (hPow y) _
      _ = (A*B)^r := by
        rw [← mul_assoc, ENNReal.mul_rpow_of_nonneg _ _ hr₀.le]
        congr 1
        conv_lhs => arg 2; rw [← ENNReal.rpow_one A]
        rw [← ENNReal.rpow_add_of_nonneg _ _ (by linarith) (by norm_num), show r-1+1 = r by ring]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hR ENNReal.ofReal_ne_top hm,
    ENNReal.toReal_ofReal hr₀.le, eLpNorm_one_eq_lintegral_enorm hL.aestronglyMeasurable]
  have h := ENNReal.rpow_le_rpow hMoment (one_div_nonneg.mpr hr₀.le)
  rw [one_div, ENNReal.rpow_rpow_inv hr₀.ne'] at h
  simpa only [one_div, A, B] using h

private theorem dyadicGeometric_summable {a b : ℕ} (ha : 0 < a) (hb : 0 < b) :
    Summable (fun k : ℤ =>
      if 0 ≤ k then ((2:ℝ)^b)⁻¹ ^ k.toNat else ((2:ℝ)^a)⁻¹ ^ k.natAbs) := by
  have h (j : ℕ) (hj : 0 < j) : Summable (fun n : ℕ => ((2:ℝ)^j)⁻¹ ^ n) :=
    summable_geometric_of_lt_one (by positivity)
      (inv_lt_one_of_one_lt₀ (one_lt_pow₀ (by norm_num) hj.ne'))
  rw [summable_int_iff_summable_nat_and_neg]
  constructor
  · simpa using h b hb
  · rw [← summable_nat_add_iff 1]
    convert (h a ha).mul_right ((2:ℝ)^a)⁻¹ using 1
    funext n
    have hn : ¬ (0:ℤ) ≤ -(↑(n+1):ℤ) := by omega
    rw [if_neg hn, Int.natAbs_neg, Int.natAbs_natCast, pow_succ]

private theorem dyadicGeometric_hasSum : ∀ {a b : ℕ}, 0 < a → 0 < b →
    Summable (fun k : ℤ => if 0 ≤ k then (2:ℝ)^(-k*(b:ℤ)) else (2:ℝ)^(k*(a:ℤ))) := by
  intro a b ha hb
  convert dyadicGeometric_summable ha hb using 1
  funext k
  split_ifs with hk
  · rw [neg_mul, mul_comm, zpow_neg, zpow_mul, zpow_natCast]
    conv_lhs => rw [← Int.toNat_of_nonneg hk, zpow_natCast]
    rw [inv_pow]
  · have he : k = -(k.natAbs:ℤ) := by omega
    conv_lhs => rw [he]
    rw [neg_mul, mul_comm, zpow_neg, zpow_mul, zpow_natCast, zpow_natCast, inv_pow]

private theorem dyadicKernel_summable {a b : ℕ} (ha : 0 < a) (hb : 0 < b)
    {ρ : ℝ} (hρ : 0 < ρ) {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) :
    Summable (fun k : ℤ => min (A*(2:ℝ)^(k*(a:ℤ)))
      (B*(2:ℝ)^(-k*(b:ℤ))/ρ^(a+b))) := by
  let D := A+B/ρ^(a+b)
  have hD : 0 ≤ D := by dsimp [D]; positivity
  apply ((dyadicGeometric_hasSum ha hb).mul_left D).of_nonneg_of_le
  · intro k
    apply le_min <;> positivity
  · intro k
    split_ifs with hk
    · exact (min_le_right _ _).trans (by
        rw [mul_div_right_comm]
        exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_left hA) (by positivity))
    · exact (min_le_left _ _).trans
        (mul_le_mul_of_nonneg_right (le_add_of_nonneg_right (by positivity : 0 ≤ B/ρ^(a+b))) (by positivity))

private theorem dyadicScale_exists {ρ : ℝ} (hρ : 0 < ρ) :
    ∃ j : ℤ, ρ*(2:ℝ)^j ≤ 1 ∧ 1 < 2*(ρ*(2:ℝ)^j) := by
  let s := Real.log (ρ⁻¹)/Real.log 2
  let j : ℤ := ⌊s⌋
  have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have h₁ : (2:ℝ)^j ≤ ρ⁻¹ := by
    apply (Real.log_le_log_iff (by positivity) (inv_pos.mpr hρ)).mp
    rw [Real.log_zpow]
    exact (le_div_iff₀ hlog).mp (Int.floor_le s)
  have h₂ : ρ⁻¹ < (2:ℝ)^(j+1) := by
    apply (Real.log_lt_log_iff (inv_pos.mpr hρ) (by positivity)).mp
    rw [Real.log_zpow, Int.cast_add, Int.cast_one]
    exact (div_lt_iff₀ hlog).mp (Int.lt_floor_add_one s)
  refine ⟨j, ?_, ?_⟩
  · exact (mul_le_mul_of_nonneg_left h₁ hρ.le).trans_eq (mul_inv_cancel₀ hρ.ne')
  · rw [zpow_add₀ (by norm_num : (2:ℝ) ≠ 0), zpow_one] at h₂
    calc
      1 = ρ*ρ⁻¹ := (mul_inv_cancel₀ hρ.ne').symm
      _ < ρ*((2:ℝ)^j*2) := mul_lt_mul_of_pos_left h₂ hρ
      _ = 2*(ρ*(2:ℝ)^j) := by ring

private theorem dyadicKernel_tsum_le {a b : ℕ} (ha : 0 < a) (hb : 0 < b)
    {ρ : ℝ} (hρ : 0 < ρ) {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) :
    (∑' k : ℤ, min (A*(2:ℝ)^(k*(a:ℤ))) (B*(2:ℝ)^(-k*(b:ℤ))/ρ^(a+b))) ≤
      (A+B*2^b)*ρ⁻¹^a *
        ∑' k : ℤ, if 0 ≤ k then (2:ℝ)^(-k*(b:ℤ)) else (2:ℝ)^(k*(a:ℤ)) := by
  obtain ⟨j,hj₁,hj₂⟩ := dyadicScale_exists hρ
  let m (k : ℤ) := min (A*(2:ℝ)^(k*(a:ℤ))) (B*(2:ℝ)^(-k*(b:ℤ))/ρ^(a+b))
  let w (k : ℤ) := if 0 ≤ k then (2:ℝ)^(-k*(b:ℤ)) else (2:ℝ)^(k*(a:ℤ))
  let C := (A+B*2^b)*ρ⁻¹^a
  change ∑' k, m k ≤ C * ∑' k, w k
  rw [← tsum_mul_left]
  have he : (∑' k, m (k+j)) = ∑' k, m k := (Equiv.addRight j).tsum_eq m
  rw [← he]
  apply ((dyadicKernel_summable ha hb hρ hA hB).comp_injective (Equiv.addRight j).injective).tsum_le_tsum
    _ ((dyadicGeometric_hasSum ha hb).mul_left C)
  intro k
  have hs : (2:ℝ)^j ≤ ρ⁻¹ := by
    rw [← one_div]
    exact (le_div_iff₀ hρ).mpr (by simpa [mul_comm] using hj₁)
  have ht : ((2:ℝ)^j)⁻¹ ≤ 2*ρ := by
    rw [← one_div]
    apply (div_le_iff₀ (by positivity : 0 < (2:ℝ)^j)).mpr
    linarith only [hj₂]
  change m (k+j) ≤ C * (if 0 ≤ k then _ else _)
  split_ifs with hk
  · refine (min_le_right _ _).trans ?_
    have ht' := pow_le_pow_left₀ (by positivity : 0 ≤ ((2:ℝ)^j)⁻¹) ht b
    dsimp only [C]
    rw [show -(k+j)*(b:ℤ) = -k*(b:ℤ)+(-j)*(b:ℤ) by ring, zpow_add₀ (by norm_num : (2:ℝ) ≠ 0),
      zpow_mul (2:ℝ) (-j) (b:ℤ), zpow_neg, zpow_natCast]
    calc
      _ ≤ B*((2:ℝ)^(-k*(b:ℤ))*(2*ρ)^b)/ρ^(a+b) := by gcongr
      _ = (B*2^b)*ρ⁻¹^a*(2:ℝ)^(-k*(b:ℤ)) := by
        rw [mul_pow, pow_add, inv_pow]
        field_simp [hρ.ne']
      _ ≤ _ := by gcongr; exact le_add_of_nonneg_left hA
  · refine (min_le_left _ _).trans ?_
    have hs' := pow_le_pow_left₀ (by positivity : 0 ≤ (2:ℝ)^j) hs a
    dsimp only [C]
    rw [show (k+j)*(a:ℤ) = k*(a:ℤ)+j*(a:ℤ) by ring, zpow_add₀ (by norm_num : (2:ℝ) ≠ 0),
      zpow_mul (2:ℝ) j (a:ℤ), zpow_natCast]
    calc
      _ ≤ A*((2:ℝ)^(k*(a:ℤ))*ρ⁻¹^a) := by gcongr
      _ = A*ρ⁻¹^a*(2:ℝ)^(k*(a:ℤ)) := by ring
      _ ≤ _ := by
        gcongr
        exact le_add_of_nonneg_right (by positivity)

open MikhlinHormander LittlewoodPaley in
private noncomputable def rawKernelPiece {d : ℕ} (C : lpCutoffs d)
    (m : E d → ℂ) (k : ℤ) : E d → ℂ :=
  𝓕⁻ (fun ξ => intDyadicBandpassMultiplier C.cutoff k ξ * m ξ)

open MikhlinHormander LittlewoodPaley in
private theorem rawKernelPiece_estimates {d N : ℕ} (C : lpCutoffs d)
    (hN : d < N) :
    ∃ P Q P' Q' : ℝ, 0 ≤ P ∧ 0 ≤ Q ∧ 0 ≤ P' ∧ 0 ≤ Q' ∧
      ∀ (m : E d → ℂ) (A : ℝ), 0 ≤ A → MikhlinCondition N m A →
      (∀ k, ContDiff ℝ 1 (rawKernelPiece C m k)) ∧
      ∀ k (x : E d), x ≠ 0 →
        ‖rawKernelPiece C m k x‖ ≤ min (P*A*(2:ℝ)^(k*(d:ℤ)))
          (Q*A*(2:ℝ)^(-k*((N:ℤ)-d))/‖x‖^N) ∧
        ‖fderiv ℝ (rawKernelPiece C m k) x‖ ≤ min (P'*A*(2:ℝ)^(k*((d:ℤ)+1)))
          (Q'*A*(2:ℝ)^(-k*((N:ℤ)-(d+1)))/‖x‖^N) := by
  let P := normalizedMikhlinKernelFrequencyL1Bound (N := N) C 1
  let Q := normalizedMikhlinKernelIBPBound (N := N) C 1
  let P' := normalizedMikhlinKernelDerivativeFrequencyL1Bound (N := N) C 1
  let Q' := normalizedMikhlinKernelDerivativeIBPBound (N := N) C 1
  have hc : 0 ≤ schwartzWeightedCutoffDerivativeConstant (N := N)
      (integerDyadicBandpassPrototype C.cutoff) := by
    unfold schwartzWeightedCutoffDerivativeConstant
    positivity
  refine ⟨P,Q,P',Q',?_,?_,?_,?_,?_⟩
  · dsimp [P, normalizedMikhlinKernelFrequencyL1Bound]
    positivity
  · dsimp [Q, normalizedMikhlinKernelIBPBound]
    positivity
  · dsimp [P', normalizedMikhlinKernelDerivativeFrequencyL1Bound]
    positivity
  · dsimp [Q', normalizedMikhlinKernelDerivativeIBPBound]
    positivity
  intro m A hA hm
  have hmP : normalizedMikhlinKernelFrequencyL1Bound (N := N) C A = P*A := by
    dsimp [P, normalizedMikhlinKernelFrequencyL1Bound]
    ring
  have hmQ : normalizedMikhlinKernelIBPBound (N := N) C A = Q*A := by
    unfold Q normalizedMikhlinKernelIBPBound
    rw [mul_assoc, Finset.sum_mul]
    simp only [one_mul]
    congr 1
    apply Finset.sum_congr rfl
    intro n _
    ring
  have hmP' : normalizedMikhlinKernelDerivativeFrequencyL1Bound (N := N) C A = P'*A := by
    dsimp [P', normalizedMikhlinKernelDerivativeFrequencyL1Bound]
    ring
  have hmQ' : normalizedMikhlinKernelDerivativeIBPBound (N := N) C A = Q'*A := by
    unfold Q' normalizedMikhlinKernelDerivativeIBPBound
    conv_rhs => rw [mul_assoc, Finset.sum_mul]
    congr 1
    apply Finset.sum_congr rfl
    intro n _
    ring
  let G (k : ℤ) := normalizedIntDyadicMikhlinPiece C m k
  let D (k : ℤ) := VectorFourier.fourierSMulRight (-innerSL ℝ) (G k)
  let R (k : ℤ) := (2:ℝ)^k
  have hR (k : ℤ) : 0 < R k := by dsimp only [R]; positivity
  have hG (k : ℤ) := contDiff_hasCompactSupport_normalizedIntDyadicMikhlinPiece C m k hm
  have hC (k : ℤ) : ContDiff ℝ 1 (𝓕⁻ (G k)) :=
    contDiff_one_fourierInv_normalizedIntDyadicMikhlinPiece_at C m hm hN k
  have hscale (k : ℤ) : rawKernelPiece C m k = fun x => (R k ^ d) • (𝓕⁻ (G k)) (R k • x) := by
    funext x
    simpa only [rawKernelPiece, R, G, integerDyadicFrequencyScale, inv_inv] using
      fourierInv_intDyadicMikhlinPiece_eq_normalized_scale C m k x
  have hf (k : ℤ) (x : E d) :
      fderiv ℝ (rawKernelPiece C m k) x = (R k ^ (d+1)) • (𝓕⁻ (D k)) (R k • x) := by
    have hi : Integrable (G k) := (hG k).1.continuous.integrable_of_hasCompactSupport (hG k).2
    have hw : Integrable (fun x => ‖x‖ * ‖G k x‖) :=
      (continuous_norm.mul (hG k).1.continuous.norm).integrable_of_hasCompactSupport (hG k).2.norm.mul_left
    have hs : HasFDerivAt (fun x : E d => R k • x)
        (R k • ContinuousLinearMap.id ℝ (E d)) x :=
      (ContinuousLinearMap.id ℝ (E d)).hasFDerivAt.const_smul (R k)
    have hd := (((hC k).differentiable (by norm_num) (R k • x)).hasFDerivAt.comp x hs).const_smul (R k ^ d)
    have heq : rawKernelPiece C m k = (R k ^ d) • ((𝓕⁻ (G k)) ∘ (R k • ·)) := by
      funext y
      rw [hscale k]
      rfl
    rw [heq, hd.fderiv]
    have he := congrFun (fderiv_fourierInv_eq_fourierInv_fourierSMulRight (G k) hi hw) (R k • x)
    change fderiv ℝ (𝓕⁻ (G k)) (R k • x) = (𝓕⁻ (D k)) (R k • x) at he
    rw [he, pow_succ]
    ext y
    simp [smul_smul]
  have hl (k : ℤ) (x : E d) : ‖(𝓕⁻ (G k)) x‖ ≤ P*A := by
    rw [← hmP, Real.fourierInv_eq_fourier_neg]
    exact (VectorFourier.norm_fourierIntegral_le_integral_norm
      Real.fourierChar volume (innerSL ℝ).toLinearMap₁₂ (G k) (-x)).trans (by
        simpa [G, normalizedMikhlinKernelFrequencyL1Bound] using
          integral_norm_iteratedFDeriv_normalizedIntDyadicMikhlinPiece_le C m hm hA k (n := 0) (by omega))
  have hl' (k : ℤ) (x : E d) : ‖(𝓕⁻ (D k)) x‖ ≤ P'*A := by
    rw [← hmP', Real.fourierInv_eq_fourier_neg]
    exact (VectorFourier.norm_fourierIntegral_le_integral_norm
      Real.fourierChar volume (innerSL ℝ).toLinearMap₁₂ (D k) (-x)).trans (by
        simpa [D, G, normalizedMikhlinKernelDerivativeFrequencyL1Bound] using
          integral_norm_iteratedFDeriv_fourierSMulRight_normalizedIntDyadicMikhlinPiece_le C m hm hA k (n := 0) (by omega))
  have hh (k : ℤ) (x : E d) : ‖x‖^N * ‖(𝓕⁻ (G k)) x‖ ≤ Q*A := by
    rw [← hmQ]
    exact pow_norm_fourierInv_normalizedIntDyadicMikhlinPiece_le C m hm hA k x
  have hh' (k : ℤ) (x : E d) : ‖x‖^N * ‖(𝓕⁻ (D k)) x‖ ≤ Q'*A := by
    rw [← hmQ']
    exact pow_norm_fourierInv_fourierSMulRight_normalizedIntDyadicMikhlinPiece_le C m hm hA k x
  have hbound {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] {g : E d → V}
      {L H : ℝ} (k : ℤ) {x : E d} (hx : x ≠ 0) (a : ℕ)
      (hL : ‖g (R k • x)‖ ≤ L) (hH : ‖R k • x‖^N * ‖g (R k • x)‖ ≤ H) :
      ‖R k ^ a • g (R k • x)‖ ≤ min (L*(2:ℝ)^(k*(a:ℤ)))
        (H*(2:ℝ)^(-k*((N:ℤ)-a))/‖x‖^N) := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (hR k).le _)]
    have he (n : ℕ) : R k ^ n = (2:ℝ)^(k*(n:ℤ)) := by
      rw [zpow_mul, zpow_natCast]
    have hx' := norm_pos_iff.mpr hx
    apply le_min
    · rw [← he, mul_comm L]
      exact mul_le_mul_of_nonneg_left hL (by positivity)
    · rw [norm_smul, Real.norm_eq_abs, abs_of_pos (hR k), mul_pow] at hH
      apply (le_div_iff₀ (pow_pos hx' _)).mpr
      have hE : (2:ℝ)^(-k*((N:ℤ)-a))*R k^N = R k^a := by
        rw [he, he, ← zpow_add₀ (by norm_num : (2:ℝ) ≠ 0)]
        congr 1
        ring
      calc
        _ = (2:ℝ)^(-k*((N:ℤ)-a)) *((R k^N*‖x‖^N)*‖g (R k • x)‖) := by
          rw [← mul_assoc, ← mul_assoc, hE]
          ring
        _ ≤ H*(2:ℝ)^(-k*((N:ℤ)-a)) := by
          rw [mul_comm H]
          exact mul_le_mul_of_nonneg_left hH (by positivity)
  constructor
  · intro k
    rw [hscale k]
    have hi : ContDiff ℝ 1 (fun x : E d => R k • x) :=
      (R k • ContinuousLinearMap.id ℝ (E d)).contDiff
    have hj : ContDiff ℝ 1 (fun x : E d => (𝓕⁻ (G k)) (R k • x)) := (hC k).comp hi
    exact hj.const_smul _
  · intro k x hx
    rw [hf, hscale k]
    exact ⟨hbound (g := 𝓕⁻ (G k)) k hx d (hl k _) (hh k _),
      by simpa only [Nat.cast_add, Nat.cast_one] using
        hbound (g := 𝓕⁻ (D k)) k hx (d+1) (hl' k _) (hh' k _)⟩

private theorem kernelSeries_regular {d a b a' b' : ℕ}
    (ha : 0 < a) (hb : 0 < b) (ha' : 0 < a') (hb' : 0 < b')
    {P Q P' Q' : ℝ} (hP : 0 ≤ P) (hQ : 0 ≤ Q) (hP' : 0 ≤ P') (hQ' : 0 ≤ Q')
    (L : ℤ → E d → ℂ) (hL : ∀ k, ContDiff ℝ 1 (L k))
    (hB : ∀ k (x : E d), x ≠ 0 → ‖L k x‖ ≤
      min (P*(2:ℝ)^(k*(a:ℤ))) (Q*(2:ℝ)^(-k*(b:ℤ))/‖x‖^(a+b)))
    (hD : ∀ k (x : E d), x ≠ 0 → ‖fderiv ℝ (L k) x‖ ≤
      min (P'*(2:ℝ)^(k*(a':ℤ))) (Q'*(2:ℝ)^(-k*(b':ℤ))/‖x‖^(a'+b'))) :
    ContDiffOn ℝ 1 (fun x => ∑' k, L k x) {x | x ≠ 0} ∧
      ∀ x : E d, x ≠ 0 → Summable (fun k => ‖L k x‖) ∧
        Summable (fun k => ‖fderiv ℝ (L k) x‖) ∧
        fderiv ℝ (fun z => ∑' k, L k z) x = ∑' k, fderiv ℝ (L k) x := by
  let K (x : E d) := ∑' k, L k x
  let J (x : E d) := ∑' k, fderiv ℝ (L k) x
  have hLoc (x : E d) (hx : x ≠ 0) :
      HasFDerivAt K (J x) x ∧ ContinuousAt J x := by
    let ρ := ‖x‖/2
    have hρ : 0 < ρ := half_pos (norm_pos_iff.mpr hx)
    let S := Metric.ball x ρ
    have hxS : x ∈ S := Metric.mem_ball_self hρ
    have hY {y : E d} (hy : y ∈ S) : y ≠ 0 ∧ ρ ≤ ‖y‖ := by
      have h₀ : ‖x‖ ≤ ‖x-y‖+‖y‖ := by
        simpa only [sub_add_cancel] using norm_add_le (x-y) y
      have hy' : ‖x-y‖ < ρ := by
        rw [← dist_eq_norm, dist_comm]
        exact hy
      have hn : ρ ≤ ‖y‖ := by dsimp [ρ] at *; linarith
      exact ⟨norm_pos_iff.mp (hρ.trans_le hn),hn⟩
    let w (k : ℤ) := min (P*(2:ℝ)^(k*(a:ℤ))) (Q*(2:ℝ)^(-k*(b:ℤ))/ρ^(a+b))
    let v (k : ℤ) := min (P'*(2:ℝ)^(k*(a':ℤ))) (Q'*(2:ℝ)^(-k*(b':ℤ))/ρ^(a'+b'))
    have hw : Summable w := dyadicKernel_summable ha hb hρ hP hQ
    have hv : Summable v := dyadicKernel_summable ha' hb' hρ hP' hQ'
    have hwB (k : ℤ) (y : E d) (hy : y ∈ S) : ‖L k y‖ ≤ w k := by
      refine (hB k y (hY hy).1).trans (min_le_min le_rfl ?_)
      exact div_le_div_of_nonneg_left (by positivity) (by positivity)
        (pow_le_pow_left₀ hρ.le (hY hy).2 _)
    have hvB (k : ℤ) (y : E d) (hy : y ∈ S) : ‖fderiv ℝ (L k) y‖ ≤ v k := by
      refine (hD k y (hY hy).1).trans (min_le_min le_rfl ?_)
      exact div_le_div_of_nonneg_left (by positivity) (by positivity)
        (pow_le_pow_left₀ hρ.le (hY hy).2 _)
    have hd (k : ℤ) (y : E d) (_ : y ∈ S) :
        HasFDerivAt (L k) (fderiv ℝ (L k) y) y :=
      ((hL k).differentiable (by norm_num) y).hasFDerivAt
    refine ⟨hasFDerivAt_tsum_of_isPreconnected hv Metric.isOpen_ball
      (convex_ball x ρ).isPreconnected hd hvB hxS (hw.of_norm_bounded fun k => hwB k x hxS) hxS, ?_⟩
    have hJ : ContinuousOn J S :=
      continuousOn_tsum (fun k => ((hL k).continuous_fderiv (by norm_num)).continuousOn) hv hvB
    exact (hJ x hxS).continuousAt (Metric.isOpen_ball.mem_nhds hxS)
  have ho : IsOpen ({x : E d | x ≠ 0}) := isOpen_compl_singleton
  constructor
  · rw [show (1 : WithTop ℕ∞) = 0+1 by simp, contDiffOn_succ_iff_fderiv_of_isOpen ho]
    refine ⟨fun x hx => (hLoc x hx).1.differentiableAt.differentiableWithinAt, by norm_num, ?_⟩
    rw [contDiffOn_zero]
    have hJ : ContinuousOn J {x | x ≠ 0} := fun x hx => (hLoc x hx).2.continuousWithinAt
    exact hJ.congr (fun x hx => (hLoc x hx).1.fderiv)
  · intro x hx
    have hx₀ := norm_pos_iff.mpr hx
    exact ⟨(dyadicKernel_summable ha hb hx₀ hP hQ).of_nonneg_of_le (fun _ => norm_nonneg _)
        (fun k => hB k x hx),
      (dyadicKernel_summable ha' hb' hx₀ hP' hQ').of_nonneg_of_le (fun _ => norm_nonneg _)
        (fun k => hD k x hx), (hLoc x hx).1.fderiv⟩

private theorem inverseFourier_bilinear {d : ℕ} {u v : E d → ℂ}
    (hu : Integrable u) (hv : Integrable v) :
    (∫ x, (𝓕⁻ u) x * v x) = ∫ ξ, u ξ * (𝓕⁻ v) ξ := by
  have h := VectorFourier.integral_fourierIntegral_smul_eq_flip
    (L := -(innerₗ (E d)))
    Real.continuous_fourierChar (show Continuous (fun xy : E d × E d => -inner ℝ xy.1 xy.2) from
      continuous_inner.neg) hu hv
  have hflip : (-(innerₗ (E d))).flip = -(innerₗ (E d)) := by
    ext x y
    simpa using congrArg Neg.neg (real_inner_comm x y)
  rw [hflip] at h
  change (∫ x, (𝓕⁻ u) x • v x) = ∫ ξ, u ξ • (𝓕⁻ v) ξ at h
  simpa only [smul_eq_mul] using h

open MikhlinHormander LittlewoodPaley in
private theorem kernelSeries_pairing {d N : ℕ} (hd : 0 < d) (C : lpCutoffs d)
    (m : E d → ℂ) {A : ℝ} (hA : 0 ≤ A) (hm : MikhlinCondition N m A)
    {B : ℝ} (hB : 0 ≤ B)
    (hK : ∀ x : E d, x ≠ 0 → Summable (fun k => ‖rawKernelPiece C m k x‖) ∧
      (∑' k, ‖rawKernelPiece C m k x‖) ≤ B*‖x‖⁻¹^d)
    (g : SchwartzMap (E d) ℂ) (hg : 0 ∉ tsupport (g : E d → ℂ)) :
    (∫ x, (∑' k, rawKernelPiece C m k x) * g x) = ∫ ξ, m ξ * (𝓕⁻ g) ξ := by
  let S (n : ℕ) := (Finset.range (2*n+1)).image (fun k : ℕ => -(n:ℤ)+(k:ℤ))
  let F (k : ℤ) (ξ : E d) := intDyadicBandpassMultiplier C.cutoff k ξ * m ξ
  let M (n : ℕ) (ξ : E d) := ∑ k ∈ S n, F k ξ
  let L (n : ℕ) (x : E d) := ∑ k ∈ S n, rawKernelPiece C m k x
  have hF (k : ℤ) := contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hm
  have hFi (k : ℤ) : Integrable (F k) := (hF k).1.continuous.integrable_of_hasCompactSupport (hF k).2
  have hL (n : ℕ) : L n = 𝓕⁻ (M n) := by
    funext x
    exact (fourierInv_finset_sum_of_integrable (S n) F (fun k _ => hFi k) x).symm
  have hP (n : ℕ) : (∫ x, L n x * g x) = ∫ ξ, M n ξ * (𝓕⁻ g) ξ := by
    rw [hL n]
    simp only [SchwartzMap.fourierInv_coe]
    exact inverseFourier_bilinear (integrable_finset_sum _ fun k _ => hFi k) g.integrable
  have hS : Tendsto S atTop atTop := dyadicWindow_exhaustion
  have ho : IsOpen (tsupport (g : E d → ℂ))ᶜ := (isClosed_tsupport _).isOpen_compl
  obtain ⟨δ,hδ,hδS⟩ := Metric.mem_nhds_iff.mp (ho.mem_nhds hg)
  have hn (x : E d) (hx : g x ≠ 0) : δ ≤ ‖x‖ := by
    apply le_of_not_gt
    intro h
    exact (hδS (by simpa [Metric.mem_ball, dist_zero_right] using h))
      (subset_tsupport (g : E d → ℂ) hx)
  have hSpatial :
      Tendsto (fun n => ∫ x, L n x * g x) atTop
        (𝓝 (∫ x, (∑' k, rawKernelPiece C m k x) * g x)) := by
    apply tendsto_integral_of_dominated_convergence (fun x => (B*δ⁻¹^d)*‖g x‖)
    · intro n
      have hc : Continuous (L n) := by
        rw [hL n]
        rw [show 𝓕⁻ (M n) = fun x => 𝓕 (M n) (-x) by funext x; exact Real.fourierInv_eq_fourier_neg _ _]
        exact (VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
          (innerSL ℝ).continuous₂ (integrable_finset_sum _ fun k _ => hFi k)).comp continuous_neg
      exact (hc.mul g.continuous).aestronglyMeasurable
    · exact g.integrable.norm.const_mul _
    · intro n
      filter_upwards [] with x
      by_cases hx : g x = 0
      · simp [hx]
      · have hx₀ : x ≠ 0 := norm_pos_iff.mp (hδ.trans_le (hn x hx))
        rw [norm_mul]
        apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
        refine (norm_sum_le _ _).trans (((hK x hx₀).1.sum_le_tsum _ (fun _ _ => norm_nonneg _)).trans
          ((hK x hx₀).2.trans ?_))
        gcongr
        exact hn x hx
    · filter_upwards [] with x
      by_cases hx : g x = 0
      · simp [hx]
      · have hx₀ : x ≠ 0 := norm_pos_iff.mp (hδ.trans_le (hn x hx))
        exact (((hK x hx₀).1.of_norm.hasSum).comp hS).mul_const (g x)
  have hM (n : ℕ) (ξ : E d) : M n ξ = symmetricIntegerDyadicCutoff C n ξ * m ξ := by
    unfold M S symmetricIntegerDyadicCutoff
    rw [Finset.sum_image (fun k _ l _ h => by
      exact_mod_cast (add_left_cancel (show -(n:ℤ)+(k:ℤ) = -(n:ℤ)+(l:ℤ) from h)))]
    simp only [F, Finset.sum_mul]
  have hZ : ∀ᵐ x ∂(volume : Measure (E d)), x ≠ 0 := by
    letI : Nonempty (Fin d) := ⟨⟨0,hd⟩⟩
    exact ae_ne (volume : Measure (E d)) 0
  have hFreq : Tendsto (fun n => ∫ ξ, M n ξ * (𝓕⁻ g) ξ) atTop
      (𝓝 (∫ ξ, m ξ * (𝓕⁻ g) ξ)) := by
    apply tendsto_integral_of_dominated_convergence (fun ξ => (2*A)*‖(𝓕⁻ g) ξ‖)
    · exact fun n => ((continuous_finsetSum _ fun k _ => (hF k).1.continuous).mul
        (𝓕⁻ g : SchwartzMap (E d) ℂ).continuous).aestronglyMeasurable
    · exact (𝓕⁻ g : SchwartzMap (E d) ℂ).integrable.norm.const_mul _
    · intro n
      filter_upwards [hZ] with ξ hξ
      have hmB : ‖m ξ‖ ≤ A := by simpa using hm.2 0 (Nat.zero_le N) ξ hξ
      rw [hM, norm_mul, norm_mul]
      gcongr
      exact norm_symmetricIntegerDyadicCutoff_le_two C n ξ
    · filter_upwards [hZ] with ξ hξ
      simp_rw [hM]
      simpa only [one_mul] using ((tendsto_symmetricIntegerDyadicCutoff C hξ).mul_const
        (m ξ)).mul_const ((𝓕⁻ g) ξ)
  exact tendsto_nhds_unique hSpatial (hFreq.congr' (Filter.Eventually.of_forall fun n => (hP n).symm))

/-- The inverse Fourier transform of a Mihlin symbol is a (C^1) kernel away from zero. -/
theorem mihlinKernel {d : ℕ} (hd : 2 ≤ d) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (m : E d → ℂ) (A : ℝ), 0 ≤ A →
      MikhlinHormander.MikhlinCondition (d+2) m A →
      ∃ K : E d → ℂ, ContDiffOn ℝ 1 K {y | y ≠ 0} ∧
        (∀ y, y ≠ 0 → ‖K y‖ + ‖y‖*‖fderiv ℝ K y‖ ≤ B*A*‖y‖⁻¹^d) ∧
        ∀ g : SchwartzMap (E d) ℂ, 0 ∉ tsupport (g : E d → ℂ) →
          (∫ y, K y * g y) = ∫ ξ, m ξ * (𝓕⁻ g) ξ := by
  obtain ⟨C⟩ := LittlewoodPaley.exists_lpCutoffs d
  obtain ⟨P,Q,P',Q',hP,hQ,hP',hQ',hEst⟩ :=
    rawKernelPiece_estimates (N := d+2) C (by omega)
  let W (a b : ℕ) : ℝ :=
    ∑' k : ℤ, if 0 ≤ k then (2:ℝ)^(-k*(b:ℤ)) else (2:ℝ)^(k*(a:ℤ))
  have hW (a b : ℕ) : 0 ≤ W a b := by
    apply tsum_nonneg
    intro k
    split_ifs <;> positivity
  let U := (P+Q*2^2)*W d 2
  let V := (P'+Q'*2^1)*W (d+1) 1
  have hU : 0 ≤ U := by dsimp [U]; positivity
  have hV : 0 ≤ V := by dsimp [V]; positivity
  refine ⟨U+V, add_nonneg hU hV, ?_⟩
  intro m A hA hm
  obtain ⟨hLc,hL⟩ := hEst m A hA hm
  let L := rawKernelPiece C m
  have h1 (k : ℤ) (x : E d) (hx : x ≠ 0) : ‖L k x‖ ≤
      min (P*A*(2:ℝ)^(k*(d:ℤ))) (Q*A*(2:ℝ)^(-k*(2:ℤ))/‖x‖^(d+2)) := by
    simpa using (hL k x hx).1
  have h2 (k : ℤ) (x : E d) (hx : x ≠ 0) : ‖fderiv ℝ (L k) x‖ ≤
      min (P'*A*(2:ℝ)^(k*((d+1:ℕ):ℤ))) (Q'*A*(2:ℝ)^(-k*(1:ℤ))/‖x‖^((d+1)+1)) := by
    simpa only [L, Nat.cast_add, Nat.cast_one, add_sub_add_left_eq_sub, Nat.cast_ofNat,
      show (2:ℤ)-1 = 1 by norm_num, show d+1+1=d+2 by omega] using (hL k x hx).2
  obtain ⟨hC,hD⟩ := kernelSeries_regular (a := d) (b := 2) (a' := d+1) (b' := 1)
    (by omega) (by omega) (by omega) (by omega)
    (mul_nonneg hP hA) (mul_nonneg hQ hA) (mul_nonneg hP' hA) (mul_nonneg hQ' hA)
    L hLc h1 h2
  let K (x : E d) := ∑' k, L k x
  have hTb (x : E d) (hx : x ≠ 0) :
      (∑' k, ‖L k x‖) ≤ (U*A)*‖x‖⁻¹^d := by
    have hx₀ := norm_pos_iff.mpr hx
    refine ((hD x hx).1.tsum_le_tsum (fun k => h1 k x hx)
      (dyadicKernel_summable (by omega : 0 < d) (by omega : 0 < 2) hx₀
        (mul_nonneg hP hA) (mul_nonneg hQ hA))).trans ?_
    refine (dyadicKernel_tsum_le (by omega : 0 < d) (by omega : 0 < 2) hx₀
      (mul_nonneg hP hA) (mul_nonneg hQ hA)).trans_eq ?_
    change (P*A+Q*A*2^2)*‖x‖⁻¹^d*W d 2 = U*A*‖x‖⁻¹^d
    dsimp only [U]
    ring
  have hTd (x : E d) (hx : x ≠ 0) :
      (∑' k, ‖fderiv ℝ (L k) x‖) ≤ (V*A)*‖x‖⁻¹^(d+1) := by
    have hx₀ := norm_pos_iff.mpr hx
    refine ((hD x hx).2.1.tsum_le_tsum (fun k => h2 k x hx)
      (dyadicKernel_summable (by omega : 0 < d+1) (by omega : 0 < 1) hx₀
        (mul_nonneg hP' hA) (mul_nonneg hQ' hA))).trans ?_
    refine (dyadicKernel_tsum_le (by omega : 0 < d+1) (by omega : 0 < 1) hx₀
      (mul_nonneg hP' hA) (mul_nonneg hQ' hA)).trans_eq ?_
    change (P'*A+Q'*A*2^1)*‖x‖⁻¹^(d+1)*W (d+1) 1 = V*A*‖x‖⁻¹^(d+1)
    dsimp only [V]
    ring
  refine ⟨K,hC,?_,?_⟩
  · intro x hx
    change ‖K x‖+‖x‖*‖fderiv ℝ (fun z => ∑' k, L k z) x‖ ≤ _
    rw [(hD x hx).2.2]
    have h₁ := (norm_tsum_le_tsum_norm (hD x hx).1).trans (hTb x hx)
    have h₂ := (norm_tsum_le_tsum_norm (hD x hx).2.1).trans (hTd x hx)
    refine (add_le_add h₁ (mul_le_mul_of_nonneg_left h₂ (norm_nonneg _))).trans_eq ?_
    have he : ‖x‖ * ‖x‖⁻¹^(d+1) = ‖x‖⁻¹^d := by
      rw [pow_succ, ← mul_assoc, mul_comm ‖x‖, mul_assoc, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hx), mul_one]
    calc
      _ = U*A*‖x‖⁻¹^d+V*A*(‖x‖*‖x‖⁻¹^(d+1)) := by ring
      _ = _ := by rw [he]; ring
  · exact kernelSeries_pairing (by omega) C m hA hm (mul_nonneg hU hA)
      (fun x hx => ⟨(hD x hx).1, hTb x hx⟩)

/-- A normalized dilation of the physical mollifier. -/
noncomputable def kernelMollifier {d : ℕ} (ρ : SchwartzMap (E d) ℂ)
    (r : ℝ) (x : E d) : ℂ := ((r⁻¹^d : ℝ) : ℂ) * ρ (r⁻¹ • x)

/-- Convolution of the inverse multiplier distribution with the normalized mollifier. -/
noncomputable def mollifiedKernel {d : ℕ} (m : E d → ℂ) (ρ : SchwartzMap (E d) ℂ)
    (r : ℝ) : E d → ℂ :=
  𝓕⁻ (fun ξ => m ξ * (𝓕 (kernelMollifier ρ r)) ξ)

private theorem kernelMollifier_integral {d : ℕ} (ρ : SchwartzMap (E d) ℂ)
    {r : ℝ} (hr : 0 < r) :
    (∫ x, kernelMollifier ρ r x) = ∫ x, ρ x := by
  unfold kernelMollifier
  rw [integral_const_mul, integral_comp_smul_of_nonneg volume _ _ (hR := inv_nonneg.mpr hr.le)]
  simp only [finrank_euclideanSpace_fin, inv_pow, inv_inv, Complex.real_smul, ← mul_assoc]
  rw [← Complex.ofReal_mul, inv_mul_cancel₀ (pow_ne_zero _ hr.ne'), Complex.ofReal_one, one_mul]

private theorem kernelMollifier_fourier {d : ℕ} (ρ : SchwartzMap (E d) ℂ)
    {r : ℝ} (hr : 0 < r) (ξ : E d) :
    (𝓕 (kernelMollifier ρ r)) ξ = (𝓕 ρ) (r • ξ) := by
  rw [SchwartzMap.fourier_coe, Real.fourier_eq', Real.fourier_eq']
  simp only [kernelMollifier, smul_eq_mul]
  have he (x : E d) :
      inner ℝ x ξ = inner ℝ (r⁻¹ • x) (r • ξ) := by
    rw [real_inner_smul_left, real_inner_smul_right, ← mul_assoc, inv_mul_cancel₀ hr.ne', one_mul]
  simp_rw [he, ← mul_left_comm ((↑(r⁻¹^d):ℂ))]
  let F (y : E d) := Complex.exp ((↑(-2*Real.pi*inner ℝ y (r • ξ)):ℂ)*Complex.I)*ρ y
  change (∫ x : E d, (↑(r⁻¹^d):ℂ) * F (r⁻¹ • x)) = ∫ y, F y
  rw [integral_const_mul, integral_comp_inv_smul_of_nonneg volume F hr.le]
  simp only [finrank_euclideanSpace_fin, inv_pow, inv_inv, Complex.real_smul, ← mul_assoc]
  rw [← Complex.ofReal_mul, inv_mul_cancel₀ (pow_ne_zero _ hr.ne'), Complex.ofReal_one, one_mul]

private theorem hardKernelMollifier_support {d : ℕ} {ρ : SchwartzMap (E d) ℂ}
    (hρ : tsupport (ρ : E d → ℂ) ⊆ Metric.closedBall 0 1) {r : ℝ} (hr : 0 < r) :
    tsupport (kernelMollifier ρ r) ⊆ Metric.closedBall 0 r := by
  apply closure_minimal _ Metric.isClosed_closedBall
  intro x hx
  have h : ρ (r⁻¹ • x) ≠ 0 := by
    intro he
    exact hx (by simp [kernelMollifier, he])
  have hh := hρ (subset_tsupport (ρ : E d → ℂ) h)
  rw [Metric.mem_closedBall, dist_zero_right, norm_smul, Real.norm_eq_abs,
    abs_of_pos (inv_pos.mpr hr)] at hh
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (mul_le_mul_iff_right₀ (inv_pos.mpr hr)).mp
  rwa [inv_mul_cancel₀ hr.ne']

private theorem mollifiedKernel_local {d : ℕ} {m K : E d → ℂ}
    (hK : ∀ g : SchwartzMap (E d) ℂ, 0 ∉ tsupport (g : E d → ℂ) →
      (∫ y, K y * g y) = ∫ ξ, m ξ * (𝓕⁻ g) ξ)
    {ρ : SchwartzMap (E d) ℂ} (hρ : tsupport (ρ : E d → ℂ) ⊆ Metric.closedBall 0 1)
    {r : ℝ} (hr : 0 < r) {x : E d} (hx : r < ‖x‖) :
    mollifiedKernel m ρ r x = ∫ y, K y * kernelMollifier ρ r (x-y) := by
  let R := kernelMollifier ρ r
  have hR : ContDiff ℝ (↑(⊤ : ℕ∞)) R := by
    exact contDiff_const.mul (ρ.smooth'.comp ((r⁻¹ • ContinuousLinearMap.id ℝ (E d)).contDiff))
  have hs : tsupport (fun y => R (x-y)) ⊆ Metric.closedBall x r := by
    apply closure_minimal _ Metric.isClosed_closedBall
    intro y hy
    have ht := hardKernelMollifier_support hρ hr (subset_tsupport R hy)
    simpa only [Metric.mem_closedBall, dist_zero_right, dist_eq_norm, norm_sub_rev, sub_zero] using ht
  have hc : HasCompactSupport (fun y => R (x-y)) := IsCompact.of_isClosed_subset
    (isCompact_closedBall x r) (isClosed_tsupport _) hs
  let g := hc.toSchwartzMap (hR.comp (contDiff_const.sub contDiff_id))
  have hzero : 0 ∉ tsupport (g : E d → ℂ) := by
    intro h
    have hh := hs h
    rw [Metric.mem_closedBall, dist_zero_left] at hh
    exact (not_le_of_gt hx) hh
  have he (ξ : E d) : (𝓕⁻ g) ξ =
      inverseFourierPhase ξ x * (𝓕 R) ξ := by
    rw [SchwartzMap.fourierInv_coe]
    change (𝓕⁻ (fun y => R (x-y))) ξ = _
    rw [Real.fourierInv_eq', Real.fourier_eq']
    let H (y : E d) := Complex.exp ((↑(2*Real.pi*inner ℝ y ξ):ℂ) * Complex.I) * R (x-y)
    change (∫ y, H y) = _
    rw [← integral_sub_left_eq_self H volume x]
    simp only [H, sub_sub_cancel, inner_sub_left, inverseFourierPhase, smul_eq_mul]
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with y
    rw [← mul_assoc, ← Complex.exp_add]
    congr 1
    rw [real_inner_comm x ξ]
    push_cast
    ring
  change mollifiedKernel m ρ r x = ∫ y, K y * g y
  rw [hK g hzero]
  simp_rw [he]
  unfold mollifiedKernel
  rw [Real.fourierInv_eq']
  apply integral_congr_ae
  filter_upwards [] with ξ
  simp only [inverseFourierPhase, smul_eq_mul]
  ring

private theorem kernelMollifier_norm_integral {d : ℕ} (ρ : SchwartzMap (E d) ℂ)
    {r : ℝ} (hr : 0 < r) :
    (∫ x, ‖kernelMollifier ρ r x‖) = ∫ x, ‖ρ x‖ := by
  simp_rw [kernelMollifier, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity : 0 ≤ r⁻¹^d)]
  let F (x : E d) := ‖ρ x‖
  change (∫ x : E d, r⁻¹^d * F (r⁻¹ • x)) = ∫ x, F x
  rw [integral_const_mul, integral_comp_inv_smul_of_nonneg volume F hr.le]
  simp only [finrank_euclideanSpace_fin, smul_eq_mul, ← mul_assoc,
    inv_pow, inv_mul_cancel₀ (pow_ne_zero _ hr.ne'), one_mul]

private theorem kernelMollifier_integrable {d : ℕ} (ρ : SchwartzMap (E d) ℂ)
    {r : ℝ} (hr : 0 < r) : Integrable (kernelMollifier ρ r) := by
  apply Integrable.const_mul
  exact (integrable_comp_smul_iff volume ρ (inv_ne_zero hr.ne')).2 ρ.integrable

private theorem mollifiedKernel_bound {d : ℕ} {m : E d → ℂ}
    (ρ : SchwartzMap (E d) ℂ) {r : ℝ} (hr : 0 < r) {A : ℝ} (hA : 0 ≤ A)
    (hm : ∀ᵐ ξ ∂(volume : Measure (E d)), ‖m ξ‖ ≤ A) (x : E d) :
    ‖mollifiedKernel m ρ r x‖ ≤ (A*∫ ξ, ‖(𝓕 ρ) ξ‖)*r⁻¹^d := by
  unfold mollifiedKernel
  rw [Real.fourierInv_eq_fourier_neg]
  refine (VectorFourier.norm_fourierIntegral_le_integral_norm
    Real.fourierChar volume (innerSL ℝ).toLinearMap₁₂ _ _).trans ?_
  have hg : Integrable (fun ξ : E d => (𝓕 ρ) (r • ξ)) :=
    (integrable_comp_smul_iff volume ((𝓕 ρ : SchwartzMap (E d) ℂ) : E d → ℂ) hr.ne').2 (𝓕 ρ).integrable
  calc
    _ ≤ ∫ ξ, A*‖(𝓕 ρ) (r • ξ)‖ := by
      simp_rw [norm_mul, kernelMollifier_fourier ρ hr]
      exact integral_mono_of_nonneg (Eventually.of_forall fun _ => by positivity)
        (hg.norm.const_mul _) (hm.mono fun ξ h => mul_le_mul_of_nonneg_right h (norm_nonneg _))
    _ = _ := by
      let F (ξ : E d) := ‖(𝓕 ρ) ξ‖
      change (∫ x : E d, A * F (r • x)) = (A * ∫ x, F x) * r⁻¹^d
      rw [integral_const_mul, integral_comp_smul_of_nonneg volume F _ (hR := hr.le)]
      simp only [finrank_euclideanSpace_fin, smul_eq_mul, inv_pow]
      ring

private theorem offOrigin_sub_le {d : ℕ} {K : E d → ℂ} {B r : ℝ}
    (hK : ContDiffOn ℝ 1 K {y | y ≠ 0}) (hB : 0 ≤ B)
    (hD : ∀ y : E d, y ≠ 0 → ‖fderiv ℝ K y‖ ≤ B*‖y‖⁻¹^(d+1))
    {x z : E d} (hr : 0 < r) (hx : 2*r < ‖x‖) (hz : ‖z‖ ≤ r) :
    ‖K x-K (x-z)‖ ≤ (B*2^(d+1))*r*‖x‖⁻¹^(d+1) := by
  let S := Metric.closedBall x r
  have hx₂ : 0 < ‖x‖/2 := by linarith
  have hS (y : E d) (hy : y ∈ S) : ‖x‖/2 ≤ ‖y‖ := by
    have he : ‖x-y‖ ≤ r := by
      change dist y x ≤ r at hy
      simpa only [dist_eq_norm, norm_sub_rev] using hy
    have hn : ‖x‖ ≤ ‖x-y‖+‖y‖ := by simpa using norm_add_le (x-y) y
    linarith
  have hn (y : E d) (hy : y ∈ S) := norm_pos_iff.mp (hx₂.trans_le (hS y hy))
  have hdiff (y : E d) (hy : y ∈ S) : DifferentiableAt ℝ K y :=
    (hK.differentiableOn (by norm_num) y (hn y hy)).differentiableAt
      (isOpen_compl_singleton.mem_nhds (hn y hy))
  have hb (y : E d) (hy : y ∈ S) : ‖fderiv ℝ K y‖ ≤ (B*2^(d+1))*‖x‖⁻¹^(d+1) := by
    refine (hD y (hn y hy)).trans ?_
    calc
      _ ≤ B*(‖x‖/2)⁻¹^(d+1) := by gcongr; exact hS y hy
      _ = _ := by rw [inv_div, div_eq_mul_inv, mul_pow, mul_assoc]
  have hzS : x-z ∈ S := by simpa [S, Metric.mem_closedBall, dist_eq_norm] using hz
  have hxS : x ∈ S := Metric.mem_closedBall_self hr.le
  have h := (convex_closedBall x r).norm_image_sub_le_of_norm_fderiv_le hdiff hb hzS hxS
  refine h.trans ?_
  rw [show x-(x-z) = z by abel]
  calc
    _ ≤ (B*2^(d+1)*‖x‖⁻¹^(d+1))*r := mul_le_mul_of_nonneg_left hz (by positivity)
    _ = _ := by ring

private theorem kernelDecay_integrable (d : ℕ) :
    Integrable (fun x : E d => ((1+‖x‖)^(d+1))⁻¹) := by
  have h : Integrable (fun x : E d => (1+‖x‖)^(-((d:ℝ)+1))) (volume : Measure (E d)) :=
    integrable_one_add_norm (by simp)
  apply h.congr
  filter_upwards [] with x
  change (1+‖x‖)^(-((d:ℝ)+1)) = _
  rw [Real.rpow_neg (by positivity : 0 ≤ 1+‖x‖), ← Nat.cast_one (R := ℝ), ← Nat.cast_add, Real.rpow_natCast]

/-- The error between hard and mollified truncation is uniformly integrable. -/
theorem hardComparison {d : ℕ} (ρ : SchwartzMap (E d) ℂ)
    (hρ : tsupport (ρ : E d → ℂ) ⊆ Metric.closedBall 0 1)
    (hρI : (∫ x, ρ x) = 1) (B : ℝ) (hB : 0 ≤ B) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m K : E d → ℂ) (A : ℝ), 0 ≤ A → Measurable m →
      (∀ᵐ ξ ∂(volume : Measure (E d)), ‖m ξ‖ ≤ A) →
      ContDiffOn ℝ 1 K {y | y ≠ 0} →
      (∀ y, y ≠ 0 → ‖K y‖+‖y‖*‖fderiv ℝ K y‖ ≤ B*A*‖y‖⁻¹^d) →
      (∀ g : SchwartzMap (E d) ℂ, 0 ∉ tsupport (g : E d → ℂ) →
        (∫ y, K y*g y) = ∫ ξ, m ξ*(𝓕⁻ g) ξ) →
      ∀ r : ℝ, 0 < r →
        let D := {y : E d | r < ‖y‖}.indicator K - mollifiedKernel m ρ r
        Integrable D ∧ (∫ x, ‖D x‖) ≤ C*A := by
  let M : ℝ := ∫ ξ, ‖(𝓕 ρ) ξ‖
  let N : ℝ := ∫ y, ‖ρ y‖
  let W (x : E d) : ℝ := ((1+‖x‖)^(d+1))⁻¹
  let U := (B+M)*3^(d+1) + (B*2^(d+1)*N)*2^(d+1)
  have hM : 0 ≤ M := integral_nonneg fun _ => norm_nonneg _
  have hN : 0 ≤ N := integral_nonneg fun _ => norm_nonneg _
  have hU : 0 ≤ U := by dsimp [U]; positivity
  have hW (x : E d) : 0 ≤ W x := by dsimp [W]; positivity
  refine ⟨U*∫ x, W x, mul_nonneg hU (integral_nonneg hW), ?_⟩
  intro m K A hA hm hmB hK hKb hPair r hr
  dsimp only
  let D := {y : E d | r < ‖y‖}.indicator K - mollifiedKernel m ρ r
  let R := kernelMollifier ρ r
  have hKm : Measurable K := measurable_of_continuousOn_compl_singleton 0 hK.continuousOn
  have hRm : Measurable R :=
    measurable_const.mul (ρ.continuous.measurable.comp ((r⁻¹ • ContinuousLinearMap.id ℝ (E d)).continuous.measurable))
  have hRi : Integrable R := kernelMollifier_integrable ρ hr
  have hS (y : E d) (hy : y ≠ 0) : ‖K y‖ ≤ B*A*‖y‖⁻¹^d := by
    have := hKb y hy
    linarith only [this, mul_nonneg (norm_nonneg y) (norm_nonneg (fderiv ℝ K y))]
  have hD (y : E d) (hy : y ≠ 0) : ‖fderiv ℝ K y‖ ≤ (B*A)*‖y‖⁻¹^(d+1) := by
    have h := hKb y hy
    have hy₀ := norm_pos_iff.mpr hy
    have h' : ‖fderiv ℝ K y‖ ≤ (B*A*‖y‖⁻¹^d)/‖y‖ := by
      apply (le_div_iff₀ hy₀).mpr
      rw [mul_comm]
      linarith only [h,norm_nonneg (K y)]
    refine h'.trans_eq ?_
    rw [pow_succ]
    ring
  have hs (x : E d) (hx : 2*r < ‖x‖) :
      ‖D x‖ ≤ (B*A*2^(d+1))*r*‖x‖⁻¹^(d+1)*N := by
    change ‖{y : E d | r < ‖y‖}.indicator K x - mollifiedKernel m ρ r x‖ ≤ _
    rw [Set.indicator_of_mem (show x ∈ {y : E d | r < ‖y‖} by change r < ‖x‖; linarith),
      mollifiedKernel_local hPair hρ hr (by linarith)]
    rw [← integral_sub_left_eq_self (fun y => K y*R (x-y)) volume x]
    simp only [sub_sub_cancel]
    have hRx : (∫ z, R z) = 1 := (kernelMollifier_integral ρ hr).trans hρI
    let T (z : E d) := (K x-K (x-z))*R z
    let C := (B*A*2^(d+1))*r*‖x‖⁻¹^(d+1)
    have hBound (z : E d) : ‖T z‖ ≤ C*‖R z‖ := by
      rw [show T z = (K x-K (x-z))*R z from rfl, norm_mul]
      by_cases hz : ‖z‖ ≤ r
      · exact mul_le_mul_of_nonneg_right (offOrigin_sub_le hK (mul_nonneg hB hA) hD hr hx hz)
          (norm_nonneg _)
      · have hz' : R z = 0 := by
          by_contra hh
          exact hz (by simpa [Metric.mem_closedBall, dist_zero_right] using
            hardKernelMollifier_support hρ hr (subset_tsupport R hh))
        simp [hz']
    have hT : Measurable T := (measurable_const.sub (hKm.comp (measurable_const.sub measurable_id))).mul hRm
    have hTi : Integrable T := (hRi.norm.const_mul C).mono' hT.aestronglyMeasurable
      (Filter.Eventually.of_forall hBound)
    have hi : Integrable (fun z => K (x-z)*R z) := by
      have hh := (hRi.const_mul (K x)).sub hTi
      convert hh using 1
      funext z
      simp only [Pi.sub_apply, T, sub_mul]
      ring
    have he : K x - (∫ z, K (x-z)*R z) = ∫ z, T z := by
      dsimp only [T]
      simp_rw [sub_mul]
      rw [integral_sub (hRi.const_mul _) hi, integral_const_mul, hRx, mul_one]
    rw [he]
    refine (norm_integral_le_integral_norm _).trans ?_
    exact (integral_mono hTi.norm (hRi.norm.const_mul C) hBound).trans_eq (by
      rw [integral_const_mul, kernelMollifier_norm_integral ρ hr])
  have hrn (x : E d) : ‖r⁻¹ • x‖ = r⁻¹*‖x‖ := by
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hr.le)]
  have hDpoint (x : E d) : ‖D x‖ ≤ (U*A)*r⁻¹^d*W (r⁻¹ • x) := by
    let t := ‖r⁻¹ • x‖
    have ht : 0 ≤ t := norm_nonneg _
    have htE : r*t = ‖x‖ := by
      dsimp only [t]
      rw [hrn, ← mul_assoc, mul_inv_cancel₀ hr.ne', one_mul]
    change ‖D x‖ ≤ (U*A)*r⁻¹^d*((1+t)^(d+1))⁻¹
    by_cases hx : ‖x‖ ≤ 2*r
    · have ht₂ : t ≤ 2 := (mul_le_mul_iff_right₀ hr).mp (by rw [htE]; linarith)
      have hKx : ‖{y : E d | r < ‖y‖}.indicator K x‖ ≤ B*A*r⁻¹^d := by
        by_cases hx' : r < ‖x‖
        · rw [Set.indicator_of_mem (show x ∈ {y : E d | r < ‖y‖} from hx')]
          exact (hS x (norm_pos_iff.mp (hr.trans hx'))).trans (by gcongr)
        · rw [Set.indicator_of_notMem (show x ∉ {y : E d | r < ‖y‖} from hx'), norm_zero]
          positivity
      refine (norm_sub_le _ _).trans ((add_le_add hKx (mollifiedKernel_bound ρ hr hA hmB x)).trans ?_)
      have ht' : (1+t)^(d+1) ≤ 3^(d+1) :=
        pow_le_pow_left₀ (by positivity) (by linarith) _
      rw [← div_eq_mul_inv]
      apply (le_div_iff₀ (by positivity : 0 < (1+t)^(d+1))).mpr
      calc
        _ = ((B+M)*A*r⁻¹^d)*(1+t)^(d+1) := by ring
        _ ≤ ((B+M)*A*r⁻¹^d)*3^(d+1) := mul_le_mul_of_nonneg_left ht' (by positivity)
        _ = ((B+M)*3^(d+1))*A*r⁻¹^d := by ring
        _ ≤ _ := by dsimp only [U]; gcongr; exact le_add_of_nonneg_right (by positivity)
    · have hx' := lt_of_not_ge hx
      have ht₂ : 2 < t := by
        by_contra! hh
        apply hx
        rw [← htE, mul_comm 2]
        exact mul_le_mul_of_nonneg_left hh hr.le
      refine (hs x hx').trans ?_
      rw [← htE, mul_inv, mul_pow, ← div_eq_mul_inv]
      apply (le_div_iff₀ (by positivity : 0 < (1+t)^(d+1))).mpr
      have hc : t⁻¹^(d+1)*(1+t)^(d+1) ≤ 2^(d+1) := by
        rw [← mul_pow]
        apply pow_le_pow_left₀ (by positivity)
        exact (inv_mul_le_iff₀ (by linarith : 0 < t)).mpr (by linarith)
      have he : r*r⁻¹^(d+1) = r⁻¹^d := by
        rw [pow_succ, mul_left_comm r, mul_inv_cancel₀ hr.ne', mul_one]
      calc
        _ = ((B*2^(d+1)*N)*A*r⁻¹^d)*(t⁻¹^(d+1)*(1+t)^(d+1)) := by
          rw [← he]
          ring
        _ ≤ ((B*2^(d+1)*N)*A*r⁻¹^d)*2^(d+1) := mul_le_mul_of_nonneg_left hc (by positivity)
        _ = (B*2^(d+1)*N*2^(d+1))*A*r⁻¹^d := by ring
        _ ≤ _ := by dsimp only [U]; gcongr; exact le_add_of_nonneg_left (by positivity)
  have hMaj : Integrable (fun x => (U*A)*r⁻¹^d*W (r⁻¹ • x)) :=
    ((integrable_comp_smul_iff volume W (inv_ne_zero hr.ne')).2
      (kernelDecay_integrable d)).const_mul _
  have hDm : AEStronglyMeasurable D volume := by
    apply Measurable.aestronglyMeasurable
    apply Measurable.sub (hKm.indicator (measurableSet_lt measurable_const continuous_norm.measurable))
    unfold mollifiedKernel
    rw [show 𝓕⁻ (fun ξ => m ξ * 𝓕 R ξ) = fun x => (𝓕 (fun ξ => m ξ * 𝓕 R ξ)) (-x) by
      funext x; exact Real.fourierInv_eq_fourier_neg _ _]
    apply Continuous.measurable
    apply Continuous.comp _ continuous_neg
    apply VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar (innerSL ℝ).continuous₂
    have hG : Integrable (fun ξ : E d => (𝓕 ρ) (r • ξ)) :=
      (integrable_comp_smul_iff volume ((𝓕 ρ : SchwartzMap (E d) ℂ) : E d → ℂ) hr.ne').2 (𝓕 ρ).integrable
    refine (hG.norm.const_mul A).mono' (hm.mul
      (VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
        (innerSL ℝ).continuous₂ hRi).measurable).aestronglyMeasurable ?_
    filter_upwards [hmB] with ξ hξ
    rw [norm_mul, kernelMollifier_fourier ρ hr]
    exact mul_le_mul_of_nonneg_right hξ (norm_nonneg _)
  have hDi := hMaj.mono' hDm (Filter.Eventually.of_forall hDpoint)
  refine ⟨hDi, (integral_mono hDi.norm hMaj hDpoint).trans_eq ?_⟩
  rw [integral_const_mul, integral_comp_inv_smul_of_nonneg volume _ hr.le]
  simp only [finrank_euclideanSpace_fin, smul_eq_mul]
  rw [inv_pow]
  calc
    _ = (U*A)*(r^d)⁻¹*r^d*(∫ x, W x) := by ring
    _ = _ := by rw [mul_assoc (U*A), inv_mul_cancel₀ (pow_ne_zero _ hr.ne'), mul_one]; ring

private theorem exists_kernelMollifier (d : ℕ) :
    ∃ ρ : SchwartzMap (E d) ℂ, tsupport (ρ : E d → ℂ) ⊆ Metric.closedBall 0 1 ∧
      (∫ x, ρ x) = 1 := by
  let b : ContDiffBump (0 : E d) := ⟨1/2, 1, by norm_num, by norm_num⟩
  let f (x : E d) : ℂ := b.normed volume x
  have hfs : tsupport f = Metric.closedBall 0 1 := by
    have he : Function.support f = Function.support (b.normed volume) := by
      ext x
      simp [f, Function.mem_support]
    rw [tsupport, he, ← tsupport, b.tsupport_normed_eq]
  have hfc : HasCompactSupport f := by
    unfold HasCompactSupport
    rw [hfs]
    exact isCompact_closedBall _ _
  let g := hfc.toSchwartzMap (Complex.ofRealCLM.contDiff.comp b.contDiff_normed)
  refine ⟨g, hfs.le, ?_⟩
  change (∫ x, f x) = 1
  unfold f
  rw [integral_complex_ofReal, b.integral_normed, Complex.ofReal_one]

private theorem kernelProduct_integrable {d : ℕ} {L : E d → ℂ} (hL : Integrable L)
    (f : Fin d → SchwartzMap (E d) ℂ) (x : E d) :
    Integrable (fun y => L y * ∏ i, f i (x-y i • EuclideanSpace.single i 1)) := by
  let B := ∏ i, SchwartzMap.seminorm ℝ 0 0 (f i)
  have hC : Continuous (fun y : E d => ∏ i, f i (x-y i • EuclideanSpace.single i 1)) :=
    continuous_finsetProd _ fun i _ => (f i).continuous.comp
      (continuous_const.sub ((EuclideanSpace.proj (𝕜 := ℝ) i).continuous.smul continuous_const))
  refine (hL.norm.mul_const B).mono' (hL.aestronglyMeasurable.mul hC.aestronglyMeasurable) ?_
  filter_upwards [] with y
  simp only [norm_mul, norm_prod]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  apply Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _)
  intro i _
  simpa using SchwartzMap.le_seminorm ℝ 0 0 (f i) (x-y i • EuclideanSpace.single i 1)

private theorem physicalKernelApply_sub {d : ℕ} {L G : E d → ℂ} (hL : Integrable L)
    (hG : Integrable G) (f : Fin d → SchwartzMap (E d) ℂ) :
    physicalKernelApply (L-G) (fun i => f i) =
      physicalKernelApply L (fun i => f i)-physicalKernelApply G (fun i => f i) := by
  funext x
  unfold physicalKernelApply
  simp only [Pi.sub_apply, sub_mul]
  exact integral_sub (kernelProduct_integrable hL f x) (kernelProduct_integrable hG f x)

private theorem physicalKernelApply_congr {d : ℕ} {L G : E d → ℂ}
    (h : L =ᵐ[volume] G) (f : Fin d → E d → ℂ) :
    physicalKernelApply L f = physicalKernelApply G f := by
  funext x
  apply integral_congr_ae
  filter_upwards [h] with y hy
  simp [hy]

private theorem twisted_sub {d : ℕ} {m n : E d → ℂ} (hd : 0 < d)
    (hm : ContinuousOn m {x | x ≠ 0}) (hn : ContinuousOn n {x | x ≠ 0})
    {A B : ℝ} (hA : ∀ x, x ≠ 0 → ‖m x‖ ≤ A) (hB : ∀ x, x ≠ 0 → ‖n x‖ ≤ B)
    (f : Fin d → SchwartzMap (E d) ℂ) :
    twisted (m-n) f = twisted m f - twisted n f := by
  funext x
  simp only [twisted_eq_integral]
  have he (ξ : Fin d → E d) : fourierIntegrand (m-n) f x ξ =
      fourierIntegrand m f x ξ-fourierIntegrand n f x ξ := by simp [fourierIntegrand,sub_mul]
  simp_rw [he]
  exact integral_sub ((schwartzFourier_convergence hd hm hA f).1 x)
    ((schwartzFourier_convergence hd hn hB f).1 x)

open MikhlinHormander in
private theorem mollifiedMultiplier_mikhlin {d N : ℕ} (ρ : SchwartzMap (E d) ℂ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : E d → ℂ) (A : ℝ), 0 ≤ A → MikhlinCondition N m A →
      ∀ r : ℝ, 0 < r → MikhlinCondition N (fun ξ => m ξ * (𝓕 (kernelMollifier ρ r)) ξ) (C*A) := by
  let χ : SchwartzMap (E d) ℂ := 𝓕 ρ
  let P := schwartzWeightedCutoffDerivativeConstant (N := N) χ
  have hP : 0 ≤ P := by dsimp [P, schwartzWeightedCutoffDerivativeConstant]; positivity
  refine ⟨P*2^N, by positivity, ?_⟩
  intro m A hA hm r hr
  have he : (fun ξ => m ξ * (𝓕 (kernelMollifier ρ r)) ξ) = fun ξ => χ (r • ξ)*m ξ := by
    funext ξ
    rw [kernelMollifier_fourier ρ hr, mul_comm]
  rw [he]
  constructor
  · exact ((χ.smooth (N : ℕ∞)).comp (r • ContinuousLinearMap.id ℝ (E d)).contDiff).contDiffOn.mul hm.1
  · intro n hn x hx
    refine (norm_iteratedFDeriv_dilated_schwartz_cutoff_mul_mikhlin_le χ m hm hA r hx hn).trans ?_
    calc
      _ ≤ A*P*2^N := mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (by norm_num) hn) (by positivity)
      _ = _ := by ring

private theorem hardAnnulus_integrable {d : ℕ} {K : E d → ℂ}
    (hKm : Measurable K) {B ε R : ℝ} (hε : 0 < ε) (hR : ε < R) (hB : 0 ≤ B)
    (hK : ∀ y, y ≠ 0 → ‖K y‖ ≤ B*‖y‖⁻¹^d) : Integrable (hardAnnulus K ε R) := by
  have hs : MeasurableSet {y : E d | ε < ‖y‖ ∧ ‖y‖ < R} :=
    (measurableSet_lt measurable_const continuous_norm.measurable).inter
      (measurableSet_lt continuous_norm.measurable measurable_const)
  have hW : Integrable ((Metric.closedBall (0:E d) R).indicator (fun _ => B*ε⁻¹^d)) :=
    integrable_indicator_iff Metric.isClosed_closedBall.measurableSet |>.mpr
      (integrableOn_const (measure_closedBall_lt_top.ne))
  refine hW.mono' (hKm.indicator hs).aestronglyMeasurable ?_
  filter_upwards [] with y
  by_cases hy : y ∈ {y : E d | ε < ‖y‖ ∧ ‖y‖ < R}
  · have hh : y ∈ Metric.closedBall (0:E d) R := by
      simpa only [Metric.mem_closedBall,dist_zero_right] using hy.2.le
    rw [hardAnnulus, Set.indicator_of_mem hy, Set.indicator_of_mem hh]
    exact (hK y (norm_pos_iff.mp (hε.trans hy.1))).trans (by gcongr; exact hy.1.le)
  · rw [hardAnnulus, Set.indicator_of_notMem hy,norm_zero]
    exact Set.indicator_nonneg (fun _ _ => by positivity) _

private theorem mollifiedMultiplier_integrable {d : ℕ} {m : E d → ℂ} (hm : Measurable m)
    {A : ℝ} (hA : ∀ᵐ ξ ∂(volume : Measure (E d)), ‖m ξ‖ ≤ A)
    (ρ : SchwartzMap (E d) ℂ) {r : ℝ} (hr : 0 < r) :
    Integrable (fun ξ => m ξ * 𝓕 (kernelMollifier ρ r) ξ) := by
  have hG : Integrable (fun ξ : E d => (𝓕 ρ) (r • ξ)) :=
    (integrable_comp_smul_iff volume ((𝓕 ρ : SchwartzMap (E d) ℂ) : E d → ℂ) hr.ne').2 (𝓕 ρ).integrable
  have he (ξ : E d) : (𝓕 (kernelMollifier ρ r)) ξ = (𝓕 ρ) (r • ξ) :=
    kernelMollifier_fourier ρ hr ξ
  simp_rw [he]
  refine (hG.norm.const_mul A).mono' (hm.mul ((𝓕 ρ : SchwartzMap (E d) ℂ).continuous.comp
    ((r • ContinuousLinearMap.id ℝ (E d)).continuous)).measurable).aestronglyMeasurable ?_
  filter_upwards [hA] with ξ hξ
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_right hξ (norm_nonneg _)

private theorem fourierInv_sub_of_integrable {d : ℕ} {m n : E d → ℂ}
    (hm : Integrable m) (hn : Integrable n) :
    (𝓕⁻ (m-n)) = (𝓕⁻ m)-(𝓕⁻ n) := by
  funext x
  simp only [Pi.sub_apply, Real.fourierInv_eq', smul_eq_mul, mul_sub]
  apply integral_sub
  · apply hm.bdd_mul (c := 1) (by fun_prop)
    filter_upwards [] with y
    exact (Complex.norm_exp_ofReal_mul_I _).le
  · apply hn.bdd_mul (c := 1) (by fun_prop)
    filter_upwards [] with y
    exact (Complex.norm_exp_ofReal_mul_I _).le

open MikhlinHormander in
/-- The original hard annuli are uniformly bounded on Schwartz inputs. -/
theorem hardGeneral {d : ℕ} (hd : 2 ≤ d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hs : r⁻¹ = ∑ i, (p i)⁻¹) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : E d → ℂ) (A : ℝ), 0 ≤ A →
      MikhlinCondition (5*d+2) m A →
      ∃ K : E d → ℂ, ContDiffOn ℝ 1 K {x | x ≠ 0} ∧
        (∀ g : SchwartzMap (E d) ℂ, 0 ∉ tsupport (g : E d → ℂ) →
          (∫ y, K y*g y) = ∫ ξ, m ξ*(𝓕⁻ g) ξ) ∧
        ∀ ε R : ℝ, 0 < ε → ε < R → ∀ f : Fin d → SchwartzMap (E d) ℂ,
          eLpNorm (physicalKernelApply (hardAnnulus K ε R) (fun i => f i)) (ENNReal.ofReal r) volume ≤
            ENNReal.ofReal (C*A) * ∏ i, eLpNorm (f i : E d → ℂ) (ENNReal.ofReal (p i)) volume := by
  obtain ⟨B,hB,hKer⟩ := mihlinKernel hd
  obtain ⟨ρ,hρ,hρI⟩ := exists_kernelMollifier d
  obtain ⟨Cerr,hE,hErr⟩ := hardComparison ρ hρ hρI B hB
  obtain ⟨F,hF,hFull⟩ := fullMultiplier hd hp hr hs
  obtain ⟨G,hG,hGM⟩ := mollifiedMultiplier_mikhlin (N := 5*d+2) ρ
  refine ⟨2*(Cerr+F*G), by positivity, ?_⟩
  intro m A hA hm
  have hm' : MikhlinCondition (d+2) m A :=
    ⟨hm.1.of_le (by exact_mod_cast (show d+2 ≤ 5*d+2 by omega)), fun n hn => hm.2 n (by omega)⟩
  obtain ⟨K,hK,hKsz,hKp⟩ := hKer m A hA hm'
  refine ⟨K,hK,hKp,?_⟩
  intro ε R hε hεR f
  have hR := hε.trans hεR
  have hd₀ : 0 < d := by omega
  let S := ENNReal.ofReal r
  have hS : 1 ≤ S := by simpa [S] using ENNReal.ofReal_le_ofReal hr.le
  let L := hardAnnulus K ε R
  let D (s : ℝ) := {x : E d | s < ‖x‖}.indicator K - mollifiedKernel m ρ s
  let T (s : ℝ) (ξ : Auto.E d) := m ξ * (𝓕 (kernelMollifier ρ s)) ξ
  let J := mollifiedKernel m ρ ε - mollifiedKernel m ρ R
  have hmC : ContinuousOn m {x | x ≠ 0} := hm.1.continuousOn
  have hmM : Measurable m := measurable_of_continuousOn_compl_singleton 0 hmC
  have hmB (ξ : Auto.E d) (hξ : ξ ≠ 0) : ‖m ξ‖ ≤ A := by simpa using hm.2 0 (by omega) ξ hξ
  letI : Nonempty (Fin d) := ⟨⟨0,hd₀⟩⟩
  have hmAE : ∀ᵐ ξ ∂(volume : Measure (Auto.E d)), ‖m ξ‖ ≤ A :=
    (ae_ne (volume : Measure (Auto.E d)) 0).mono hmB
  have hKm : Measurable K := measurable_of_continuousOn_compl_singleton 0 hK.continuousOn
  have hLm : Measurable L := hKm.indicator ((measurableSet_lt measurable_const
    continuous_norm.measurable).inter (measurableSet_lt continuous_norm.measurable measurable_const))
  have hLi : Integrable L := hardAnnulus_integrable hKm hε hεR (mul_nonneg hB hA)
    (fun y hy => (le_add_of_nonneg_right (by positivity)).trans (hKsz y hy))
  have hDi (s : ℝ) (hs : 0 < s) : Integrable (D s) ∧ (∫ x, ‖D s x‖) ≤ Cerr*A :=
    hErr m K A hA hmM hmAE hK hKsz hKp s hs
  have hTi (s : ℝ) (hs : 0 < s) : Integrable (T s) := mollifiedMultiplier_integrable hmM hmAE ρ hs
  have hTS (s : ℝ) (hs : 0 < s) : MikhlinCondition (5*d+2) (T s) (G*A) :=
    hGM m A hA hm s hs
  have hJ : J = 𝓕⁻ (T ε-T R) := (fourierInv_sub_of_integrable (hTi ε hε) (hTi R hR)).symm
  have hJm : Measurable J := by
    rw [hJ]
    have hC : Continuous (𝓕 (T ε-T R)) := VectorFourier.fourierIntegral_continuous
      Real.continuous_fourierChar (innerSL ℝ).continuous₂ ((hTi ε hε).sub (hTi R hR))
    have he : 𝓕⁻ (T ε-T R) = (𝓕 (T ε-T R)) ∘ Neg.neg := by
      funext x
      exact Real.fourierInv_eq_fourier_neg _ _
    rw [he]
    exact hC.measurable.comp measurable_neg
  have hDecomp : L =ᵐ[volume] J - (D R-D ε) := by
    have ha : ∀ᵐ x ∂(volume : Measure (Auto.E d)), ‖x‖ ≠ R := by
      apply ae_iff.mpr
      simpa [Metric.sphere, dist_zero_right] using addHaar_sphere_of_ne_zero
        (volume : Measure (Auto.E d)) 0 hR.ne'
    filter_upwards [ha] with x hx
    change hardAnnulus K ε R x = J x-(D R x-D ε x)
    unfold hardAnnulus J D
    simp only [Pi.sub_apply]
    simp only [Set.indicator, Set.mem_setOf_eq]
    split_ifs <;> (first | (exfalso; grind) | abel)
  have hJi : Integrable J := by
    have h := (hLi.add ((hDi R hR).1.sub (hDi ε hε).1))
    apply h.congr
    filter_upwards [hDecomp] with x hx
    change L x + (D R x-D ε x) = J x
    change L x = J x-(D R x-D ε x) at hx
    rw [hx]
    abel
  have hTfourier : Integrable (𝓕 (T ε-T R)) := by
    have h := (measurePreserving_neg (volume : Measure (Auto.E d))).integrable_comp_of_integrable hJi
    convert h using 1
    funext x
    simp only [Function.comp_apply, hJ, Real.fourierInv_eq_fourier_neg, neg_neg]
  have hEq (ξ : Auto.E d) (hξ : ξ ≠ 0) : (𝓕 J) ξ = (T ε-T R) ξ := by
    rw [hJ]
    refine ((hTi ε hε).sub (hTi R hR)).fourier_fourierInv_eq hTfourier ?_
    have hc : ContinuousOn (T ε-T R) {x | x ≠ 0} :=
      (hTS ε hε).1.continuousOn.sub (hTS R hR).1.continuousOn
    exact (hc ξ hξ).continuousAt (isOpen_compl_singleton.mem_nhds hξ)
  have hLr : physicalKernelApply L (fun i => f i) =
      physicalKernelApply J (fun i => f i) -
        (physicalKernelApply (D R) (fun i => f i)-physicalKernelApply (D ε) (fun i => f i)) := by
    rw [physicalKernelApply_congr hDecomp, physicalKernelApply_sub hJi ((hDi R hR).1.sub (hDi ε hε).1),
      physicalKernelApply_sub (hDi R hR).1 (hDi ε hε).1]
  have hJr : physicalKernelApply J (fun i => f i) = twisted (T ε) f - twisted (T R) f := by
    have he : physicalKernelApply J (fun i => f i) = twisted (T ε-T R) f := by
      funext x
      exact (physicalIntegrable_fourier hJi hJm f x).trans (twisted_congr_off_origin hd₀ hEq f x)
    rw [he]
    have hb (s : ℝ) (hs : 0 < s) (ξ : Auto.E d) (hξ : ξ ≠ 0) : ‖T s ξ‖ ≤ G*A := by
      simpa using (hTS s hs).2 0 (by omega) ξ hξ
    exact twisted_sub hd₀ (hTS ε hε).1.continuousOn (hTS R hR).1.continuousOn (hb ε hε) (hb R hR) f
  let Z := ∏ i, eLpNorm (f i : Auto.E d → ℂ) (ENNReal.ofReal (p i)) volume
  have hLbound (s : ℝ) (hs : 0 < s) :
      eLpNorm (physicalKernelApply (D s) (fun i => f i)) S volume ≤ ENNReal.ofReal (Cerr*A)*Z := by
    have hDm : Measurable (D s) := by
      apply (hKm.indicator (measurableSet_lt measurable_const continuous_norm.measurable)).sub
      change Measurable (𝓕⁻ (T s))
      have he : 𝓕⁻ (T s) = (𝓕 (T s)) ∘ Neg.neg := by
        funext x
        exact Real.fourierInv_eq_fourier_neg _ _
      rw [he]
      exact (VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
        (innerSL ℝ).continuous₂ (hTi s hs)).measurable.comp measurable_neg
    refine (physicalIntegrable hp hr (by assumption) (hDi s hs).1 hDm
      (fun i => f i) (fun i => (f i).continuous.measurable)).trans ?_
    apply mul_le_mul_left
    rw [eLpNorm_one_eq_lintegral_enorm (hDi s hs).1.aestronglyMeasurable]
    simp_rw [← ofReal_norm]
    rw [← ofReal_integral_eq_lintegral_ofReal (hDi s hs).1.norm
        (Filter.Eventually.of_forall fun x => norm_nonneg (D s x))]
    exact ENNReal.ofReal_le_ofReal (hDi s hs).2
  have hTb (s : ℝ) (hs : 0 < s) : eLpNorm (twisted (T s) f) S volume ≤
      ENNReal.ofReal (F*(G*A))*Z := hFull (T s) (G*A) (by positivity) (hTS s hs) f
  rw [hLr,hJr]
  refine ((eLpNorm_sub_le hS).trans (add_le_add
    ((eLpNorm_sub_le hS).trans (add_le_add (hTb ε hε) (hTb R hR)))
    ((eLpNorm_sub_le hS).trans (add_le_add (hLbound R hR) (hLbound ε hε))))).trans_eq ?_
  rw [← add_mul, ← add_mul, ← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity),
    ← ENNReal.ofReal_add (by positivity) (by positivity), ← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 2
  ring

private theorem smoothSeries_on_ball {d : ℕ} {x₀ : E d} {ρ : ℝ} (hρ : 0 < ρ)
    (F : ℤ → E d → ℂ) (hF : ∀ k, ContDiff ℝ (↑(⊤ : ℕ∞)) (F k))
    (v : ℕ → ℤ → ℝ) (hv : ∀ n, Summable (v n))
    (hV : ∀ n k x, x ∈ Metric.ball x₀ ρ → ‖iteratedFDeriv ℝ n (F k) x‖ ≤ v n k) :
    ContDiffOn ℝ (↑(⊤ : ℕ∞)) (fun x => ∑' k, F k x) (Metric.ball x₀ ρ) ∧
      ∀ n x, x ∈ Metric.ball x₀ ρ →
        iteratedFDeriv ℝ n (fun z => ∑' k, F k z) x =
          ∑' k, iteratedFDeriv ℝ n (F k) x := by
  let S := Metric.ball x₀ ρ
  let M (x : E d) := ∑' k, F k x
  have ho : IsOpen S := Metric.isOpen_ball
  have hc : IsPreconnected S := (convex_ball x₀ ρ).isPreconnected
  have hx₀ : x₀ ∈ S := Metric.mem_ball_self hρ
  have hs (n : ℕ) (x : E d) (hx : x ∈ S) :
      Summable (fun k => iteratedFDeriv ℝ n (F k) x) :=
    (hv n).of_norm_bounded fun k => hV n k x hx
  have hD (n : ℕ) (x : E d) (hx : x ∈ S) :
      HasFDerivAt (fun y => ∑' k, iteratedFDeriv ℝ n (F k) y)
        (∑' k, fderiv ℝ (iteratedFDeriv ℝ n (F k)) x) x := by
    apply hasFDerivAt_tsum_of_isPreconnected (hv (n+1)) ho hc _ _ hx₀ (hs n x₀ hx₀) hx
    · intro k y _
      exact ((hF k).differentiable_iteratedFDeriv (m := n) (by exact_mod_cast WithTop.coe_lt_top (α := ℕ) n) y).hasFDerivAt
    · intro k y hy
      rw [fderiv_iteratedFDeriv, Function.comp_apply, LinearIsometryEquiv.norm_map]
      exact hV (n+1) k y hy
  have he (n : ℕ) : EqOn (iteratedFDeriv ℝ n M) (fun x => ∑' k, iteratedFDeriv ℝ n (F k) x) S := by
    induction n with
    | zero =>
      intro x _
      simp_rw [iteratedFDeriv_zero_eq_comp, Function.comp_apply, M]
      exact (continuousMultilinearCurryFin0 ℝ (E d) ℂ).symm.toContinuousLinearEquiv.map_tsum
    | succ n ih =>
      intro x hx
      have hEq : iteratedFDeriv ℝ n M =ᶠ[𝓝 x] (fun x => ∑' k, iteratedFDeriv ℝ n (F k) x) :=
        Filter.mem_of_superset (ho.mem_nhds hx) fun y hy => ih hy
      simp_rw [iteratedFDeriv_succ_eq_comp_left, Function.comp_apply]
      rw [hEq.fderiv_eq, (hD n x hx).fderiv]
      exact (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n+1) => E d) ℂ).symm.toContinuousLinearEquiv.map_tsum
  refine ⟨?_, fun n x hx => he n hx⟩
  rw [contDiffOn_infty]
  intro n
  rw [contDiffOn_nat_iff_continuousOn_differentiableOn ho.uniqueDiffOn]
  have hu (j : ℕ) : EqOn (iteratedFDerivWithin ℝ j M S)
      (fun x => ∑' k, iteratedFDeriv ℝ j (F k) x) S := by
    intro x hx
    rw [iteratedFDerivWithin_of_isOpen j ho hx]
    exact he j hx
  constructor
  · intro j _
    exact (continuousOn_tsum (fun k =>
      ((hF k).continuous_iteratedFDeriv (by simp)).continuousOn) (hv j) (hV j)).congr (hu j)
  · intro j _ x hx
    exact (hD j x hx).differentiableAt.differentiableWithinAt.congr (hu j) (hu j hx)

private theorem schwartzDilation_derivative_le {d : ℕ} (G : SchwartzMap (E d) ℂ)
    {s : ℝ} (hs : 0 < s) (n : ℕ) (x : E d) :
    ‖iteratedFDeriv ℝ n (fun y => G (s • y)) x‖ ≤
      s^n*‖iteratedFDeriv ℝ n (G : E d → ℂ) (s • x)‖ := by
  let L := s • ContinuousLinearMap.id ℝ (E d)
  have he : (fun y => G (s • y)) = (G : E d → ℂ) ∘ L := rfl
  rw [he, L.iteratedFDeriv_comp_right (G.smooth (n : ℕ∞)) _ le_rfl]
  refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  have hL : ‖L‖ ≤ s := by
    calc
      _ = s*‖ContinuousLinearMap.id ℝ (E d)‖ := by
        simp [L, norm_smul, Real.norm_of_nonneg hs.le]
      _ ≤ _ := mul_le_of_le_one_right hs.le ContinuousLinearMap.norm_id_le
  change ‖iteratedFDeriv ℝ n (G : E d → ℂ) (s • x)‖ * ‖L‖^n ≤ _
  rw [mul_comm]
  gcongr

private theorem schwartz_vanishes_linear_bound {d : ℕ} (G : SchwartzMap (E d) ℂ) (hG : G 0 = 0)
    (x : E d) : ‖G x‖ ≤ SchwartzMap.seminorm ℝ 0 1 G * ‖x‖ := by
  have hD (y : E d) : ‖fderiv ℝ (G : E d → ℂ) y‖ ≤ SchwartzMap.seminorm ℝ 0 1 G := by
    simpa only [pow_zero, one_mul, norm_iteratedFDeriv_one] using SchwartzMap.le_seminorm ℝ 0 1 G y
  simpa only [hG, sub_zero] using (convex_univ : Convex ℝ (Set.univ : Set (E d)))
    |>.norm_image_sub_le_of_norm_fderiv_le
      (fun y _ => G.differentiable y) (fun y _ => hD y) (mem_univ 0) (mem_univ x)

private theorem schwartzDyadic_derivative_bounds {d : ℕ} (G : SchwartzMap (E d) ℂ) (hG : G 0 = 0) :
    ∃ P Q : ℕ → ℝ, (∀ n, 0 ≤ P n) ∧ (∀ n, 0 ≤ Q n) ∧
      ∀ n (k : ℤ) (x : E d), x ≠ 0 →
        let a := max 1 n
        ‖iteratedFDeriv ℝ n (fun y => G (((2:ℝ)^k) • y)) x‖ ≤
          min (P n*‖x‖^(a-n)*(2:ℝ)^(k*(a:ℤ)))
            (Q n*‖x‖^(a-n)*(2:ℝ)^(-k*(2:ℤ))/‖x‖^(a+2)) := by
  let P (n : ℕ) := if n = 0 then SchwartzMap.seminorm ℝ 0 1 G else SchwartzMap.seminorm ℝ 0 n G
  let Q (n : ℕ) := SchwartzMap.seminorm ℝ (n+2) n G
  refine ⟨P,Q,fun n => by unfold P; split_ifs <;> positivity, fun n => by dsimp [Q]; positivity,?_⟩
  intro n k x hx
  let s : ℝ := (2:ℝ)^k
  have hs : 0 < s := by dsimp [s]; positivity
  have hx₀ : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have he (j : ℕ) : s^j = (2:ℝ)^(k*(j:ℤ)) := by rw [zpow_mul, zpow_natCast]
  have he' : (2:ℝ)^(-k*(2:ℤ)) = (s^2)⁻¹ := by rw [neg_mul, zpow_neg]; exact congrArg Inv.inv (he 2).symm
  have hX : ‖s • x‖ = s*‖x‖ := by rw [norm_smul, Real.norm_of_nonneg hs.le]
  dsimp only
  apply le_min
  · cases n with
    | zero =>
      rw [norm_iteratedFDeriv_zero, show max 1 0 = 1 by decide, ← he]
      simp only [Nat.sub_zero, pow_one, P, if_pos rfl]
      exact (schwartz_vanishes_linear_bound G hG (s • x)).trans_eq (by rw [hX]; ring)
    | succ n =>
      rw [max_eq_right (by omega : 1 ≤ n+1), Nat.sub_self, pow_zero, mul_one, ← he]
      refine (schwartzDilation_derivative_le G hs _ _).trans ?_
      rw [mul_comm (P _)]
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      simpa [P] using SchwartzMap.le_seminorm ℝ 0 (n+1) G (s • x)
  · rw [he']
    have h := SchwartzMap.le_seminorm ℝ (n+2) n G (s • x)
    rw [hX, mul_pow, pow_add s] at h
    have hB : s^n*‖iteratedFDeriv ℝ n (G : E d → ℂ) (s • x)‖ ≤
        Q n*(s^2)⁻¹/‖x‖^(n+2) := by
      have he : Q n*(s^2)⁻¹/‖x‖^(n+2) = Q n/(s^2*‖x‖^(n+2)) := by
        simp only [div_eq_mul_inv,mul_inv]
        ring
      rw [he]
      apply (le_div_iff₀ (mul_pos (pow_pos hs _) (pow_pos hx₀ _))).mpr
      convert h using 1 <;> ring
    refine (schwartzDilation_derivative_le G hs _ _).trans (hB.trans_eq ?_)
    cases n with
    | zero =>
      norm_num
      field_simp [hx₀.ne']
    | succ n =>
      rw [max_eq_right (by omega : 1 ≤ n+1), Nat.sub_self, pow_zero, mul_one]

private theorem schwartzDyadic_mikhlin {d : ℕ} (G : SchwartzMap (E d) ℂ) (hG : G 0 = 0) :
    ∃ B : ℕ → ℝ, (∀ n, 0 ≤ B n) ∧
      let m (x : E d) := ∑' k : ℤ, G (((2:ℝ)^k) • x)
      ContDiffOn ℝ (↑(⊤ : ℕ∞)) m {x | x ≠ 0} ∧
      (∀ x : E d, Summable (fun k : ℤ => ‖G (((2:ℝ)^k) • x)‖) ∧
        (∑' k : ℤ, ‖G (((2:ℝ)^k) • x)‖) ≤ B 0) ∧
      ∀ n (x : E d), x ≠ 0 → ‖x‖^n*‖iteratedFDeriv ℝ n m x‖ ≤ B n := by
  obtain ⟨P,Q,hP,hQ,hBound⟩ := schwartzDyadic_derivative_bounds G hG
  let F (k : ℤ) (x : E d) := G (((2:ℝ)^k) • x)
  let m (x : E d) := ∑' k, F k x
  let a (n : ℕ) := max 1 n
  have ha (n : ℕ) : 0 < a n := lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  let W (n : ℕ) := ∑' k : ℤ, if 0 ≤ k then (2:ℝ)^(-k*(2:ℤ)) else (2:ℝ)^(k*(a n:ℤ))
  let B (n : ℕ) := (P n+Q n*2^2)*W n
  have hB (n : ℕ) : 0 ≤ B n := by
    apply mul_nonneg (add_nonneg (hP n) (mul_nonneg (hQ n) (by positivity)))
    apply tsum_nonneg
    intro k
    split_ifs <;> positivity
  have hSmooth (k : ℤ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (F k) :=
    G.smooth'.comp (((2:ℝ)^k • ContinuousLinearMap.id ℝ (E d)).contDiff)
  have hTerm (n : ℕ) (k : ℤ) (x : E d) (hx : x ≠ 0) : ‖iteratedFDeriv ℝ n (F k) x‖ ≤
      min (P n*‖x‖^(a n-n)*(2:ℝ)^(k*(a n:ℤ)))
        (Q n*‖x‖^(a n-n)*(2:ℝ)^(-k*(2:ℤ))/‖x‖^(a n+2)) := hBound n k x hx
  have hLoc (x : E d) (hx : x ≠ 0) :
      ContDiffAt ℝ (↑(⊤ : ℕ∞)) m x ∧
        ∀ n, iteratedFDeriv ℝ n m x = ∑' k, iteratedFDeriv ℝ n (F k) x := by
    let ρ := ‖x‖/2
    let R := ‖x‖+ρ
    have hρ : 0 < ρ := half_pos (norm_pos_iff.mpr hx)
    have hR : 0 ≤ R := by dsimp [R]; positivity
    let S := Metric.ball x ρ
    let v (n : ℕ) (k : ℤ) := min (P n*R^(a n-n)*(2:ℝ)^(k*(a n:ℤ)))
      (Q n*R^(a n-n)*(2:ℝ)^(-k*(2:ℤ))/ρ^(a n+2))
    have hv (n : ℕ) : Summable (v n) :=
      dyadicKernel_summable (ha n) (by norm_num) hρ
        (mul_nonneg (hP n) (by positivity)) (mul_nonneg (hQ n) (by positivity))
    have hV (n : ℕ) (k : ℤ) (y : E d) (hy : y ∈ S) :
        ‖iteratedFDeriv ℝ n (F k) y‖ ≤ v n k := by
      have hd : ‖y-x‖ < ρ := by simpa [S,Metric.mem_ball,dist_eq_norm] using hy
      have hL : ρ ≤ ‖y‖ := by
        have h := norm_add_le (x-y) y
        rw [sub_add_cancel,norm_sub_rev] at h
        dsimp [ρ] at *
        linarith
      have hU : ‖y‖ ≤ R := by
        have h := norm_add_le (y-x) x
        rw [sub_add_cancel] at h
        dsimp [R]
        linarith
      refine (hTerm n k y (norm_pos_iff.mp (hρ.trans_le hL))).trans (min_le_min ?_ ?_)
      · have := hP n
        gcongr
      · have := hQ n
        gcongr
    obtain ⟨hC,hD⟩ := smoothSeries_on_ball hρ F hSmooth v hv hV
    have hxs := Metric.mem_ball_self (x := x) hρ
    exact ⟨(hC x hxs).contDiffAt (Metric.isOpen_ball.mem_nhds hxs), fun n => hD n x hxs⟩
  have hNorm (n : ℕ) (x : E d) (hx : x ≠ 0) :
      Summable (fun k => ‖iteratedFDeriv ℝ n (F k) x‖) ∧
      (∑' k, ‖iteratedFDeriv ℝ n (F k) x‖) ≤ B n*‖x‖⁻¹^n := by
    have hx₀ := norm_pos_iff.mpr hx
    have hs := dyadicKernel_summable (ha n) (by norm_num : 0 < 2) hx₀
      (mul_nonneg (hP n) (pow_nonneg (norm_nonneg x) (a n-n)))
      (mul_nonneg (hQ n) (pow_nonneg (norm_nonneg x) (a n-n)))
    have hs' := hs.of_nonneg_of_le (fun k => norm_nonneg (iteratedFDeriv ℝ n (F k) x))
      (fun k => hTerm n k x hx)
    refine ⟨hs', (hs'.tsum_le_tsum (fun k => hTerm n k x hx) hs).trans ?_⟩
    refine (dyadicKernel_tsum_le (ha n) (by norm_num : 0 < 2) hx₀
      (mul_nonneg (hP n) (pow_nonneg (norm_nonneg x) (a n-n)))
      (mul_nonneg (hQ n) (pow_nonneg (norm_nonneg x) (a n-n)))).trans_eq ?_
    have he : ‖x‖^(a n-n)*‖x‖⁻¹^(a n) = ‖x‖⁻¹^n := by
      have hah : a n = (a n-n)+n := (Nat.sub_add_cancel (le_max_right _ _)).symm
      conv_lhs => arg 2; rw [hah,pow_add]
      rw [← mul_assoc, ← mul_pow, mul_inv_cancel₀ hx₀.ne', one_pow, one_mul]
    change (P n*‖x‖^(a n-n)+Q n*‖x‖^(a n-n)*2^2)*‖x‖⁻¹^(a n)*W n = B n*‖x‖⁻¹^n
    calc
      _ = B n*(‖x‖^(a n-n)*‖x‖⁻¹^(a n)) := by dsimp [B]; ring
      _ = _ := by rw [he]
  refine ⟨B,hB,fun x hx => (hLoc x hx).1.contDiffWithinAt,?_,?_⟩
  · intro x
    by_cases hx : x = 0
    · subst x
      simp [hG,hB]
    · simpa only [norm_iteratedFDeriv_zero, pow_zero, mul_one, F] using hNorm 0 x hx
  · intro n x hx
    rw [(hLoc x hx).2 n]
    refine (mul_le_mul_of_nonneg_left ((norm_tsum_le_tsum_norm (hNorm n x hx).1).trans
      (hNorm n x hx).2) (by positivity)).trans_eq ?_
    rw [mul_left_comm, ← mul_pow, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hx), one_pow, mul_one]

private theorem homogeneousKernel_dilate {d : ℕ}
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    {r : ℝ} (hr : 0 < r) {y : E d} (hy : y ≠ 0) :
    homogeneousKernel Ω (r • y) = (↑(r⁻¹^d):ℂ)*homogeneousKernel Ω y := by
  have hsy : r • y ≠ 0 := smul_ne_zero hr.ne' hy
  have he : (homeomorphUnitSphereProd (E d) ⟨r • y,hsy⟩).1 =
      (homeomorphUnitSphereProd (E d) ⟨y,hy⟩).1 := by
    apply Subtype.ext
    simp only [homeomorphUnitSphereProd_apply_fst_coe, norm_smul, Real.norm_of_nonneg hr.le, mul_inv, smul_smul]
    congr 1
    field_simp [hr.ne', norm_ne_zero_iff.mpr hy]
  simp only [homogeneousKernel, dif_neg hsy, dif_neg hy, he, norm_smul,
    Real.norm_of_nonneg hr.le, mul_inv, mul_pow, Complex.ofReal_mul, mul_assoc]

private theorem homogeneousKernel_radial_integral {d : ℕ}
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    (hΩ : (∫ ω, Ω ω ∂(volume : Measure (E d)).toSphere) = 0) (w : ℝ → ℂ) :
    (∫ y, homogeneousKernel Ω y * w ‖y‖) = 0 := by
  let μ : Measure (E d) := volume
  let ν := μ.toSphere
  let σ := volumeIoiPow (Module.finrank ℝ (E d) - 1)
  let e := homeomorphUnitSphereProd (E d)
  let H (z : Metric.sphere (0 : E d) 1 × Ioi (0 : ℝ)) : ℂ :=
    Ω z.1 * ((↑((z.2:ℝ)⁻¹^d):ℂ) * w z.2)
  have he (z : ({0}ᶜ : Set (E d))) :
      homogeneousKernel Ω z * w ‖(z:E d)‖ = H (e z) := by
    have hz : (z:E d) ≠ 0 := z.property
    simp only [H,e,homogeneousKernel,dif_neg hz,homeomorphUnitSphereProd_apply_snd_coe]
    ring
  have hzero : (∫ y : E d, homogeneousKernel Ω y*w ‖y‖ ∂(μ.restrict ({0}ᶜ))) =
      ∫ y : E d, homogeneousKernel Ω y*w ‖y‖ ∂μ := by
    by_cases hd : d = 0
    · subst d
      haveI : Subsingleton (E 0) := inferInstance
      simp [Subsingleton.elim (α := E 0) _ 0, homogeneousKernel]
    · letI : Nonempty (Fin d) := ⟨⟨0,Nat.pos_of_ne_zero hd⟩⟩
      rw [restrict_compl_singleton]
  rw [← hzero, ← integral_subtype_comap (measurableSet_singleton _).compl]
  simp_rw [he]
  have hmp := measurePreserving_homeomorphUnitSphereProd μ
  rw [hmp.integral_comp (Homeomorph.measurableEmbedding _) H]
  change (∫ z, H z ∂ν.prod σ) = 0
  change (∫ z, Ω z.1 * ((↑((z.2:ℝ)⁻¹^d):ℂ) * w z.2) ∂ν.prod σ) = 0
  let U (t : Ioi (0:ℝ)) : ℂ := (↑((t:ℝ)⁻¹^d):ℂ)*w t
  change (∫ z, Ω z.1*U z.2 ∂ν.prod σ) = 0
  rw [integral_prod_mul Ω U, show (∫ ω, Ω ω ∂ν) = 0 from hΩ, zero_mul]

private theorem dyadicAnnularCutoff_radial {d : ℕ} (y : E d) :
    dyadicAnnularCutoff y = Real.smoothTransition ((4-‖y‖^2)/3) -
      Real.smoothTransition ((4-(2*‖y‖)^2)/3) := by
  unfold dyadicAnnularCutoff radialProfileCutoff
  rw [norm_smul, Real.norm_of_nonneg (by norm_num : (0:ℝ) ≤ 2)]

private theorem homogeneousAnnularSchwartz {d : ℕ}
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    (hK : ContDiffOn ℝ (↑(⊤ : ℕ∞)) (homogeneousKernel Ω) {y | y ≠ 0})
    (hΩ : (∫ ω, Ω ω ∂(volume : Measure (E d)).toSphere) = 0) :
    ∃ L : SchwartzMap (E d) ℂ,
      (∀ y, L y = homogeneousKernel Ω y * dyadicAnnularCutoff y) ∧ (∫ y, L y) = 0 := by
  let K := homogeneousKernel Ω
  let L (y : E d) := K y * (dyadicAnnularCutoff y : ℂ)
  have hL0 : EqOn L 0 (Metric.ball 0 (1/2)) := by
    intro y hy
    have hn : ‖y‖ < 1/2 := by simpa [Metric.mem_ball,dist_zero_right] using hy
    simp [L, dyadicAnnularCutoff_eq_zero (Or.inl hn.le)]
  have hL : ContDiff ℝ (↑(⊤ : ℕ∞)) L := by
    apply contDiff_iff_contDiffAt.mpr
    intro y
    by_cases hy : y = 0
    · subst y
      apply contDiffAt_const.congr_of_eventuallyEq
      filter_upwards [Metric.ball_mem_nhds (0 : E d) (by norm_num : (0:ℝ) < 1/2)] with z hz
      exact hL0 hz
    · exact (hK.contDiffAt (isOpen_compl_singleton.mem_nhds hy)).mul
        (Complex.ofRealCLM.contDiff.comp dyadicAnnularCutoff_smooth).contDiffAt
  have hLc : HasCompactSupport L :=
    (dyadicAnnularCutoff_compact.comp_left Complex.ofReal_zero).mul_left
  refine ⟨hLc.toSchwartzMap hL,fun _ => rfl,?_⟩
  change (∫ y, L y) = 0
  simp_rw [L,dyadicAnnularCutoff_radial]
  exact homogeneousKernel_radial_integral Ω hΩ (fun t =>
    (↑(Real.smoothTransition ((4-t^2)/3)-Real.smoothTransition ((4-(2*t)^2)/3)):ℂ))

private theorem homogeneousKernel_size {d : ℕ}
    {Ω : Metric.sphere (0 : E d) 1 → ℂ}
    (hK : ContinuousOn (homogeneousKernel Ω) {y | y ≠ 0}) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ y, ‖homogeneousKernel Ω y‖ ≤ C*‖y‖⁻¹^d := by
  have hS : Metric.sphere (0 : E d) 1 ⊆ {y : E d | y ≠ 0} := by
    intro y hy
    rw [Metric.mem_sphere,dist_zero_right] at hy
    exact norm_ne_zero_iff.mp (by linarith)
  obtain ⟨C,hC⟩ := (isCompact_sphere (0 : E d) 1).exists_bound_of_continuousOn (hK.mono hS)
  refine ⟨max C 0,le_max_right _ _,?_⟩
  intro y
  by_cases hy : y = 0
  · simp [homogeneousKernel, hy]
    positivity
  · let ω := (homeomorphUnitSphereProd (E d) ⟨y,hy⟩).1
    have hω (z : Metric.sphere (0 : E d) 1) : homogeneousKernel Ω z = Ω z := by
      have hz : (z:E d) ≠ 0 := hS z.property
      have hn : ‖(z:E d)‖ = 1 := by simpa [Metric.mem_sphere,dist_zero_right] using z.property
      have hE : (homeomorphUnitSphereProd (E d) ⟨z,hz⟩).1 = z := by
        apply Subtype.ext
        simp only [homeomorphUnitSphereProd_apply_fst_coe, hn, inv_one, one_smul]
      simp [homogeneousKernel, hz, hn, hE]
    have hb := (hC (ω:E d) ω.property).trans (le_max_left C 0)
    rw [hω] at hb
    simp only [homogeneousKernel, dif_neg hy, norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (by positivity : 0 ≤ ‖y‖⁻¹^d)]
    rw [mul_comm]
    exact mul_le_mul_of_nonneg_right hb (by positivity)

private noncomputable def principalValueWeight (d : ℕ) (t : ℝ) : ℝ :=
  if t ≤ 1 then t⁻¹^(d-1) else t⁻¹^(d+1)

private theorem principalValueWeight_integrable {d : ℕ} (hd : 2 ≤ d) :
    Integrable (fun y : E d => principalValueWeight d ‖y‖) := by
  letI : Nonempty (Fin d) := ⟨⟨0, by omega⟩⟩
  apply (integrable_fun_norm_addHaar (volume : Measure (E d))).2
  have h0 : Integrable ((Ioc (0:ℝ) 1).indicator (fun _ => (1:ℝ))) :=
    (integrable_indicator_iff measurableSet_Ioc).mpr (integrableOn_const measure_Ioc_lt_top.ne)
  have h1 : Integrable ((Ioi (1:ℝ)).indicator (fun t => t^(-2:ℝ))) :=
    (integrable_indicator_iff measurableSet_Ioi).mpr (integrableOn_Ioi_rpow_of_lt (by norm_num) zero_lt_one)
  refine (h0.add h1).integrableOn.congr_fun ?_ measurableSet_Ioi
  intro t ht
  have ht₀ : 0 < t := ht
  simp only [Pi.add_apply, finrank_euclideanSpace_fin, smul_eq_mul]
  by_cases ht₁ : t ≤ 1
  · rw [Set.indicator_of_mem (show t ∈ Ioc (0:ℝ) 1 from ⟨ht₀,ht₁⟩),
      Set.indicator_of_notMem (show t ∉ Ioi (1:ℝ) from not_lt.mpr ht₁),
      add_zero, principalValueWeight, if_pos ht₁, ← mul_pow, mul_inv_cancel₀ ht₀.ne', one_pow]
  · have ht₂ : 1 < t := lt_of_not_ge ht₁
    rw [Set.indicator_of_notMem (show t ∉ Ioc (0:ℝ) 1 from fun h => ht₁ h.2),
      Set.indicator_of_mem (show t ∈ Ioi (1:ℝ) from ht₂),
      zero_add, principalValueWeight, if_neg ht₁, show d+1=d-1+2 by omega, pow_add, ← mul_assoc,
      ← mul_pow, mul_inv_cancel₀ ht₀.ne', one_pow, one_mul, Real.rpow_neg ht₀.le, Real.rpow_two, inv_pow]

private theorem compensatedPrincipalValue_bound {d : ℕ} (hd : 2 ≤ d)
    {K g : E d → ℂ} (hK0 : K 0 = 0) {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hK : ∀ y, ‖K y‖ ≤ C*‖y‖⁻¹^d)
    (hNear : ∀ y, ‖y‖ ≤ 1 → ‖g y-g 0‖ ≤ D*‖y‖)
    (hFar : ∀ y, 1 < ‖y‖ → ‖g y‖ ≤ D*‖y‖⁻¹) (y : E d) :
    ‖compensatedPrincipalValue K g y‖ ≤ C*D*principalValueWeight d ‖y‖ := by
  by_cases hy : y = 0
  · subst y
    simp [compensatedPrincipalValue,hK0,principalValueWeight]
    positivity
  have hy₀ := norm_pos_iff.mpr hy
  by_cases h : ‖y‖ ≤ 1
  · rw [compensatedPrincipalValue, Set.indicator_of_mem (show y ∈ {z : E d | ‖z‖ ≤ 1} from h),
      norm_mul, principalValueWeight, if_pos h]
    refine (mul_le_mul (hK y) (hNear y h) (norm_nonneg _) (by positivity)).trans_eq ?_
    have hpow : ‖y‖⁻¹^d = ‖y‖⁻¹^(d-1)*‖y‖⁻¹ := by
      have he := pow_succ (‖y‖⁻¹) (d-1)
      rw [show d-1+1=d by omega] at he
      exact he
    rw [hpow]
    calc
      _ = C*D*(‖y‖⁻¹^(d-1)*(‖y‖⁻¹*‖y‖)) := by ring
      _ = _ := by rw [inv_mul_cancel₀ hy₀.ne',mul_one]
  · rw [compensatedPrincipalValue, Set.indicator_of_notMem (show y ∉ {z : E d | ‖z‖ ≤ 1} from h),
      sub_zero, norm_mul, principalValueWeight, if_neg h, pow_succ]
    exact (mul_le_mul (hK y) (hFar y (lt_of_not_ge h)) (norm_nonneg _) (by positivity)).trans_eq (by ring)

private theorem schwartz_compensated_integrable {d : ℕ} (hd : 2 ≤ d)
    {Ω : Metric.sphere (0 : E d) 1 → ℂ}
    (hK : ContinuousOn (homogeneousKernel Ω) {y | y ≠ 0}) (g : SchwartzMap (E d) ℂ) :
    Integrable (compensatedPrincipalValue (homogeneousKernel Ω) g) := by
  obtain ⟨C,hC,hB⟩ := homogeneousKernel_size hK
  let D := SchwartzMap.seminorm ℝ 0 1 g + SchwartzMap.seminorm ℝ 1 0 g
  have hD : 0 ≤ D := by dsimp [D]; positivity
  have hNear (y : E d) (_ : ‖y‖ ≤ 1) : ‖g y-g 0‖ ≤ D*‖y‖ := by
    have h (z : E d) : ‖fderiv ℝ (g : E d → ℂ) z‖ ≤ D := by
      refine (le_trans ?_ (le_add_of_nonneg_right (by positivity : 0 ≤ SchwartzMap.seminorm ℝ 1 0 g)))
      simpa only [pow_zero, one_mul,norm_iteratedFDeriv_one] using SchwartzMap.le_seminorm ℝ 0 1 g z
    simpa only [sub_zero] using (convex_univ : Convex ℝ (Set.univ : Set (E d)))
      |>.norm_image_sub_le_of_norm_fderiv_le
        (fun z _ => g.differentiable z) (fun z _ => h z) (mem_univ 0) (mem_univ y)
  have hFar (y : E d) (hy : 1 < ‖y‖) : ‖g y‖ ≤ D*‖y‖⁻¹ := by
    rw [← div_eq_mul_inv]
    apply (le_div_iff₀ (zero_lt_one.trans hy)).mpr
    have h := SchwartzMap.le_seminorm ℝ 1 0 g y
    simp only [pow_one,norm_iteratedFDeriv_zero] at h
    rw [mul_comm]
    exact h.trans (le_add_of_nonneg_left (by positivity))
  have hKm := measurable_of_continuousOn_compl_singleton 0 hK
  have hGm : Measurable (compensatedPrincipalValue (homogeneousKernel Ω) g) :=
    hKm.mul (g.continuous.measurable.sub (measurable_const.indicator
      (measurableSet_le continuous_norm.measurable measurable_const)))
  refine ((principalValueWeight_integrable hd).const_mul (C*D)).mono' hGm.aestronglyMeasurable ?_
  exact Filter.Eventually.of_forall (compensatedPrincipalValue_bound hd (by simp [homogeneousKernel])
    hC hD hB hNear hFar)

private noncomputable def homogeneousAnnularPiece {d : ℕ}
    (Ω : Metric.sphere (0 : E d) 1 → ℂ) (k : ℤ) (y : E d) : ℂ :=
  homogeneousKernel Ω y * (dyadicAnnularCutoff (((2:ℝ)^(-k)) • y) : ℂ)

private theorem homogeneousAnnularPiece_eq {d : ℕ}
    {Ω : Metric.sphere (0 : E d) 1 → ℂ} {L : SchwartzMap (E d) ℂ}
    (hL : ∀ y, L y = homogeneousKernel Ω y*dyadicAnnularCutoff y)
    (k : ℤ) : homogeneousAnnularPiece Ω k = kernelMollifier L ((2:ℝ)^k) := by
  funext y
  by_cases hy : y = 0
  · simp [hy,homogeneousAnnularPiece,kernelMollifier,hL,homogeneousKernel]
  · unfold homogeneousAnnularPiece kernelMollifier
    rw [← zpow_neg, hL, homogeneousKernel_dilate Ω (by positivity) hy, zpow_neg, inv_pow, inv_inv]
    have hz : ((2:ℝ)^k)^d ≠ 0 := by positivity
    have he : ((↑(((2:ℝ)^k)^d)⁻¹:ℂ))*((↑(((2:ℝ)^k)^d):ℂ)) = 1 := by
      rw [← Complex.ofReal_mul, inv_mul_cancel₀ hz, Complex.ofReal_one]
    calc
      _ = ((↑(((2:ℝ)^k)^d)⁻¹:ℂ))*((↑(((2:ℝ)^k)^d):ℂ)) *
          (homogeneousKernel Ω y*(dyadicAnnularCutoff (((2:ℝ)^k)⁻¹ • y):ℂ)) := by rw [he,one_mul]
      _ = _ := by ring

private theorem radialCutoff_compensation {d : ℕ}
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    (hΩ : (∫ ω, Ω ω ∂(volume : Measure (E d)).toSphere) = 0)
    (g : E d → ℂ) (w : ℝ → ℂ) (hg : Measurable g) {B : ℝ}
    (hB : ∀ y, ‖g y‖ ≤ B)
    (hL : Integrable (fun y => homogeneousKernel Ω y * w ‖y‖)) :
    (∫ y, homogeneousKernel Ω y*w ‖y‖*g y) =
      ∫ y, w ‖y‖*compensatedPrincipalValue (homogeneousKernel Ω) g y := by
  let L (y : E d) := homogeneousKernel Ω y*w ‖y‖
  let W (t : ℝ) := (Iic (1:ℝ)).indicator (fun _ => g 0) t
  have hW : Measurable W := measurable_const.indicator measurableSet_Iic
  have hWb (t : ℝ) : ‖W t‖ ≤ ‖g 0‖ := by
    by_cases ht : t ∈ Iic (1:ℝ) <;> simp [W,ht]
  have hI (v : E d → ℂ) (hv : Measurable v) {C : ℝ} (hc : ∀ y, ‖v y‖ ≤ C) :
      Integrable (fun y => L y*v y) := (hL.bdd_mul hv.aestronglyMeasurable
        (Filter.Eventually.of_forall hc)).congr (Filter.Eventually.of_forall fun _ => mul_comm _ _)
  have hZero : (∫ y, L y*W ‖y‖) = 0 := by
    simpa only [L,mul_assoc] using homogeneousKernel_radial_integral Ω hΩ (fun t => w t*W t)
  have he (y : E d) : w ‖y‖ * compensatedPrincipalValue (homogeneousKernel Ω) g y =
      L y*g y - L y*W ‖y‖ := by
    have hW' : ({z : E d | ‖z‖ ≤ 1}.indicator (fun _ => g 0)) y = W ‖y‖ := rfl
    rw [compensatedPrincipalValue,hW']
    dsimp [L]
    ring
  simp_rw [he]
  have hWI : Integrable (fun y => L y*W ‖y‖) :=
    hI (fun y => W ‖y‖) (hW.comp continuous_norm.measurable) (fun y => hWb ‖y‖)
  rw [integral_sub (hI g hg hB) hWI,
    hZero,sub_zero]

private theorem finiteHomogeneousAnnular_fourier {d : ℕ}
    (Ω : Metric.sphere (0 : E d) 1 → ℂ) {L : SchwartzMap (E d) ℂ}
    (hL : ∀ y, L y = homogeneousKernel Ω y*dyadicAnnularCutoff y)
    (s : Finset ℤ) :
    (𝓕 (fun y => ∑ k ∈ s, homogeneousAnnularPiece Ω k y)) =
      fun ξ => ∑ k ∈ s, (𝓕 L) (((2:ℝ)^k) • ξ) := by
  funext ξ
  rw [Real.fourier_eq']
  simp only [smul_eq_mul, Finset.mul_sum]
  rw [integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro k _
    rw [homogeneousAnnularPiece_eq hL, ← kernelMollifier_fourier L (by positivity : 0 < (2:ℝ)^k)]
    simp only [Real.fourier_eq',smul_eq_mul]
  · intro k _
    have hi : Integrable (homogeneousAnnularPiece Ω k) := by
      rw [homogeneousAnnularPiece_eq hL]
      exact kernelMollifier_integrable L (by positivity)
    apply hi.bdd_mul (c := 1) (by fun_prop)
    filter_upwards [] with y
    simp only [Complex.norm_exp_ofReal_mul_I,le_refl]

private noncomputable def physicalAnnularWeight (s : Finset ℤ) (t : ℝ) : ℝ :=
  ∑ k ∈ s, (Real.smoothTransition ((4-(((2:ℝ)^(-k))*t)^2)/3) -
    Real.smoothTransition ((4-(2*(((2:ℝ)^(-k))*t))^2)/3))

private theorem physicalAnnularWeight_eval {d : ℕ} (s : Finset ℤ) (y : E d) :
    physicalAnnularWeight s ‖y‖ =
      ∑ k ∈ s, dyadicAnnularCutoff (((2:ℝ)^(-k)) • y) := by
  simp only [physicalAnnularWeight,dyadicAnnularCutoff_radial,norm_dyadicFrequencyDilate]

private theorem finiteHomogeneousAnnularPairing {d : ℕ}
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    (hΩ : (∫ ω, Ω ω ∂(volume : Measure (E d)).toSphere) = 0)
    {L : SchwartzMap (E d) ℂ} (hL : ∀ y, L y = homogeneousKernel Ω y*dyadicAnnularCutoff y)
    (g : SchwartzMap (E d) ℂ) (s : Finset ℤ) :
    (∫ y, (∑ k ∈ s, (dyadicAnnularCutoff (((2:ℝ)^(-k)) • y) : ℂ)) *
        compensatedPrincipalValue (homogeneousKernel Ω) g y) =
      ∫ ξ, (∑ k ∈ s, (𝓕 L) (((2:ℝ)^k) • ξ)) * (𝓕⁻ g) ξ := by
  let K := homogeneousKernel Ω
  let P (y : E d) := ∑ k ∈ s, homogeneousAnnularPiece Ω k y
  let w (t : ℝ) : ℂ := physicalAnnularWeight s t
  have hP : Integrable P := integrable_finsetSum _ fun k _ => by
    rw [homogeneousAnnularPiece_eq hL]
    exact kernelMollifier_integrable L (by positivity)
  have hW (y : E d) : P y = K y * w ‖y‖ := by
    simp only [P,w,physicalAnnularWeight_eval,Complex.ofReal_sum,Finset.mul_sum,homogeneousAnnularPiece,K]
  have hPW := hP.congr (Filter.Eventually.of_forall hW)
  have hComp := radialCutoff_compensation Ω hΩ g w g.continuous.measurable
    (SchwartzMap.norm_le_seminorm ℝ g) hPW
  have hComp' : (∫ y, P y*g y) = ∫ y, (∑ k ∈ s, (dyadicAnnularCutoff (((2:ℝ)^(-k)) • y):ℂ))*
      compensatedPrincipalValue K g y := by
    change (∫ y, K y*w ‖y‖*g y) = _ at hComp
    simp_rw [w,physicalAnnularWeight_eval,Complex.ofReal_sum] at hComp
    simpa only [hW,w,physicalAnnularWeight_eval,Complex.ofReal_sum] using hComp
  have hF (ξ : E d) : (𝓕 P) ξ = ∑ k ∈ s, (𝓕 L) (((2:ℝ)^k) • ξ) :=
    congrFun (finiteHomogeneousAnnular_fourier Ω hL s) ξ
  rw [← hComp']
  simp_rw [← hF, SchwartzMap.fourierInv_coe]
  have hflip := VectorFourier.integral_fourierIntegral_smul_eq_flip
    (L := innerₗ (E d)) Real.continuous_fourierChar continuous_inner hP
    ((𝓕⁻ g : SchwartzMap (E d) ℂ).integrable (μ := (volume : Measure (E d))))
  rw [flip_innerₗ] at hflip
  have he : 𝓕 (𝓕⁻ (g : E d → ℂ)) = (g : E d → ℂ) := by
    rw [← SchwartzMap.fourierInv_coe, ← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  change (∫ ξ, (𝓕 P) ξ • (𝓕⁻ g) ξ) =
    ∫ y, P y • (𝓕 ((𝓕⁻ g : SchwartzMap (E d) ℂ) : E d → ℂ)) y at hflip
  rw [SchwartzMap.fourierInv_coe,he] at hflip
  simpa only [smul_eq_mul] using hflip.symm

private noncomputable def symmetricPhysicalCutoff {d : ℕ} (n : ℕ) (y : E d) : ℝ :=
  ∑ k ∈ (Finset.range (2*n+1)).image (fun k : ℕ => -(n:ℤ)+(k:ℤ)),
    dyadicAnnularCutoff (((2:ℝ)^(-k)) • y)

private theorem symmetricPhysicalCutoff_bounds {d : ℕ} (n : ℕ) (y : E d) :
    0 ≤ symmetricPhysicalCutoff n y ∧ symmetricPhysicalCutoff n y ≤ 1 := by
  have h₀ (k : ℤ) : 0 ≤ dyadicAnnularCutoff (((2:ℝ)^(-k)) • y) := dyadicAnnularCutoff_nonneg _
  refine ⟨Finset.sum_nonneg (fun k _ => h₀ k),?_⟩
  by_cases hy : y = 0
  · have hz : dyadicAnnularCutoff (0:E d) = 0 := dyadicAnnularCutoff_eq_zero (Or.inl (by simp))
    simp [symmetricPhysicalCutoff,hy,hz]
  · have hSum : Summable (fun k : ℤ => dyadicAnnularCutoff (((2:ℝ)^(-k)) • y)) := by
      by_contra h
      have he := dyadicAnnularCutoff_partition hy
      rw [tsum_eq_zero_of_not_summable h] at he
      norm_num at he
    exact (hSum.sum_le_tsum _ (fun k _ => h₀ k)).trans_eq (dyadicAnnularCutoff_partition hy)

private theorem symmetricPhysicalCutoff_tendsto {d : ℕ} {y : E d} (hy : y ≠ 0) :
    Tendsto (fun n => symmetricPhysicalCutoff n y) atTop (𝓝 1) := by
  have hSum : Summable (fun k : ℤ => dyadicAnnularCutoff (((2:ℝ)^(-k)) • y)) := by
    by_contra h
    have he := dyadicAnnularCutoff_partition hy
    rw [tsum_eq_zero_of_not_summable h] at he
    norm_num at he
  have he : HasSum (fun k : ℤ => dyadicAnnularCutoff (((2:ℝ)^(-k)) • y)) 1 :=
    (dyadicAnnularCutoff_partition hy) ▸ hSum.hasSum
  exact he.comp dyadicWindow_exhaustion

private theorem finiteAnnular_compensated_tendsto {d : ℕ} (hd : 0 < d)
    {K g : E d → ℂ} (h : Integrable (compensatedPrincipalValue K g)) :
    Tendsto (fun n => ∫ y, (symmetricPhysicalCutoff n y : ℂ) * compensatedPrincipalValue K g y)
      atTop (𝓝 (∫ y, compensatedPrincipalValue K g y)) := by
  letI : Nonempty (Fin d) := ⟨⟨0,hd⟩⟩
  apply tendsto_integral_of_dominated_convergence (fun y => ‖compensatedPrincipalValue K g y‖)
  · intro n
    have hm : Continuous (symmetricPhysicalCutoff (d := d) n) :=
      continuous_finsetSum _ (fun k _ => dyadicAnnularCutoff_smooth.continuous.comp
        (((2:ℝ)^(-k) • ContinuousLinearMap.id ℝ (E d)).continuous))
    exact (Complex.continuous_ofReal.comp hm).aestronglyMeasurable.mul h.aestronglyMeasurable
  · exact h.norm
  · intro n
    filter_upwards [] with y
    have hb := symmetricPhysicalCutoff_bounds n y
    rw [norm_mul,Complex.norm_real,Real.norm_of_nonneg hb.1]
    exact mul_le_of_le_one_left (norm_nonneg _) hb.2
  · filter_upwards [ae_ne (volume : Measure (E d)) 0] with y hy
    simpa only [Complex.ofReal_one,one_mul,Function.comp_apply] using
      (Complex.continuous_ofReal.continuousAt.tendsto.comp (symmetricPhysicalCutoff_tendsto hy)).mul_const
        (compensatedPrincipalValue K g y)

