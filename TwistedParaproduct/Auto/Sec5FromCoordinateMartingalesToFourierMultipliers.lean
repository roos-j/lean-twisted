/-- The uniform untruncated estimate for a smooth multiplier of order (5d+2). -/
theorem fullMultiplier {d : ℕ} (hd : 2 ≤ d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹) :
    ∃ C : ℝ, 0 < C ∧ ∀ (m : E d → ℂ) (A : ℝ), 0 ≤ A →
      Auto.MikhlinHormander.MikhlinCondition (5*d+2) m A →
      ∀ f : Fin d → SchwartzMap (E d) ℂ,
        eLpNorm (twisted m f) (ENNReal.ofReal r) volume ≤ ENNReal.ofReal (C*A) *
          ∏ i, eLpNorm (f i : E d → ℂ) (ENNReal.ofReal (p i)) volume := by
  have hd₀ : 0 < d := by omega
  obtain ⟨θ, θb, γ, hθ, hθc, hθn, hθsum, hPart, hθb, hγ, hγb, hOne⟩ := coneCutoffs hd₀
  let c := 1/(8*Real.sqrt d)
  have hc : 0 < c := by dsimp [c]; positivity
  have hcC : c < 3 := by
    have hS : (1:ℝ) ≤ Real.sqrt d := by
      have hh : (1:ℝ) ≤ d := by exact_mod_cast (show 1 ≤ d by omega)
      simpa using Real.sqrt_le_sqrt hh
    dsimp only [c]
    apply (div_lt_iff₀ (by positivity)).mpr
    linarith
  choose B hB hCone using fun b : Fin d =>
    conicalWindow_bound hd hp hr hSum hc hcC b (hθb b).1 (hθb b).2.1
      (fun x hx => ⟨((hθb b).2.2.2 hx).1, ((hθb b).2.2.2 hx).2.1⟩)
      (γ b) (hγ b) (hγb b) (hOne b)
  let D := ∑ b, B b
  have hD : D ≠ ∞ := ENNReal.sum_ne_top.mpr fun b _ => hB b
  let C := D.toReal + 1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro m A hA hm f
  have hmC : ContinuousOn m {x | x ≠ 0} := hm.1.continuousOn
  have hmB (x : E d) (hx : x ≠ 0) : ‖m x‖ ≤ A := by
    have h := hm.2 0 (by omega) x hx
    simpa only [pow_zero, one_mul, norm_iteratedFDeriv_zero] using h
  have hθle (b : Fin d) (x : E d) : θb b x ≤ θ x := by
    rw [hθsum]
    exact Finset.single_le_sum (fun i _ => (hθb i).2.2.1 x) (Finset.mem_univ b)
  let F := ∏ i, eLpNorm (f i : E d → ℂ) (ENNReal.ofReal (p i)) volume
  have hWindow (u : ℤ) (T : ℕ) :
      eLpNorm (twisted (annularWindowSymbol θ m u T) f) (ENNReal.ofReal r) volume ≤ D*ENNReal.ofReal A*F := by
    let M (b : Fin d) := annularWindowSymbol (θb b) m u T
    have hI (b : Fin d) (x : E d) : Integrable (fourierIntegrand (M b) f x) :=
      (schwartzFourier_convergence hd₀
        (annularWindowSymbol_punctured_continuous (hθb b).1.continuous hmC u T)
        (fun z hz => annularWindowSymbol_bound (hθb b).2.2.1 (hθle b) hPart hmB u T hz) f).1 x
    have hM : annularWindowSymbol θ m u T = fun x => ∑ b, M b x := by
      funext x
      unfold annularWindowSymbol M
      simp_rw [hθsum, Complex.ofReal_sum, Finset.sum_mul]
      exact Finset.sum_comm
    have hEq : twisted (annularWindowSymbol θ m u T) f = ∑ b, twisted (M b) f := by
      funext x
      rw [hM, twisted_finset_linear Finset.univ M f x (fun b _ => hI b x), Finset.sum_apply]
    rw [hEq]
    have h₁ : 1 ≤ ENNReal.ofReal r := by simpa using ENNReal.ofReal_le_ofReal hr.le
    refine (eLpNorm_sum_le h₁).trans ((Finset.sum_le_sum (fun b _ => hCone b m A hA hm u T f)).trans_eq ?_)
    rw [Finset.sum_mul, Finset.sum_mul]
  let M (n : ℕ) := annularWindowSymbol θ m (-(n:ℤ)) (2*n+1)
  have hMbound (n : ℕ) (x : E d) (hx : x ≠ 0) : ‖M n x‖ ≤ A :=
    annularWindowSymbol_bound hθn (fun _ => le_rfl) hPart hmB _ _ hx
  have hM (n : ℕ) : Continuous (twisted (M n) f) :=
    (schwartzFourier_convergence hd₀ (annularWindowSymbol_punctured_continuous hθ.continuous hmC _ _)
      (hMbound n) f).2
  have hMc (n : ℕ) : Measurable (M n) :=
    measurable_of_continuousOn_compl_singleton 0
      (annularWindowSymbol_punctured_continuous hθ.continuous hmC _ _)
  have hmOut : Continuous (twisted m f) := (schwartzFourier_convergence hd₀ hmC hmB f).2
  have hLim (x : E d) :
      Tendsto (fun n => twisted (M n) f x) atTop (𝓝 (twisted m f x)) := by
    apply tendsto_integral_of_dominated_convergence (fun ξ : Fin d → E d =>
      A * ∏ i, ‖(𝓕 (f i)) (ξ i)‖)
      (fun n => (fourierIntegrand_measurable (hMc n) f x).aestronglyMeasurable)
      (integrable_fourierMajorant f A)
    · intro n
      filter_upwards [ae_diagonalFrequency_ne_zero ⟨0,hd₀⟩] with ξ hξ
      exact norm_fourierIntegrand_le f x ξ (hMbound n _ hξ)
    · filter_upwards [ae_diagonalFrequency_ne_zero ⟨0,hd₀⟩] with ξ hξ
      simpa only [fourierIntegrand] using
        ((annularWindowSymbol_tendsto hPart m hξ).mul_const (∏ i, (𝓕 (f i)) (ξ i))).mul_const
          (Complex.exp (Complex.I * Complex.ofReal (2*Real.pi*inner ℝ x (∑ i, ξ i))))
  have hh : eLpNorm (twisted m f) (ENNReal.ofReal r) volume ≤ D*ENNReal.ofReal A*F :=
    Lp.eLpNorm_le_of_ae_tendsto (u := atTop) (f := fun n => twisted (M n) f)
      (Filter.Eventually.of_forall fun n => hWindow _ _)
      (fun n => (hM n).aestronglyMeasurable) hmOut.aestronglyMeasurable (Filter.Eventually.of_forall hLim)
  refine hh.trans ?_
  rw [ENNReal.ofReal_mul (by positivity : 0 ≤ C)]
  exact mul_le_mul_left (mul_le_mul_left (by
    rw [← ENNReal.ofReal_toReal hD]
    exact ENNReal.ofReal_le_ofReal (by dsimp [C]; linarith)) _) _

/-- The untruncated estimate in the blueprint's Lean appendix. -/
theorem untruncatedEstimate : BanachTarget := by
  intro d hd p r hp hr hSum
  obtain ⟨C,hC,h⟩ := fullMultiplier hd hp hr hSum
  refine ⟨5*d+2,C,hC,?_⟩
  intro m B hB hm hBound f
  exact h m B hB ⟨hm (5*d+2), hBound⟩ f

private theorem physical_shift_inner {d : ℕ} (x y ξ : E d) (i : Fin d) :
    inner ℝ ξ (x - y i • EuclideanSpace.single i 1) = inner ℝ ξ x - y i * ξ i := by
  rw [inner_sub_right, real_inner_smul_right, EuclideanSpace.inner_single_right, conj_trivial,
    one_mul]

