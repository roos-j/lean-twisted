private theorem twisted_product_multiplier {d : ℕ} (K : Fin d → ℝ → ℂ)
    (hK : ∀ i, Integrable (K i)) (hKm : ∀ i, Measurable (K i))
    (f : Fin d → SchwartzMap (E d) ℂ) (x : Fin d → ℝ) :
    twisted (fun η => ∏ i, 𝓕 (K i) (η i)) f (WithLp.toLp 2 x) =
      ∏ i, coordinateProfileConvolution i (K i) (coordinateSchwartzPullback (f i)) x := by
  simp_rw [coordinateConvolution_fourierIntegral _ (hK _) (hKm _)]
  rw [← integral_fintype_prod_volume_eq_prod]
  simp only [twisted_eq_integral, fourierIntegrand]
  apply integral_congr_ae
  filter_upwards [] with ξ
  have he (i : Fin d) : (diagonalFrequency ξ) i = ξ i i := rfl
  simp_rw [he, separated_fourierPhase, ← Finset.prod_mul_distrib]

private theorem eLpNorm_coordinatePullback {d : ℕ} {a : E d → ℂ} {p : ℝ≥0∞}
    (ha : AEStronglyMeasurable a volume) :
    eLpNorm (a ∘ WithLp.toLp 2) p (volume : Measure (Fin d → ℝ)) =
      eLpNorm a p (volume : Measure (E d)) := by
  exact eLpNorm_comp_measurePreserving ha (PiLp.volume_preserving_toLp (Fin d))

private theorem continuous_twisted_bounded {d : ℕ} (hd : 0 < d) {m : E d → ℂ}
    (hm : Continuous m) {w : ℝ} (hw : ∀ x, ‖m x‖ ≤ w)
    (f : Fin d → SchwartzMap (E d) ℂ) : Continuous (twisted m f) :=
  (schwartzFourier_convergence hd hm.continuousOn (fun x _ => hw x) f).2

private theorem twisted_finset_linear {d : ℕ} {ι : Type*} (S : Finset ι)
    (m : ι → E d → ℂ) (f : Fin d → SchwartzMap (E d) ℂ) (x : E d)
    (hI : ∀ i ∈ S, Integrable (fourierIntegrand (m i) f x)) :
    twisted (fun z => ∑ i ∈ S, m i z) f x = ∑ i ∈ S, twisted (m i) f x := by
  simp only [twisted_eq_integral]
  rw [← integral_finsetSum _ hI]
  apply integral_congr_ae
  filter_upwards [] with ξ
  simp only [fourierIntegrand, Finset.sum_mul]

set_option maxHeartbeats 750000 in
private theorem twisted_tsum_estimate {d : ℕ} (hd : 0 < d) {ι : Type*} [Countable ι]
    (f : Fin d → SchwartzMap (E d) ℂ) {r : ℝ} (hr : 1 < r)
    {m : E d → ℂ} {M : ι → E d → ℂ}
    (hM : ∀ i, Continuous (M i)) (hw : ι → ℝ) (hwS : Summable hw)
    (hwM : ∀ i z, ‖M i z‖ ≤ hw i)
    (hSum : ∀ z, HasSum (fun i => M i z) (m z))
    (B : ι → ℝ≥0∞)
    (hB : ∀ i, eLpNorm (twisted (M i) f) (ENNReal.ofReal r) volume ≤ B i) :
    eLpNorm (twisted m f) (ENNReal.ofReal r) volume ≤ ∑' i, B i := by
  have hI (i : ι) (x : E d) : Integrable (fourierIntegrand (M i) f x) :=
    (schwartzFourier_convergence hd (hM i).continuousOn (fun z _ => hwM i z) f).1 x
  have hTc (i : ι) : Continuous (twisted (M i) f) := continuous_twisted_bounded hd (hM i) (hwM i) f
  have hS (x : E d) : HasSum (fun i => twisted (M i) f x) (twisted m f x) := by
    let D := ∫ ξ : Fin d → E d, ∏ j, ‖(𝓕 (f j)) (ξ j)‖
    have hS' : Summable (fun i => ∫ ξ, ‖fourierIntegrand (M i) f x ξ‖) := by
      apply (hwS.mul_right D).of_nonneg_of_le (fun _ => integral_nonneg fun _ => norm_nonneg _)
      intro i
      rw [show hw i*D = ∫ ξ : Fin d → E d, hw i * ∏ j, ‖(𝓕 (f j)) (ξ j)‖ by
        dsimp only [D]; rw [integral_const_mul]]
      exact integral_mono (hI i x).norm (integrable_fourierMajorant f (hw i))
        fun ξ => norm_fourierIntegrand_le f x ξ (hwM i _)
    have he : (∫ ξ, ∑' i, fourierIntegrand (M i) f x ξ) = twisted m f x := by
      simp only [twisted_eq_integral]
      apply integral_congr_ae
      filter_upwards [] with ξ
      have hh := ((hSum (diagonalFrequency ξ)).mul_right
        (∏ j, (𝓕 (f j)) (ξ j))).mul_right
        (Complex.exp (Complex.I * Complex.ofReal (2*Real.pi*inner ℝ x (∑ j, ξ j))))
      exact hh.tsum_eq
    rw [← he]
    exact hasSum_integral_of_summable_integral_norm (fun i => hI i x) hS'
  let T (S : Finset ι) (x : E d) := ∑ i ∈ S, twisted (M i) f x
  have hTm (S : Finset ι) : Measurable (T S) :=
    Finset.measurable_sum _ fun i _ => (hTc i).measurable
  have hlim : ∀ᵐ x ∂(volume : Measure (E d)),
      Tendsto (fun S : Finset ι => T S x) atTop (𝓝 (twisted m f x)) :=
    Filter.Eventually.of_forall fun x => hS x
  have hm : AEStronglyMeasurable (twisted m f) volume :=
    aestronglyMeasurable_of_tendsto_ae atTop (fun S => (hTm S).aestronglyMeasurable) hlim
  refine Lp.eLpNorm_le_of_ae_tendsto (f := T) ?_ (fun S => (hTm S).aestronglyMeasurable) hm hlim
  filter_upwards [] with S
  have h₁ : 1 ≤ ENNReal.ofReal r := by simpa using ENNReal.ofReal_le_ofReal hr.le
  have he : T S = ∑ i ∈ S, twisted (M i) f := by
    funext x
    simp [T, Finset.sum_apply]
  rw [he]
  exact (eLpNorm_sum_le (s := S) h₁).trans ((Finset.sum_le_sum (fun i _ => hB i)).trans
    (ENNReal.sum_le_tsum _))

private noncomputable def separatedModeMultiplier {d : ℕ} (a : Fin d → SchwartzMap ℝ ℂ)
    (k : ℤ) (η : E d) : ℂ :=
  ∏ i, (𝓕 (a i) : SchwartzMap ℝ ℂ) (((2:ℝ)^(-k))*η i)

private theorem separatedModeMultiplier_continuous {d : ℕ} (a : Fin d → SchwartzMap ℝ ℂ)
    (k : ℤ) : Continuous (separatedModeMultiplier a k) :=
  continuous_finsetProd _ fun i _ => (𝓕 (a i) : SchwartzMap ℝ ℂ).continuous.comp
    (continuous_const.mul (EuclideanSpace.proj (𝕜 := ℝ) i).continuous)

private theorem twisted_separatedModeMultiplier {d : ℕ} (a : Fin d → SchwartzMap ℝ ℂ)
    (k : ℤ) (f : Fin d → SchwartzMap (E d) ℂ) (x : Fin d → ℝ) :
    twisted (separatedModeMultiplier a k) f (WithLp.toLp 2 x) =
      ∏ i, coordinateProfileConvolution i (profileDilation (a i) k)
        (coordinateSchwartzPullback (f i)) x := by
  have hI (i : Fin d) : Integrable (profileDilation (a i) k) :=
    profileDilation_integrable (a i).integrable k
  have hM (i : Fin d) : Measurable (profileDilation (a i) k) :=
    measurable_const.mul ((a i).continuous.measurable.comp (measurable_const.mul measurable_id))
  have F := twisted_product_multiplier (fun i => profileDilation (a i) k) hI hM f x
  convert F using 2
  funext η
  apply Finset.prod_congr rfl
  intro i _
  exact (profileDilation_fourier (a i) k (η i)).symm

private theorem separatedModeMultiplier_bound {d : ℕ} (a : Fin d → SchwartzMap ℝ ℂ)
    (k : ℤ) (η : E d) :
    ‖separatedModeMultiplier a k η‖ ≤ ∏ i, profileFourierFourNorm (𝓕 (a i)) := by
  unfold separatedModeMultiplier
  rw [norm_prod]
  apply Finset.prod_le_prod₀
  · exact fun _ _ => norm_nonneg _
  · intro i _
    simpa only [norm_iteratedFDeriv_zero] using
      profileFourierFourNorm_controls (𝓕 (a i)) (by decide : (0:ℕ) ≤ 4) (((2:ℝ)^(-k))*η i)

private theorem twisted_scalar {d : ℕ} (c : ℂ) (m : E d → ℂ)
    (f : Fin d → SchwartzMap (E d) ℂ) :
    twisted (fun z => c*m z) f = c • twisted m f := by
  funext x
  simp only [twisted,fourierIntegrand,Pi.smul_apply,smul_eq_mul,mul_assoc,integral_const_mul]

set_option maxHeartbeats 825000 in
private theorem modeWindow_estimate {d : ℕ} (hd : 2 ≤ d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {c C : ℝ} (hc : 0 < c) (hcC : c < C) :
    ∃ K : ℝ≥0∞, K ≠ ∞ ∧ ∀ (b : Fin d) (a : Fin d → SchwartzMap ℝ ℂ),
      Function.support ((𝓕 (a b) : SchwartzMap ℝ ℂ) : ℝ → ℂ) ⊆ {z | c ≤ |z| ∧ |z| ≤ C} →
      ∀ (u : ℤ) (T : ℕ) (z : ℕ → ℂ) {B : ℝ}, 0 ≤ B → (∀ k, ‖z k‖ ≤ B) →
      ∀ f : Fin d → SchwartzMap (E d) ℂ,
        eLpNorm (twisted (fun η => ∑ k ∈ Finset.range T, z k *
          separatedModeMultiplier a (u+k) η) f) (ENNReal.ofReal r) volume ≤
          ENNReal.ofReal B * K *
            (∏ i, if i = b then profileSize (a i) + ENNReal.ofReal (profileFourierFourNorm (𝓕 (a i)))
             else profileSize (a i)) *
            ∏ i, eLpNorm (f i : E d → ℂ) (ENNReal.ofReal (p i)) volume := by
  obtain ⟨K,hK,hSep⟩ := separatedCone hd hp hr hSum hc hcC
  refine ⟨K,hK,?_⟩
  intro b a ha u T z B hB hz f
  let M (z' : ℕ → ℂ) (η : E d) := ∑ k ∈ Finset.range T, z' k * separatedModeMultiplier a (u+k) η
  have hM (z' : ℕ → ℂ) : Continuous (M z') :=
    continuous_finsetSum _ fun k _ => continuous_const.mul (separatedModeMultiplier_continuous a (u+k))
  have hMB (z' : ℕ → ℂ) (η : E d) :
      ‖M z' η‖ ≤ ∑ k ∈ Finset.range T, ‖z' k‖ * ∏ i, profileFourierFourNorm (𝓕 (a i)) := by
    apply (norm_sum_le _ _).trans
    apply Finset.sum_le_sum
    intro k hk
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (separatedModeMultiplier_bound a _ _) (norm_nonneg _)
  rcases hB.eq_or_lt with hb | hb
  · have hz₀ (k : ℕ) : z k = 0 := by simpa only [← hb, norm_le_zero_iff] using hz k
    have he : M z = fun _ => 0 := by funext η; simp [M,hz₀]
    change eLpNorm (twisted (M z) f) (ENNReal.ofReal r) volume ≤ _
    rw [he]
    have hzero : twisted (fun _ : E d => (0:ℂ)) f = 0 := by
      funext x
      simp [twisted,fourierIntegrand]
    rw [hzero, eLpNorm_zero]
    exact zero_le
  let z' (k : ℕ) := (↑B⁻¹ : ℂ)*z k
  have hz' (k : ℕ) : ‖z' k‖ ≤ 1 := by
    dsimp only [z']
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (inv_nonneg.mpr hb.le)]
    exact (mul_le_mul_of_nonneg_left (hz k) (inv_nonneg.mpr hb.le)).trans_eq (inv_mul_cancel₀ hb.ne')
  have he : M z = fun η => (B:ℂ)*M z' η := by
    funext η
    unfold M
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k _
    dsimp only [z']
    rw [← mul_assoc, ← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ hb.ne', Complex.ofReal_one, one_mul]
  let g (i : Fin d) := coordinateSchwartzPullback (f i)
  have hg (i : Fin d) :
      eLpNorm (g i : (Fin d → ℝ) → ℂ) (ENNReal.ofReal (p i)) volume =
        eLpNorm (f i : E d → ℂ) (ENNReal.ofReal (p i)) volume :=
    eLpNorm_coordinatePullback (f i).continuous.aestronglyMeasurable
  have hEq (x : Fin d → ℝ) :
      twisted (M z') f (WithLp.toLp 2 x) =
        separatedProfileSum ((Finset.range T).image (fun k : ℕ => u+(k:ℤ))) (fun k => z' (k-u).toNat)
          (fun i => a i) (fun i => g i) x := by
    have hI (k : ℕ) (_ : k ∈ Finset.range T) :
        Integrable (fourierIntegrand (fun η => z' k * separatedModeMultiplier a (u+k) η) f (WithLp.toLp 2 x)) :=
      (schwartzFourier_convergence (by omega : 0 < d)
        (continuous_const.mul (separatedModeMultiplier_continuous a (u+k))).continuousOn
        (fun η _ => by
          change ‖z' k * separatedModeMultiplier a (u+k) η‖ ≤ _
          rw [norm_mul]
          exact mul_le_mul_of_nonneg_left (separatedModeMultiplier_bound a _ _) (norm_nonneg _)) f).1 _
    dsimp only [M]
    rw [twisted_finset_linear _ _ _ _ hI]
    simp_rw [twisted_scalar, Pi.smul_apply, smul_eq_mul, twisted_separatedModeMultiplier]
    unfold separatedProfileSum
    have hinj : Function.Injective (fun k : ℕ => u+(k:ℤ)) := by
      intro i j h
      change u+(i:ℤ) = u+(j:ℤ) at h
      exact_mod_cast add_left_cancel h
    rw [Finset.sum_image (fun i _ j _ he => hinj he)]
    simp [g]
  have h := hSep b a ha u T z' hz' g
  simp_rw [hg] at h
  have hEq' : twisted (M z') f ∘ WithLp.toLp 2 = _ := funext hEq
  rw [← hEq', eLpNorm_coordinatePullback
    (continuous_twisted_bounded (by omega) (hM z') (hMB z') f).aestronglyMeasurable] at h
  change eLpNorm (twisted (M z) f) (ENNReal.ofReal r) volume ≤ _
  rw [he, twisted_scalar, eLpNorm_const_smul, ← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hb.le]
  exact (mul_le_mul_right h _).trans_eq (by ac_rfl)

private theorem frequencyProfile_product_growth {d : ℕ} (b : Fin d) (n : Fin d → ℤ)
    (a : Fin d → SchwartzMap ℝ ℂ) {L : ℝ} (hL : 0 ≤ L)
    (hA : ∀ i, profileSize (a i) + ENNReal.ofReal (profileFourierFourNorm (𝓕 (a i))) ≤
      ENNReal.ofReal (L*(1+|(n i:ℝ)|)^4)) :
    (∏ i, if i = b then profileSize (a i) + ENNReal.ofReal (profileFourierFourNorm (𝓕 (a i)))
      else profileSize (a i)) ≤ ENNReal.ofReal (L^d*(1+‖integerFrequency n‖)^(4*d)) ∧
    (∏ i, profileFourierFourNorm (𝓕 (a i))) ≤ L^d*(1+‖integerFrequency n‖)^(4*d) := by
  let R := 1+‖integerFrequency n‖
  have hBound (i : Fin d) :
      profileSize (a i) + ENNReal.ofReal (profileFourierFourNorm (𝓕 (a i))) ≤
        ENNReal.ofReal (L*R^4) := by
    refine (hA i).trans (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left ?_ hL))
    have h : |(n i:ℝ)| ≤ ‖integerFrequency n‖ := by
      simpa only [Real.norm_eq_abs, integerFrequency] using PiLp.norm_apply_le (integerFrequency n) i
    exact pow_le_pow_left₀ (by positivity) (add_le_add_right h 1) _
  have hPow : (L*R^4)^d = L^d*R^(4*d) := by rw [mul_pow, pow_mul]
  constructor
  · calc
      _ ≤ ∏ i : Fin d, ENNReal.ofReal (L*R^4) := by
        apply Finset.prod_le_prod
        intro i _
        split
        · exact hBound i
        · exact (le_add_of_nonneg_right zero_le).trans (hBound i)
      _ = _ := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← ENNReal.ofReal_pow (by positivity), hPow]
  · calc
      _ ≤ ∏ i : Fin d, L*R^4 := by
        apply Finset.prod_le_prod₀
        · exact fun i _ => profileFourierFourNorm_nonneg _
        · intro i _
          exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp
            ((le_add_of_nonneg_left zero_le).trans (hBound i))
      _ = _ := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, hPow]

private theorem profileMode_coefficient_growth {d : ℕ} (n : Fin d → ℤ) (A K L : ℝ) :
    (K*A/(1+‖integerFrequency n‖)^(5*d+2)) * (L^d*(1+‖integerFrequency n‖)^(4*d)) =
      K*L^d*A * ((1+‖integerFrequency n‖)^(d+2))⁻¹ := by
  let R := 1+‖integerFrequency n‖
  have hR : 0 < R := by dsimp [R]; positivity
  change (K*A/R^(5*d+2))*(L^d*R^(4*d)) = K*L^d*A*(R^(d+2))⁻¹
  rw [show 5*d+2 = 4*d+(d+2) by omega, pow_add]
  field_simp [hR.ne'] <;> ring

set_option maxHeartbeats 1300000 in
private theorem conicalWindow_bound {d : ℕ} (hd : 2 ≤ d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {c C : ℝ} (hc : 0 < c) (hcC : c < C) (b : Fin d)
    {θ : E d → ℝ} (hθ : ContDiff ℝ (↑(⊤ : ℕ∞)) θ) (hθc : HasCompactSupport θ)
    (hθs : tsupport θ ⊆ {x : E d | 1/2 ≤ ‖x‖ ∧ ‖x‖ ≤ 2})
    (γ : Fin d → ℝ → ℝ)
    (hγ : ∀ i, ContDiff ℝ (↑(⊤ : ℕ∞)) (γ i) ∧ HasCompactSupport (γ i) ∧
      tsupport (γ i) ⊆ Ioo (-3:ℝ) 3)
    (hgg : tsupport (γ b) ⊆ {z | c ≤ |z| ∧ |z| ≤ C})
    (hOne : ∀ x ∈ tsupport θ, ∏ i, γ i (x i) = 1) :
    ∃ B : ℝ≥0∞, B ≠ ∞ ∧ ∀ (m : E d → ℂ) (A : ℝ), 0 ≤ A →
      Auto.MikhlinHormander.MikhlinCondition (5*d+2) m A →
      ∀ (u : ℤ) (T : ℕ) (f : Fin d → SchwartzMap (E d) ℂ),
      eLpNorm (twisted (fun η => ∑ k ∈ Finset.range T,
        (θ (((2:ℝ)^(-(u+(k:ℤ)))) • η):ℂ)*m η) f) (ENNReal.ofReal r) volume ≤
      B * ENNReal.ofReal A * ∏ i, eLpNorm (f i : E d → ℂ) (ENNReal.ofReal (p i)) volume := by
  obtain ⟨K,L,hK,hL,φ,hφ,hφs,hExp⟩ := modeExpansion (N := 5*d+2) (by omega)
    hθ hθc hθs γ hγ hOne
  obtain ⟨B,hB,hM⟩ := modeWindow_estimate hd hp hr hSum hc hcC
  let w (n : Fin d → ℤ) := ((1+‖integerFrequency n‖)^(d+2))⁻¹
  have hw : Summable w := summable_integerFrequency_weight (by omega : d < d+2)
  have hWnonneg (n : Fin d → ℤ) : 0 ≤ w n := by dsimp [w]; positivity
  let W := ENNReal.ofReal (∑' n : Fin d → ℤ, w n)
  refine ⟨B*ENNReal.ofReal (K*L^d)*W, ENNReal.mul_ne_top
    (ENNReal.mul_ne_top hB ENNReal.ofReal_ne_top) ENNReal.ofReal_ne_top, ?_⟩
  intro m A hA hm u T f
  choose a ha hSeries using fun k => hExp m A hA hm k
  let S := Finset.range T
  let N := 5*d+2
  let m₀ (n : Fin d → ℤ) (k : ℕ) (η : E d) :=
    a (u+k) n * separatedModeMultiplier (φ n) (u+k) η
  let M (n : Fin d → ℤ) (η : E d) := ∑ k ∈ S, m₀ n k η
  let Q (k : ℕ) (η : E d) := (θ (((2:ℝ)^(-(u+(k:ℤ)))) • η):ℂ)*m η
  have hCont (n : Fin d → ℤ) : Continuous (M n) :=
    continuous_finsetSum _ fun k _ => continuous_const.mul (separatedModeMultiplier_continuous (φ n) (u+k))
  have hGrowth (n : Fin d → ℤ) := frequencyProfile_product_growth b n (φ n) hL (hφ n)
  let Z := K*L^d*A
  have hZ : 0 ≤ Z := by dsimp only [Z]; positivity
  have hMBound (n : Fin d → ℤ) (k : ℕ) (η : E d) : ‖m₀ n k η‖ ≤ Z*w n := by
    change ‖a (u+k) n * separatedModeMultiplier (φ n) (u+k) η‖ ≤ _
    rw [norm_mul]
    exact (mul_le_mul (ha _ _) ((separatedModeMultiplier_bound _ _ _).trans (hGrowth n).2)
      (norm_nonneg _) (by positivity)).trans_eq (profileMode_coefficient_growth n A K L)
  have hWt : Summable (fun n => ((T:ℝ)*Z)*w n) := hw.mul_left _
  have hVal (n : Fin d → ℤ) (η : E d) : ‖M n η‖ ≤ ((T:ℝ)*Z)*w n := by
    refine (norm_sum_le _ _).trans ((Finset.sum_le_sum fun k _ => hMBound n k η).trans_eq ?_)
    rw [Finset.sum_const, nsmul_eq_mul, show S.card = T from Finset.card_range T]
    dsimp only [Z]
    ring
  have hEq (k : ℕ) (η : E d) : HasSum (fun n => m₀ n k η) (Q k η) := by
    have hs : Summable (fun n => m₀ n k η) := (hw.mul_left Z).of_norm_bounded fun n => hMBound n k η
    have hH := hSeries (u+k) (((2:ℝ)^(-(u+(k:ℤ)))) • η)
    have hη : ((2:ℝ)^(u+(k:ℤ))) • (((2:ℝ)^(-(u+(k:ℤ)))) • η) = η := by
      rw [smul_smul, ← zpow_add₀ (by norm_num : (2:ℝ) ≠ 0), add_neg_cancel, zpow_zero, one_smul]
    rw [normalizedConicalSymbol,hη] at hH
    have he : Q k η = ∑' n, m₀ n k η := hH
    rw [he]
    exact hs.hasSum
  have hMS (η : E d) : HasSum (fun n => M n η) (∑ k ∈ S, Q k η) :=
    hasSum_sum fun k _ => hEq k η
  let F := ∏ i, eLpNorm (f i : E d → ℂ) (ENNReal.ofReal (p i)) volume
  let D (n : Fin d → ℤ) := B*ENNReal.ofReal Z*ENNReal.ofReal (w n)*F
  have hb (n : Fin d → ℤ) : eLpNorm (twisted (M n) f) (ENNReal.ofReal r) volume ≤ D n := by
    let t := K*A/(1+‖integerFrequency n‖)^N
    have ht : 0 ≤ t := by dsimp only [t]; positivity
    have hs : Function.support ((𝓕 (φ n b) : SchwartzMap ℝ ℂ) : ℝ → ℂ) ⊆
        {z | c ≤ |z| ∧ |z| ≤ C} := subset_closure.trans ((hφs n b).trans hgg)
    have h := hM b (φ n) hs u T (fun k => a (u+k) n) ht (fun k => ha _ _) f
    refine h.trans ((mul_le_mul_left (mul_le_mul_right (hGrowth n).1 _) _).trans_eq ?_)
    dsimp only [D]
    have he : ENNReal.ofReal t * ENNReal.ofReal (L^d*(1+‖integerFrequency n‖)^(4*d)) =
        ENNReal.ofReal Z * ENNReal.ofReal (w n) := by
      rw [← ENNReal.ofReal_mul ht, ← ENNReal.ofReal_mul hZ]
      congr 1
      exact profileMode_coefficient_growth n A K L
    calc
      _ = B*(ENNReal.ofReal t*ENNReal.ofReal (L^d*(1+‖integerFrequency n‖)^(4*d)))*F := by dsimp only [F]; ac_rfl
      _ = _ := by rw [he]; ac_rfl
  have hh := twisted_tsum_estimate (by omega : 0 < d) f hr hCont _ hWt hVal hMS D hb
  refine hh.trans_eq ?_
  have he : (∑' n : Fin d → ℤ, ENNReal.ofReal (w n)) = W :=
    (ENNReal.ofReal_tsum_of_nonneg hWnonneg hw).symm
  simp only [D, ENNReal.tsum_mul_right]
  rw [ENNReal.tsum_mul_left, he]
  dsimp only [Z]
  rw [ENNReal.ofReal_mul (by positivity : 0 ≤ K*L^d)]
  dsimp only [F]
  ac_rfl

private noncomputable def annularWindowSymbol {d : ℕ} (θ : E d → ℝ) (m : E d → ℂ)
    (u : ℤ) (T : ℕ) (η : E d) : ℂ :=
  ∑ k ∈ Finset.range T, (θ (((2:ℝ)^(-(u+(k:ℤ)))) • η):ℂ)*m η

private theorem annularWindowSymbol_punctured_continuous {d : ℕ} {θ : E d → ℝ}
    (hθ : Continuous θ) {m : E d → ℂ} (hm : ContinuousOn m {x | x ≠ 0}) (u : ℤ) (T : ℕ) :
    ContinuousOn (annularWindowSymbol θ m u T) {x | x ≠ 0} := by
  unfold annularWindowSymbol
  apply continuousOn_finsetSum
  intro k _
  exact (Complex.continuous_ofReal.comp (hθ.comp
    ((continuous_const : Continuous (fun _ : E d => (2:ℝ)^(-(u+(k:ℤ))))).smul continuous_id))).continuousOn.mul hm

private theorem annularWindowSymbol_bound {d : ℕ} {θ χ : E d → ℝ}
    (hχ : ∀ x, 0 ≤ χ x) (hχθ : ∀ x, χ x ≤ θ x)
    (hPartition : ∀ x : E d, x ≠ 0 → ∑' k : ℤ, θ (((2:ℝ)^(-k)) • x) = 1)
    {m : E d → ℂ} {A : ℝ} (hm : ∀ x ≠ 0, ‖m x‖ ≤ A)
    (u : ℤ) (T : ℕ) {η : E d} (hη : η ≠ 0) :
    ‖annularWindowSymbol χ m u T η‖ ≤ A := by
  let f (k : ℤ) := θ (((2:ℝ)^(-k)) • η)
  have hf : Summable f := by
    by_contra h
    have hh := hPartition η hη
    change (∑' k, f k) = 1 at hh
    rw [tsum_eq_zero_of_not_summable h] at hh
    norm_num at hh
  let j (k : ℕ) := u+(k:ℤ)
  have hj : Function.Injective j := by
    intro k l h
    exact_mod_cast (add_left_cancel (show u+(k:ℤ) = u+(l:ℤ) from h))
  have hSum : (∑ k ∈ Finset.range T, f (j k)) ≤ 1 := by
    rw [← Finset.sum_image (fun i _ l _ h => hj h)]
    exact (hf.sum_le_tsum _ (fun k _ => (hχ _).trans (hχθ _))).trans_eq (hPartition η hη)
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ k ∈ Finset.range T, f (j k)*A := by
      apply Finset.sum_le_sum
      intro k _
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hχ _)]
      exact mul_le_mul (hχθ _) (hm η hη) (norm_nonneg _) ((hχ _).trans (hχθ _))
    _ = (∑ k ∈ Finset.range T, f (j k))*A := by rw [Finset.sum_mul]
    _ ≤ _ := (mul_le_mul_of_nonneg_right hSum ((norm_nonneg _).trans (hm η hη))).trans_eq (one_mul _)

private theorem dyadicWindow_exhaustion :
    Tendsto (fun n : ℕ => (Finset.range (2*n+1)).image (fun k : ℕ => -(n:ℤ)+(k:ℤ)))
      atTop atTop := by
  apply tendsto_atTop.mpr
  intro s
  let N := s.sup Int.natAbs
  filter_upwards [eventually_ge_atTop N] with n hn
  intro k hk
  have hN : k.natAbs ≤ n := (Finset.le_sup hk).trans hn
  have hk₁ : -(n:ℤ) ≤ k := by omega
  have hk₂ : k ≤ (n:ℤ) := by omega
  have h₃ : (0:ℤ) ≤ k+(n:ℤ) := by omega
  have h₄ : (k+(n:ℤ)).toNat < 2*n+1 := by omega
  refine Finset.mem_image.mpr ⟨(k+(n:ℤ)).toNat, Finset.mem_range.mpr h₄, ?_⟩
  rw [Int.toNat_of_nonneg h₃]
  omega

