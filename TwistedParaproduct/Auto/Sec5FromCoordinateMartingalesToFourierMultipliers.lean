/-- The weighted essential supremum of a profile and its derivative. -/
noncomputable def profileSize (a : ℝ → ℂ) : ℝ≥0∞ :=
  essSup (fun y => ENNReal.ofReal ((1+|y|)^4 * (‖a y‖+‖deriv a y‖))) volume

/-- The one-dimensional dilation used at integer level `k`. -/
noncomputable def profileDilation (a : ℝ → ℂ) (k : ℤ) (y : ℝ) : ℂ :=
  (((2:ℝ)^k : ℝ) : ℂ) * a ((2:ℝ)^k*y)

/-- Convolution on the line with a coordinate profile. -/
noncomputable def lineProfileConvolution (a f : ℝ → ℂ) (x : ℝ) : ℂ :=
  ∫ y, a y * f (x-y)

/-- Convolution in the indicated coordinate, holding all other coordinates fixed. -/
noncomputable def coordinateProfileConvolution {d : ℕ} (i : Fin d)
    (a : ℝ → ℂ) (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) : ℂ :=
  ∫ y, a y * f (Function.update x i (x i-y))

/-- The normalized triangle profile from averaging translated intervals. -/
noncomputable def tentProfile (y : ℝ) : ℂ := (max (1-|y|) 0 : ℝ)

private theorem continuous_weighted_profile (a : ℝ → ℂ) (ha : Continuous a) :
    Continuous (fun y => (1+|y|)^4 * ‖a y‖) := by fun_prop

private theorem profileSize_amplitude_le {a : ℝ → ℂ} (ha : Continuous a)
    (hQ : profileSize a ≠ ∞) (y : ℝ) :
    (1+|y|)^4 * ‖a y‖ ≤ (profileSize a).toReal := by
  have hae : ∀ᵐ y ∂(volume : Measure ℝ),
      (1+|y|)^4 * ‖a y‖ ≤ (profileSize a).toReal := by
    filter_upwards [ENNReal.ae_le_essSup (μ := (volume : Measure ℝ))
      (fun y => ENNReal.ofReal ((1+|y|)^4 * (‖a y‖+‖deriv a y‖)))] with x hx
    have hh : ENNReal.ofReal ((1+|x|)^4 * (‖a x‖+‖deriv a x‖)) ≤ profileSize a := hx
    have hh' := ENNReal.toReal_mono hQ hh
    rw [ENNReal.toReal_ofReal (by positivity)] at hh'
    exact (mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (norm_nonneg _)) (by positivity)).trans hh'
  by_contra! hy
  have ho : IsOpen {y | (profileSize a).toReal < (1+|y|)^4 * ‖a y‖} :=
    isOpen_lt continuous_const (continuous_weighted_profile a ha)
  have hn : {y | (profileSize a).toReal < (1+|y|)^4 * ‖a y‖}.Nonempty := ⟨y,hy⟩
  have hz : volume {y | (profileSize a).toReal < (1+|y|)^4 * ‖a y‖} = 0 := by
    simpa only [not_le] using (ae_iff.mp hae)
  exact (ho.measure_pos _ hn).ne' hz

private theorem tentProfile_lipschitz : LipschitzWith 1 tentProfile := by
  have h : LipschitzWith 1 (fun y : ℝ => 1-|y|) := by
    apply LipschitzWith.of_dist_le_mul
    intro x y
    have h := (LipschitzWith.dist_right (0:ℝ)).dist_le_mul x y
    simp only [Real.dist_eq, zero_sub, abs_neg] at h ⊢
    rw [show 1-|x|-(1-|y|) = |y|-|x| by ring, abs_sub_comm]
    exact h
  have hm : LipschitzWith 1 (fun y : ℝ => max (1-|y|) 0) := by
    simpa only [max_eq_left (show (0:NNReal) ≤ 1 from zero_le_one)] using
      h.max (LipschitzWith.const (0:ℝ))
  change LipschitzWith 1 (fun y : ℝ => ((max (1-|y|) 0 : ℝ) : ℂ))
  simpa only [Function.comp_def, one_mul] using Complex.isometry_ofReal.lipschitzWith.comp hm

private theorem tentProfile_eq_zero {x : ℝ} (hx : 1 ≤ |x|) : tentProfile x = 0 := by
  unfold tentProfile
  rw [max_eq_right (sub_nonpos.mpr hx), Complex.ofReal_zero]

private theorem tentProfile_deriv_eq_zero {x : ℝ} (hx : 1 < |x|) : deriv tentProfile x = 0 := by
  have ho : IsOpen {y : ℝ | 1 < |y|} := isOpen_lt continuous_const continuous_abs
  have he : tentProfile =ᶠ[𝓝 x] (fun _ => (0:ℂ)) := by
    have hm : ∀ᶠ y in 𝓝 x, y ∈ {y : ℝ | 1 < |y|} := ho.mem_nhds hx
    filter_upwards [hm] with y hy
    exact tentProfile_eq_zero hy.le
  rw [he.deriv_eq, deriv_const]

/-- The normalized triangle profile has finite weighted size. -/
theorem tentProfile_size_finite : profileSize tentProfile ≠ ∞ := by
  have h : profileSize tentProfile ≤ ENNReal.ofReal 32 := by
    unfold profileSize
    let w (x : ℝ) := ENNReal.ofReal ((1+|x|)^4 * (‖tentProfile x‖+‖deriv tentProfile x‖))
    have hco : IsCoboundedUnder (· ≤ ·) (ae (volume : Measure ℝ)) w :=
      isCoboundedUnder_le_of_le (ae (volume : Measure ℝ)) (x := (0:ℝ≥0∞)) (fun _ => zero_le)
    apply essSup_le_of_ae_le _ (f := w) _ hco
    filter_upwards [] with x
    apply ENNReal.ofReal_le_ofReal
    rcases le_or_gt |x| 1 with hx | hx
    · have hval : ‖tentProfile x‖ ≤ 1 := by
        rw [tentProfile, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (le_max_right _ _)]
        exact max_le (by linarith [abs_nonneg x]) zero_le_one
      have hd : ‖deriv tentProfile x‖ ≤ 1 := norm_deriv_le_of_lipschitz tentProfile_lipschitz
      have hpow : (1+|x|)^4 ≤ (2:ℝ)^4 :=
        pow_le_pow_left₀ (by positivity) (by linarith) _
      exact (mul_le_mul hpow (add_le_add hval hd) (by positivity) (by positivity)).trans
        (by norm_num)
    · rw [tentProfile_eq_zero hx.le, tentProfile_deriv_eq_zero hx, norm_zero, add_zero, mul_zero]
      norm_num
  exact h.trans_lt ENNReal.ofReal_lt_top |>.ne

/-- The normalized triangle profile has integral one. -/
theorem tentProfile_integral : (∫ y, tentProfile y) = 1 := by
  let L : ℝ → ℝ := (Ioc (-1:ℝ) 0).indicator (fun y => 1+y)
  let R : ℝ → ℝ := (Ioc (0:ℝ) 1).indicator (fun y => 1-y)
  have hLR : tentProfile = fun y => ((L y+R y : ℝ) : ℂ) := by
    funext y
    unfold tentProfile
    rcases le_or_gt y 0 with hy | hy
    · have hyR : y ∉ Ioc (0:ℝ) 1 := fun h => (not_lt_of_ge hy) h.1
      rcases le_or_gt y (-1) with hy' | hy'
      · have hyL : y ∉ Ioc (-1:ℝ) 0 := fun h => (not_lt_of_ge hy') h.1
        simp [L,R,hyL,hyR,abs_of_nonpos hy,max_eq_right (by linarith : 1+y ≤ 0)]
      · have hyL : y ∈ Ioc (-1:ℝ) 0 := ⟨hy',hy⟩
        simp [L,R,hyL,hyR,abs_of_nonpos hy,max_eq_left (by linarith : 0 ≤ 1+y)]
    · have hyL : y ∉ Ioc (-1:ℝ) 0 := fun h => (not_le_of_gt hy) h.2
      rcases le_or_gt y 1 with hy' | hy'
      · have hyR : y ∈ Ioc (0:ℝ) 1 := ⟨hy,hy'⟩
        simp [L,R,hyL,hyR,abs_of_pos hy,max_eq_left (by linarith : 0 ≤ 1-y)]
      · have hyR : y ∉ Ioc (0:ℝ) 1 := fun h => (not_le_of_gt hy') h.2
        simp [L,R,hyL,hyR,abs_of_pos hy,max_eq_right (by linarith : 1-y ≤ 0)]
  have hleft : IntervalIntegrable (fun y : ℝ => 1+y) volume (-1) 0 :=
    (continuous_const.add continuous_id).intervalIntegrable _ _
  have hright : IntervalIntegrable (fun y : ℝ => 1-y) volume 0 1 :=
    (continuous_const.sub continuous_id).intervalIntegrable _ _
  have hLI : Integrable L := by
    unfold L
    rw [integrable_indicator_iff measurableSet_Ioc]
    exact hleft.1
  have hRI : Integrable R := by
    unfold R
    rw [integrable_indicator_iff measurableSet_Ioc]
    exact hright.1
  have hli : (∫ y, L y) = 1/2 := by
    unfold L
    rw [integral_indicator measurableSet_Ioc, ← intervalIntegral.integral_of_le (by norm_num),
      intervalIntegral.integral_add (f := fun _ => (1:ℝ)) (g := fun y => y)
        intervalIntegrable_const (continuous_id.intervalIntegrable _ _),
      intervalIntegral.integral_const, integral_id]
    norm_num
  have hri : (∫ y, R y) = 1/2 := by
    unfold R
    rw [integral_indicator measurableSet_Ioc, ← intervalIntegral.integral_of_le (by norm_num),
      intervalIntegral.integral_sub (f := fun _ => (1:ℝ)) (g := fun y => y)
        intervalIntegrable_const (continuous_id.intervalIntegrable _ _),
      intervalIntegral.integral_const, integral_id]
    norm_num
  rw [hLR, integral_complex_ofReal, integral_add hLI hRI, hli,hri]
  norm_num

