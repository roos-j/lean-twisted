/-- The multiplier of the homogeneous, spherically normalized principal value. -/
theorem homogeneousSymbol {d : ℕ} (hd : 2 ≤ d)
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    (hK : ContDiffOn ℝ (↑(⊤ : ℕ∞)) (homogeneousKernel Ω) {y | y ≠ 0})
    (hΩ : (∫ ω, Ω ω ∂(volume : Measure (E d)).toSphere) = 0) :
    ∃ (L : SchwartzMap (E d) ℂ) (m : E d → ℂ) (B : ℕ → ℝ),
      (∀ y, L y = homogeneousKernel Ω y * dyadicAnnularCutoff y) ∧ (∫ y, L y) = 0 ∧
      (∀ ξ, m ξ = ∑' k : ℤ, (𝓕 L) (((2:ℝ)^k) • ξ)) ∧
      (∀ N, 0 ≤ B N ∧ MikhlinHormander.MikhlinCondition N m (B N)) ∧
      ∀ g : SchwartzMap (E d) ℂ,
        Integrable (compensatedPrincipalValue (homogeneousKernel Ω) g) ∧
        (∫ y, compensatedPrincipalValue (homogeneousKernel Ω) g y) =
          ∫ ξ, m ξ*(𝓕⁻ g) ξ := by
  obtain ⟨L,hL,hL0⟩ := homogeneousAnnularSchwartz Ω hK hΩ
  let G : SchwartzMap (E d) ℂ := 𝓕 L
  have hG : G 0 = 0 := by
    change (𝓕 L) 0 = 0
    rw [SchwartzMap.fourier_coe, Real.fourier_eq']
    simp [hL0]
  let m (ξ : E d) := ∑' k : ℤ, G (((2:ℝ)^k) • ξ)
  obtain ⟨B,hB,hM,hNorm,hD⟩ := schwartzDyadic_mikhlin G hG
  let A (N : ℕ) := ∑ j ∈ Finset.range (N+1), B j
  refine ⟨L,m,A,hL,hL0,fun _ => rfl,?_,?_⟩
  · intro N
    exact ⟨Finset.sum_nonneg (fun n _ => hB n), hM.of_le (by simp), fun n hn ξ hξ =>
      (hD n ξ hξ).trans (Finset.single_le_sum (fun j _ => hB j) (Finset.mem_range.mpr (by omega)))⟩
  · intro g
    have hI := schwartz_compensated_integrable hd hK.continuousOn g
    refine ⟨hI,?_⟩
    have hLeft := finiteAnnular_compensated_tendsto (by omega : 0 < d) hI
    let S (n : ℕ) := (Finset.range (2*n+1)).image (fun k : ℕ => -(n:ℤ)+(k:ℤ))
    let T (n : ℕ) (ξ : E d) := ∑ k ∈ S n, G (((2:ℝ)^k) • ξ)
    have hT (n : ℕ) (ξ : E d) : ‖T n ξ‖ ≤ B 0 :=
      (norm_sum_le _ _).trans (((hNorm ξ).1.sum_le_tsum _ (fun _ _ => norm_nonneg _)).trans (hNorm ξ).2)
    have hTc (n : ℕ) : Continuous (T n) :=
      continuous_finsetSum _ fun k _ => G.continuous.comp
        (((2:ℝ)^k • ContinuousLinearMap.id ℝ (E d)).continuous)
    have hlim (ξ : E d) : Tendsto (fun n => T n ξ) atTop (𝓝 (m ξ)) :=
      ((hNorm ξ).1.of_norm.hasSum).comp dyadicWindow_exhaustion
    have hRight : Tendsto (fun n => ∫ ξ, T n ξ*(𝓕⁻ g) ξ)
        atTop (𝓝 (∫ ξ, m ξ*(𝓕⁻ g) ξ)) := by
      apply tendsto_integral_of_dominated_convergence (fun ξ => B 0 * ‖(𝓕⁻ g) ξ‖)
      · exact fun n => ((hTc n).mul (𝓕⁻ g : SchwartzMap (E d) ℂ).continuous).aestronglyMeasurable
      · exact (𝓕⁻ g : SchwartzMap (E d) ℂ).integrable.norm.const_mul _
      · intro n
        filter_upwards [] with ξ
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_right (hT n ξ) (norm_nonneg _)
      · exact Filter.Eventually.of_forall fun ξ => (hlim ξ).mul_const _
    apply tendsto_nhds_unique hLeft
    refine hRight.congr' (Filter.Eventually.of_forall fun n => ?_)
    simpa only [symmetricPhysicalCutoff,Complex.ofReal_sum,G,T,S] using
      (finiteHomogeneousAnnularPairing Ω hΩ hL g (S n)).symm

private theorem schwartz_weighted_derivative {d : ℕ} (f : SchwartzMap (E d) ℂ)
    (n L : ℕ) (x : E d) :
    (1+‖x‖)^L*‖iteratedFDeriv ℝ n (f : E d → ℂ) x‖ ≤
      2^L*(SchwartzMap.seminorm ℝ 0 n f+SchwartzMap.seminorm ℝ L n f) := by
  let G := ‖iteratedFDeriv ℝ n (f : E d → ℂ) x‖
  let P := SchwartzMap.seminorm ℝ 0 n f
  let Q := SchwartzMap.seminorm ℝ L n f
  have hP : G ≤ P := by simpa only [G,P,pow_zero,one_mul] using SchwartzMap.le_seminorm ℝ 0 n f x
  have hQ : ‖x‖^L*G ≤ Q := SchwartzMap.le_seminorm ℝ L n f x
  by_cases hx : ‖x‖ ≤ 1
  · calc
      _ ≤ 2^L*G := mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) (by linarith) _) (norm_nonneg _)
      _ ≤ 2^L*(P+Q) := mul_le_mul_of_nonneg_left (hP.trans (le_add_of_nonneg_right (by positivity))) (by positivity)
  · have hx' := le_of_lt (lt_of_not_ge hx)
    calc
      _ ≤ (2*‖x‖)^L*G := mul_le_mul_of_nonneg_right
        (pow_le_pow_left₀ (by positivity) (by linarith) _) (norm_nonneg _)
      _ = 2^L*(‖x‖^L*G) := by rw [mul_pow,mul_assoc]
      _ ≤ 2^L*(P+Q) := mul_le_mul_of_nonneg_left (hQ.trans (le_add_of_nonneg_left (by positivity))) (by positivity)

private theorem norm_le_coord_bound {d : ℕ} (x : E d) {B : ℝ}
    (h : ∀ i, |x i| ≤ B) : ‖x‖ ≤ (d:ℝ)*B := by
  have he : x = ∑ i : Fin d, EuclideanSpace.single i (x i) := by
    ext i
    change x i = EuclideanSpace.proj (𝕜 := ℝ) i (∑ j : Fin d, EuclideanSpace.single j (x j))
    rw [_root_.map_sum]
    simp [EuclideanSpace.single_apply]
  calc
    ‖x‖ = ‖∑ i : Fin d, EuclideanSpace.single i (x i)‖ := congrArg norm he
    _ ≤ ∑ i : Fin d, ‖EuclideanSpace.single i (x i)‖ := norm_sum_le _ _
    _ ≤ ∑ _i : Fin d, B := Finset.sum_le_sum fun i _ => by
      simpa [EuclideanSpace.norm_single, Real.norm_eq_abs] using h i
    _ = _ := by simp [nsmul_eq_mul]

noncomputable def physicalSchwartzProduct {d : ℕ}
    (f : Fin d → SchwartzMap (E d) ℂ) (x y : E d) : ℂ :=
  ∏ i, f i (x-y i • EuclideanSpace.single i 1)

private theorem physicalSchwartzProduct_continuous {d : ℕ}
    (f : Fin d → SchwartzMap (E d) ℂ) : Continuous (Function.uncurry (physicalSchwartzProduct f)) := by
  change Continuous (fun a : E d × E d => ∏ i, f i (a.1-a.2 i • EuclideanSpace.single i 1))
  apply continuous_finsetProd
  intro i _
  exact (f i).continuous.comp (continuous_fst.sub
    (((EuclideanSpace.proj (𝕜 := ℝ) i).continuous.comp continuous_snd).smul continuous_const))

