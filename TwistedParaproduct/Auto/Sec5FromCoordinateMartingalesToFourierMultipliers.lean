private theorem lineProfileConvolution_integrand_ae {K f : ℝ → ℂ}
    (hKm : Measurable K) (hK : Integrable K) (hm : Measurable f) {p : ℝ} (hp : 1 < p)
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    ∀ᵐ x ∂volume, Integrable (fun y => K y*f (x-y)) := by
  let N (x : ℝ) := ∫⁻ y, ‖K y‖ₑ * ‖f (x-y)‖ₑ^p
  have hn : Measurable N := by
    have hm' : Measurable (fun z : ℝ×ℝ => ‖K z.2‖ₑ*‖f (z.1-z.2)‖ₑ^p) :=
      (hKm.comp measurable_snd).enorm.mul
        ((hm.comp (measurable_fst.sub measurable_snd)).enorm.pow_const p)
    exact hm'.lintegral_prod_right'
  have hp₀ : 0 < p := zero_lt_one.trans hp
  have hKfin : (∫⁻ y, ‖K y‖ₑ) ≠ ∞ := hK.hasFiniteIntegral.ne
  have hfp : (∫⁻ x, ‖f x‖ₑ^p) ≠ ∞ := by
    intro h
    have hl := hf.eLpNorm_lt_top
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp₀)
      ENNReal.ofReal_ne_top hf.aestronglyMeasurable,
      ENNReal.toReal_ofReal hp₀.le, h, ENNReal.top_rpow_of_pos (one_div_pos.mpr hp₀)] at hl
    exact lt_irrefl _ hl
  have hN : (∫⁻ x, N x) ≠ ∞ := by
    have hs := Auto.Spherical.BRSRadial.lintegral_convolution_swap (p := p) hKm.norm hm
    have he (x : ℝ) : ‖‖K x‖‖ₑ = ‖K x‖ₑ := by simp [← ofReal_norm]
    simp_rw [he] at hs
    rw [show (∫⁻ x, N x) = _ from hs]
    exact ENNReal.mul_ne_top hKfin hfp
  filter_upwards [ae_lt_top hn hN] with x hx
  let q := p.conjExponent
  have hconj : q.HolderConjugate p := (Real.HolderConjugate.conjExponent hp).symm
  have hq₀ := hconj.pos
  have hsum : 1/q+1/p = 1 := by simpa using hconj.one_div_add_one_div
  have h₁ : Measurable (fun y : ℝ => ‖K y‖ₑ^(1/q)) := hKm.enorm.pow_const _
  have h₂ : Measurable (fun y : ℝ => ‖K y‖ₑ^(1/p)*‖f (x-y)‖ₑ) :=
    (hKm.enorm.pow_const _).mul ((hm.comp (measurable_const.sub measurable_id)).enorm)
  have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hconj h₁.aemeasurable h₂.aemeasurable
  have hsplit (y : ℝ) : ‖K y‖ₑ^(1/q)*(‖K y‖ₑ^(1/p)*‖f (x-y)‖ₑ) = ‖K y*f (x-y)‖ₑ := by
    rw [enorm_mul, ← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity),
      hsum, ENNReal.rpow_one]
  have hpart₁ (y : ℝ) : (‖K y‖ₑ^(1/q))^q = ‖K y‖ₑ := by
    rw [one_div, ENNReal.rpow_inv_rpow hq₀.ne']
  have hpart₂ (y : ℝ) : (‖K y‖ₑ^(1/p)*‖f (x-y)‖ₑ)^p = ‖K y‖ₑ*‖f (x-y)‖ₑ^p := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp₀.le, one_div, ENNReal.rpow_inv_rpow hp₀.ne']
  simp only [Pi.mul_apply, hsplit, hpart₁, hpart₂] at hH
  refine ⟨(hKm.mul (hm.comp (measurable_const.sub measurable_id))).aestronglyMeasurable, ?_⟩
  exact hH.trans_lt (ENNReal.mul_lt_top
    (ENNReal.rpow_lt_top_of_nonneg (by positivity) hKfin)
    (ENNReal.rpow_lt_top_of_nonneg (by positivity) hx.ne))

private theorem lineProfileConvolution_congr_input {K f g : ℝ → ℂ}
    (h : f =ᵐ[volume] g) : lineProfileConvolution K f = lineProfileConvolution K g := by
  funext x
  have he := ((volume : Measure ℝ).measurePreserving_sub_left x).quasiMeasurePreserving.ae h
  unfold lineProfileConvolution
  apply integral_congr_ae
  filter_upwards [he] with y hy using congrArg (fun z => K y*z) hy

private theorem lineProfileConvolution_truncation_tendsto {K f : ℝ → ℂ}
    (hKm : Measurable K) (hK : Integrable K) (hm : Measurable f) {p : ℝ} (hp : 1 < p)
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    ∀ᵐ x ∂volume, Tendsto (fun n : ℕ =>
      lineProfileConvolution K ((Icc (-(n:ℝ)) (n:ℝ)).indicator f) x) atTop
      (𝓝 (lineProfileConvolution K f x)) := by
  filter_upwards [lineProfileConvolution_integrand_ae hKm hK hm hp hf] with x hx
  let A (n : ℕ) := Icc (-(n:ℝ)) (n:ℝ)
  let F (n : ℕ) (y : ℝ) := K y*(A n).indicator f (x-y)
  let G (y : ℝ) := K y*f (x-y)
  change Tendsto (fun n => ∫ y, F n y) atTop (𝓝 (∫ y, G y))
  refine tendsto_integral_of_dominated_convergence (fun y => ‖G y‖)
    (fun n => (hKm.mul ((hm.indicator measurableSet_Icc).comp
      (measurable_const.sub measurable_id))).aestronglyMeasurable) hx.norm ?_ ?_
  · intro n
    filter_upwards [] with y
    change ‖K y*(A n).indicator f (x-y)‖ ≤ ‖G y‖
    by_cases hy : x-y ∈ A n
    · simp [hy,G]
    · simpa [hy] using norm_nonneg (G y)
  · filter_upwards [] with y
    have he : (fun n => F n y) =ᶠ[atTop] fun _ : ℕ => G y := by
      obtain ⟨N,hN⟩ := exists_nat_ge |x-y|
      filter_upwards [eventually_ge_atTop N] with n hn
      have hh : |x-y| ≤ (n:ℝ) := hN.trans (Nat.cast_le.mpr hn)
      have hy : x-y ∈ A n := abs_le.mp hh
      simp [F,hy,G]
    exact tendsto_const_nhds.congr' he.symm

