private theorem dyadicBallMaximalRaw_moment {d : ℕ} (hd : 0 < d) {q : ℝ} (hq : 1 < q)
    (f : EuclideanSpace ℝ (Fin d) → ℂ) (hf : Measurable f) :
    let C := ENNReal.ofReal q * (2*(ENNReal.ofReal 4)^d*(ENNReal.ofReal (q-1))⁻¹*
      (ENNReal.ofReal 2)^(q-1))
    (∫⁻ x, dyadicBallMaximalRaw d f x ^ q) ≤ C * ∫⁻ x, (ENNReal.ofReal ‖f x‖)^q := by
  let X := EuclideanSpace ℝ (Fin d)
  let R := dyadicBallMaximalRaw d
  let C := ENNReal.ofReal q * (2*(ENNReal.ofReal 4)^d*(ENNReal.ofReal (q-1))⁻¹*
    (ENNReal.ofReal 2)^(q-1))
  have hq₀ : 0 < q := zero_lt_one.trans hq
  let F (n : ℕ) : X → ℂ := {x | ‖f x‖ ≤ (n:ℝ)}.indicator f
  have hFm (n : ℕ) : Measurable (F n) :=
    hf.indicator (measurableSet_le hf.norm measurable_const)
  have hFn (n : ℕ) (x : X) : ‖F n x‖ ≤ (n:ℝ) := by
    by_cases hx : ‖f x‖ ≤ (n:ℝ) <;> simp [F,hx]
  let G (n : ℕ) (x : X) := ENNReal.ofReal ‖F n x‖
  have hGle (n : ℕ) (x : X) : G n x ≤ ENNReal.ofReal ‖f x‖ := by
    by_cases hx : ‖f x‖ ≤ (n:ℝ) <;> simp [G,F,hx]
  have hGm (n : ℕ) : Measurable (G n) := (hFm n).norm.ennreal_ofReal
  have hGmono : Monotone G := by
    intro n m hnm x
    by_cases hx : ‖f x‖ ≤ (n:ℝ)
    · have hm := hx.trans (Nat.cast_le.mpr hnm)
      simp [G,F,hx,hm]
    · simp [G,F,hx]
  have hG_eq : (fun x => ENNReal.ofReal ‖f x‖) = fun x => ⨆ n, G n x := by
    funext x
    apply le_antisymm _ (iSup_le (fun n => hGle n x))
    obtain ⟨n,hn⟩ := exists_nat_ge ‖f x‖
    have hg : G n x = ENNReal.ofReal ‖f x‖ := by simp [G,F,hn]
    exact hg.ge.trans (le_iSup (fun n => G n x) n)
  have hR_eq (x : X) : R f x = ⨆ n, R (F n) x := by
    dsimp only [R,dyadicBallMaximalRaw]
    rw [hG_eq]
    simp_rw [lintegral_iSup hGm hGmono, ENNReal.mul_iSup]
    exact iSup_comm
  have hRmono : Monotone (fun n x => R (F n) x) := by
    intro n m hnm x
    dsimp only [R,dyadicBallMaximalRaw]
    exact iSup_mono (fun k => mul_le_mul_right (lintegral_mono (hGmono hnm)) _)
  have hMoment (n : ℕ) : (∫⁻ x, R (F n) x ^ q) ≤ C * ∫⁻ x, (ENNReal.ofReal ‖f x‖)^q := by
    have h := dyadic_ball_maximal_lintegral_bound_of_bounded hd hq (F n) (hFm n)
      ⟨(n:ℝ),Nat.cast_nonneg n,hFn n⟩
    have hRfin (x : X) : R (F n) x ≠ ∞ :=
      ne_top_of_le_ne_top ENNReal.ofReal_ne_top
        (dyadic_ball_maximal_raw_le_of_norm_le (F n) (n:ℝ) (Nat.cast_nonneg n) (hFn n) x)
    have he (x : X) : ENNReal.ofReal (dyadicBallMaximal d (F n) x ^ q) = R (F n) x ^ q := by
      unfold dyadicBallMaximal
      change ENNReal.ofReal ((R (F n) x).toReal ^ q) = _
      rw [← ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg hq₀.le, ENNReal.ofReal_toReal (hRfin x)]
    simp_rw [he] at h
    refine h.trans ?_
    dsimp only [C]
    rw [← mul_assoc]
    exact mul_le_mul_right (lintegral_mono fun x => ENNReal.rpow_le_rpow (hGle n x) hq₀.le) _
  have hpSup (x : X) : R f x ^ q = ⨆ n, R (F n) x ^ q := by
    rw [hR_eq]
    exact (ENNReal.orderIsoRpow q hq₀).map_iSup (fun n => R (F n) x)
  change (∫⁻ x, R f x ^ q) ≤ C * _
  simp_rw [hpSup]
  rw [lintegral_iSup (fun n => (dyadicBallMaximalRaw_measurable (hFm n)).pow_const q)
    (fun n m hnm x => ENNReal.rpow_le_rpow (hRmono hnm x) hq₀.le)]
  exact iSup_le hMoment

private noncomputable def lineEuclideanEquiv : ℝ ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin 1) where
  toLinearEquiv := (PiLp.equivOfUnique 2 ℝ (fun _ : Fin 1 => ℝ)).symm.toLinearEquiv
  norm_map' x := by
    rw [PiLp.norm_eq_of_L2]
    simp only [Fin.sum_univ_one, Real.norm_eq_abs]
    have hx : ((PiLp.equivOfUnique 2 ℝ (fun _ : Fin 1 => ℝ)).symm x) 0 = x := rfl
    change Real.sqrt (|((PiLp.equivOfUnique 2 ℝ (fun _ : Fin 1 => ℝ)).symm x) 0|^2) = |x|
    rw [hx, Real.sqrt_sq (abs_nonneg x)]

private noncomputable def lineDyadicMaximalRaw (f : ℝ → ℂ) (x : ℝ) : ℝ≥0∞ :=
  ⨆ k : ℤ, (volume (Metric.ball x ((2:ℝ)^k)))⁻¹ *
    ∫⁻ y in Metric.ball x ((2:ℝ)^k), ENNReal.ofReal ‖f y‖

open Auto.HardyLittlewoodMaximal in
private theorem lineDyadicMaximalRaw_equiv (f : ℝ → ℂ) (x : ℝ) :
    lineDyadicMaximalRaw f x =
      dyadicBallMaximalRaw 1 (f ∘ lineEuclideanEquiv.symm) (lineEuclideanEquiv x) := by
  let e := lineEuclideanEquiv
  have hm := e.measurePreserving
  have he : MeasurableEmbedding e := e.toContinuousLinearEquiv.toHomeomorph.measurableEmbedding
  unfold lineDyadicMaximalRaw dyadicBallMaximalRaw
  apply iSup_congr
  intro k
  let s := Metric.ball (e x) ((2:ℝ)^k)
  have hpre : e ⁻¹' s = Metric.ball x ((2:ℝ)^k) := by
    ext y
    simp [s, Metric.mem_ball]
  have hvol : volume (Metric.ball x ((2:ℝ)^k)) = (volume : Measure _) s := by
    rw [← hpre]
    have hs : MeasurableSet s := measurableSet_ball
    exact hm.measure_preimage hs.nullMeasurableSet
  rw [hvol, ← hpre]
  have heq := hm.setLIntegral_comp_preimage_emb he
    (fun y => ENNReal.ofReal ‖f (e.symm y)‖) s
  simp only [e.symm_apply_apply] at heq
  rw [heq]
  rfl

private theorem lineDyadicMaximalRaw_moment {q : ℝ} (hq : 1 < q) {f : ℝ → ℂ}
    (hf : Measurable f) :
    let C := ENNReal.ofReal q * (2*(ENNReal.ofReal 4)^1*(ENNReal.ofReal (q-1))⁻¹*
      (ENNReal.ofReal 2)^(q-1))
    (∫⁻ x, lineDyadicMaximalRaw f x ^ q) ≤ C * ∫⁻ x, (ENNReal.ofReal ‖f x‖)^q := by
  let e := lineEuclideanEquiv
  let g := f ∘ e.symm
  have he : MeasurableEmbedding e := e.toContinuousLinearEquiv.toHomeomorph.measurableEmbedding
  have hm := e.measurePreserving
  have hg := hf.comp e.symm.continuous.measurable
  have h := dyadicBallMaximalRaw_moment (by norm_num : 0 < 1) hq g hg
  dsimp only at h ⊢
  rw [← hm.lintegral_comp_emb he (fun z => Auto.HardyLittlewoodMaximal.dyadicBallMaximalRaw 1 g z^q),
    ← hm.lintegral_comp_emb he (fun z => (ENNReal.ofReal ‖g z‖)^q)] at h
  have heq (x : ℝ) : Auto.HardyLittlewoodMaximal.dyadicBallMaximalRaw 1 g (e x) =
      lineDyadicMaximalRaw f x := (lineDyadicMaximalRaw_equiv f x).symm
  simp only [heq, g, Function.comp_apply, e.symm_apply_apply] at h
  exact h

private theorem exists_dyadic_shell (r : ℝ) :
    ∃ n : ℕ, r < (2:ℝ)^(n+1) ∧ (n = 0 ∨ (2:ℝ)^n ≤ r) := by
  have h : ∃ n : ℕ, r < (2:ℝ)^(n+1) := by
    obtain ⟨n,hn⟩ := pow_unbounded_of_one_lt r (by norm_num : (1:ℝ) < 2)
    exact ⟨n,hn.trans_le (pow_le_pow_right₀ (by norm_num) (Nat.le_succ n))⟩
  refine ⟨Nat.find h, Nat.find_spec h, ?_⟩
  rcases Nat.eq_zero_or_pos (Nat.find h) with hn | hn
  · exact Or.inl hn
  · refine Or.inr (le_of_not_gt ?_)
    intro hr
    have he : Nat.find h - 1 + 1 = Nat.find h := by omega
    have hlt : Nat.find h - 1 < Nat.find h := by omega
    exact (Nat.find_min h hlt) (by simpa only [he] using hr)

set_option maxHeartbeats 750000 in
private theorem lineProfileConvolution_dominated {a f : ℝ → ℂ} (ha : Continuous a)
    (hq : profileSize a ≠ ∞) (hf : Measurable f) (k : ℤ) (x : ℝ) :
    ‖lineProfileConvolution (profileDilation a k) f x‖ₑ ≤
      (8 * profileSize a) * lineDyadicMaximalRaw f x := by
  let Q := (profileSize a).toReal
  let s := (2:ℝ)^k
  let R (n : ℕ) := (2:ℝ)^((n:ℤ)+1-k)
  let c (n : ℕ) := s*Q*(1/16:ℝ)^n
  let V (y : ℝ) := ENNReal.ofReal ‖f (x-y)‖
  let H := lineDyadicMaximalRaw f x
  have hs : 0 < s := by dsimp [s]; positivity
  have hQ : 0 ≤ Q := ENNReal.toReal_nonneg
  have hR (n : ℕ) : 0 < R n := by dsimp [R]; positivity
  have hc (n : ℕ) : 0 ≤ c n := by dsimp [c]; positivity
  have hR' (n : ℕ) : R n = ((2:ℝ)^n*2)/s := by
    dsimp [R,s]
    rw [zpow_sub₀ (by norm_num : (2:ℝ) ≠ 0), zpow_add₀ (by norm_num : (2:ℝ) ≠ 0),
      zpow_one, zpow_natCast]
  have hVm : Measurable V := (hf.comp (measurable_const.sub measurable_id)).norm.ennreal_ofReal
  have hpoint (y : ℝ) :
      ‖profileDilation a k y * f (x-y)‖ₑ ≤
        ∑' n : ℕ, ENNReal.ofReal (c n) * (Metric.ball 0 (R n)).indicator V y := by
    obtain ⟨n,hn,hprev⟩ := exists_dyadic_shell |s*y|
    have hy : y ∈ Metric.ball (0:ℝ) (R n) := by
      rw [Metric.mem_ball, Real.dist_eq, sub_zero, hR' n]
      apply (lt_div_iff₀ hs).mpr
      rwa [abs_mul, abs_of_pos hs, pow_succ, mul_comm s] at hn
    have hkernel : ‖profileDilation a k y‖ ≤ c n := by
      have hval := profileSize_amplitude_le ha hq (s*y)
      have hden : 0 < (1+|s*y|)^4 := by positivity
      have hval' : ‖a (s*y)‖ ≤ Q/(1+|s*y|)^4 :=
        (le_div_iff₀ hden).mpr (by simpa [Q, mul_comm] using hval)
      have hfactor : Q/(1+|s*y|)^4 ≤ Q*(1/16:ℝ)^n := by
        have hp : (16:ℝ)^n ≤ (1+|s*y|)^4 := by
          rcases hprev with rfl | hprev
          · rw [pow_zero]
            exact one_le_pow₀ (le_add_of_nonneg_right (abs_nonneg _))
          · calc
              _ = ((2:ℝ)^n)^4 := by rw [← pow_mul, mul_comm n, pow_mul]; norm_num
              _ ≤ _ := pow_le_pow_left₀ (by positivity) (by linarith) _
        rw [one_div, inv_pow, ← div_eq_mul_inv]
        exact div_le_div_of_nonneg_left hQ (by positivity) hp
      have he : ‖profileDilation a k y‖ = s * ‖a (s*y)‖ := by
        unfold profileDilation
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hs]
      rw [he]
      exact (mul_le_mul_of_nonneg_left (hval'.trans hfactor) hs.le).trans_eq (by dsimp [c]; ring)
    rw [enorm_mul, ← ofReal_norm, ← ofReal_norm]
    refine (mul_le_mul_left (ENNReal.ofReal_le_ofReal hkernel) _).trans ?_
    change ENNReal.ofReal (c n) * V y ≤ _
    rw [← Set.indicator_of_mem hy V]
    exact ENNReal.le_tsum (f := fun n => ENNReal.ofReal (c n) * (Metric.ball 0 (R n)).indicator V y) n
  have hBall (n : ℕ) : (∫⁻ y in Metric.ball 0 (R n), V y) ≤
      ENNReal.ofReal (2*R n)*H := by
    let B := Metric.ball x (R n)
    have hpre : (fun y : ℝ => x-y) ⁻¹' B = Metric.ball 0 (R n) := by
      ext y
      simp [B, Metric.mem_ball]
    have hcomp : (∫⁻ y in Metric.ball 0 (R n), V y) = ∫⁻ y in B, ENNReal.ofReal ‖f y‖ := by
      rw [← hpre]
      exact ((volume : Measure ℝ).measurePreserving_sub_left x).setLIntegral_comp_preimage
        measurableSet_ball hf.norm.ennreal_ofReal
    have hmax : (ENNReal.ofReal (2*R n))⁻¹ * (∫⁻ y in B, ENNReal.ofReal ‖f y‖) ≤ H := by
      have hp := le_iSup (fun j : ℤ => (volume (Metric.ball x ((2:ℝ)^j)))⁻¹ *
        ∫⁻ y in Metric.ball x ((2:ℝ)^j), ENNReal.ofReal ‖f y‖) ((n:ℤ)+1-k)
      rw [Real.volume_ball] at hp
      exact hp
    have hvol : ENNReal.ofReal (2*R n) ≠ 0 :=
      ENNReal.ofReal_ne_zero_iff.mpr (mul_pos (by norm_num) (hR n))
    rw [hcomp]
    calc
      _ = ENNReal.ofReal (2*R n)*((ENNReal.ofReal (2*R n))⁻¹ *
          ∫⁻ y in B, ENNReal.ofReal ‖f y‖) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel hvol ENNReal.ofReal_ne_top, one_mul]
      _ ≤ _ := mul_le_mul_right hmax _
  have hcoeff (n : ℕ) : ENNReal.ofReal (c n)*ENNReal.ofReal (2*R n) =
      (4*profileSize a) * (1/8:ℝ≥0∞)^n := by
    have hreal : c n*(2*R n) = (4*Q)*(1/8:ℝ)^n := by
      rw [hR' n]
      dsimp only [c]
      calc
        _ = (4*Q)*((1/16:ℝ)^n*(2:ℝ)^n) := by field_simp [hs.ne']; ring
        _ = _ := by rw [← mul_pow]; norm_num
    rw [← ENNReal.ofReal_mul (hc n), hreal, ENNReal.ofReal_mul (by positivity : 0 ≤ 4*Q),
      ENNReal.ofReal_pow (by norm_num : 0 ≤ (1/8:ℝ)), ENNReal.ofReal_mul (by norm_num : 0 ≤ (4:ℝ)),
      ENNReal.ofReal_toReal hq]
    rw [show ENNReal.ofReal (1/8:ℝ) = (1/8:ℝ≥0∞) by
      rw [one_div, ENNReal.ofReal_inv_of_pos (by norm_num)]
      norm_num]
    norm_num
  unfold lineProfileConvolution
  refine (enorm_integral_le_lintegral_enorm _).trans ((lintegral_mono hpoint).trans ?_)
  rw [lintegral_tsum (μ := volume) (f := fun n y => ENNReal.ofReal (c n) *
    (Metric.ball 0 (R n)).indicator V y)
    (fun n => (measurable_const.mul (hVm.indicator measurableSet_ball)).aemeasurable)]
  have hInt n : (∫⁻ y, ENNReal.ofReal (c n) * (Metric.ball 0 (R n)).indicator V y) ≤
      ((4*profileSize a) * (1/8:ℝ≥0∞)^n)*H := by
    rw [lintegral_const_mul _ (hVm.indicator measurableSet_ball), lintegral_indicator measurableSet_ball]
    exact (mul_le_mul_right (hBall n) _).trans_eq (by rw [← mul_assoc,hcoeff])
  refine (ENNReal.tsum_le_tsum hInt).trans ?_
  rw [ENNReal.tsum_mul_right, ENNReal.tsum_mul_left, ENNReal.tsum_geometric]
  apply mul_le_mul_left
  calc
    (4*profileSize a)*((1:ℝ≥0∞)-1/8)⁻¹ =
        (4*((1:ℝ≥0∞)-1/8)⁻¹)*profileSize a := by ac_rfl
    _ ≤ 8*profileSize a := by
      have h8 : (1/8:ℝ≥0∞) ≤ 1/2 := by
        simpa only [one_div] using ENNReal.inv_le_inv.mpr (by norm_num : (2:ℝ≥0∞) ≤ 8)
      have ht : (1/2:ℝ≥0∞) ≤ 1-1/8 :=
        ENNReal.le_sub_of_add_le_right (by finiteness)
          ((add_le_add le_rfl h8).trans_eq (ENNReal.add_halves 1))
      have hi := ENNReal.inv_le_inv.mpr ht
      exact mul_le_mul_left ((mul_le_mul_right hi (4:ℝ≥0∞)).trans_eq (by norm_num)) _

/-- The countable supremum of the moduli of the profile convolutions. -/
noncomputable def profileMaximalRaw {d : ℕ} (i : Fin d) (a : ℝ → ℂ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) : ℝ≥0∞ :=
  ⨆ k : ℤ, ‖coordinateProfileConvolution i (profileDilation a k) f x‖ₑ

/-- The real maximal profile convolution, which is finite almost everywhere on \(L^q\). -/
noncomputable def profileMaximal {d : ℕ} (i : Fin d) (a : ℝ → ℂ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) : ℝ :=
  (profileMaximalRaw i a f x).toReal

private theorem coordinateProfileConvolution_measurable {d : ℕ} (i : Fin d)
    {a : ℝ → ℂ} (ha : Measurable a) {f : (Fin d → ℝ) → ℂ} (hf : Measurable f) :
    Measurable (coordinateProfileConvolution i a f) := by
  have hUpdate : Measurable (fun z : (Fin d → ℝ) × ℝ => Function.update z.1 i (z.1 i-z.2)) :=
    (measurable_update' (a := i)).comp
      (measurable_fst.prodMk (((measurable_pi_apply i).comp measurable_fst).sub measurable_snd))
  exact (ha.comp measurable_snd |>.mul (hf.comp hUpdate)).stronglyMeasurable.integral_prod_right'.measurable

private theorem profileMaximalRaw_measurable {d : ℕ} (i : Fin d)
    {a : ℝ → ℂ} (ha : Measurable a) {f : (Fin d → ℝ) → ℂ} (hf : Measurable f) :
    Measurable (profileMaximalRaw i a f) := by
  unfold profileMaximalRaw
  apply Measurable.iSup
  intro k
  have hm : Measurable (profileDilation a k) :=
    (ha.comp (measurable_const.mul measurable_id)).const_mul _
  exact (coordinateProfileConvolution_measurable i hm hf).enorm

private noncomputable def profileMaximalMomentConstant (q : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal q * (2*(ENNReal.ofReal 4)^1*(ENNReal.ofReal (q-1))⁻¹*(ENNReal.ofReal 2)^(q-1))

private theorem profileMaximalMomentConstant_ne_top {q : ℝ} (hq : 1 < q) :
    profileMaximalMomentConstant q ≠ ∞ := by
  have hq' : 0 < q-1 := sub_pos.mpr hq
  have hi : (ENNReal.ofReal (q-1))⁻¹ ≠ ∞ :=
    ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hq')
  have hp : (ENNReal.ofReal 2)^(q-1) ≠ ∞ :=
    (ENNReal.rpow_lt_top_of_nonneg hq'.le ENNReal.ofReal_ne_top).ne
  unfold profileMaximalMomentConstant
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (ENNReal.mul_ne_top (ENNReal.mul_ne_top (by finiteness) hi) hp)

private theorem lineProfileMaximal_moment {q : ℝ} (hq : 1 < q) {a f : ℝ → ℂ}
    (ha : Continuous a) (hQ : profileSize a ≠ ∞) (hm : Measurable f) :
    (∫⁻ x, (⨆ k : ℤ, ‖lineProfileConvolution (profileDilation a k) f x‖ₑ) ^ q) ≤
      ((8*profileSize a)^q*profileMaximalMomentConstant q) * ∫⁻ x, ‖f x‖ₑ ^ q := by
  have hq₀ : 0 ≤ q := (zero_lt_one.trans hq).le
  have hm' : Measurable (lineDyadicMaximalRaw f) := by
    rw [show lineDyadicMaximalRaw f = (fun x =>
      Auto.HardyLittlewoodMaximal.dyadicBallMaximalRaw 1 (f ∘ lineEuclideanEquiv.symm)
        (lineEuclideanEquiv x)) from funext (lineDyadicMaximalRaw_equiv f)]
    exact (dyadicBallMaximalRaw_measurable (hm.comp lineEuclideanEquiv.symm.continuous.measurable)).comp
      lineEuclideanEquiv.continuous.measurable
  calc
    _ ≤ ∫⁻ x, ((8*profileSize a)*lineDyadicMaximalRaw f x)^q :=
      lintegral_mono fun x => ENNReal.rpow_le_rpow
        (iSup_le fun k => lineProfileConvolution_dominated ha hQ hm k x) hq₀
    _ = (8*profileSize a)^q * ∫⁻ x, lineDyadicMaximalRaw f x ^ q := by
      simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hq₀, lintegral_const_mul _ (hm'.pow_const q)]
    _ ≤ _ := by
      rw [mul_assoc]
      apply mul_le_mul_right
      simp_rw [← ofReal_norm]
      exact lineDyadicMaximalRaw_moment hq hm

set_option maxHeartbeats 850000 in
private theorem profileMaximal_moment {d : ℕ} (i : Fin d) {q : ℝ} (hq : 1 < q)
    {a : ℝ → ℂ} (ha : Continuous a) (hQ : profileSize a ≠ ∞)
    {f : (Fin d → ℝ) → ℂ} (hm : Measurable f) :
    (∫⁻ x, profileMaximalRaw i a f x ^ q) ≤
      ((8*profileSize a)^q*profileMaximalMomentConstant q) * ∫⁻ x, ‖f x‖ₑ ^ q := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n+1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n+1) => ℝ) i).symm _
    let g := f ∘ e
    let F := profileMaximalRaw i a f ∘ e
    let C := (8*profileSize a)^q*profileMaximalMomentConstant q
    have hgm : Measurable g := hm.comp e.measurable
    have hFm : Measurable F := (profileMaximalRaw_measurable i ha.measurable hm).comp e.measurable
    rw [← he.lintegral_comp_emb e.measurableEmbedding (fun x => profileMaximalRaw i a f x^q),
      ← he.lintegral_comp_emb e.measurableEmbedding (fun x => ‖f x‖ₑ^q)]
    change (∫⁻ z, F z^q ∂volume) ≤ C * ∫⁻ z, ‖g z‖ₑ^q ∂volume
    rw [Measure.volume_eq_prod, lintegral_prod_symm' _ (hFm.pow_const q),
      lintegral_prod_symm' _ (hgm.enorm.pow_const q), ← lintegral_const_mul C]
    swap
    · exact (hgm.enorm.pow_const q).lintegral_prod_left'
    apply lintegral_mono
    intro y
    let g' (x : ℝ) := g (x,y)
    have hg' : Measurable g' := hgm.comp (measurable_id.prodMk measurable_const)
    have hslice (x : ℝ) : F (x,y) = ⨆ k : ℤ, ‖lineProfileConvolution (profileDilation a k) g' x‖ₑ := by
      change profileMaximalRaw i a f (i.insertNth x y) = _
      unfold profileMaximalRaw
      apply iSup_congr
      intro k
      unfold coordinateProfileConvolution lineProfileConvolution
      simp only [Fin.insertNth_apply_same, Fin.update_insertNth]
      rfl
    simp_rw [hslice]
    exact lineProfileMaximal_moment hq ha hQ hg'

private theorem profileMaximalRaw_congr_ae {d : ℕ} (i : Fin d) (a : ℝ → ℂ)
    {f g : (Fin d → ℝ) → ℂ} (h : f =ᵐ[volume] g) :
    profileMaximalRaw i a f =ᵐ[volume] profileMaximalRaw i a g := by
  filter_upwards [coordinateFiber_congr_ae i h] with x hx
  have hv := ((volume : Measure ℝ).measurePreserving_sub_left (x i)).quasiMeasurePreserving.ae hx
  unfold profileMaximalRaw
  apply iSup_congr
  intro k
  unfold coordinateProfileConvolution
  have he : (∫ y, profileDilation a k y * f (Function.update x i (x i-y))) =
      ∫ y, profileDilation a k y * g (Function.update x i (x i-y)) := by
    apply integral_congr_ae
    filter_upwards [hv] with y hy
    exact congrArg (fun z => profileDilation a k y*z) hy
  rw [he]

set_option maxHeartbeats 800000 in
/-- The dyadic-scale maximal profile bound on a coordinate. -/
theorem profileMax {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {d : ℕ} (i : Fin d) (a : ℝ → ℂ),
      Continuous a → profileSize a ≠ ∞ → ∀ (f : (Fin d → ℝ) → ℂ),
      MemLp f (ENNReal.ofReal q) volume →
      (∀ᵐ x ∂volume, profileMaximalRaw i a f x < ∞) ∧
      MemLp (profileMaximal i a f) (ENNReal.ofReal q) volume ∧
      lpNorm (profileMaximal i a f) (ENNReal.ofReal q) volume ≤
        C * (profileSize a).toReal * lpNorm f (ENNReal.ofReal q) volume := by
  let C := profileMaximalMomentConstant q
  have hq₀ : 0 < q := zero_lt_one.trans hq
  have hqN : ENNReal.ofReal q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hq₀
  have hqT : ENNReal.ofReal q ≠ ∞ := ENNReal.ofReal_ne_top
  have hC : C ≠ ∞ := profileMaximalMomentConstant_ne_top hq
  refine ⟨8*(C^(1/q)).toReal, by positivity, ?_⟩
  intro d i a ha hQ f hf
  let g := hf.aestronglyMeasurable.mk f
  have hfg : f =ᵐ[volume] g := hf.aestronglyMeasurable.ae_eq_mk
  have hg : MemLp g (ENNReal.ofReal q) volume := hf.ae_eq hfg
  have hgm : Measurable g := hf.aestronglyMeasurable.stronglyMeasurable_mk.measurable
  have hR := profileMaximalRaw_congr_ae i a hfg
  have hMeas := profileMaximalRaw_measurable i ha.measurable hgm
  let R := profileMaximalRaw i a g
  have hm : Measurable R := hMeas
  have hnorm : (∫⁻ x, ‖g x‖ₑ^q)^(1/q) = eLpNorm g (ENNReal.ofReal q) volume := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hqN hqT hg.aestronglyMeasurable,
      ENNReal.toReal_ofReal hq₀.le]
  have hfin : (∫⁻ x, ‖g x‖ₑ^q) ≠ ∞ := by
    intro he
    have h := hg.eLpNorm_lt_top
    rw [← hnorm, he, ENNReal.top_rpow_of_pos (one_div_pos.mpr hq₀)] at h
    exact lt_irrefl _ h
  have hQ' : 8*profileSize a ≠ ∞ := ENNReal.mul_ne_top (by finiteness) hQ
  have hPow : (8*profileSize a)^q ≠ ∞ :=
    (ENNReal.rpow_lt_top_of_nonneg hq₀.le hQ').ne
  have hbound := profileMaximal_moment i hq ha hQ hgm
  have hInt : (∫⁻ x, R x^q) ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top hPow hC) hfin) hbound
  have haeR : ∀ᵐ x ∂volume, R x < ∞ := by
    filter_upwards [ae_lt_top (hm.pow_const q) hInt] with x hx
    refine lt_of_le_of_ne le_top (fun he => ?_)
    rw [he, ENNReal.top_rpow_of_pos hq₀] at hx
    exact lt_irrefl _ hx
  refine ⟨by filter_upwards [hR,haeR] with x hx h; rw [hx]; exact h, ?_⟩
  have hT : profileMaximal i a f =ᵐ[volume] profileMaximal i a g :=
    hR.fun_comp ENNReal.toReal
  have hTm : AEStronglyMeasurable (profileMaximal i a g) volume := hm.ennreal_toReal.aestronglyMeasurable
  have he : (∫⁻ x, ‖profileMaximal i a g x‖ₑ ^ q) = ∫⁻ x, R x^q := by
    apply lintegral_congr_ae
    filter_upwards [haeR] with x hx
    change ‖(R x).toReal‖ₑ^q = R x^q
    rw [← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
    rw [ENNReal.ofReal_toReal hx.ne]
  have hN : eLpNorm (profileMaximal i a g) (ENNReal.ofReal q) volume =
      (∫⁻ x, R x^q)^(1/q) := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hqN hqT hTm,
      ENNReal.toReal_ofReal hq₀.le, he]
  have hM : MemLp (profileMaximal i a g) (ENNReal.ofReal q) volume := by
    rw [memLp_iff,hN]
    exact ENNReal.rpow_lt_top_of_nonneg (one_div_nonneg.mpr hq₀.le) hInt
  refine ⟨hM.ae_eq hT.symm, ?_⟩
  have hNorm := ENNReal.rpow_le_rpow hbound (one_div_nonneg.mpr hq₀.le)
  change (∫⁻ x, R x^q)^(1/q) ≤
    (((8*profileSize a)^q*C) * ∫⁻ x, ‖g x‖ₑ^q)^(1/q) at hNorm
  have hqInv : 0 ≤ 1/q := one_div_nonneg.mpr hq₀.le
  rw [ENNReal.mul_rpow_of_nonneg _ _ hqInv, ENNReal.mul_rpow_of_nonneg _ _ hqInv, hnorm] at hNorm
  simp only [one_div, ENNReal.rpow_rpow_inv hq₀.ne'] at hNorm
  have hC' : C^q⁻¹ ≠ ∞ :=
    (ENNReal.rpow_lt_top_of_nonneg (inv_nonneg.mpr hq₀.le) hC).ne
  have hReal := ENNReal.toReal_mono (ENNReal.mul_ne_top (ENNReal.mul_ne_top hQ' hC')
    hg.eLpNorm_lt_top.ne) hNorm
  simp only [one_div] at hN
  rw [← hN] at hReal
  simp only [ENNReal.toReal_mul, ENNReal.toReal_ofNat] at hReal
  have hL : lpNorm (profileMaximal i a f) (ENNReal.ofReal q) volume =
      lpNorm (profileMaximal i a g) (ENNReal.ofReal q) volume :=
    congrArg ENNReal.toReal (eLpNorm_congr_ae hT)
  have hG : lpNorm f (ENNReal.ofReal q) volume = lpNorm g (ENNReal.ofReal q) volume :=
    congrArg ENNReal.toReal (eLpNorm_congr_ae hfg)
  rw [hL,hG]
  refine hReal.trans_eq ?_
  simp only [one_div, lpNorm]
  ring

private theorem lineProfileConvolution_measurable {K f : ℝ → ℂ}
    (hK : Measurable K) (hf : Measurable f) : Measurable (lineProfileConvolution K f) := by
  have hm : Measurable (fun z : ℝ × ℝ => K z.2 * f (z.1-z.2)) :=
    (hK.comp measurable_snd).mul (hf.comp (measurable_fst.sub measurable_snd))
  exact (hm.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure ℝ))).measurable

private theorem lineProfileConvolution_integrable {K f : ℝ → ℂ}
    (hK : Integrable K) (hf : Integrable f) : Integrable (lineProfileConvolution K f) :=
  hK.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hf

private theorem lineProfileConvolution_young {q : ℝ} (hq : 1 ≤ q)
    {K f : ℝ → ℂ} (hKm : Measurable K) (hK : Integrable K) (hm : Measurable f)
    (hf : MemLp f (ENNReal.ofReal q) volume) :
    MemLp (lineProfileConvolution K f) (ENNReal.ofReal q) volume ∧
      eLpNorm (lineProfileConvolution K f) (ENNReal.ofReal q) volume ≤
        eLpNorm K 1 volume * eLpNorm f (ENNReal.ofReal q) volume := by
  let H (x : ℝ) := ∫ y, ‖K y‖ * ‖f (x-y)‖
  let G (x : ℝ) := Complex.ofReal ‖f x‖
  have hH (x : ℝ) : 0 ≤ H x := integral_nonneg fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _)
  have hBound (x : ℝ) : ‖lineProfileConvolution K f x‖ ≤ H x := by
    unfold lineProfileConvolution
    simpa only [norm_mul, H] using norm_integral_le_integral_norm
      (μ := (volume : Measure ℝ)) (fun y => K y * f (x-y))
  have hEq (x : ℝ) :
      (∫ y : ℝ, ((‖K y‖:ℝ) : ℂ) * G (x-y)) = (H x : ℂ) := by
    dsimp only [G,H]
    simp_rw [← Complex.ofReal_mul, integral_complex_ofReal]
  have hK1 : (∫⁻ y, ‖K y‖ₑ) ≠ ∞ := hK.hasFiniteIntegral.ne
  have hkn : (∫⁻ y : ℝ, ‖‖K y‖‖ₑ) ≠ ∞ := by
    simp_rw [← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _), ofReal_norm]
    exact hK1
  have hGM : Measurable G := Complex.continuous_ofReal.measurable.comp hm.norm
  have hb := Auto.Spherical.BRSRadial.lintegral_convolution_rpow_le hq hKm.norm hkn hGM
  have hNK (y : ℝ) : ‖‖K y‖‖ₑ = ‖K y‖ₑ := by simp [← ofReal_norm, Real.norm_eq_abs]
  have hNG (y : ℝ) : ‖G y‖ₑ = ‖f y‖ₑ := by simp [G, ← ofReal_norm, Complex.norm_real]
  have hNH (x : ℝ) : ‖(H x : ℂ)‖ₑ = ENNReal.ofReal (H x) := by
    simp [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hH x)]
  simp_rw [hEq, hNH, hNK, hNG] at hb
  have hq₀ : 0 < q := zero_lt_one.trans_le hq
  have hp : ENNReal.ofReal q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hq₀
  have hpt : ENNReal.ofReal q ≠ ∞ := ENNReal.ofReal_ne_top
  have hMoment :
      (∫⁻ x, ‖lineProfileConvolution K f x‖ₑ^q) ≤
        (∫⁻ y, ‖K y‖ₑ)^q * ∫⁻ x, ‖f x‖ₑ^q := by
    refine (lintegral_mono fun x => ENNReal.rpow_le_rpow ?_ hq₀.le).trans hb
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hBound x)
  have hm' := lineProfileConvolution_measurable hKm hm
  have he := ENNReal.rpow_le_rpow hMoment (inv_nonneg.mpr hq₀.le)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hq₀.le),
    ENNReal.rpow_rpow_inv hq₀.ne'] at he
  have heNorm : eLpNorm (lineProfileConvolution K f) (ENNReal.ofReal q) volume ≤
        eLpNorm K 1 volume * eLpNorm f (ENNReal.ofReal q) volume := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp hpt hm'.aestronglyMeasurable,
      eLpNorm_eq_lintegral_rpow_enorm_toReal hp hpt hf.aestronglyMeasurable,
      ENNReal.toReal_ofReal hq₀.le, eLpNorm_one_eq_lintegral_enorm hK.aestronglyMeasurable]
    simpa only [one_div] using he
  exact ⟨heNorm.trans_lt (ENNReal.mul_lt_top
    (memLp_one_iff_integrable.mpr hK).eLpNorm_lt_top hf.eLpNorm_lt_top), heNorm⟩

set_option maxHeartbeats 700000 in
private theorem lp2Fourier_ae_eq {f : ℝ → ℂ} (h1 : Integrable f) (h2 : MemLp f 2 volume) :
    (⇑(Lp.fourierTransformₗᵢ ℝ ℂ (h2.toLp f)) : ℝ → ℂ) =ᵐ[volume] 𝓕 f := by
  have hTD := Lp.fourier_toTemperedDistribution_eq (h2.toLp f)
  have hLoc : LocallyIntegrable (𝓕 f) volume :=
    (VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
      (innerSL ℝ).continuous₂ h1).locallyIntegrable
  refine ae_eq_of_integral_contDiff_smul_eq
    ((Lp.memLp (Lp.fourierTransformₗᵢ ℝ ℂ (h2.toLp f))).locallyIntegrable (by norm_num)) hLoc ?_
  intro φ hφ hφc
  let u : SchwartzMap ℝ ℂ := (hφc.comp_left (g := Complex.ofRealCLM) rfl).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp hφ)
  have ht := congrArg (fun T : TemperedDistribution ℝ ℂ => T u) hTD
  simp only [TemperedDistribution.fourier_apply, Lp.toTemperedDistribution_apply] at ht
  change (∫ x : ℝ, 𝓕 u x • (⇑(h2.toLp f) : ℝ → ℂ) x) =
    ∫ x : ℝ, u x • (⇑(Lp.fourierTransformₗᵢ ℝ ℂ (h2.toLp f)) : ℝ → ℂ) x at ht
  have hflip := VectorFourier.integral_fourierIntegral_smul_eq_flip
    (L := innerₗ ℝ) Real.continuous_fourierChar continuous_inner h1 (u.integrable (μ := volume))
  calc
    _ = ∫ x : ℝ, 𝓕 u x • f x := by
      change (∫ x : ℝ, u x • (⇑(Lp.fourierTransformₗᵢ ℝ ℂ (h2.toLp f)) : ℝ → ℂ) x) = _
      rw [← ht]
      apply integral_congr_ae
      filter_upwards [h2.coeFn_toLp] with x hx
      rw [hx]
    _ = ∫ x : ℝ, f x • 𝓕 u x := by simp_rw [smul_eq_mul, mul_comm]
    _ = ∫ x : ℝ, 𝓕 f x • u x := by
      change (∫ x : ℝ, f x • VectorFourier.fourierIntegral 𝐞 volume (innerₗ ℝ) u x) =
        ∫ x : ℝ, VectorFourier.fourierIntegral 𝐞 volume (innerₗ ℝ) f x • u x
      simpa only [flip_innerₗ] using hflip.symm
    _ = _ := by
      change (∫ x : ℝ, 𝓕 f x • u x) = ∫ x : ℝ, u x • 𝓕 f x
      simp_rw [smul_eq_mul, mul_comm]

set_option maxHeartbeats 700000 in
private theorem lineProfileConvolution_L2 {K f : ℝ → ℂ} (hK : Integrable K)
    (hKm : Measurable K) {B : ℝ} (hB : 0 ≤ B) (hFourier : ∀ ξ, ‖𝓕 K ξ‖ ≤ B)
    (hf : Integrable f) (hm : Measurable f) (hf₂ : MemLp f 2 volume) :
    MemLp (lineProfileConvolution K f) 2 volume ∧
      eLpNorm (lineProfileConvolution K f) 2 volume ≤ ENNReal.ofReal B * eLpNorm f 2 volume := by
  let g := lineProfileConvolution K f
  have hg : Integrable g := lineProfileConvolution_integrable hK hf
  have hg₂ : MemLp g 2 volume := by
    simpa using (lineProfileConvolution_young (q := 2) (by norm_num) hKm hK hm
      (by simpa using hf₂)).1
  refine ⟨hg₂, ?_⟩
  have hfg := lp2Fourier_ae_eq hg hg₂
  have hff := lp2Fourier_ae_eq hf hf₂
  have hcomp (ξ : ℝ) : 𝓕 g ξ = 𝓕 K ξ * 𝓕 f ξ :=
    Real.fourier_mul_convolution_eq hK hf ξ
  let V := Lp.fourierTransformₗᵢ ℝ ℂ (hg₂.toLp g)
  let U := Lp.fourierTransformₗᵢ ℝ ℂ (hf₂.toLp f)
  have hG := eLpNorm_le_nnreal_smul_eLpNorm_of_ae_le_mul (f := ⇑V) (g := ⇑U) (c := B.toNNReal)
    (Lp.aestronglyMeasurable V) (by
      filter_upwards [hfg,hff] with x hxg hxf
      apply NNReal.coe_le_coe.mp
      change ‖V x‖ ≤ ((B.toNNReal:NNReal):ℝ)*‖U x‖
      change V x = _ at hxg
      change U x = _ at hxf
      rw [hxg,hxf,hcomp x,norm_mul,Real.coe_toNNReal _ hB]
      exact mul_le_mul_of_nonneg_right (hFourier x) (norm_nonneg _)) 2
  have heForm (v : Lp (α := ℝ) ℂ 2) :
      eLpNorm (⇑(Lp.fourierTransformₗᵢ ℝ ℂ v)) 2 volume = eLpNorm (⇑v) 2 volume := by
    rw [← Lp.enorm_def, ← Lp.enorm_def, ← ofReal_norm, ← ofReal_norm,
      (Lp.fourierTransformₗᵢ ℝ ℂ).norm_map]
  dsimp only [U,V] at hG
  rw [heForm, heForm, eLpNorm_congr_ae hg₂.coeFn_toLp, eLpNorm_congr_ae hf₂.coeFn_toLp] at hG
  exact hG

/-- The scalar kernel difference condition in the convolution estimate. -/
def scalarKernelRegular (K : ℝ → ℂ) (B : ℝ) : Prop :=
  ∀ x u : ℝ, 2*|u| ≤ |x| → x ≠ 0 → ‖K (x-u)-K x‖ ≤ B*|u|/|x|^2

private theorem scalarKernelRegular_measurable {K : ℝ → ℂ} {B : ℝ}
    (hB : 0 ≤ B) (hK : scalarKernelRegular K B) : Measurable K := by
  apply measurable_of_continuousOn_compl_singleton 0
  intro x hx
  have hx₀ : x ≠ 0 := hx
  apply ContinuousAt.continuousWithinAt
  rw [Metric.continuousAt_iff]
  intro ε hε
  let A := B/|x|^2
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hAbs : 0 < |x| := abs_pos.mpr hx₀
  let δ := min (|x|/2) (ε/(A+1))
  refine ⟨δ, lt_min (by positivity) (by positivity), ?_⟩
  intro z hz
  have hz' : |x-z| < δ := by simpa only [Real.dist_eq, abs_sub_comm] using hz
  have hin : 2*|x-z| ≤ |x| := by
    linarith [hz'.le.trans (min_le_left (|x|/2) (ε/(A+1)))]
  have hk := hK x (x-z) hin hx₀
  rw [sub_sub_cancel] at hk
  rw [dist_eq_norm]
  calc
    _ ≤ A*|x-z| := hk.trans_eq (by dsimp [A]; ring)
    _ ≤ (A+1)*|x-z| := mul_le_mul_of_nonneg_right (by linarith) (abs_nonneg _)
    _ < ε := by
      have h := (lt_div_iff₀ (by positivity : 0 < A+1)).mp
        (hz'.trans_le (min_le_right (|x|/2) (ε/(A+1))))
      simpa only [mul_comm] using h

private abbrev ScalarCzCells (f : ℝ → ℂ) (s : ℝ) :=
  {c : ℤ × ℤ // dyadicMaximalCell (fun x => ‖f x‖) s c}

private noncomputable def scalarCzLength {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s) : ℝ :=
  (2:ℝ)^(-c.1.1)

private noncomputable def scalarCzCenter {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s) : ℝ :=
  ((c.1.2 : ℝ)+1/2)*scalarCzLength c

private def scalarCzInterval {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s) : Set ℝ :=
  dyadicInterval c.1.1 c.1.2

private theorem scalarCzLength_pos {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s) :
    0 < scalarCzLength c := by unfold scalarCzLength; positivity

private theorem scalarCzInterval_volume {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s) :
    volume (scalarCzInterval c) = ENNReal.ofReal (scalarCzLength c) := by
  unfold scalarCzInterval scalarCzLength dyadicInterval
  rw [Real.volume_Ico]
  congr 1
  ring

private theorem scalarCzInterval_dist {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s)
    {y : ℝ} (hy : y ∈ scalarCzInterval c) : |y-scalarCzCenter c| ≤ scalarCzLength c/2 := by
  change y ∈ Ico ((c.1.2:ℝ)*scalarCzLength c) (((c.1.2:ℝ)+1)*scalarCzLength c) at hy
  apply abs_le.mpr
  rcases hy with ⟨h₀,h₁⟩
  unfold scalarCzCenter
  constructor <;> linarith

private theorem scalarCzCellAverage_le {f : ℝ → ℂ} (hf : Integrable f) {s : ℝ}
    (c : ScalarCzCells f s) :
    (scalarCzLength c)⁻¹ * (∫ y in scalarCzInterval c, ‖f y‖) ≤ 2*s := by
  let i := c.1.1
  let j := c.1.2
  let x := (j:ℝ)*scalarCzLength c
  let h := i-1
  have hx : x ∈ dyadicInterval i j := by
    refine ⟨le_rfl, ?_⟩
    change (j : ℝ)*scalarCzLength c < ((j : ℝ)+1)*scalarCzLength c
    exact mul_lt_mul_of_pos_right (by linarith) (scalarCzLength_pos c)
  let m := dyadicIndex h x
  have hh : h < i := by dsimp [h]; omega
  have hsub := dyadicInterval_subset_of_mem hh.le hx (mem_dyadicInterval_iff.mpr (rfl : dyadicIndex h x = m))
  have hparent := le_of_not_gt (c.2.2 (h,m) hh hsub)
  change (((2:ℝ)^(-h))⁻¹*(∫ y in dyadicInterval h m, |‖f y‖|)) ≤ s at hparent
  simp only [abs_of_nonneg (norm_nonneg _)] at hparent
  have hmass : (∫ y in scalarCzInterval c, ‖f y‖) ≤ ∫ y in dyadicInterval h m, ‖f y‖ :=
    setIntegral_mono_set hf.norm.integrableOn (Filter.Eventually.of_forall fun y => norm_nonneg _)
      (Filter.Eventually.of_forall hsub)
  have hscale : (scalarCzLength c)⁻¹ = 2*((2:ℝ)^(-h))⁻¹ := by
    change ((2:ℝ)^(-i))⁻¹ = _
    have he : -i = -h + (-1) := by dsimp [h]; omega
    rw [he,zpow_add₀ (by norm_num : (2:ℝ) ≠ 0),zpow_neg_one,mul_inv_rev,inv_inv]
  rw [hscale, mul_assoc]
  exact mul_le_mul_of_nonneg_left
    ((mul_le_mul_of_nonneg_left hmass (inv_nonneg.mpr (zpow_nonneg (by norm_num) _))).trans hparent)
    (by norm_num)

private noncomputable def scalarCzAverage {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s) : ℂ :=
  (((scalarCzLength c)⁻¹ : ℝ) : ℂ) * ∫ y in scalarCzInterval c, f y

private noncomputable def scalarCzGood (f : ℝ → ℂ) (s : ℝ) (x : ℝ) : ℂ := by
  classical
  exact if h : ∃ c : ScalarCzCells f s, x ∈ scalarCzInterval c then scalarCzAverage h.choose else f x

private theorem scalarCzGood_on {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s)
    {x : ℝ} (hx : x ∈ scalarCzInterval c) : scalarCzGood f s x = scalarCzAverage c := by
  have h : ∃ c : ScalarCzCells f s, x ∈ scalarCzInterval c := ⟨c,hx⟩
  unfold scalarCzGood
  rw [dite_eq_left h]
  congr 1
  by_contra! hc
  exact Set.disjoint_left.mp (disjoint_dyadicMaximalCells (f := fun y => ‖f y‖) (threshold := s) hc)
    h.choose_spec hx

private theorem scalarCzGood_off {f : ℝ → ℂ} {s x : ℝ}
    (hx : x ∉ ⋃ c : ScalarCzCells f s, scalarCzInterval c) : scalarCzGood f s x = f x := by
  have h : ¬ ∃ c : ScalarCzCells f s, x ∈ scalarCzInterval c := fun ⟨c,hc⟩ => hx (mem_iUnion.mpr ⟨c,hc⟩)
  unfold scalarCzGood
  rw [dite_eq_right h]

private theorem scalarCzAverage_norm_le {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s) :
    ‖scalarCzAverage c‖ ≤ (scalarCzLength c)⁻¹ * ∫ y in scalarCzInterval c, ‖f y‖ := by
  rw [scalarCzAverage, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (inv_nonneg.mpr (scalarCzLength_pos c).le)]
  exact mul_le_mul_of_nonneg_left (norm_integral_le_integral_norm _) (by positivity [scalarCzLength_pos c])

set_option maxHeartbeats 950000 in
private theorem scalarCzGood_bounds {f : ℝ → ℂ} (hf : Integrable f) (hm : Measurable f)
    {s : ℝ} (hs : 0 < s) :
    let g := scalarCzGood f s
    Measurable g ∧ Integrable g ∧
      (∫⁻ x, ‖g x‖ₑ) ≤ (∫⁻ x, ‖f x‖ₑ) ∧
      (∫⁻ x, ‖g x‖ₑ^(2:ℝ)) ≤ ENNReal.ofReal (2*s)*(∫⁻ x, ‖f x‖ₑ) ∧
      MemLp g 2 volume := by
  let I := @scalarCzInterval f s
  let g := scalarCzGood f s
  let D := ⋃ c : ScalarCzCells f s, I c
  have hI (c : ScalarCzCells f s) : MeasurableSet (I c) := measurableSet_Ico
  have hDm : MeasurableSet D := MeasurableSet.iUnion hI
  have hDis := disjoint_dyadicMaximalCells (f := fun y => ‖f y‖) (threshold := s)
  have hgm : Measurable g := by
    intro S hS
    have he : g ⁻¹' S = (Dᶜ ∩ f ⁻¹' S) ∪ ⋃ c : {c : ScalarCzCells f s // scalarCzAverage c ∈ S}, I c := by
      ext x
      constructor
      · intro hx
        by_cases hd : x ∈ D
        · obtain ⟨c,hc⟩ := mem_iUnion.mp hd
          have hg : scalarCzAverage c ∈ S := scalarCzGood_on c hc ▸ hx
          exact Or.inr (mem_iUnion.mpr ⟨⟨c,hg⟩,hc⟩)
        · refine Or.inl ⟨hd, ?_⟩
          change scalarCzGood f s x ∈ S at hx
          rwa [scalarCzGood_off hd] at hx
      · rintro (⟨hd,hx⟩ | hx)
        · change scalarCzGood f s x ∈ S
          rwa [scalarCzGood_off hd]
        · obtain ⟨c,hc⟩ := mem_iUnion.mp hx
          change scalarCzGood f s x ∈ S
          rw [scalarCzGood_on c.1 hc]
          exact c.2
    rw [he]
    exact (hDm.compl.inter (hm hS)).union (MeasurableSet.iUnion fun _ => hI _)
  have hcell (c : ScalarCzCells f s) : (∫⁻ x in I c, ‖g x‖ₑ) ≤ ∫⁻ x in I c, ‖f x‖ₑ := by
    have he : (∫⁻ x in I c, ‖g x‖ₑ) = ‖scalarCzAverage c‖ₑ * volume (I c) := by
      rw [setLIntegral_congr_fun (hI c) (g := fun _ => ‖scalarCzAverage c‖ₑ)
        (fun x hx => congrArg (fun z : ℂ => ‖z‖ₑ) (scalarCzGood_on c hx)), lintegral_const,
        Measure.restrict_apply_univ]
    rw [he, scalarCzInterval_volume, ← ofReal_norm, ← ENNReal.ofReal_mul (norm_nonneg _)]
    have h := mul_le_mul_of_nonneg_right (scalarCzAverage_norm_le c) (scalarCzLength_pos c).le
    have h' : ‖scalarCzAverage c‖ * scalarCzLength c ≤ ∫ x in I c, ‖f x‖ := by
      refine h.trans_eq ?_
      rw [mul_assoc, mul_comm (∫ x in I c, ‖f x‖), ← mul_assoc,
        inv_mul_cancel₀ (scalarCzLength_pos c).ne', one_mul]
    have hb := ENNReal.ofReal_le_ofReal h'
    rw [ofReal_integral_eq_lintegral_ofReal hf.norm.integrableOn
      (Filter.Eventually.of_forall fun x => norm_nonneg (f x))] at hb
    simpa only [ofReal_norm] using hb
  have hOutside : (∫⁻ x in Dᶜ, ‖g x‖ₑ) = ∫⁻ x in Dᶜ, ‖f x‖ₑ :=
    setLIntegral_congr_fun hDm.compl (fun x hx => congrArg (fun z : ℂ => ‖z‖ₑ) (scalarCzGood_off hx))
  have h₁ : (∫⁻ x, ‖g x‖ₑ) ≤ ∫⁻ x, ‖f x‖ₑ := by
    rw [← lintegral_add_compl _ hDm, ← lintegral_add_compl (fun x => ‖f x‖ₑ) hDm, hOutside]
    apply add_le_add_left
    change (∫⁻ x in ⋃ c, I c, ‖g x‖ₑ) ≤ ∫⁻ x in ⋃ c, I c, ‖f x‖ₑ
    rw [lintegral_iUnion hI hDis, lintegral_iUnion hI hDis]
    exact ENNReal.tsum_le_tsum hcell
  have hgi : Integrable g :=
    ⟨hgm.aestronglyMeasurable, h₁.trans_lt hf.hasFiniteIntegral⟩
  have hBound : ∀ᵐ x ∂volume, ‖g x‖ ≤ 2*s := by
    have hD := dyadicMaxLevel_eq_union hf.norm hs
    filter_upwards [ae_tendsto_dyadicAverage hf.norm] with x hx
    change ‖scalarCzGood f s x‖ ≤ 2*s
    by_cases hd : x ∈ D
    · obtain ⟨c,hc⟩ := mem_iUnion.mp hd
      rw [scalarCzGood_on c hc]
      exact (scalarCzAverage_norm_le c).trans (scalarCzCellAverage_le hf c)
    · rw [scalarCzGood_off hd]
      have he : x ∉ dyadicMaxLevel (fun y => ‖f y‖) s := hD ▸ hd
      have hl (k : ℤ) : dyadicAverage k (fun y => ‖f y‖) x ≤ s := by
        apply le_of_not_gt
        intro hc
        apply he
        exact ⟨k, by simpa only [abs_of_nonneg (norm_nonneg _)] using hc⟩
      exact (le_of_tendsto hx (Filter.Eventually.of_forall hl)).trans (by linarith)
  have h₂ : (∫⁻ x, ‖g x‖ₑ^(2:ℝ)) ≤ ENNReal.ofReal (2*s)*(∫⁻ x, ‖f x‖ₑ) := by
    refine le_trans ?_ (mul_le_mul_right h₁ _)
    rw [← lintegral_const_mul _ hgm.enorm]
    apply lintegral_mono_ae
    filter_upwards [hBound] with x hx
    rw [ENNReal.rpow_two, pow_two, ← ofReal_norm]
    exact mul_le_mul_left (ENNReal.ofReal_le_ofReal hx) _
  refine ⟨hgm,hgi,h₁,h₂,?_⟩
  unfold MemLp
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num : (2:ℝ≥0∞) ≠ 0)
    ENNReal.ofNat_ne_top hgm.aestronglyMeasurable, ENNReal.toReal_ofNat]
  exact ENNReal.rpow_lt_top_of_nonneg (by positivity)
    (h₂.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.hasFiniteIntegral)).ne

private theorem scalarCzGood_cancel {f : ℝ → ℂ} (hf : Integrable f) (hm : Measurable f)
    {s : ℝ} (hs : 0 < s) (c : ScalarCzCells f s) :
    (∫ x in scalarCzInterval c, f x - scalarCzGood f s x) = 0 := by
  have hI : MeasurableSet (scalarCzInterval c) := measurableSet_Ico
  let a := scalarCzAverage c
  have h := (scalarCzGood_bounds hf hm hs).2.1
  rw [integral_sub hf.integrableOn h.integrableOn, setIntegral_congr_fun hI (fun _ hx => scalarCzGood_on c hx),
    setIntegral_const, measureReal_def, scalarCzInterval_volume,
    ENNReal.toReal_ofReal (scalarCzLength_pos c).le]
  change (∫ x in scalarCzInterval c, f x) - (scalarCzLength c : ℂ)*scalarCzAverage c = 0
  unfold scalarCzAverage
  rw [← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ (scalarCzLength_pos c).ne',
    Complex.ofReal_one, one_mul, sub_self]

private theorem lineProfileConvolution_right (K f : ℝ → ℂ) (x : ℝ) :
    lineProfileConvolution K f x = ∫ y, f y*K (x-y) := by
  unfold lineProfileConvolution
  rw [← integral_sub_left_eq_self (fun y => f y*K (x-y)) volume x]
  simp [mul_comm]

private theorem lintegral_inverse_square_off (c r : ℝ) (hr : 0 < r) :
    (∫⁻ x in (Metric.closedBall c r)ᶜ, ENNReal.ofReal (|x-c|^2)⁻¹) =
      ENNReal.ofReal (2/r) := by
  let E := {x : ℝ | r < |x|}
  let g (x : ℝ) := ENNReal.ofReal (|x|^2)⁻¹
  have hg : Measurable g := by dsimp [g]; fun_prop
  have hE : MeasurableSet E := measurableSet_lt measurable_const continuous_abs.measurable
  have hpre : (fun x : ℝ => x-c) ⁻¹' E = (Metric.closedBall c r)ᶜ := by
    ext x
    change r < |x-c| ↔ x ∉ Metric.closedBall c r
    rw [Metric.mem_closedBall, Real.dist_eq, not_le]
  rw [← hpre]
  change (∫⁻ x in (fun x : ℝ => x-c) ⁻¹' E, g (x-c)) = _
  have hm : MeasurePreserving (fun x : ℝ => x-c) volume volume := by
    simpa only [sub_eq_add_neg] using measurePreserving_add_right (volume : Measure ℝ) (-c)
  rw [hm.setLIntegral_comp_preimage hE hg]
  have hs : E = Ioi r ∪ Iio (-r) := by
    ext x
    change r < |x| ↔ r < x ∨ x < -r
    rcases le_or_gt 0 x with hx | hx
    · rw [abs_of_nonneg hx]
      exact ⟨Or.inl, fun h => h.elim id (fun hn => by linarith)⟩
    · rw [abs_of_neg hx]
      exact ⟨fun h => Or.inr (by linarith), fun h => h.elim (fun hn => by linarith) (fun hn => by linarith)⟩
  have hdis : Disjoint (Ioi r) (Iio (-r)) := by
    apply Set.disjoint_left.mpr
    intro x h₁ h₂
    have h₁' : r < x := h₁
    have h₂' : x < -r := h₂
    linarith
  rw [hs, lintegral_union measurableSet_Iio hdis]
  have hsym : (∫⁻ x in Iio (-r), g x) = ∫⁻ x in Ioi r, g x := by
    have hpre' : (fun x : ℝ => -x) ⁻¹' Ioi r = Iio (-r) := by
      ext x
      simp [lt_neg]
    rw [← hpre']
    have he : (fun x : ℝ => g x) = (fun x : ℝ => g (-x)) := by funext x; simp [g]
    exact (congrArg (fun h : ℝ → ℝ≥0∞ => ∫⁻ x in (fun x : ℝ => -x) ⁻¹' Ioi r, h x) he).trans
      (((volume : Measure ℝ).measurePreserving_neg).setLIntegral_comp_preimage measurableSet_Ioi hg)
  rw [hsym]
  have hpos : (∫⁻ x in Ioi r, g x) = ENNReal.ofReal r⁻¹ := by
    have hInt : IntegrableOn (fun x : ℝ => x^(-2:ℝ)) (Ioi r) :=
      integrableOn_Ioi_rpow_of_lt (by norm_num) hr
    have hEq : (∫ x in Ioi r, x^(-2:ℝ)) = r⁻¹ := by
      rw [integral_Ioi_rpow_of_lt (by norm_num) hr]
      norm_num [Real.rpow_neg_one]
    have hL : ENNReal.ofReal (∫ x in Ioi r, x^(-2:ℝ)) =
        ∫⁻ x in Ioi r, ENNReal.ofReal (x^(-2:ℝ)) := by
      apply ofReal_integral_eq_lintegral_ofReal hInt
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
      exact Real.rpow_nonneg (hr.trans hx).le _
    rw [hEq] at hL
    refine (setLIntegral_congr_fun measurableSet_Ioi (fun x hx => ?_)).trans hL.symm
    have hx' : 0 < x := hr.trans hx
    simp [g, abs_of_pos hx', Real.rpow_neg hx'.le, Real.rpow_two]
  rw [hpos, ← ENNReal.ofReal_add (inv_nonneg.mpr hr.le) (inv_nonneg.mpr hr.le)]
  congr 1
  ring

private def scalarCzEnlarged {f : ℝ → ℂ} {s : ℝ} (c : ScalarCzCells f s) : Set ℝ :=
  Metric.closedBall (scalarCzCenter c) (2*scalarCzLength c)

set_option maxHeartbeats 1200000 in
private theorem scalarCzBad_tail {K f : ℝ → ℂ} (hK : Integrable K) (hKm : Measurable K)
    {B : ℝ} (hB : 0 ≤ B) (hReg : scalarKernelRegular K B) (hf : Integrable f) (hm : Measurable f)
    {s : ℝ} (hs : 0 < s) :
    let E := ⋃ c : ScalarCzCells f s, scalarCzEnlarged c
    let b x := f x - scalarCzGood f s x
    (∫⁻ x in Eᶜ, ‖lineProfileConvolution K b x‖ₑ) ≤
      ENNReal.ofReal B * ∫⁻ x, ‖b x‖ₑ := by
  let I := @scalarCzInterval f s
  let D := ⋃ c : ScalarCzCells f s, I c
  let E c := @scalarCzEnlarged f s c
  let Eall := ⋃ c : ScalarCzCells f s, E c
  let b x := f x - scalarCzGood f s x
  let A (c : ScalarCzCells f s) (x : ℝ) := ∫ y in I c, b y*K (x-y)
  have hI (c : ScalarCzCells f s) : MeasurableSet (I c) := measurableSet_Ico
  have hDis := disjoint_dyadicMaximalCells (f := fun y => ‖f y‖) (threshold := s)
  have hD : MeasurableSet D := MeasurableSet.iUnion hI
  have hE c : MeasurableSet (E c) := Metric.isClosed_closedBall.measurableSet
  have hEall : MeasurableSet Eall := MeasurableSet.iUnion hE
  have hgood := scalarCzGood_bounds hf hm hs
  have hb : Integrable b := hf.sub hgood.2.1
  have hbm : Measurable b := hm.sub hgood.1
  have hInt : ∀ᵐ x ∂volume, Integrable (fun y => b y*K (x-y)) := by
    exact hb.ae_convolution_exists (ContinuousLinearMap.mul ℂ ℂ) hK
  have hAm (c : ScalarCzCells f s) : Measurable (A c) := by
    have h := lineProfileConvolution_measurable hKm (hbm.indicator (hI c))
    have he (x : ℝ) : lineProfileConvolution K ((I c).indicator b) x = A c x := by
      rw [lineProfileConvolution_right]
      change (∫ y, (I c).indicator b y*K (x-y)) = ∫ y in I c, b y*K (x-y)
      rw [← integral_indicator (hI c)]
      apply integral_congr_ae
      filter_upwards [] with y
      by_cases hy : y ∈ I c <;> simp [hy]
    exact (funext he) ▸ h
  have hAtom (c : ScalarCzCells f s) :
      (∫⁻ x in (E c)ᶜ, ‖A c x‖ₑ) ≤ ENNReal.ofReal B * ∫⁻ y in I c, ‖b y‖ₑ := by
    let L := scalarCzLength c
    let z := scalarCzCenter c
    let v (x : ℝ) := ENNReal.ofReal (|x-z|^2)⁻¹
    let N := ∫⁻ y in I c, ‖b y‖ₑ
    let C := ENNReal.ofReal (B*(L/2))
    have hL : 0 < L := scalarCzLength_pos c
    have hv : Measurable v := by dsimp [v]; fun_prop
    have hC₀ : 0 ≤ B*(L/2) := by positivity
    have hpoint : ∀ᵐ x ∂volume.restrict (E c)ᶜ, ‖A c x‖ₑ ≤ C*v x*N := by
      filter_upwards [ae_restrict_of_ae hInt, ae_restrict_mem (hE c).compl] with x hx hEx
      have hfar : 2*L < |x-z| := by
        change x ∉ Metric.closedBall z (2*L) at hEx
        simpa only [Metric.mem_closedBall, Real.dist_eq, not_le] using hEx
      have hxne : x-z ≠ 0 := fun he => by rw [he,abs_zero] at hfar; linarith
      have hcanc : (∫ y in I c, b y) = 0 := scalarCzGood_cancel hf hm hs c
      have he : A c x = ∫ y in I c, b y*(K (x-y)-K (x-z)) := by
        simp_rw [mul_sub]
        rw [integral_sub hx.integrableOn (hb.integrableOn.mul_const _), integral_mul_const,
          hcanc,zero_mul,sub_zero]
      have hI' : IntegrableOn (fun y => b y*(K (x-y)-K (x-z))) (I c) := by
        simp_rw [mul_sub]
        exact hx.integrableOn.sub (hb.integrableOn.mul_const _)
      have hscale : 0 ≤ (B*(L/2))*(|x-z|^2)⁻¹ := by positivity
      have hN : ENNReal.ofReal (∫ y in I c, ‖b y‖) = N := by
        rw [ofReal_integral_eq_lintegral_ofReal hb.norm.integrableOn
          (Filter.Eventually.of_forall fun _ => norm_nonneg _)]
        simp only [N, ofReal_norm]
      have hn : ‖A c x‖ ≤ ((B*(L/2))*(|x-z|^2)⁻¹) * ∫ y in I c, ‖b y‖ := by
        rw [he, ← integral_const_mul]
        refine (norm_integral_le_integral_norm _).trans (integral_mono_ae hI'.norm
          (hb.norm.integrableOn.const_mul _) ?_)
        filter_upwards [ae_restrict_mem (hI c)] with y hy
        have hnear : |y-z| ≤ L/2 := scalarCzInterval_dist c hy
        have hin : 2*|y-z| ≤ |x-z| := by linarith
        have hdiff := hReg (x-z) (y-z) hin hxne
        rw [show (x-z)-(y-z) = x-y by ring] at hdiff
        have hstep := (mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hnear hB) (inv_nonneg.mpr (by positivity : 0 ≤ |x-z|^2)))
        rw [norm_mul]
        calc
          _ ≤ ‖b y‖*(B*|y-z|/|x-z|^2) := mul_le_mul_of_nonneg_left hdiff (norm_nonneg _)
          _ ≤ ‖b y‖*(((B*(L/2))*(|x-z|^2)⁻¹)) :=
            mul_le_mul_of_nonneg_left (by simpa only [div_eq_mul_inv] using hstep) (norm_nonneg _)
          _ = _ := mul_comm _ _
      have h := ENNReal.ofReal_le_ofReal hn
      rw [ofReal_norm, ENNReal.ofReal_mul hscale, ENNReal.ofReal_mul hC₀, hN] at h
      exact h
    refine (lintegral_mono_ae hpoint).trans ?_
    rw [lintegral_mul_const N (f := fun x => C*v x) (measurable_const.mul hv),
      lintegral_const_mul C hv]
    have hvInt : (∫⁻ x in (E c)ᶜ, v x) = ENNReal.ofReal (2/(2*L)) :=
      lintegral_inverse_square_off z (2*L) (by positivity)
    rw [hvInt]
    apply mul_le_mul_left
    change ENNReal.ofReal (B*(L/2))*ENNReal.ofReal (2/(2*L)) ≤ ENNReal.ofReal B
    rw [← ENNReal.ofReal_mul hC₀]
    apply ENNReal.ofReal_le_ofReal
    have h' : B*(L/2)*(2/(2*L)) = B/2 := by field_simp [hL.ne']
    rw [h']
    linarith
  have hsplit : ∀ᵐ x ∂volume, lineProfileConvolution K b x = ∑' c, A c x := by
    filter_upwards [hInt] with x hx
    rw [lineProfileConvolution_right]
    have he : (∫ y, b y*K (x-y)) = ∫ y in D, b y*K (x-y) := by
      rw [← integral_indicator hD]
      apply integral_congr_ae
      filter_upwards [] with y
      by_cases hy : y ∈ D
      · simp [hy]
      · have hz : b y = 0 := by
          dsimp [b]
          rw [scalarCzGood_off hy,sub_self]
        simp [hy,hz]
    rw [he, integral_iUnion hI hDis hx.integrableOn]
  have hpoint : ∀ᵐ x ∂volume.restrict Eallᶜ, ‖lineProfileConvolution K b x‖ₑ ≤ ∑' c, ‖A c x‖ₑ := by
    filter_upwards [ae_restrict_of_ae hsplit] with x hx
    rw [hx]
    exact enorm_tsum_le_tsum_enorm
  change (∫⁻ x in Eallᶜ, ‖lineProfileConvolution K b x‖ₑ) ≤ _
  refine (lintegral_mono_ae hpoint).trans ?_
  rw [lintegral_tsum (μ := volume.restrict Eallᶜ)
    (f := fun c x => ‖A c x‖ₑ) (fun c => (hAm c).enorm.aemeasurable)]
  calc
    _ ≤ ∑' c, ∫⁻ x in (E c)ᶜ, ‖A c x‖ₑ :=
      ENNReal.tsum_le_tsum fun c => lintegral_mono' (Measure.restrict_mono
        (compl_subset_compl.mpr (subset_iUnion E c)) le_rfl) le_rfl
    _ ≤ ∑' c, ENNReal.ofReal B * ∫⁻ y in I c, ‖b y‖ₑ := ENNReal.tsum_le_tsum hAtom
    _ = ENNReal.ofReal B * ∫⁻ y in D, ‖b y‖ₑ := by
      rw [ENNReal.tsum_mul_left]
      congr 1
      exact (lintegral_iUnion hI hDis (fun y => ‖b y‖ₑ)).symm
    _ ≤ _ := mul_le_mul_right (setLIntegral_le_lintegral _ _) _

private theorem lineProfileConvolution_add_ae {K f g : ℝ → ℂ}
    (hK : Integrable K) (hf : Integrable f) (hg : Integrable g) :
    lineProfileConvolution K (f+g) =ᵐ[volume]
      lineProfileConvolution K f + lineProfileConvolution K g := by
  filter_upwards [hf.ae_convolution_exists (ContinuousLinearMap.mul ℂ ℂ) hK,
    hg.ae_convolution_exists (ContinuousLinearMap.mul ℂ ℂ) hK] with x hx hy
  have hfx : Integrable (fun y => f y*K (x-y)) := hx
  have hgx : Integrable (fun y => g y*K (x-y)) := hy
  change lineProfileConvolution K (f+g) x = lineProfileConvolution K f x + lineProfileConvolution K g x
  simp_rw [lineProfileConvolution_right, Pi.add_apply, add_mul]
  exact integral_add hfx hgx

private theorem measure_strict_norm_le_moment {μ : Measure ℝ} {f : ℝ → ℂ}
    (hf : Measurable f) {s r : ℝ} (hs : 0 < s) (hr : 0 ≤ r) :
    μ {x | s < ‖f x‖} ≤ ((ENNReal.ofReal s)^r)⁻¹ * ∫⁻ x, ‖f x‖ₑ^r ∂μ := by
  let A := (ENNReal.ofReal s)^r
  have hA₀ : A ≠ 0 := (ENNReal.rpow_pos_of_nonneg (ENNReal.ofReal_pos.mpr hs) hr).ne'
  have hAt : A ≠ ∞ := (ENNReal.rpow_lt_top_of_nonneg hr ENNReal.ofReal_ne_top).ne
  have hsub : {x | s < ‖f x‖} ⊆ {x | A ≤ ‖f x‖ₑ^r} := by
    intro x hx
    change s < ‖f x‖ at hx
    change ENNReal.ofReal s ^ r ≤ ‖f x‖ₑ^r
    rw [← ofReal_norm]
    exact ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hx.le) hr
  have h := (mul_le_mul_right (measure_mono hsub) A).trans
    (mul_meas_ge_le_lintegral (μ := μ) (hf.enorm.pow_const r) A)
  calc
    _ = A⁻¹*(A*μ {x | s < ‖f x‖}) := by rw [← mul_assoc, ENNReal.inv_mul_cancel hA₀ hAt, one_mul]
    _ ≤ _ := mul_le_mul_right h _

private theorem norm_two_rpow_moment {f : ℝ → ℂ} (hf : AEStronglyMeasurable f volume) :
    (∫⁻ x, ‖f x‖ₑ^(2:ℝ)) = (eLpNorm f 2 volume)^2 := by
  simpa only [ENNReal.coe_ofNat, NNReal.coe_ofNat, ENNReal.rpow_two] using
    (eLpNorm_nnreal_pow_eq_lintegral (p := (2:NNReal)) (by norm_num) hf).symm

set_option maxHeartbeats 1200000 in
private theorem scalarCz_weak_one {K f : ℝ → ℂ}
    (hK : Integrable K) (hKm : Measurable K) (hReg : scalarKernelRegular K 1)
    (hFourier : ∀ ξ, ‖𝓕 K ξ‖ ≤ 1) (hf : Integrable f) (hm : Measurable f)
    {s : ℝ} (hs : 0 < s) :
    volume {x | s < ‖lineProfileConvolution K f x‖} ≤
      16*(ENNReal.ofReal s)⁻¹ * ∫⁻ y, ‖f y‖ₑ := by
  let D := ⋃ c : ScalarCzCells f s, scalarCzInterval c
  let E := ⋃ c : ScalarCzCells f s, scalarCzEnlarged c
  let g := scalarCzGood f s
  let b x := f x - g x
  let M := ∫⁻ y, ‖f y‖ₑ
  let T := lineProfileConvolution K
  let A := ENNReal.ofReal s
  let H := ENNReal.ofReal (s/2)
  have hs' : 0 < s/2 := by positivity
  have hV : MeasurableSet E := MeasurableSet.iUnion fun c => Metric.isClosed_closedBall.measurableSet
  have hE : volume E ≤ (4*A⁻¹)*M := by
    have hvol (c : ScalarCzCells f s) : volume (scalarCzEnlarged c) = 4 * volume (scalarCzInterval c) := by
      rw [scalarCzEnlarged, Real.volume_closedBall, scalarCzInterval_volume,
        show 2*(2*scalarCzLength c) = 4*scalarCzLength c by ring,
        ENNReal.ofReal_mul (by norm_num)]
      norm_num
    have hD : volume D ≤ A⁻¹*M := by
      unfold D scalarCzInterval
      rw [← dyadicMaxLevel_eq_union hf.norm hs]
      have h := volume_dyadicMaxLevel_le hf.norm hs
      have he (x : ℝ) : ‖‖f x‖‖ₑ = ‖f x‖ₑ := by simp [← ofReal_norm]
      simpa only [he] using h
    calc
      _ ≤ ∑' c, volume (scalarCzEnlarged c) := measure_iUnion_le _
      _ = 4*volume D := by
        simp_rw [hvol, ENNReal.tsum_mul_left]
        congr 1
        exact (measure_iUnion disjoint_dyadicMaximalCells
          (fun c => (measurableSet_Ico : MeasurableSet (scalarCzInterval c)))).symm
      _ ≤ _ := (mul_le_mul_right hD _).trans_eq (by ac_rfl)
  have hg := scalarCzGood_bounds hf hm hs
  dsimp only at hg
  have hgm : Measurable g := hg.1
  have hgi : Integrable g := hg.2.1
  have hg₂ : MemLp g 2 volume := hg.2.2.2.2
  have hbm : Measurable b := hm.sub hgm
  have hbi : Integrable b := hf.sub hgi
  have hTb := scalarCzBad_tail hK hKm zero_le_one hReg hf hm hs
  have hB : (∫⁻ x in Eᶜ, ‖T b x‖ₑ) ≤ 2*M := by
    have hb1 : (∫⁻ x, ‖b x‖ₑ) ≤ 2*M := by
      calc
        _ ≤ ∫⁻ x, ‖f x‖ₑ + ‖g x‖ₑ := lintegral_mono fun x => by
          change ‖f x-g x‖ₑ ≤ _
          simpa only [sub_eq_add_neg, enorm_neg] using enorm_add_le (f x) (-g x)
        _ = M + ∫⁻ x, ‖g x‖ₑ := lintegral_add_left hm.enorm _
        _ ≤ _ := (add_le_add le_rfl hg.2.2.1).trans_eq (by rw [two_mul])
    exact hTb.trans (by rw [ENNReal.ofReal_one, one_mul]; exact hb1)
  have hTg := lineProfileConvolution_L2 hK hKm zero_le_one hFourier hgi hgm hg₂
  have hG : (∫⁻ x, ‖T g x‖ₑ^(2:ℝ)) ≤ ENNReal.ofReal (2*s)*M := by
    have hr : (eLpNorm (T g) 2 volume)^2 ≤ (eLpNorm g 2 volume)^2 :=
      pow_le_pow_left' (by simpa only [ENNReal.ofReal_one, one_mul] using hTg.2) 2
    rw [← norm_two_rpow_moment hTg.1.aestronglyMeasurable, ← norm_two_rpow_moment hg₂.aestronglyMeasurable] at hr
    exact hr.trans hg.2.2.2.1
  let Lg := {x | s/2 < ‖T g x‖}
  let Lb := {x | s/2 < ‖T b x‖}
  have hGvol : volume Lg ≤ (8*A⁻¹)*M := by
    refine (measure_strict_norm_le_moment (lineProfileConvolution_measurable hKm hgm) hs'
      (by norm_num : (0:ℝ) ≤ 2)).trans ?_
    change (H^(2:ℝ))⁻¹ * (∫⁻ x, ‖T g x‖ₑ^ (2:ℝ)) ≤ _
    refine (mul_le_mul_right hG _).trans_eq ?_
    rw [← mul_assoc]
    congr 1
    dsimp [H,A]
    rw [ENNReal.ofReal_rpow_of_nonneg hs'.le (by norm_num : (0:ℝ) ≤ 2),
      ← ENNReal.ofReal_inv_of_pos (by positivity : 0 < (s/2)^(2:ℝ)),
      ← ENNReal.ofReal_mul (inv_nonneg.mpr (by positivity)),
      ← ENNReal.ofReal_inv_of_pos hs, show (8:ℝ≥0∞) = ENNReal.ofReal (8:ℝ) by norm_num,
      ← ENNReal.ofReal_mul (by norm_num : 0 ≤ (8:ℝ))]
    congr 1
    rw [Real.rpow_two]
    field_simp [hs.ne']
    <;> ring
  have hBvol : volume (Lb ∩ Eᶜ) ≤ (4*A⁻¹)*M := by
    rw [← Measure.restrict_apply (measurableSet_lt measurable_const
      (lineProfileConvolution_measurable hKm hbm).norm)]
    refine (measure_strict_norm_le_moment (μ := volume.restrict Eᶜ)
      (lineProfileConvolution_measurable hKm hbm) hs' (by norm_num : (0:ℝ) ≤ 1)).trans ?_
    simp only [ENNReal.rpow_one]
    refine (mul_le_mul_right hB _).trans_eq ?_
    rw [← mul_assoc]
    congr 1
    dsimp [H,A]
    rw [← ENNReal.ofReal_inv_of_pos hs', ← ENNReal.ofReal_inv_of_pos hs,
      show (2:ℝ≥0∞) = ENNReal.ofReal (2:ℝ) by norm_num,
      show (4:ℝ≥0∞) = ENNReal.ofReal (4:ℝ) by norm_num,
      ← ENNReal.ofReal_mul (inv_nonneg.mpr hs'.le), ← ENNReal.ofReal_mul (by norm_num : 0 ≤ (4:ℝ))]
    congr 1
    field_simp [hs.ne']
    <;> ring
  have hLinear : T f =ᵐ[volume] T g + T b := by
    have he : f = g+b := by funext x; dsimp [b]; ring
    conv_lhs => rw [he]
    exact lineProfileConvolution_add_ae hK hgi hbi
  have hCover : volume {x | s < ‖T f x‖} ≤ volume (E ∪ Lg ∪ (Lb ∩ Eᶜ)) := by
    apply measure_mono_ae
    filter_upwards [hLinear] with x hx hxt
    have hxt' : s < ‖T f x‖ := hxt
    by_cases h : x ∈ E
    · exact Or.inl (Or.inl h)
    by_cases h' : x ∈ Lg
    · exact Or.inl (Or.inr h')
    refine Or.inr ⟨?_,h⟩
    by_contra h''
    have hg' : ‖T g x‖ ≤ s/2 := le_of_not_gt h'
    have hb' : ‖T b x‖ ≤ s/2 := le_of_not_gt h''
    rw [show T f x = T g x + T b x from hx] at hxt'
    linarith [norm_add_le (T g x) (T b x)]
  refine hCover.trans ((measure_union_le _ _).trans ?_)
  apply ((add_le_add ((measure_union_le _ _).trans (add_le_add hE hGvol)) hBvol)).trans_eq
  rw [← add_mul, ← add_mul, ← add_mul, ← add_mul]
  congr 1
  norm_num [A]

private noncomputable def scalarCzLowerMomentConstant (p : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal p * (4 * ENNReal.ofReal (1/(2-p)+1/p) + 32 * ENNReal.ofReal (1/(p-1)))

open Auto.MarcinkiewiczInterpolation in
set_option maxHeartbeats 2500000 in
private theorem scalarCz_lower {K f : ℝ → ℂ}
    (hK : Integrable K) (hKm : Measurable K) (hReg : scalarKernelRegular K 1)
    (hFourier : ∀ ξ, ‖𝓕 K ξ‖ ≤ 1) (hf : Integrable f) (hm : Measurable f)
    {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) (hfp : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (lineProfileConvolution K f) (ENNReal.ofReal p) volume ≤
      (scalarCzLowerMomentConstant p)^p⁻¹ * eLpNorm f (ENNReal.ofReal p) volume := by
  let T := lineProfileConvolution K
  let h (f : ℝ → ℂ) (x : ℝ) := ‖T f x‖
  let D : Set (ℝ → ℂ) := {g | Measurable g ∧ Integrable g}
  let M := ∫⁻ x, ‖f x‖ₑ^p
  let J := M.toReal
  let L := truncLow f
  let H := truncHigh f
  have hp₀ : 0 < p := zero_lt_one.trans hp₁
  have hP₀ : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp₀
  have hMt : M ≠ ∞ := by
    intro htop
    have h := hfp.eLpNorm_lt_top
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hP₀ ENNReal.ofReal_ne_top hfp.aestronglyMeasurable,
      ENNReal.toReal_ofReal hp₀.le, show (∫⁻ x, ‖f x‖ₑ^p) = M from rfl, htop,
      ENNReal.top_rpow_of_pos (one_div_pos.mpr hp₀)] at h
    exact lt_irrefl _ h
  by_cases hMzero : M = 0
  · have hnorm : eLpNorm f (ENNReal.ofReal p) volume = 0 := by
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hP₀ ENNReal.ofReal_ne_top hfp.aestronglyMeasurable,
        ENNReal.toReal_ofReal hp₀.le, show (∫⁻ x, ‖f x‖ₑ^p) = M from rfl, hMzero,
        ENNReal.zero_rpow_of_pos (one_div_pos.mpr hp₀)]
    have hb := (lineProfileConvolution_young hp₁.le hKm hK hm hfp).2
    rw [hnorm,mul_zero] at hb ⊢
    exact hb
  have hJ₀ : 0 < J := ENNReal.toReal_pos hMzero hMt
  have hJ_eq : ENNReal.ofReal J = M := ENNReal.ofReal_toReal hMt
  have hJ : (∫⁻ x, (ENNReal.ofReal ‖f x‖)^p) ≤ ENNReal.ofReal J := by
    simp only [ofReal_norm, hJ_eq]
    exact le_rfl
  have hL (t : ℝ) : L t ∈ D :=
    ⟨(stronglyMeasurable_truncLow hm.stronglyMeasurable t).measurable,
      hf.indicator (measurableSet_lt hm.norm measurable_const)⟩
  have hH (t : ℝ) : H t ∈ D :=
    ⟨(stronglyMeasurable_truncHigh hm.stronglyMeasurable t).measurable,
      hf.indicator (measurableSet_le measurable_const hm.norm)⟩
  have hSub ⦃g j : ℝ → ℂ⦄ (hg : g ∈ D) (hj : j ∈ D) :
      ∀ᵐ x ∂volume, h (g+j) x ≤ h g x + h j x := by
    filter_upwards [lineProfileConvolution_add_ae hK hg.2 hj.2] with x hx
    change ‖T (g+j) x‖ ≤ ‖T g x‖ + ‖T j x‖
    rw [show T (g+j) x = T g x + T j x from hx]
    exact norm_add_le _ _
  have hWeak₁ (g : ℝ → ℂ) (hg : g ∈ D) {s : ℝ} (hs : 0 < s) :
      ENNReal.ofReal s * volume {x | s < h g x} ≤ 16*(∫⁻ x, ENNReal.ofReal ‖g x‖) := by
    have ha : ENNReal.ofReal s ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hs
    have hb := mul_le_mul_right (scalarCz_weak_one hK hKm hReg hFourier hg.2 hg.1 hs) (ENNReal.ofReal s)
    refine hb.trans_eq ?_
    simp only [ofReal_norm]
    calc
      _ = (ENNReal.ofReal s*(ENNReal.ofReal s)⁻¹)*(16*∫⁻ x, ‖g x‖ₑ) := by ac_rfl
      _ = _ := by rw [ENNReal.mul_inv_cancel ha ENNReal.ofReal_ne_top, one_mul]
  have hTwo (g : ℝ → ℂ) (hg : g ∈ D) :
      (∫⁻ x, ‖T g x‖ₑ^(2:ℝ)) ≤ ∫⁻ x, ‖g x‖ₑ^(2:ℝ) := by
    by_cases ht : (∫⁻ x, ‖g x‖ₑ^(2:ℝ)) = ∞
    · rw [ht]
      exact le_top
    have hgi : MemLp g 2 volume := by
      unfold MemLp
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num : (2:ℝ≥0∞) ≠ 0)
        ENNReal.ofNat_ne_top hg.1.aestronglyMeasurable, ENNReal.toReal_ofNat]
      exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) ht
    have h2 := lineProfileConvolution_L2 hK hKm zero_le_one hFourier hg.2 hg.1 hgi
    rw [norm_two_rpow_moment h2.1.aestronglyMeasurable, norm_two_rpow_moment hgi.aestronglyMeasurable]
    exact pow_le_pow_left' (by simpa only [ENNReal.ofReal_one,one_mul] using h2.2) _
  have hWeak₂ (g : ℝ → ℂ) (hg : g ∈ D) {s : ℝ} (hs : 0 < s) :
      ENNReal.ofReal (s^2) * volume {x | s < h g x} ≤
        1*(∫⁻ x, ENNReal.ofReal (‖g x‖^2)) := by
    have hS : (ENNReal.ofReal s)^2 ≠ 0 := by positivity
    have hSt : (ENNReal.ofReal s)^2 ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    have hCheb := measure_strict_norm_le_moment (μ := volume)
      (lineProfileConvolution_measurable hKm hg.1) hs (by norm_num : (0:ℝ) ≤ 2)
    have hB := mul_le_mul_right hCheb ((ENNReal.ofReal s)^2)
    simp only [ENNReal.rpow_two] at hB
    rw [← mul_assoc, ENNReal.mul_inv_cancel hS hSt, one_mul] at hB
    simp only [← ENNReal.ofReal_pow hs.le, ← ENNReal.ofReal_pow (norm_nonneg _), ← ofReal_norm,
      one_mul] at hB ⊢
    exact hB.trans (by simpa only [ENNReal.rpow_two, ← ofReal_norm,
      ← ENNReal.ofReal_pow (norm_nonneg _)] using hTwo g hg)
  have hLI (t : ℝ) : (∫⁻ x, ENNReal.ofReal (‖L t x‖^2)) =
      (eLpNorm (L t) 2 volume)^2 := by
    simpa only [ENNReal.rpow_two, ← ofReal_norm, ← ENNReal.ofReal_pow (norm_nonneg _)] using
      norm_two_rpow_moment (hL t).1.aestronglyMeasurable
  have hHI (t : ℝ) : (∫⁻ x, ENNReal.ofReal ‖H t x‖) =
      eLpNorm (H t) 1 volume := by
    simp only [ofReal_norm, eLpNorm_one_eq_lintegral_enorm (hH t).1.aestronglyMeasurable]
  have hLIm : Measurable (fun t => ∫⁻ x, ENNReal.ofReal (‖L t x‖^2)) := by
    simp_rw [hLI]
    exact (monotone_eLpNorm_truncLow (μ := volume) f 2).measurable.pow_const 2
  have hHIm : Measurable (fun t => ∫⁻ x, ENNReal.ofReal ‖H t x‖) := by
    simp_rw [hHI]
    exact (antitone_eLpNorm_truncHigh (μ := volume) f 1).measurable
  let A₂ := ENNReal.ofReal (1/(2-p)+1/p)*M
  let A₁ := ENNReal.ofReal (1/(p-1))*M
  have hTail₂ : (∫⁻ t in Ioi (0:ℝ), (∫⁻ x, ENNReal.ofReal (‖L t x‖^2)) *
      (ENNReal.ofReal t)^(p-3)) ≤ A₂ := by
    have h := lintegral_truncLow_tail_le (μ := volume) hm.stronglyMeasurable
      (p1 := 2) (q1 := 2) (q := p) (p := p) (m := 1) (c := 1) (J := J)
      hp₀ hp₂ le_rfl one_ne_zero zero_lt_one hJ₀ hJ (by ring)
    simp only [Real.rpow_one, one_mul, ENNReal.ofReal_ofNat, ENNReal.rpow_two,
      Real.one_rpow, div_self (by norm_num : (2:ℝ) ≠ 0), abs_one,
      show p-2-1 = p-3 by ring] at h
    simp_rw [hLI]
    refine h.trans_eq ?_
    dsimp only [A₂]
    rw [← hJ_eq, ← ENNReal.ofReal_mul (by positivity : 0 ≤ 1/(2-p)+1/p)]
    congr 1
