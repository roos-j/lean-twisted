private theorem profileCentered_locallyAbsolutelyContinuous (a : SchwartzMap ℝ ℂ)
    (l r : ℝ) : AbsolutelyContinuousOnInterval (fun y => a y-(∫ z, a z)*tentProfile y) l r := by
  let m : ℂ := ∫ z, a z
  have h : AbsolutelyContinuousOnInterval (fun y => m • tentProfile y) l r :=
    (tentProfile_locallyAbsolutelyContinuous l r).const_smul m
  change AbsolutelyContinuousOnInterval ((a : ℝ → ℂ) - (fun y => m • tentProfile y)) l r
  exact (schwartzProfile_locallyAbsolutelyContinuous a l r).sub h

private theorem profileCentered_integral (a : SchwartzMap ℝ ℂ) :
    (∫ y, a y-(∫ z, a z)*tentProfile y) = 0 := by
  rw [integral_sub a.integrable
    ((profile_integrable tentProfile_lipschitz.continuous tentProfile_size_finite).const_mul _),
    integral_const_mul, tentProfile_integral, mul_one, sub_self]

private theorem profileFourier_annulus_integral {c : ℝ} (hc : 0 < c)
    {ψ : SchwartzMap ℝ ℂ}
    (h : Function.support ((𝓕 ψ : SchwartzMap ℝ ℂ) : ℝ → ℂ) ⊆ {x | c ≤ |x|}) :
    (∫ y, ψ y) = 0 := by
  have h₀ : (𝓕 ψ : SchwartzMap ℝ ℂ) 0 = 0 := by
    by_contra hn
    have h' := h hn
    exact (not_le_of_gt hc) (by simpa using h')
  rw [SchwartzMap.fourier_coe, Real.fourier_eq] at h₀
  simpa using h₀

set_option maxHeartbeats 1850000 in
private theorem separatedCone_bounded {d : ℕ} (hd : 2 ≤ d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {c C : ℝ} (hc : 0 < c) (hcC : c < C) (b : Fin d) :
    ∃ K : ℝ≥0∞, K ≠ ∞ ∧ ∀ (a : Fin d → SchwartzMap ℝ ℂ),
      Function.support ((𝓕 (a b) : SchwartzMap ℝ ℂ) : ℝ → ℂ) ⊆ {z | c ≤ |z| ∧ |z| ≤ C} →
      ∀ (u : ℤ) (T : ℕ) (z : ℕ → ℂ), (∀ k, ‖z k‖ ≤ 1) →
      ∀ (f : Fin d → (Fin d → ℝ) → ℂ), (∀ i, Measurable (f i)) →
      (∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume) →
      (∀ i x, Integrable (fun y => f i (Function.update x i y))) →
      (∀ i, ∃ B : ℝ, 0 ≤ B ∧ ∀ x, ‖f i x‖ ≤ B) →
      eLpNorm (separatedProfileSum ((Finset.range T).image (fun k : ℕ => u+(k:ℤ)))
        (fun k => z (k-u).toNat) (fun i => a i) f) (ENNReal.ofReal r) volume ≤
      K * (∏ i, if i = b then profileSize (a i) + ENNReal.ofReal (profileFourierFourNorm (𝓕 (a i)))
        else profileSize (a i)) * ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  obtain ⟨K, hK, hTent⟩ := separatedTent_norm_bound hd hp hr hSum hc hcC b
  obtain ⟨D, hD, hPair⟩ := separatedProfileSum_two_cancellations hp hr hSum
  let J := ENNReal.ofReal (∫ y : ℝ, ((1+|y|)^4)⁻¹)
  let β := 1 + J * profileSize tentProfile
  have hβ : β ≠ ∞ := ENNReal.add_ne_top.mpr
    ⟨ENNReal.one_ne_top, ENNReal.mul_ne_top ENNReal.ofReal_ne_top tentProfile_size_finite⟩
  let P := K * (max 1 J)^d
  let R := D * β^d
  have hP : P ≠ ∞ := ENNReal.mul_ne_top hK
    (ENNReal.pow_ne_top (max_lt ENNReal.one_lt_top ENNReal.ofReal_lt_top).ne)
  have hR : R ≠ ∞ := ENNReal.mul_ne_top hD (ENNReal.pow_ne_top hβ)
  have hβ₁ : 1 ≤ β := le_add_of_nonneg_right zero_le
  refine ⟨P+(d:ℝ≥0∞)*R, ENNReal.add_ne_top.mpr
    ⟨hP, ENNReal.mul_ne_top (ENNReal.natCast_ne_top d) hR⟩, ?_⟩
  intro a ha u T z hz f hfm hf hfi hfb
  let Q (i : Fin d) := profileSize (a i)
  have hQ (i : Fin d) : Q i ≠ ∞ := schwartzProfile_size_finite (a i)
  let W (i : Fin d) := if i = b then Q i + ENNReal.ofReal (profileFourierFourNorm (𝓕 (a i))) else Q i
  let X := ∏ i, W i
  let Y := ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume
  let m (i : Fin d) := ∫ y, a i y
  have hm (i : Fin d) : ‖m i‖ₑ ≤ J*Q i := by
    have hh := ENNReal.ofReal_le_ofReal (profileIntegral_le (a i).continuous (hQ i))
    have hJ : 0 ≤ ∫ y : ℝ, ((1+|y|)^4)⁻¹ := integral_nonneg fun _ => by positivity
    rwa [ENNReal.ofReal_mul hJ, ofReal_norm, ENNReal.ofReal_toReal (hQ i)] at hh
  let a₀ (i : Fin d) : ℝ → ℂ := if i = b then a i else fun y => m i*tentProfile y
  let aJ (U : Finset (Fin d)) (i : Fin d) : ℝ → ℂ := if i ∈ U then a i else a₀ i
  let S := (Finset.range T).image (fun k : ℕ => u+(k:ℤ))
  let w (k : ℤ) := z (k-u).toNat
  have hw (k : ℤ) (_ : k ∈ S) : ‖w k‖ ≤ 1 := hz _
  let F (U : Finset (Fin d)) := separatedProfileSum S w (aJ U) f
  have hAC₀ (i : Fin d) (l r : ℝ) : AbsolutelyContinuousOnInterval (a₀ i) l r := by
    by_cases hi : i = b
    · simpa only [a₀, if_pos hi] using schwartzProfile_locallyAbsolutelyContinuous (a i) l r
    · rw [show a₀ i = m i • tentProfile from by
        funext y
        simp [a₀,hi, Pi.smul_apply,smul_eq_mul]]
      exact (tentProfile_locallyAbsolutelyContinuous l r).const_smul (m i)
  have hAC (U : Finset (Fin d)) (i : Fin d) (l r : ℝ) :
      AbsolutelyContinuousOnInterval (aJ U i) l r := by
    by_cases hi : i ∈ U
    · simpa only [aJ, if_pos hi] using schwartzProfile_locallyAbsolutelyContinuous (a i) l r
    · simpa only [aJ, if_neg hi] using hAC₀ i l r
  have hA₀ (i : Fin d) : profileSize (a₀ i) ≤ β*W i := by
    by_cases hi : i = b
    · simp only [a₀, W, if_pos hi]
      exact (le_add_of_nonneg_right zero_le).trans (le_mul_of_one_le_left zero_le hβ₁)
    · simp only [a₀, W, if_neg hi]
      have h₁ := profileSize_const_mul_le tentProfile_locallyAbsolutelyContinuous tentProfile_size_finite (m i)
      calc
        _ ≤ ‖m i‖ₑ * profileSize tentProfile := h₁
        _ ≤ (J*Q i)*profileSize tentProfile := mul_le_mul_left (hm i) _
        _ = (J*profileSize tentProfile)*Q i := by ac_rfl
        _ ≤ β*Q i := mul_le_mul_left (le_add_of_nonneg_left zero_le) _
  have hProfile (U : Finset (Fin d)) (i : Fin d) : profileSize (aJ U i) ≤ β*W i := by
    by_cases hi : i ∈ U
    · rw [show aJ U i = a i by simp [aJ,hi]]
      have he : Q i ≤ W i := by dsimp only [W]; split; exact le_add_of_nonneg_right zero_le; rfl
      exact he.trans (le_mul_of_one_le_left zero_le hβ₁)
    · simpa only [aJ, if_neg hi] using hA₀ i
  have hW (i : Fin d) : W i ≠ ∞ := by
    dsimp only [W]
    split
    · exact ENNReal.add_ne_top.mpr ⟨hQ i, ENNReal.ofReal_ne_top⟩
    · exact hQ i
  have hBase : eLpNorm (F ∅) (ENNReal.ofReal r) volume ≤ P*X*Y := by
    let T₀ (i : Fin d) : ℝ → ℂ := if i = b then a b else tentProfile
    let w₀ (i : Fin d) : ℂ := if i = b then 1 else m i
    let W₀ (i : Fin d) : ℝ≥0∞ := if i = b then 1 else Q i
    have he : aJ ∅ = fun i y => w₀ i*T₀ i y := by
      funext i y
      by_cases hi : i = b <;> simp [aJ,a₀,w₀,T₀,hi]
    have hW₀ (i : Fin d) : ‖w₀ i‖ₑ ≤ (max 1 J)*W₀ i := by
      by_cases hi : i = b
      · simpa only [w₀,W₀,if_pos hi,enorm_one,mul_one] using (le_max_left (1:ℝ≥0∞) J)
      · simp only [w₀,W₀,if_neg hi]
        exact (hm i).trans (mul_le_mul_left (le_max_right _ _) _)
    have hProd : ‖∏ i, w₀ i‖ₑ ≤ (max 1 J)^d * ∏ i, W₀ i := by
      rw [← ofReal_norm, norm_prod, ENNReal.ofReal_prod_of_nonneg (fun _ _ => norm_nonneg _)]
      simp only [ofReal_norm]
      exact (Finset.prod_le_prod fun i _ => hW₀ i).trans_eq (by
        rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin])
    have hφ : ENNReal.ofReal (profileFourierFourNorm (𝓕 (a b))) * (∏ i, W₀ i) ≤ X := by
      rw [← Finset.mul_prod_erase _ W₀ (Finset.mem_univ b), show W₀ b = 1 by simp [W₀], one_mul]
      dsimp only [X]
      rw [← Finset.mul_prod_erase _ W (Finset.mem_univ b)]
      have he' : ∏ i ∈ (Finset.univ : Finset (Fin d)).erase b, W₀ i =
          ∏ i ∈ (Finset.univ : Finset (Fin d)).erase b, W i := by
        apply Finset.prod_congr rfl
        intro i hi
        simp [W,W₀,(Finset.mem_erase.mp hi).1]
      rw [he']
      exact mul_le_mul_left (by simp [W]) _
    have h := hTent (a b) ha u T z hz f hfm hf hfi (hfb b)
    change eLpNorm (separatedProfileSum S w (aJ ∅) f) (ENNReal.ofReal r) volume ≤ _
    rw [he, separatedProfileSum_scale, eLpNorm_const_smul]
    refine (mul_le_mul' hProd h).trans ?_
    calc
      _ = P*(ENNReal.ofReal (profileFourierFourNorm (𝓕 (a b))) * ∏ i, W₀ i)*Y := by
        dsimp only [P,Y]
        ac_rfl
      _ ≤ _ := mul_le_mul_left (mul_le_mul_right hφ _) _
  have hBound (U : Finset (Fin d)) (hbU : b ∉ U) :
      eLpNorm (F U) (ENNReal.ofReal r) volume ≤ (P+(U.card:ℝ≥0∞)*R)*X*Y := by
    induction U using Finset.induction_on with
    | empty => simpa only [Finset.card_empty, Nat.cast_zero, zero_mul, add_zero] using hBase
    | @insert j U hj ih =>
      have hjb : j ≠ b := fun h => hbU (h ▸ Finset.mem_insert_self j U)
      have hb : b ∉ U := fun h => hbU (Finset.mem_insert_of_mem h)
      let A := aJ (insert j U)
      have haJ : A j = a j := by simp [A,aJ]
      have hPre : Function.update A j (a₀ j) = aJ U := by
        funext i
        by_cases hi : i = j
        · subst i
          simp [aJ,hj]
        · simp [Function.update_of_ne hi, A,aJ, Finset.mem_insert,hi]
      let B := Function.update A j (fun y => a j y-m j*tentProfile y)
      have hBa (i : Fin d) (l r : ℝ) : AbsolutelyContinuousOnInterval (B i) l r := by
        by_cases hi : i = j
        · subst i; simpa [B] using profileCentered_locallyAbsolutelyContinuous (a j) l r
        · simpa [B, Function.update_of_ne hi] using hAC (insert j U) i l r
      have hBQ (i : Fin d) : profileSize (B i) ≤ β*W i := by
        by_cases hi : i = j
        · subst i
          simp only [B, Function.update_self, W, if_neg hjb]
          refine (profileSize_sub_const_mul (schwartzProfile_locallyAbsolutelyContinuous (a j))
            tentProfile_locallyAbsolutelyContinuous (hQ j) tentProfile_size_finite (m j)).trans ?_
          calc
            _ ≤ Q j + (J*Q j)*profileSize tentProfile := add_le_add_right (mul_le_mul_left (hm j) _) _
            _ = β*Q j := by dsimp only [β]; rw [add_mul, one_mul]; ac_rfl
        · simpa only [B, Function.update_of_ne hi] using hProfile (insert j U) i
      have hBfin (i : Fin d) : profileSize (B i) ≠ ∞ :=
        ((hBQ i).trans_lt (ENNReal.mul_lt_top hβ.lt_top (hW i).lt_top)).ne
      have hB₀ : (∫ y, B b y) = 0 := by
        have he : B b = a b := by simp [B, Function.update_of_ne (Ne.symm hjb), A, aJ, a₀]
        rw [he]
        exact profileFourier_annulus_integral hc fun z hz => (ha hz).1
      have hB₁ : (∫ y, B j y) = 0 := by simpa only [B, Function.update_self] using profileCentered_integral (a j)
      have hE := (hPair b j hjb S w hw B hBa hBfin hB₀ hB₁ f hfm hf).2
      have heB : eLpNorm (separatedProfileSum S w B f) (ENNReal.ofReal r) volume ≤ R*X*Y := by
        have hh : (∏ i, profileSize (B i)) ≤ β^d * X := by
          exact (Finset.prod_le_prod (fun i _ => hBQ i)).trans_eq (by
            rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin])
        exact hE.trans ((mul_le_mul_left (mul_le_mul_right hh D) Y).trans_eq (by dsimp only [R]; ac_rfl))
      obtain ⟨M, hM, hfb'⟩ := hfb j
      have hAjI : Integrable (A j) := by rw [haJ]; exact (a j).integrable
      have hA₀I : Integrable (a₀ j) := profile_integrable
        (locallyAbsolutelyContinuous_continuous (hAC₀ j)) ((hA₀ j).trans_lt
          (ENNReal.mul_lt_top hβ.lt_top (hW j).lt_top)).ne
      have he := separatedProfileSum_replace_sub S w A f j hAjI hA₀I (hfm j) hM hfb'
      rw [hPre, show A j-a₀ j = (fun y => a j y-m j*tentProfile y) by
        funext y
        simp [haJ,a₀,hjb,Pi.sub_apply]] at he
      have he' : F (insert j U) = F U + separatedProfileSum S w B f := by
        exact ((sub_eq_iff_eq_add.mp (show F (insert j U)-F U = separatedProfileSum S w B f from he))).trans
          (add_comm _ _)
      rw [he']
      have h₁ : 1 ≤ ENNReal.ofReal r := by simpa using ENNReal.ofReal_le_ofReal hr.le
      refine (eLpNorm_add_le h₁).trans ?_
      refine (add_le_add (ih hb) heB).trans_eq ?_
      rw [Finset.card_insert_of_notMem hj, Nat.cast_add, Nat.cast_one]
      ring
  let U := (Finset.univ : Finset (Fin d)).erase b
  have hU : b ∉ U := Finset.notMem_erase b _
  have he : aJ U = fun i => (a i : ℝ → ℂ) := by
    funext i
    by_cases hi : i = b
    · simp [aJ,a₀,U,hi]
    · simp [aJ,U,hi]
  have hh := hBound U hU
  rw [show F U = separatedProfileSum S w (fun i => a i) f by simp [F,he]] at hh
  refine hh.trans ?_
  have hcard : (U.card : ℝ≥0∞) ≤ d := by
    exact_mod_cast (by simpa only [Fintype.card_fin] using Finset.card_le_univ U : U.card ≤ d)
  exact mul_le_mul_left (mul_le_mul_left (add_le_add_right (mul_le_mul_left hcard _) _) _) _

private theorem schwartzCoordinateFiber_integrable {d : ℕ} (i : Fin d)
    (f : SchwartzMap (Fin d → ℝ) ℂ) (x : Fin d → ℝ) :
    Integrable (fun y => f (Function.update x i y)) := by
  let M := (2:ℝ)^2 * (Finset.Iic ((2,0) : ℕ×ℕ)).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) f
  have hRad : Integrable (fun y : ℝ => ((1+|y|)^2)⁻¹) := by
    have hDim : (Module.finrank ℝ ℝ : ℝ) < 2 := by simp
    have hi := integrable_one_add_norm (E := ℝ) (μ := volume) hDim
    convert hi using 1
    funext y
    rw [Real.norm_eq_abs, show (-2:ℝ) = -(2:ℝ) from rfl, Real.rpow_neg (by positivity),
      show (2:ℝ) = ↑(2:ℕ) from rfl, Real.rpow_natCast]
  have hm : Measurable (fun y => f (Function.update x i y)) :=
    f.continuous.measurable.comp ((measurable_update' (a := i)).comp
      (measurable_const.prodMk measurable_id))
  apply (hRad.const_mul M).mono' hm.aestronglyMeasurable
  filter_upwards [] with y
  change ‖f (Function.update x i y)‖ ≤ M * ((1+|y|)^2)⁻¹
  rw [← div_eq_mul_inv]
  apply (le_div_iff₀ (by positivity)).mpr
  have hnorm : |y| ≤ ‖Function.update x i y‖ := by
    simpa only [Function.update_self, Real.norm_eq_abs] using norm_le_pi_norm (Function.update x i y) i
  rw [mul_comm]
  have hpow : (1+|y|)^2 ≤ (1+‖Function.update x i y‖)^2 :=
    pow_le_pow_left₀ (by positivity) (by linarith [hnorm]) _
  refine (mul_le_mul_of_nonneg_right
    hpow (norm_nonneg _)).trans ?_
  simpa only [norm_iteratedFDeriv_zero] using
    (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (2,0)) (k := 2) (n := 0)
      le_rfl le_rfl f (Function.update x i y))

set_option maxHeartbeats 700000 in
/-- The separated-profile estimate with an annular distinguished profile, on Schwartz inputs. -/
theorem separatedCone {d : ℕ} (hd : 2 ≤ d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {c C : ℝ} (hc : 0 < c) (hcC : c < C) :
    ∃ K : ℝ≥0∞, K ≠ ∞ ∧ ∀ (b : Fin d) (a : Fin d → SchwartzMap ℝ ℂ),
      Function.support ((𝓕 (a b) : SchwartzMap ℝ ℂ) : ℝ → ℂ) ⊆ {z | c ≤ |z| ∧ |z| ≤ C} →
      ∀ (u : ℤ) (T : ℕ) (z : ℕ → ℂ), (∀ k, ‖z k‖ ≤ 1) →
      ∀ f : Fin d → SchwartzMap (Fin d → ℝ) ℂ,
      eLpNorm (separatedProfileSum ((Finset.range T).image (fun k : ℕ => u+(k:ℤ)))
        (fun k => z (k-u).toNat) (fun i => a i) (fun i => f i)) (ENNReal.ofReal r) volume ≤
      K * (∏ i, if i = b then profileSize (a i) + ENNReal.ofReal (profileFourierFourNorm (𝓕 (a i)))
        else profileSize (a i)) * ∏ i, eLpNorm (f i : (Fin d → ℝ) → ℂ) (ENNReal.ofReal (p i)) volume := by
  choose K hK h using fun b => separatedCone_bounded hd hp hr hSum hc hcC b
  refine ⟨∑ b, K b, ENNReal.sum_ne_top.mpr (fun b _ => hK b), ?_⟩
  intro b a ha u T z hz f
  exact (h b a ha u T z hz (fun i => f i) (fun i => (f i).continuous.measurable)
    (fun i => (f i).memLp _ _) (fun i x => schwartzCoordinateFiber_integrable i (f i) x)
    (fun i => ⟨SchwartzMap.seminorm ℝ 0 0 (f i), apply_nonneg _ _,
      SchwartzMap.norm_le_seminorm ℝ (f i)⟩)).trans
      (mul_le_mul_left (mul_le_mul_left (Finset.single_le_sum (fun _ _ => zero_le)
        (Finset.mem_univ b)) _) _)

noncomputable def radialProfileCutoff {d : ℕ} (x : E d) : ℝ :=
  Real.smoothTransition ((4-‖x‖^2)/3)

noncomputable def dyadicAnnularCutoff {d : ℕ} (x : E d) : ℝ :=
  radialProfileCutoff x - radialProfileCutoff ((2:ℝ) • x)

private theorem radialProfileCutoff_one {d : ℕ} {x : E d} (hx : ‖x‖ ≤ 1) :
    radialProfileCutoff x = 1 := by
  apply Real.smoothTransition.one_of_one_le
  have h := pow_le_pow_left₀ (norm_nonneg x) hx 2
  linarith

private theorem radialProfileCutoff_zero {d : ℕ} {x : E d} (hx : 2 ≤ ‖x‖) :
    radialProfileCutoff x = 0 := by
  apply Real.smoothTransition.zero_of_nonpos
  have h := pow_le_pow_left₀ (by norm_num : (0:ℝ) ≤ 2) hx 2
  linarith

private theorem radialProfileCutoff_smooth {d : ℕ} :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (@radialProfileCutoff d) := by
  unfold radialProfileCutoff
  exact Real.smoothTransition.contDiff.comp
    ((contDiff_const.sub (contDiff_norm_sq ℝ)).div_const 3)

private theorem dyadicAnnularCutoff_smooth {d : ℕ} :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (@dyadicAnnularCutoff d) := by
  have he : ContDiff ℝ (↑(⊤ : ℕ∞)) (fun x : E d => (2:ℝ) • x) :=
    contDiff_const_smul 2
  exact radialProfileCutoff_smooth.sub (radialProfileCutoff_smooth.comp he)

private theorem dyadicAnnularCutoff_nonneg {d : ℕ} (x : E d) : 0 ≤ dyadicAnnularCutoff x := by
  unfold dyadicAnnularCutoff radialProfileCutoff
  apply sub_nonneg.mpr
  apply Real.smoothTransition.monotone
  rw [norm_smul, Real.norm_of_nonneg (by norm_num : (0:ℝ) ≤ 2)]
  nlinarith [sq_nonneg ‖x‖]

private theorem dyadicAnnularCutoff_eq_zero {d : ℕ} {x : E d}
    (hx : ‖x‖ ≤ 1/2 ∨ 2 ≤ ‖x‖) : dyadicAnnularCutoff x = 0 := by
  unfold dyadicAnnularCutoff
  have he : ‖(2:ℝ) • x‖ = 2*‖x‖ := by rw [norm_smul, Real.norm_of_nonneg (by norm_num)]
  rcases hx with hx | hx
  · rw [radialProfileCutoff_one (by linarith : ‖x‖ ≤ 1),
      radialProfileCutoff_one (by rw [he]; linarith), sub_self]
  · rw [radialProfileCutoff_zero hx, radialProfileCutoff_zero (by rw [he]; linarith), sub_self]

private theorem dyadicAnnularCutoff_compact {d : ℕ} :
    HasCompactSupport (@dyadicAnnularCutoff d) := by
  refine HasCompactSupport.intro' (isCompact_closedBall (0:E d) 2) Metric.isClosed_closedBall ?_
  intro z hz
  apply dyadicAnnularCutoff_eq_zero
  right
  have hh : ¬ ‖z‖ ≤ 2 := by simpa only [Metric.mem_closedBall, dist_zero_right] using hz
  exact (lt_of_not_ge hh).le

private theorem norm_dyadicFrequencyDilate {d : ℕ} (k : ℤ) (x : E d) :
    ‖((2:ℝ)^(-k)) • x‖ = (2:ℝ)^(-k)*‖x‖ := by
  rw [norm_smul, Real.norm_of_nonneg (by positivity)]

set_option maxHeartbeats 650000 in
private theorem dyadicAnnularCutoff_partition {d : ℕ} {x : E d} (hx : x ≠ 0) :
    ∑' k : ℤ, dyadicAnnularCutoff (((2:ℝ)^(-k)) • x) = 1 := by
  obtain ⟨m, hm⟩ := exists_mem_Ico_zpow (norm_pos_iff.mpr hx) (show (1:ℝ) < 2 by norm_num)
  have h₂ (k : ℤ) : (2:ℝ) * (2:ℝ)^(-k) = (2:ℝ)^(-(k-1)) := by
    rw [show -(k-1) = 1+(-k) by omega, zpow_add₀ (by norm_num : (2:ℝ) ≠ 0), zpow_one]
  have hσ (k : ℤ) : dyadicAnnularCutoff (((2:ℝ)^(-k)) • x) =
      radialProfileCutoff (((2:ℝ)^(-k)) • x) -
        radialProfileCutoff (((2:ℝ)^(-(k-1))) • x) := by
    rw [dyadicAnnularCutoff, smul_smul, h₂]
  have hLeft : 2 ≤ ‖((2:ℝ)^(-(m-1))) • x‖ := by
    rw [norm_dyadicFrequencyDilate, ← h₂]
    have hh := mul_le_mul_of_nonneg_left hm.1 (show 0 ≤ (2:ℝ)*(2:ℝ)^(-m) by positivity)
    rw [mul_assoc, ← zpow_add₀ (by norm_num : (2:ℝ) ≠ 0),
      neg_add_cancel, zpow_zero, mul_one] at hh
    exact hh
  have hRight : ‖((2:ℝ)^(-(m+1))) • x‖ ≤ 1 := by
    rw [norm_dyadicFrequencyDilate]
    have hh := mul_le_mul_of_nonneg_left hm.2.le (show 0 ≤ (2:ℝ)^(-(m+1)) by positivity)
    rw [← zpow_add₀ (by norm_num : (2:ℝ) ≠ 0), neg_add_cancel, zpow_zero] at hh
    exact hh
  rw [tsum_eq_sum (s := ({m,m+1} : Finset ℤ))]
  · rw [Finset.sum_insert (by simp), Finset.sum_singleton, hσ, hσ,
      show m+1-1 = m by omega, radialProfileCutoff_zero hLeft, radialProfileCutoff_one hRight]
    ring
  · intro k hk
    have hCases : k ≤ m-1 ∨ m+2 ≤ k := by simp at hk; omega
    apply dyadicAnnularCutoff_eq_zero
    rcases hCases with h | h
    · right
      refine hLeft.trans ?_
      simp only [norm_dyadicFrequencyDilate]
      exact mul_le_mul_of_nonneg_right (zpow_le_zpow_right₀ (by norm_num) (by omega)) (norm_nonneg x)
    · left
      have he : ‖((2:ℝ)^(-(m+2))) • x‖ ≤ 1/2 := by
        rw [norm_dyadicFrequencyDilate,
          show -(m+2) = -(m+1)+(-1) by omega, zpow_add₀ (by norm_num : (2:ℝ) ≠ 0),
          zpow_neg_one]
        rw [norm_dyadicFrequencyDilate] at hRight
        linarith only [hRight, show ((2:ℝ)^(-(m+1)) * (2:ℝ)⁻¹)*‖x‖ =
          ((2:ℝ)^(-(m+1))*‖x‖)/2 by ring]
      refine le_trans ?_ he
      simp only [norm_dyadicFrequencyDilate]
      exact mul_le_mul_of_nonneg_right (zpow_le_zpow_right₀ (by norm_num) (by omega)) (norm_nonneg x)

private noncomputable def angularProfileGate {d : ℕ} (b : Fin d) (x : E d) : ℝ :=
  Real.smoothTransition (4*(d:ℝ)*(x b)^2 / ‖x‖^2 - 1)

private noncomputable def conicalProfileCutoff {d : ℕ} (b : Fin d) (x : E d) : ℝ :=
  dyadicAnnularCutoff x * angularProfileGate b x / ∑ i, angularProfileGate i x

private theorem angularProfileGate_nonneg {d : ℕ} (b : Fin d) (x : E d) :
    0 ≤ angularProfileGate b x := Real.smoothTransition.nonneg _

private theorem angularProfileGate_sum_pos {d : ℕ} (hd : 0 < d) {x : E d} (hx : x ≠ 0) :
    0 < ∑ i, angularProfileGate i x := by
  have hX : 0 < ‖x‖^2 := pow_pos (norm_pos_iff.mpr hx) _
  have hd' : 0 < (d:ℝ) := Nat.cast_pos.mpr hd
  by_contra! h
  have hZ (i : Fin d) : (x i)^2 ≤ ‖x‖^2/(4*d) := by
    have h₁ := (Finset.single_le_sum (fun i _ => angularProfileGate_nonneg i x)
      (Finset.mem_univ i)).trans h
    have h₂ : angularProfileGate i x = 0 := le_antisymm h₁ (angularProfileGate_nonneg i x)
    have h₃ : 4*(d:ℝ)*(x i)^2 / ‖x‖^2 - 1 ≤ 0 :=
      Real.smoothTransition.zero_iff_nonpos.mp h₂
    have h₄ := (div_le_iff₀ hX).mp (sub_nonpos.mp h₃)
    apply (le_div_iff₀ (by positivity : 0 < 4*(d:ℝ))).mpr
    nlinarith
  have hSum : ‖x‖^2 ≤ (d:ℝ)*(‖x‖^2/(4*d)) := by
    conv_lhs => rw [EuclideanSpace.real_norm_sq_eq]
    exact (Finset.sum_le_sum (fun i _ => hZ i)).trans_eq (by
      rw [Finset.sum_const, nsmul_eq_mul, Finset.card_univ, Fintype.card_fin])
  have he : (d:ℝ)*(‖x‖^2/(4*d)) = ‖x‖^2/4 := by
    field_simp [hd'.ne']
  linarith

private theorem conicalProfileCutoff_nonneg {d : ℕ} (b : Fin d) (x : E d) :
    0 ≤ conicalProfileCutoff b x :=
  div_nonneg (mul_nonneg (dyadicAnnularCutoff_nonneg x) (angularProfileGate_nonneg b x))
    (Finset.sum_nonneg fun i _ => angularProfileGate_nonneg i x)

private theorem angularProfileGate_smoothAt {d : ℕ} (b : Fin d) {x : E d} (hx : x ≠ 0) :
    ContDiffAt ℝ (↑(⊤ : ℕ∞)) (angularProfileGate b) x := by
  have hs : ContDiff ℝ (↑(⊤ : ℕ∞)) (fun z : E d => 4*(d:ℝ)*(z b)^2) :=
    contDiff_const.mul ((EuclideanSpace.proj (𝕜 := ℝ) b).contDiff.pow 2)
  have hr : ContDiff ℝ (↑(⊤ : ℕ∞)) (fun z : E d => ‖z‖^2) := contDiff_norm_sq ℝ
  have hn : ‖x‖^2 ≠ 0 := pow_ne_zero _ (norm_pos_iff.mpr hx).ne'
  exact Real.smoothTransition.contDiffAt.comp x ((hs.contDiffAt.div hr.contDiffAt hn).sub contDiffAt_const)

private theorem conicalProfileCutoff_smooth {d : ℕ} (hd : 0 < d) (b : Fin d) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (conicalProfileCutoff b) := by
  apply contDiff_iff_contDiffAt.mpr
  intro x
  by_cases hx : x = 0
  · subst x
    apply (contDiffAt_const (c := (0:ℝ))).congr_of_eventuallyEq
    filter_upwards [Metric.ball_mem_nhds (0:E d) (by norm_num : (0:ℝ) < 1/2)] with y hy
    have h : ‖y‖ ≤ 1/2 := (by simpa only [Metric.mem_ball, dist_zero_right] using hy : ‖y‖ < 1/2).le
    simp [conicalProfileCutoff, dyadicAnnularCutoff_eq_zero (Or.inl h)]
  · have h := angularProfileGate_smoothAt b hx
    have hsum : ContDiffAt ℝ (↑(⊤ : ℕ∞)) (fun z : E d => ∑ i, angularProfileGate i z) x :=
      ContDiffAt.sum (s := Finset.univ) fun i _ => angularProfileGate_smoothAt i hx
    exact (dyadicAnnularCutoff_smooth.contDiffAt.mul h).div hsum
      (angularProfileGate_sum_pos hd hx).ne'

private theorem conicalProfileCutoff_sum {d : ℕ} (hd : 0 < d) (x : E d) :
    ∑ i, conicalProfileCutoff i x = dyadicAnnularCutoff x := by
  by_cases hx : x = 0
  · subst x
    have h := dyadicAnnularCutoff_eq_zero (d := d) (x := 0)
      (Or.inl (by simp : ‖(0:E d)‖ ≤ 1/2))
    simp [conicalProfileCutoff,h]
  · simp only [conicalProfileCutoff, ← Finset.sum_div, ← Finset.mul_sum]
    exact mul_div_cancel_right₀ _ (angularProfileGate_sum_pos hd hx).ne'

private theorem conicalProfileCutoff_support {d : ℕ} (hd : 0 < d) (b : Fin d) :
    tsupport (conicalProfileCutoff b) ⊆
      {x : E d | 1/2 ≤ ‖x‖ ∧ ‖x‖ ≤ 2 ∧ 1/(4*Real.sqrt d) ≤ |x b|} := by
  have hClosed : IsClosed {x : E d | 1/2 ≤ ‖x‖ ∧ ‖x‖ ≤ 2 ∧ 1/(4*Real.sqrt d) ≤ |x b|} :=
    (isClosed_le continuous_const continuous_norm).inter
      ((isClosed_le continuous_norm continuous_const).inter
        (isClosed_le continuous_const (EuclideanSpace.proj (𝕜 := ℝ) b).continuous.abs))
  apply closure_minimal _ hClosed
  intro x hx
  have h₁ : dyadicAnnularCutoff x ≠ 0 := fun h => hx (by simp [conicalProfileCutoff,h])
  have h₂ : angularProfileGate b x ≠ 0 := fun h => hx (by simp [conicalProfileCutoff,h])
  have hx₀ : 1/2 < ‖x‖ := lt_of_not_ge fun h => h₁ (dyadicAnnularCutoff_eq_zero (Or.inl h))
  have hx₂ : ‖x‖ < 2 := lt_of_not_ge fun h => h₁ (dyadicAnnularCutoff_eq_zero (Or.inr h))
  have hS : 0 < Real.sqrt d := Real.sqrt_pos.mpr (Nat.cast_pos.mpr hd)
  refine ⟨hx₀.le,hx₂.le,?_⟩
  have hg : 1 < 4*(d:ℝ)*(x b)^2/‖x‖^2 := by
    have h := lt_of_not_ge (mt Real.smoothTransition.zero_iff_nonpos.mpr h₂)
    linarith
  have hn : 0 < ‖x‖^2 := by positivity
  have he := (lt_div_iff₀ hn).mp hg
  apply (div_le_iff₀ (by positivity : 0 < 4*Real.sqrt d)).mpr
  have hs : Real.sqrt d ^ 2 = (d:ℝ) := Real.sq_sqrt (Nat.cast_nonneg d)
  have hAbs : |x b|^2 = (x b)^2 := sq_abs _
  by_contra! h
  have hsq := pow_le_pow_left₀ (by positivity : 0 ≤ |x b| * (4*Real.sqrt d)) h.le 2
  have hr := pow_le_pow_left₀ (by norm_num : (0:ℝ) ≤ 1/2) hx₀.le 2
  rw [mul_pow, mul_pow, hAbs, hs] at hsq
  nlinarith

private theorem conicalProfileCutoff_compact {d : ℕ} (hd : 0 < d) (b : Fin d) :
    HasCompactSupport (conicalProfileCutoff b) := by
  refine HasCompactSupport.intro' (isCompact_closedBall (0:E d) 2) Metric.isClosed_closedBall ?_
  intro x hx
  by_contra hn
  have h := conicalProfileCutoff_support hd b (subset_closure hn)
  exact hx (by simpa only [Metric.mem_closedBall, dist_zero_right] using h.2.1)

private noncomputable def outerCoordinateCutoff (x : ℝ) : ℝ :=
  Real.smoothTransition (((5/2:ℝ)^2-x^2)/((5/2:ℝ)^2-2^2))

private theorem outerCoordinateCutoff_one {x : ℝ} (hx : |x| ≤ 2) :
    outerCoordinateCutoff x = 1 := by
  apply Real.smoothTransition.one_of_one_le
  have h := pow_le_pow_left₀ (abs_nonneg x) hx 2
  rw [sq_abs] at h
  norm_num
  linarith

private theorem outerCoordinateCutoff_zero {x : ℝ} (hx : 5/2 ≤ |x|) :
    outerCoordinateCutoff x = 0 := by
  apply Real.smoothTransition.zero_of_nonpos
  have h := pow_le_pow_left₀ (by norm_num : (0:ℝ) ≤ 5/2) hx 2
  rw [sq_abs] at h
  norm_num
  linarith

private theorem outerCoordinateCutoff_smooth :
    ContDiff ℝ (↑(⊤ : ℕ∞)) outerCoordinateCutoff :=
  Real.smoothTransition.contDiff.comp (by
    change ContDiff ℝ _ (fun x : ℝ => (((5/2:ℝ)^2-x^2)/((5/2:ℝ)^2-2^2)))
    fun_prop)

private noncomputable def innerCoordinateCutoff (l h x : ℝ) : ℝ :=
  Real.smoothTransition ((x^2-l^2)/(h^2-l^2))

private theorem innerCoordinateCutoff_zero {l h x : ℝ} (hl : 0 ≤ l) (hlh : l < h)
    (hx : |x| ≤ l) : innerCoordinateCutoff l h x = 0 := by
  apply Real.smoothTransition.zero_of_nonpos
  have hc : 0 ≤ h^2-l^2 := sub_nonneg.mpr (pow_le_pow_left₀ hl hlh.le _)
  apply div_nonpos_of_nonpos_of_nonneg _ hc
  have h' := pow_le_pow_left₀ (abs_nonneg x) hx 2
  rwa [sq_abs, ← sub_nonpos] at h'

private theorem innerCoordinateCutoff_one {l h x : ℝ} (hl : 0 ≤ l) (hlh : l < h)
    (hx : h ≤ |x|) : innerCoordinateCutoff l h x = 1 := by
  apply Real.smoothTransition.one_of_one_le
  have hc : 0 < h^2-l^2 := sub_pos.mpr (pow_lt_pow_left₀ hlh hl (by decide))
  apply (le_div_iff₀ hc).mpr
  have h' := pow_le_pow_left₀ (hl.trans hlh.le) hx 2
  rw [sq_abs] at h'
  linarith

private theorem innerCoordinateCutoff_smooth (l h : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (innerCoordinateCutoff l h) :=
  Real.smoothTransition.contDiff.comp (by
    change ContDiff ℝ _ (fun x : ℝ => (x^2-l^2)/(h^2-l^2))
    fun_prop)

set_option maxHeartbeats 850000 in
/-- The conical partition and compatible one-dimensional frequency cutoffs. -/
theorem coneCutoffs {d : ℕ} (hd : 0 < d) :
    ∃ (θ : E d → ℝ) (θb : Fin d → E d → ℝ) (γ : Fin d → Fin d → ℝ → ℝ),
      ContDiff ℝ (↑(⊤ : ℕ∞)) θ ∧ HasCompactSupport θ ∧ (∀ x, 0 ≤ θ x) ∧
      (∀ x, θ x = ∑ b, θb b x) ∧
      (∀ x : E d, x ≠ 0 → ∑' k : ℤ, θ (((2:ℝ)^(-k)) • x) = 1) ∧
      (∀ b, ContDiff ℝ (↑(⊤ : ℕ∞)) (θb b) ∧ HasCompactSupport (θb b) ∧ (∀ x, 0 ≤ θb b x) ∧
        tsupport (θb b) ⊆
          {x : E d | 1/2 ≤ ‖x‖ ∧ ‖x‖ ≤ 2 ∧ 1/(4*Real.sqrt d) ≤ |x b|}) ∧
      (∀ b i, ContDiff ℝ (↑(⊤ : ℕ∞)) (γ b i) ∧ HasCompactSupport (γ b i) ∧
        tsupport (γ b i) ⊆ Ioo (-3:ℝ) 3) ∧
      (∀ b, tsupport (γ b b) ⊆ {x : ℝ | 1/(8*Real.sqrt d) ≤ |x| ∧ |x| ≤ 3}) ∧
      (∀ b x, x ∈ tsupport (θb b) → ∏ i, γ b i (x i) = 1) := by
  let l := 1/(8*Real.sqrt d)
  let h := 1/(4*Real.sqrt d)
  have hs : 0 < Real.sqrt d := Real.sqrt_pos.mpr (Nat.cast_pos.mpr hd)
  have hl : 0 ≤ l := by dsimp [l]; positivity
  have hlh : l < h := by
    dsimp only [l,h]
    apply one_div_lt_one_div_of_lt (by positivity)
    linarith
  let γ (b i : Fin d) (x : ℝ) :=
    outerCoordinateCutoff x * if i = b then innerCoordinateCutoff l h x else 1
  have hγ (b i : Fin d) : tsupport (γ b i) ⊆ Icc (-(5/2:ℝ)) (5/2) := by
    apply closure_minimal _ isClosed_Icc
    intro x hx
    have h' : |x| ≤ 5/2 := by
      by_contra! h'
      exact hx (by simp [γ,outerCoordinateCutoff_zero h'.le])
    exact abs_le.mp h'
  refine ⟨dyadicAnnularCutoff, conicalProfileCutoff, γ, dyadicAnnularCutoff_smooth,
    dyadicAnnularCutoff_compact, dyadicAnnularCutoff_nonneg,
    fun x => (conicalProfileCutoff_sum hd x).symm, fun _ => dyadicAnnularCutoff_partition, ?_, ?_, ?_, ?_⟩
  · exact fun b => ⟨conicalProfileCutoff_smooth hd b, conicalProfileCutoff_compact hd b,
      conicalProfileCutoff_nonneg b, conicalProfileCutoff_support hd b⟩
  · intro b i
    have hC : HasCompactSupport (γ b i) :=
      isCompact_Icc.of_isClosed_subset isClosed_closure (hγ b i)
    refine ⟨?_, hC, ?_⟩
    · by_cases hi : i = b
      · simpa only [γ, if_pos hi] using outerCoordinateCutoff_smooth.mul (innerCoordinateCutoff_smooth l h)
      · simpa only [γ, if_neg hi, mul_one] using outerCoordinateCutoff_smooth
    · intro x hx
      have hh := hγ b i hx
      exact ⟨by linarith [hh.1], by linarith [hh.2]⟩
  · intro b
    apply closure_minimal _
      ((isClosed_le continuous_const continuous_abs).inter (isClosed_le continuous_abs continuous_const))
    intro x hx
    have hh : l ≤ |x| := by
      by_contra! hh
      exact hx (by simp [γ, innerCoordinateCutoff_zero hl hlh hh.le])
    have hOuter := hγ b b (subset_closure hx)
    have hAbs : |x| ≤ 5/2 := abs_le.mpr hOuter
    exact ⟨hh,hAbs.trans (by norm_num)⟩
  · intro b x hx
    have hCone := conicalProfileCutoff_support hd b hx
    apply Finset.prod_eq_one
    intro i _
    have hUpper : |x i| ≤ 2 := (by
      simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le x i : |x i| ≤ ‖x‖).trans hCone.2.1
    by_cases hi : i = b
    · subst i
      simp [γ, outerCoordinateCutoff_one hUpper, innerCoordinateCutoff_one hl hlh hCone.2.2]
    · simp [γ,hi,outerCoordinateCutoff_one hUpper]

/-- A conical symbol rescaled to the fixed frequency annulus. -/
noncomputable def normalizedConicalSymbol {d : ℕ}
    (θ : E d → ℝ) (m : E d → ℂ) (k : ℤ) (x : E d) : ℂ :=
  (θ x : ℂ) * m (((2:ℝ)^k) • x)

set_option maxHeartbeats 850000 in
private theorem normalizedConicalSymbol_control {d N : ℕ} {θ : E d → ℝ}
    (hθ : ContDiff ℝ (↑(⊤ : ℕ∞)) θ) (hθc : HasCompactSupport θ)
    (hθs : tsupport θ ⊆ {x : E d | 1/2 ≤ ‖x‖ ∧ ‖x‖ ≤ 2}) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ {m : E d → ℂ} {A : ℝ},
      0 ≤ A → Auto.MikhlinHormander.MikhlinCondition N m A → ∀ k : ℤ,
      let F := normalizedConicalSymbol θ m k
      ContDiff ℝ N F ∧ HasCompactSupport F ∧
      (∀ j ≤ N, ∀ x, ‖iteratedFDeriv ℝ j F x‖ ≤ K*A) ∧
      tsupport F ⊆ tsupport θ := by
  let χ : SchwartzMap (E d) ℂ :=
    (hθc.comp_left Complex.ofReal_zero).toSchwartzMap (Complex.ofRealCLM.contDiff.comp hθ)
  let C := Auto.MikhlinHormander.schwartzWeightedCutoffDerivativeConstant (N := N) χ
  have hC : 0 ≤ C := Finset.sum_nonneg fun _ _ => apply_nonneg _ _
  refine ⟨C*(4:ℝ)^N, by positivity, ?_⟩
  intro m A hA hm k
  let s : ℝ := (2:ℝ)^k
  have hs : 0 < s := by dsimp [s]; positivity
  let H (y : E d) := χ (s⁻¹ • y)*m y
  let F := normalizedConicalSymbol θ m k
  have hF : F = fun x => H (s • x) := by
    funext x
    change (θ x : ℂ) * m (s • x) = χ (s⁻¹ • (s • x)) * m (s • x)
    rw [smul_smul, inv_mul_cancel₀ hs.ne', one_smul]
    rfl
  have hχc : HasCompactSupport (χ : E d → ℂ) := hθc.comp_left Complex.ofReal_zero
  have hχs : HasCompactSupport (fun y : E d => χ (s⁻¹ • y)) :=
    hχc.comp_smul (inv_ne_zero hs.ne')
  have hsupp : tsupport F ⊆ tsupport θ := by
    apply closure_mono
    intro x hx
    by_contra! hz
    have he : θ x = 0 := Function.notMem_support.mp hz
    exact hx (by simp [F,normalizedConicalSymbol,he])
  have hH : ContDiff ℝ N H := by
    refine (Auto.MikhlinHormander.contDiff_hasCompactSupport_cutoff_mul_punctured
      (fun y : E d => χ (s⁻¹ • y)) m (s/2) (by positivity)
      ((χ.smooth (N:ℕ∞)).comp (contDiff_const_smul _)) hχs ?_ hm.1).1
    intro x hx
    have hh : ‖x‖ < s/2 := by simpa only [Metric.mem_ball, dist_zero_right] using hx
    have hnorm : ‖s⁻¹ • x‖ < 1/2 := by
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hs.le), ← div_eq_inv_mul, div_lt_iff₀ hs]
      simpa only [div_eq_mul_inv,mul_comm,one_mul] using hh
    change (θ (s⁻¹ • x) : ℂ) = 0
    congr 1
    by_contra h
    exact (not_le_of_gt hnorm) (hθs (subset_closure h)).1
  change ContDiff ℝ N F ∧ HasCompactSupport F ∧ _ ∧ _
  refine ⟨hF ▸ hH.comp (contDiff_const_smul s), hθc.of_isClosed_subset isClosed_closure hsupp, ?_, hsupp⟩
  intro j hj x
  by_cases hx : iteratedFDeriv ℝ j F x = 0
  · change ‖iteratedFDeriv ℝ j F x‖ ≤ _
    rw [hx,norm_zero]
    positivity
  have hxA := hθs (hsupp (support_iteratedFDeriv_subset j hx))
  have hx₀ : x ≠ 0 := by
    intro he
    have hh := hxA.1
    rw [he,norm_zero] at hh
    norm_num at hh
  have hW := Auto.MikhlinHormander.norm_iteratedFDeriv_dilated_schwartz_cutoff_mul_mikhlin_le
    χ m hm hA s⁻¹ (smul_ne_zero hs.ne' hx₀) hj
  have hChain : iteratedFDeriv ℝ j F x =
      s^j • iteratedFDeriv ℝ j H (s • x) := by
    rw [hF]
    exact congrFun (iteratedFDeriv_comp_const_smul s (hH.of_le (by exact_mod_cast hj))) x
  have hWeighted : ‖x‖^j * ‖iteratedFDeriv ℝ j F x‖ ≤ A*C*(2:ℝ)^j := by
    rw [hChain,norm_smul,Real.norm_of_nonneg (pow_nonneg hs.le _)]
    rw [norm_smul,Real.norm_of_nonneg hs.le, mul_pow] at hW
    exact (show ‖x‖^j * (s^j * ‖iteratedFDeriv ℝ j H (s • x)‖) ≤ _ by
      rw [← mul_assoc, mul_comm (‖x‖^j)]
      exact hW)
  have hNorm : (1/2:ℝ)^j ≤ ‖x‖^j := pow_le_pow_left₀ (by norm_num) hxA.1 _
  have hh := (mul_le_mul_of_nonneg_right hNorm (norm_nonneg _)).trans hWeighted
  have hpos : 0 < (1/2:ℝ)^j := by positivity
  have hk : ‖iteratedFDeriv ℝ j F x‖ ≤ (A*C*(2:ℝ)^j) / (1/2:ℝ)^j :=
    (le_div_iff₀ hpos).mpr (by convert hh using 1 <;> ring)
  have he : (A*C*(2:ℝ)^j) / (1/2:ℝ)^j = C*(4:ℝ)^j*A := by
    rw [mul_div_assoc, ← div_pow]
    norm_num
    ring
  rw [he] at hk
  exact hk.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left
    (pow_le_pow_right₀ (by norm_num) hj) hC) hA)

set_option maxHeartbeats 850000 in
private theorem compactSymbol_fourier_decay {d N : ℕ} {f : E d → ℂ}
    (hf : ContDiff ℝ N f) (hF : tsupport f ⊆ Metric.closedBall 0 1)
    {B : ℝ} (hB : 0 ≤ B) (hDer : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n f x‖ ≤ B) :
    ∀ x, ‖𝓕 f x‖ ≤
      ((2:ℝ)^N * ((2:ℝ)^N * (N+1) * (volume : Measure (E d)).real (Metric.closedBall 0 1))) *
        B/ (1+‖x‖)^N := by
  let S := Metric.closedBall (0:E d) 1
  let V := (volume : Measure (E d)).real S
  have hS : MeasurableSet S := Metric.isClosed_closedBall.measurableSet
  have hK : HasCompactSupport f :=
    (isCompact_closedBall (0:E d) 1).of_isClosed_subset isClosed_closure hF
  have hV : 0 ≤ V := ENNReal.toReal_nonneg
  have hInt (n : ℕ) (hn : n ≤ N) : Integrable (iteratedFDeriv ℝ n f) :=
    (hf.continuous_iteratedFDeriv (by exact_mod_cast hn)).integrable_of_hasCompactSupport
      (hK.iteratedFDeriv n)
  have hL1 (n : ℕ) (hn : n ≤ N) :
      (∫ x, ‖iteratedFDeriv ℝ n f x‖) ≤ V*B := by
    have hConst : Integrable ((S.indicator fun _ => B)) := by
      rw [integrable_indicator_iff hS]
      let : IsFiniteMeasure (volume.restrict S) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact (isCompact_closedBall (0:E d) 1).measure_lt_top⟩
      exact integrable_const B
    refine (integral_mono (hInt n hn).norm hConst fun x => ?_).trans_eq ?_
    · by_cases hx : x ∈ S
      · simpa only [Set.indicator_of_mem hx] using hDer n hn x
      · have h₀ : iteratedFDeriv ℝ n f x = 0 := by
          by_contra h
          exact hx (hF (support_iteratedFDeriv_subset n h))
        rw [Set.indicator_of_notMem hx, h₀, norm_zero]
    · rw [integral_indicator hS, setIntegral_const, smul_eq_mul]
  have hfI : Integrable f := hf.continuous.integrable_of_hasCompactSupport hK
  have h0 (x : E d) : ‖𝓕 f x‖ ≤ V*B :=
    (VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _).trans (by
      simpa only [norm_iteratedFDeriv_zero] using hL1 0 (Nat.zero_le N))
  have hN (x : E d) : ‖x‖^N * ‖𝓕 f x‖ ≤ (2:ℝ)^N*(N+1)*(V*B) := by
    have hIntegrable (k n : ℕ) (hk : k ≤ (0:ℕ∞)) (hn : n ≤ (N:ℕ∞)) :
        Integrable (fun x : E d => ‖x‖^k * ‖iteratedFDeriv ℝ n f x‖) := by
      have hk₀ : k = 0 := Nat.le_zero.mp (by exact_mod_cast hk)
      subst k
      simpa only [pow_zero,one_mul] using (hInt n (by exact_mod_cast hn)).norm
    have h := Real.pow_mul_norm_iteratedFDeriv_fourier_le (K := 0) (N := (N:ℕ∞))
      (f := f) hf hIntegrable (k := 0) (n := N) (by simp) le_rfl x
    simp only [norm_iteratedFDeriv_zero, pow_zero, one_mul, Nat.cast_zero, zero_mul, zero_add] at h
    have hSum : (∑ b ∈ Finset.range 1 ×ˢ Finset.range (N+1),
        ∫ y : E d, ‖y‖^b.1 * ‖iteratedFDeriv ℝ b.2 f y‖) ≤ (N+1)*(V*B) := by
      calc
        _ ≤ ∑ b ∈ Finset.range 1 ×ˢ Finset.range (N+1), V*B := by
          apply Finset.sum_le_sum
          intro b hb
          have h₁ := Finset.mem_range.mp (Finset.mem_product.mp hb).1
          have h₂ := Finset.mem_range.mp (Finset.mem_product.mp hb).2
          have he : b.1 = 0 := by omega
          simpa only [he,pow_zero,one_mul] using hL1 b.2 (by omega)
        _ = _ := by
          rw [Finset.sum_const, nsmul_eq_mul, Finset.card_product, Finset.card_range,
            Finset.card_range, one_mul, Nat.cast_add, Nat.cast_one]
    simp only [mul_zero, zero_add] at h
    exact h.trans ((mul_le_mul_of_nonneg_left hSum (show 0 ≤ (2:ℝ)^N by positivity)).trans_eq
      (mul_assoc _ _ _).symm)
  intro x
  apply (le_div_iff₀ (by positivity)).mpr
  have hC : (1:ℝ) ≤ (2:ℝ)^N*(N+1) := by
    exact one_le_mul_of_one_le_of_one_le (one_le_pow₀ (by norm_num)) (by linarith [show (0:ℝ) ≤ N by positivity])
  rw [mul_comm ‖𝓕 f x‖]
  by_cases hx : ‖x‖ ≤ 1
  · have hp : (1+‖x‖)^N ≤ (2:ℝ)^N := pow_le_pow_left₀ (by positivity) (by linarith) _
    refine (mul_le_mul hp (h0 x) (norm_nonneg _) (by positivity)).trans ?_
    calc
      _ ≤ ((2:ℝ)^N * ((2:ℝ)^N*(N+1)))*(V*B) :=
        mul_le_mul_of_nonneg_right (le_mul_of_one_le_right (by positivity) hC) (by positivity)
      _ = _ := by dsimp only [V,S]; ring
  · have hp : (1+‖x‖)^N ≤ ((2:ℝ)*‖x‖)^N :=
      pow_le_pow_left₀ (by positivity) (by linarith) _
    refine (mul_le_mul_of_nonneg_right hp (norm_nonneg _)).trans ?_
    rw [mul_pow,mul_assoc]
    exact (mul_le_mul_of_nonneg_left (hN x) (by positivity)).trans_eq (by dsimp only [V,S]; ring)

/-- The integer frequency vector viewed in Euclidean space. -/
def integerFrequency {d : ℕ} (n : Fin d → ℤ) : E d :=
  WithLp.toLp 2 (fun i => (n i:ℝ))

set_option maxHeartbeats 550000 in
private theorem summable_integerFrequency_weight {d s : ℕ} (hs : d < s) :
    Summable (fun n : Fin d → ℤ => ((1+‖integerFrequency n‖)^s)⁻¹) := by
  let b := PiLp.basisFun 2 ℝ (Fin d)
  let L := Submodule.span ℤ (Set.range b)
  letI : DiscreteTopology L := inferInstanceAs (DiscreteTopology (Submodule.span ℤ (Set.range b)))
  letI : IsZLattice ℝ L := inferInstanceAs (IsZLattice ℝ (Submodule.span ℤ (Set.range b)))
  have hDim : Module.finrank ℤ L = d := by rw [ZLattice.rank ℝ]; exact finrank_euclideanSpace_fin
  have hMem (n : Fin d → ℤ) : integerFrequency n ∈ L := by
    apply (b.mem_span_iff_repr_mem ℤ _).mpr
    intro i
    exact ⟨n i, by simp [b, integerFrequency, PiLp.basisFun_repr]⟩
  have hCoord (z : L) (i : Fin d) : ∃ n : ℤ, (n:ℝ) = (z:E d) i := by
    have h := (b.mem_span_iff_repr_mem ℤ _).mp z.property i
    simpa [b,PiLp.basisFun_repr, Set.mem_range] using h
  let e : (Fin d → ℤ) ≃ L :=
    { toFun := fun n => ⟨integerFrequency n, hMem n⟩
      invFun := fun z i => ⌊(z:E d) i⌋
      left_inv := fun n => by funext i; simp [integerFrequency]
      right_inv := fun z => by
        apply Subtype.ext
        ext i
        obtain ⟨m, hm⟩ := hCoord z i
        change (↑⌊(z:E d) i⌋ : ℝ) = (z:E d) i
        rw [← hm, Int.floor_intCast] }
  have hB : Summable (fun z : L => ‖z‖⁻¹ ^ s) :=
    ZLattice.summable_norm_pow_inv L s (by simpa only [hDim] using hs)
  have hδ : Summable (fun z : L => if z = 0 then (1:ℝ) else 0) := by
    apply summable_of_hasFiniteSupport
    exact (Set.finite_singleton (0:L)).subset fun z hz => by simpa [Function.mem_support] using hz
  have hW : Summable (fun z : L => ((1+‖z‖)^s)⁻¹) := by
    apply (hδ.add hB).of_nonneg_of_le (fun _ => by positivity)
    intro z
    by_cases hz : z = 0
    · simp [hz]
    · rw [if_neg hz, zero_add]
      calc
        _ ≤ (‖z‖^s)⁻¹ := inv_anti₀ (pow_pos (norm_pos_iff.mpr hz) _)
          (pow_le_pow_left₀ (norm_nonneg _) (by linarith) _)
        _ = _ := (inv_pow _ _).symm
  exact e.summable_iff.mpr hW

section FourierModes

noncomputable local instance : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩
local instance : IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (IsProbabilityMeasure AddCircle.haarAddCircle)

private noncomputable def profileMode (n : ℤ) (z : ℝ) : ℂ :=
  Complex.exp ((↑(2*Real.pi*((n:ℝ)*z/8)) : ℂ) * Complex.I)

private theorem profileMode_norm (n : ℤ) (z : ℝ) : ‖profileMode n z‖ = 1 :=
  Complex.norm_exp_ofReal_mul_I _

private theorem torusMode_apply {d : ℕ} (n : Fin d → ℤ) (z : Fin d → ℝ) :
    UnitAddTorus.mFourier n (fun i => ((z i/8 : ℝ) : UnitAddCircle)) =
      ∏ i, profileMode (n i) (z i) := by
  simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk]
  apply Finset.prod_congr rfl
  intro i _
  rw [fourier_coe_apply]
  congr 2
  push_cast
  ring

set_option maxHeartbeats 500000 in
private theorem torusFourier_series_ae {d : ℕ} {F : UnitAddTorus (Fin d) → ℂ}
    (hF : MemLp F 2 volume) (hC : Summable (fun n => ‖UnitAddTorus.mFourierCoeff F n‖)) :
    (fun x => ∑' n : Fin d → ℤ,
      UnitAddTorus.mFourierCoeff F n * UnitAddTorus.mFourier n x) =ᵐ[volume] F := by
  let W := UnitAddTorus (Fin d)
  let a := UnitAddTorus.mFourierCoeff F
  let B (n : Fin d → ℤ) : C(W,ℂ) := (a n) • UnitAddTorus.mFourier n
  have hSum : Summable B := by
    apply Summable.of_norm
    convert hC using 1
    funext n
    change ‖a n • UnitAddTorus.mFourier n‖ = ‖a n‖
    rw [norm_smul, UnitAddTorus.mFourier_norm, mul_one]
  let g : C(W,ℂ) := ∑' n : Fin d → ℤ, B n
  let Φ := ContinuousMap.toLp (E := ℂ) 2 (volume : Measure W) ℂ
  let f := hF.toLp F
  have hCoeff (n : Fin d → ℤ) : UnitAddTorus.mFourierCoeff f n = a n := by
    unfold UnitAddTorus.mFourierCoeff
    apply integral_congr_ae
    filter_upwards [hF.coeFn_toLp] with x hx
    rw [hx]
  have h₁ : HasSum (fun n => a n • UnitAddTorus.mFourierLp 2 n) (Φ g) := by
    simpa only [Φ, B, map_smul, UnitAddTorus.mFourierLp] using Φ.hasSum hSum.hasSum
  have h₂ : HasSum (fun n => a n • UnitAddTorus.mFourierLp 2 n) f := by
    simpa only [hCoeff] using UnitAddTorus.hasSum_mFourier_series_L2 f
  have hfg : Φ g = f := h₁.unique h₂
  have he : (g : W → ℂ) =ᵐ[volume] F :=
    (ContinuousMap.coeFn_toLp volume g).symm.trans
      ((congrArg (fun v : Lp ℂ 2 (volume : Measure W) => (v : W → ℂ)) hfg).eventuallyEq.trans
        hF.coeFn_toLp)
  filter_upwards [he] with x hx
  have hEval := (ContinuousMap.evalCLM ℂ x).hasSum hSum.hasSum
  have hw : (∑' n : Fin d → ℤ, a n*UnitAddTorus.mFourier n x) = g x := by
    simpa only [ContinuousMap.evalCLM_apply, B, ContinuousMap.smul_apply, smul_eq_mul] using hEval.tsum_eq
  exact hw.trans hx

private def frequencyUnitCube (d : ℕ) : Set (Fin d → ℝ) :=
  {x | ∀ i, x i ∈ Ioc (-(1/2:ℝ)) (-(1/2:ℝ)+1)}

private theorem frequencyUnitCube_measurable (d : ℕ) : MeasurableSet (frequencyUnitCube d) := by
  rw [show frequencyUnitCube d = ⋂ i : Fin d, (fun z : Fin d → ℝ => z i) ⁻¹'
    Ioc (-(1/2:ℝ)) (-(1/2:ℝ)+1) by ext z; simp [frequencyUnitCube]]
  exact MeasurableSet.iInter fun i : Fin d => (measurable_pi_apply (X := fun _ : Fin d => ℝ) i)
    (measurableSet_Ioc (a := -(1/2:ℝ)) (b := -(1/2:ℝ)+1))

private noncomputable def torusRepresentative {d : ℕ} :
    UnitAddTorus (Fin d) ≃ᵐ frequencyUnitCube d :=
  UnitAddTorus.measurableEquivPiIoc (fun _ : Fin d => -(1/2:ℝ))

private theorem torusRepresentative_symm_apply {d : ℕ} (x : frequencyUnitCube d) :
    (@torusRepresentative d).symm x = fun i => (x.1 i : UnitAddCircle) := rfl

private theorem torusRepresentative_preserving (d : ℕ) :
    MeasurePreserving (@torusRepresentative d) volume
      (Measure.comap (Subtype.val : frequencyUnitCube d → (Fin d → ℝ)) volume) :=
  UnitAddTorus.measurePreserving_equivPiIoc _

private theorem integerFrequency_fourierMonomial {d : ℕ} (n : Fin d → ℤ) (z : Fin d → ℝ) :
    UnitAddTorus.mFourier (-n) (fun i => (z i : UnitAddCircle)) =
      Complex.exp ((↑(-2*Real.pi*inner ℝ (WithLp.toLp 2 z) (integerFrequency n)) : ℂ)*Complex.I) := by
  unfold UnitAddTorus.mFourier
  simp_rw [ContinuousMap.coe_mk, fourier_coe_apply, Pi.neg_apply, Int.cast_neg]
  rw [← Complex.exp_sum]
  congr 1
  rw [PiLp.inner_apply]
  simp only [RCLike.inner_apply, conj_trivial, integerFrequency]
  push_cast
  rw [Finset.mul_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i _
  change (2:ℂ)*Real.pi*Complex.I*(-(n i:ℂ))*(z i)/1 =
    (-2:ℂ)*Real.pi*((n i:ℂ)*(z i))*Complex.I
  ring

set_option maxHeartbeats 800000 in
private theorem coefficient_of_small_support {d : ℕ} {P : E d → ℂ}
    (hP : Function.support P ⊆ Metric.closedBall 0 (1/4))
    (n : Fin d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun t => P (WithLp.toLp 2 ((@torusRepresentative d t).1))) n =
      𝓕 P (integerFrequency n) := by
  let q := @torusRepresentative d
  let g (z : Fin d → ℝ) :=
    Complex.exp ((↑(-2*Real.pi*inner ℝ (WithLp.toLp 2 z) (integerFrequency n)) : ℂ) * Complex.I) *
      P (WithLp.toLp 2 z)
  rw [UnitAddTorus.mFourierCoeff_eq_integral _ _ (fun _ => -(1/2:ℝ))]
  have hSet : {z : Fin d → ℝ | ∀ i, z i ∈ Ioc (-(1/2:ℝ)) (-(1/2:ℝ)+1)} = frequencyUnitCube d := rfl
  rw [hSet]
  have he : (∫ z in frequencyUnitCube d,
      UnitAddTorus.mFourier (-n) (fun i => (z i : UnitAddCircle)) •
        P (WithLp.toLp 2 ((q (fun i => (z i : UnitAddCircle))).1))) = ∫ z in frequencyUnitCube d, g z := by
    apply setIntegral_congr_fun (frequencyUnitCube_measurable d)
    intro z hz
    have hq : q (fun i => (z i : UnitAddCircle)) = ⟨z,hz⟩ := by
      rw [← torusRepresentative_symm_apply ⟨z,hz⟩]
      exact q.apply_symm_apply _
    change UnitAddTorus.mFourier (-n) (fun i => (z i : UnitAddCircle)) •
      P (WithLp.toLp 2 ((q (fun i => (z i : UnitAddCircle))).1)) = g z
    rw [hq, integerFrequency_fourierMonomial]
    rfl
  rw [he]
  have hzero (z : Fin d → ℝ) (hz : z ∉ frequencyUnitCube d) : g z = 0 := by
    have hZ : P (WithLp.toLp 2 z) = 0 := by
      by_contra hZ
      apply hz
      intro i
      have hb := hP hZ
      rw [Metric.mem_closedBall, dist_zero_right] at hb
      have hi : |z i| ≤ ‖WithLp.toLp 2 z‖ := by
        simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le (WithLp.toLp 2 z) i
      have h := abs_le.mp (hi.trans hb)
      exact ⟨by linarith [h.1], by linarith [h.2]⟩
    simp [g,hZ]
  rw [← integral_indicator (frequencyUnitCube_measurable d)]
  have hEq : (frequencyUnitCube d).indicator g = g := by
    funext z
    by_cases hz : z ∈ frequencyUnitCube d <;> simp [hz, hzero]
  rw [hEq, Real.fourier_eq']
  let e := ((PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin d => ℝ)).symm).toHomeomorph.toMeasurableEquiv
  have hm := (PiLp.volume_preserving_toLp (Fin d)).integral_comp e.measurableEmbedding
    (fun x : E d => Complex.exp ((↑(-2*Real.pi*inner ℝ x (integerFrequency n)) : ℂ)*Complex.I)*P x)
  exact hm

set_option maxHeartbeats 900000 in
private theorem smallSupport_fourierSeries {d : ℕ} {P : E d → ℂ}
    (hP : Continuous P) (hSupp : Function.support P ⊆ Metric.closedBall 0 (1/4))
    (hSum : Summable (fun n : Fin d → ℤ => ‖𝓕 P (integerFrequency n)‖)) :
    ∀ z : Fin d → ℝ, (∀ i, |z i| < 1/2) →
      P (WithLp.toLp 2 z) =
        ∑' n : Fin d → ℤ, 𝓕 P (integerFrequency n) * ∏ i, profileMode (n i) (8*z i) := by
  let q := @torusRepresentative d
  let Q (z : Fin d → ℝ) : UnitAddTorus (Fin d) := fun i => (z i : UnitAddCircle)
  have hQc : Continuous Q := continuous_pi fun i => (AddCircle.continuous_mk' 1).comp (continuous_apply i)
  let F (t : UnitAddTorus (Fin d)) := P (WithLp.toLp 2 ((q t).1))
  have hM : Measurable F := hP.measurable.comp
    ((PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ)).measurable.comp
      (measurable_subtype_coe.comp q.measurable))
  have hCompact : HasCompactSupport P :=
    (isCompact_closedBall (0:E d) (1/4)).of_isClosed_subset isClosed_closure
      (closure_minimal hSupp Metric.isClosed_closedBall)
  obtain ⟨M,hMbound⟩ := hP.norm.bddAbove_range_of_hasCompactSupport hCompact.norm
  have hLp : MemLp F 2 volume := by
    apply (memLp_const M).mono hM.aestronglyMeasurable
    exact Filter.Eventually.of_forall fun t => (hMbound (mem_range_self (WithLp.toLp 2 (q t).1))).trans
      (le_abs_self M) |>.trans_eq (Real.norm_eq_abs M).symm
  let a (n : Fin d → ℤ) := 𝓕 P (integerFrequency n)
  have hCoeff (n : Fin d → ℤ) : UnitAddTorus.mFourierCoeff F n = a n :=
    coefficient_of_small_support hSupp n
  have hAE := torusFourier_series_ae hLp (by simpa only [hCoeff] using hSum)
  simp_rw [hCoeff] at hAE
  let G (z : Fin d → ℝ) := ∑' n : Fin d → ℤ, a n * UnitAddTorus.mFourier n (Q z)
  have hG : Continuous G := by
    apply continuous_tsum (u := fun n => ‖a n‖)
    · exact fun n => continuous_const.mul ((UnitAddTorus.mFourier n).continuous.comp hQc)
    · exact hSum
    · intro n z
      rw [norm_mul]
      exact (mul_le_mul_of_nonneg_left (((UnitAddTorus.mFourier n).norm_coe_le_norm (Q z)).trans_eq
        UnitAddTorus.mFourier_norm) (norm_nonneg _)).trans_eq (mul_one _)
  have hPull := (torusRepresentative_preserving d).symm.quasiMeasurePreserving.ae hAE
  have he : ∀ᵐ z ∂(volume.restrict (frequencyUnitCube d)), G z = P (WithLp.toLp 2 z) := by
    apply (ae_restrict_iff_subtype (frequencyUnitCube_measurable d)).mpr
    filter_upwards [hPull] with z hz
    change (∑' n : Fin d → ℤ, a n * UnitAddTorus.mFourier n (q.symm z)) = F (q.symm z) at hz
    rw [show F (q.symm z) = P (WithLp.toLp 2 z.1) by unfold F; rw [q.apply_symm_apply],
      torusRepresentative_symm_apply] at hz
    exact hz
  let U : Set (Fin d → ℝ) := {z | ∀ i, |z i| < 1/2}
  have hU : IsOpen U := by
    rw [show U = ⋂ i : Fin d, {z : Fin d → ℝ | |z i| < 1/2} by ext z; simp [U]]
    exact isOpen_iInter_of_finite fun i => isOpen_lt (continuous_apply i).abs continuous_const
  have hSub : U ⊆ frequencyUnitCube d := by
    intro z hz i
    have hh := abs_lt.mp (hz i)
    exact ⟨hh.1, by linarith [hh.2]⟩
  have hPoint := Measure.eqOn_open_of_ae_eq (ae_restrict_of_ae_restrict_of_subset hSub he) hU
    hG.continuousOn (hP.comp (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ))).continuousOn
  intro z hz
  have hEq : G z = P (WithLp.toLp 2 z) := hPoint (show z ∈ U from hz)
  rw [← hEq]
  unfold G
  apply tsum_congr
  intro n
  have hQeq : Q z = fun i => ((8*z i/8:ℝ) : UnitAddCircle) := by
    funext i
    change (z i : UnitAddCircle) = ((8*z i/8:ℝ) : UnitAddCircle)
    rw [show (8:ℝ)*z i/8 = z i by ring]
  rw [hQeq, torusMode_apply]

set_option maxHeartbeats 950000 in
private theorem conicalSymbol_modeSeries {d N : ℕ} (hN : d < N)
    {θ : E d → ℝ} (hθ : ContDiff ℝ (↑(⊤ : ℕ∞)) θ) (hθc : HasCompactSupport θ)
    (hθs : tsupport θ ⊆ {x : E d | 1/2 ≤ ‖x‖ ∧ ‖x‖ ≤ 2})
    (γ : Fin d → ℝ → ℝ) (hγ : ∀ i, tsupport (γ i) ⊆ Ioo (-3:ℝ) 3)
    (hOne : ∀ x ∈ tsupport θ, ∏ i, γ i (x i) = 1) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (m : E d → ℂ) (A : ℝ),
      0 ≤ A → Auto.MikhlinHormander.MikhlinCondition N m A →
      ∀ k : ℤ, ∃ a : (Fin d → ℤ) → ℂ,
        (∀ n, ‖a n‖ ≤ K*A/ (1+‖integerFrequency n‖)^N) ∧
        ∀ z, normalizedConicalSymbol θ m k z =
          ∑' n : Fin d → ℤ, a n * ∏ i, (γ i (z i):ℂ) * profileMode (n i) (z i) := by
  obtain ⟨B, hB, hF⟩ := normalizedConicalSymbol_control (N := N) hθ hθc hθs
  let V := (volume : Measure (E d)).real (Metric.closedBall 0 1)
  let C := (2:ℝ)^N * ((2:ℝ)^N * (N+1) * V)
  have hC : 0 ≤ C := by dsimp [C,V]; positivity
  refine ⟨C*((8:ℝ)^N*B), mul_nonneg hC (mul_nonneg (by positivity) hB), ?_⟩
  intro m A hA hm k
  let F := normalizedConicalSymbol θ m k
  have hF' := hF hA hm k
  let P (x : E d) := F ((8:ℝ) • x)
  have hPs : ContDiff ℝ N P := hF'.1.comp (contDiff_const_smul 8)
  have hSupp : tsupport P ⊆ Metric.closedBall 0 (1/4) := by
    apply closure_minimal _ Metric.isClosed_closedBall
    intro x hx
    have hx' : (8:ℝ) • x ∈ Function.support F := hx
    have h := (hθs (hF'.2.2.2 (subset_closure hx'))).2
    rw [Metric.mem_closedBall, dist_zero_right]
    rw [norm_smul, Real.norm_of_nonneg (by norm_num : (0:ℝ) ≤ 8)] at h
    linarith
  have hDer (j : ℕ) (hj : j ≤ N) (x : E d) :
      ‖iteratedFDeriv ℝ j P x‖ ≤ (8:ℝ)^N*B*A := by
    rw [show P = (fun y : E d => F ((8:ℝ) • y)) from rfl,
      iteratedFDeriv_comp_const_smul (8:ℝ) (hF'.1.of_le (by exact_mod_cast hj)),
      norm_smul, Real.norm_of_nonneg (by positivity : 0 ≤ (8:ℝ)^j)]
    have h8 : (8:ℝ)^j ≤ (8:ℝ)^N := pow_le_pow_right₀ (by norm_num) hj
    exact (mul_le_mul h8 (hF'.2.2.1 j hj _) (norm_nonneg _) (by positivity)).trans_eq (by ring)
  have hsmall : Function.support P ⊆ Metric.closedBall 0 (1/4) := subset_closure.trans hSupp
  have hd := compactSymbol_fourier_decay hPs
    (hSupp.trans (Metric.closedBall_subset_closedBall (by norm_num))) (by positivity) hDer
  let a (n : Fin d → ℤ) := 𝓕 P (integerFrequency n)
  have hDec (n : Fin d → ℤ) : ‖a n‖ ≤ C*((8:ℝ)^N*B)*A / (1+‖integerFrequency n‖)^N :=
    (hd _).trans_eq (by dsimp only [C,V]; ring)
  refine ⟨a, hDec, ?_⟩
  have hSum : Summable (fun n : Fin d → ℤ => ‖a n‖) := by
    have hS := (summable_integerFrequency_weight hN).mul_left (C*((8:ℝ)^N*B)*A)
    apply hS.of_nonneg_of_le (fun _ => norm_nonneg _)
    intro n
    simpa only [div_eq_mul_inv] using hDec n
  intro z
  change F z = _
  by_cases hz : ∀ i, |z i| < 4
  · let x (i : Fin d) := z i / 8
    have hx (i : Fin d) : |x i| < 1/2 := by
      rw [show x i = z i / 8 from rfl, abs_div, abs_of_pos (by norm_num : (0:ℝ) < 8)]
      linarith [hz i]
    have hs : (8:ℝ) • WithLp.toLp 2 x = z := by
      ext i
      change (8:ℝ)*(z i/8) = z i
      ring
    have hZ (i : Fin d) : 8*x i = z i := by dsimp [x]; ring
    have h := smallSupport_fourierSeries hPs.continuous hsmall hSum x hx
    change F ((8:ℝ) • WithLp.toLp 2 x) = _ at h
    simp_rw [hs,hZ] at h
    let G := ∏ i, (γ i (z i) : ℂ)
    have he : (∑' n : Fin d → ℤ, a n * ∏ i, (γ i (z i):ℂ) * profileMode (n i) (z i)) =
        G*F z := by
      simp_rw [Finset.prod_mul_distrib]
      change (∑' n : Fin d → ℤ, a n*(G*∏ i, profileMode (n i) (z i))) = _
      have hmul (n : Fin d → ℤ) :
          a n*(G*∏ i, profileMode (n i) (z i)) =
            G*(a n*∏ i, profileMode (n i) (z i)) := by ring
      simp_rw [hmul]
      rw [tsum_mul_left, ← h]
    rw [he]
    by_cases hzero : F z = 0
    · simp [hzero]
    · have hSupp' : z ∈ tsupport θ := hF'.2.2.2 (subset_closure hzero)
      have hG : G = 1 := by dsimp only [G]; norm_cast; exact hOne z hSupp'
      simp [hG]
  · push_neg at hz
    obtain ⟨i, hi⟩ := hz
    have hZi : γ i (z i) = 0 := by
      by_contra hh
      have h := hγ i (subset_closure hh)
      have h' := abs_lt.mpr ⟨h.1,h.2⟩
      linarith
    have hZero : F z = 0 := by
      by_contra he
      have h := (hθs (hF'.2.2.2 (subset_closure he))).2
      have hcoord : |z i| ≤ ‖z‖ := by simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le z i
      linarith
    have hzProd (n : Fin d → ℤ) : (∏ j, (γ j (z j):ℂ) * profileMode (n j) (z j)) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ i)
      simp [hZi]
    change F z = _
    simp [hZero,hzProd]

private theorem profileSize_translate {a : ℝ → ℂ} (hQ : profileSize a ≠ ∞) (t : ℝ) :
    profileSize (fun x => a (x+t)) ≤ ENNReal.ofReal ((1+|t|)^4) * profileSize a := by
  have hA := ((measurePreserving_add_right (volume : Measure ℝ) t).quasiMeasurePreserving).ae
    (profileSize_weight_ae hQ)
  have h := profileSize_le_of_ae (a := fun x => a (x+t))
    (C := (1+|t|)^4*(profileSize a).toReal) (by
      filter_upwards [hA] with x hx
      rw [deriv_comp_add_const]
      have hw : 1+|x| ≤ (1+|t|)*(1+|x+t|) := by
        have hh := abs_sub_le (x+t) 0 t
        simp only [add_sub_cancel_right, sub_zero, zero_sub, abs_neg] at hh
        nlinarith [mul_nonneg (abs_nonneg t) (abs_nonneg (x+t))]
      calc
        _ ≤ ((1+|t|)*(1+|x+t|))^4 * (‖a (x+t)‖+‖deriv a (x+t)‖) :=
          mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) hw _) (by positivity)
        _ = (1+|t|)^4*((1+|x+t|)^4*(‖a (x+t)‖+‖deriv a (x+t)‖)) := by rw [mul_pow, mul_assoc]
        _ ≤ _ := mul_le_mul_of_nonneg_left hx (by positivity))
  rwa [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_toReal hQ] at h

private theorem inverseFourier_profileMode (a : ℝ → ℂ) (n : ℤ) (y : ℝ) :
    𝓕⁻ (fun z => a z*profileMode n z) y = 𝓕⁻ a (y+(n:ℝ)/8) := by
  rw [Real.fourierInv_eq_fourier_neg, Real.fourierInv_eq_fourier_neg, Real.fourier_eq', Real.fourier_eq']
  simp_rw [RCLike.inner_apply, conj_trivial, smul_eq_mul]
  apply integral_congr_ae
  filter_upwards [] with z
  unfold profileMode
  rw [mul_comm (a z), ← mul_assoc, ← Complex.exp_add]
  congr 2
  push_cast
  ring

private theorem profileMode_derivative (n : ℤ) (x : ℝ) :
    HasDerivAt (profileMode n) ((↑(2*Real.pi*(n:ℝ)/8):ℂ)*Complex.I*profileMode n x) x := by
  let c : ℂ := (↑(2*Real.pi*(n:ℝ)/8):ℂ)*Complex.I
  have he : profileMode n = fun x : ℝ => Complex.exp ((x:ℂ)*c) := by
    funext x
    unfold profileMode
    congr 1
    dsimp only [c]
    push_cast
    ring
  rw [he]
  change HasDerivAt (fun y : ℝ => Complex.exp ((y:ℂ)*c)) (c*Complex.exp ((x:ℂ)*c)) x
  have h : HasDerivAt (fun x : ℝ => (x:ℂ)) 1 x := Complex.ofRealCLM.hasDerivAt
  simpa only [one_mul, mul_comm (Complex.exp ((x:ℂ)*c)) c] using (h.mul_const c).cexp

private theorem profileMode_iteratedDeriv (n : ℤ) (j : ℕ) (x : ℝ) :
    iteratedDeriv j (profileMode n) x =
      ((↑(2*Real.pi*(n:ℝ)/8):ℂ)*Complex.I)^j * profileMode n x := by
  let c : ℂ := (↑(2*Real.pi*(n:ℝ)/8):ℂ)*Complex.I
  induction j generalizing x with
  | zero => simp
  | succ j ih =>
    rw [iteratedDeriv_succ, show iteratedDeriv j (profileMode n) =
      (fun x => c^j*profileMode n x) from funext ih]
    rw [((profileMode_derivative n x).const_mul (c^j)).deriv]
    dsimp only [c]
    rw [pow_succ]
    ring

private theorem profileMode_smooth (n : ℤ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (profileMode n) := by
  let c : ℂ := (↑(2*Real.pi*(n:ℝ)/8):ℂ)*Complex.I
  have he : profileMode n = fun x : ℝ => Complex.exp ((x:ℂ)*c) := by
    funext x
    unfold profileMode
    congr 1
    dsimp only [c]
    push_cast
    ring
  rw [he]
  have h : ContDiff ℝ (↑(⊤ : ℕ∞)) (fun x : ℝ => (x:ℂ)) := Complex.ofRealCLM.contDiff
  exact (h.mul contDiff_const).cexp

private theorem profileMode_derivative_norm_bound (n : ℤ) {j : ℕ} (hj : j ≤ 4) (x : ℝ) :
    ‖iteratedFDeriv ℝ j (profileMode n) x‖ ≤ (max 1 (2*Real.pi))^4 * (1+|(n:ℝ)|)^4 := by
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, profileMode_iteratedDeriv,
    norm_mul, norm_pow, norm_mul, Complex.norm_I, mul_one, profileMode_norm, mul_one,
    Complex.norm_real, Real.norm_eq_abs, abs_div, abs_of_pos (by norm_num : (0:ℝ) < 8),
    abs_mul, abs_of_nonneg (by positivity : 0 ≤ 2*Real.pi)]
  let A := max 1 (2*Real.pi)
  let B := 1+|(n:ℝ)|
  have hA : 1 ≤ A := le_max_left _ _
  have hB : 1 ≤ B := le_add_of_nonneg_right (abs_nonneg _)
  have h : 2*Real.pi*|(n:ℝ)|/8 ≤ A*B := by
    calc
      _ ≤ 2*Real.pi*|(n:ℝ)| := div_le_self (by positivity) (by norm_num)
      _ ≤ _ := mul_le_mul (le_max_right _ _) (le_add_of_nonneg_left zero_le_one)
        (abs_nonneg _) (zero_le_one.trans hA)
  exact ((pow_le_pow_left₀ (by positivity) h _).trans
    (pow_le_pow_right₀ (one_le_mul_of_one_le_of_one_le hA hB) hj)).trans_eq (mul_pow _ _ _)

set_option maxHeartbeats 750000 in
private theorem modulatedProfile_control {γ : ℝ → ℝ}
    (hγ : ContDiff ℝ (↑(⊤ : ℕ∞)) γ) (hγc : HasCompactSupport γ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ n : ℤ, ∃ a : SchwartzMap ℝ ℂ,
      (∀ x, (𝓕 a : SchwartzMap ℝ ℂ) x = (γ x:ℂ)*profileMode n x) ∧
      profileSize a ≤ ENNReal.ofReal (K*(1+|(n:ℝ)|)^4) ∧
      profileFourierFourNorm (𝓕 a) ≤ K*(1+|(n:ℝ)|)^4 := by
  let g : SchwartzMap ℝ ℂ :=
    (hγc.comp_left Complex.ofReal_zero).toSchwartzMap (Complex.ofRealCLM.contDiff.comp hγ)
  let G : SchwartzMap ℝ ℂ := 𝓕⁻ g
  let P := (profileSize G).toReal
  let D := 16 * profileFourierFourNorm g * (max 1 (2*Real.pi))^4
  have hD : 0 ≤ D := by dsimp only [D]; positivity [profileFourierFourNorm_nonneg g]
  let K := P + 5*D
  have hK : 0 ≤ K := add_nonneg ENNReal.toReal_nonneg (mul_nonneg (by norm_num) hD)
  refine ⟨K,hK,?_⟩
  intro n
  let M (z : ℝ) := g z*profileMode n z
  have hMc : HasCompactSupport M := (show HasCompactSupport (g : ℝ → ℂ) from
    hγc.comp_left Complex.ofReal_zero).mul_right
  have hMs : ContDiff ℝ (↑(⊤ : ℕ∞)) M := (g.smooth ⊤).mul (profileMode_smooth n)
  let Gₙ := hMc.toSchwartzMap hMs
  let a : SchwartzMap ℝ ℂ := 𝓕⁻ Gₙ
  have ha : 𝓕 a = Gₙ := FourierTransform.fourier_fourierInv_eq _
  have hQ : profileSize G ≠ ∞ := schwartzProfile_size_finite G
  have hsize : profileSize a ≤ ENNReal.ofReal (K*(1+|(n:ℝ)|)^4) := by
    have he : (a : ℝ → ℂ) = fun y => G (y+(n:ℝ)/8) := by
      change ⇑(𝓕⁻ Gₙ : SchwartzMap ℝ ℂ) = fun y => (𝓕⁻ g : SchwartzMap ℝ ℂ) (y+(n:ℝ)/8)
      rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourierInv_coe]
      funext y
      exact inverseFourier_profileMode g n y
    rw [he]
    refine (profileSize_translate hQ _).trans ?_
    rw [← ENNReal.ofReal_toReal hQ, ← ENNReal.ofReal_mul (by positivity)]
    apply ENNReal.ofReal_le_ofReal
    have hN : |(n:ℝ)/8| ≤ |(n:ℝ)| := by
      rw [abs_div, abs_of_pos (by norm_num : (0:ℝ) < 8)]
      exact div_le_self (abs_nonneg _) (by norm_num)
    have hPow : (1+|(n:ℝ)/8|)^4 ≤ (1+|(n:ℝ)|)^4 :=
      pow_le_pow_left₀ (by positivity) (by linarith) _
    exact (mul_le_mul_of_nonneg_right hPow ENNReal.toReal_nonneg).trans
      (by rw [mul_comm]; exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_right (by positivity)) (by positivity))
  refine ⟨a, fun x => by rw [ha]; rfl, hsize, ?_⟩
  rw [ha]
  let H := (1+|(n:ℝ)|)^4
  have hH : 0 ≤ H := by dsimp only [H]; positivity
  have hDerivative (j : ℕ) (hj : j ≤ 4) (x : ℝ) : ‖iteratedFDeriv ℝ j M x‖ ≤ D*H := by
    refine (norm_iteratedFDeriv_mul_le (g.smooth ⊤) (profileMode_smooth n) x
      (show (j : WithTop ℕ∞) ≤ ↑(⊤ : ℕ∞) by simp)).trans ?_
    calc
      _ ≤ ∑ i ∈ Finset.range (j+1), (j.choose i:ℝ) *
          (profileFourierFourNorm g * ((max 1 (2*Real.pi))^4 * H)) := by
        apply Finset.sum_le_sum
        intro i hi
        have hi' : i ≤ 4 := by have := Finset.mem_range.mp hi; omega
        rw [mul_assoc]
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul (profileFourierFourNorm_controls g hi' x)
            (profileMode_derivative_norm_bound n (by omega : j-i ≤ 4) x)
            (norm_nonneg _) (profileFourierFourNorm_nonneg g)) (Nat.cast_nonneg _)
      _ = (2:ℝ)^j * (profileFourierFourNorm g * ((max 1 (2*Real.pi))^4 * H)) := by
        rw [← Finset.sum_mul, ← Nat.cast_sum, Nat.sum_range_choose, Nat.cast_pow, Nat.cast_ofNat]
      _ ≤ _ := by
        have he : (2:ℝ)^j ≤ 16 := (pow_le_pow_right₀ (by norm_num) hj).trans_eq (by norm_num)
        exact (mul_le_mul_of_nonneg_right he
          (by positivity [profileFourierFourNorm_nonneg g])).trans_eq (by dsimp only [D]; ring)
  have hTotal : profileFourierFourNorm Gₙ ≤ 5*(D*H) := by
    unfold profileFourierFourNorm
    calc
      _ ≤ ∑ _ ∈ Finset.range 5, D*H := by
        apply Finset.sum_le_sum
        intro j hj
        exact Gₙ.seminorm_le_bound ℝ 0 j (mul_nonneg hD hH) (fun x => by
          rw [pow_zero,one_mul]
          exact hDerivative j (by have := Finset.mem_range.mp hj; omega) x)
      _ = _ := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; norm_num
  exact hTotal.trans (by dsimp only [K]; rw [add_mul]; simpa only [mul_assoc] using
    le_add_of_nonneg_left (mul_nonneg (show 0 ≤ P from ENNReal.toReal_nonneg) hH))

set_option maxHeartbeats 850000 in
/-- The localized symbols admit uniform separated Fourier series with controlled Schwartz profiles. -/
theorem modeExpansion {d N : ℕ} (hN : d < N)
    {θ : E d → ℝ} (hθ : ContDiff ℝ (↑(⊤ : ℕ∞)) θ) (hθc : HasCompactSupport θ)
    (hθs : tsupport θ ⊆ {x : E d | 1/2 ≤ ‖x‖ ∧ ‖x‖ ≤ 2})
    (γ : Fin d → ℝ → ℝ)
    (hγ : ∀ i, ContDiff ℝ (↑(⊤ : ℕ∞)) (γ i) ∧ HasCompactSupport (γ i) ∧
      tsupport (γ i) ⊆ Ioo (-3:ℝ) 3)
    (hOne : ∀ x ∈ tsupport θ, ∏ i, γ i (x i) = 1) :
    ∃ K L : ℝ, 0 ≤ K ∧ 0 ≤ L ∧
      ∃ φ : (Fin d → ℤ) → Fin d → SchwartzMap ℝ ℂ,
      (∀ n i, profileSize (φ n i) + ENNReal.ofReal (profileFourierFourNorm (𝓕 (φ n i))) ≤
        ENNReal.ofReal (L*(1+|(n i:ℝ)|)^4)) ∧
      (∀ n i, tsupport ((𝓕 (φ n i) : SchwartzMap ℝ ℂ) : ℝ → ℂ) ⊆ tsupport (γ i)) ∧
      ∀ (m : E d → ℂ) (A : ℝ), 0 ≤ A →
        Auto.MikhlinHormander.MikhlinCondition N m A →
        ∀ k : ℤ, ∃ a : (Fin d → ℤ) → ℂ,
          (∀ n, ‖a n‖ ≤ K*A/(1+‖integerFrequency n‖)^N) ∧
          ∀ z, normalizedConicalSymbol θ m k z =
            ∑' n : Fin d → ℤ, a n * ∏ i, (𝓕 (φ n i) : SchwartzMap ℝ ℂ) (z i) := by
  obtain ⟨K,hK,hA⟩ := conicalSymbol_modeSeries hN hθ hθc hθs γ (fun i => (hγ i).2.2) hOne
  choose L hL hφ using fun i => modulatedProfile_control (hγ i).1 (hγ i).2.1
  choose a ha hQa hFa using fun i n => hφ i n
  let Φ (n : Fin d → ℤ) (i : Fin d) := a i (n i)
  let B := ∑ i, L i
  have hB : 0 ≤ B := Finset.sum_nonneg fun i _ => hL i
  refine ⟨K, 2*B, hK, by positivity, Φ, ?_, ?_, ?_⟩
  · intro n i
    have he : L i ≤ B := Finset.single_le_sum (fun i _ => hL i) (Finset.mem_univ i)
    have h := mul_le_mul_of_nonneg_right he (by positivity : 0 ≤ (1+|(n i:ℝ)|)^4)
    have h₁ := (hQa i (n i)).trans (ENNReal.ofReal_le_ofReal h)
    have h₂ := ENNReal.ofReal_le_ofReal ((hFa i (n i)).trans h)
    refine (add_le_add h₁ h₂).trans_eq ?_
    rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
    congr 1
    ring
  · intro n i
    apply closure_mono
    intro x hx
    by_contra h
    have hz : γ i x = 0 := Function.notMem_support.mp h
    exact hx (by rw [ha i (n i), hz, Complex.ofReal_zero, zero_mul])
  · intro m A hA₀ hm k
    obtain ⟨c,hc,he⟩ := hA m A hA₀ hm k
    refine ⟨c,hc,?_⟩
    intro z
    simp_rw [show ∀ n i (x : ℝ), (𝓕 (Φ n i) : SchwartzMap ℝ ℂ) x =
      (γ i x:ℂ)*profileMode (n i) x from fun n i => ha i (n i)]
    exact he z

end FourierModes

private noncomputable def coordinateSchwartzPullback {d : ℕ} (f : SchwartzMap (E d) ℂ) :
    SchwartzMap (Fin d → ℝ) ℂ :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℝ
    (PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin d => ℝ)).symm f

private theorem coordinateSchwartzPullback_apply {d : ℕ} (f : SchwartzMap (E d) ℂ) (x : Fin d → ℝ) :
    coordinateSchwartzPullback f x = f (WithLp.toLp 2 x) := rfl

private noncomputable def inverseFourierPhase {d : ℕ} (ξ x : E d) : ℂ :=
  Complex.exp ((↑(2*Real.pi*inner ℝ ξ x):ℂ)*Complex.I)

private theorem inverseFourierPhase_norm {d : ℕ} (ξ x : E d) : ‖inverseFourierPhase ξ x‖ = 1 :=
  Complex.norm_exp_ofReal_mul_I _

private theorem update_inner {d : ℕ} (i : Fin d) (x : Fin d → ℝ) (t : ℝ) (ξ : E d) :
    inner ℝ ξ (WithLp.toLp 2 (Function.update x i (x i-t))) =
      inner ℝ ξ (WithLp.toLp 2 x) - t*ξ i := by
  have he : WithLp.toLp 2 (Function.update x i (x i-t)) =
      WithLp.toLp 2 x - EuclideanSpace.single i t := by
    ext j
    by_cases h : j = i
    · subst j
      simp
    · simp [EuclideanSpace.single_apply, Function.update_of_ne h, h]
  rw [he, inner_sub_right, EuclideanSpace.inner_single_right, conj_trivial]

set_option maxHeartbeats 800000 in
private theorem coordinateConvolution_fourierIntegral {d : ℕ} (i : Fin d)
    {K : ℝ → ℂ} (hK : Integrable K) (hKm : Measurable K) (f : SchwartzMap (E d) ℂ) (x : Fin d → ℝ) :
    coordinateProfileConvolution i K (coordinateSchwartzPullback f) x =
      ∫ ξ, 𝓕 K (ξ i) * (𝓕 f : SchwartzMap (E d) ℂ) ξ * inverseFourierPhase ξ (WithLp.toLp 2 x) := by
  let F := (𝓕 f : SchwartzMap (E d) ℂ)
  let X (t : ℝ) := WithLp.toLp 2 (Function.update x i (x i-t))
  let H (z : ℝ × E d) := K z.1 * (inverseFourierPhase z.2 (X z.1) * F z.2)
  have hX : Continuous X := by
    apply (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ)).comp
    apply continuous_pi
    intro j
    by_cases h : j = i
    · subst j
      simp only [Function.update_self]
      have hh : Continuous (fun _ : ℝ => x i) := continuous_const
      change Continuous ((fun _ : ℝ => x i) - id)
      exact hh.sub continuous_id
    · simpa only [Function.update_of_ne h] using (continuous_const : Continuous (fun _ : ℝ => x j))
  have hPh : Continuous (fun z : ℝ × E d => inverseFourierPhase z.2 (X z.1)) := by
    unfold inverseFourierPhase
    have hin : Continuous (fun z : ℝ × E d => inner ℝ z.2 (X z.1)) :=
      continuous_snd.inner (hX.comp continuous_fst)
    fun_prop
  have hHm : Measurable H := (hKm.comp measurable_fst).mul (hPh.measurable.mul
    (F.continuous.measurable.comp measurable_snd))
  have hHi : Integrable H (volume.prod volume) := by
    refine (hK.norm.mul_prod F.integrable.norm).mono' hHm.aestronglyMeasurable ?_
    filter_upwards [] with z
    change ‖K z.1 * (inverseFourierPhase z.2 (X z.1) * F z.2)‖ ≤ ‖K z.1‖*‖F z.2‖
    rw [norm_mul,norm_mul,inverseFourierPhase_norm,one_mul]
  have hInv (t : ℝ) : f (X t) = ∫ ξ, inverseFourierPhase ξ (X t)*F ξ := by
    have he : 𝓕⁻ (F : E d → ℂ) = (f : E d → ℂ) :=
      f.continuous.fourierInv_fourier_eq f.integrable F.integrable
    calc
      _ = 𝓕⁻ (F : E d → ℂ) (X t) := (congrFun he (X t)).symm
      _ = _ := Real.fourierInv_eq' (F : E d → ℂ) (X t)
  change (∫ t, K t*f (X t)) = _
  simp_rw [hInv, ← integral_const_mul]
  change (∫ t, ∫ ξ, H (t,ξ)) = _
  rw [integral_integral_swap hHi]
  apply integral_congr_ae
  filter_upwards [] with ξ
  let e (y : ℝ) := Complex.exp ((↑(-2*Real.pi*(y*ξ i)):ℂ)*Complex.I)
  have hPhEq (y : ℝ) : inverseFourierPhase ξ (X y) =
      inverseFourierPhase ξ (WithLp.toLp 2 x) * e y := by
    unfold inverseFourierPhase
    dsimp only [e]
    rw [show inner ℝ ξ (X y) = _ from update_inner i x y ξ, ← Complex.exp_add]
    congr 1
    push_cast
    ring
  have he : (∫ y, K y*e y) = 𝓕 K (ξ i) := by
    rw [Real.fourier_eq']
    simp_rw [RCLike.inner_apply, conj_trivial, smul_eq_mul]
    apply integral_congr_ae
    filter_upwards [] with y
    unfold e
    rw [mul_comm (ξ i), mul_comm (K y)]
  have hH (y : ℝ) : H (y,ξ) = (K y * e y) * (F ξ * inverseFourierPhase ξ (WithLp.toLp 2 x)) := by
    change K y*(inverseFourierPhase ξ (X y)*F ξ) = _
    rw [hPhEq]
    ring
  simp_rw [hH, integral_mul_const, he]
  ring

private theorem separated_fourierPhase {d : ℕ} (x : E d) (ξ : Fin d → E d) :
    Complex.exp (Complex.I * Complex.ofReal (2*Real.pi*inner ℝ x (∑ j, ξ j))) =
      ∏ i, inverseFourierPhase (ξ i) x := by
  unfold inverseFourierPhase
  rw [← Complex.exp_sum]
  congr 1
  rw [inner_sum, Finset.mul_sum]
  push_cast
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [real_inner_comm x (ξ i), mul_comm Complex.I]

