private theorem physicalSchwartzProduct_decay {d : ℕ} (hd : 2 ≤ d)
    (f : Fin d → SchwartzMap (E d) ℂ) (L : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x y : E d,
      (‖y‖ ≤ 1 → ‖physicalSchwartzProduct f x y-physicalSchwartzProduct f x 0‖ ≤
        C*((1+‖x‖)^L)⁻¹*‖y‖) ∧
      (1 < ‖y‖ → ‖physicalSchwartzProduct f x y‖ ≤ C*((1+‖x‖)^L)⁻¹*‖y‖⁻¹) := by
  let A := 1+∑ i, (2:ℝ)^(L+1) *
    (SchwartzMap.seminorm ℝ 0 0 (f i)+SchwartzMap.seminorm ℝ (L+1) 0 (f i)+
      SchwartzMap.seminorm ℝ 0 1 (f i)+SchwartzMap.seminorm ℝ (L+1) 1 (f i))
  have hA : 1 ≤ A := by
    dsimp only [A]
    exact le_add_of_nonneg_right (Finset.sum_nonneg fun _ _ => by positivity)
  have hA₀ := zero_le_one.trans hA
  have hAterm (i : Fin d) (n : ℕ) (hn : n = 0 ∨ n = 1) (z : E d) :
      (1+‖z‖)^(L+1)*‖iteratedFDeriv ℝ n (f i : E d → ℂ) z‖ ≤ A := by
    refine (schwartz_weighted_derivative (f i) n (L+1) z).trans ?_
    unfold A
    refine (le_trans ?_ (le_add_of_nonneg_left zero_le_one))
    refine le_trans ?_ (Finset.single_le_sum (fun j _ => by positivity) (Finset.mem_univ i))
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    rcases hn with rfl | rfl
    · linarith only [apply_nonneg (SchwartzMap.seminorm ℝ 0 1) (f i),
        apply_nonneg (SchwartzMap.seminorm ℝ (L+1) 1) (f i)]
    · linarith only [apply_nonneg (SchwartzMap.seminorm ℝ 0 0) (f i),
        apply_nonneg (SchwartzMap.seminorm ℝ (L+1) 0) (f i)]
  have hA0 (i : Fin d) (z : E d) : ‖f i z‖ ≤ A := by
    have h := hAterm i 0 (Or.inl rfl) z
    rw [norm_iteratedFDeriv_zero] at h
    exact (le_mul_of_one_le_left (norm_nonneg _) (one_le_pow₀ (le_add_of_nonneg_right (norm_nonneg z)) (n := L+1))).trans h
  let C₁ := d*2^L*A^(d+1)
  let C₂ := (d+1:ℝ)^L*(2*d)*A^(d+1)
  have hC₁ : 0 ≤ C₁ := by dsimp [C₁]; positivity
  have hC₂ : 0 ≤ C₂ := by dsimp [C₂]; positivity
  refine ⟨C₁+C₂,add_nonneg hC₁ hC₂,?_⟩
  intro x y
  let z (i : Fin d) (t : E d) := x-t i • EuclideanSpace.single i 1
  let U (i : Fin d) (t : E d) : ℂ := f i (z i t)
  have hUz (i : Fin d) (t : E d) : ‖U i t‖ ≤ A := hA0 i _
  have hShift (i : Fin d) (t : E d) : ‖t i • EuclideanSpace.single i (1:ℝ)‖ ≤ ‖t‖ := by
    simpa [norm_smul, EuclideanSpace.norm_single] using PiLp.norm_apply_le t i
  have hXpos : 0 < (1+‖x‖)^L := by positivity
  constructor
  · intro hy
    let S := Metric.closedBall (0:E d) 1
    have hD (t : E d) (ht : t ∈ S) :
        ‖fderiv ℝ (physicalSchwartzProduct f x) t‖ ≤ C₁*((1+‖x‖)^L)⁻¹ := by
      have ht₀ : ‖t‖ ≤ 1 := by simpa [S,Metric.mem_closedBall,dist_zero_right] using ht
      have hF (i : Fin d) : ‖fderiv ℝ (f i : E d → ℂ) (z i t)‖ ≤
          (2^L*A)*((1+‖x‖)^L)⁻¹ := by
        have h := hAterm i 1 (Or.inr rfl) (z i t)
        rw [norm_iteratedFDeriv_one] at h
        have hxz : 1+‖x‖ ≤ 2*(1+‖z i t‖) := by
          have hh := norm_add_le (z i t) (t i • EuclideanSpace.single i (1:ℝ))
          rw [show z i t + t i • EuclideanSpace.single i 1 = x by simp [z]] at hh
          linarith only [hh,(hShift i t).trans ht₀,norm_nonneg (z i t)]
        rw [← div_eq_mul_inv]
        apply (le_div_iff₀ hXpos).mpr
        calc
          _ ≤ ‖fderiv ℝ (f i : E d → ℂ) (z i t)‖*(2*(1+‖z i t‖))^L := by gcongr
          _ = 2^L*((1+‖z i t‖)^L*‖fderiv ℝ (f i : E d → ℂ) (z i t)‖) := by rw [mul_pow]; ring
          _ ≤ 2^L*((1+‖z i t‖)^(L+1)*‖fderiv ℝ (f i : E d → ℂ) (z i t)‖) := by
            apply mul_le_mul_of_nonneg_left _ (by positivity)
            apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
            exact pow_le_pow_right₀ (le_add_of_nonneg_right (norm_nonneg (z i t))) (by omega)
          _ ≤ _ := mul_le_mul_of_nonneg_left h (by positivity)
      let Z (i : Fin d) : E d →L[ℝ] E d :=
        -((EuclideanSpace.proj (𝕜 := ℝ) i).smulRight (EuclideanSpace.single i 1))
      have hZ (i : Fin d) : ‖Z i‖ ≤ 1 := by
        apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
        intro u
        simp only [Z, ContinuousLinearMap.neg_apply, norm_neg, ContinuousLinearMap.smulRight_apply,
          norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, one_mul]
        exact PiLp.norm_apply_le _ _
      have hZU (i : Fin d) : HasFDerivAt (U i)
          ((fderiv ℝ (f i : E d → ℂ) (z i t)).comp (Z i)) t := by
        have hZ' : HasFDerivAt (z i) (Z i) t := by
          have he := (hasFDerivAt_const (𝕜 := ℝ) x (x := t)).sub
            ((EuclideanSpace.proj (𝕜 := ℝ) i).smulRight (EuclideanSpace.single i 1)).hasFDerivAt
          rw [zero_sub] at he
          convert he using 1
          funext v
          simp [z,Pi.sub_apply,ContinuousLinearMap.smulRight_apply]
        exact (((f i).differentiable (z i t)).hasFDerivAt.comp t hZ')
      have hFU (i : Fin d) : ‖fderiv ℝ (U i) t‖ ≤ (2^L*A)*((1+‖x‖)^L)⁻¹ := by
        rw [(hZU i).fderiv]
        exact ((ContinuousLinearMap.opNorm_comp_le _ _).trans
          (mul_le_of_le_one_right (norm_nonneg _) (hZ i))).trans (hF i)
      change ‖fderiv ℝ (fun t => ∏ i, U i t) t‖ ≤ _
      rw [fderiv_finsetProd (fun i _ => (hZU i).differentiableAt)]
      refine (norm_sum_le _ _).trans ?_
      calc
        _ ≤ ∑ _i : Fin d, A^d*((2^L*A)*((1+‖x‖)^L)⁻¹) := by
          apply Finset.sum_le_sum
          intro i _
          rw [norm_smul,norm_prod]
          refine mul_le_mul ?_ (hFU i) (norm_nonneg _) (by positivity)
          refine (Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) (fun j _ => hUz j t)).trans ?_
          rw [Finset.prod_const]
          exact pow_le_pow_right₀ hA (by simpa using Finset.card_le_card (Finset.erase_subset i Finset.univ))
        _ = _ := by simp [C₁,nsmul_eq_mul,pow_succ]; ring
    have hfDiff (t : E d) (_ : t ∈ S) : DifferentiableAt ℝ (physicalSchwartzProduct f x) t := by
      change DifferentiableAt ℝ (fun v => ∏ i, U i v) t
      have hd (i : Fin d) : DifferentiableAt ℝ (U i) t := (f i).differentiable.differentiableAt.comp t
        ((differentiableAt_const (𝕜 := ℝ) x).sub
          (((EuclideanSpace.proj (𝕜 := ℝ) i).differentiableAt).smul (differentiableAt_const _)))
      exact (HasFDerivAt.finsetProd (u := Finset.univ) (fun i _ => (hd i).hasFDerivAt)).differentiableAt
    have hyS : y ∈ S := by simpa [S, Metric.mem_closedBall, dist_zero_right] using hy
    have h0S : (0:E d) ∈ S := Metric.mem_closedBall_self zero_le_one
    have h := (convex_closedBall (0:E d) 1).norm_image_sub_le_of_norm_fderiv_le hfDiff hD h0S hyS
    rw [sub_zero] at h
    exact h.trans (by gcongr; exact le_add_of_nonneg_right hC₂)
  · intro hy
    letI : Nonempty (Fin d) := ⟨⟨0,by omega⟩⟩
    letI : Nontrivial (Fin d) := ⟨⟨⟨0,by omega⟩,⟨1,by omega⟩,by intro h; exact (by norm_num : (0:ℕ) ≠ 1) (congrArg Fin.val h)⟩⟩
    obtain ⟨i,_,hi⟩ := Finset.exists_max_image (Finset.univ : Finset (Fin d)) (fun j => ‖z j y‖)
      Finset.univ_nonempty
    let B := ‖z i y‖
    have hB : 0 ≤ B := norm_nonneg _
    have hCoord (j : Fin d) : |x j| ≤ B := by
      obtain ⟨j',hj'⟩ : ∃ j' : Fin d, j ≠ j' := exists_ne j |>.imp fun _ h => h.symm
      have he : z j' y j = x j := by simp [z, EuclideanSpace.single_apply, hj']
      rw [← he]
      exact (by simpa [Real.norm_eq_abs] using PiLp.norm_apply_le (z j' y) j : |z j' y j| ≤ ‖z j' y‖)
        |>.trans (hi j' (Finset.mem_univ _))
    have hX := norm_le_coord_bound x hCoord
    have hY : ‖y‖ ≤ d*(2*B) := by
      apply norm_le_coord_bound
      intro j
      have h := PiLp.norm_apply_le (z j y) j
      have hh : |x j-y j| ≤ B := by
        simpa [z,EuclideanSpace.single_apply,Real.norm_eq_abs] using h.trans (hi j (Finset.mem_univ _))
      calc
        _ = |x j-(x j-y j)| := by ring_nf
        _ ≤ |x j|+|x j-y j| := abs_sub _ _
        _ ≤ 2*B := by linarith [hCoord j]
    have hXY : (1+‖x‖)^L*‖y‖ ≤ ((d+1:ℝ)^L*(2*d))*(1+B)^(L+1) := by
      calc
        _ ≤ ((d+1:ℝ)*(1+B))^L*((2*d)*(1+B)) := by
          apply mul_le_mul
          · apply pow_le_pow_left₀ (by positivity)
            nlinarith [hX]
          · nlinarith [hY]
          · positivity
          · positivity
        _ = _ := by rw [mul_pow,pow_succ]; ring
    have hProd : ‖physicalSchwartzProduct f x y‖ ≤ ‖U i y‖*A^d := by
      unfold physicalSchwartzProduct
      rw [norm_prod, ← Finset.mul_prod_erase _ _ (Finset.mem_univ i)]
      apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
      refine (Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) (fun j _ => hUz j y)).trans ?_
      rw [Finset.prod_const]
      exact pow_le_pow_right₀ hA (by simpa using Finset.card_le_card (Finset.erase_subset i Finset.univ))
    have hC' := hAterm i 0 (Or.inl rfl) (z i y)
    rw [norm_iteratedFDeriv_zero] at hC'
    rw [mul_assoc, ← mul_inv, ← div_eq_mul_inv]
    apply (le_div_iff₀ (mul_pos hXpos (zero_lt_one.trans hy))).mpr
    refine (mul_le_mul hProd hXY (by positivity) (by positivity)).trans ?_
    calc
      _ = ((d+1:ℝ)^L*(2*d))*A^d*((1+B)^(L+1)*‖U i y‖) := by ring
      _ ≤ C₂ := by
        dsimp only [C₂]
        rw [pow_succ A,mul_assoc]
        have hC'' : (1+B)^(L+1)*‖U i y‖ ≤ A := hC'
        calc
          _ = ((d+1:ℝ)^L*(2*d)*A^d)*((1+B)^(L+1)*‖U i y‖) := by ring
          _ ≤ ((d+1:ℝ)^L*(2*d)*A^d)*A := mul_le_mul_of_nonneg_left hC'' (by positivity)
          _ = _ := by ring
      _ ≤ _ := le_add_of_nonneg_left hC₁

