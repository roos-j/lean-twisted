private theorem annularWindowSymbol_tendsto {d : ℕ} {θ : E d → ℝ}
    (hPartition : ∀ x : E d, x ≠ 0 → ∑' k : ℤ, θ (((2:ℝ)^(-k)) • x) = 1)
    (m : E d → ℂ) {η : E d} (hη : η ≠ 0) :
    Tendsto (fun n : ℕ => annularWindowSymbol θ m (-(n:ℤ)) (2*n+1) η) atTop (𝓝 (m η)) := by
  let f (k : ℤ) := θ (((2:ℝ)^(-k)) • η)
  have hf : Summable f := by
    by_contra h
    have hh := hPartition η hη
    change (∑' k, f k) = 1 at hh
    rw [tsum_eq_zero_of_not_summable h] at hh
    norm_num at hh
  have he : HasSum f 1 := (hPartition η hη) ▸ hf.hasSum
  have hc : Tendsto (fun n : ℕ =>
      (∑ k ∈ (Finset.range (2*n+1)).image (fun k : ℕ => -(n:ℤ)+(k:ℤ)), f k)) atTop (𝓝 1) :=
    he.comp dyadicWindow_exhaustion
  have hZ : Tendsto (fun n : ℕ =>
      ((∑ k ∈ (Finset.range (2*n+1)).image (fun k : ℕ => -(n:ℤ)+(k:ℤ)), f k):ℂ)*m η)
      atTop (𝓝 ((1:ℂ)*m η)) :=
    by simpa only [Function.comp_apply, Complex.ofReal_one, Complex.ofReal_sum] using
      (Complex.continuous_ofReal.continuousAt.tendsto.comp hc).mul_const (m η)
  rw [one_mul] at hZ
  convert hZ using 1
  funext n
  unfold annularWindowSymbol
  rw [Finset.sum_image (fun k _ l _ h => by
    exact_mod_cast (add_left_cancel (show -(n:ℤ)+(k:ℤ) = -(n:ℤ)+(l:ℤ) from h)))]
  rw [Finset.sum_mul]

