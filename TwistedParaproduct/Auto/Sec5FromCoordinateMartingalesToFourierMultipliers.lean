private theorem scalarCz_normalized {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ {K f : ℝ → ℂ},
      Integrable K → Measurable K → scalarKernelRegular K 1 →
      (∀ ξ, ‖𝓕 K ξ‖ ≤ 1) → Measurable f → MemLp f (ENNReal.ofReal p) volume →
      eLpNorm (lineProfileConvolution K f) (ENNReal.ofReal p) volume ≤
        C * eLpNorm f (ENNReal.ofReal p) volume := by
  by_cases h : p ≤ 2
  · exact ⟨scalarCzConstant p, scalarCzConstant_ne_top hp,
      fun hi hm hr hf hm' hl => scalarCz_lower_all hi hm hr hf hm' hp h hl⟩
  let q := p.conjExponent
  have hc := Real.HolderConjugate.conjExponent hp
  have hq : 1 < q := hc.symm.lt
  have hq₂ : q ≤ 2 := by
    have hh := hc.one_div_add_one_div
    have hpp : 2 < p := lt_of_not_ge h
    have hqpos : 0 < q := zero_lt_one.trans hq
    have hp' : 1/p < (1:ℝ)/2 := one_div_lt_one_div_of_lt (by norm_num) hpp
    by_contra! h'
    have hq' : 1/q < (1:ℝ)/2 := one_div_lt_one_div_of_lt (by norm_num) h'
    change 1/p + 1/q = 1/1 at hh
    linarith
  let C := scalarCzConstant q
  have hC : C ≠ ∞ := scalarCzConstant_ne_top hq
  refine ⟨C, hC, ?_⟩
  intro K f hK hKm hReg hFourier hm hf
  let R (x : ℝ) := K (-x)
  have hRm : Measurable R := hKm.comp measurable_neg
  have hR : Integrable R :=
    ((volume : Measure ℝ).measurePreserving_neg).integrable_comp_of_integrable hK
  have hRegR : scalarKernelRegular R 1 := by
    intro x u hu
    have hz := hReg (-x) (-u) (by simpa using hu)
    simpa [R, neg_sub, abs_neg, sub_eq_add_neg, add_comm] using hz
  have hFR (ξ : ℝ) : ‖𝓕 R ξ‖ ≤ 1 := by
    change ‖𝓕 (fun x => K (-x)) ξ‖ ≤ 1
    rw [← Real.fourierInv_eq_fourier_comp_neg, Real.fourierInv_eq_fourier_neg]
    exact hFourier (-ξ)
  have hy := (lineProfileConvolution_young hp.le hKm hK hm hf).1
  have hFin : C * eLpNorm f (ENNReal.ofReal p) volume ≠ ∞ :=
    ENNReal.mul_ne_top hC hf.eLpNorm_ne_top
  apply (ENNReal.toReal_le_toReal hy.eLpNorm_ne_top hFin).mp
  rw [ENNReal.toReal_mul]
  change lpNorm (lineProfileConvolution K f) (ENNReal.ofReal p) volume ≤
    C.toReal * lpNorm f (ENNReal.ofReal p) volume
  apply Auto.LpSpaceFacts.lpNorm_le_of_simple_test_pairing_bound hp
    (mul_nonneg ENNReal.toReal_nonneg lpNorm_nonneg) hy
  intro g
  letI : Fact (1 ≤ ENNReal.ofReal q) := ⟨by simpa using ENNReal.ofReal_le_ofReal hq.le⟩
  let s := Lp.simpleFunc.toSimpleFunc g
  have hsg := Lp.simpleFunc.toSimpleFunc_eq_toFun g
  have hs : MemLp s (ENNReal.ofReal q) volume := Lp.simpleFunc.memLp g
  have hpairs : (∫ x, lineProfileConvolution K f x * (g : Lp ℂ (ENNReal.ofReal q) volume) x) =
      ∫ x, lineProfileConvolution K f x * s x := by
    apply integral_congr_ae
    filter_upwards [hsg] with x hx using congrArg (fun z => lineProfileConvolution K f x*z) hx.symm
  rw [hpairs, lineProfileConvolution_pair hp hKm hK hm s.measurable hf hs]
  have hz := Auto.LpSpaceFacts.enorm_integral_mul_le_eLpNorm_p_pconj_mul hp f
    (lineProfileConvolution R s) hf (lineProfileConvolution_young hq.le hRm hR s.measurable hs).1
  have hsBound : eLpNorm (lineProfileConvolution R s) (ENNReal.ofReal q) volume ≤
      C * eLpNorm s (ENNReal.ofReal q) volume :=
    scalarCz_lower_all hR hRm hRegR hFR s.measurable hq hq₂ hs
  have hEst := hz.trans (mul_le_mul_right hsBound (eLpNorm f (ENNReal.ofReal p) volume))
  have he := ENNReal.toReal_mono (ENNReal.mul_ne_top hf.eLpNorm_ne_top
    (ENNReal.mul_ne_top hC hs.eLpNorm_ne_top)) hEst
  rw [eLpNorm_congr_ae hsg] at he
  simpa only [ENNReal.toReal_mul, ← ofReal_norm, ENNReal.toReal_ofReal (norm_nonneg _),
    Lp.norm_def, lpNorm, ← mul_assoc, mul_comm, mul_left_comm] using he

private theorem lineProfileConvolution_scale (c : ℂ) (K f : ℝ → ℂ) :
    lineProfileConvolution (fun x => c*K x) f = c • lineProfileConvolution K f := by
  funext x
  simp only [lineProfileConvolution, Pi.smul_apply, smul_eq_mul, mul_assoc, integral_const_mul]

set_option maxHeartbeats 850000 in
/-- The one-dimensional scalar convolution estimate used for signed profile sums. -/
theorem scalarCz {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ {K f : ℝ → ℂ} {B : ℝ},
      0 ≤ B → Integrable K → scalarKernelRegular K B →
      (∀ ξ, ‖𝓕 K ξ‖ ≤ B) → MemLp f (ENNReal.ofReal p) volume →
      MemLp (lineProfileConvolution K f) (ENNReal.ofReal p) volume ∧
      eLpNorm (lineProfileConvolution K f) (ENNReal.ofReal p) volume ≤
        C * ENNReal.ofReal B * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C, hC, hN⟩ := scalarCz_normalized hp
  refine ⟨C, hC, ?_⟩
  intro K f B hB hK hReg hF hf
  have hKm := scalarKernelRegular_measurable hB hReg
  let g := hf.aestronglyMeasurable.mk f
  have hg : Measurable g := hf.aestronglyMeasurable.stronglyMeasurable_mk.measurable
  have he : f =ᵐ[volume] g := hf.aestronglyMeasurable.ae_eq_mk
  have hgp := hf.ae_eq he
  rw [lineProfileConvolution_congr_input he, eLpNorm_congr_ae he]
  have hY := (lineProfileConvolution_young hp.le hKm hK hg hgp).1
  refine ⟨hY, ?_⟩
  have hPos {b : ℝ} (hb : 0 < b) (hr : scalarKernelRegular K b)
      (hF' : ∀ ξ, ‖𝓕 K ξ‖ ≤ b) :
      eLpNorm (lineProfileConvolution K g) (ENNReal.ofReal p) volume ≤
        C * ENNReal.ofReal b * eLpNorm g (ENNReal.ofReal p) volume := by
    let K' (x : ℝ) := (b⁻¹ : ℝ) * K x
    have hK' : Integrable K' := hK.const_mul (↑b⁻¹ : ℂ)
    have hK'm : Measurable K' := measurable_const.mul hKm
    have hr' : scalarKernelRegular K' 1 := by
      intro x u hu hx
      have hR := hr x u hu hx
      simp only [K', ← mul_sub, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (inv_nonneg.mpr hb.le)]
      calc
        _ ≤ b⁻¹ * (b*|u|/|x|^2) := mul_le_mul_of_nonneg_left hR (by positivity)
        _ = _ := by rw [← mul_div_assoc, ← mul_assoc, inv_mul_cancel₀ hb.ne']
    have hF'₁ (ξ : ℝ) : ‖𝓕 K' ξ‖ ≤ 1 := by
      have hs : 𝓕 K' ξ = (↑b⁻¹ : ℂ) * 𝓕 K ξ := by
        rw [Real.fourier_eq, Real.fourier_eq, ← integral_const_mul]
        apply integral_congr_ae
        filter_upwards [] with x
        simp only [K', mul_comm (↑b⁻¹ : ℂ), smul_mul_assoc]
      rw [hs, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (inv_nonneg.mpr hb.le)]
      exact (mul_le_mul_of_nonneg_left (hF' ξ) (inv_nonneg.mpr hb.le)).trans_eq
        (inv_mul_cancel₀ hb.ne')
    have hh := hN hK' hK'm hr' hF'₁ hg hgp
    rw [show K' = (fun x => (↑b⁻¹ : ℂ)*K x) from rfl,
      lineProfileConvolution_scale, eLpNorm_const_smul] at hh
    have hNorm : ‖(↑b⁻¹ : ℂ)‖ₑ = (ENNReal.ofReal b)⁻¹ := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (inv_nonneg.mpr hb.le), ENNReal.ofReal_inv_of_pos hb]
    rw [hNorm] at hh
    calc
      _ = ENNReal.ofReal b * ((ENNReal.ofReal b)⁻¹ *
          eLpNorm (lineProfileConvolution K g) (ENNReal.ofReal p) volume) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel (by positivity) ENNReal.ofReal_ne_top, one_mul]
      _ ≤ _ := (mul_le_mul_right hh (ENNReal.ofReal b)).trans_eq (by ac_rfl)
  rcases hB.eq_or_lt with hZero | hB
  · have hZero' : B = 0 := hZero.symm
    subst B
    simp only [ENNReal.ofReal_zero, mul_zero, zero_mul]
    by_contra! hn
    let L := lpNorm (lineProfileConvolution K g) (ENNReal.ofReal p) volume
    have hL : 0 < L := ENNReal.toReal_pos hn.ne' hY.eLpNorm_ne_top
    let A := C.toReal * lpNorm g (ENNReal.ofReal p) volume
    have hA : 0 ≤ A := mul_nonneg ENNReal.toReal_nonneg lpNorm_nonneg
    let b := L / (A+1)
    have hb : 0 < b := div_pos hL (by linarith)
    have hr : scalarKernelRegular K b := by
      intro x u hu hx
      exact (hReg x u hu hx).trans (by simp only [zero_mul, zero_div]; positivity)
    have hh := hPos hb hr (fun ξ => (hF ξ).trans hb.le)
    have ht := ENNReal.toReal_mono (ENNReal.mul_ne_top
      (ENNReal.mul_ne_top hC ENNReal.ofReal_ne_top) hgp.eLpNorm_ne_top) hh
    simp only [ENNReal.toReal_mul, ENNReal.toReal_ofReal hb.le] at ht
    have ht' : L ≤ b*A := by simpa only [L, A, lpNorm, mul_left_comm, mul_comm, mul_assoc] using ht
    have hlt : b*A < L := by
      dsimp only [b]
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by linarith : 0 < A+1)]
      nlinarith
    exact (not_lt_of_ge ht') hlt
  · exact hPos hB hReg hF

private theorem dyadicProfileWeight_partial {S : Finset ℤ} (m : ℤ)
    (hS : ∀ k ∈ S, k ≤ m) :
    ∑ k ∈ S, (2:ℝ)^(k-m) ≤ 2 := by
  let j (k : ℤ) := (m-k).toNat
  have hcast {k : ℤ} (hk : k ∈ S) : (j k : ℤ) = m-k :=
    Int.toNat_of_nonneg (sub_nonneg.mpr (hS k hk))
  have hterm {k : ℤ} (hk : k ∈ S) : (2:ℝ)^(k-m) = (1/2:ℝ)^j k := by
    rw [show k-m = -(↑(j k) : ℤ) by rw [hcast hk]; omega,
      zpow_neg, zpow_natCast, ← inv_pow]
    norm_num
  have hinj : ∀ a ∈ S, ∀ b ∈ S, j a = j b → a = b := by
    intro a ha b hb he
    have hh : (↑(j a) : ℤ) = ↑(j b) := congrArg (fun n : ℕ => (n : ℤ)) he
    rw [hcast ha, hcast hb] at hh
    omega
  have hs : Summable (fun n : ℕ => (1/2:ℝ)^n) :=
    summable_geometric_of_norm_lt_one (by norm_num)
  calc
    _ = ∑ n ∈ S.image j, (1/2:ℝ)^n := by
      rw [Finset.sum_image hinj]
      exact Finset.sum_congr rfl fun _ hk => hterm hk
    _ ≤ ∑' n : ℕ, (1/2:ℝ)^n := hs.sum_le_tsum _ (fun _ _ => by positivity)
    _ = 2 := by rw [tsum_geometric_of_lt_one (by norm_num) (by norm_num)]; norm_num

private theorem dyadicProfileWeight_reverse {S : Finset ℤ} (m : ℤ)
    (hS : ∀ k ∈ S, m ≤ k) :
    ∑ k ∈ S, (2:ℝ)^(m-k) ≤ 2 := by
  let j (k : ℤ) := -k
  have he : (∑ k ∈ S.image j, (2:ℝ)^(k-(-m))) = ∑ k ∈ S, (2:ℝ)^(m-k) := by
    rw [Finset.sum_image (fun a _ b _ h => neg_injective h)]
    apply Finset.sum_congr rfl
    intro k hk
    congr 1
    omega
  rw [← he]
  apply dyadicProfileWeight_partial
  rintro k hk
  obtain ⟨l, hl, rfl⟩ := Finset.mem_image.mp hk
  exact neg_le_neg (hS l hl)

private theorem profileSize_derivative_le {a : ℝ → ℂ} (hQ : profileSize a ≠ ∞) :
    ∀ᵐ y ∂(volume : Measure ℝ), ‖deriv a y‖ ≤ (profileSize a).toReal / (1+|y|)^4 := by
  filter_upwards [ENNReal.ae_le_essSup (μ := (volume : Measure ℝ))
    (fun y => ENNReal.ofReal ((1+|y|)^4 * (‖a y‖+‖deriv a y‖)))] with x hx
  have hh : ENNReal.ofReal ((1+|x|)^4 * (‖a x‖+‖deriv a x‖)) ≤ profileSize a := hx
  have hd := ENNReal.toReal_mono hQ hh
  rw [ENNReal.toReal_ofReal (by positivity)] at hd
  apply (le_div_iff₀ (by positivity)).mpr
  rw [mul_comm]
  exact (mul_le_mul_of_nonneg_left (le_add_of_nonneg_left (norm_nonneg _)) (by positivity)).trans hd

private theorem locallyAbsolutelyContinuous_continuous {a : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r) : Continuous a := by
  rw [continuous_iff_continuousAt]
  intro y
  apply (ha (y-1) (y+1)).continuousOn.continuousAt
  rw [uIcc_of_le (by linarith)]
  exact Icc_mem_nhds (by linarith) (by linarith)

private theorem profileWeight_integrable : Integrable (fun x : ℝ => ((1+|x|)^4)⁻¹) := by
  have hr : (Module.finrank ℝ ℝ : ℝ) < 4 := by simp
  have hi := integrable_one_add_norm (E := ℝ) (μ := volume) hr
  convert hi using 1
  funext x
  rw [Real.norm_eq_abs, show (-4:ℝ) = -(4:ℝ) from rfl,
    Real.rpow_neg (by positivity), show (4:ℝ) = ↑(4:ℕ) from rfl, Real.rpow_natCast]

private theorem profileFirstWeight_integrable :
    Integrable (fun x : ℝ => |x| * ((1+|x|)^4)⁻¹) := by
  have hr : (Module.finrank ℝ ℝ : ℝ) < 3 := by simp
  have hi := integrable_one_add_norm (E := ℝ) (μ := volume) hr
  apply hi.mono' (by fun_prop)
  filter_upwards [] with x
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), Real.norm_eq_abs,
    Real.rpow_neg (by positivity), show (3:ℝ) = ↑(3:ℕ) from rfl, Real.rpow_natCast]
  have h : (0:ℝ) < 1+|x| := by positivity
  field_simp
  nlinarith

private theorem profile_integrable {a : ℝ → ℂ} (ha : Continuous a)
    (hQ : profileSize a ≠ ∞) : Integrable a := by
  refine (profileWeight_integrable.const_mul (profileSize a).toReal).mono'
    ha.aestronglyMeasurable ?_
  filter_upwards [] with x
  rw [← div_eq_mul_inv]
  apply (le_div_iff₀ (by positivity)).mpr
  simpa only [mul_comm] using profileSize_amplitude_le ha hQ x

private theorem profile_derivative_integrable {a : ℝ → ℂ} (hQ : profileSize a ≠ ∞) :
    Integrable (deriv a) :=
  (profileWeight_integrable.const_mul (profileSize a).toReal).mono'
    (measurable_deriv a).aestronglyMeasurable
    ((profileSize_derivative_le hQ).mono fun _ hx => by simpa only [div_eq_mul_inv] using hx)

private theorem intervalIntegral_deriv_complex {a : ℝ → ℂ} {l r : ℝ}
    (ha : AbsolutelyContinuousOnInterval a l r)
    (hi : IntervalIntegrable (deriv a) volume l r) :
    (∫ x in l..r, deriv a x) = a r - a l := by
  have hdiff := ha.boundedVariationOn.ae_differentiableAt_of_mem_uIcc
  have hProj (L : ℂ →L[ℝ] ℝ) :
      L (∫ x in l..r, deriv a x) = L (a r - a l) := by
    have hAc := L.lipschitzWith.comp_absolutelyContinuousOnInterval ha
    rw [← L.intervalIntegral_comp_comm hi, L.map_sub]
    change _ = (L ∘ a) r - (L ∘ a) l
    rw [← hAc.integral_deriv_eq_sub]
    apply intervalIntegral.integral_congr_ae
    filter_upwards [hdiff] with x hx hx'
    exact ((L.hasFDerivAt.comp_hasDerivAt x (hx (uIoc_subset_uIcc hx')).hasDerivAt).deriv).symm
  exact Complex.ext (hProj Complex.reCLM) (hProj Complex.imCLM)

private theorem profileFourier_low {a : ℝ → ℂ} (ha : Continuous a)
    (hQ : profileSize a ≠ ∞) (hzero : (∫ y, a y) = 0) (ξ : ℝ) :
    ‖𝓕 a ξ‖ ≤ (2*Real.pi * (∫ y : ℝ, |y| * ((1+|y|)^4)⁻¹)) *
      (profileSize a).toReal * |ξ| := by
  let w (y : ℝ) := Complex.exp (↑(-2*Real.pi*(y*ξ)) * Complex.I)
  have hw (y : ℝ) : ‖w y‖ = 1 := Complex.norm_exp_ofReal_mul_I _
  have hwM : Continuous w := by dsimp [w]; fun_prop
  have hi := profile_integrable ha hQ
  have hwi : Integrable (fun y => w y * a y) := by
    apply hi.norm.mono' (hwM.mul ha).aestronglyMeasurable
    exact Filter.Eventually.of_forall fun y => by
      change ‖w y*a y‖ ≤ ‖a y‖
      rw [norm_mul, hw, one_mul]
  have he : 𝓕 a ξ = ∫ y, (w y-1)*a y := by
    rw [Real.fourier_eq']
    simp_rw [RCLike.inner_apply, conj_trivial, mul_comm ξ, smul_eq_mul]
    change (∫ y, w y*a y) = _
    simp_rw [sub_mul, one_mul]
    rw [integral_sub hwi hi, hzero, sub_zero]
  let M := (profileSize a).toReal
  let c := 2*Real.pi*|ξ| * M
  have hc : 0 ≤ c := by dsimp [c, M]; positivity
  rw [he]
  refine (norm_integral_le_integral_norm _).trans ?_
  have hb (y : ℝ) : ‖(w y-1)*a y‖ ≤ c * (|y| * ((1+|y|)^4)⁻¹) := by
    have hz : ‖w y-1‖ ≤ 2*Real.pi*|y| * |ξ| := by
      unfold w
      rw [mul_comm _ Complex.I]
      exact Real.norm_exp_I_mul_ofReal_sub_one_le.trans_eq (by
        rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, abs_of_nonneg Real.pi_pos.le]; norm_num <;> ring)
    have hA : ‖a y‖ ≤ M * ((1+|y|)^4)⁻¹ := by
      rw [← div_eq_mul_inv]
      exact (le_div_iff₀ (by positivity)).mpr (by
        simpa only [mul_comm] using profileSize_amplitude_le ha hQ y)
    rw [norm_mul]
    exact (mul_le_mul hz hA (norm_nonneg _) (by positivity)).trans_eq (by dsimp [c]; ring)
  have hbi := profileFirstWeight_integrable.const_mul c
  have hwi' := hbi.mono' ((hwM.sub continuous_const).mul ha).aestronglyMeasurable
    (Filter.Eventually.of_forall hb)
  refine (integral_mono hwi'.norm hbi hb).trans_eq ?_
  rw [integral_const_mul]
  dsimp only [c, M]
  ring

private theorem integral_deriv_complex_eq_zero {a : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r)
    (hi : Integrable (deriv a))
    (hL : Tendsto a atBot (𝓝 0)) (hR : Tendsto a atTop (𝓝 0)) :
    (∫ x, deriv a x) = 0 := by
  have ht := intervalIntegral_tendsto_integral hi (tendsto_neg_atTop_atBot (G := ℝ))
    (tendsto_id : Tendsto (id : ℝ → ℝ) atTop atTop)
  have hz : Tendsto (fun t : ℝ => a t - a (-t)) atTop (𝓝 0) := by
    simpa only [sub_zero, Function.comp_apply] using hR.sub (hL.comp tendsto_neg_atTop_atBot)
  have he (t : ℝ) : (∫ x in -t..t, deriv a x) = a t - a (-t) :=
    intervalIntegral_deriv_complex (ha _ _) hi.intervalIntegrable
  exact tendsto_nhds_unique (ht.congr he) hz

set_option maxHeartbeats 850000 in
private theorem profileFourier_derivative {a : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r)
    (hQ : profileSize a ≠ ∞) (ξ : ℝ) :
    𝓕 (deriv a) ξ = (↑(2*Real.pi*ξ) * Complex.I) * 𝓕 a ξ := by
  let c : ℂ := ↑(-2*Real.pi*ξ) * Complex.I
  let w (y : ℝ) := Complex.exp (↑(-2*Real.pi*(y*ξ)) * Complex.I)
  have hw' (y : ℝ) : HasDerivAt w (c*w y) y := by
    have he (x : ℝ) : ↑(-2*Real.pi*(x*ξ)) * Complex.I = (x:ℂ)*c := by
      dsimp only [c]
      push_cast
      ring
    have hwEq : w = (fun x : ℝ => Complex.exp ((x:ℂ)*c)) := by
      funext x
      dsimp only [w]
      rw [he]
    rw [hwEq]
    have hDeriv : HasDerivAt (fun x : ℝ => (x:ℂ)) 1 y := Complex.ofRealCLM.hasDerivAt
    simpa only [one_mul, mul_comm c (Complex.exp _)] using (hDeriv.mul_const c).cexp
  have hw (y : ℝ) : ‖w y‖ = 1 := Complex.norm_exp_ofReal_mul_I _
  have hwC : ContDiff ℝ 1 w := by
    have hInner : ContDiff ℝ 1 (fun y : ℝ => -2*Real.pi*(y*ξ)) := by fun_prop
    exact ((Complex.ofRealCLM.contDiff.comp hInner).mul contDiff_const).cexp
  let b (y : ℝ) := w y*a y
  have hba (l r : ℝ) : AbsolutelyContinuousOnInterval b l r := by
    have hwAC : AbsolutelyContinuousOnInterval w l r := hwC.contDiffOn.absolutelyContinuousOnInterval
    change AbsolutelyContinuousOnInterval (w • a) l r
    exact hwAC.smul (ha l r)
  have haC := locallyAbsolutelyContinuous_continuous ha
  have hAi := profile_integrable haC hQ
  have hDi := profile_derivative_integrable hQ
  have hwi {F : ℝ → ℂ} (hi : Integrable F) : Integrable (fun x => w x * F x) := by
    apply hi.norm.mono' (hwC.continuous.aestronglyMeasurable.mul hi.aestronglyMeasurable)
    exact Filter.Eventually.of_forall fun y => by
      change ‖w y*F y‖ ≤ ‖F y‖
      rw [norm_mul, hw, one_mul]
  have hdiff := (show LocallyBoundedVariationOn a univ from by
    intro l r hl hr
    exact (ha l r).boundedVariationOn.mono (by
      intro z hz
      exact Icc_subset_uIcc hz.2)).ae_differentiableAt
  let F (x : ℝ) := c*(w x*a x)
  let G (x : ℝ) := w x*deriv a x
  have hDer : deriv b =ᵐ[volume] (fun x => F x + G x) := by
    filter_upwards [hdiff] with x hx
    have hb' : HasDerivAt b ((c*w x)*a x + w x*deriv a x) x :=
      (hw' x).mul hx.hasDerivAt
    simpa only [F, G, mul_assoc] using hb'.deriv
  have hFi : Integrable F := (hwi hAi).const_mul c
  have hGi : Integrable G := hwi hDi
  have hbi : Integrable (deriv b) := (hFi.add hGi).congr hDer.symm
  have hlim {l : Filter ℝ} (h : Tendsto (fun y : ℝ => |y|) l atTop) :
      Tendsto b l (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    have ht : Tendsto (fun y : ℝ => (profileSize a).toReal * ((1+|y|)^4)⁻¹) l (𝓝 0) := by
      have ht' : Tendsto (fun y : ℝ => 1 + |y|) l atTop :=
        tendsto_atTop_mono (fun y => by linarith) h
      simpa only [Pi.inv_apply, ← inv_pow, zero_pow (by decide : (4:ℕ) ≠ 0), mul_zero] using
        (ht'.inv_tendsto_atTop.pow 4).const_mul (profileSize a).toReal
    apply squeeze_zero' (Filter.Eventually.of_forall fun _ => norm_nonneg _) ?_ ht
    filter_upwards [] with y
    rw [show ‖b y‖ = ‖a y‖ by simp [b,norm_mul, hw], ← div_eq_mul_inv]
    exact (le_div_iff₀ (by positivity)).mpr (by
      simpa only [mul_comm] using profileSize_amplitude_le haC hQ y)
  have hz : (∫ x, deriv b x) = 0 :=
    integral_deriv_complex_eq_zero hba hbi (hlim tendsto_abs_atBot_atTop) (hlim tendsto_abs_atTop_atTop)
  have hF (F : ℝ → ℂ) : 𝓕 F ξ = ∫ x, w x*F x := by
    rw [Real.fourier_eq']
    simp_rw [w, RCLike.inner_apply, conj_trivial, mul_comm ξ, smul_eq_mul]
  have hSum : c * 𝓕 a ξ + 𝓕 (deriv a) ξ = 0 := by
    calc
      _ = (∫ x, F x) + ∫ x, G x := by rw [hF a, hF (deriv a)]; simp only [F,G,integral_const_mul]
      _ = ∫ x, F x + G x := (integral_add hFi hGi).symm
      _ = _ := (integral_congr_ae hDer.symm).trans hz
  have hc : c = -(↑(2*Real.pi*ξ) * Complex.I) := by
    dsimp only [c]
    push_cast
    ring
  rw [hc, neg_mul] at hSum
  exact (neg_add_eq_zero.mp hSum).symm

private theorem dyadicProfileWeight_sum (S : Finset ℤ) {t : ℝ} (ht : 0 < t)
    (F : ℤ → ℝ) (hF₁ : ∀ k ∈ S, F k ≤ t*(2:ℝ)^k)
    (hF₂ : ∀ k ∈ S, F k ≤ (t*(2:ℝ)^k)⁻¹) : ∑ k ∈ S, F k ≤ 4 := by
  obtain ⟨m, hm⟩ := exists_mem_Ico_zpow (inv_pos.mpr ht) (show (1:ℝ) < 2 by norm_num)
  have hleft : t*(2:ℝ)^m ≤ 1 := by
    have h' := (le_div_iff₀ ht).mp (show (2:ℝ)^m ≤ 1/t from by simpa only [one_div] using hm.1)
    simpa only [mul_comm] using h'
  have hright : 1 ≤ t*(2:ℝ)^(m+1) := by
    have h' := (div_lt_iff₀ ht).mp (show 1/t < (2:ℝ)^(m+1) from by simpa only [one_div] using hm.2)
    exact h'.le.trans_eq (mul_comm _ _)
  have h₁ : (∑ k ∈ S.filter (fun k => k ≤ m), F k) ≤ 2 := by
    refine (Finset.sum_le_sum fun k hk => ?_).trans
      (dyadicProfileWeight_partial m fun k hk => (Finset.mem_filter.mp hk).2)
    rw [show (2:ℝ)^(k-m) = (t*(2:ℝ)^m)⁻¹ * (t*(2:ℝ)^k) by
      rw [zpow_sub₀ (by norm_num : (2:ℝ) ≠ 0)]
      field_simp [ht.ne']]
    exact (hF₁ k (Finset.mem_filter.mp hk).1).trans
      (le_mul_of_one_le_left (by positivity) (one_le_inv₀ (by positivity) |>.mpr hleft))
  have h₂ : (∑ k ∈ S.filter (fun k => ¬ k ≤ m), F k) ≤ 2 := by
    refine (Finset.sum_le_sum fun k hk => ?_).trans
      (dyadicProfileWeight_reverse (m+1) fun k hk => by
        have hh := (Finset.mem_filter.mp hk).2
        omega)
    rw [show (2:ℝ)^(m+1-k) = (t*(2:ℝ)^(m+1)) * (t*(2:ℝ)^k)⁻¹ by
      rw [zpow_sub₀ (by norm_num : (2:ℝ) ≠ 0)]
      field_simp [ht.ne']]
    exact (hF₂ k (Finset.mem_filter.mp hk).1).trans (le_mul_of_one_le_left (by positivity) hright)
  rw [← Finset.sum_filter_add_sum_filter_not S (fun k => k ≤ m)]
  linarith

private theorem scalarProfileWeight_le (t : ℝ) (ht : 0 < t) :
    t^2/(1+t)^4 ≤ t ∧ t^2/(1+t)^4 ≤ t⁻¹ := by
  have h : 0 < (1+t)^4 := by positivity
  constructor
  · apply (div_le_iff₀ h).mpr
    have h' : t ≤ (1+t)^4 := by
      calc
        _ ≤ 1+t := by linarith
        _ ≤ _ := by nth_rw 1 [← pow_one (1+t)]; exact pow_le_pow_right₀ (by linarith) (by decide)
    simpa only [pow_two, mul_comm] using mul_le_mul_of_nonneg_right h' ht.le
  · apply (div_le_iff₀ h).mpr
    rw [← div_eq_inv_mul, le_div_iff₀ ht]
    calc
      _ = t^3 := by ring
      _ ≤ (1+t)^3 := pow_le_pow_left₀ ht.le (by linarith) _
      _ ≤ _ := pow_le_pow_right₀ (by linarith) (by decide)

private theorem profileDilation_integrable {a : ℝ → ℂ} (ha : Integrable a) (k : ℤ) :
    Integrable (profileDilation a k) :=
  (ha.comp_mul_left' (R := (2:ℝ)^k) (by positivity)).const_mul _

private theorem profileDilation_difference {a : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r) (hQ : profileSize a ≠ ∞)
    (k : ℤ) (x u : ℝ) (hu : 2*|u| ≤ |x|) :
    ‖profileDilation a k (x-u)-profileDilation a k x‖ ≤
      (profileSize a).toReal * |u| * ((2:ℝ)^k)^2 / (1+(2:ℝ)^k*|x|/2)^4 := by
  let s : ℝ := (2:ℝ)^k
  have hs : 0 < s := by dsimp [s]; positivity
  let l := s*x
  let r := s*(x-u)
  have hI := profile_derivative_integrable hQ
  have hFTC := intervalIntegral_deriv_complex (ha l r) hI.intervalIntegrable
  have hweight : ∀ z ∈ uIoc l r, s*|x|/2 ≤ |z| := by
    intro z hz
    have hz' := uIoc_subset_uIcc hz
    have hd : |z-l| ≤ s*|u| := by
      have hl : |r-l| = s*|u| := by
        rw [show r-l = -(s*u) by dsimp [r,l]; ring, abs_neg, abs_mul, abs_of_pos hs]
      rw [← hl]
      rcases le_total l r with h | h
      · rw [uIcc_of_le h] at hz'
        rw [abs_of_nonneg (sub_nonneg.mpr hz'.1), abs_of_nonneg (sub_nonneg.mpr h)]
        linarith [hz'.2]
      · rw [uIcc_comm, uIcc_of_le h] at hz'
        rw [abs_of_nonpos (sub_nonpos.mpr hz'.2), abs_of_nonpos (sub_nonpos.mpr h)]
        linarith [hz'.1]
    have ht := abs_sub_le l z 0
    rw [sub_zero, sub_zero, abs_sub_comm l z, show |l| = s*|x| by
      rw [show l = s*x from rfl, abs_mul, abs_of_pos hs]] at ht
    linarith [mul_le_mul_of_nonneg_left hu hs.le]
  have hbound : ‖∫ z in l..r, deriv a z‖ ≤
      ((profileSize a).toReal / (1+s*|x|/2)^4) * |r-l| := by
    apply intervalIntegral.norm_integral_le_of_norm_le_const_ae
    filter_upwards [profileSize_derivative_le hQ] with z hz hz'
    exact hz.trans (div_le_div_of_nonneg_left ENNReal.toReal_nonneg (by positivity)
      (pow_le_pow_left₀ (by positivity) (by linarith [hweight z hz']) _))
  have hdiff : |r-l| = s*|u| := by
    rw [show r-l = -(s*u) by dsimp [r,l]; ring, abs_neg, abs_mul, abs_of_pos hs]
  rw [hFTC, hdiff] at hbound
  change ‖(s:ℂ)*a r-(s:ℂ)*a l‖ ≤ _
  rw [← mul_sub, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hs]
  exact (mul_le_mul_of_nonneg_left hbound hs.le).trans_eq (by
    change s*((profileSize a).toReal / (1+s*|x|/2)^4*(s*|u|)) =
      (profileSize a).toReal*|u| * s^2/(1+s*|x|/2)^4
    ring)

private theorem signedProfile_regular {a : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r) (hQ : profileSize a ≠ ∞)
    (S : Finset ℤ) (z : ℤ → ℂ) (hz : ∀ k ∈ S, ‖z k‖ ≤ 1) :
    scalarKernelRegular (fun y => ∑ k ∈ S, z k * profileDilation a k y)
      (16*(profileSize a).toReal) := by
  intro x u hu hx
  let t := |x|/2
  have ht : 0 < t := half_pos (abs_pos.mpr hx)
  let F (k : ℤ) := (t*(2:ℝ)^k)^2 / (1+t*(2:ℝ)^k)^4
  have hF₁ (k : ℤ) (_ : k ∈ S) : F k ≤ t*(2:ℝ)^k :=
    (scalarProfileWeight_le _ (by positivity)).1
  have hF₂ (k : ℤ) (_ : k ∈ S) : F k ≤ (t*(2:ℝ)^k)⁻¹ :=
    (scalarProfileWeight_le _ (by positivity)).2
  let C := 4*(profileSize a).toReal*|u|/|x|^2
  have hC : 0 ≤ C := by dsimp [C]; positivity
  rw [← Finset.sum_sub_distrib]
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ k ∈ S, C*F k := by
      apply Finset.sum_le_sum
      intro k hk
      rw [← mul_sub, norm_mul]
      have h₁ := mul_le_mul_of_nonneg_right (hz k hk)
        (norm_nonneg (profileDilation a k (x-u)-profileDilation a k x))
      rw [one_mul] at h₁
      refine h₁.trans ((profileDilation_difference ha hQ k x u hu).trans_eq ?_)
      dsimp only [C, F, t]
      rw [show (2:ℝ)^k*|x|/2 = |x|/2*(2:ℝ)^k by ring]
      field_simp [abs_ne_zero.mpr hx]
      <;> ring
    _ = C * (∑ k ∈ S, F k) := by rw [Finset.mul_sum]
    _ ≤ C*4 := mul_le_mul_of_nonneg_left (dyadicProfileWeight_sum S ht F hF₁ hF₂) hC
    _ = _ := by dsimp only [C]; ring

private theorem lineProfileScale_fourier (a : ℝ → ℂ) {s : ℝ} (hs : 0 < s) (ξ : ℝ) :
    𝓕 (fun x => (s:ℂ)*a (s*x)) ξ = 𝓕 a (s⁻¹*ξ) := by
  let F (x : ℝ) := Complex.exp (↑(-2*Real.pi*(x*(s⁻¹*ξ))) * Complex.I)*a x
  rw [Real.fourier_eq', Real.fourier_eq']
  simp_rw [RCLike.inner_apply, conj_trivial, mul_comm ξ, smul_eq_mul]
  change (∫ x, Complex.exp (↑(-2*Real.pi*(x*ξ)) * Complex.I)*((s:ℂ)*a (s*x))) =
    ∫ x, Complex.exp (↑(-2*Real.pi*((s⁻¹*ξ)*x)) * Complex.I)*a x
  have he (x : ℝ) : (s*x)*(s⁻¹*ξ) = x*ξ := by field_simp [hs.ne']
  conv_rhs => simp only [mul_comm (s⁻¹*ξ) _]
  change _ = ∫ x, F x
  calc
    _ = (s:ℂ) * ∫ x, F (s*x) := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      filter_upwards [] with x
      simp only [F, he]
      ring
    _ = _ := by
      rw [Measure.integral_comp_mul_left, abs_of_nonneg (inv_nonneg.mpr hs.le), Complex.real_smul,
        ← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ hs.ne', Complex.ofReal_one, one_mul]

private theorem profileDilation_fourier (a : ℝ → ℂ) (k : ℤ) (ξ : ℝ) :
    𝓕 (profileDilation a k) ξ = 𝓕 a ((2:ℝ)^(-k)*ξ) := by
  rw [zpow_neg]
  exact lineProfileScale_fourier a (zpow_pos (by norm_num) k) ξ

private theorem profileFourier_high {a : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r)
    (hQ : profileSize a ≠ ∞) {ξ : ℝ} (hξ : ξ ≠ 0) :
    ‖𝓕 a ξ‖ ≤ ((∫ y : ℝ, ((1+|y|)^4)⁻¹) / (2*Real.pi)) *
      (profileSize a).toReal * |ξ|⁻¹ := by
  let M := (profileSize a).toReal
  have h1 : ‖𝓕 (deriv a) ξ‖ ≤ M*(∫ y : ℝ, ((1+|y|)^4)⁻¹) := by
    have hm : ‖𝓕 (deriv a) ξ‖ ≤ ∫ x, ‖deriv a x‖ :=
      VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _
    refine hm.trans ?_
    rw [← integral_const_mul]
    exact integral_mono_ae (profile_derivative_integrable hQ).norm
      (profileWeight_integrable.const_mul M)
      ((profileSize_derivative_le hQ).mono fun _ hx => by simpa only [div_eq_mul_inv] using hx)
  rw [profileFourier_derivative ha hQ, norm_mul, norm_mul, Complex.norm_I, mul_one,
    Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_of_nonneg (by positivity : 0 ≤ 2*Real.pi)] at h1
  have hpos : 0 < 2*Real.pi*|ξ| := by positivity [Real.pi_pos, abs_pos.mpr hξ]
  have hh := (le_div_iff₀ hpos).mpr ((mul_comm ‖𝓕 a ξ‖ (2*Real.pi*|ξ|)).le.trans h1)
  refine hh.trans_eq ?_
  field_simp [Real.pi_ne_zero, abs_ne_zero.mpr hξ]
  ring

private theorem signedProfile_fourier {a : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r) (hQ : profileSize a ≠ ∞)
    (hzero : (∫ y, a y) = 0) (S : Finset ℤ) (z : ℤ → ℂ) (hz : ∀ k ∈ S, ‖z k‖ ≤ 1) :
    let B := max (2*Real.pi * (∫ y : ℝ, |y| * ((1+|y|)^4)⁻¹))
      ((∫ y : ℝ, ((1+|y|)^4)⁻¹) / (2*Real.pi))
    ∀ ξ, ‖𝓕 (fun y => ∑ k ∈ S, z k * profileDilation a k y) ξ‖ ≤ 4*B*(profileSize a).toReal := by
  let B₁ := 2*Real.pi * (∫ y : ℝ, |y| * ((1+|y|)^4)⁻¹)
  let B₂ := (∫ y : ℝ, ((1+|y|)^4)⁻¹) / (2*Real.pi)
  let B := max B₁ B₂
  let M := (profileSize a).toReal
  have hB₁ : 0 ≤ B₁ := mul_nonneg (by positivity) (integral_nonneg fun _ => by positivity)
  have hB : 0 ≤ B := hB₁.trans (le_max_left _ _)
  have haC := locallyAbsolutelyContinuous_continuous ha
  have hai := profile_integrable haC hQ
  dsimp only
  intro ξ
  change ‖𝓕 (fun y => ∑ k ∈ S, z k * profileDilation a k y) ξ‖ ≤ 4*B*M
  have he : 𝓕 (fun y => ∑ k ∈ S, z k * profileDilation a k y) ξ =
      ∑ k ∈ S, z k * 𝓕 a ((2:ℝ)^(-k)*ξ) := by
    rw [Real.fourier_eq]
    simp_rw [Finset.smul_sum, ← mul_smul_comm]
    rw [integral_finsetSum]
    · apply Finset.sum_congr rfl
      intro k _
      rw [integral_const_mul, ← Real.fourier_eq, profileDilation_fourier]
    · intro k _
      exact ((Real.fourierIntegral_convergent_iff ξ).2
        (profileDilation_integrable hai k)).const_mul (z k)
  rw [he]
  by_cases hξ : ξ = 0
  · have hZ := profileFourier_low haC hQ hzero 0
    simp only [abs_zero, mul_zero, norm_le_zero_iff] at hZ
    simp only [hξ, mul_zero, hZ, Finset.sum_const_zero, norm_zero]
    exact mul_nonneg (mul_nonneg (by norm_num) hB) ENNReal.toReal_nonneg
  let F (k : ℤ) := min (|ξ| * (2:ℝ)^(-k)) (|ξ| * (2:ℝ)^(-k))⁻¹
  have hf : ∑ k ∈ S, F k ≤ 4 := by
    let j (k : ℤ) := -k
    have h' := dyadicProfileWeight_sum (S.image j) (abs_pos.mpr hξ)
      (fun k => min (|ξ| * (2:ℝ)^k) (|ξ| * (2:ℝ)^k)⁻¹)
      (fun _ _ => min_le_left _ _) (fun _ _ => min_le_right _ _)
    rw [Finset.sum_image (fun a _ b _ h => neg_injective h)] at h'
    exact h'
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ k ∈ S, (B*M) * F k := by
      apply Finset.sum_le_sum
      intro k hk
      let η := (2:ℝ)^(-k)*ξ
      have hη : η ≠ 0 := mul_ne_zero (by positivity) hξ
      have hη' : |η| = |ξ| * (2:ℝ)^(-k) := by
        rw [show η = (2:ℝ)^(-k)*ξ from rfl, abs_mul, abs_of_nonneg (by positivity), mul_comm]
      have hl := (profileFourier_low haC hQ hzero η).trans
        (mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right (le_max_left B₁ B₂) ENNReal.toReal_nonneg) (abs_nonneg _))
      have hh := (profileFourier_high ha hQ hη).trans
        (mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right (le_max_right B₁ B₂) ENNReal.toReal_nonneg) (by positivity))
      have hmin : ‖𝓕 a η‖ ≤ (B*M)*F k := by
        rw [show F k = min |η| |η|⁻¹ by simp only [F, hη'],
          mul_min_of_nonneg _ _ (mul_nonneg hB ENNReal.toReal_nonneg)]
        exact le_min hl hh
      rw [norm_mul]
      exact (mul_le_mul_of_nonneg_right (hz k hk) (norm_nonneg _)).trans
        (by simpa only [one_mul] using hmin)
    _ = (B*M) * (∑ k ∈ S, F k) := by rw [Finset.mul_sum]
    _ ≤ (B*M)*4 := mul_le_mul_of_nonneg_left hf (mul_nonneg hB ENNReal.toReal_nonneg)
    _ = _ := by ring

private theorem lineProfileConvolution_finset_sum {S : Finset ℤ} {A : ℤ → ℝ → ℂ}
    {z : ℤ → ℂ} {f : ℝ → ℂ} {p : ℝ} (hp : 1 < p) (hm : Measurable f)
    (hf : MemLp f (ENNReal.ofReal p) volume)
    (hM : ∀ k ∈ S, Measurable (A k)) (hI : ∀ k ∈ S, Integrable (A k)) :
    lineProfileConvolution (fun y => ∑ k ∈ S, z k * A k y) f =ᵐ[volume]
      fun x => ∑ k ∈ S, z k * lineProfileConvolution (A k) f x := by
  classical
  have ha : ∀ᵐ x ∂(volume : Measure ℝ), ∀ k ∈ S,
      Integrable (fun y => A k y * f (x-y)) :=
    (eventually_all_finset S).2 fun k hk =>
      lineProfileConvolution_integrand_ae (hM k hk) (hI k hk) hm hp hf
  filter_upwards [ha] with x hx
  unfold lineProfileConvolution
  simp_rw [Finset.sum_mul, mul_assoc]
  rw [integral_finset_sum]
  · simp_rw [integral_const_mul]
  · intro k hk
    exact (hx k hk).const_mul (z k)

set_option maxHeartbeats 550000 in
private theorem lineProfile_signed {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ {a f : ℝ → ℂ},
      (∀ l r, AbsolutelyContinuousOnInterval a l r) → profileSize a ≠ ∞ →
      (∫ y, a y) = 0 → Measurable f → MemLp f (ENNReal.ofReal p) volume →
      ∀ (S : Finset ℤ) (z : ℤ → ℂ), (∀ k ∈ S, ‖z k‖ ≤ 1) →
      MemLp (fun x => ∑ k ∈ S, z k * lineProfileConvolution (profileDilation a k) f x)
        (ENNReal.ofReal p) volume ∧
      eLpNorm (fun x => ∑ k ∈ S, z k * lineProfileConvolution (profileDilation a k) f x)
        (ENNReal.ofReal p) volume ≤ C * profileSize a * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C₀, hC₀, hCZ⟩ := scalarCz hp
  let B := max (2*Real.pi * (∫ y : ℝ, |y| * ((1+|y|)^4)⁻¹))
    ((∫ y : ℝ, ((1+|y|)^4)⁻¹) / (2*Real.pi))
  let D : ℝ := max 16 (4*B)
  have hD : 0 ≤ D := (by norm_num : (0:ℝ) ≤ 16).trans (le_max_left _ _)
  refine ⟨C₀ * ENNReal.ofReal D, ENNReal.mul_ne_top hC₀ ENNReal.ofReal_ne_top, ?_⟩
  intro a f ha hQ hzero hm hf S z hz
  let K (y : ℝ) := ∑ k ∈ S, z k * profileDilation a k y
  let M := (profileSize a).toReal
  have hM : 0 ≤ M := ENNReal.toReal_nonneg
  have hi := profile_integrable (locallyAbsolutelyContinuous_continuous ha) hQ
  have hi' (k : ℤ) : Integrable (profileDilation a k) := profileDilation_integrable hi k
  have hm' (k : ℤ) : Measurable (profileDilation a k) :=
    measurable_const.mul ((locallyAbsolutelyContinuous_continuous ha).measurable.comp
      (measurable_const.mul measurable_id))
  have hKi : Integrable K := integrable_finset_sum _ fun k _ => (hi' k).const_mul (z k)
  have hReg : scalarKernelRegular K (D*M) := by
    intro x u hu hx
    exact (signedProfile_regular ha hQ S z hz x u hu hx).trans
      (div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_max_left 16 _) hM)
          (abs_nonneg u)) (by positivity))
  have hF (ξ : ℝ) : ‖𝓕 K ξ‖ ≤ D*M :=
    (signedProfile_fourier ha hQ hzero S z hz ξ).trans
      (mul_le_mul_of_nonneg_right (le_max_right 16 _) hM)
  have h := hCZ (mul_nonneg hD hM) hKi hReg hF hf
  have he := lineProfileConvolution_finset_sum hp hm hf (fun k _ => hm' k) (fun k _ => hi' k)
    (S := S) (z := z)
  refine ⟨h.1.ae_eq he, ?_⟩
  rw [← eLpNorm_congr_ae he]
  have hb := h.2
  rw [ENNReal.ofReal_mul hD, ENNReal.ofReal_toReal hQ, ← mul_assoc] at hb
  exact hb

private theorem coordinateProfileConvolution_congr_ae {d : ℕ} (i : Fin d) (a : ℝ → ℂ)
    {f g : (Fin d → ℝ) → ℂ} (h : f =ᵐ[volume] g) :
    coordinateProfileConvolution i a f =ᵐ[volume] coordinateProfileConvolution i a g := by
  filter_upwards [coordinateFiber_congr_ae i h] with x hx
  have hv := ((volume : Measure ℝ).measurePreserving_sub_left (x i)).quasiMeasurePreserving.ae hx
  unfold coordinateProfileConvolution
  apply integral_congr_ae
  filter_upwards [hv] with y hy
  exact congrArg (fun c => a y*c) hy

private theorem eLpNorm_bound_iff_moment {X E : Type*} [MeasurableSpace X]
    [NormedAddCommGroup E] {μ : Measure X} {f g : X → E} {p : ℝ}
    (hp : 0 < p) (hf : AEStronglyMeasurable f μ) (hg : AEStronglyMeasurable g μ)
    (C : ℝ≥0∞) :
    eLpNorm g (ENNReal.ofReal p) μ ≤ C * eLpNorm f (ENNReal.ofReal p) μ ↔
      (∫⁻ x, ‖g x‖ₑ ^ p ∂μ) ≤ C^p * ∫⁻ x, ‖f x‖ₑ^p ∂μ := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp)
      ENNReal.ofReal_ne_top hf,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp)
      ENNReal.ofReal_ne_top hg, ENNReal.toReal_ofReal hp.le, one_div]
  constructor
  · intro h
    have h' := ENNReal.rpow_le_rpow h hp.le
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le, ENNReal.rpow_inv_rpow hp.ne',
      ENNReal.rpow_inv_rpow hp.ne'] at h'
    exact h'
  · intro h
    have h' := ENNReal.rpow_le_rpow h (inv_nonneg.mpr hp.le)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le), ENNReal.rpow_rpow_inv hp.ne'] at h'
    exact h'

set_option maxHeartbeats 1000000 in
private theorem coordinateFiber_bound {n : ℕ} (i : Fin (n+1)) {p : ℝ} (h₀ : 0 < p)
    {C : ℝ≥0∞} (hC : C ≠ ∞) {f T : (Fin (n+1) → ℝ) → ℂ}
    (hfm : Measurable f) (hT : Measurable T) (hfp : MemLp f (ENNReal.ofReal p) volume)
    (W : (ℝ → ℂ) → ℝ → ℂ)
    (hline : ∀ g : ℝ → ℂ, Measurable g → MemLp g (ENNReal.ofReal p) volume →
      MemLp (W g) (ENNReal.ofReal p) volume ∧
        eLpNorm (W g) (ENNReal.ofReal p) volume ≤ C * eLpNorm g (ENNReal.ofReal p) volume)
    (hslice : ∀ (x : ℝ) (y : Fin n → ℝ), T (i.insertNth x y) =
      W (fun t => f (i.insertNth t y)) x) :
    MemLp T (ENNReal.ofReal p) volume ∧
      eLpNorm T (ENNReal.ofReal p) volume ≤ C*eLpNorm f (ENNReal.ofReal p) volume := by
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n+1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n+1) => ℝ) i).symm _
    let g := f ∘ e
    have hgm : Measurable g := hfm.comp e.measurable
    have hT' : Measurable (T ∘ e) := hT.comp e.measurable
    have hFin : (∫⁻ x, ‖f x‖ₑ^p) ≠ ∞ := by
      intro h
      have hh := hfp.eLpNorm_ne_top
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr h₀)
        ENNReal.ofReal_ne_top hfm.aestronglyMeasurable, ENNReal.toReal_ofReal h₀.le, h,
        ENNReal.top_rpow_of_pos (one_div_pos.mpr h₀)] at hh
      contradiction
    have hBound : eLpNorm T (ENNReal.ofReal p) volume ≤
        C*eLpNorm f (ENNReal.ofReal p) volume := by
      apply (eLpNorm_bound_iff_moment h₀ hfm.aestronglyMeasurable hT.aestronglyMeasurable _).mpr
      rw [← he.lintegral_comp_emb e.measurableEmbedding (fun x => ‖T x‖ₑ^p),
        ← he.lintegral_comp_emb e.measurableEmbedding (fun x => ‖f x‖ₑ^p)]
      change (∫⁻ y, ‖(T ∘ e) y‖ₑ^p ∂volume) ≤ C^p*∫⁻ y, ‖g y‖ₑ^p ∂volume
      rw [Measure.volume_eq_prod, lintegral_prod_symm' _ (hT'.enorm.pow_const p),
        lintegral_prod_symm' _ (hgm.enorm.pow_const p), ← lintegral_const_mul _ (hgm.enorm.pow_const p).lintegral_prod_left']
      apply lintegral_mono_ae
      have hFin' : (∫⁻ y, ∫⁻ x, ‖g (x,y)‖ₑ^p) ≠ ∞ := by
        rw [← lintegral_prod_symm' _ (hgm.enorm.pow_const p), ← Measure.volume_eq_prod]
        change (∫⁻ y, ‖f (e y)‖ₑ^p ∂volume) ≠ ∞
        rw [he.lintegral_comp_emb e.measurableEmbedding (fun x => ‖f x‖ₑ^p)]
        exact hFin
      filter_upwards [ae_lt_top (hgm.enorm.pow_const p).lintegral_prod_left' hFin'] with y hy
      let g' (x : ℝ) := g (x,y)
      have hgm' : Measurable g' := hgm.comp (measurable_id.prodMk measurable_const)
      have hgp' : MemLp g' (ENNReal.ofReal p) volume := by
        rw [memLp_iff]
        rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr h₀)
          ENNReal.ofReal_ne_top hgm'.aestronglyMeasurable, ENNReal.toReal_ofReal h₀.le]
        exact ENNReal.rpow_lt_top_of_nonneg (by positivity) hy.ne
      have hslice' (x : ℝ) : T (e (x,y)) = W g' x := hslice x y
      change (∫⁻ x : ℝ, ‖T (e (x,y))‖ₑ^p) ≤ C^p * ∫⁻ x : ℝ, ‖g' x‖ₑ^p
      simp_rw [hslice']
      have hb := hline g' hgm' hgp'
      exact (eLpNorm_bound_iff_moment h₀ hgm'.aestronglyMeasurable
        hb.1.aestronglyMeasurable _).mp hb.2
    have hMem : MemLp T (ENNReal.ofReal p) volume :=
      hBound.trans_lt (ENNReal.mul_lt_top hC.lt_top hfp.eLpNorm_lt_top)
    exact And.intro hMem hBound

private theorem coordinateProfile_signed {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ {d : ℕ} (i : Fin d) {a : ℝ → ℂ} {f : (Fin d → ℝ) → ℂ},
      (∀ l r, AbsolutelyContinuousOnInterval a l r) → profileSize a ≠ ∞ →
      (∫ y, a y) = 0 → Measurable f → MemLp f (ENNReal.ofReal p) volume →
      ∀ (S : Finset ℤ) (z : ℤ → ℂ), (∀ k ∈ S, ‖z k‖ ≤ 1) →
      MemLp (fun x => ∑ k ∈ S, z k * coordinateProfileConvolution i (profileDilation a k) f x)
        (ENNReal.ofReal p) volume ∧
      eLpNorm (fun x => ∑ k ∈ S, z k * coordinateProfileConvolution i (profileDilation a k) f x)
        (ENNReal.ofReal p) volume ≤ C * profileSize a * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C, hC, hline⟩ := lineProfile_signed hp
  refine ⟨C, hC, ?_⟩
  intro d i a f ha hQ hzero hfm hfp S z hz
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    have haC := locallyAbsolutelyContinuous_continuous ha
    have hDm (k : ℤ) : Measurable (profileDilation a k) :=
      measurable_const.mul (haC.measurable.comp (measurable_const.mul measurable_id))
    have hT : Measurable (fun x => ∑ k ∈ S,
        z k * coordinateProfileConvolution i (profileDilation a k) f x) :=
      Finset.measurable_sum _ fun k _ =>
        measurable_const.mul (coordinateProfileConvolution_measurable i (hDm k) hfm)
    refine coordinateFiber_bound i (zero_lt_one.trans hp) (ENNReal.mul_ne_top hC hQ)
      hfm hT hfp (fun g x => ∑ k ∈ S, z k*lineProfileConvolution (profileDilation a k) g x)
      (fun _ hm hf => hline ha hQ hzero hm hf S z hz) ?_
    intro x y
    unfold coordinateProfileConvolution lineProfileConvolution
    simp only [Fin.insertNth_apply_same, Fin.update_insertNth] <;> rfl

private theorem coordinateProfile_young {d : ℕ} (i : Fin d) {p : ℝ} (hp : 1 < p)
    {K : ℝ → ℂ} (hKm : Measurable K) (hK : Integrable K)
    {f : (Fin d → ℝ) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (coordinateProfileConvolution i K f) (ENNReal.ofReal p) volume ∧
      eLpNorm (coordinateProfileConvolution i K f) (ENNReal.ofReal p) volume ≤
        eLpNorm K 1 volume * eLpNorm f (ENNReal.ofReal p) volume := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let g := hf.aestronglyMeasurable.mk f
    have hm : Measurable g := hf.aestronglyMeasurable.stronglyMeasurable_mk.measurable
    have he : f =ᵐ[volume] g := hf.aestronglyMeasurable.ae_eq_mk
    have hg : MemLp g (ENNReal.ofReal p) volume := hf.ae_eq he
    have hb := coordinateFiber_bound i (zero_lt_one.trans hp)
      (memLp_one_iff_integrable.mpr hK).eLpNorm_ne_top hm
      (coordinateProfileConvolution_measurable i hKm hm) hg (lineProfileConvolution K)
      (fun _ hgm hgp => lineProfileConvolution_young hp.le hKm hK hgm hgp) (by
        intro x y
        unfold coordinateProfileConvolution lineProfileConvolution
        simp only [Fin.insertNth_apply_same, Fin.update_insertNth] <;> rfl)
    have hx := coordinateProfileConvolution_congr_ae i K he
    exact ⟨hb.1.ae_eq hx.symm, by rw [eLpNorm_congr_ae hx, eLpNorm_congr_ae he]; exact hb.2⟩

private theorem coordinateProfileSquare_moment {X : Type*} [MeasurableSpace X]
    {μ : Measure X} (S : Finset ℤ) {G : ℤ → X → ℂ}
    (hG : ∀ k ∈ S, Measurable (G k)) {p : ℝ} (hp : 0 < p)
    (B : ℝ≥0∞)
    (hB : ∀ u ∈ S.powerset,
      (∫⁻ x, ‖Auto.LittlewoodPaley.rademacherSignedSum S u (fun k => G k x)‖ₑ^p ∂μ) ≤ B) :
    (∫⁻ x, ENNReal.ofReal (Real.sqrt (∑ k ∈ S, ‖G k x‖^2)) ^ p ∂μ) ≤
      ENNReal.ofReal (12 * (2:ℝ)^(p/2)) * B := by
  let A := 12*(2:ℝ)^(p/2)/S.powerset.card
  have hA : 0 ≤ A := by dsimp only [A]; positivity
  have hpt (x : X) : ENNReal.ofReal (Real.sqrt (∑ k ∈ S, ‖G k x‖^2)) ^ p ≤
      ENNReal.ofReal A * ∑ u ∈ S.powerset,
        ‖Auto.LittlewoodPaley.rademacherSignedSum S u (fun k => G k x)‖ₑ^p := by
    have hh := ENNReal.ofReal_le_ofReal
      (Auto.Spherical.FLLRS.square_envelope_le_rademacher_moment S (fun k => G k x) hp.le)
    rw [ENNReal.ofReal_mul hA] at hh
    simpa only [A,
      ENNReal.ofReal_sum_of_nonneg (fun u hu => Real.rpow_nonneg (norm_nonneg _) _),
      ← ENNReal.ofReal_rpow_of_nonneg (Real.sqrt_nonneg _) hp.le,
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le, ofReal_norm] using hh
  have hm (u : Finset ℤ) : Measurable
      (fun x => ‖Auto.LittlewoodPaley.rademacherSignedSum S u (fun k => G k x)‖ₑ^p) := by
    apply Measurable.pow_const
    apply Measurable.enorm
    exact Finset.measurable_sum _ fun k hk => measurable_const.mul (hG k hk)
  apply (lintegral_mono hpt).trans
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    lintegral_finsetSum S.powerset (fun u _ => hm u)]
  calc
    _ ≤ ENNReal.ofReal A * ∑ u ∈ S.powerset, B :=
      mul_le_mul' le_rfl (Finset.sum_le_sum hB)
    _ = ENNReal.ofReal A * (S.powerset.card : ℝ≥0∞) * B := by
      rw [Finset.sum_const, nsmul_eq_mul, mul_assoc]
    _ = _ := by
      have hcard : (S.powerset.card : ℝ) ≠ 0 := by positivity
      rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul hA]
      simp only [A, div_mul_cancel₀ _ hcard]

set_option maxHeartbeats 1000000 in
/-- Signed dyadic profile sums and their square function are uniformly bounded in each coordinate. -/
theorem profileSquare {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ {d : ℕ} (i : Fin d) {a : ℝ → ℂ} {f : (Fin d → ℝ) → ℂ},
      (∀ l r, AbsolutelyContinuousOnInterval a l r) → profileSize a ≠ ∞ →
      (∫ y, a y) = 0 → MemLp f (ENNReal.ofReal p) volume →
      ∀ (S : Finset ℤ) (z : ℤ → ℂ), (∀ k ∈ S, ‖z k‖ ≤ 1) →
      let F (k : ℤ) := coordinateProfileConvolution i (profileDilation a k) f
      let Ts (x : Fin d → ℝ) := ∑ k ∈ S, z k * F k x
      let Tq (x : Fin d → ℝ) := Real.sqrt (∑ k ∈ S, ‖F k x‖^2)
      MemLp Ts (ENNReal.ofReal p) volume ∧ MemLp Tq (ENNReal.ofReal p) volume ∧
        eLpNorm Ts (ENNReal.ofReal p) volume + eLpNorm Tq (ENNReal.ofReal p) volume ≤
          C * profileSize a * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C₀, hC₀, hS₀⟩ := coordinateProfile_signed hp
  let D := ENNReal.ofReal (12*(2:ℝ)^(p/2))
  let C₁ := D^p⁻¹ * C₀
  have hp₀ : 0 < p := zero_lt_one.trans hp
  have hC₁ : C₁ ≠ ∞ := ENNReal.mul_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top) hC₀
  refine ⟨C₀+C₁, ENNReal.add_ne_top.mpr ⟨hC₀,hC₁⟩, ?_⟩
  intro d i a f ha hQ hzero hf S z hz
  let g := hf.aestronglyMeasurable.mk f
  have hgm : Measurable g := hf.aestronglyMeasurable.stronglyMeasurable_mk.measurable
  have hfg : f =ᵐ[volume] g := hf.aestronglyMeasurable.ae_eq_mk
  have hg : MemLp g (ENNReal.ofReal p) volume := hf.ae_eq hfg
  let F (k : ℤ) := coordinateProfileConvolution i (profileDilation a k) g
  let Ts (x : Fin d → ℝ) := ∑ k ∈ S, z k * F k x
  let Tq (x : Fin d → ℝ) := Real.sqrt (∑ k ∈ S, ‖F k x‖^2)
  have haC := locallyAbsolutelyContinuous_continuous ha
  have hFm (k : ℤ) : Measurable (F k) := coordinateProfileConvolution_measurable i
    (measurable_const.mul (haC.measurable.comp (measurable_const.mul measurable_id))) hgm
  have hTq : Measurable Tq := (Finset.measurable_sum _ fun k _ =>
    (hFm k).norm.pow_const 2).sqrt
  have hTs := hS₀ i ha hQ hzero hgm hg S z hz
  let M := ∫⁻ x, ‖g x‖ₑ^p
  have hMom := coordinateProfileSquare_moment S (fun k _ => hFm k) hp₀
    ((C₀*profileSize a)^p * M) (fun u _ => by
      have hh := hS₀ i ha hQ hzero hgm hg S (Auto.LittlewoodPaley.rademacherSign u)
        (fun k _ => by unfold Auto.LittlewoodPaley.rademacherSign; split <;> simp)
      exact (eLpNorm_bound_iff_moment hp₀ hgm.aestronglyMeasurable
        hh.1.aestronglyMeasurable _).mp hh.2)
  have hQBound : eLpNorm Tq (ENNReal.ofReal p) volume ≤
      C₁ * profileSize a * eLpNorm g (ENNReal.ofReal p) volume := by
    have hEq (x : Fin d → ℝ) : ‖Tq x‖ₑ = ENNReal.ofReal (Tq x) := by
      rw [← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
    have hh := ENNReal.rpow_le_rpow hMom (inv_nonneg.mpr hp₀.le)
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp₀)
        ENNReal.ofReal_ne_top hgm.aestronglyMeasurable,
      eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp₀)
        ENNReal.ofReal_ne_top hTq.aestronglyMeasurable, ENNReal.toReal_ofReal hp₀.le, one_div]
    simp_rw [hEq]
    dsimp only [C₁]
    change _ ≤ (D^p⁻¹*C₀)*profileSize a * M^p⁻¹
    change _ ≤ (D * ((C₀*profileSize a)^p*M))^p⁻¹ at hh
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
      ENNReal.rpow_rpow_inv hp₀.ne'] at hh
    simpa only [mul_assoc] using hh
  have hQMem : MemLp Tq (ENNReal.ofReal p) volume :=
    hQBound.trans_lt (ENNReal.mul_lt_top
      (ENNReal.mul_lt_top hC₁.lt_top hQ.lt_top) hg.eLpNorm_lt_top)
  have he := (eventually_all_finset S).2 fun k _ =>
    coordinateProfileConvolution_congr_ae i (profileDilation a k) hfg
  have heS : (fun x => ∑ k ∈ S, z k*coordinateProfileConvolution i (profileDilation a k) f x)
      =ᵐ[volume] Ts := by
    filter_upwards [he] with x hx
    exact Finset.sum_congr rfl fun k hk => congrArg (z k * ·) (hx k hk)
  have heQ : (fun x => Real.sqrt (∑ k ∈ S, ‖coordinateProfileConvolution i (profileDilation a k) f x‖^2))
      =ᵐ[volume] Tq := by
    filter_upwards [he] with x hx
    exact congrArg Real.sqrt
      (Finset.sum_congr rfl fun k hk => congrArg (fun s : ℂ => ‖s‖^2) (hx k hk))
  refine ⟨hTs.1.ae_eq heS.symm, hQMem.ae_eq heQ.symm, ?_⟩
  rw [eLpNorm_congr_ae heS, eLpNorm_congr_ae heQ, eLpNorm_congr_ae hfg, add_mul, add_mul]
  exact add_le_add hTs.2 hQBound

private theorem tentProfile_fourier_re (ξ : ℝ) :
    (𝓕 tentProfile ξ).re =
      ∫ y : ℝ, Real.cos (2*Real.pi*(y*ξ))*max (1-|y|) 0 := by
  let w (y : ℝ) := Complex.exp (↑(-2*Real.pi*(y*ξ))*Complex.I)
  have hw : Continuous w := by dsimp [w]; fun_prop
  have hI := profile_integrable tentProfile_lipschitz.continuous tentProfile_size_finite
  have hi : Integrable (fun y => w y*tentProfile y) := by
    apply hI.norm.mono' (hw.mul tentProfile_lipschitz.continuous).aestronglyMeasurable
    filter_upwards [] with x
    change ‖w x * tentProfile x‖ ≤ ‖tentProfile x‖
    rw [norm_mul, show ‖w x‖ = 1 from Complex.norm_exp_ofReal_mul_I _, one_mul]
  rw [Real.fourier_eq']
  simp_rw [RCLike.inner_apply, conj_trivial, mul_comm ξ, smul_eq_mul]
  change (∫ y, w y*tentProfile y).re = _
  rw [← Complex.reCLM_apply, ← Complex.reCLM.integral_comp_comm hi]
  apply integral_congr_ae
  filter_upwards [] with y
  simp only [Complex.reCLM_apply, tentProfile, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    mul_zero, sub_zero, w, Complex.exp_ofReal_mul_I_re]
  rw [show -2*Real.pi*(y*ξ) = -(2*Real.pi*(y*ξ)) by ring, Real.cos_neg]

private theorem tentProfile_fourier_difference_re_pos {ξ : ℝ} (hξ : ξ ≠ 0)
    (hsmall : |ξ| ≤ 1/2) : 0 < (𝓕 tentProfile (ξ/2) - 𝓕 tentProfile ξ).re := by
  let W (z y : ℝ) := Real.cos (2*Real.pi*(y*z))*max (1-|y|) 0
  have hC (z : ℝ) : Continuous (W z) := by dsimp [W]; fun_prop
  have hComp (z : ℝ) : HasCompactSupport (W z) := by
    refine HasCompactSupport.intro' (isCompact_Icc (a := (-1:ℝ)) (b := 1)) isClosed_Icc ?_
    intro x hx
    have ha : 1 ≤ |x| := by
      by_contra! hf
      exact hx (abs_le.mp hf.le)
    simp [W, max_eq_right (sub_nonpos.mpr ha)]
  have hi (z : ℝ) : Integrable (W z) := (hC z).integrable_of_hasCompactSupport (hComp z)
  have hmono (y : ℝ) (hy : |y| ≤ 1) :
      Real.cos (2*Real.pi*(y*ξ)) ≤ Real.cos (2*Real.pi*(y*(ξ/2))) := by
    let t := 2*Real.pi*|y| * |ξ|
    have ht : 0 ≤ t := by dsimp [t]; positivity
    have ht' : t ≤ Real.pi := by
      calc
        _ ≤ 2*Real.pi*1*(1/2) := mul_le_mul
          (mul_le_mul_of_nonneg_left hy (by positivity)) hsmall (by positivity) (by positivity)
        _ = _ := by ring
    have h₁ : |2*Real.pi*(y*ξ)| = t := by
      simp only [abs_mul, abs_of_nonneg (by norm_num : (0:ℝ) ≤ 2), abs_of_pos Real.pi_pos, t]
      ring
    have h₂ : |2*Real.pi*(y*(ξ/2))| = t/2 := by
      simp only [abs_mul, abs_div, abs_of_nonneg (by norm_num : (0:ℝ) ≤ 2),
        abs_of_pos Real.pi_pos, t]
      ring
    rw [← @Real.cos_abs (2*Real.pi*(y*ξ)), ← @Real.cos_abs (2*Real.pi*(y*(ξ/2))), h₁, h₂]
    exact Real.cos_le_cos_of_nonneg_of_le_pi (by positivity) ht' (by linarith)
  have hnonneg : 0 ≤ W (ξ/2) - W ξ := by
    intro y
    change 0 ≤ W (ξ/2) y - W ξ y
    rw [sub_nonneg]
    by_cases hy : |y| ≤ 1
    · exact mul_le_mul_of_nonneg_right (hmono y hy) (le_max_right _ _)
    · have h := max_eq_right (sub_nonpos.mpr (le_of_not_ge hy))
      simp [W,h]
  have hne : W (ξ/2) (1/2) - W ξ (1/2) ≠ 0 := by
    apply ne_of_gt
    rw [sub_pos]
    apply mul_lt_mul_of_pos_right _ (by norm_num)
    have hp := Real.pi_pos
    have hξp := abs_pos.mpr hξ
    rw [← @Real.cos_abs (2*Real.pi*((1/2)*ξ)), ← @Real.cos_abs (2*Real.pi*((1/2)*(ξ/2)))]
    simp only [abs_mul, abs_div, abs_of_nonneg (by norm_num : (0:ℝ) ≤ 1),
      abs_of_nonneg (by norm_num : (0:ℝ) ≤ 2), abs_of_pos hp]
    apply Real.cos_lt_cos_of_nonneg_of_le_pi (by positivity)
    · nlinarith [mul_le_mul_of_nonneg_left hsmall hp.le]
    · nlinarith [mul_pos hp hξp]
  rw [Complex.sub_re, tentProfile_fourier_re, tentProfile_fourier_re,
    ← integral_sub (hi (ξ/2)) (hi ξ)]
  exact integral_pos_of_integrable_nonneg_nonzero ((hC _).sub (hC _))
    ((hi _).sub (hi _)) hnonneg hne

private theorem tentProfile_hasCompactSupport : HasCompactSupport tentProfile :=
  HasCompactSupport.intro' isCompact_Icc isClosed_Icc fun y hy =>
    tentProfile_eq_zero (by
      by_contra! h
      exact hy (abs_le.mp h.le))

private theorem tentProfile_fourier_smooth : ContDiff ℝ (↑(⊤ : ℕ∞)) (𝓕 tentProfile) := by
  have h := @Real.contDiff_fourier ℂ _ _ ℝ _ _ _ _ _ tentProfile (⊤ : ℕ∞)
  apply h
  intro n hn
  exact ((continuous_norm.pow n).mul tentProfile_lipschitz.continuous.norm).integrable_of_hasCompactSupport
    tentProfile_hasCompactSupport.norm.mul_left

/-- The Fourier symbol of the difference between two adjacent tent averages. -/
noncomputable def tentFourierDifference (lam z : ℝ) : ℂ :=
  𝓕 tentProfile (lam*z/2) - 𝓕 tentProfile (lam*z)

private theorem tentFourierDifference_smooth (lam : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (tentFourierDifference lam) :=
  (tentProfile_fourier_smooth.comp (by fun_prop)).sub
    (tentProfile_fourier_smooth.comp (by fun_prop))

private theorem tentCorrectionMultiplier {c C : ℝ} (hc : 0 < c) (hcC : c < C) :
    ∃ lam : ℝ, 0 < lam ∧ ∃ M : ℝ → ℂ, ContDiff ℝ (↑(⊤ : ℕ∞)) M ∧ HasCompactSupport M ∧
      M 0 = 0 ∧
      (∀ z, c/2 < |z| → |z| < 2*C → tentFourierDifference lam z ≠ 0) ∧
      ∀ z, c ≤ |z| → |z| ≤ C → tentFourierDifference lam z * M z = 1 := by
  let lam := (4*C)⁻¹
  have hC := hc.trans hcC
  have hlam : 0 < lam := by dsimp [lam]; positivity
  let s : Set ℝ := {z | c/2 < |z| ∧ |z| < 2*C}
  let t : Set ℝ := {z | c ≤ |z| ∧ |z| ≤ C}
  have hs : IsOpen s :=
    (isOpen_lt continuous_const continuous_abs).inter (isOpen_lt continuous_abs continuous_const)
  have ht : IsClosed t :=
    (isClosed_le continuous_const continuous_abs).inter (isClosed_le continuous_abs continuous_const)
  have hst : t ⊆ s := fun z hz => ⟨by linarith [hz.1], by linarith [hz.2]⟩
  have hD {z : ℝ} (hz : z ∈ s) : tentFourierDifference lam z ≠ 0 := by
    have hz' : z ≠ 0 := by
      intro h
      have hh := hz.1
      rw [h, abs_zero] at hh
      linarith
    have hsmall : |lam*z| ≤ 1/2 := by
      rw [abs_mul, abs_of_pos hlam]
      have he : lam*(2*C) = 1/2 := by dsimp only [lam]; field_simp [hC.ne']; ring
      rw [← he]
      exact mul_le_mul_of_nonneg_left hz.2.le hlam.le
    intro he
    have hpos := tentProfile_fourier_difference_re_pos (mul_ne_zero hlam.ne' hz') hsmall
    exact hpos.ne' (congrArg Complex.re he)
  obtain ⟨b, hb, _, hbSupp, hbOne⟩ :=
    exists_contDiff_support_eq_eq_one_iff (n := (⊤ : ℕ∞)) hs ht hst
  have hbComp : HasCompactSupport b := by
    refine HasCompactSupport.intro' (isCompact_Icc (a := -(2*C)) (b := 2*C)) isClosed_Icc ?_
    intro z hz
    have : z ∉ s := fun h => hz (abs_le.mp h.2.le)
    simpa [← hbSupp] using this
  let M (z : ℝ) : ℂ := ↑(b z) / tentFourierDifference lam z
  have hMSupp : Function.support M ⊆ Function.support b := by
    intro z hz
    by_contra! hbz
    exact hz (by simp [M, Function.notMem_support.mp hbz])
  have hMc : HasCompactSupport M := hbComp.mono hMSupp
  have hMs : ContDiff ℝ (↑(⊤ : ℕ∞)) M := by
    apply contDiff_iff_contDiffAt.mpr
    intro z
    by_cases hz : tentFourierDifference lam z = 0
    · have hIn : z ∉ closure s := by
        have hclose : closure s ⊆ {y | c/2 ≤ |y| ∧ |y| ≤ 2*C} :=
          closure_minimal (fun y hy => ⟨hy.1.le,hy.2.le⟩)
            ((isClosed_le continuous_const continuous_abs).inter (isClosed_le continuous_abs continuous_const))
        intro h
        have h' := hclose h
        have hz' : z ≠ 0 := by
          intro he
          have hh := h'.1
          rw [he, abs_zero] at hh
          linarith
        have hh : |lam*z| ≤ 1/2 := by
          rw [abs_mul, abs_of_pos hlam]
          have he : lam*(2*C) = 1/2 := by dsimp only [lam]; field_simp [hC.ne']; ring
          rw [← he]
          exact mul_le_mul_of_nonneg_left h'.2 hlam.le
        exact (tentProfile_fourier_difference_re_pos (mul_ne_zero hlam.ne' hz') hh).ne'
          (congrArg Complex.re hz)
      apply (contDiffAt_const (c := (0:ℂ))).congr_of_eventuallyEq
      filter_upwards [isClosed_closure.isOpen_compl.mem_nhds hIn] with y hy
      have hby : b y = 0 := by
        have : y ∉ s := fun h => hy (subset_closure h)
        simpa [← hbSupp] using this
      simp [M,hby]
    · have hb' := (Complex.ofRealCLM.contDiff.comp hb).contDiffAt (x := z)
      have hi := (tentFourierDifference_smooth lam).contDiffAt.fun_inv hz
      simpa only [M, div_eq_mul_inv, Function.comp_apply, Complex.ofRealCLM_apply, Pi.mul_apply] using
        hb'.mul hi
  refine ⟨lam, hlam, M, hMs, hMc, by simp [M,tentFourierDifference], ?_, ?_⟩
  · exact fun z hlo hhi => hD (z := z) ⟨hlo,hhi⟩
  · intro z hlo hhi
    have hz : z ∈ t := ⟨hlo,hhi⟩
    rw [show M z = (↑(b z) : ℂ) / tentFourierDifference lam z from rfl, (hbOne z).mp hz,
      Complex.ofReal_one, mul_one_div_cancel (hD (hst hz))]

open scoped SchwartzMap in
/-- The sum of the sup norms of a profile's first four derivatives and the profile itself. -/
noncomputable def profileFourierFourNorm (g : 𝓢(ℝ, ℂ)) : ℝ :=
  ∑ j ∈ Finset.range 5, SchwartzMap.seminorm ℝ 0 j g

open scoped SchwartzMap in
private theorem profileFourierFourNorm_nonneg (g : 𝓢(ℝ, ℂ)) :
    0 ≤ profileFourierFourNorm g := Finset.sum_nonneg fun _ _ => apply_nonneg _ _

open scoped SchwartzMap in
private theorem profileFourierFourNorm_controls (g : 𝓢(ℝ, ℂ)) {j : ℕ} (hj : j ≤ 4) (x : ℝ) :
    ‖iteratedFDeriv ℝ j g x‖ ≤ profileFourierFourNorm g := by
  refine (SchwartzMap.norm_iteratedFDeriv_le_seminorm ℝ g j x).trans ?_
  exact Finset.single_le_sum (fun _ _ => apply_nonneg _ _)
    (Finset.mem_range.mpr (by omega : j < 5))

open scoped SchwartzMap in
set_option maxHeartbeats 850000 in
private theorem compactProfile_product_moment {M : ℝ → ℂ} (hMs : ContDiff ℝ (↑(⊤ : ℕ∞)) M)
    (hMc : HasCompactSupport M) :
    ∃ H : ℝ, 0 ≤ H ∧ ∀ (g : 𝓢(ℝ, ℂ)) (k n : ℕ), k ≤ 1 → n ≤ 4 →
      (∫ y : ℝ, ‖y‖^k * ‖iteratedFDeriv ℝ n (fun z => M z*g z) y‖) ≤
        H * profileFourierFourNorm g := by
  let m := hMc.toSchwartzMap hMs
  let S := tsupport M
  let J := ∫ y : ℝ in S, (1+‖y‖)
  have hS : MeasurableSet S := isClosed_closure.measurableSet
  have hJ : 0 ≤ J := integral_nonneg fun _ => by positivity
  let D := ∑ n ∈ Finset.range 5, ∑ i ∈ Finset.range (n+1),
    (n.choose i : ℝ) * SchwartzMap.seminorm ℝ 0 i m
  have hD : 0 ≤ D := by dsimp [D]; positivity
  refine ⟨D*J, mul_nonneg hD hJ, ?_⟩
  intro g k n hk hn
  let F := fun z : ℝ => M z*g z
  have hF : ContDiff ℝ (↑(⊤ : ℕ∞)) F := hMs.mul (g.smooth ⊤)
  have hFc : HasCompactSupport F := hMc.mul_right
  let B := profileFourierFourNorm g
  have hB : 0 ≤ B := profileFourierFourNorm_nonneg g
  have hDerivative (y : ℝ) : ‖iteratedFDeriv ℝ n F y‖ ≤ D*B := by
    refine (norm_iteratedFDeriv_mul_le hMs (g.smooth ⊤) y (show (n : WithTop ℕ∞) ≤ ↑(⊤ : ℕ∞) by simp)).trans ?_
    calc
      _ ≤ ∑ i ∈ Finset.range (n+1), ((n.choose i : ℝ) * SchwartzMap.seminorm ℝ 0 i m) * B := by
        apply Finset.sum_le_sum
        intro i hi
        exact mul_le_mul
          (mul_le_mul_of_nonneg_left (SchwartzMap.norm_iteratedFDeriv_le_seminorm ℝ m i y)
            (Nat.cast_nonneg _))
          (profileFourierFourNorm_controls g (by omega : n-i ≤ 4) y)
          (norm_nonneg _) (by positivity)
      _ ≤ _ := by
        rw [← Finset.sum_mul]
        apply mul_le_mul_of_nonneg_right _ hB
        exact Finset.single_le_sum (f := fun n : ℕ => ∑ i ∈ Finset.range (n+1),
          (n.choose i : ℝ) * SchwartzMap.seminorm ℝ 0 i m) (fun _ _ => by positivity)
          (Finset.mem_range.mpr (by omega : n < 5))
  have hzero {y : ℝ} (hy : y ∉ S) : iteratedFDeriv ℝ n F y = 0 := by
    by_contra hz
    apply hy
    apply closure_mono (s := Function.support F) (t := Function.support M) _
      (support_iteratedFDeriv_subset n hz)
    intro z hz'
    exact left_ne_zero_of_mul (show M z*g z ≠ 0 from hz')
  let W (y : ℝ) := (D*B)*(1+‖y‖)
  have hWI : IntegrableOn W S :=
    (show Continuous W from by dsimp [W]; fun_prop).continuousOn.integrableOn_compact hMc
  have hFi : Integrable (fun y : ℝ => ‖y‖^k * ‖iteratedFDeriv ℝ n F y‖) :=
    ((continuous_norm.pow k).mul
      (hF.continuous_iteratedFDeriv (by simp)).norm).integrable_of_hasCompactSupport
      (hFc.iteratedFDeriv n).norm.mul_left
  have hI' : Integrable (S.indicator W) := (integrable_indicator_iff hS).mpr hWI
  have hCompare (y : ℝ) : ‖y‖^k * ‖iteratedFDeriv ℝ n F y‖ ≤ S.indicator W y := by
    by_cases hy : y ∈ S
    · rw [Set.indicator_of_mem hy]
      have hk' : ‖y‖^k ≤ 1+‖y‖ := by
        rcases (show k = 0 ∨ k = 1 by omega) with rfl | rfl <;> simp
      exact (mul_le_mul hk' (hDerivative y) (by positivity) (by positivity)).trans_eq (mul_comm _ _)
    · rw [Set.indicator_of_notMem hy, hzero hy, norm_zero, mul_zero]
  refine (integral_mono hFi hI' hCompare).trans_eq ?_
  rw [integral_indicator hS, show W = fun y => (D*B)*(1+‖y‖) from rfl, integral_const_mul]
  change (D*B)*J = (D*J)*B
  ring

open scoped SchwartzMap in
set_option maxHeartbeats 950000 in
private theorem compactProfile_inverse_bound {M : ℝ → ℂ} (hMs : ContDiff ℝ (↑(⊤ : ℕ∞)) M)
    (hMc : HasCompactSupport M) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (g : 𝓢(ℝ, ℂ)),
      profileSize (𝓕⁻ (fun z => M z*g z)) ≤ ENNReal.ofReal (C * profileFourierFourNorm g) := by
  obtain ⟨H, hH, hMom⟩ := compactProfile_product_moment hMs hMc
  let A := (max 1 (2*Real.pi)) * (4:ℝ)^4 * 10 * H
  have hA : 0 ≤ A := by dsimp only [A]; positivity
  refine ⟨64*A, by positivity, ?_⟩
  intro g
  let F := fun z : ℝ => M z*g z
  have hFs : ContDiff ℝ (↑(⊤ : ℕ∞)) F := hMs.mul (g.smooth ⊤)
  have hFc : HasCompactSupport F := hMc.mul_right
  let B := profileFourierFourNorm g
  have hB : 0 ≤ B := profileFourierFourNorm_nonneg g
  let v : ℝ → ℂ := 𝓕⁻ F
  have hFourier (k n : ℕ) (hk : k ≤ 1) (hn : n ≤ 4) (y : ℝ) :
      ‖y‖^n * ‖iteratedFDeriv ℝ k (𝓕 F) y‖ ≤ A*B := by
    have hInt (j l : ℕ) (_hj : j ≤ (1 : ℕ∞)) (_hl : l ≤ (4 : ℕ∞)) :
        Integrable (fun x : ℝ => ‖x‖^j * ‖iteratedFDeriv ℝ l F x‖) :=
      ((continuous_norm.pow j).mul (hFs.continuous_iteratedFDeriv (by simp)).norm).integrable_of_hasCompactSupport
        (hFc.iteratedFDeriv l).norm.mul_left
    have hP := Real.pow_mul_norm_iteratedFDeriv_fourier_le
      (hFs.of_le (show ((4:ℕ∞):WithTop ℕ∞) ≤ ↑(⊤ : ℕ∞) by simp)) hInt
      (show (k:ℕ∞) ≤ 1 by exact_mod_cast hk) (show (n:ℕ∞) ≤ 4 by exact_mod_cast hn) y
    have hSum : (∑ b ∈ Finset.range (k+1) ×ˢ Finset.range (n+1),
        ∫ x : ℝ, ‖x‖^b.1 * ‖iteratedFDeriv ℝ b.2 F x‖) ≤ 10*(H*B) := by
      calc
        _ ≤ ∑ b ∈ Finset.range (k+1) ×ˢ Finset.range (n+1), H*B := by
          apply Finset.sum_le_sum
          intro b hb
          have hb' := Finset.mem_product.mp hb
          exact hMom g b.1 b.2 (by have := Finset.mem_range.mp hb'.1; omega)
            (by have := Finset.mem_range.mp hb'.2; omega)
        _ ≤ _ := by
          rw [Finset.sum_const, nsmul_eq_mul, Finset.card_product, Finset.card_range, Finset.card_range]
          refine mul_le_mul_of_nonneg_right ?_ (mul_nonneg hH hB)
          have hCard : (k+1)*(n+1) ≤ 10 :=
            (Nat.mul_le_mul (show k+1 ≤ 2 by omega) (show n+1 ≤ 5 by omega)).trans_eq (by decide)
          exact_mod_cast hCard
    refine hP.trans ?_
    have hr : (2*Real.pi)^k ≤ max 1 (2*Real.pi) := by
      rcases (show k = 0 ∨ k = 1 by omega) with rfl | rfl
      · simpa using (le_max_left (1:ℝ) (2*Real.pi))
      · simpa using (le_max_right (1:ℝ) (2*Real.pi))
    have hr' : (2*(k:ℝ)+2)^n ≤ (4:ℝ)^4 := by
      have hk' : (k : ℝ) ≤ 1 := by exact_mod_cast hk
      have he : (2*(k:ℝ)+2)^n ≤ (4:ℝ)^n :=
        pow_le_pow_left₀ (by positivity) (by linarith) _
      exact he.trans (pow_le_pow_right₀ (by norm_num) hn)
    calc
      _ ≤ (max 1 (2*Real.pi)) * (4:ℝ)^4 * (10*(H*B)) := by
        exact mul_le_mul (mul_le_mul hr hr' (by positivity) (by positivity))
          hSum (Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => by positivity) (by positivity)
      _ = _ := by dsimp only [A]; ring
  have hv : v = fun y => 𝓕 F (-y) := funext (Real.fourierInv_eq_fourier_neg F)
  have hV (n : ℕ) (hn : n ≤ 4) (y : ℝ) :
      |y|^n * ‖v y‖ ≤ A*B ∧ |y|^n * ‖deriv v y‖ ≤ A*B := by
    have h₀ := hFourier 0 n (by omega) hn (-y)
    have h₁ := hFourier 1 n le_rfl hn (-y)
    rw [hv, deriv_comp_neg]
    constructor
    · simpa only [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_zero, norm_neg,
        Real.norm_eq_abs] using h₀
    · simpa only [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_one, norm_neg,
        Real.norm_eq_abs] using h₁
  change profileSize v ≤ ENNReal.ofReal (64*A*B)
  let W (x : ℝ) := ENNReal.ofReal ((1+|x|)^4 * (‖v x‖ + ‖deriv v x‖))
  have hb : IsCoboundedUnder (· ≤ ·) (ae (volume : Measure ℝ)) W :=
    isCoboundedUnder_le_of_le _ (x := (0:ℝ≥0∞)) (fun _ => zero_le)
  apply essSup_le_of_ae_le _ (f := W) _ hb
  filter_upwards [] with y
  apply ENNReal.ofReal_le_ofReal
  have h₀ := hV 0 (by omega) y
  have h₄ := hV 4 le_rfl y
  simp only [pow_zero, one_mul] at h₀
  by_cases hy : |y| ≤ 1
  · have hpow : (1+|y|)^4 ≤ (16:ℝ) := by
      calc _ ≤ (2:ℝ)^4 := pow_le_pow_left₀ (by positivity) (by linarith) _
           _ = _ := by norm_num
    exact (mul_le_mul hpow (add_le_add h₀.1 h₀.2) (by positivity) (by norm_num)).trans (by nlinarith)
  · have hpow : (1+|y|)^4 ≤ (16:ℝ)*|y|^4 := by
      calc
        _ ≤ (2*|y|)^4 := pow_le_pow_left₀ (by positivity) (by linarith) _
        _ = _ := by ring
    calc
      _ ≤ (16*|y|^4)*(‖v y‖+‖deriv v y‖) :=
        mul_le_mul_of_nonneg_right hpow (by positivity)
      _ = 16*(|y|^4*‖v y‖+|y|^4*‖deriv v y‖) := by ring
      _ ≤ _ := by nlinarith [h₄.1,h₄.2,mul_nonneg hA hB]

open scoped SchwartzMap in
set_option maxHeartbeats 750000 in
/-- A fixed annulus admits a uniformly bounded Schwartz correction for the tent difference. -/
theorem tentInverse {c C : ℝ} (hc : 0 < c) (hcC : c < C) :
    ∃ lam L : ℝ, 0 < lam ∧ 0 ≤ L ∧
      (∀ z, c/2 < |z| → |z| < 2*C → tentFourierDifference lam z ≠ 0) ∧
      ∀ ψ : 𝓢(ℝ, ℂ),
        Function.support ((𝓕 ψ : 𝓢(ℝ, ℂ)) : ℝ → ℂ) ⊆ {z | c ≤ |z| ∧ |z| ≤ C} →
        ∃ v : 𝓢(ℝ, ℂ), (∫ y, v y) = 0 ∧
          (∀ z, tentFourierDifference lam z * (𝓕 v : 𝓢(ℝ, ℂ)) z = (𝓕 ψ : 𝓢(ℝ, ℂ)) z) ∧
          profileSize v ≤ ENNReal.ofReal (L * profileFourierFourNorm (𝓕 ψ)) := by
  obtain ⟨lam, hlam, M, hMs, hMc, hM₀, hD, hM⟩ := tentCorrectionMultiplier hc hcC
  obtain ⟨L, hL, hB⟩ := compactProfile_inverse_bound hMs hMc
  refine ⟨lam, L, hlam, hL, hD, ?_⟩
  intro ψ hψ
  let g : 𝓢(ℝ, ℂ) := 𝓕 ψ
  let F (z : ℝ) := M z*g z
  have hFs : ContDiff ℝ (↑(⊤ : ℕ∞)) F := hMs.mul (g.smooth ⊤)
  have hFc : HasCompactSupport F := hMc.mul_right
  let Z := hFc.toSchwartzMap hFs
  let v : 𝓢(ℝ, ℂ) := 𝓕⁻ Z
  have hV : 𝓕 v = Z := FourierTransform.fourier_fourierInv_eq Z
  have hZ (z : ℝ) : Z z = F z := rfl
  have hV₀ : (𝓕 v : 𝓢(ℝ, ℂ)) 0 = 0 := by rw [hV,hZ]; simp [F,hM₀]
  refine ⟨v, ?_, ?_, ?_⟩
  · rw [SchwartzMap.fourier_coe, Real.fourier_eq] at hV₀
    simpa using hV₀
  · intro z
    rw [hV,hZ]
    change tentFourierDifference lam z * (M z*g z) = g z
    by_cases hz : g z = 0
    · simp [hz]
    · have hs : z ∈ {z | c ≤ |z| ∧ |z| ≤ C} := hψ hz
      rw [← mul_assoc, hM z hs.1 hs.2, one_mul]
  · change profileSize (⇑(𝓕⁻ Z : 𝓢(ℝ, ℂ))) ≤ _
    rw [SchwartzMap.fourierInv_coe]
    change profileSize (𝓕⁻ (fun z => M z*g z)) ≤ _
    exact hB g

/-- The integer label of the translated half-open cell containing a point. -/
noncomputable def translatedProfileCell (L s x : ℝ) : ℤ := ⌊(x-s)/L⌋

/-- The indicator that two points lie in a common translated cell. -/
noncomputable def translatedProfileMatch (L x y s : ℝ) : ℝ :=
  if translatedProfileCell L s x = translatedProfileCell L s y then 1 else 0

private theorem translatedProfileMatch_measurable (L x : ℝ) :
    Measurable (fun z : ℝ×ℝ => translatedProfileMatch L x z.2 z.1) := by
  have h₁ : Measurable (fun z : ℝ×ℝ => translatedProfileCell L z.1 x) :=
    Int.measurable_floor.comp ((measurable_const.sub measurable_fst).div_const L)
  have h₂ : Measurable (fun z : ℝ×ℝ => translatedProfileCell L z.1 z.2) :=
    Int.measurable_floor.comp ((measurable_snd.sub measurable_fst).div_const L)
  exact Measurable.ite (measurableSet_eq_fun h₁ h₂) measurable_const measurable_const

private theorem translatedProfileMatch_range (L x y s : ℝ) :
    0 ≤ translatedProfileMatch L x y s ∧ translatedProfileMatch L x y s ≤ 1 := by
  unfold translatedProfileMatch
  split <;> norm_num

private theorem translatedProfileMatch_periodic {L : ℝ} (hL : 0 < L) (x y : ℝ) :
    Function.Periodic (translatedProfileMatch L x y) L := by
  intro s
  have he (z : ℝ) : translatedProfileCell L (s+L) z = translatedProfileCell L s z - 1 := by
    unfold translatedProfileCell
    rw [show (z-(s+L))/L = (z-s)/L-(↑(1:ℤ):ℝ) by push_cast; field_simp [hL.ne']; ring,
      Int.floor_sub_intCast]
  simp only [translatedProfileMatch, he, sub_left_inj]

private theorem translatedProfileMatch_intervalIntegrable (L x y a b : ℝ) :
    IntervalIntegrable (translatedProfileMatch L x y) volume a b := by
  have hm : Measurable (translatedProfileMatch L x y) :=
    (translatedProfileMatch_measurable L x).comp (measurable_id.prodMk
    (measurable_const (a := y)))
  apply IntervalIntegrable.mono_fun'
    (g := fun _ : ℝ => (1:ℝ)) (intervalIntegrable_const) hm.aestronglyMeasurable
  exact Filter.Eventually.of_forall fun s =>
    by simpa only [Real.norm_eq_abs, abs_of_nonneg (translatedProfileMatch_range L x y s).1]
      using (translatedProfileMatch_range L x y s).2

set_option maxHeartbeats 600000 in
private theorem translatedProfileMatch_integral_period {L : ℝ} (hL : 0 < L) (x y : ℝ) :
    (∫ s in (0:ℝ)..L, translatedProfileMatch L x y s) = max (L-|x-y|) 0 := by
  wlog hxy : x ≤ y generalizing x y
  · have he : translatedProfileMatch L x y = translatedProfileMatch L y x := by
      funext s
      simp only [translatedProfileMatch, eq_comm]
    rw [he, this y x (le_of_not_ge hxy), abs_sub_comm]
  have hP := translatedProfileMatch_periodic hL x y
  have he := hP.intervalIntegral_add_eq 0 (x-L)
  rw [zero_add, sub_add_cancel] at he
  rw [he, intervalIntegral.integral_of_le (by linarith), abs_of_nonpos (sub_nonpos.mpr hxy)]
  have hI : EqOn (translatedProfileMatch L x y) ((Ioc (y-L) x).indicator (fun _ => (1:ℝ)))
      (Ioc (x-L) x) := by
    intro s hs
    have h₀ : translatedProfileCell L s x = 0 := by
      apply Int.floor_eq_zero_iff.mpr
      exact ⟨div_nonneg (sub_nonneg.mpr hs.2) hL.le,
        (div_lt_iff₀ hL).mpr (by linarith [hs.1])⟩
    have h₁ : translatedProfileCell L s y = 0 ↔ s ∈ Ioc (y-L) x := by
      rw [translatedProfileCell, Int.floor_eq_zero_iff]
      constructor
      · intro h
        have hh := (div_lt_iff₀ hL).mp h.2
        exact ⟨by linarith, hs.2⟩
      · intro h
        exact ⟨div_nonneg (sub_nonneg.mpr (hs.2.trans hxy)) hL.le,
          (div_lt_iff₀ hL).mpr (by linarith [h.1])⟩
    have hs' : 0 = translatedProfileCell L s y ↔ s ∈ Ioc (y-L) x := eq_comm.trans h₁
    by_cases h : s ∈ Ioc (y-L) x
    · simp [translatedProfileMatch, h₀, hs'.mpr h, h]
    · simp [translatedProfileMatch, h₀, mt hs'.mp h, h]
  rw [setIntegral_congr_fun measurableSet_Ioc hI, setIntegral_indicator measurableSet_Ioc,
    inter_eq_right.mpr (Ioc_subset_Ioc_left (sub_le_sub_right hxy L)), setIntegral_const, smul_eq_mul, mul_one,
    measureReal_def, Real.volume_Ioc, ENNReal.toReal_ofReal']
  congr 1
  ring

private theorem translatedProfileMatch_window {L : ℝ} (hL : 0 < L) {N : ℕ} (hN : 0 < N)
    (x y : ℝ) : (N*L)⁻¹ * (∫ s in (0:ℝ)..N*L, translatedProfileMatch L x y s) =
      max (1-|x-y|/L) 0 := by
  have hp := (translatedProfileMatch_periodic hL x y).intervalIntegral_add_zsmul_eq
    (N:ℤ) 0 (translatedProfileMatch_intervalIntegrable L x y)
  simp only [zero_add, zsmul_eq_mul, Int.cast_natCast] at hp
  rw [hp, translatedProfileMatch_integral_period hL]
  have hN' : (N:ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hN.ne'
  have he : (N*L)⁻¹ * ((N:ℝ) * max (L-|x-y|) 0) = L⁻¹*max (L-|x-y|) 0 := by
    field_simp [hN', hL.ne']
  rw [he, mul_max_of_nonneg _ _ (inv_nonneg.mpr hL.le), mul_zero]
  congr 1
  field_simp [hL.ne']

/-- Average on the half-open interval of the translated grid that contains (x). -/
noncomputable def translatedGridExpectation (L s : ℝ) (f : ℝ → ℂ) (x : ℝ) : ℂ :=
  (↑L⁻¹ : ℂ) * ∫ y, (translatedProfileMatch L x y s : ℂ) * f y

/-- The rescaled tent kernel at an arbitrary positive interval length. -/
noncomputable def gridTentKernel (L : ℝ) (y : ℝ) : ℂ :=
  (↑L⁻¹ : ℂ) * tentProfile (y/L)

set_option maxHeartbeats 650000 in
private theorem translatedGridExpectation_window {L : ℝ} (hL : 0 < L) {N : ℕ} (hN : 0 < N)
    {f : ℝ → ℂ} (hf : Integrable f) (x : ℝ) :
    (↑((N:ℝ)*L)⁻¹ : ℂ) * (∫ s in Ico 0 ((N:ℝ)*L), translatedGridExpectation L s f x) =
      lineProfileConvolution (gridTentKernel L) f x := by
  let R := (N:ℝ)*L
  have hR : 0 < R := mul_pos (by exact_mod_cast hN) hL
  let ν := (volume : Measure ℝ).restrict (Ioc 0 R)
  let H (z : ℝ×ℝ) := (translatedProfileMatch L x z.2 z.1 : ℂ) * f z.2
  haveI : IsFiniteMeasure ν :=
    ⟨by rw [show ν = volume.restrict (Ioc 0 R) from rfl, Measure.restrict_apply_univ]
        exact measure_Ioc_lt_top⟩
  have hI := hf.comp_snd ν
  have hMatch : Measurable (fun z : ℝ×ℝ => (translatedProfileMatch L x z.2 z.1 : ℂ)) :=
    Complex.continuous_ofReal.measurable.comp (translatedProfileMatch_measurable L x)
  have hHM : AEStronglyMeasurable H (ν.prod volume) :=
    hMatch.aestronglyMeasurable.mul hI.aestronglyMeasurable
  have hH : Integrable H (ν.prod volume) := by
    apply hI.norm.mono' hHM
    filter_upwards [] with z
    have h := translatedProfileMatch_range L x z.2 z.1
    change ‖(translatedProfileMatch L x z.2 z.1 : ℂ) * f z.2‖ ≤ ‖f z.2‖
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h.1]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right h.2 (norm_nonneg (f z.2))
  rw [integral_Ico_eq_integral_Ioc]
  change (↑R⁻¹ : ℂ) * (∫ s, (↑L⁻¹ : ℂ) * (∫ y, H (s,y)) ∂ν) = _
  rw [integral_const_mul, integral_integral_swap hH, lineProfileConvolution_right]
  simp_rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with y
  have he : (∫ s, (translatedProfileMatch L x y s : ℂ) ∂ν) =
      Complex.ofReal (∫ s in (0:ℝ)..R, translatedProfileMatch L x y s) := by
    rw [integral_complex_ofReal, intervalIntegral.integral_of_le hR.le]
  rw [integral_const_mul, integral_const_mul]
  change ↑R⁻¹ * (↑L⁻¹ * ∫ s, H (s,y) ∂ν) = f y * gridTentKernel L (x-y)
  rw [show (∫ s, H (s,y) ∂ν) = (∫ s, (translatedProfileMatch L x y s : ℂ) ∂ν)*f y by
    exact integral_mul_const (μ := ν) (f y) (fun s => (translatedProfileMatch L x y s : ℂ)), he]
  have hw := congrArg Complex.ofReal (translatedProfileMatch_window hL hN x y)
  simp only [Complex.ofReal_mul] at hw
  have hw' : (↑R⁻¹ : ℂ) * ↑(∫ s in (0:ℝ)..R, translatedProfileMatch L x y s) =
      tentProfile ((x-y)/L) := by
    simpa only [tentProfile, abs_div, abs_of_pos hL] using hw
  let J := Complex.ofReal (∫ s in (0:ℝ)..R, translatedProfileMatch L x y s)
  change (↑R⁻¹ : ℂ) * (↑L⁻¹ * (J * f y)) =
    f y * ((↑L⁻¹ : ℂ) * tentProfile ((x-y)/L))
  calc
    _ = f y * ((↑L⁻¹ : ℂ) * ((↑R⁻¹ : ℂ) * J)) := by ring
    _ = _ := by rw [show (↑R⁻¹ : ℂ)*J = _ from hw']

set_option maxHeartbeats 550000 in
/-- A single uniform translate on the coarsest interval gives a tent convolution at each finer level. -/
theorem randomGrid {scale : ℝ} (hs : 0 < scale) {u k : ℤ} (huk : u ≤ k)
    {f : ℝ → ℂ} (hf : Integrable f) (x : ℝ) :
    let R := scale*(2:ℝ)^(-u)
    let L := scale*(2:ℝ)^(-k)
    (↑R⁻¹ : ℂ) * (∫ s in Ico 0 R, translatedGridExpectation L s f x) =
      lineProfileConvolution (gridTentKernel L) f x := by
  dsimp only
  let L := scale*(2:ℝ)^(-k)
  let R := scale*(2:ℝ)^(-u)
  let N : ℕ := 2^(k-u).toNat
  have hN : 0 < N := by dsimp [N]; positivity
  have hL : 0 < L := by dsimp [L]; positivity
  have he : (N:ℝ)*L = R := by
    dsimp only [N,L,R]
    push_cast
    rw [← zpow_natCast, Int.toNat_of_nonneg (sub_nonneg.mpr huk),
      mul_left_comm, ← zpow_add₀ (by norm_num : (2:ℝ) ≠ 0)]
    congr 2
    omega
  change (↑R⁻¹ : ℂ) * (∫ s in Ico 0 R, translatedGridExpectation L s f x) = _
  rw [← he]
  exact translatedGridExpectation_window hL hN hf x

open scoped SchwartzMap in
private theorem lpNorm_le_of_schwartz_pairing_bound {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    [FiniteDimensional ℝ X] [MeasureSpace X] [BorelSpace X]
    [(volume : Measure X).HasTemperateGrowth] [IsFiniteMeasureOnCompacts (volume : Measure X)]
    {p K : ℝ} (hp : 1 < p)
    (hK : 0 ≤ K) {f : X → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume)
    (hS : ∀ g : 𝓢(X, ℂ), ‖∫ x, f x*g x‖ ≤
      K*lpNorm (g : X → ℂ) (ENNReal.ofReal p.conjExponent) volume) :
    lpNorm f (ENNReal.ofReal p) volume ≤ K := by
  let P := ENNReal.ofReal p
  let Q := ENNReal.ofReal p.conjExponent
  letI : Fact (1 ≤ P) := ⟨by rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le⟩
  letI : Fact (1 ≤ Q) := ⟨Auto.LpSpaceFacts.one_le_ofReal_conjExponent p hp⟩
  letI : ENNReal.HolderConjugate P Q := Auto.LpSpaceFacts.ofReal_holderConjugate p hp
  let Φ : Lp ℂ Q (volume : Measure X) →L[ℂ] ℂ :=
    (ContinuousLinearMap.lpPairing volume P Q (ContinuousLinearMap.mul ℂ ℂ)) (hf.toLp f)
  have hPair (g : Lp ℂ Q (volume : Measure X)) : Φ g = ∫ x, f x*g x :=
    Auto.LpSpaceFacts.lpPairing_apply_toLp_eq_integral hf g
  have hBound (g : Lp ℂ Q (volume : Measure X)) : ‖Φ g‖ ≤ K*‖g‖ := by
    refine (SchwartzMap.denseRange_toLpCLM (E := X) (F := ℂ) (p := Q)
      (μ := volume) ENNReal.ofReal_ne_top).induction_on g
      (isClosed_le Φ.continuous.norm (continuous_id.norm.const_mul K)) ?_
    intro G
    rw [SchwartzMap.toLpCLM_apply, hPair, SchwartzMap.norm_toLp, toReal_eLpNorm]
    have he : (∫ x, f x*G.toLp Q volume x) = ∫ x, f x*G x := by
      apply integral_congr_ae
      filter_upwards [G.coeFn_toLp Q volume] with x hx
      rw [hx]
    rw [he]
    exact hS G
  apply Auto.LpSpaceFacts.lpNorm_le_of_simple_test_pairing_bound hp hK hf
  intro g
  rw [← hPair]
  exact hBound g

open scoped SchwartzMap in
/-- Schwartz functions in the conjugate unit ball norm the (L^p) output. -/
theorem dual {d : ℕ} {p : ℝ} (hp : 1 < p)
    {f : E d → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    lpNorm f (ENNReal.ofReal p) volume =
      sSup {t : ℝ | ∃ h : 𝓢(E d, ℂ),
        lpNorm (h : E d → ℂ) (ENNReal.ofReal p.conjExponent) volume ≤ 1 ∧
        t = ‖∫ x, f x*h x‖} := by
  let P := ENNReal.ofReal p
  let Q := ENNReal.ofReal p.conjExponent
  let V := {t : ℝ | ∃ h : 𝓢(E d, ℂ), lpNorm (h : E d → ℂ) Q volume ≤ 1 ∧
    t = ‖∫ x, f x*h x‖}
  have hHolder (h : 𝓢(E d, ℂ)) :
      ‖∫ x, f x*h x‖ ≤ lpNorm f P volume * lpNorm (h : E d → ℂ) Q volume := by
    have hh := h.memLp Q volume
    exact ENNReal.toReal_mono
      (ENNReal.mul_ne_top hf.eLpNorm_ne_top hh.eLpNorm_ne_top)
      (Auto.LpSpaceFacts.enorm_integral_mul_le_eLpNorm_p_pconj_mul hp f h hf hh)
      |>.trans_eq (ENNReal.toReal_mul)
  have hNonempty : (0:ℝ) ∈ V := by
    refine ⟨0, ?_, ?_⟩
    · simp
    · simp
  have hUpper : lpNorm f P volume ∈ upperBounds V := by
    rintro t ⟨h, hh, rfl⟩
    have hNonneg : 0 ≤ lpNorm f P volume := lpNorm_nonneg
    exact (hHolder h).trans ((mul_le_mul_of_nonneg_left hh hNonneg).trans_eq (mul_one _))
  have hB : BddAbove V := ⟨lpNorm f P volume, hUpper⟩
  have hSup : 0 ≤ sSup V := le_csSup hB hNonempty
  apply le_antisymm _ (csSup_le ⟨0,hNonempty⟩ hUpper)
  apply lpNorm_le_of_schwartz_pairing_bound hp hSup hf
  intro h
  let b := lpNorm (h : E d → ℂ) Q volume
  have hb : 0 ≤ b := lpNorm_nonneg
  rcases hb.eq_or_lt with he | hpos
  · exact (hHolder h).trans_eq (by change _ * b = _ * b; rw [← he, mul_zero, mul_zero])
  let H : 𝓢(E d, ℂ) := (b⁻¹ : ℝ) • h
  have hNorm : lpNorm (H : E d → ℂ) Q volume = 1 := by
    change lpNorm (b⁻¹ • (h : E d → ℂ)) Q volume = 1
    rw [lpNorm_const_smul]
    change ‖b⁻¹‖ * b = 1
    rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpos)]
    exact inv_mul_cancel₀ hpos.ne'
  have hMem : ‖∫ x, f x*H x‖ ∈ V := ⟨H, hNorm.le, rfl⟩
  have hPair : (∫ x, f x*H x) = (↑b⁻¹ : ℂ)*(∫ x, f x*h x) := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with x
    change f x * (b⁻¹ • h x) = (↑b⁻¹ : ℂ)*(f x*h x)
    rw [Complex.real_smul]
    ring
  have h := le_csSup hB hMem
  rw [hPair, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpos),
    ← div_eq_inv_mul] at h
  exact ((div_le_iff₀ hpos).mp h)

private theorem finiteSum_le_two_square_prod {d : ℕ} (S : Finset ℤ)
    (b j : Fin d) (hjb : j ≠ b) (W : Fin d → ℤ → ℝ) (G : Fin d → ℝ)
    (hW : ∀ i k, 0 ≤ W i k) (hG : ∀ i, 0 ≤ G i)
    (hg : ∀ i, i ≠ b → i ≠ j → ∀ k ∈ S, W i k ≤ G i) :
    (∑ k ∈ S, ∏ i, W i k) ≤
      ∏ i, if i = b ∨ i = j then Real.sqrt (∑ k ∈ S, W i k^2) else G i := by
  let U := (Finset.univ.erase b).erase j
  have hb : b ∈ (Finset.univ : Finset (Fin d)) := Finset.mem_univ b
  have hj : j ∈ (Finset.univ : Finset (Fin d)).erase b := Finset.mem_erase.mpr ⟨hjb, Finset.mem_univ j⟩
  have hU {i : Fin d} (hi : i ∈ U) : i ≠ b ∧ i ≠ j :=
    ⟨(Finset.mem_erase.mp (Finset.mem_erase.mp hi).2).1, (Finset.mem_erase.mp hi).1⟩
  have hsplit (F : Fin d → ℝ) : ∏ i, F i = F b * (F j * ∏ i ∈ U, F i) := by
    rw [← Finset.mul_prod_erase Finset.univ F hb, ← Finset.mul_prod_erase _ F hj]
  let A := ∏ i ∈ U, G i
  let N (i : Fin d) := Real.sqrt (∑ k ∈ S, W i k^2)
  have hA : 0 ≤ A := Finset.prod_nonneg fun i _ => hG i
  have hCauchy : (∑ k ∈ S, W b k * W j k) ≤ N b * N j := by
    have h := Real.sqrt_le_sqrt (Finset.sum_mul_sq_le_sq_mul_sq S (W b) (W j))
    rwa [Real.sqrt_sq (Finset.sum_nonneg fun k _ => mul_nonneg (hW b k) (hW j k)),
      Real.sqrt_mul (Finset.sum_nonneg fun k _ => sq_nonneg (W b k))] at h
  calc
    _ ≤ ∑ k ∈ S, (W b k*W j k)*A := by
      apply Finset.sum_le_sum
      intro k hk
      rw [hsplit, ← mul_assoc]
      exact mul_le_mul_of_nonneg_left
        (Finset.prod_le_prod₀ (fun i _ => hW i k)
          (fun i hi => hg i (hU hi).1 (hU hi).2 k hk)) (mul_nonneg (hW b k) (hW j k))
    _ = (∑ k ∈ S, W b k * W j k)*A := by rw [Finset.sum_mul]
    _ ≤ (N b*N j)*A := mul_le_mul_of_nonneg_right hCauchy hA
    _ = _ := by
      rw [hsplit]
      have hprod : (∏ i ∈ U, if i = b ∨ i = j then N i else G i) = A := by
        apply Finset.prod_congr rfl
        intro i hi
        simp [(hU hi).1,(hU hi).2]
      change _ = (if b=b ∨ b=j then N b else G b) *
        ((if j=b ∨ j=j then N j else G j)*(∏ i ∈ U, if i=b ∨ i=j then N i else G i))
      rw [hprod]
      simp [mul_assoc]

private theorem finiteProfileExponent {d : ℕ} {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹) :
    (∑ i, (ENNReal.ofReal (p i))⁻¹)⁻¹ = ENNReal.ofReal r := by
  have he (i : Fin d) : (ENNReal.ofReal (p i))⁻¹ = ENNReal.ofReal ((p i)⁻¹) :=
    (ENNReal.ofReal_inv_of_pos (zero_lt_one.trans (hp i))).symm
  simp_rw [he]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => inv_nonneg.mpr (zero_lt_one.trans (hp i)).le),
    ← hSum, ENNReal.ofReal_inv_of_pos (zero_lt_one.trans hr), inv_inv]

private theorem finiteProfileProduct_bound {d : ℕ} {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {G : Fin d → (Fin d → ℝ) → ℝ} (hG : ∀ i, Measurable (G i))
    (hLp : ∀ i, MemLp (G i) (ENNReal.ofReal (p i)) volume) :
    MemLp (fun x => ∏ i, G i x) (ENNReal.ofReal r) volume ∧
      eLpNorm (fun x => ∏ i, G i x) (ENNReal.ofReal r) volume ≤
        ∏ i, eLpNorm (G i) (ENNReal.ofReal (p i)) volume := by
  have h := eLpNorm_finite_product_le (μ := volume) Finset.univ (fun i => ENNReal.ofReal (p i)) G hG
  rw [finiteProfileExponent hp hr hSum] at h
  exact ⟨h.trans_lt (ENNReal.prod_lt_top (fun i _ => (hLp i).eLpNorm_lt_top)), h⟩

private theorem profileSize_le_of_ae {a : ℝ → ℂ} {C : ℝ}
    (h : ∀ᵐ y ∂(volume : Measure ℝ), (1+|y|)^4 * (‖a y‖+‖deriv a y‖) ≤ C) :
    profileSize a ≤ ENNReal.ofReal C := by
  let w (y : ℝ) := ENNReal.ofReal ((1+|y|)^4 * (‖a y‖+‖deriv a y‖))
  apply essSup_le_of_ae_le _ (f := w) _
    (isCoboundedUnder_le_of_le _ (x := (0:ℝ≥0∞)) (fun _ => zero_le))
  exact h.mono fun _ hy => ENNReal.ofReal_le_ofReal hy

private theorem profileSize_weight_ae {a : ℝ → ℂ} (hQ : profileSize a ≠ ∞) :
    ∀ᵐ y ∂(volume : Measure ℝ), (1+|y|)^4 * (‖a y‖+‖deriv a y‖) ≤ (profileSize a).toReal := by
  filter_upwards [ENNReal.ae_le_essSup (μ := (volume : Measure ℝ))
    (fun y => ENNReal.ofReal ((1+|y|)^4 * (‖a y‖+‖deriv a y‖)))] with y hy
  exact (ENNReal.ofReal_le_ofReal_iff ENNReal.toReal_nonneg).mp
    (hy.trans_eq (ENNReal.ofReal_toReal hQ).symm)

private theorem locallyAbsolutelyContinuous_ae_differentiable {a : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r) :
    ∀ᵐ y ∂(volume : Measure ℝ), DifferentiableAt ℝ a y :=
  (show LocallyBoundedVariationOn a univ from by
    intro l r _ _
    exact (ha l r).boundedVariationOn.mono (fun _ hz => Icc_subset_uIcc hz.2)).ae_differentiableAt

private theorem profileSize_sub_const_mul {a b : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r)
    (hb : ∀ l r, AbsolutelyContinuousOnInterval b l r)
    (hA : profileSize a ≠ ∞) (hB : profileSize b ≠ ∞) (c : ℂ) :
    profileSize (fun y => a y-c*b y) ≤ profileSize a + ‖c‖ₑ*profileSize b := by
  have h : profileSize (fun y => a y-c*b y) ≤ ENNReal.ofReal
      ((profileSize a).toReal + ‖c‖*(profileSize b).toReal) := by
    apply profileSize_le_of_ae
    filter_upwards [profileSize_weight_ae hA, profileSize_weight_ae hB,
      locallyAbsolutelyContinuous_ae_differentiable ha, locallyAbsolutelyContinuous_ae_differentiable hb]
      with y hAy hBy had hbd
    rw [show deriv (fun y => a y-c*b y) y = deriv a y-c*deriv b y from
      (had.hasDerivAt.sub (hbd.hasDerivAt.const_mul c)).deriv]
    calc
      _ ≤ (1+|y|)^4 * ((‖a y‖ + ‖c*b y‖)+(‖deriv a y‖+‖c*deriv b y‖)) :=
        mul_le_mul_of_nonneg_left (add_le_add (norm_sub_le _ _) (norm_sub_le _ _)) (by positivity)
      _ = (1+|y|)^4*(‖a y‖+‖deriv a y‖) + ‖c‖*((1+|y|)^4*(‖b y‖+‖deriv b y‖)) := by
        rw [norm_mul,norm_mul]
        ring
      _ ≤ _ := add_le_add hAy (mul_le_mul_of_nonneg_left hBy (norm_nonneg _))
  rwa [ENNReal.ofReal_add ENNReal.toReal_nonneg (mul_nonneg (norm_nonneg _) ENNReal.toReal_nonneg),
    ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ENNReal.ofReal_toReal hA,
    ENNReal.ofReal_toReal hB] at h

private theorem profileIntegral_le {a : ℝ → ℂ} (ha : Continuous a) (hQ : profileSize a ≠ ∞) :
    ‖∫ y, a y‖ ≤ (∫ y : ℝ, ((1+|y|)^4)⁻¹) * (profileSize a).toReal := by
  have hi := profile_integrable ha hQ
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [mul_comm, ← integral_const_mul]
  apply integral_mono hi.norm (profileWeight_integrable.const_mul _)
  intro y
  change ‖a y‖ ≤ (profileSize a).toReal * ((1+|y|)^4)⁻¹
  rw [← div_eq_mul_inv]
  exact (le_div_iff₀ (by positivity)).mpr (by
    simpa only [mul_comm] using profileSize_amplitude_le ha hQ y)

private theorem schwartzProfile_locallyAbsolutelyContinuous (a : SchwartzMap ℝ ℂ) (l r : ℝ) :
    AbsolutelyContinuousOnInterval a l r :=
  (a.smooth 1).contDiffOn.absolutelyContinuousOnInterval

private theorem schwartzProfile_size_finite (a : SchwartzMap ℝ ℂ) : profileSize a ≠ ∞ := by
  let M (_ : ℕ) := (2:ℝ)^4 * (Finset.Iic ((4,1) : ℕ×ℕ)).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) a
  have hn (j : ℕ) (hj : j ≤ 1) (y : ℝ) :
      (1+|y|)^4 * ‖iteratedDeriv j a y‖ ≤ M j := by
    simpa [M, Real.norm_eq_abs, norm_iteratedFDeriv_eq_norm_iteratedDeriv] using
      (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (4,1))
        (k := 4) (n := j) le_rfl hj a y)
  have hQ := profileSize_le_of_ae (a := a) (C := M 0 + M 1)
    (Filter.Eventually.of_forall fun y => by
      have h₀ := hn 0 (by decide) y
      have h₁ := hn 1 le_rfl y
      rw [mul_add]
      simpa only [iteratedDeriv_zero, iteratedDeriv_one] using add_le_add h₀ h₁)
  exact hQ.trans_lt ENNReal.ofReal_lt_top |>.ne

/-- The finite sum of products of dyadic convolutions along the designated coordinates. -/
noncomputable def separatedProfileSum {d : ℕ} (S : Finset ℤ) (z : ℤ → ℂ)
    (a : Fin d → ℝ → ℂ) (f : Fin d → (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) : ℂ :=
  ∑ k ∈ S, z k * ∏ i, coordinateProfileConvolution i (profileDilation (a i) k) (f i) x

private theorem separatedProfileSum_measurable {d : ℕ} (S : Finset ℤ) (z : ℤ → ℂ)
    {a : Fin d → ℝ → ℂ} (ha : ∀ i, Continuous (a i))
    {f : Fin d → (Fin d → ℝ) → ℂ} (hf : ∀ i, Measurable (f i)) :
    Measurable (separatedProfileSum S z a f) :=
  Finset.measurable_sum _ fun k _ => measurable_const.mul <|
    Finset.measurable_prod _ fun i _ => coordinateProfileConvolution_measurable i
      (measurable_const.mul ((ha i).measurable.comp (measurable_const.mul measurable_id))) (hf i)

set_option maxHeartbeats 1250000 in
private theorem separatedProfileSum_two_cancellations {d : ℕ} {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹) :
    ∃ D : ℝ≥0∞, D ≠ ∞ ∧ ∀ (b j : Fin d), j ≠ b →
      ∀ (S : Finset ℤ) (z : ℤ → ℂ), (∀ k ∈ S, ‖z k‖ ≤ 1) →
      ∀ (a : Fin d → ℝ → ℂ), (∀ i l r, AbsolutelyContinuousOnInterval (a i) l r) →
      (∀ i, profileSize (a i) ≠ ∞) → (∫ x, a b x) = 0 → (∫ x, a j x) = 0 →
      ∀ (f : Fin d → (Fin d → ℝ) → ℂ), (∀ i, Measurable (f i)) →
      (∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume) →
      MemLp (separatedProfileSum S z a f) (ENNReal.ofReal r) volume ∧
        eLpNorm (separatedProfileSum S z a f) (ENNReal.ofReal r) volume ≤
          D * (∏ i, profileSize (a i)) * ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  choose C hC hSquare using fun i => profileSquare (hp i)
  choose M hM hMax using fun i => profileMax (hp i)
  let V (i : Fin d) := max (C i) (ENNReal.ofReal (M i))
  have hV (i : Fin d) : V i ≠ ∞ :=
    (max_lt (hC i).lt_top ENNReal.ofReal_lt_top).ne
  refine ⟨∏ i, V i, (ENNReal.prod_lt_top fun i _ => (hV i).lt_top).ne, ?_⟩
  intro b j hjb S z hz a ha hQ hB hJ f hfm hfp
  have haC (i : Fin d) : Continuous (a i) := locallyAbsolutelyContinuous_continuous (ha i)
  let F (i : Fin d) (k : ℤ) := coordinateProfileConvolution i (profileDilation (a i) k) (f i)
  let W (i : Fin d) (x : Fin d → ℝ) := Real.sqrt (∑ k ∈ S, ‖F i k x‖^2)
  let R (i : Fin d) := profileMaximal i (a i) (f i)
  let G (i : Fin d) := if i = b ∨ i = j then W i else R i
  have hFm (i : Fin d) (k : ℤ) : Measurable (F i k) :=
    coordinateProfileConvolution_measurable i
      (measurable_const.mul ((haC i).measurable.comp (measurable_const.mul measurable_id))) (hfm i)
  have hG (i : Fin d) : Measurable (G i) := by
    dsimp only [G]
    split
    · exact (Finset.measurable_sum _ fun k _ => (hFm i k).norm.pow_const 2).sqrt
    · exact (profileMaximalRaw_measurable i (haC i).measurable (hfm i)).ennreal_toReal
  have hLp (i : Fin d) : MemLp (G i) (ENNReal.ofReal (p i)) volume ∧
      eLpNorm (G i) (ENNReal.ofReal (p i)) volume ≤
        V i * profileSize (a i) * eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
    by_cases hi : i = b ∨ i = j
    · have hZero : (∫ x, a i x) = 0 := by rcases hi with rfl | rfl <;> assumption
      have hh := hSquare i (i := i) (ha i) (hQ i) hZero (hfp i) S z hz
      rw [show G i = W i by simp [G,hi]]
      exact ⟨hh.2.1, (le_add_of_nonneg_left zero_le).trans
        (hh.2.2.trans (mul_le_mul_left (mul_le_mul_left (le_max_left _ _) _) _))⟩
    · have hh := hMax i i (a i) (haC i) (hQ i) (f i) (hfp i)
      rw [show G i = R i by simp [G,hi]]
      refine ⟨hh.2.1, ?_⟩
      have hb := ENNReal.ofReal_le_ofReal hh.2.2
      rw [ENNReal.ofReal_mul (mul_nonneg (hM i) ENNReal.toReal_nonneg),
        ENNReal.ofReal_mul (hM i), ENNReal.ofReal_toReal (hQ i)] at hb
      simp only [← toReal_eLpNorm, ENNReal.ofReal_toReal hh.2.1.eLpNorm_ne_top,
        ENNReal.ofReal_toReal (hfp i).eLpNorm_ne_top] at hb
      exact hb.trans (mul_le_mul_left (mul_le_mul_left (le_max_right _ _) _) _)
  have hProd := finiteProfileProduct_bound hp hr hSum hG (fun i => (hLp i).1)
  have hMeas := separatedProfileSum_measurable S z haC hfm
  have hAE : ∀ᵐ x ∂(volume : Measure (Fin d → ℝ)), ∀ i,
      profileMaximalRaw i (a i) (f i) x < ∞ :=
    eventually_all.mpr fun i => (hMax i i (a i) (haC i) (hQ i) (f i) (hfp i)).1
  have hPoint : ∀ᵐ x ∂(volume : Measure (Fin d → ℝ)),
      ‖separatedProfileSum S z a f x‖ ≤ ∏ i, G i x := by
    filter_upwards [hAE] with x hx
    refine (norm_sum_le _ _).trans ?_
    calc
      _ ≤ ∑ k ∈ S, ∏ i, ‖F i k x‖ := by
        apply Finset.sum_le_sum
        intro k hk
        rw [norm_mul, norm_prod]
        have hprod : 0 ≤ ∏ i, ‖F i k x‖ :=
          Finset.prod_nonneg fun i _ => norm_nonneg (F i k x)
        have h := mul_le_mul_of_nonneg_right (hz k hk) hprod
        simpa only [one_mul] using h
      _ ≤ _ := by
        have hGx (i : Fin d) : G i x = if i = b ∨ i = j then W i x else R i x := by
          dsimp only [G]
          split <;> rfl
        simp_rw [hGx]
        apply finiteSum_le_two_square_prod S b j hjb (fun i k => ‖F i k x‖) (fun i => R i x)
          (fun _ _ => norm_nonneg _) (fun _ => ENNReal.toReal_nonneg)
        intro i _ _ k _
        have hh : ‖F i k x‖ₑ ≤ profileMaximalRaw i (a i) (f i) x :=
          le_iSup (fun l : ℤ => ‖F i l x‖ₑ) k
        simpa only [toReal_enorm, R, profileMaximal] using ENNReal.toReal_mono (hx i).ne hh
  have hb := eLpNorm_mono_ae_real (p := ENNReal.ofReal r) hMeas.aestronglyMeasurable hPoint
  refine ⟨hb.trans_lt hProd.1.eLpNorm_lt_top, hb.trans (hProd.2.trans ?_)⟩
  exact (Finset.prod_le_prod fun i _ => (hLp i).2).trans_eq (by simp_rw [Finset.prod_mul_distrib])

private theorem translatedGridExpectation_eq_interval {L s : ℝ} (hL : 0 < L)
    (f : ℝ → ℂ) (x : ℝ) :
    translatedGridExpectation L s f x = (↑L⁻¹ : ℂ) *
      ∫ y in Ico (s+L*(translatedProfileCell L s x:ℝ))
        (s+L*((translatedProfileCell L s x:ℝ)+1)), f y := by
  let n := translatedProfileCell L s x
  let I := Ico (s+L*(n:ℝ)) (s+L*((n:ℝ)+1))
  have hm : MeasurableSet I := measurableSet_Ico
  have he (y : ℝ) : translatedProfileCell L s y = n ↔ y ∈ I := by
    rw [translatedProfileCell, Int.floor_eq_iff]
    change ((n:ℝ) ≤ (y-s)/L ∧ (y-s)/L < (n:ℝ)+1) ↔
      s+L*(n:ℝ) ≤ y ∧ y < s+L*((n:ℝ)+1)
    rw [le_div_iff₀ hL, div_lt_iff₀ hL]
    constructor <;> intro h <;> constructor <;> linarith [h.1,h.2]
  unfold translatedGridExpectation
  congr 1
  rw [← integral_indicator hm]
  apply integral_congr_ae
  filter_upwards [] with y
  by_cases hy : y ∈ I
  · have hh : translatedProfileCell L s x = translatedProfileCell L s y := ((he y).mpr hy).symm
    simp [translatedProfileMatch, hh, hy]
  · have hne : translatedProfileCell L s x ≠ translatedProfileCell L s y :=
      fun h => hy ((he y).mp h.symm)
    simp [translatedProfileMatch, hne, hy]

private theorem translatedGridExpectation_affine {s scale : ℝ} (hs : 0 < scale)
    (k : ℤ) (f : ℝ → ℂ) (x : ℝ) :
    translatedGridExpectation (scale*(2:ℝ)^(-k)) s f (s+scale*x) =
      (↑(((2:ℝ)^(-k))⁻¹) : ℂ) *
        ∫ y in dyadicInterval k (dyadicIndex k x), f (s+scale*y) := by
  let L₀ : ℝ := (2:ℝ)^(-k)
  have hL₀ : 0 < L₀ := by dsimp [L₀]; positivity
  have hL := mul_pos hs hL₀
  have he : translatedProfileCell (scale*L₀) s (s+scale*x) = dyadicIndex k x := by
    unfold translatedProfileCell dyadicIndex
    congr 1
    change (s+scale*x-s)/(scale*L₀) = x/L₀
    rw [show s+scale*x-s = scale*x by ring, mul_div_mul_left _ _ hs.ne']
  rw [translatedGridExpectation_eq_interval hL, he]
  let a : ℝ := L₀*(dyadicIndex k x:ℝ)
  let b : ℝ := L₀*((dyadicIndex k x:ℝ)+1)
  have hab : a ≤ b := by dsimp [a,b]; nlinarith
  have hab' : s+scale*a ≤ s+scale*b := by gcongr
  have he₁ : s+scale*L₀*(dyadicIndex k x:ℝ) = s+scale*a := by dsimp [a]; ring
  have he₂ : s+scale*L₀*((dyadicIndex k x:ℝ)+1) = s+scale*b := by dsimp [b]; ring
  have he₃ : dyadicInterval k (dyadicIndex k x) = Ico a b := by
    simp only [dyadicInterval, a, b, L₀, Int.cast_add, Int.cast_one, mul_comm]
  rw [he₁, he₂, he₃, integral_Ico_eq_integral_Ioc, integral_Ico_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le hab, ← intervalIntegral.integral_of_le hab']
  have hInt := intervalIntegral.integral_comp_add_mul (f := f) (a := a) (b := b)
    (c := scale) hs.ne' s
  rw [hInt, Complex.real_smul]
  have hCoeff : (↑(scale*L₀)⁻¹ : ℂ) = (↑L₀⁻¹ : ℂ) * (↑scale⁻¹ : ℂ) := by
    rw [← Complex.ofReal_mul, mul_inv_rev]
  rw [hCoeff, mul_assoc]

private theorem finiteSigns_orthogonal {ι : Type*} [DecidableEq ι]
    (S : Finset ι) {i j : ι} (hi : i ∈ S) (hj : j ∈ S) :
    (∑ u ∈ S.powerset, Auto.LittlewoodPaley.rademacherSign u i *
      Auto.LittlewoodPaley.rademacherSign u j) =
      if i = j then (S.powerset.card : ℂ) else 0 := by
  let ε := Auto.LittlewoodPaley.rademacherSign (I := ι)
  change (∑ u ∈ S.powerset, ε u i*ε u j) = _
  by_cases he : i = j
  · subst j
    simp only [ite_true]
    have h (u : Finset ι) : ε u i*ε u i = 1 := by
      dsimp only [ε, Auto.LittlewoodPaley.rademacherSign]
      split <;> norm_num
    simp [h]
  simp only [he, if_false]
  induction S using Finset.induction_on with
  | empty => contradiction
  | @insert a S ha ih =>
    rw [Finset.sum_powerset_insert ha, ← Finset.sum_add_distrib]
    have hm (u : Finset ι) (hu : u ∈ S.powerset) : a ∉ u :=
      fun h => ha ((Finset.mem_powerset.mp hu) h)
    have hchange (u : Finset ι) (hu : u ∈ S.powerset) (k : ι) :
        ε (insert a u) k = if k = a then -ε u k else ε u k := by
      by_cases hk : k = a
      · subst k
        simp [ε, Auto.LittlewoodPaley.rademacherSign, hm u hu]
      · simp [ε, Auto.LittlewoodPaley.rademacherSign, hk, Finset.mem_insert]
    by_cases hia : i = a
    · have hja : j ≠ a := fun h => he (hia.trans h.symm)
      apply Finset.sum_eq_zero
      intro u hu
      rw [hchange u hu i, hchange u hu j, if_pos hia, if_neg hja]
      ring
    by_cases hja : j = a
    · apply Finset.sum_eq_zero
      intro u hu
      rw [hchange u hu i, hchange u hu j, if_neg hia, if_pos hja]
      ring
    have hP : (∑ u ∈ S.powerset, (ε u i*ε u j + ε (insert a u) i*ε (insert a u) j)) =
        ∑ u ∈ S.powerset, (ε u i*ε u j + ε u i*ε u j) := by
      apply Finset.sum_congr rfl
      intro u hu
      rw [hchange u hu i, hchange u hu j, if_neg hia, if_neg hja]
    rw [hP, Finset.sum_add_distrib, ih
      ((Finset.mem_insert.mp hi).resolve_left hia)
      ((Finset.mem_insert.mp hj).resolve_left hja), add_zero]

private noncomputable def translatedCoordinateAverage {d : ℕ} (i : Fin d) (L s : ℝ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) : ℂ :=
  translatedGridExpectation L s (fun y => f (Function.update x i y)) (x i)

private theorem translatedCoordinateAverage_measurable {d : ℕ} (i : Fin d) (L : ℝ)
    {f : (Fin d → ℝ) → ℂ} (hf : Measurable f) :
    Measurable (fun z : ℝ × (Fin d → ℝ) => translatedCoordinateAverage i L z.1 f z.2) := by
  let X := ℝ × (Fin d → ℝ)
  have hs : Measurable (fun z : X×ℝ => z.1.1) := measurable_fst.comp measurable_fst
  have hx : Measurable (fun z : X×ℝ => z.1.2 i) :=
    (measurable_pi_apply i).comp (measurable_snd.comp measurable_fst)
  have h₁ : Measurable (fun z : X×ℝ => translatedProfileCell L z.1.1 (z.1.2 i)) :=
    Int.measurable_floor.comp ((hx.sub hs).div_const L)
  have h₂ : Measurable (fun z : X×ℝ => translatedProfileCell L z.1.1 z.2) :=
    Int.measurable_floor.comp ((measurable_snd.sub hs).div_const L)
  have hmatch : Measurable (fun z : X×ℝ => (translatedProfileMatch L (z.1.2 i) z.2 z.1.1 : ℂ)) :=
    Complex.continuous_ofReal.measurable.comp
      (Measurable.ite (measurableSet_eq_fun h₁ h₂) measurable_const measurable_const)
  have hUpdate : Measurable (fun z : X×ℝ => Function.update z.1.2 i z.2) :=
    (measurable_update' (a := i)).comp
      ((measurable_snd.comp measurable_fst).prodMk measurable_snd)
  exact measurable_const.mul ((hmatch.mul (hf.comp hUpdate)).stronglyMeasurable.integral_prod_right'.measurable)

private theorem translatedCoordinateAverage_affine {d : ℕ} (i : Fin d)
    {scale : Fin d → ℝ} (hscale : 0 < scale i) (a : Fin d → ℝ) (k : ℤ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) :
    translatedCoordinateAverage i (scale i*(2:ℝ)^(-k)) (a i) f (coordinateAffine a scale x) =
      complexCoordinateAverage i k (f ∘ coordinateAffine a scale) x := by
  unfold translatedCoordinateAverage
  change translatedGridExpectation _ _ _ (a i+scale i*x i) = _
  rw [translatedGridExpectation_affine hscale]
  have he (y : ℝ) : Function.update (coordinateAffine a scale x) i (a i+scale i*y) =
      coordinateAffine a scale (Function.update x i y) := by
    funext l
    by_cases hl : l = i
    · subst l
      simp [coordinateAffine]
    · simp [coordinateAffine, Function.update_of_ne hl]
  simp only [he, complexCoordinateAverage, Function.comp_apply]

private noncomputable def translatedDyadicSlot {d : ℕ} (b : Fin d)
    (a scale : Fin d → ℝ) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℂ) :
    Option (Fin d) → (Fin d → ℝ) → ℂ
  | none => f none
  | some i => if i = b then
      translatedCoordinateAverage i (scale i*(2:ℝ)^(-(k+1))) (a i) (f (some i)) -
        translatedCoordinateAverage i (scale i*(2:ℝ)^(-k)) (a i) (f (some i))
      else translatedCoordinateAverage i (scale i*(2:ℝ)^(-k)) (a i) (f (some i))

private theorem translatedDyadicSlot_affine {d : ℕ} (b : Fin d)
    (a scale : Fin d → ℝ) (hscale : ∀ i, 0 < scale i) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℂ) (i : Option (Fin d)) (x : Fin d → ℝ) :
    translatedDyadicSlot b a scale k f i (coordinateAffine a scale x) =
      complexDyadicSlot b k (fun i => f i ∘ coordinateAffine a scale) i x := by
  cases i with
  | none => rfl
  | some i =>
    by_cases hi : i = b
    · simp only [translatedDyadicSlot, complexDyadicSlot, hi, if_true, Pi.sub_apply,
        complexCoordinateDifference, translatedCoordinateAverage_affine _ (hscale _)]
    · simp only [translatedDyadicSlot, complexDyadicSlot, hi, if_false,
        translatedCoordinateAverage_affine _ (hscale _)]

set_option maxHeartbeats 650000 in
private theorem translatedDyadicForm_eq_affine {d : ℕ} (b : Fin d)
    (a scale : Fin d → ℝ) (hscale : ∀ i, 0 < scale i) (u : ℤ) (T : ℕ)
    (c : ℕ → ℂ) (f : Option (Fin d) → (Fin d → ℝ) → ℂ) (hf : ∀ i, Measurable (f i)) :
    (∑ k ∈ Finset.range T, c k * ∫ x, ∏ i, translatedDyadicSlot b a scale (u+k) f i x) =
      affineDyadicForm b u T c a scale f := by
  let J := ∏ i, scale i
  have hJ : 0 < J := Finset.prod_pos fun i _ => hscale i
  have he (k : ℤ) :
      (∫ x, ∏ i, translatedDyadicSlot b a scale k f i x) =
        (↑J : ℂ) * ∫ x, ∏ i,
          complexDyadicSlot b k (fun i => f i ∘ coordinateAffine a scale) i x := by
    let F (x : Fin d → ℝ) := ∏ i, translatedDyadicSlot b a scale k f i x
    have hm : Measurable F := by
      apply Finset.measurable_prod
      intro i _
      cases i with
      | none => exact hf none
      | some i =>
        have hAvg (l : ℤ) : Measurable (translatedCoordinateAverage i
            (scale i*(2:ℝ)^(-l)) (a i) (f (some i))) :=
          (translatedCoordinateAverage_measurable i _ (hf (some i))).comp
            (measurable_const.prodMk measurable_id)
        by_cases hi : i = b
        · simpa only [translatedDyadicSlot, hi, if_true] using (hAvg (k+1)).sub (hAvg k)
        · simpa only [translatedDyadicSlot, hi, if_false] using hAvg k
    have hmap := integral_map (μ := volume) (f := F) (coordinateAffine_measurable a scale).aemeasurable
      hm.aestronglyMeasurable
    rw [coordinateAffine_map_volume a scale hscale, integral_smul_measure,
      ENNReal.toReal_ofReal (inv_nonneg.mpr hJ.le), Complex.real_smul] at hmap
    have hSlot : F ∘ coordinateAffine a scale =
        fun x => ∏ i, complexDyadicSlot b k (fun i => f i ∘ coordinateAffine a scale) i x := by
      funext x
      exact Finset.prod_congr rfl fun i _ => translatedDyadicSlot_affine b a scale hscale k f i x
    simp_rw [← hSlot]
    change (∫ x, F x) = (↑J : ℂ) * ∫ x, F (coordinateAffine a scale x)
    rw [← hmap]
    change (∫ x, F x) = (↑J : ℂ) * (↑J⁻¹ * ∫ x, F x)
    rw [← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ hJ.ne', Complex.ofReal_one, one_mul]
  simp only [affineDyadicForm, complexDyadicForm, Finset.mul_sum, he]
  apply Finset.sum_congr rfl
  intro k _
  ring

private theorem coordinateProfileConvolution_right {d : ℕ} (i : Fin d) (a : ℝ → ℂ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) :
    coordinateProfileConvolution i a f x = ∫ y, f (Function.update x i y)*a (x i-y) :=
  lineProfileConvolution_right a (fun y => f (Function.update x i y)) (x i)

private theorem translatedCoordinateAverage_expectation {d : ℕ} (i : Fin d)
    {scale : ℝ} (hs : 0 < scale) {u k : ℤ} (huk : u ≤ k)
    {f : (Fin d → ℝ) → ℂ} (hf : ∀ x, Integrable (fun y => f (Function.update x i y)))
    (x : Fin d → ℝ) :
    let R := scale*(2:ℝ)^(-u)
    let L := scale*(2:ℝ)^(-k)
    (↑R⁻¹ : ℂ) * (∫ s in Ico 0 R, translatedCoordinateAverage i L s f x) =
      coordinateProfileConvolution i (gridTentKernel L) f x :=
  randomGrid hs huk (hf x) (x i)

private noncomputable def uniformGridMeasure (R : ℝ) : Measure ℝ :=
  ENNReal.ofReal R⁻¹ • volume.restrict (Ico 0 R)

private theorem uniformGridMeasure_probability {R : ℝ} (hR : 0 < R) :
    IsProbabilityMeasure (uniformGridMeasure R) := by
  constructor
  rw [uniformGridMeasure, Measure.smul_apply, Measure.restrict_apply_univ, Real.volume_Ico,
    sub_zero, smul_eq_mul, ← ENNReal.ofReal_mul (inv_nonneg.mpr hR.le),
    inv_mul_cancel₀ hR.ne', ENNReal.ofReal_one]

private theorem uniformGridMeasure_integral {R : ℝ} (hR : 0 < R) (g : ℝ → ℂ) :
    ∫ s, g s ∂uniformGridMeasure R =
      (↑R⁻¹ : ℂ) * ∫ s in Ico 0 R, g s := by
  rw [uniformGridMeasure, integral_smul_measure, ENNReal.toReal_ofReal (inv_nonneg.mpr hR.le),
    Complex.real_smul]

private theorem translatedProfileMatch_distance {L : ℝ} (hL : 0 < L) {s x y : ℝ}
    (h : translatedProfileCell L s x = translatedProfileCell L s y) : |x-y| ≤ L := by
  let n := translatedProfileCell L s x
  have hx : (n:ℝ) ≤ (x-s)/L ∧ (x-s)/L < (n:ℝ)+1 :=
    Int.floor_eq_iff.mp (show ⌊(x-s)/L⌋ = n from rfl)
  have hy : (n:ℝ) ≤ (y-s)/L ∧ (y-s)/L < (n:ℝ)+1 :=
    Int.floor_eq_iff.mp h.symm
  rw [le_div_iff₀ hL, div_lt_iff₀ hL] at hx hy
  exact abs_le.mpr ⟨by linarith [hx.1, hy.2], by linarith [hx.2, hy.1]⟩

private noncomputable def gridDominatingKernel (L : ℝ) : ℝ → ℂ :=
  (Icc (-L) L).indicator (fun _ => (↑L⁻¹ : ℂ))

private theorem gridDominatingKernel_measurable (L : ℝ) : Measurable (gridDominatingKernel L) :=
  measurable_const.indicator measurableSet_Icc

private theorem gridDominatingKernel_integrable (L : ℝ) : Integrable (gridDominatingKernel L) := by
  rw [gridDominatingKernel, integrable_indicator_iff measurableSet_Icc]
  let : IsFiniteMeasure (volume.restrict (Icc (-L) L)) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact measure_Icc_lt_top⟩
  exact integrable_const _

private noncomputable def gridAverageDominant {d : ℕ} (i : Fin d) (L : ℝ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) : ℝ :=
  (coordinateProfileConvolution i (gridDominatingKernel L) (fun z => Complex.ofReal ‖f z‖) x).re

private theorem gridAverageDominant_nonneg {d : ℕ} (i : Fin d) {L : ℝ} (hL : 0 < L)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) :
    0 ≤ gridAverageDominant i L f x := by
  have he (y : ℝ) : gridDominatingKernel L y =
      Complex.ofReal ((Icc (-L) L).indicator (fun _ => L⁻¹) y) := by
    by_cases hy : y ∈ Icc (-L) L <;> simp [gridDominatingKernel,hy]
  unfold gridAverageDominant coordinateProfileConvolution
  simp_rw [he, ← Complex.ofReal_mul, integral_complex_ofReal, Complex.ofReal_re]
  apply integral_nonneg
  intro y
  exact mul_nonneg (Set.indicator_nonneg (fun _ _ => inv_nonneg.mpr hL.le) _) (norm_nonneg _)

private theorem translatedCoordinateAverage_norm_le_dominant {d : ℕ} (i : Fin d)
    {L : ℝ} (hL : 0 < L) (s : ℝ) {f : (Fin d → ℝ) → ℂ}
    (hf : ∀ x, Integrable (fun y => f (Function.update x i y))) (x : Fin d → ℝ) :
    ‖translatedCoordinateAverage i L s f x‖ ≤ gridAverageDominant i L f x := by
  let b (y : ℝ) := translatedProfileMatch L (x i) y s
  let F (y : ℝ) := f (Function.update x i y)
  let W (y : ℝ) := (Icc (x i-L) (x i+L)).indicator (fun y => ‖F y‖) y
  have he (y : ℝ) : gridDominatingKernel L (x i-y) =
        Complex.ofReal ((Icc (x i-L) (x i+L)).indicator (fun _ => L⁻¹) y) := by
    have h : x i-y ∈ Icc (-L) L ↔ y ∈ Icc (x i-L) (x i+L) := by
      simp only [mem_Icc]
      constructor <;> intro h <;> constructor <;> linarith [h.1,h.2]
    by_cases hy : y ∈ Icc (x i-L) (x i+L)
    · simp [gridDominatingKernel, h.mpr hy,hy]
    · simp [gridDominatingKernel, mt h.mp hy,hy]
  have hDominant : gridAverageDominant i L f x = L⁻¹ * ∫ y, W y := by
    unfold gridAverageDominant
    rw [coordinateProfileConvolution_right]
    simp_rw [he, ← Complex.ofReal_mul, integral_complex_ofReal, Complex.ofReal_re]
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with y
    by_cases hy : y ∈ Icc (x i-L) (x i+L) <;> simp [hy,W,F,mul_comm]
  have hb (y : ℝ) : ‖(b y:ℂ)*F y‖ ≤ W y := by
    by_cases hxy : translatedProfileCell L s (x i) = translatedProfileCell L s y
    · have h := abs_le.mp (translatedProfileMatch_distance hL hxy)
      have hy : y ∈ Icc (x i-L) (x i+L) := ⟨by linarith [h.2], by linarith [h.1]⟩
      simp [b, translatedProfileMatch, hxy, W, hy]
    · have hW : 0 ≤ W y := Set.indicator_nonneg (fun _ _ => norm_nonneg _) _
      simpa [b, translatedProfileMatch, hxy] using hW
  have hbm : Measurable b := (translatedProfileMatch_measurable L (x i)).comp
    (measurable_const.prodMk measurable_id)
  have hWi : Integrable W := (hf x).norm.indicator measurableSet_Icc
  have hI : Integrable (fun y => (b y:ℂ)*F y) :=
    hWi.mono' ((Complex.continuous_ofReal.measurable.comp hbm).aestronglyMeasurable.mul
      (hf x).aestronglyMeasurable) (Filter.Eventually.of_forall hb)
  rw [hDominant, translatedCoordinateAverage, translatedGridExpectation, norm_mul,
    Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (inv_nonneg.mpr hL.le)]
  exact mul_le_mul_of_nonneg_left ((norm_integral_le_integral_norm _).trans
    (integral_mono hI.norm hWi hb)) (inv_nonneg.mpr hL.le)

private theorem gridAverageDominant_memLp {d : ℕ} (i : Fin d) (L : ℝ) {p : ℝ} (hp : 1 < p)
    {f : (Fin d → ℝ) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (gridAverageDominant i L f) (ENNReal.ofReal p) volume := by
  have h := (coordinateProfile_young i hp (gridDominatingKernel_measurable L)
    (gridDominatingKernel_integrable L) hf.norm.ofReal).1
  exact h.norm.mono (Complex.continuous_re.comp_aestronglyMeasurable h.aestronglyMeasurable)
    (Filter.Eventually.of_forall fun x => by
      change ‖(coordinateProfileConvolution i (gridDominatingKernel L)
        (fun z => Complex.ofReal ‖f z‖) x).re‖ ≤ _
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      exact Complex.abs_re_le_norm _)

private theorem gridTentKernel_continuous (L : ℝ) : Continuous (gridTentKernel L) :=
  continuous_const.mul (tentProfile_lipschitz.continuous.comp (continuous_id.div_const L))

private theorem gridTentKernel_as_scale (L : ℝ) :
    gridTentKernel L = fun x => (↑L⁻¹ : ℂ)*tentProfile (L⁻¹*x) := by
  funext x
  change (↑L⁻¹ : ℂ)*tentProfile (x/L) = _
  rw [div_eq_mul_inv, mul_comm x L⁻¹]

private theorem gridTentKernel_integrable {L : ℝ} (hL : 0 < L) :
    Integrable (gridTentKernel L) := by
  have hI := profile_integrable tentProfile_lipschitz.continuous tentProfile_size_finite
  rw [gridTentKernel_as_scale]
  exact (hI.comp_mul_left' (R := L⁻¹) (inv_pos.mpr hL).ne').const_mul (↑L⁻¹ : ℂ)

private theorem gridTentKernel_fourier {L : ℝ} (hL : 0 < L) (ξ : ℝ) :
    𝓕 (gridTentKernel L) ξ = 𝓕 tentProfile (L*ξ) := by
  simpa only [gridTentKernel_as_scale, inv_inv] using
    lineProfileScale_fourier tentProfile (inv_pos.mpr hL) ξ

private theorem fourier_sub_line {a b : ℝ → ℂ} (ha : Integrable a) (hb : Integrable b) (ξ : ℝ) :
    𝓕 (a-b) ξ = 𝓕 a ξ-𝓕 b ξ := by
  simp only [Real.fourier_eq, Pi.sub_apply, smul_sub]
  exact integral_sub ((Real.fourierIntegral_convergent_iff ξ).mpr ha)
    ((Real.fourierIntegral_convergent_iff ξ).mpr hb)

private theorem lineProfileConvolution_sub_kernel_bounded {a b f : ℝ → ℂ}
    (ha : Integrable a) (hb : Integrable b) (hfM : Measurable f)
    {C : ℝ} (hC : 0 ≤ C) (hF : ∀ x, ‖f x‖ ≤ C) :
    lineProfileConvolution (a-b) f =
      lineProfileConvolution a f - lineProfileConvolution b f := by
  funext x
  have hi {g : ℝ → ℂ} (hg : Integrable g) :
      Integrable (fun y => g y*f (x-y)) := by
    apply (hg.norm.mul_const C).mono'
      (hg.aestronglyMeasurable.mul ((hfM.comp (measurable_const.sub measurable_id)).aestronglyMeasurable))
    filter_upwards [] with y
    change ‖g y*f (x-y)‖ ≤ ‖g y‖*C
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hF (x-y)) (norm_nonneg _)
  simp only [lineProfileConvolution, Pi.sub_apply, sub_mul]
  exact integral_sub (hi ha) (hi hb)

private theorem lineProfileConvolution_uniform {a f : ℝ → ℂ} (aI : Integrable a)
    {C : ℝ} (hC : 0 ≤ C) (hf : ∀ x, ‖f x‖ ≤ C) (x : ℝ) :
    ‖lineProfileConvolution a f x‖ ≤ (∫ y, ‖a y‖)*C := by
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← integral_mul_const]
  apply integral_mono_of_nonneg
  · exact Filter.Eventually.of_forall fun _ => norm_nonneg _
  · exact aI.norm.mul_const C
  · exact Filter.Eventually.of_forall fun y => by
      change ‖a y*f (x-y)‖ ≤ ‖a y‖*C
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hf (x-y)) (norm_nonneg _)

set_option maxHeartbeats 650000 in
private theorem lineProfileConvolution_assoc {a b f : ℝ → ℂ}
    (ha : Integrable a) (hb : Integrable b) (hf : Integrable f) (hbM : Measurable b)
    (hfM : Measurable f) {C : ℝ} (hC : 0 ≤ C) (hF : ∀ x, ‖f x‖ ≤ C) :
    lineProfileConvolution a (lineProfileConvolution b f) =
      lineProfileConvolution (lineProfileConvolution a b) f := by
  let M := ContinuousLinearMap.mul ℂ ℂ
  let M' := ContinuousLinearMap.mul ℝ ℝ
  let N := (fun x => ‖b x‖) ⋆[M'] (fun x => ‖f x‖)
  have hN (x : ℝ) : ‖N x‖ ≤ (∫ y, ‖b y‖)*C := by
    refine (norm_integral_le_integral_norm _).trans ?_
    rw [← integral_mul_const]
    apply integral_mono_of_nonneg
    · exact Filter.Eventually.of_forall fun _ => norm_nonneg _
    · exact hb.norm.mul_const C
    · filter_upwards [] with y
      change ‖‖b y‖*‖f (x-y)‖‖ ≤ ‖b y‖*C
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (norm_nonneg _) (norm_nonneg _))]
      exact mul_le_mul_of_nonneg_left (hF (x-y)) (norm_nonneg _)
  have hNm : Measurable N := by
    have hm : Measurable (fun z : ℝ×ℝ => ‖b z.2‖*‖f (z.1-z.2)‖) :=
      (hbM.norm.comp measurable_snd).mul (hfM.norm.comp (measurable_fst.sub measurable_snd))
    exact hm.stronglyMeasurable.integral_prod_right'.measurable
  funext x
  have hex : ConvolutionExistsAt (fun x => ‖a x‖) N x M' volume := by
    change Integrable (fun y => ‖a y‖*N (x-y))
    apply (ha.norm.mul_const ((∫ y, ‖b y‖)*C)).mono'
      (ha.norm.aestronglyMeasurable.mul ((hNm.comp (measurable_const.sub measurable_id)).aestronglyMeasurable))
    filter_upwards [] with y
    change ‖‖a y‖*N (x-y)‖ ≤ ‖a y‖*((∫ y, ‖b y‖)*C)
    rw [norm_mul, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg (a y))]
    exact mul_le_mul_of_nonneg_left (hN (x-y)) (norm_nonneg _)
  exact (MeasureTheory.convolution_assoc M M M M
    (fun x y z => mul_assoc x y z) ha.aestronglyMeasurable hb.aestronglyMeasurable hf.aestronglyMeasurable
    (ha.ae_convolution_exists M hb) (hb.norm.ae_convolution_exists M' hf.norm) hex).symm

private theorem gridTentKernel_dilation (k : ℤ) :
    gridTentKernel ((2:ℝ)^(-k)) = profileDilation tentProfile k := by
  funext y
  rw [gridTentKernel, profileDilation, zpow_neg, inv_inv, div_inv_eq_mul, mul_comm y]

set_option maxHeartbeats 850000 in
private theorem correctedTentDilation {lam : ℝ} (hlam : 0 < lam) {v ψ : SchwartzMap ℝ ℂ}
    (hV : ∀ z, tentFourierDifference lam z * (𝓕 v : SchwartzMap ℝ ℂ) z =
      (𝓕 ψ : SchwartzMap ℝ ℂ) z) (k : ℤ) :
    lineProfileConvolution (gridTentKernel (lam*(2:ℝ)^(-(k+1))) -
      gridTentKernel (lam*(2:ℝ)^(-k))) (profileDilation v k) =
      profileDilation ψ k := by
  let L := lam*(2:ℝ)^(-k)
  let L' := lam*(2:ℝ)^(-(k+1))
  have hL : 0 < L := by dsimp [L]; positivity
  have hL' : 0 < L' := by dsimp [L']; positivity
  let A := gridTentKernel L' - gridTentKernel L
  let B := profileDilation v k
  let C := profileDilation ψ k
  let D := lineProfileConvolution A B
  have hA : Integrable A := (gridTentKernel_integrable hL').sub (gridTentKernel_integrable hL)
  have hB : Integrable B := profileDilation_integrable v.integrable k
  have hC : Integrable C := profileDilation_integrable ψ.integrable k
  have hD : Integrable D := lineProfileConvolution_integrable hA hB
  have hBc : Continuous B := continuous_const.mul (v.continuous.comp (continuous_const.mul continuous_id))
  have hCc : Continuous C := continuous_const.mul (ψ.continuous.comp (continuous_const.mul continuous_id))
  have hBb : BddAbove (range fun x => ‖B x‖) := by
    refine ⟨(2:ℝ)^k*SchwartzMap.seminorm ℝ 0 0 v, ?_⟩
    rintro _ ⟨x,rfl⟩
    change ‖((↑((2:ℝ)^k) : ℂ) * v ((2:ℝ)^k*x))‖ ≤ _
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity : 0 < (2:ℝ)^k)]
    exact mul_le_mul_of_nonneg_left (SchwartzMap.norm_le_seminorm ℝ v _) (by positivity)
  have hDc : Continuous D :=
    hBb.continuous_convolution_right_of_integrable (ContinuousLinearMap.mul ℂ ℂ) hA hBc
  have hEq : 𝓕 D = 𝓕 C := by
    funext ξ
    rw [show 𝓕 D ξ = (𝓕 A ξ)*(𝓕 B ξ) from Real.fourier_mul_convolution_eq hA hB ξ]
    rw [show A = gridTentKernel L' - gridTentKernel L from rfl,
      fourier_sub_line (gridTentKernel_integrable hL') (gridTentKernel_integrable hL),
      gridTentKernel_fourier hL', gridTentKernel_fourier hL,
      show B = profileDilation v k from rfl, show C = profileDilation ψ k from rfl,
      profileDilation_fourier, profileDilation_fourier]
    have hlen : L' = L/2 := by
      dsimp only [L,L']
      rw [neg_add, zpow_add₀ (by norm_num : (2:ℝ) ≠ 0)]
      norm_num
      ring
    rw [hlen]
    change (𝓕 tentProfile ((L/2)*ξ) - 𝓕 tentProfile (L*ξ)) *
      (𝓕 v : SchwartzMap ℝ ℂ) ((2:ℝ)^(-k)*ξ) =
        (𝓕 ψ : SchwartzMap ℝ ℂ) ((2:ℝ)^(-k)*ξ)
    rw [show (L/2)*ξ = lam*((2:ℝ)^(-k)*ξ)/2 by dsimp only [L]; ring,
      show L*ξ = lam*((2:ℝ)^(-k)*ξ) by dsimp only [L]; ring]
    exact hV ((2:ℝ)^(-k)*ξ)
  have hFi : Integrable (𝓕 C) := by
    have he : 𝓕 C = fun ξ => (𝓕 ψ : SchwartzMap ℝ ℂ) ((2:ℝ)^(-k)*ξ) :=
      funext (profileDilation_fourier ψ k)
    rw [he]
    exact (SchwartzMap.integrable (𝓕 ψ : SchwartzMap ℝ ℂ)).comp_mul_left' (by positivity)
  calc
    D = 𝓕⁻ (𝓕 D) := (hDc.fourierInv_fourier_eq hD (hEq ▸ hFi)).symm
    _ = 𝓕⁻ (𝓕 C) := by rw [hEq]
    _ = C := hCc.fourierInv_fourier_eq hC hFi

private theorem finiteSigns_trace {ι : Type*} [DecidableEq ι] (S : Finset ι)
    (A : ι → ι → ℂ) :
    (↑S.powerset.card : ℂ)⁻¹ *
      (∑ u ∈ S.powerset, ∑ k ∈ S, ∑ l ∈ S,
        (Auto.LittlewoodPaley.rademacherSign u k * Auto.LittlewoodPaley.rademacherSign u l)*A k l) =
      ∑ k ∈ S, A k k := by
  let N := (S.powerset.card : ℂ)
  have hN : N ≠ 0 := Nat.cast_ne_zero.mpr
    ((Finset.card_pos.mpr ⟨∅, Finset.empty_mem_powerset S⟩).ne')
  have hSum (k : ι) (hk : k ∈ S) :
      (∑ u ∈ S.powerset, ∑ l ∈ S,
        (Auto.LittlewoodPaley.rademacherSign u k * Auto.LittlewoodPaley.rademacherSign u l)*A k l) =
        N*A k k := by
    rw [Finset.sum_comm]
    simp_rw [← Finset.sum_mul]
    have he (l : ι) (hl : l ∈ S) :
        (∑ u ∈ S.powerset, Auto.LittlewoodPaley.rademacherSign u k *
          Auto.LittlewoodPaley.rademacherSign u l) * A k l =
          if l = k then N*A k k else 0 := by
      rw [finiteSigns_orthogonal S hk hl]
      by_cases h : l = k
      · simp [h,N]
      · simp [h,Ne.symm h]
    calc
      _ = ∑ l ∈ S, if l = k then N*A k k else 0 := Finset.sum_congr rfl he
      _ = _ := by simp [hk]
  rw [Finset.sum_comm]
  change N⁻¹ * (∑ k ∈ S, ∑ u ∈ S.powerset, ∑ l ∈ S, _) = _
  have he : (∑ k ∈ S, ∑ u ∈ S.powerset, ∑ l ∈ S,
        (Auto.LittlewoodPaley.rademacherSign u k * Auto.LittlewoodPaley.rademacherSign u l)*A k l) =
      ∑ k ∈ S, N*A k k := Finset.sum_congr rfl hSum
  rw [he, ← Finset.mul_sum, ← mul_assoc, inv_mul_cancel₀ hN, one_mul]

private theorem coordinateProfileConvolution_fiber {d : ℕ} (i : Fin d) (a : ℝ → ℂ)
    (f : (Fin d → ℝ) → ℂ) (x : Fin d → ℝ) (t : ℝ) :
    coordinateProfileConvolution i a f (Function.update x i t) =
      lineProfileConvolution a (fun y => f (Function.update x i y)) t := by
  simp [coordinateProfileConvolution, lineProfileConvolution, Function.update_idem]

private theorem coordinateProfileConvolution_fiber_integrable {d : ℕ} (i : Fin d)
    {a : ℝ → ℂ} (ha : Integrable a) {f : (Fin d → ℝ) → ℂ}
    (hf : ∀ x, Integrable (fun y => f (Function.update x i y))) (x : Fin d → ℝ) :
    Integrable (fun t => coordinateProfileConvolution i a f (Function.update x i t)) := by
  simp_rw [coordinateProfileConvolution_fiber]
  exact lineProfileConvolution_integrable ha (hf x)

private theorem coordinateProfileConvolution_sub_kernel {d : ℕ} (i : Fin d)
    {a b : ℝ → ℂ} (ha : Integrable a) (hb : Integrable b) {f : (Fin d → ℝ) → ℂ}
    (hf : Measurable f) {C : ℝ} (hC : 0 ≤ C) (hF : ∀ x, ‖f x‖ ≤ C) (x : Fin d → ℝ) :
    coordinateProfileConvolution i (a-b) f x =
      coordinateProfileConvolution i a f x - coordinateProfileConvolution i b f x := by
  have hm : Measurable (fun y => f (Function.update x i y)) :=
    hf.comp (measurable_update' (a := i) |>.comp (measurable_const.prodMk measurable_id))
  exact congrFun (lineProfileConvolution_sub_kernel_bounded ha hb hm hC
    (fun y => hF (Function.update x i y))) (x i)

private theorem coordinateProfileConvolution_assoc {d : ℕ} (i : Fin d)
    {a b : ℝ → ℂ} (ha : Integrable a) (hb : Integrable b) (hbM : Measurable b)
    {f : (Fin d → ℝ) → ℂ} (hfM : Measurable f)
    (hf : ∀ x, Integrable (fun y => f (Function.update x i y)))
    {C : ℝ} (hC : 0 ≤ C) (hF : ∀ x, ‖f x‖ ≤ C) (x : Fin d → ℝ) :
    coordinateProfileConvolution i a (coordinateProfileConvolution i b f) x =
      coordinateProfileConvolution i (lineProfileConvolution a b) f x := by
  have hm : Measurable (fun y => f (Function.update x i y)) :=
    hfM.comp (measurable_update' (a := i) |>.comp (measurable_const.prodMk measurable_id))
  change lineProfileConvolution a (fun y =>
    coordinateProfileConvolution i b f (Function.update x i y)) (x i) = _
  simp_rw [coordinateProfileConvolution_fiber i b f x]
  exact congrFun (lineProfileConvolution_assoc ha hb (hf x) hbM hm hC
    (fun y => hF (Function.update x i y))) (x i)

set_option maxHeartbeats 700000 in
private theorem integrate_grid_product {d : ℕ} (ν : Fin d → Measure ℝ)
    [∀ i, IsProbabilityMeasure (ν i)] {g : Fin d → ℝ → (Fin d → ℝ) → ℂ}
    (hgm : ∀ i, Measurable (fun z : ℝ × (Fin d → ℝ) => g i z.1 z.2))
    (h : (Fin d → ℝ) → ℂ) (hm : Measurable h)
    {W : Fin d → (Fin d → ℝ) → ℝ} (hW : ∀ i s x, ‖g i s x‖ ≤ W i x)
    (hI : Integrable (fun x => ‖h x‖ * ∏ i, W i x)) :
    Integrable (fun a => ∫ x, h x * ∏ i, g i (a i) x) (Measure.pi ν) ∧
    (∫ a, (∫ x, h x * ∏ i, g i (a i) x) ∂Measure.pi ν) =
      ∫ x, h x * ∏ i, (∫ s, g i s x ∂ν i) := by
  let μ := Measure.pi ν
  let F (z : (Fin d → ℝ) × (Fin d → ℝ)) := h z.2 * ∏ i, g i (z.1 i) z.2
  have hG (i : Fin d) : Measurable (fun z : (Fin d → ℝ) × (Fin d → ℝ) => g i (z.1 i) z.2) := by
    have hmap : Measurable (fun z : (Fin d → ℝ) × (Fin d → ℝ) => (z.1 i,z.2)) :=
      ((measurable_pi_apply i).comp measurable_fst).prodMk measurable_snd
    exact (hgm i).comp hmap
  have hF : Measurable F := (hm.comp measurable_snd).mul
    (Finset.measurable_prod _ fun i _ => hG i)
  have hi : Integrable F (μ.prod volume) := by
    apply (hI.comp_snd μ).mono' hF.aestronglyMeasurable
    filter_upwards [] with z
    change ‖h z.2 * ∏ i, g i (z.1 i) z.2‖ ≤ ‖h z.2‖ * ∏ i, W i z.2
    rw [norm_mul, norm_prod]
    exact mul_le_mul_of_nonneg_left
      (Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) (fun i _ => hW i (z.1 i) z.2))
      (norm_nonneg _)
  refine ⟨hi.integral_prod_left, ?_⟩
  change (∫ a, (∫ x, F (a,x)) ∂μ) = _
  rw [integral_integral_swap hi]
  apply integral_congr_ae
  filter_upwards [] with x
  change (∫ a, h x * ∏ i, g i (a i) x ∂μ) = _
  rw [integral_const_mul, integral_fintype_prod_eq_prod (fun i s => g i s x)]

private theorem conjugateFormExponents {d : ℕ} {p : Fin d → ℝ} {r : ℝ}
    (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹) :
    ∑ i : Option (Fin d), (Option.elim i r.conjExponent p)⁻¹ = 1 := by
  rw [Fintype.sum_option]
  change r.conjExponent⁻¹ + (∑ i, (p i)⁻¹) = 1
  rw [← hSum]
  have hh := (Real.HolderConjugate.conjExponent hr).symm.one_div_add_one_div
  simpa only [one_div, inv_one] using hh

private theorem gridProduct_integrable {d : ℕ} {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {W : Fin d → (Fin d → ℝ) → ℝ} (hW : ∀ i, Measurable (W i))
    (hLp : ∀ i, MemLp (W i) (ENNReal.ofReal (p i)) volume)
    {h : (Fin d → ℝ) → ℂ} (hh : MemLp h (ENNReal.ofReal r.conjExponent) volume) :
    Integrable (fun x => ‖h x‖ * ∏ i, W i x) := by
  let _ : ENNReal.HolderConjugate (ENNReal.ofReal r) (ENNReal.ofReal r.conjExponent) :=
    Auto.LpSpaceFacts.ofReal_holderConjugate r hr
  let P (x : Fin d → ℝ) := ∏ i, W i x
  let Q (x : Fin d → ℝ) := ‖h x‖
  have hi : Integrable (P * Q) :=
    (finiteProfileProduct_bound hp hr hSum hW hLp).1.integrable_mul hh.norm
  have he : P * Q = fun x => ‖h x‖ * ∏ i, W i x := funext fun x => mul_comm (P x) (Q x)
  rwa [he] at hi

private theorem gridAverageDominant_measurable {d : ℕ} (i : Fin d) (L : ℝ)
    {f : (Fin d → ℝ) → ℂ} (hf : Measurable f) : Measurable (gridAverageDominant i L f) :=
  Complex.continuous_re.measurable.comp
    (coordinateProfileConvolution_measurable i (gridDominatingKernel_measurable L)
      (Complex.continuous_ofReal.measurable.comp hf.norm))

private noncomputable def translatedProfileFactor {d : ℕ} (b : Fin d) (scale : Fin d → ℝ)
    (k : ℤ) (f : Fin d → (Fin d → ℝ) → ℂ) (i : Fin d) (s : ℝ) (x : Fin d → ℝ) : ℂ :=
  if i = b then
    translatedCoordinateAverage i (scale i*(2:ℝ)^(-(k+1))) s (f i) x -
      translatedCoordinateAverage i (scale i*(2:ℝ)^(-k)) s (f i) x
  else translatedCoordinateAverage i (scale i*(2:ℝ)^(-k)) s (f i) x

private noncomputable def expectedProfileFactor {d : ℕ} (b : Fin d) (scale : Fin d → ℝ)
    (k : ℤ) (f : Fin d → (Fin d → ℝ) → ℂ) (i : Fin d) (x : Fin d → ℝ) : ℂ :=
  if i = b then
    coordinateProfileConvolution i (gridTentKernel (scale i*(2:ℝ)^(-(k+1)))) (f i) x -
      coordinateProfileConvolution i (gridTentKernel (scale i*(2:ℝ)^(-k))) (f i) x
  else coordinateProfileConvolution i (gridTentKernel (scale i*(2:ℝ)^(-k))) (f i) x

set_option maxHeartbeats 1050000 in
private theorem integrate_translatedProfileFactors {d : ℕ} (b : Fin d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    (scale : Fin d → ℝ) (hs : ∀ i, 0 < scale i) {u k : ℤ} (huk : u ≤ k)
    {f : Fin d → (Fin d → ℝ) → ℂ}
    (hfm : ∀ i, Measurable (f i)) (hfp : ∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume)
    (hfI : ∀ i x, Integrable (fun y => f i (Function.update x i y)))
    {h : (Fin d → ℝ) → ℂ} (hm : Measurable h) (hLp : MemLp h (ENNReal.ofReal r.conjExponent) volume) :
    (∀ a : Fin d → ℝ, Integrable (fun x => h x * ∏ i, translatedProfileFactor b scale k f i (a i) x)) ∧
    Integrable (fun a => ∫ x, h x * ∏ i, translatedProfileFactor b scale k f i (a i) x)
      (Measure.pi (fun i => uniformGridMeasure (scale i*(2:ℝ)^(-u)))) ∧
    (∫ a, (∫ x, h x * ∏ i, translatedProfileFactor b scale k f i (a i) x)
      ∂Measure.pi (fun i => uniformGridMeasure (scale i*(2:ℝ)^(-u)))) =
      ∫ x, h x * ∏ i, expectedProfileFactor b scale k f i x := by
  let ν (i : Fin d) := uniformGridMeasure (scale i*(2:ℝ)^(-u))
  have hR (i : Fin d) : 0 < scale i*(2:ℝ)^(-u) := by positivity [hs i]
  letI (i : Fin d) : IsProbabilityMeasure (ν i) := uniformGridMeasure_probability (hR i)
  let L (i : Fin d) := scale i*(2:ℝ)^(-k)
  let H (i : Fin d) := scale i*(2:ℝ)^(-(k+1))
  have hL (i : Fin d) : 0 < L i := by dsimp [L]; positivity [hs i]
  have hH (i : Fin d) : 0 < H i := by dsimp [H]; positivity [hs i]
  let G := translatedProfileFactor b scale k f
  let W (i : Fin d) := gridAverageDominant i (H i) (f i) + gridAverageDominant i (L i) (f i)
  have hWm (i : Fin d) : Measurable (W i) :=
    (gridAverageDominant_measurable i _ (hfm i)).add (gridAverageDominant_measurable i _ (hfm i))
  have hWp (i : Fin d) : MemLp (W i) (ENNReal.ofReal (p i)) volume :=
    (gridAverageDominant_memLp i _ (hp i) (hfp i)).add (gridAverageDominant_memLp i _ (hp i) (hfp i))
  have hGm (i : Fin d) : Measurable (fun z : ℝ×(Fin d → ℝ) => G i z.1 z.2) := by
    by_cases hi : i = b
    · let f₁ (z : ℝ×(Fin d → ℝ)) := translatedCoordinateAverage i (H i) z.1 (f i) z.2
      let f₂ (z : ℝ×(Fin d → ℝ)) := translatedCoordinateAverage i (L i) z.1 (f i) z.2
      have he : (fun z : ℝ×(Fin d → ℝ) => G i z.1 z.2) = f₁ - f₂ := by
        funext z
        simp only [G, translatedProfileFactor, if_pos hi, f₁, f₂, Pi.sub_apply, H, L]
      rw [he]
      exact (translatedCoordinateAverage_measurable i (H i) (hfm i)).sub
        (translatedCoordinateAverage_measurable i (L i) (hfm i))
    · simpa only [G, translatedProfileFactor, if_neg hi, L] using
        translatedCoordinateAverage_measurable i (L i) (hfm i)
  have hGW (i : Fin d) (s : ℝ) (x : Fin d → ℝ) : ‖G i s x‖ ≤ W i x := by
    have h₁ := translatedCoordinateAverage_norm_le_dominant i (hH i) s (hfI i) x
    have h₂ := translatedCoordinateAverage_norm_le_dominant i (hL i) s (hfI i) x
    by_cases hi : i = b
    · simp only [G, translatedProfileFactor, if_pos hi]
      exact (norm_sub_le _ _).trans (add_le_add h₁ h₂)
    · simp only [G, translatedProfileFactor, if_neg hi]
      exact h₂.trans (le_add_of_nonneg_left (gridAverageDominant_nonneg i (hH i) (f i) x))
  have hDom := gridProduct_integrable hp hr hSum hWm hWp hLp
  have hAvg := integrate_grid_product ν hGm h hm hGW hDom
  refine ⟨?_, hAvg.1, ?_⟩
  · intro a
    have hgm' (i : Fin d) : Measurable (fun x : Fin d → ℝ => G i (a i) x) := by
      have he : Measurable (fun x : Fin d → ℝ => (a i,x)) := measurable_const.prodMk measurable_id
      change Measurable ((fun z : ℝ×(Fin d → ℝ) => G i z.1 z.2) ∘
        (fun x : Fin d → ℝ => (a i,x)))
      exact (hGm i).comp he
    have hFm : Measurable (fun x => h x * ∏ i, G i (a i) x) :=
      hm.mul (Finset.measurable_prod _ fun i _ => hgm' i)
    refine hDom.mono' hFm.aestronglyMeasurable (Filter.Eventually.of_forall fun x => ?_)
    change ‖h x*(∏ i, G i (a i) x)‖ ≤ ‖h x‖*(∏ i, W i x)
    rw [norm_mul,norm_prod]
    exact mul_le_mul_of_nonneg_left
      (Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) (fun i _ => hGW i (a i) x))
      (norm_nonneg _)
  change (∫ a, (∫ x, h x * ∏ i, G i (a i) x) ∂Measure.pi ν) = _
  rw [hAvg.2]
  apply integral_congr_ae
  filter_upwards [] with x
  congr 1
  apply Finset.prod_congr rfl
  intro i _
  have hAv (l : ℤ) (hul : u ≤ l) :
      (∫ s, translatedCoordinateAverage i (scale i*(2:ℝ)^(-l)) s (f i) x ∂ν i) =
        coordinateProfileConvolution i (gridTentKernel (scale i*(2:ℝ)^(-l))) (f i) x := by
    rw [show ν i = uniformGridMeasure _ from rfl, uniformGridMeasure_integral (hR i)]
    exact translatedCoordinateAverage_expectation i (hs i) hul (hfI i) x
  have hInt (l : ℝ) (hl : 0 < l) :
      Integrable (fun s => translatedCoordinateAverage i l s (f i) x) (ν i) := by
    apply (integrable_const (gridAverageDominant i l (f i) x)).mono'
      (((translatedCoordinateAverage_measurable i l (hfm i)).comp
        (measurable_id.prodMk measurable_const)).aestronglyMeasurable)
    exact Filter.Eventually.of_forall fun s =>
      translatedCoordinateAverage_norm_le_dominant i hl s (hfI i) x
  by_cases hi : i = b
  · simp only [G, translatedProfileFactor, expectedProfileFactor, if_pos hi]
    rw [integral_sub (hInt _ (hH i)) (hInt _ (hL i)), hAv (k+1) (by omega), hAv k huk]
  · simp only [G, translatedProfileFactor, expectedProfileFactor, if_neg hi, hAv k huk]

private theorem separatedProfileProduct_memLp {d : ℕ} {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {a : Fin d → ℝ → ℂ} (ha : ∀ i, Continuous (a i)) (hI : ∀ i, Integrable (a i))
    {f : Fin d → (Fin d → ℝ) → ℂ} (hf : ∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume)
    (k : ℤ) :
    MemLp (fun x => ∏ i, coordinateProfileConvolution i (profileDilation (a i) k) (f i) x)
      (ENNReal.ofReal r) volume := by
  have hm (i : Fin d) : Measurable (profileDilation (a i) k) :=
    measurable_const.mul ((ha i).measurable.comp (measurable_const.mul measurable_id))
  have hterm (i : Fin d) : MemLp
      (coordinateProfileConvolution i (profileDilation (a i) k) (f i))
      (ENNReal.ofReal (p i)) volume :=
    (coordinateProfile_young i (hp i) (hm i) (profileDilation_integrable (hI i) k) (hf i)).1
  have h := MemLp.fun_prod (s := Finset.univ) fun i _ => hterm i
  rwa [finiteProfileExponent hp hr hSum] at h

private theorem separatedProfileSum_memLp {d : ℕ} {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {a : Fin d → ℝ → ℂ} (ha : ∀ i, Continuous (a i)) (hI : ∀ i, Integrable (a i))
    {f : Fin d → (Fin d → ℝ) → ℂ} (hf : ∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume)
    (S : Finset ℤ) (z : ℤ → ℂ) : MemLp (separatedProfileSum S z a f) (ENNReal.ofReal r) volume :=
  memLp_finsetSum S fun k _ => (separatedProfileProduct_memLp hp hr hSum ha hI hf k).const_mul (z k)

private theorem translatedCoordinateAverage_finset {d : ℕ} (i : Fin d) (L s : ℝ)
    {ι : Type*} (S : Finset ι) (w : ι → ℂ) (g : ι → (Fin d → ℝ) → ℂ)
    (hg : ∀ j ∈ S, ∀ x, Integrable (fun y => g j (Function.update x i y))) (x : Fin d → ℝ) :
    translatedCoordinateAverage i L s (fun y => ∑ j ∈ S, w j * g j y) x =
      ∑ j ∈ S, w j * translatedCoordinateAverage i L s (g j) x := by
  unfold translatedCoordinateAverage translatedGridExpectation
  simp_rw [Finset.mul_sum, ← mul_assoc]
  rw [integral_finsetSum]
  · rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    have he (y : ℝ) : (translatedProfileMatch L (x i) y s : ℂ) * w j *
        g j (Function.update x i y) =
          w j * ((translatedProfileMatch L (x i) y s : ℂ) * g j (Function.update x i y)) := by ring
    simp_rw [he, integral_const_mul]
    ring
  · intro j hj
    have hM : Measurable (fun y => (translatedProfileMatch L (x i) y s : ℂ)) :=
      Complex.continuous_ofReal.measurable.comp
        ((translatedProfileMatch_measurable L (x i)).comp (measurable_const.prodMk measurable_id))
    have hI : Integrable (fun y => w j * g j (Function.update x i y)) := (hg j hj x).const_mul (w j)
    refine hI.norm.mono' (by
      exact (hM.aestronglyMeasurable.mul hI.aestronglyMeasurable).congr
        (Filter.Eventually.of_forall fun y => (mul_assoc _ _ _).symm)) ?_
    filter_upwards [] with y
    have h := translatedProfileMatch_range L (x i) y s
    change ‖(translatedProfileMatch L (x i) y s : ℂ)*w j * g j (Function.update x i y)‖ ≤ _
    rw [mul_assoc, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h.1]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right h.2 (norm_nonneg (w j*g j (Function.update x i y)))

private theorem translatedProfileFactor_replace_high {d : ℕ} (b : Fin d) (scale : Fin d → ℝ)
    (k : ℤ) {ι : Type*} (S : Finset ι) (w : ι → ℂ) (g : ι → (Fin d → ℝ) → ℂ)
    (hfI : ∀ j ∈ S, ∀ x, Integrable (fun y => g j (Function.update x b y)))
    (f : Fin d → (Fin d → ℝ) → ℂ) (a : Fin d → ℝ) (x : Fin d → ℝ) :
    (∏ i, translatedProfileFactor b scale k (Function.update f b (fun x => ∑ j ∈ S, w j*g j x))
      i (a i) x) =
      ∑ j ∈ S, w j*(∏ i, translatedProfileFactor b scale k (Function.update f b (g j)) i (a i) x) := by
  let U := (Finset.univ : Finset (Fin d)).erase b
  let L := scale b*(2:ℝ)^(-k)
  let L' := scale b*(2:ℝ)^(-(k+1))
  have he (G : (Fin d → ℝ) → ℂ) :
      (∏ i, translatedProfileFactor b scale k (Function.update f b G) i (a i) x) =
      (translatedCoordinateAverage b L' (a b) G x - translatedCoordinateAverage b L (a b) G x) *
        (∏ i ∈ U, translatedProfileFactor b scale k f i (a i) x) := by
    rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ b)]
    congr 1
    · simp only [translatedProfileFactor, ite_true, Function.update_self, L, L']
    · apply Finset.prod_congr rfl
      intro i hi
      have hn := (Finset.mem_erase.mp hi).1
      simp [translatedProfileFactor,hn, Function.update_of_ne hn]
  simp_rw [he]
  rw [translatedCoordinateAverage_finset b L' (a b) S w g hfI x,
    translatedCoordinateAverage_finset b L (a b) S w g hfI x, ← Finset.sum_sub_distrib,
    Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _
  ring

private theorem finiteSigns_norm_average_le {ι : Type*} [DecidableEq ι] (S : Finset ι)
    (F : Finset ι → ℂ) {B : ℝ} (h : ∀ a ∈ S.powerset, ‖F a‖ ≤ B) :
    ‖(↑S.powerset.card : ℂ)⁻¹ * ∑ a ∈ S.powerset, F a‖ ≤ B := by
  have hN : (0:ℝ) < S.powerset.card := by
    exact_mod_cast Finset.card_pos.mpr ⟨∅, Finset.empty_mem_powerset S⟩
  rw [norm_mul, norm_inv, Complex.norm_natCast]
  refine (mul_le_mul_of_nonneg_left (norm_sum_le _ _) (inv_nonneg.mpr hN.le)).trans ?_
  calc
    _ ≤ (S.powerset.card : ℝ)⁻¹ * ∑ a ∈ S.powerset, B :=
      mul_le_mul_of_nonneg_left (Finset.sum_le_sum h) (inv_nonneg.mpr hN.le)
    _ = B := by rw [Finset.sum_const, nsmul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hN.ne', one_mul]

private theorem coordinateSignedCorrections_bound {d : ℕ} (b : Fin d) {p : ℝ} (hp : 1 < p) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (v : SchwartzMap ℝ ℂ), (∫ y, v y) = 0 →
      ∀ (f : (Fin d → ℝ) → ℂ), Measurable f → MemLp f (ENNReal.ofReal p) volume →
      ∀ (u : ℤ) (S : Finset ℕ) (ε : ℕ → ℂ), (∀ k ∈ S, ‖ε k‖ ≤ 1) →
      let g (x : Fin d → ℝ) := ∑ k ∈ S, ε k *
        coordinateProfileConvolution b (profileDilation v (u+k)) f x
      MemLp g (ENNReal.ofReal p) volume ∧
      lpNorm g (ENNReal.ofReal p) volume ≤ B * (profileSize v).toReal * lpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C, hC, h⟩ := coordinateProfile_signed hp
  refine ⟨C.toReal, ENNReal.toReal_nonneg, ?_⟩
  intro v hV f hfm hfp u S ε hε
  let inv (k : ℤ) := (k-u).toNat
  let add (k : ℕ) := u+(k:ℤ)
  have hInv (k : ℕ) : inv (add k) = k := by simp [inv,add]
  have hInj : Function.Injective add := fun a b h => by
    simpa only [hInv] using congrArg inv h
  have hν (k : ℤ) (hk : k ∈ S.image add) : ‖ε (inv k)‖ ≤ 1 := by
    obtain ⟨j,hj,rfl⟩ := Finset.mem_image.mp hk
    simpa only [hInv] using hε j hj
  have hQ := schwartzProfile_size_finite v
  have hh := h b (schwartzProfile_locallyAbsolutelyContinuous v) hQ hV hfm hfp
    (S.image add) (ε ∘ inv) hν
  simp_rw [Finset.sum_image (fun i _ j _ e => hInj e), Function.comp_apply, hInv] at hh
  refine ⟨hh.1, ?_⟩
  exact (ENNReal.toReal_mono (ENNReal.mul_ne_top (ENNReal.mul_ne_top hC hQ) hfp.eLpNorm_ne_top)
    hh.2).trans_eq (by simp only [ENNReal.toReal_mul,toReal_eLpNorm])

set_option maxHeartbeats 2000000 in
private theorem separatedTent_pairing {d : ℕ} (hd : 2 ≤ d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {c C : ℝ} (hc : 0 < c) (hcC : c < C) (b : Fin d) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (ψ : SchwartzMap ℝ ℂ),
      Function.support ((𝓕 ψ : SchwartzMap ℝ ℂ) : ℝ → ℂ) ⊆ {z | c ≤ |z| ∧ |z| ≤ C} →
      ∀ (u : ℤ) (T : ℕ) (z : ℕ → ℂ), (∀ k, ‖z k‖ ≤ 1) →
      ∀ (f : Fin d → (Fin d → ℝ) → ℂ), (∀ i, Measurable (f i)) →
      (∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume) →
      (∀ i x, Integrable (fun y => f i (Function.update x i y))) →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ x, ‖f b x‖ ≤ B) →
      ∀ (h : (Fin d → ℝ) → ℂ), Measurable h → MemLp h (ENNReal.ofReal r.conjExponent) volume →
      ‖∑ k ∈ Finset.range T, z k * ∫ x, h x *
        ∏ i, coordinateProfileConvolution i
          (profileDilation (if i = b then (ψ : ℝ → ℂ) else tentProfile) (u+k)) (f i) x‖ ≤
      K * profileFourierFourNorm (𝓕 ψ) *
        (∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume) * lpNorm h (ENNReal.ofReal r.conjExponent) volume := by
  let P (i : Option (Fin d)) := Option.elim i r.conjExponent p
  have hP (i : Option (Fin d)) : 1 < P i := by
    cases i with
    | none => exact (Real.HolderConjugate.conjExponent hr).symm.lt
    | some i => exact hp i
  have hSumP : ∑ i, 1/P i = 1 := by
    simpa only [one_div] using conjugateFormExponents hr hSum
  obtain ⟨Cdy, hCdy, hDy⟩ := dyadic hd P hP hSumP
  obtain ⟨lam, L, hlam, hL, _, hInv⟩ := tentInverse hc hcC
  obtain ⟨B, hB, hSigned⟩ := coordinateSignedCorrections_bound b (hp b)
  refine ⟨Cdy*B*L, by positivity, ?_⟩
  intro ψ hψ u T z hz f hfM hfLp hfI hfB h hM hLp
  obtain ⟨v, hV₀, hV, hVBound⟩ := hInv ψ hψ
  have hQ := schwartzProfile_size_finite v
  let S := Finset.range T
  let scale (i : Fin d) := if i = b then lam else 1
  have hs (i : Fin d) : 0 < scale i := by dsimp only [scale]; split <;> positivity
  let R (i : Fin d) := scale i*(2:ℝ)^(-u)
  let ν (i : Fin d) := uniformGridMeasure (R i)
  let _ (i : Fin d) : IsProbabilityMeasure (ν i) :=
    uniformGridMeasure_probability (mul_pos (hs i) (by positivity))
  let μ := Measure.pi ν
  let G (l : ℕ) := coordinateProfileConvolution b (profileDilation v (u+l)) (f b)
  have hGI (l : ℕ) : Integrable (profileDilation v (u+l)) := profileDilation_integrable v.integrable _
  have hGK (l : ℕ) : Measurable (profileDilation v (u+l)) :=
    measurable_const.mul (v.continuous.measurable.comp (measurable_const.mul measurable_id))
  have hGm (l : ℕ) : Measurable (G l) :=
    coordinateProfileConvolution_measurable b (hGK l) (hfM b)
  have hGp (l : ℕ) : MemLp (G l) (ENNReal.ofReal (p b)) volume :=
    (coordinateProfile_young b (hp b) (hGK l) (hGI l) (hfLp b)).1
  have hGf (l : ℕ) (x : Fin d → ℝ) : Integrable (fun y => G l (Function.update x b y)) :=
    coordinateProfileConvolution_fiber_integrable b (hGI l) (hfI b) x
  let F (l : ℕ) := Function.update f b (G l)
  have hFm (l : ℕ) (i : Fin d) : Measurable (F l i) := by
    by_cases hi : i = b
    · subst i; simpa only [F, Function.update_self] using hGm l
    · simpa only [F, Function.update_of_ne hi] using hfM i
  have hFp (l : ℕ) (i : Fin d) : MemLp (F l i) (ENNReal.ofReal (p i)) volume := by
    by_cases hi : i = b
    · subst i; simpa only [F, Function.update_self] using hGp l
    · simpa only [F, Function.update_of_ne hi] using hfLp i
  have hFf (l : ℕ) (i : Fin d) (x : Fin d → ℝ) : Integrable (fun y => F l i (Function.update x i y)) := by
    by_cases hi : i = b
    · subst i; simpa only [F, Function.update_self] using hGf l x
    · simpa only [F, Function.update_of_ne hi] using hfI i x
  let A (k l : ℕ) (a : Fin d → ℝ) :=
    z k * ∫ x, h x * ∏ i, translatedProfileFactor b scale (u+k) (F l) i (a i) x
  have hAvg (k l : ℕ) := integrate_translatedProfileFactors b hp hr hSum scale hs
    (show u ≤ u+(k:ℤ) by omega) (hFm l) (hFp l) (hFf l) hM hLp
  let D (a : Fin d → ℝ) := ∑ k ∈ S, A k k a
  have hIff (k : ℕ) (x : Fin d → ℝ) :
      (∏ i, expectedProfileFactor b scale (u+k) (F k) i x) =
        ∏ i, coordinateProfileConvolution i
          (profileDilation (if i = b then (ψ : ℝ → ℂ) else tentProfile) (u+k)) (f i) x := by
    obtain ⟨M, hM₀, hMax⟩ := hfB
    apply Finset.prod_congr rfl
    intro i _
    by_cases hi : i = b
    · subst i
      have hL₁ : 0 < lam*(2:ℝ)^(-(u+(k:ℤ)+1)) := by positivity
      have hL₀ : 0 < lam*(2:ℝ)^(-(u+(k:ℤ))) := by positivity
      have hGb : ∀ y, ‖G k y‖ ≤ (∫ t, ‖profileDilation v (u+k) t‖)*M := fun y =>
        lineProfileConvolution_uniform (hGI k) hM₀ (fun t => hMax (Function.update y b t)) (y b)
      simp only [expectedProfileFactor, F, Function.update_self, scale, ite_true]
      rw [← coordinateProfileConvolution_sub_kernel b (gridTentKernel_integrable hL₁)
        (gridTentKernel_integrable hL₀) (hGm k) (by positivity) hGb x]
      change coordinateProfileConvolution b _ (coordinateProfileConvolution b
        (profileDilation v (u+k)) (f b)) x = _
      rw [coordinateProfileConvolution_assoc b ((gridTentKernel_integrable hL₁).sub
        (gridTentKernel_integrable hL₀)) (hGI k) (hGK k) (hfM b) (hfI b) hM₀ hMax x,
        correctedTentDilation hlam hV (u+k)]
    · simp only [expectedProfileFactor, F, Function.update_of_ne hi, scale, hi, ite_false,
        one_mul, gridTentKernel_dilation]
  have hTrace : (∫ a, D a ∂μ) = ∑ k ∈ S, z k * ∫ x, h x *
        ∏ i, coordinateProfileConvolution i
          (profileDilation (if i = b then (ψ : ℝ → ℂ) else tentProfile) (u+k)) (f i) x := by
    rw [show D = fun a => ∑ k ∈ S, A k k a from rfl, integral_finsetSum]
    · apply Finset.sum_congr rfl
      intro k _
      rw [show A k k = fun a => z k * _ from rfl, integral_const_mul, (hAvg k k).2.2]
      simp_rw [hIff]
    · exact fun k _ => (hAvg k k).2.1.const_mul (z k)
  let ε := Auto.LittlewoodPaley.rademacherSign (I := ℕ)
  let N := (S.powerset.card : ℂ)
  let K₀ := Cdy*B*L*profileFourierFourNorm (𝓕 ψ) *
    (∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume) * lpNorm h (ENNReal.ofReal r.conjExponent) volume
  have hPoint (a : Fin d → ℝ) : ‖D a‖ ≤ K₀ := by
    rw [show D a = ∑ k ∈ S, A k k a from rfl, ← finiteSigns_trace S (fun k l => A k l a)]
    apply finiteSigns_norm_average_le
    intro t _
    let Gt (x : Fin d → ℝ) := ∑ l ∈ S, ε t l*G l x
    let ft (i : Option (Fin d)) := Option.elim i h (Function.update f b Gt)
    have hε (l : ℕ) : ‖ε t l‖ ≤ 1 := by dsimp only [ε, Auto.LittlewoodPaley.rademacherSign]; split <;> simp
    have hGt := hSigned v hV₀ (f b) (hfM b) (hfLp b) u S (ε t) (fun l _ => hε l)
    have hGtm : Measurable Gt := Finset.measurable_sum _ fun l _ => measurable_const.mul (hGm l)
    have hftM (i : Option (Fin d)) : Measurable (ft i) := by
      cases i with
      | none => exact hM
      | some i =>
        by_cases hi : i = b
        · subst i; simpa [ft] using hGtm
        · simpa [ft, Function.update_of_ne hi] using hfM i
    have hftP (i : Option (Fin d)) : MemLp (ft i) (ENNReal.ofReal (P i)) volume := by
      cases i with
      | none => exact hLp
      | some i =>
        by_cases hi : i = b
        · subst i; simpa [ft,P] using hGt.1
        · simpa [ft,P,Function.update_of_ne hi] using hfLp i
    have hc' (k : ℕ) : ‖z k*ε t k‖ ≤ 1 := by rw [norm_mul]; exact mul_le_one₀ (hz k) (norm_nonneg _) (hε k)
    have hD := (hDy b u T (fun k => z k*ε t k) hc' ft hftP).2 a scale hs
    rw [← translatedDyadicForm_eq_affine b a scale hs u T (fun k => z k*ε t k) ft hftM] at hD
    have he : (∑ k ∈ S, ∑ l ∈ S, (ε t k*ε t l)*A k l a) =
        ∑ k ∈ S, (z k*ε t k) * ∫ x, ∏ i, translatedDyadicSlot b a scale (u+k) ft i x := by
      apply Finset.sum_congr rfl
      intro k _
      have hE (x : Fin d → ℝ) :
          (∏ i, translatedDyadicSlot b a scale (u+k) ft i x) =
          ∑ l ∈ S, ε t l*(h x*∏ i, translatedProfileFactor b scale (u+k) (F l) i (a i) x) := by
        rw [Fintype.prod_option]
        have hnone : translatedDyadicSlot b a scale (u+k) ft none x = h x := rfl
        have hsome (i : Fin d) : translatedDyadicSlot b a scale (u+k) ft (some i) x =
            translatedProfileFactor b scale (u+k) (Function.update f b Gt) i (a i) x := by
          by_cases hi : i = b <;> simp [translatedDyadicSlot, translatedProfileFactor, ft,hi]
        simp_rw [hnone, hsome]
        change h x * (∏ i, translatedProfileFactor b scale (u+k) (Function.update f b Gt) i (a i) x) = _
        rw [translatedProfileFactor_replace_high b scale (u+k) S (ε t) G
          (fun l _ => hGf l) f a x, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro l _
        ring
      simp_rw [hE]
      rw [integral_finsetSum, Finset.mul_sum]
      · apply Finset.sum_congr rfl
        intro l _
        rw [integral_const_mul]
        dsimp only [A]
        ring
      · exact fun l _ => ((hAvg k l).1 a).const_mul (ε t l)
    rw [he]
    refine hD.trans ?_
    have hVQ : (profileSize v).toReal ≤ L*profileFourierFourNorm (𝓕 ψ) := by
      have h := ENNReal.toReal_mono ENNReal.ofReal_ne_top hVBound
      rwa [ENNReal.toReal_ofReal (mul_nonneg hL (profileFourierFourNorm_nonneg _))] at h
    rw [Fintype.prod_option, ← Finset.mul_prod_erase _ _ (Finset.mem_univ b)]
    have hRest : (∏ i ∈ (Finset.univ : Finset (Fin d)).erase b, lpNorm (ft (some i))
          (ENNReal.ofReal (P (some i))) volume) =
        ∏ i ∈ (Finset.univ : Finset (Fin d)).erase b, lpNorm (f i) (ENNReal.ofReal (p i)) volume := by
      apply Finset.prod_congr rfl
      intro i hi
      simp [ft,P,Function.update_of_ne (Finset.mem_erase.mp hi).1]
    rw [hRest]
    have hGNorm := hGt.2.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hVQ hB) lpNorm_nonneg)
    rw [show ft none = h from rfl, show P none = r.conjExponent from rfl,
      show ft (some b) = Gt by
        change Function.update f b Gt b = Gt
        exact Function.update_self b Gt f,
      show P (some b) = p b from rfl]
    change Cdy * (lpNorm h (ENNReal.ofReal r.conjExponent) volume *
      (lpNorm Gt (ENNReal.ofReal (p b)) volume *
        ∏ i ∈ (Finset.univ : Finset (Fin d)).erase b, lpNorm (f i) (ENNReal.ofReal (p i)) volume)) ≤ _
    calc
      _ ≤ Cdy * (lpNorm h (ENNReal.ofReal r.conjExponent) volume *
        ((B*(L*profileFourierFourNorm (𝓕 ψ))*lpNorm (f b) (ENNReal.ofReal (p b)) volume) *
          ∏ i ∈ (Finset.univ : Finset (Fin d)).erase b, lpNorm (f i) (ENNReal.ofReal (p i)) volume)) := by
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hGNorm
            (Finset.prod_nonneg fun _ _ => lpNorm_nonneg)) lpNorm_nonneg) hCdy
      _ = K₀ := by dsimp only [K₀]; rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ b)]; ring
  rw [← hTrace]
  have hh := norm_integral_le_of_norm_le_const (μ := μ) (Filter.Eventually.of_forall hPoint)
  simpa [measureReal_def] using hh

set_option maxHeartbeats 700000 in
private theorem separatedTent_norm_bound {d : ℕ} (hd : 2 ≤ d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {c C : ℝ} (hc : 0 < c) (hcC : c < C) (b : Fin d) :
    ∃ K : ℝ≥0∞, K ≠ ∞ ∧ ∀ (ψ : SchwartzMap ℝ ℂ),
      Function.support ((𝓕 ψ : SchwartzMap ℝ ℂ) : ℝ → ℂ) ⊆ {z | c ≤ |z| ∧ |z| ≤ C} →
      ∀ (u : ℤ) (T : ℕ) (z : ℕ → ℂ), (∀ k, ‖z k‖ ≤ 1) →
      ∀ (f : Fin d → (Fin d → ℝ) → ℂ), (∀ i, Measurable (f i)) →
      (∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume) →
      (∀ i x, Integrable (fun y => f i (Function.update x i y))) →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ x, ‖f b x‖ ≤ B) →
      eLpNorm (separatedProfileSum ((Finset.range T).image (fun k : ℕ => u+(k:ℤ)))
        (fun k => z (k-u).toNat) (fun i => if i = b then ψ else tentProfile) f)
        (ENNReal.ofReal r) volume ≤ K * ENNReal.ofReal (profileFourierFourNorm (𝓕 ψ)) *
          ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  obtain ⟨K, hK, hT⟩ := separatedTent_pairing hd hp hr hSum hc hcC b
  refine ⟨ENNReal.ofReal K, ENNReal.ofReal_ne_top, ?_⟩
  intro ψ hψ u T z hz f hfm hf hfi hfb
  let S := (Finset.range T).image (fun k : ℕ => u+(k:ℤ))
  let a (i : Fin d) : ℝ → ℂ := if i = b then ψ else tentProfile
  let F := separatedProfileSum S (fun k => z (k-u).toNat) a f
  have ha (i : Fin d) : Continuous (a i) := by dsimp only [a]; split; exact ψ.continuous; exact tentProfile_lipschitz.continuous
  have hai (i : Fin d) : Integrable (a i) := by
    dsimp only [a]
    split
    · exact ψ.integrable
    · exact profile_integrable tentProfile_lipschitz.continuous tentProfile_size_finite
  have hFp : MemLp F (ENNReal.ofReal r) volume :=
    separatedProfileSum_memLp hp hr hSum ha hai hf S (fun k => z (k-u).toNat)
  let B := K * profileFourierFourNorm (𝓕 ψ) * ∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume
  have hFour : 0 ≤ profileFourierFourNorm (𝓕 ψ) := profileFourierFourNorm_nonneg _
  have hProd : 0 ≤ ∏ i, lpNorm (f i) (ENNReal.ofReal (p i)) volume :=
    Finset.prod_nonneg fun _ _ => lpNorm_nonneg
  have hB : 0 ≤ B := mul_nonneg (mul_nonneg hK hFour) hProd
  have hbd : lpNorm F (ENNReal.ofReal r) volume ≤ B := by
    apply lpNorm_le_of_schwartz_pairing_bound hr hB hFp
    intro g
    let _ : ENNReal.HolderConjugate (ENNReal.ofReal r) (ENNReal.ofReal r.conjExponent) :=
      Auto.LpSpaceFacts.ofReal_holderConjugate r hr
    have hg := g.memLp (ENNReal.ofReal r.conjExponent) volume
    have he : (∫ x, F x*g x) = ∑ k ∈ Finset.range T, z k * ∫ x, g x *
        ∏ i, coordinateProfileConvolution i (profileDilation (a i) (u+k)) (f i) x := by
      unfold F separatedProfileSum S
      have hi : Function.Injective (fun k : ℕ => u+(k:ℤ)) := by
        intro j k h
        change u+(j:ℤ) = u+(k:ℤ) at h
        exact_mod_cast (add_left_cancel h)
      simp_rw [Finset.sum_image (fun i _ j _ e => hi e),
        show ∀ k : ℕ, (u+(k:ℤ)-u).toNat = k from fun k => by simp,
        Finset.sum_mul, mul_assoc]
      rw [integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro k _
        rw [integral_const_mul]
        apply congrArg (z k * ·)
        apply integral_congr_ae
        filter_upwards [] with x
        exact mul_comm _ _
      · intro k _
        have hI := (separatedProfileProduct_memLp hp hr hSum ha hai hf (u+k)).integrable_mul hg
        exact hI.const_mul (z k)
    rw [he]
    exact hT ψ hψ u T z hz f hfm hf hfi hfb g g.continuous.measurable hg
  have hOut := ENNReal.ofReal_le_ofReal hbd
  rw [ofReal_lpNorm hFp, ENNReal.ofReal_mul (mul_nonneg hK hFour),
    ENNReal.ofReal_mul hK, ENNReal.ofReal_prod_of_nonneg (fun _ _ => lpNorm_nonneg)] at hOut
  simpa only [ofReal_lpNorm (hf _)] using hOut

private theorem profileDilation_sub (a b : ℝ → ℂ) (k : ℤ) :
    profileDilation (a-b) k = profileDilation a k - profileDilation b k := by
  funext y
  simp only [profileDilation, Pi.sub_apply, mul_sub]

private theorem separatedProfileSum_replace_sub {d : ℕ} (S : Finset ℤ) (z : ℤ → ℂ)
    (a : Fin d → ℝ → ℂ) (f : Fin d → (Fin d → ℝ) → ℂ) (j : Fin d) {v : ℝ → ℂ}
    (ha : Integrable (a j)) (hv : Integrable v) (hf : Measurable (f j))
    {B : ℝ} (hB : 0 ≤ B) (hfB : ∀ x, ‖f j x‖ ≤ B) :
    separatedProfileSum S z a f - separatedProfileSum S z (Function.update a j v) f =
      separatedProfileSum S z (Function.update a j (a j-v)) f := by
  let V := (Finset.univ : Finset (Fin d)).erase j
  funext x
  simp only [separatedProfileSum, Pi.sub_apply, ← Finset.sum_sub_distrib, ← mul_sub]
  apply Finset.sum_congr rfl
  intro k _
  congr 1
  have he (P : ℝ → ℂ) :
      (∏ i, coordinateProfileConvolution i (profileDilation (Function.update a j P i) k) (f i) x) =
      coordinateProfileConvolution j (profileDilation P k) (f j) x *
        ∏ i ∈ V, coordinateProfileConvolution i (profileDilation (a i) k) (f i) x := by
    rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ j), Function.update_self]
    apply congrArg (coordinateProfileConvolution j (profileDilation P k) (f j) x * ·)
    apply Finset.prod_congr rfl
    intro i hi
    rw [Function.update_of_ne (Finset.mem_erase.mp hi).1]
  rw [he, he, ← Finset.mul_prod_erase _ _ (Finset.mem_univ j), ← sub_mul, profileDilation_sub,
    coordinateProfileConvolution_sub_kernel j (profileDilation_integrable ha k)
      (profileDilation_integrable hv k) hf hB hfB x]

private theorem separatedProfileSum_scale {d : ℕ} (S : Finset ℤ) (z : ℤ → ℂ)
    (a : Fin d → ℝ → ℂ) (f : Fin d → (Fin d → ℝ) → ℂ) (w : Fin d → ℂ) :
    separatedProfileSum S z (fun i y => w i*a i y) f = (∏ i, w i) • separatedProfileSum S z a f := by
  have he (i : Fin d) (k : ℤ) (x : Fin d → ℝ) :
      coordinateProfileConvolution i (profileDilation (fun y => w i*a i y) k) (f i) x =
      w i*coordinateProfileConvolution i (profileDilation (a i) k) (f i) x := by
    simp only [coordinateProfileConvolution, profileDilation]
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with y
    ring
  funext x
  simp only [separatedProfileSum, Pi.smul_apply, smul_eq_mul, he, Finset.prod_mul_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro _ _
  ring

private theorem profileSize_const_mul_le {a : ℝ → ℂ}
    (ha : ∀ l r, AbsolutelyContinuousOnInterval a l r) (hA : profileSize a ≠ ∞) (c : ℂ) :
    profileSize (fun y => c*a y) ≤ ‖c‖ₑ*profileSize a := by
  have h₀ : profileSize (fun _ => (0:ℂ)) = 0 := by
    simp [profileSize, deriv_const]
  have hAC (l r : ℝ) : AbsolutelyContinuousOnInterval (fun _ : ℝ => (0:ℂ)) l r := by
    have hL : LipschitzWith 0 (fun _ : ℝ => (0:ℂ)) := LipschitzWith.const _
    exact hL.lipschitzOnWith.absolutelyContinuousOnInterval
  have h := profileSize_sub_const_mul (a := fun _ => (0:ℂ)) (b := a)
    hAC ha (h₀.symm ▸ ENNReal.zero_ne_top) hA (-c)
  simpa only [h₀, zero_add, neg_mul, zero_sub, neg_neg, enorm_neg] using h

private theorem tentProfile_locallyAbsolutelyContinuous (l r : ℝ) :
    AbsolutelyContinuousOnInterval tentProfile l r :=
  tentProfile_lipschitz.lipschitzOnWith.absolutelyContinuousOnInterval

