private theorem scalarCz_lower_all {K f : ℝ → ℂ}
    (hK : Integrable K) (hKm : Measurable K) (hReg : scalarKernelRegular K 1)
    (hFourier : ∀ ξ, ‖𝓕 K ξ‖ ≤ 1) (hm : Measurable f) {p : ℝ} (hp : 1 < p) (hp₂ : p ≤ 2)
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    let C := if p = 2 then (1:ℝ≥0∞) else (scalarCzLowerMomentConstant p)^p⁻¹
    eLpNorm (lineProfileConvolution K f) (ENNReal.ofReal p) volume ≤
      C * eLpNorm f (ENNReal.ofReal p) volume := by
  let C : ℝ≥0∞ := if p = 2 then 1 else (scalarCzLowerMomentConstant p)^p⁻¹
  let A (n : ℕ) := Icc (-(n:ℝ)) (n:ℝ)
  let F (n : ℕ) := (A n).indicator f
  let T := lineProfileConvolution K
  have hM (n : ℕ) : Measurable (F n) := hm.indicator measurableSet_Icc
  have hLp (n : ℕ) : MemLp (F n) (ENNReal.ofReal p) volume :=
    hf.indicator measurableSet_Icc
  have hI (n : ℕ) : Integrable (F n) := by
    rw [show F n = (A n).indicator f from rfl, integrable_indicator_iff measurableSet_Icc]
    let : IsFiniteMeasure (volume.restrict (A n)) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact measure_Icc_lt_top⟩
    exact (hf.restrict (A n)).integrable (by simpa using ENNReal.ofReal_le_ofReal hp.le)
  have hNorm (n : ℕ) : eLpNorm (F n) (ENNReal.ofReal p) volume ≤ eLpNorm f (ENNReal.ofReal p) volume := by
    apply eLpNorm_mono_ae (hM n).aestronglyMeasurable
    exact Filter.Eventually.of_forall fun x => norm_indicator_le_norm_self _ _
  change eLpNorm (T f) (ENNReal.ofReal p) volume ≤ C * _
  apply Lp.eLpNorm_le_of_ae_tendsto (u := (atTop : Filter ℕ)) (f := fun n => T (F n))
    ?_ (fun n => (lineProfileConvolution_measurable hKm (hM n)).aestronglyMeasurable)
    (lineProfileConvolution_measurable hKm hm).aestronglyMeasurable
    (lineProfileConvolution_truncation_tendsto hKm hK hm hp hf)
  filter_upwards [] with n
  rcases hp₂.eq_or_lt with he | hlt
  · subst p
    have hh := (lineProfileConvolution_L2 hK hKm zero_le_one hFourier (hI n) (hM n)
      (by simpa only [ENNReal.ofReal_ofNat] using hLp n)).2
    simp only [C, ite_true, ENNReal.ofReal_one, ENNReal.ofReal_ofNat, one_mul] at hh ⊢
    exact hh.trans (by simpa only [ENNReal.ofReal_ofNat] using hNorm n)
  · have hh := scalarCz_lower hK hKm hReg hFourier (hI n) (hM n) hp hlt (hLp n)
    rw [show C = (scalarCzLowerMomentConstant p)^p⁻¹ by simp [C,hlt.ne]]
    exact hh.trans (mul_le_mul_right (hNorm n) _)

