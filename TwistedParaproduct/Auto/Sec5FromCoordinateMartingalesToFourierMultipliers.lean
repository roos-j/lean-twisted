private theorem finiteHomogeneousAnnular_apply_tendsto {d : ℕ} (hd : 0 < d)
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    (hΩ : (∫ ω, Ω ω ∂(volume : Measure (E d)).toSphere) = 0)
    {L : SchwartzMap (E d) ℂ}
    (hL : ∀ y, L y = homogeneousKernel Ω y*dyadicAnnularCutoff y) (hL0 : (∫ y, L y) = 0)
    {m : E d → ℂ} (hm : ∀ ξ, m ξ = ∑' k : ℤ, (𝓕 L) (((2:ℝ)^k) • ξ))
    (f : Fin d → SchwartzMap (E d) ℂ) (x : E d)
    (hI : Integrable (compensatedPrincipalValue (homogeneousKernel Ω) (physicalSchwartzProduct f x))) :
    (∫ y, compensatedPrincipalValue (homogeneousKernel Ω) (physicalSchwartzProduct f x) y) =
      twisted m f x := by
  let G : SchwartzMap (E d) ℂ := 𝓕 L
  have hG : G 0 = 0 := by
    change (𝓕 L) 0 = 0
    rw [SchwartzMap.fourier_coe, Real.fourier_eq']
    simp [hL0]
  obtain ⟨B,hB,_,hGNorm,_⟩ := schwartzDyadic_mikhlin G hG
  let S (n : ℕ) := (Finset.range (2*n+1)).image (fun k : ℕ => -(n:ℤ)+(k:ℤ))
  let P (n : ℕ) (y : E d) := ∑ k ∈ S n, homogeneousAnnularPiece Ω k y
  let T (n : ℕ) (ξ : E d) := ∑ k ∈ S n, G (((2:ℝ)^k) • ξ)
  let g := physicalSchwartzProduct f x
  have hg : Continuous g := (physicalSchwartzProduct_continuous f).comp (continuous_const.prodMk continuous_id)
  have hgB (y : E d) : ‖g y‖ ≤ ∏ i, SchwartzMap.seminorm ℝ 0 0 (f i) := by
    simp only [g,physicalSchwartzProduct,norm_prod]
    exact Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) (fun i _ => SchwartzMap.norm_le_seminorm ℝ (f i) _)
  have hP (n : ℕ) : Integrable (P n) :=
    integrable_finsetSum _ fun k _ => by
      rw [homogeneousAnnularPiece_eq hL]
      exact kernelMollifier_integrable _ (by positivity)
  have hPm (n : ℕ) : Measurable (P n) :=
    Finset.measurable_sum _ fun k _ => by
      rw [homogeneousAnnularPiece_eq hL]
      exact measurable_const.mul (L.continuous.measurable.comp
        ((((2:ℝ)^k)⁻¹ • ContinuousLinearMap.id ℝ (E d)).continuous.measurable))
  have hT (n : ℕ) (ξ : E d) : ‖T n ξ‖ ≤ B 0 :=
    (norm_sum_le _ _).trans (((hGNorm ξ).1.sum_le_tsum _ (fun _ _ => norm_nonneg _)).trans (hGNorm ξ).2)
  have hTc (n : ℕ) : Continuous (T n) :=
    continuous_finsetSum _ fun k _ => G.continuous.comp
      (((2:ℝ)^k • ContinuousLinearMap.id ℝ (E d)).continuous)
  have hlim (ξ : E d) : Tendsto (fun n => T n ξ) atTop (𝓝 (m ξ)) := by
    rw [hm]
    exact ((hGNorm ξ).1.of_norm.hasSum).comp dyadicWindow_exhaustion
  have hPcut (n : ℕ) : ∃ w : ℝ → ℂ, (∀ y : E d, w ‖y‖ = (symmetricPhysicalCutoff n y:ℂ)) :=
    ⟨fun t => ↑(∑ k ∈ S n, (Real.smoothTransition ((4-(((2:ℝ)^(-k))*t)^2)/3) -
      Real.smoothTransition ((4-(2*(((2:ℝ)^(-k))*t))^2)/3))), fun y => by
        simp only [symmetricPhysicalCutoff,S,dyadicAnnularCutoff_radial,norm_dyadicFrequencyDilate]⟩
  have hEq (n : ℕ) :
      (∫ y, (symmetricPhysicalCutoff n y:ℂ)*compensatedPrincipalValue (homogeneousKernel Ω) g y) =
        twisted (T n) f x := by
    obtain ⟨w,hw⟩ := hPcut n
    have hPw : P n = fun y => homogeneousKernel Ω y * w ‖y‖ := by
      funext y
      rw [hw]
      simp only [P,homogeneousAnnularPiece,symmetricPhysicalCutoff,S,Complex.ofReal_sum,Finset.mul_sum]
    have he := radialCutoff_compensation Ω hΩ g w hg.measurable hgB (hPw ▸ hP n)
    have hF := physicalIntegrable_fourier (hP n) (hPm n) f x
    rw [finiteHomogeneousAnnular_fourier Ω hL (S n)] at hF
    change physicalKernelApply (P n) (fun i => f i) x = twisted (T n) f x at hF
    rw [← hF, hPw]
    simp_rw [← hw]
    exact he.symm
  have hRight : Tendsto (fun n => twisted (T n) f x) atTop (𝓝 (twisted m f x)) := by
    apply tendsto_integral_of_dominated_convergence (fun ξ => B 0 * ∏ i, ‖(𝓕 (f i)) (ξ i)‖)
      (fun n => (fourierIntegrand_measurable (hTc n).measurable f x).aestronglyMeasurable)
      (integrable_fourierMajorant f _)
    · exact fun n => Filter.Eventually.of_forall fun ξ => norm_fourierIntegrand_le f x ξ (hT n _)
    · filter_upwards [] with ξ
      simpa only [fourierIntegrand] using
        ((hlim (diagonalFrequency ξ)).mul_const (∏ i, (𝓕 (f i)) (ξ i))).mul_const
          (Complex.exp (Complex.I*Complex.ofReal (2*Real.pi*inner ℝ x (∑ i, ξ i))))
  exact tendsto_nhds_unique (finiteAnnular_compensated_tendsto hd hI)
    (hRight.congr' (Filter.Eventually.of_forall fun n => (hEq n).symm))

private theorem hardEndpointFilter_good :
    ∀ᶠ a in hardEndpointFilter, 0 < a.1 ∧ a.1 < 1 ∧ 1 < a.2 := by
  have hε : Tendsto (fun a : ℝ × ℝ => a.1) hardEndpointFilter (𝓝[>] (0:ℝ)) := tendsto_fst
  have hR : Tendsto (fun a : ℝ × ℝ => a.2) hardEndpointFilter atTop := tendsto_snd
  exact (hε.eventually (self_mem_nhdsWithin : Ioi (0:ℝ) ∈ 𝓝[>] (0:ℝ))).and
    ((hε.eventually ((eventually_lt_nhds (by norm_num : (0:ℝ) < 1)).filter_mono nhdsWithin_le_nhds)).and
      (hR.eventually (eventually_gt_atTop 1)))

private theorem hardEndpointFilter_eventually_mem {d : ℕ} {y : E d} (hy : y ≠ 0) :
    ∀ᶠ a in hardEndpointFilter, a.1 < ‖y‖ ∧ ‖y‖ < a.2 := by
  have hε : Tendsto (fun a : ℝ × ℝ => a.1) hardEndpointFilter (𝓝[>] (0:ℝ)) := tendsto_fst
  have hR : Tendsto (fun a : ℝ × ℝ => a.2) hardEndpointFilter atTop := tendsto_snd
  exact (hε.eventually ((eventually_lt_nhds (norm_pos_iff.mpr hy)).filter_mono nhdsWithin_le_nhds)).and
    (hR.eventually (eventually_gt_atTop ‖y‖))

private theorem hardAnnulus_compensation {d : ℕ}
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    (hΩ : (∫ ω, Ω ω ∂(volume : Measure (E d)).toSphere) = 0)
    (f : Fin d → SchwartzMap (E d) ℂ) (x : E d) (a : ℝ × ℝ)
    (hL : Integrable (hardAnnulus (homogeneousKernel Ω) a.1 a.2)) :
    physicalKernelApply (hardAnnulus (homogeneousKernel Ω) a.1 a.2) (fun i => f i) x =
      ∫ y, {y : E d | a.1 < ‖y‖ ∧ ‖y‖ < a.2}.indicator
        (compensatedPrincipalValue (homogeneousKernel Ω) (physicalSchwartzProduct f x)) y := by
  let g := physicalSchwartzProduct f x
  let w (t : ℝ) := (Ioo a.1 a.2).indicator (fun _ => (1:ℂ)) t
  have hg : Continuous g := (physicalSchwartzProduct_continuous f).comp (continuous_const.prodMk continuous_id)
  have hgB (y : E d) : ‖g y‖ ≤ ∏ i, SchwartzMap.seminorm ℝ 0 0 (f i) := by
    simp only [g,physicalSchwartzProduct,norm_prod]
    exact Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) (fun i _ => SchwartzMap.norm_le_seminorm ℝ (f i) _)
  have hK (y : E d) : hardAnnulus (homogeneousKernel Ω) a.1 a.2 y =
      homogeneousKernel Ω y * w ‖y‖ := by
    unfold hardAnnulus w
    simp only [Set.indicator, Set.mem_setOf_eq, Set.mem_Ioo]
    split_ifs <;> simp
  have hI : Integrable (fun y => homogeneousKernel Ω y*w ‖y‖) :=
    hL.congr (Filter.Eventually.of_forall hK)
  unfold physicalKernelApply
  simp_rw [hK]
  change (∫ y, homogeneousKernel Ω y*w ‖y‖*g y) = _
  rw [radialCutoff_compensation Ω hΩ g w hg.measurable hgB hI]
  apply integral_congr_ae
  filter_upwards [] with y
  unfold w
  simp only [Set.indicator, Set.mem_setOf_eq, Set.mem_Ioo]
  split_ifs <;> simp [g]

private theorem physicalKernelApply_aestronglyMeasurable {d : ℕ} {L : E d → ℂ}
    (hL : Measurable L) (f : Fin d → SchwartzMap (E d) ℂ) :
    AEStronglyMeasurable (physicalKernelApply L (fun i => f i)) volume :=
  ((hL.comp measurable_snd).stronglyMeasurable.mul
    (physicalSchwartzProduct_continuous f).stronglyMeasurable).integral_prod_right.aestronglyMeasurable

set_option maxHeartbeats 1400000 in
/-- The hard spherical principal value equals the Fourier multiplier on Schwartz inputs,
and the hard annuli converge in the Banach output norm. -/
theorem hardHomogeneous {d : ℕ} (hd : 2 ≤ d)
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    (hK : ContDiffOn ℝ (↑(⊤ : ℕ∞)) (homogeneousKernel Ω) {y | y ≠ 0})
    (hΩ : (∫ ω, Ω ω ∂(volume : Measure (E d)).toSphere) = 0)
    {p : Fin d → ℝ} {r : ℝ} (hp : ∀ i, 1 < p i) (hr : 1 < r)
    (hs : r⁻¹ = ∑ i, (p i)⁻¹) :
    ∃ (m : E d → ℂ) (C : ℝ), 0 ≤ C ∧
      (∀ g : SchwartzMap (E d) ℂ,
        (∫ y, compensatedPrincipalValue (homogeneousKernel Ω) g y) = ∫ ξ, m ξ*(𝓕⁻ g) ξ) ∧
      ∀ f : Fin d → SchwartzMap (E d) ℂ,
        (∀ x, (∫ y, compensatedPrincipalValue (homogeneousKernel Ω) (physicalSchwartzProduct f x) y) =
          twisted m f x) ∧
        (∀ x, Tendsto (fun a : ℝ × ℝ =>
          physicalKernelApply (hardAnnulus (homogeneousKernel Ω) a.1 a.2) (fun i => f i) x)
          hardEndpointFilter (𝓝 (twisted m f x))) ∧
        Tendsto (fun a : ℝ × ℝ =>
          eLpNorm (physicalKernelApply (hardAnnulus (homogeneousKernel Ω) a.1 a.2) (fun i => f i) -
            twisted m f) (ENNReal.ofReal r) volume) hardEndpointFilter (𝓝 0) ∧
        eLpNorm (twisted m f) (ENNReal.ofReal r) volume ≤
          ENNReal.ofReal C * ∏ i, eLpNorm (f i : E d → ℂ) (ENNReal.ofReal (p i)) volume := by
  obtain ⟨L,m,A,hL,hL0,hm,hA,hPair⟩ := homogeneousSymbol hd Ω hK hΩ
  obtain ⟨C,hC,hFull⟩ := fullMultiplier hd hp hr hs
  let N := 5*d+2
  refine ⟨m,C*A N,mul_nonneg hC.le (hA N).1,fun g => (hPair g).2,?_⟩
  intro f
  have hd₀ : 0 < d := by omega
  have hr₀ : 0 < r := zero_lt_one.trans hr
  letI : Nonempty (Fin d) := ⟨⟨0,hd₀⟩⟩
  letI : hardEndpointFilter.IsCountablyGenerated := by
    unfold hardEndpointFilter
    infer_instance
  let K := homogeneousKernel Ω
  let U (a : ℝ × ℝ) := physicalKernelApply (hardAnnulus K a.1 a.2) (fun i => f i)
  let T := twisted m f
  let q := ENNReal.ofReal r
  let G (x : E d) := physicalSchwartzProduct f x
  let V (x y : E d) := compensatedPrincipalValue K (G x) y
  let X (x : E d) := ((1+‖x‖)^(d+1))⁻¹
  let W (y : E d) := principalValueWeight d ‖y‖
  let S (a : ℝ × ℝ) := {y : E d | a.1 < ‖y‖ ∧ ‖y‖ < a.2}
  have hW : Integrable W := principalValueWeight_integrable hd
  have hW₀ (y : E d) : 0 ≤ W y := by dsimp [W,principalValueWeight]; split_ifs <;> positivity
  have hX : Integrable X := kernelDecay_integrable d
  have hX₀ (x : E d) : 0 ≤ X x := by dsimp [X]; positivity
  have hX₁ (x : E d) : X x ≤ 1 := inv_le_one_of_one_le₀
    (one_le_pow₀ (le_add_of_nonneg_right (norm_nonneg x)) (n := d+1))
  obtain ⟨B,hB,hKb⟩ := homogeneousKernel_size hK.continuousOn
  obtain ⟨D,hD,hGb⟩ := physicalSchwartzProduct_decay hd f (d+1)
  have hV (x y : E d) : ‖V x y‖ ≤ B*D*X x*W y := by
    have hb := hGb x y
    have h1 (z : E d) (hz : ‖z‖ ≤ 1) : ‖G x z-G x 0‖ ≤ D*X x*‖z‖ := (hGb x z).1 hz
    have h2 (z : E d) (hz : 1 < ‖z‖) : ‖G x z‖ ≤ D*X x*‖z‖⁻¹ := (hGb x z).2 hz
    exact (compensatedPrincipalValue_bound hd (by simp [K,homogeneousKernel]) hB
      (mul_nonneg hD (hX₀ x)) hKb h1 h2 y).trans_eq (by ring)
  have hKm : Measurable K := measurable_of_continuousOn_compl_singleton 0 hK.continuousOn
  have hS (a : ℝ × ℝ) : MeasurableSet (S a) :=
    (measurableSet_lt measurable_const continuous_norm.measurable).inter
      (measurableSet_lt continuous_norm.measurable measurable_const)
  have hVm (x : E d) : Measurable (V x) := by
    exact hKm.mul (((physicalSchwartzProduct_continuous f).comp
        (continuous_const.prodMk continuous_id)).measurable.sub
      (measurable_const.indicator (measurableSet_le continuous_norm.measurable measurable_const)))
  have hVi (x : E d) : Integrable (V x) :=
    (hW.const_mul (B*D*X x)).mono' (hVm x).aestronglyMeasurable
      (Filter.Eventually.of_forall (hV x))
  have hPoint (x : E d) : (∫ y, V x y) = T x :=
    finiteHomogeneousAnnular_apply_tendsto hd₀ Ω hΩ hL hL0 hm f x (hVi x)
  have hLi (a : ℝ × ℝ) (ha : 0 < a.1 ∧ a.1 < 1 ∧ 1 < a.2) :
      Integrable (hardAnnulus K a.1 a.2) := hardAnnulus_integrable hKm ha.1
        (ha.2.1.trans ha.2.2) hB (fun y _ => hKb y)
  have hEq : ∀ᶠ a in hardEndpointFilter, ∀ x, U a x = ∫ y, (S a).indicator (V x) y :=
    hardEndpointFilter_good.mono fun a ha x => hardAnnulus_compensation Ω hΩ f x a (hLi a ha)
  have hPointwise (x : E d) : Tendsto (fun a => U a x) hardEndpointFilter (𝓝 (T x)) := by
    rw [← hPoint x]
    have hD (a : ℝ × ℝ) (y : E d) : ‖(S a).indicator (V x) y‖ ≤ ‖V x y‖ := by
      by_cases hy : y ∈ S a <;> simp [hy]
    have hL : ∀ᵐ y ∂(volume : Measure (E d)), Tendsto (fun a => (S a).indicator (V x) y)
        hardEndpointFilter (𝓝 (V x y)) := by
      filter_upwards [ae_ne (volume : Measure (E d)) 0] with y hy
      exact tendsto_const_nhds.congr' ((hardEndpointFilter_eventually_mem hy).mono
        fun a h => (Set.indicator_of_mem (show y ∈ S a from h) (V x)).symm)
    exact (tendsto_integral_filter_of_dominated_convergence (fun y => ‖V x y‖)
      (Filter.Eventually.of_forall fun a => ((hVm x).indicator (hS a)).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun a => Filter.Eventually.of_forall (hD a)) (hVi x).norm
      hL).congr' (hEq.mono fun a ha => (ha x).symm)
  have hFull' : eLpNorm T q volume ≤ ENNReal.ofReal (C*A N) *
      ∏ i, eLpNorm (f i : E d → ℂ) (ENNReal.ofReal (p i)) volume :=
    hFull m (A N) (hA N).1 (hA N).2 f
  have hBm (a : ℝ × ℝ) : AEStronglyMeasurable (U a) volume :=
    physicalKernelApply_aestronglyMeasurable (hKm.indicator (hS a)) f
  have hTm : AEStronglyMeasurable T volume := by
    have hm' := (hA N).2
    exact (schwartzFourier_convergence hd₀ hm'.1.continuousOn
      (fun x hx => by simpa using hm'.2 0 (by omega) x hx) f).2.aestronglyMeasurable
  have hBnorm :
      ∀ᶠ a in hardEndpointFilter, ∀ x, ‖U a x - T x‖ ≤ (2*B*D*(∫ y, W y))*X x := by
    filter_upwards [hEq] with a ha x
    rw [ha x, ← hPoint x]
    refine (norm_sub_le _ _).trans ?_
    have hI : Integrable (fun y => B*D*X x*W y) := hW.const_mul _
    have hm : ∀ y, ‖(S a).indicator (V x) y‖ ≤ B*D*X x*W y := by
      intro y
      by_cases hy : y ∈ S a
      · simpa [hy] using hV x y
      · simp only [Set.indicator_of_notMem hy,norm_zero]
        exact mul_nonneg (mul_nonneg (mul_nonneg hB hD) (hX₀ x)) (hW₀ y)
    refine (add_le_add ((norm_integral_le_integral_norm _).trans
      (integral_mono ((hVi x).indicator (hS a)).norm hI hm))
      ((norm_integral_le_integral_norm _).trans (integral_mono (hVi x).norm hI (hV x)))).trans_eq ?_
    rw [integral_const_mul]
    ring
  let P := 2*B*D*(∫ y, W y)
  have hP : 0 ≤ P := mul_nonneg (by positivity) (integral_nonneg hW₀)
  have hPow (a : ℝ × ℝ) (ha : ∀ x, ‖U a x-T x‖ ≤ P*X x) (x : E d) :
      ‖U a x-T x‖^r ≤ P^r*X x := by
    refine (Real.rpow_le_rpow (norm_nonneg _) (ha x) hr₀.le).trans ?_
    rw [Real.mul_rpow hP (hX₀ x)]
    exact mul_le_mul_of_nonneg_left (Real.rpow_le_self_of_le_one (hX₀ x) (hX₁ x) hr.le)
      (Real.rpow_nonneg hP _)
  have hInt : Tendsto (fun a => ∫ x, ‖U a x-T x‖^r) hardEndpointFilter (𝓝 0) := by
    simpa only [integral_zero,Pi.sub_apply] using (tendsto_integral_filter_of_dominated_convergence
      (f := fun _ : E d => (0:ℝ)) (fun x => P^r*X x)
      (Filter.Eventually.of_forall fun a => (hBm a |>.sub hTm).norm.aemeasurable.pow_const r |>.aestronglyMeasurable)
      (hBnorm.mono fun a ha => Filter.Eventually.of_forall fun x => by
        rw [Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
        exact hPow a ha x)
      (hX.const_mul (P^r))
      (Filter.Eventually.of_forall fun x => by
        have h := ((hPointwise x).sub (tendsto_const_nhds (x := T x))).norm.rpow_const (p := r)
          (Or.inr hr₀.le)
        simpa only [Pi.sub_apply,sub_self,norm_zero,Real.zero_rpow hr₀.ne'] using h))
  have hE : ∀ᶠ a in hardEndpointFilter, eLpNorm (U a-T) q volume =
      ENNReal.ofReal ((∫ x, ‖U a x-T x‖^r)^r⁻¹) := by
    filter_upwards [hBnorm] with a ha
    have hI : Integrable (fun x => ‖U a x-T x‖^r) :=
      (hX.const_mul (P^r)).mono' (((hBm a).sub hTm).norm.aemeasurable.pow_const r).aestronglyMeasurable
        (Filter.Eventually.of_forall fun x => by
          rw [Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
          exact hPow a ha x)
    have hq₀ : q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hr₀
    have hqT : q ≠ ∞ := ENNReal.ofReal_ne_top
    have hNorm : (∫⁻ x, ‖(U a-T) x‖ₑ^r) =
        ENNReal.ofReal (∫ x, ‖U a x-T x‖^r) := by
      rw [ofReal_integral_eq_lintegral_ofReal hI (Filter.Eventually.of_forall fun x => Real.rpow_nonneg (norm_nonneg _) _)]
      apply lintegral_congr
      intro x
      rw [← ofReal_norm, ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hr₀.le]
      rfl
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hq₀ hqT ((hBm a).sub hTm),
      show q.toReal = r from ENNReal.toReal_ofReal hr₀.le, hNorm,one_div]
    rw [ENNReal.ofReal_rpow_of_nonneg (integral_nonneg fun _ => Real.rpow_nonneg (norm_nonneg _) _) (inv_nonneg.mpr hr₀.le)]
  have hFinal : Tendsto (fun a => eLpNorm (U a-T) q volume) hardEndpointFilter (𝓝 0) := by
    have h := ENNReal.tendsto_ofReal (hInt.rpow_const (p := r⁻¹) (Or.inr (inv_nonneg.mpr hr₀.le)))
    simpa only [Real.zero_rpow (inv_ne_zero hr₀.ne'), ENNReal.ofReal_zero] using h.congr' (hE.mono fun _ ha => ha.symm)
  exact ⟨hPoint,hPointwise,hFinal,hFull'⟩

private theorem coordinateFiber_memLp_ae {d : ℕ} (i : Fin d) {p : ℝ} (hp : 0 < p)
    {f : (Fin d → ℝ) → ℂ} (hm : Measurable f) (hf : MemLp f (ENNReal.ofReal p) volume) :
    ∀ᵐ x ∂volume, MemLp (fun t => f (Function.update x i t)) (ENNReal.ofReal p) volume := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n+1) => ℝ) i).symm
    have he : MeasurePreserving e :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n+1) => ℝ) i).symm _
    let g := f ∘ e
    let q := ENNReal.ofReal p
    have hq₀ : q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp
    have hqT : q ≠ ∞ := ENNReal.ofReal_ne_top
    have hg : MemLp g q volume := hf.comp_measurePreserving he
    have hgm : Measurable g := hm.comp e.measurable
    have hI := lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top hq₀ hqT hg.eLpNorm_lt_top
    rw [show q.toReal = p from ENNReal.toReal_ofReal hp.le, Measure.volume_eq_prod,
      lintegral_prod_symm' _ (hgm.enorm.pow_const p)] at hI
    have hP : ∀ᵐ z ∂(volume : Measure (ℝ × (Fin n → ℝ))),
        MemLp (fun t => f (Function.update (e z) i t)) q volume := by
      rw [Measure.volume_eq_prod]
      have hA := ae_lt_top (hgm.enorm.pow_const p).lintegral_prod_left' hI.ne
      filter_upwards [(Measure.quasiMeasurePreserving_snd (μ := (volume : Measure ℝ))
        (ν := (volume : Measure (Fin n → ℝ)))).ae hA] with z hz
      rcases z with ⟨x,y⟩
      have hsm : Measurable (fun t : ℝ => g (t,y)) := hgm.comp (measurable_id.prodMk measurable_const)
      have hLp : MemLp (fun t : ℝ => g (t,y)) q volume := by
        rw [memLp_iff, eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top hq₀ hqT hsm.aestronglyMeasurable,
          show q.toReal = p from ENNReal.toReal_ofReal hp.le]
        exact hz
      change MemLp (fun t => f (i.insertNth t y)) q volume at hLp
      change MemLp (fun t => f (Function.update (i.insertNth x y) i t)) q volume
      simpa only [Fin.update_insertNth,Fin.insertNth_apply_same] using hLp
    filter_upwards [(he.symm e).quasiMeasurePreserving.ae hP] with x hx
    simpa only [MeasurableEquiv.apply_symm_apply] using hx

private theorem profileDilation_memLp (a : SchwartzMap ℝ ℂ) (k : ℤ) (p : ℝ≥0∞) :
    MemLp (profileDilation a k) p volume := by
  let s : ℝ := (2:ℝ)^k
  have hs : s ≠ 0 := by dsimp only [s]; positivity
  let e := (LinearEquiv.smulOfNeZero ℝ ℝ s hs).toContinuousLinearEquiv
  let A := SchwartzMap.compCLMOfContinuousLinearEquiv ℝ e a
  have hA : MemLp (A : ℝ → ℂ) p volume := A.memLp p volume
  have he : profileDilation a k = fun y => (s:ℂ)*A y := by
    funext y
    rfl
  rw [he]
  exact hA.const_mul _

private theorem coordinateProfile_integrable_ae {d : ℕ} (i : Fin d) {p : ℝ} (hp : 1 < p)
    {f : (Fin d → ℝ) → ℂ} (hm : Measurable f) (hf : MemLp f (ENNReal.ofReal p) volume)
    (a : SchwartzMap ℝ ℂ) (k : ℤ) :
    ∀ᵐ x ∂volume, Integrable (fun y => profileDilation a k y * f (Function.update x i (x i-y))) := by
  filter_upwards [coordinateFiber_memLp_ae i (zero_lt_one.trans hp) hm hf] with x hx
  have h := hx.comp_measurePreserving ((volume : Measure ℝ).measurePreserving_sub_left (x i))
  letI : ENNReal.HolderConjugate (ENNReal.ofReal p.conjExponent) (ENNReal.ofReal p) :=
    (Auto.LpSpaceFacts.ofReal_holderConjugate p hp).symm
  exact memLp_one_iff_integrable.mp ((profileDilation_memLp a k (ENNReal.ofReal p.conjExponent)).fun_mul h)

/-- The separated-profile estimate for arbitrary (L^p) inputs. -/
theorem separatedConeLp {d : ℕ} (hd : 2 ≤ d) {p : Fin d → ℝ} {r : ℝ}
    (hp : ∀ i, 1 < p i) (hr : 1 < r) (hSum : r⁻¹ = ∑ i, (p i)⁻¹)
    {c C : ℝ} (hc : 0 < c) (hcC : c < C) :
    ∃ K : ℝ≥0∞, K ≠ ∞ ∧ ∀ (b : Fin d) (a : Fin d → SchwartzMap ℝ ℂ),
      Function.support ((𝓕 (a b) : SchwartzMap ℝ ℂ) : ℝ → ℂ) ⊆ {z | c ≤ |z| ∧ |z| ≤ C} →
      ∀ (u : ℤ) (T : ℕ) (z : ℕ → ℂ), (∀ k, ‖z k‖ ≤ 1) →
      ∀ (f : Fin d → (Fin d → ℝ) → ℂ), (∀ i, MemLp (f i) (ENNReal.ofReal (p i)) volume) →
      eLpNorm (separatedProfileSum ((Finset.range T).image (fun k : ℕ => u+(k:ℤ)))
        (fun k => z (k-u).toNat) (fun i => a i) f) (ENNReal.ofReal r) volume ≤
      K * (∏ i, if i = b then profileSize (a i) + ENNReal.ofReal (profileFourierFourNorm (𝓕 (a i)))
        else profileSize (a i)) * ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  choose K hK h using fun b => separatedCone_bounded hd hp hr hSum hc hcC b
  refine ⟨∑ b, K b, ENNReal.sum_ne_top.mpr (fun b _ => hK b), ?_⟩
  intro b a ha u T z hz f hf
  let g (i : Fin d) := (hf i).aestronglyMeasurable.mk (f i)
  have hfg (i : Fin d) : f i =ᵐ[volume] g i := (hf i).aestronglyMeasurable.ae_eq_mk
  have hgm (i : Fin d) : Measurable (g i) := (hf i).aestronglyMeasurable.stronglyMeasurable_mk.measurable
  have hg (i : Fin d) : MemLp (g i) (ENNReal.ofReal (p i)) volume := (hf i).ae_eq (hfg i)
  let S := (Finset.range T).image (fun k : ℕ => u+(k:ℤ))
  let F (g : Fin d → (Fin d → ℝ) → ℂ) := separatedProfileSum S (fun k => z (k-u).toNat) (fun i => a i) g
  have hFG : F f =ᵐ[volume] F g := by
    have hh : ∀ᵐ x ∂(volume : Measure (Fin d → ℝ)), ∀ i : Fin d × ℤ,
        coordinateProfileConvolution i.1 (profileDilation (a i.1) i.2) (f i.1) x =
          coordinateProfileConvolution i.1 (profileDilation (a i.1) i.2) (g i.1) x := by
      apply ae_all_iff.mpr
      intro j
      exact coordinateProfileConvolution_congr_ae j.1 _ (hfg j.1)
    filter_upwards [hh] with x hx
    unfold F separatedProfileSum
    apply Finset.sum_congr rfl
    intro k _
    congr 1
    apply Finset.prod_congr rfl
    intro i _
    exact hx (i,k)
  rw [show separatedProfileSum S (fun k => z (k-u).toNat) (fun i => a i) f = F f by rfl,
    eLpNorm_congr_ae hFG]
  simp_rw [fun i => eLpNorm_congr_ae (p := ENNReal.ofReal (p i)) (hfg i)]
  let U (n : ℕ) (i : Fin d) := {x : Fin d → ℝ | |x i| ≤ n ∧ ‖g i x‖ ≤ n}
  let gₙ (n : ℕ) (i : Fin d) := (U n i).indicator (g i)
  have hU (n : ℕ) (i : Fin d) : MeasurableSet (U n i) :=
    (measurableSet_le (continuous_abs.measurable.comp (measurable_pi_apply i)) measurable_const).inter
      (measurableSet_le (hgm i).norm measurable_const)
  have hgₙm (n : ℕ) (i : Fin d) : Measurable (gₙ n i) := (hgm i).indicator (hU n i)
  have hgₙb (n : ℕ) (i : Fin d) (x : Fin d → ℝ) :
      ‖gₙ n i x‖ ≤ ‖g i x‖ ∧ ‖gₙ n i x‖ ≤ n := by
    by_cases hx : x ∈ U n i
    · rw [show gₙ n i x = g i x from Set.indicator_of_mem hx _]
      exact ⟨le_rfl,hx.2⟩
    · simp only [gₙ,Set.indicator_of_notMem hx,norm_zero]
      exact ⟨norm_nonneg _,Nat.cast_nonneg _⟩
  have hgₙLp (n : ℕ) (i : Fin d) : MemLp (gₙ n i) (ENNReal.ofReal (p i)) volume :=
    (hg i).mono (hgₙm n i).aestronglyMeasurable (Filter.Eventually.of_forall fun x => (hgₙb n i x).1)
  have hgₙfiber (n : ℕ) (i : Fin d) (x : Fin d → ℝ) :
      Integrable (fun y => gₙ n i (Function.update x i y)) := by
    let A := Icc (-(n:ℝ)) (n:ℝ)
    have hA : Integrable (A.indicator (fun _ => (n:ℝ))) :=
      (integrable_indicator_iff measurableSet_Icc).mpr (integrableOn_const measure_Icc_lt_top.ne)
    refine hA.mono' ((hgₙm n i).comp ((measurable_update' (a := i)).comp
      (measurable_const.prodMk measurable_id))).aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => ?_)
    by_cases hy : y ∈ A
    · rw [Set.indicator_of_mem hy]
      exact (hgₙb n i _).2
    · have hx : Function.update x i y ∉ U n i := by
        intro ht
        exact hy (abs_le.mp (by simpa only [Function.update_self] using ht.1))
      simp [gₙ, hx, hy]
  have hConv (x : Fin d → ℝ) (i : Fin d) :
      Tendsto (fun n => gₙ n i x) atTop (𝓝 (g i x)) := by
    let M := ⌈max |x i| ‖g i x‖⌉₊
    refine tendsto_const_nhds.congr' ((eventually_ge_atTop M).mono fun n hn => ?_)
    have h₁ : max |x i| ‖g i x‖ ≤ n := (Nat.le_ceil _).trans (by exact_mod_cast hn)
    exact (Set.indicator_of_mem (show x ∈ U n i from
      ⟨(le_max_left _ _).trans h₁,(le_max_right _ _).trans h₁⟩) _).symm
  have hAe (j : Fin d × ℤ) : ∀ᵐ x ∂(volume : Measure (Fin d → ℝ)),
      Tendsto (fun n => coordinateProfileConvolution j.1 (profileDilation (a j.1) j.2) (gₙ n j.1) x) atTop
        (𝓝 (coordinateProfileConvolution j.1 (profileDilation (a j.1) j.2) (g j.1) x)) := by
    filter_upwards [coordinateProfile_integrable_ae j.1 (hp j.1) (hgm j.1) (hg j.1) (a j.1) j.2] with x hx
    let G (y : ℝ) := profileDilation (a j.1) j.2 y
    let X (y : ℝ) := Function.update x j.1 (x j.1-y)
    have hX : Measurable X := (measurable_update' (a := j.1)).comp
      (measurable_const.prodMk (measurable_const.sub measurable_id))
    have hG : Measurable G := measurable_const.mul
      ((a j.1).continuous.measurable.comp (measurable_const.mul measurable_id))
    apply tendsto_integral_of_dominated_convergence (fun y => ‖G y*g j.1 (X y)‖)
      (fun n => (hG.mul ((hgₙm n j.1).comp hX)).aestronglyMeasurable) hx.norm
    · exact fun n => Filter.Eventually.of_forall fun y => by
        simp only [Pi.mul_apply,Function.comp_apply,norm_mul]
        exact mul_le_mul_of_nonneg_left (hgₙb n j.1 (X y)).1 (norm_nonneg _)
    · exact Filter.Eventually.of_forall fun y => (hConv (X y) j.1).const_mul (G y)
  have hLim : ∀ᵐ x ∂(volume : Measure (Fin d → ℝ)), Tendsto (fun n => F (gₙ n) x) atTop (𝓝 (F g x)) := by
    filter_upwards [ae_all_iff.mpr hAe] with x hx
    unfold F separatedProfileSum
    apply tendsto_finset_sum
    intro k _
    apply Tendsto.const_mul
    exact tendsto_finset_prod _ fun i _ => hx (i,k)
  have hM (g : Fin d → (Fin d → ℝ) → ℂ)
      (hg : ∀ i, MemLp (g i) (ENNReal.ofReal (p i)) volume) :
      AEStronglyMeasurable (F g) volume :=
    (separatedProfileSum_memLp hp hr hSum (fun i => (a i).continuous) (fun i => (a i).integrable)
      hg S (fun k => z (k-u).toNat)).aestronglyMeasurable
  refine Lp.eLpNorm_le_of_ae_tendsto (f := fun n => F (gₙ n)) ?_
    (fun n => hM _ (hgₙLp n)) (hM _ hg) hLim
  filter_upwards [] with n
  refine (h b a ha u T z hz (gₙ n) (hgₙm n) (hgₙLp n) (hgₙfiber n)
    (fun i => ⟨n,Nat.cast_nonneg _,fun x => (hgₙb n i x).2⟩)).trans ?_
  gcongr
  · exact Finset.single_le_sum (fun _ _ => zero_le) (Finset.mem_univ b)
  · exact eLpNorm_mono_ae (hgₙm n _).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => (hgₙb n _ x).1)

/-- The inverse transform of the bounded symbol realizes the compensated pairing
as a tempered distribution on the whole space. -/
theorem homogeneousPrincipalValueDistribution {d : ℕ} (hd : 2 ≤ d)
    (Ω : Metric.sphere (0 : E d) 1 → ℂ)
    (hK : ContDiffOn ℝ (↑(⊤ : ℕ∞)) (homogeneousKernel Ω) {y | y ≠ 0})
    (hΩ : (∫ ω, Ω ω ∂(volume : Measure (E d)).toSphere) = 0) :
    ∃ (m : E d → ℂ) (hm : MemLp m ∞ volume),
      (∀ N, ∃ A : ℝ, 0 ≤ A ∧ MikhlinHormander.MikhlinCondition N m A) ∧
      ∀ g : SchwartzMap (E d) ℂ,
        (𝓕⁻ (MeasureTheory.Lp.toTemperedDistribution (hm.toLp m))) g =
          ∫ y, compensatedPrincipalValue (homogeneousKernel Ω) g y := by
  obtain ⟨L,m,B,hL,hL0,hm,hB,hPair⟩ := homogeneousSymbol hd Ω hK hΩ
  have hmc : ContinuousOn m {x | x ≠ 0} := (hB 0).2.1.continuousOn
  have hmm := measurable_of_continuousOn_compl_singleton 0 hmc
  letI : Nonempty (Fin d) := ⟨⟨0,by omega⟩⟩
  have hbound : ∀ᵐ x ∂(volume : Measure (E d)), ‖m x‖ ≤ B 0 :=
    (ae_ne (volume : Measure (E d)) 0).mono fun x hx => by simpa using (hB 0).2.2 0 le_rfl x hx
  have hLp : MemLp m ∞ volume := memLp_top_of_bound hmm.aestronglyMeasurable _ hbound
  refine ⟨m,hLp,fun N => ⟨B N,(hB N).1,(hB N).2⟩,?_⟩
  intro g
  rw [TemperedDistribution.fourierInv_apply, MeasureTheory.Lp.toTemperedDistribution_apply, (hPair g).2]
  apply integral_congr_ae
  filter_upwards [hLp.coeFn_toLp] with ξ hξ
  rw [hξ,smul_eq_mul,mul_comm]

