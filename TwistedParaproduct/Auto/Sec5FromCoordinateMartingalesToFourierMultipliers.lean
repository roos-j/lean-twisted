      (ENNReal.ofReal t)^(p-2)) ≤ A₁ := by
    have h := lintegral_truncHigh_tail_le (μ := volume) hm.stronglyMeasurable
      (p0 := 1) (q0 := 1) (q := p) (p := p) (m := 1) (c := 1) (J := J)
      zero_lt_one hp₁ le_rfl one_ne_zero zero_lt_one hJ₀ hJ (by ring)
    simp only [Real.rpow_one, one_mul, ENNReal.ofReal_one, ENNReal.rpow_one,
      Real.one_rpow, div_one, abs_one, show p-1-1 = p-2 by ring] at h
    simp_rw [hHI]
    refine h.trans_eq ?_
    dsimp only [A₁]
    rw [← hJ_eq, ← ENNReal.ofReal_mul (by positivity : 0 ≤ 1/(p-1))]
    congr 1
    ring
  have hMoment := Auto.Spherical.Auxiliary.marcinkiewicz_weak_one_two_on_additive_split
    D id h (fun _ _ => norm_nonneg _) hSub 16 1 hWeak₁ hWeak₂ hp₁ hp₂ f
    (lineProfileConvolution_measurable hKm hm).norm.aemeasurable L H hL hH
    (fun t => (truncLow_add_truncHigh f t).symm) hLIm hHIm A₂ A₁ hTail₂ hTail₁
  have hR : (∫⁻ x, ‖T f x‖ₑ^p) ≤ scalarCzLowerMomentConstant p*M := by
    simp only [h, ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp₀.le, ofReal_norm] at hMoment
    refine hMoment.trans_eq ?_
    dsimp only [A₂,A₁,scalarCzLowerMomentConstant]
    ring
  have hh := ENNReal.rpow_le_rpow hR (one_div_nonneg.mpr hp₀.le)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (one_div_nonneg.mpr hp₀.le)] at hh
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hP₀ ENNReal.ofReal_ne_top
      (lineProfileConvolution_measurable hKm hm).aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hP₀ ENNReal.ofReal_ne_top hfp.aestronglyMeasurable,
    ENNReal.toReal_ofReal hp₀.le]
  simpa only [one_div] using hh

