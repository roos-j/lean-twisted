private theorem lineProfileConvolution_pair {K f g : ℝ → ℂ} {p : ℝ} (hp : 1 < p)
    (hKm : Measurable K) (hK : Integrable K) (hm : Measurable f) (hgM : Measurable g)
    (hf : MemLp f (ENNReal.ofReal p) volume)
    (hg : MemLp g (ENNReal.ofReal p.conjExponent) volume) :
    (∫ x, lineProfileConvolution K f x * g x) =
      ∫ y, f y * lineProfileConvolution (fun t => K (-t)) g y := by
  let H (z : ℝ × ℝ) := (f z.2 * K (z.1-z.2)) * g z.1
  have hM : Measurable H := ((hm.comp measurable_snd).mul
    (hKm.comp (measurable_fst.sub measurable_snd))).mul (hgM.comp measurable_fst)
  let A := lineProfileConvolution (fun x => Complex.ofReal ‖K x‖)
    (fun x => Complex.ofReal ‖f x‖)
  have hA : MemLp A (ENNReal.ofReal p) volume :=
    (lineProfileConvolution_young hp.le (Complex.continuous_ofReal.measurable.comp hKm.norm)
      hK.norm.ofReal (Complex.continuous_ofReal.measurable.comp hm.norm) hf.norm.ofReal).1
  let _ : ENNReal.HolderConjugate (ENNReal.ofReal p) (ENNReal.ofReal p.conjExponent) :=
    Auto.LpSpaceFacts.ofReal_holderConjugate p hp
  have habs (x : ℝ) : (∫ y, ‖H (x,y)‖) = ‖A x‖ * ‖g x‖ := by
    simp only [H, norm_mul]
    rw [integral_mul_const]
    have he : A x = Complex.ofReal (∫ y, ‖f y‖ * ‖K (x-y)‖) := by
      rw [show A x = lineProfileConvolution _ _ x from rfl, lineProfileConvolution_right]
      simp_rw [← Complex.ofReal_mul, integral_complex_ofReal]
    rw [he, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg]
    exact integral_nonneg fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _)
  have hInt : Integrable H (volume.prod volume) := by
    apply (integrable_prod_iff hM.aestronglyMeasurable).mpr
    refine ⟨?_, ?_⟩
    · filter_upwards [lineProfileConvolution_integrand_ae hKm hK hm hp hf] with x hx
      have he := ((volume : Measure ℝ).measurePreserving_sub_left x).integrable_comp_of_integrable hx
      simpa [H, Function.comp_def, mul_comm] using he.mul_const (g x)
    · simp_rw [habs]
      exact hA.norm.integrable_mul hg.norm
  calc
    _ = ∫ x, ∫ y, H (x,y) := by
      simp_rw [lineProfileConvolution_right, H, integral_mul_const]
    _ = ∫ y, ∫ x, H (x,y) := integral_integral_swap hInt
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with y
      rw [lineProfileConvolution_right, ← integral_const_mul]
      apply integral_congr_ae
      filter_upwards [] with x
      change f y * K (x-y) * g x = f y * (g x * K (-(y-x)))
      rw [neg_sub]
      ring

private noncomputable def scalarCzConstant (p : ℝ) : ℝ≥0∞ :=
  if p = 2 then 1 else (scalarCzLowerMomentConstant p)^p⁻¹

private theorem scalarCzConstant_ne_top {p : ℝ} (hp : 1 < p) :
    scalarCzConstant p ≠ ∞ := by
  unfold scalarCzConstant
  split
  · exact ENNReal.one_ne_top
  · apply (ENNReal.rpow_lt_top_of_nonneg (by positivity : 0 ≤ p⁻¹) _).ne
    unfold scalarCzLowerMomentConstant
    finiteness

