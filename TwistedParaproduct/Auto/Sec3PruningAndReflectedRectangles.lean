/-- The finite dyadic form with the difference in coordinate `b`. -/
noncomputable def dyadicForm {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) (H : (Fin d → ℝ) → ℝ) (f : Fin d → (Fin d → ℝ) → ℝ) : ℝ :=
  ∑ k ∈ Finset.range T, c k * ∫ x, H x * coordinateDifference b (u+k) (f b) x *
    ∏ i : {i : Fin d // i ≠ b}, coordinateAverage i (u+k) (f i) x

/-- The directional weak-type exceptional set for a supporting set. -/
def pruningSet {d : ℕ} (i : Fin d) (A₀ : Set (Fin d → ℝ)) (threshold : ℝ) :
    Set (Fin d → ℝ) :=
  coordinateMaxLevel i (A₀.indicator (fun _ => (1 : ℝ))) threshold

/-- Remove the directional maximal exceptional set from an input. -/
noncomputable def prunedInput {d : ℕ} (i : Fin d) (A₀ : Set (Fin d → ℝ)) (threshold : ℝ)
    (f : (Fin d → ℝ) → ℝ) : (Fin d → ℝ) → ℝ :=
  (pruningSet i A₀ threshold)ᶜ.indicator f

/-- Keep the tester where every ancestor test has passed. The terminal level
has zero tester. -/
noncomputable def pruningTester {d : ℕ} (u : ℤ) (T : ℕ)
    (A₀ : Set (Fin d → ℝ)) (threshold : Fin d → ℝ) (H : (Fin d → ℝ) → ℝ)
    (k : ℕ) (x : Fin d → ℝ) : ℝ :=
  if k < T ∧ ∀ j ≤ k, ∀ i, coordinateAverage i (u + (j : ℤ))
      (A₀.indicator (fun _ => 1)) x ≤ threshold i
  then H x else 0

theorem pruningTester_nonneg {d : ℕ} (u : ℤ) (T : ℕ) (A₀ : Set (Fin d → ℝ))
    (threshold : Fin d → ℝ) {H : (Fin d → ℝ) → ℝ} (hH : ∀ x, 0 ≤ H x)
    (k : ℕ) (x : Fin d → ℝ) : 0 ≤ pruningTester u T A₀ threshold H k x := by
  unfold pruningTester
  split <;> simp [hH x]

theorem pruningTester_le {d : ℕ} (u : ℤ) (T : ℕ) (A₀ : Set (Fin d → ℝ))
    (threshold : Fin d → ℝ) {H : (Fin d → ℝ) → ℝ} (hH : ∀ x, 0 ≤ H x)
    (k : ℕ) (x : Fin d → ℝ) : pruningTester u T A₀ threshold H k x ≤ H x := by
  unfold pruningTester
  split <;> simp [hH x]

theorem pruningTester_antitone {d : ℕ} (u : ℤ) (T : ℕ) (A₀ : Set (Fin d → ℝ))
    (threshold : Fin d → ℝ) {H : (Fin d → ℝ) → ℝ} (hH : ∀ x, 0 ≤ H x)
    (x : Fin d → ℝ) : Antitone (fun k => pruningTester u T A₀ threshold H k x) := by
  intro j k hjk
  by_cases hk : k < T ∧ ∀ l ≤ k, ∀ i, coordinateAverage i (u + (l : ℤ))
      (A₀.indicator (fun _ => 1)) x ≤ threshold i
  · have hj : j < T ∧ ∀ l ≤ j, ∀ i, coordinateAverage i (u + (l : ℤ))
        (A₀.indicator (fun _ => 1)) x ≤ threshold i :=
      ⟨hjk.trans_lt hk.1, fun l hl => hk.2 l (hl.trans hjk)⟩
    simp only [pruningTester, ite_eq_left hk, ite_eq_left hj, le_rfl]
  · simpa only [pruningTester, ite_eq_right hk] using pruningTester_nonneg u T A₀ threshold hH j x

theorem pruningTester_measurable {d : ℕ} (u : ℤ) (T : ℕ) {A₀ : Set (Fin d → ℝ)}
    (hA₀ : MeasurableSet A₀) (threshold : Fin d → ℝ) {H : (Fin d → ℝ) → ℝ}
    (hHm : Measurable H) (k : ℕ) : Measurable (pruningTester u T A₀ threshold H k) := by
  classical
  let E : Set (Fin d → ℝ) := {x | k < T ∧ ∀ j ≤ k, ∀ i,
    coordinateAverage i (u + (j : ℤ)) (A₀.indicator (fun _ => 1)) x ≤ threshold i}
  have hE : MeasurableSet E := by
    rw [show E = ({_x : Fin d → ℝ | k < T} ∩
      ⋂ j : ℕ, ⋂ _ : j ≤ k, ⋂ i : Fin d, {x | coordinateAverage i (u + (j : ℤ))
        (A₀.indicator (fun _ => 1)) x ≤ threshold i}) by
      ext x
      simp [E]]
    exact (MeasurableSet.const _).inter (MeasurableSet.iInter fun j =>
      MeasurableSet.iInter fun _ => MeasurableSet.iInter fun i =>
        measurableSet_le (measurable_coordinateAverage i _ (measurable_const.indicator hA₀))
          measurable_const)
  convert hHm.indicator hE using 1
  funext x
  unfold pruningTester
  split
  · rename_i h
    exact (indicator_of_mem (show x ∈ E from h) H).symm
  · rename_i h
    exact (indicator_of_notMem (show x ∉ E from h) H).symm

/-- The pointwise tester losses down a chain telescope, including the final drop. -/
theorem pruningTester_loss_le {d : ℕ} (u : ℤ) (T : ℕ)
    (A₀ : Set (Fin d → ℝ)) (threshold : Fin d → ℝ) {H : (Fin d → ℝ) → ℝ}
    (hH0 : ∀ x, 0 ≤ H x) (x : Fin d → ℝ) :
    (∑ k ∈ Finset.range T,
      |pruningTester u T A₀ threshold H k x - pruningTester u T A₀ threshold H (k+1) x|) ≤ H x := by
  let P (k : ℕ) := pruningTester u T A₀ threshold H k x
  have hp : Antitone P := pruningTester_antitone u T A₀ threshold hH0 x
  change (∑ k ∈ Finset.range T, |P k - P (k+1)|) ≤ H x
  simp_rw [abs_of_nonneg (sub_nonneg.mpr (hp (Nat.le_succ _)))]
  have hT : P T = 0 := by simp [P, pruningTester]
  calc
    _ = P 0 - P T := by
      calc
        _ = -(∑ k ∈ Finset.range T, (P (k+1) - P k)) := by
          rw [← Finset.sum_neg_distrib]
          exact Finset.sum_congr rfl (fun k _ => (neg_sub _ _).symm)
        _ = _ := by rw [Finset.sum_range_sub, neg_sub]
    _ ≤ H x := by rw [hT, sub_zero]; exact pruningTester_le u T A₀ threshold hH0 0 x


/-- A failed ancestor test removes the entire descendant fiber cell from the input. -/
theorem prunedInput_average_eq_zero_of_failed_ancestor {d : ℕ} (i : Fin d)
    {j k : ℤ} (hjk : j ≤ k) (A₀ : Set (Fin d → ℝ)) (threshold : ℝ)
    (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ)
    (hfail : threshold < coordinateAverage i j (A₀.indicator (fun _ => 1)) x) :
    coordinateAverage i k (prunedInput i A₀ threshold f) x = 0 := by
  let I := A₀.indicator (fun _ : Fin d → ℝ => (1 : ℝ))
  have hI : (fun y => |I y|) = I := by
    funext y
    by_cases hy : y ∈ A₀ <;> simp [I, hy]
  unfold coordinateAverage
  suffices hz : (∫ t in dyadicInterval k (dyadicIndex k (x i)),
      prunedInput i A₀ threshold f (Function.update x i t)) = 0 by rw [hz, mul_zero]
  have hzero (t : ℝ) (ht : t ∈ dyadicInterval k (dyadicIndex k (x i))) :
      prunedInput i A₀ threshold f (Function.update x i t) = 0 := by
    have hj : t ∈ dyadicInterval j (dyadicIndex j (x i)) :=
      dyadicInterval_subset_of_mem hjk (mem_dyadicInterval_iff.mpr rfl)
        (mem_dyadicInterval_iff.mpr rfl) ht
    have ht' : Function.update x i t ∈ pruningSet i A₀ threshold := by
      refine ⟨j, ?_⟩
      rw [hI, coordinateAverage_constantOnCells i j I x t (mem_dyadicInterval_iff.mp hj)]
      exact hfail
    exact indicator_of_notMem (by simpa only [mem_compl_iff, not_not] using ht') _
  exact (setIntegral_congr_fun measurableSet_Ico hzero).trans (by simp)

/-- A failed low-coordinate test kills both the average and the zero-reset residual. -/
theorem prunedInput_low_eq_zero_of_failed_ancestor {d : ℕ} (i : Fin d) (u : ℤ)
    {j k : ℕ} (hjk : j ≤ k) (A₀ : Set (Fin d → ℝ)) (threshold δ : ℝ)
    (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ)
    (hfail : threshold < coordinateAverage i (u + (j : ℤ))
      (A₀.indicator (fun _ => 1)) x) :
    coordinateLowPath i u (prunedInput i A₀ threshold f) k x = 0 ∧
      coordinateResidual i u δ (prunedInput i A₀ threshold f) k x = 0 := by
  have h0 := prunedInput_average_eq_zero_of_failed_ancestor i
    (show u + (j : ℤ) ≤ u+k by exact add_le_add_right (by exact_mod_cast hjk) u)
    A₀ threshold f x hfail
  refine ⟨h0, ?_⟩
  unfold coordinateResidual
  rw [recordedPath_zero h0]
  exact sub_eq_zero.mpr h0

/-- A failed high-coordinate test kills the high difference. -/
theorem prunedInput_difference_eq_zero_of_failed_ancestor {d : ℕ} (i : Fin d)
    {j k : ℤ} (hjk : j ≤ k) (A₀ : Set (Fin d → ℝ)) (threshold : ℝ)
    (f : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ)
    (hfail : threshold < coordinateAverage i j (A₀.indicator (fun _ => 1)) x) :
    coordinateDifference i k (prunedInput i A₀ threshold f) x = 0 := by
  unfold coordinateDifference
  rw [prunedInput_average_eq_zero_of_failed_ancestor i hjk A₀ threshold f x hfail,
    prunedInput_average_eq_zero_of_failed_ancestor i (hjk.trans (by omega)) A₀ threshold f x hfail,
    sub_self]


/-- The exceptional set in a pruning step has mass at most the input mass divided by its pruning factor. -/
theorem volume_pruningSet_le {d : ℕ} (i : Fin d) {A₀ : Set (Fin d → ℝ)}
    (hA₀ : MeasurableSet A₀) (hf : volume A₀ ≠ ⊤) {threshold : ℝ} (ht : 0 < threshold) :
    volume (pruningSet i A₀ threshold) ≤ (ENNReal.ofReal threshold)⁻¹ * volume A₀ := by
  have hm : Measurable (A₀.indicator (fun _ => (1 : ℝ))) := measurable_const.indicator hA₀
  have hi : Integrable (A₀.indicator (fun _ => (1 : ℝ))) :=
    (integrable_indicator_iff hA₀).mpr (integrableOn_const hf)
  have h := volume_coordinateMaxLevel_le i hm hi ht
  have he : (fun x => ‖A₀.indicator (fun _ => (1 : ℝ)) x‖ₑ) = A₀.indicator 1 := by
    funext x
    by_cases hx : x ∈ A₀ <;> simp [hx]
  rwa [he, lintegral_indicator_one hA₀] at h

/-- A pruned summand can use the monotone tester with any choice of residual slots. -/
theorem pruningTester_mul_eq {d : ℕ} (b : Fin d) (u : ℤ) {T k : ℕ} (hk : k < T)
    (A₀ : Set (Fin d → ℝ)) (threshold : Fin d → ℝ) (δ : ℝ)
    (H : (Fin d → ℝ) → ℝ) (f : Fin d → (Fin d → ℝ) → ℝ)
    (D : Finset (Fin d)) (x : Fin d → ℝ) :
    let G (i : Fin d) := prunedInput i A₀ (threshold i) (f i)
    let L (i : Fin d) := if i ∈ D then coordinateResidual i u δ (G i) k x
      else coordinateLowPath i u (G i) k x
    let F := coordinateDifference b (u + (k : ℤ)) (G b) x *
      ∏ i : {i : Fin d // i ≠ b}, L i
    H x * F = pruningTester u T A₀ threshold H k x * F := by
  classical
  dsimp only
  by_cases htest : ∀ j ≤ k, ∀ i, coordinateAverage i (u + (j : ℤ))
      (A₀.indicator (fun _ => 1)) x ≤ threshold i
  · rw [pruningTester, ite_eq_left ⟨hk, htest⟩]
  rw [pruningTester, ite_eq_right (fun hh => htest hh.2), zero_mul]
  push Not at htest
  obtain ⟨j, hjk, i, hi⟩ := htest
  by_cases hib : i = b
  · subst i
    have hz := prunedInput_difference_eq_zero_of_failed_ancestor b
      (show u + (j : ℤ) ≤ u+k by exact add_le_add_right (by exact_mod_cast hjk) u)
      A₀ (threshold b) (f b) x hi
    rw [hz, zero_mul, mul_zero]
  · have hz := prunedInput_low_eq_zero_of_failed_ancestor i u hjk
      A₀ (threshold i) δ (f i) x hi
    have hp : (∏ i : {i : Fin d // i ≠ b},
        if (i : Fin d) ∈ D then coordinateResidual i u δ (prunedInput i A₀ (threshold i) (f i)) k x
        else coordinateLowPath i u (prunedInput i A₀ (threshold i) (f i)) k x) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ (⟨i, hib⟩ : {i : Fin d // i ≠ b}))
      change (if i ∈ D then _ else _) = 0
      by_cases h : i ∈ D <;> simp [h, hz.1, hz.2]
    rw [hp, mul_zero, mul_zero]


/-- The tester has the required fiber bound on every sufficiently long subinterval. -/
theorem pruningTester_fiberAverage_le {d : ℕ} (i : Fin d) (u : ℤ) (T k : ℕ)
    {A₀ : Set (Fin d → ℝ)} (hA₀ : MeasurableSet A₀) (threshold : Fin d → ℝ)
    (hthreshold : 0 ≤ threshold i) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH0 : ∀ x, 0 ≤ H x) (hH1 : ∀ x, H x ≤ A₀.indicator (fun _ => 1) x)
    (x : Fin d → ℝ) {a b C : ℝ} (hab : a < b)
    (hI : Ico a b ⊆ dyadicInterval (u + (k : ℤ)) (dyadicIndex (u + (k : ℤ)) (x i)))
    (hC : (2 : ℝ)^(-(u + (k : ℤ))) ≤ C * (b-a)) :
    intervalAverage a b (fun t => pruningTester u T A₀ threshold H k (Function.update x i t)) ≤
      C * threshold i := by
  let j := u + (k : ℤ)
  let I := dyadicInterval j (dyadicIndex j (x i))
  let h (t : ℝ) := A₀.indicator (fun _ => (1 : ℝ)) (Function.update x i t)
  let g (t : ℝ) := pruningTester u T A₀ threshold H k (Function.update x i t)
  let l := (2 : ℝ)^(-j)
  have hl : 0 < l := by dsimp [l]; positivity
  have hC0 : 0 ≤ C := (mul_nonneg_iff_of_pos_right (sub_pos.mpr hab)).mp (hl.le.trans hC)
  have hg (t : ℝ) : 0 ≤ g t := pruningTester_nonneg u T A₀ threshold hH0 _ _
  have hh0 (t : ℝ) : 0 ≤ h t := (hH0 _).trans (hH1 _)
  have hh1 (t : ℝ) : h t ≤ 1 := by
    by_cases ht : Function.update x i t ∈ A₀ <;> simp [h, ht]
  by_cases ht : coordinateAverage i j (A₀.indicator (fun _ => 1)) x ≤ threshold i
  · have hm := (measurable_const.indicator hA₀ : Measurable (A₀.indicator (fun _ => (1 : ℝ)))).comp
      (measurable_update (a := i) x)
    have hi : IntegrableOn h I := by
      have hIf : volume I ≠ ⊤ := by unfold I dyadicInterval; rw [Real.volume_Ico]; exact ENNReal.ofReal_ne_top
      exact (integrableOn_const hIf (C := (1 : ℝ))).mono' hm.aestronglyMeasurable
        (Filter.Eventually.of_forall fun t => by change |h t| ≤ 1; rw [abs_of_nonneg (hh0 t)]; exact hh1 t)
    have hgI : IntegrableOn g (Ico a b) := by
      refine (hi.mono_set hI).mono' ((pruningTester_measurable u T hA₀ threshold hHm k).comp
        (measurable_update (a := i) x)).aestronglyMeasurable ?_
      filter_upwards with t
      rw [Real.norm_of_nonneg (hg t)]
      exact (pruningTester_le u T A₀ threshold hH0 k _).trans (hH1 _)
    have hm' := integral_mono hgI (hi.mono_set hI) fun t =>
      (pruningTester_le u T A₀ threshold hH0 k (Function.update x i t)).trans (hH1 _)
    have hh' := setIntegral_mono_set hi (Filter.Eventually.of_forall hh0) (Filter.Eventually.of_forall hI)
    have havg : (∫ t in I, h t) ≤ l * threshold i :=
      (inv_mul_le_iff₀ hl).mp ht
    unfold intervalAverage
    apply (inv_mul_le_iff₀ (sub_pos.mpr hab)).mpr
    exact (hm'.trans (hh'.trans havg)).trans
      ((mul_le_mul_of_nonneg_right hC hthreshold).trans_eq (by ring))
  · have hz (t : ℝ) (htI : t ∈ Ico a b) : g t = 0 := by
      unfold g pruningTester
      apply ite_eq_right
      intro hp
      apply ht
      have hp' := hp.2 k le_rfl i
      rw [coordinateAverage_constantOnCells i j _ x t (mem_dyadicInterval_iff.mp (hI htI))] at hp'
      exact hp'
    have hzero : (∫ t in Ico a b, g t) = 0 := by
      exact (setIntegral_congr_fun measurableSet_Ico hz).trans (by simp)
    unfold intervalAverage
    change (b-a)⁻¹ * (∫ t in Ico a b, g t) ≤ _
    rw [hzero, mul_zero]
    exact mul_nonneg hC0 hthreshold


/-- The total integrated mass loss in the finite pruning chain. -/
theorem pruningTester_integral_loss_le {d : ℕ} (u : ℤ) (T : ℕ)
    {A₀ : Set (Fin d → ℝ)} (hA₀ : MeasurableSet A₀) (hA₀f : volume A₀ ≠ ⊤)
    (threshold : Fin d → ℝ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH0 : ∀ x, 0 ≤ H x) (hH1 : ∀ x, H x ≤ A₀.indicator (fun _ => 1) x) :
    (∑ k ∈ Finset.range T, ∫ x,
      |pruningTester u T A₀ threshold H k x - pruningTester u T A₀ threshold H (k+1) x|) ≤
      (volume : Measure (Fin d → ℝ)).real A₀ := by
  let P (k : ℕ) := pruningTester u T A₀ threshold H k
  have hI : Integrable (A₀.indicator (fun _ => (1 : ℝ))) :=
    (integrable_indicator_iff hA₀).mpr (integrableOn_const hA₀f)
  have hHi : Integrable H := hI.mono' hHm.aestronglyMeasurable
    (Filter.Eventually.of_forall fun x => (Real.norm_of_nonneg (hH0 x)).le.trans (hH1 x))
  have hPi (k : ℕ) : Integrable (P k) := hHi.mono'
    (pruningTester_measurable u T hA₀ threshold hHm k).aestronglyMeasurable
    (Filter.Eventually.of_forall fun x => (Real.norm_of_nonneg
      (pruningTester_nonneg u T A₀ threshold hH0 k x)).le.trans
        (pruningTester_le u T A₀ threshold hH0 k x))
  have ht (k : ℕ) : Integrable (fun x => |P k x - P (k+1) x|) :=
    ((hPi k).sub (hPi (k+1))).norm
  rw [← integral_finsetSum _ (fun k _ => ht k)]
  have h := integral_mono (integrable_finsetSum _ (fun k _ => ht k)) hI
    (fun x => (pruningTester_loss_le u T A₀ threshold hH0 x).trans (hH1 x))
  rwa [integral_indicator hA₀, setIntegral_const, smul_eq_mul, mul_one] at h


theorem eLpNorm_finite_product_le {ι Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} (s : Finset ι) (p : ι → ℝ≥0∞) (g : ι → Ω → ℝ)
    (hg : ∀ i, Measurable (g i)) :
    eLpNorm (fun x => ∏ i ∈ s, g i x) (∑ i ∈ s, (p i)⁻¹)⁻¹ μ ≤
      ∏ i ∈ s, eLpNorm (g i) (p i) μ := by
  classical
  induction s using Finset.cons_induction with
  | empty =>
    by_cases hμ : μ = 0
    · simp [hμ]
    · simp [eLpNorm_exponent_top aestronglyMeasurable_const, eLpNormEssSup_const (1 : ℝ) hμ]
  | cons i s hi ih =>
    simp only [Finset.prod_cons, Finset.sum_cons]
    let p' := (∑ j ∈ s, (p j)⁻¹)⁻¹
    let G (x : Ω) := ∏ j ∈ s, g j x
    let hG : Measurable G := Finset.measurable_fun_prod _ (fun j _ => hg j)
    have hHolder : ENNReal.HolderTriple (p i) p' (((p i)⁻¹ + ∑ j ∈ s, (p j)⁻¹)⁻¹) :=
      ⟨by simp [p']⟩
    have h := eLpNorm_le_eLpNorm_mul_eLpNorm_of_enorm (f := g i) (g := G)
      (μ := μ) (· * ·) 1 continuous_mul (hg i).aestronglyMeasurable hG.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by rw [one_mul, enorm_mul]) (hpqr := hHolder)
    exact (by simpa only [one_mul] using h : _ ≤ eLpNorm (g i) (p i) μ * eLpNorm G p' μ).trans
      (by gcongr)

/-- Hölder's inequality for the integral of a finite product. -/
theorem integral_product_le {ι Ω : Type*} [Fintype ι] [MeasurableSpace Ω] {μ : Measure Ω}
    (p : ι → ℝ≥0∞) (g : ι → Ω → ℝ) (w : ι → ℝ) (hw : ∀ i, 0 ≤ w i)
    (hp : ∑ i, (p i)⁻¹ = 1) (hm : ∀ i, Measurable (g i))
    (hLp : ∀ i, MemLp (g i) (p i) μ) (hbound : ∀ i, lpNorm (g i) (p i) μ ≤ w i) :
    let F (x : Ω) := ∏ i, g i x
    Integrable F μ ∧ |∫ x, F x ∂μ| ≤ ∏ i, w i := by
  dsimp only
  have hi := MemLp.fun_prod (s := Finset.univ) fun i _ => hLp i
  rw [hp, inv_one] at hi
  refine ⟨memLp_one_iff_integrable.mp hi, ?_⟩
  have h := eLpNorm_finite_product_le (μ := μ) Finset.univ p g hm
  rw [hp, inv_one] at h
  have hb (i : ι) : eLpNorm (g i) (p i) μ ≤ ENNReal.ofReal (w i) := by
    rw [← ENNReal.ofReal_toReal (hLp i).eLpNorm_lt_top.ne]
    exact ENNReal.ofReal_le_ofReal (hbound i)
  have he : eLpNorm (fun x => ∏ i, g i x) 1 μ ≤ ∏ i, ENNReal.ofReal (w i) :=
    h.trans (Finset.prod_le_prod fun i _ => hb i)
  have hprod : (∏ i, ENNReal.ofReal (w i)) = ENNReal.ofReal (∏ i, w i) := by
    generalize (Finset.univ : Finset ι) = s
    induction s using Finset.cons_induction with
    | empty => simp
    | cons i s hi ih => simp [Finset.prod_cons, ih, ENNReal.ofReal_mul (hw i)]
  rw [hprod] at he
  have hr := ENNReal.toReal_mono ENNReal.ofReal_ne_top he
  rw [ENNReal.toReal_ofReal (Finset.prod_nonneg fun i _ => hw i)] at hr
  change lpNorm (fun x => ∏ i, g i x) 1 μ ≤ _ at hr
  rw [lpNorm_one_eq_integral_norm hi.aestronglyMeasurable] at hr
  exact abs_integral_le_integral_abs.trans hr


/-- The support weight used to normalize the finite dyadic form. -/
noncomputable def dyadicSupportWeight {d : ℕ} (t : Option (Fin d) → ℝ)
    (A : Option (Fin d) → Set (Fin d → ℝ)) : ℝ :=
  ∏ i, ((volume : Measure (Fin d → ℝ)).real (A i))^(t i)

/-- The tester, difference, or average associated with a slot of the dyadic form. -/
noncomputable def dyadicSlot {d : ℕ} (b : Fin d) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℝ) : Option (Fin d) → (Fin d → ℝ) → ℝ
  | none => f none
  | some i => if i = b then coordinateDifference i k (f (some i))
      else coordinateAverage i k (f (some i))

theorem dyadicSlot_product {d : ℕ} (b : Fin d) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℝ) (x : Fin d → ℝ) :
    (∏ i, dyadicSlot b k f i x) = f none x * coordinateDifference b k (f (some b)) x *
      ∏ i : {i : Fin d // i ≠ b}, coordinateAverage i k (f (some i)) x := by
  rw [Fintype.prod_option, Fintype.prod_eq_mul_prod_subtype_ne _ b]
  have h : (∏ i : {i : Fin d // i ≠ b}, dyadicSlot b k f (some i) x) =
      ∏ i : {i : Fin d // i ≠ b}, coordinateAverage i (k : ℤ) (f (some i)) x := by
    apply Finset.prod_congr rfl
    intro i _
    exact congrFun (ite_eq_right i.property) x
  rw [h]
  simp only [dyadicSlot, ite_true, mul_assoc]

/-- A finite-window bound for the normalized form, including null support sets. -/
theorem dyadicForm_crude_le {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1) (t : Option (Fin d) → ℝ)
    (ht : ∀ i, 0 < t i) (hs : ∑ i, t i = 1)
    (A : Option (Fin d) → Set (Fin d → ℝ)) (hA : ∀ i, MeasurableSet (A i))
    (hAf : ∀ i, volume (A i) ≠ ⊤)
    (f : Option (Fin d) → (Fin d → ℝ) → ℝ) (hm : ∀ i, Measurable (f i))
    (h0 : ∀ i x, 0 ≤ f i x) (h1 : ∀ i x, f i x ≤ (A i).indicator (fun _ => 1) x) :
    |dyadicForm b u T c (f none) (fun i => f (some i))| ≤
      (2 * T) * dyadicSupportWeight t A := by
  classical
  let a (i : Option (Fin d)) := ((volume : Measure (Fin d → ℝ)).real (A i))^(t i)
  let p (i : Option (Fin d)) := ENNReal.ofReal (1/t i)
  let w (i : Option (Fin d)) := (if i = some b then 2 else 1) * a i
  have ht1 (i : Option (Fin d)) : t i ≤ 1 := by
    rw [← hs]
    exact Finset.single_le_sum (fun j _ => (ht j).le) (Finset.mem_univ i)
  have hp1 (i : Option (Fin d)) : 1 ≤ 1/t i :=
    (le_div_iff₀ (ht i)).mpr (by simpa using ht1 i)
  have hinv (i : Option (Fin d)) : 1/(1/t i) = t i := by field_simp
  have hp : ∑ i, (p i)⁻¹ = 1 := by
    simp_rw [p, ← ENNReal.ofReal_inv_of_pos (one_div_pos.mpr (ht _)), ← one_div, hinv]
    rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => (ht i).le), hs, ENNReal.ofReal_one]
  have ha (i : Option (Fin d)) : 0 ≤ a i := Real.rpow_nonneg ENNReal.toReal_nonneg _
  have hw (i : Option (Fin d)) : 0 ≤ w i := by
    unfold w
    split <;> positivity [ha i]
  have hF (i : Option (Fin d)) : MemLp (f i) (p i) volume ∧ lpNorm (f i) (p i) volume ≤ a i := by
    simpa only [p, a, hinv] using lpNorm_le_of_indicator (hA i) (hAf i) (hm i) (h0 i) (h1 i)
      (one_div_pos.mpr (ht i))
  have hAvg (i : Fin d) (k : ℤ) :
      MemLp (coordinateAverage i k (f (some i))) (p (some i)) volume ∧
        lpNorm (coordinateAverage i k (f (some i))) (p (some i)) volume ≤ a (some i) := by
    have hLp := (hF (some i)).1
    have he := coordinateAverage_eLpNorm_le i k (hp1 (some i)) (hm (some i)) hLp
    exact ⟨he.trans_lt hLp.eLpNorm_lt_top,
      (ENNReal.toReal_mono hLp.eLpNorm_lt_top.ne he).trans (hF (some i)).2⟩
  have hslot (k : ℤ) (i : Option (Fin d)) :
      MemLp (dyadicSlot b k f i) (p i) volume ∧
        lpNorm (dyadicSlot b k f i) (p i) volume ≤ w i := by
    cases i with
    | none => simpa [dyadicSlot, w] using hF none
    | some i =>
      by_cases hi : i = b
      · subst i
        simp only [dyadicSlot, ite_true, w]
        have hNext := hAvg b (k+1)
        have hNow := hAvg b k
        refine ⟨hNext.1.sub hNow.1, ?_⟩
        have hq : 1 ≤ p (some b) := by
          simpa only [p, ENNReal.ofReal_one] using ENNReal.ofReal_le_ofReal (hp1 (some b))
        exact (lpNorm_sub_le hNext.1 hq).trans
          ((add_le_add hNext.2 hNow.2).trans_eq (by ring))
      · simpa [dyadicSlot, hi, w] using hAvg i k
  have hslotm (k : ℤ) (i : Option (Fin d)) : Measurable (dyadicSlot b k f i) := by
    cases i with
    | none => exact hm none
    | some i =>
      by_cases hi : i = b
      · rw [dyadicSlot, ite_eq_left hi]
        change Measurable (fun x => coordinateAverage i (k+1) (f (some i)) x -
          coordinateAverage i k (f (some i)) x)
        exact (measurable_coordinateAverage i (k+1) (hm (some i))).sub
          (measurable_coordinateAverage i k (hm (some i)))
      · simpa only [dyadicSlot, ite_eq_right hi] using measurable_coordinateAverage i k (hm (some i))
  have hpw : (∏ i, w i) = 2 * dyadicSupportWeight t A := by
    simp only [w, Finset.prod_mul_distrib, dyadicSupportWeight, a]
    rw [Finset.prod_ite_eq' Finset.univ (some b)]
    simp
  unfold dyadicForm
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  calc
    _ ≤ ∑ _k ∈ Finset.range T, 2 * dyadicSupportWeight t A := by
      apply Finset.sum_le_sum
      intro k _
      rw [abs_mul]
      have he := (integral_product_le p (dyadicSlot b (u+k) f) w hw hp (hslotm _)
        (fun i => (hslot _ i).1) (fun i => (hslot _ i).2)).2
      simp only [dyadicSlot_product, hpw] at he
      exact (mul_le_of_le_one_left (abs_nonneg _) (hc k)).trans he
    _ = _ := by simp [nsmul_eq_mul]; ring


/-- Inputs and their measurable finite supports for the restricted estimate. -/
def DyadicSupported {d : ℕ} (A : Option (Fin d) → Set (Fin d → ℝ))
    (f : Option (Fin d) → (Fin d → ℝ) → ℝ) : Prop :=
  ∀ i, MeasurableSet (A i) ∧ volume (A i) ≠ ⊤ ∧ Measurable (f i) ∧
    (∀ x, 0 ≤ f i x) ∧ ∀ x, f i x ≤ (A i).indicator (fun _ => 1) x

/-- The best finite-window constant in the normalized restricted estimate. -/
noncomputable def dyadicFormConstant {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (t : Option (Fin d) → ℝ) : ℝ :=
  sSup {r | ∃ (c : ℕ → ℝ) (A : Option (Fin d) → Set (Fin d → ℝ))
      (f : Option (Fin d) → (Fin d → ℝ) → ℝ),
    (∀ k, |c k| ≤ 1) ∧ DyadicSupported A f ∧
      r = |dyadicForm b u T c (f none) (fun i => f (some i))| / dyadicSupportWeight t A}

private theorem dyadicFormConstant_upperBounds {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (t : Option (Fin d) → ℝ) (ht : ∀ i, 0 < t i) (hs : ∑ i, t i = 1) :
    (2 * T : ℝ) ∈ upperBounds {r | ∃ (c : ℕ → ℝ) (A : Option (Fin d) → Set (Fin d → ℝ))
        (f : Option (Fin d) → (Fin d → ℝ) → ℝ),
      (∀ k, |c k| ≤ 1) ∧ DyadicSupported A f ∧
        r = |dyadicForm b u T c (f none) (fun i => f (some i))| / dyadicSupportWeight t A} := by
  rintro r ⟨c, A, f, hc, hf, rfl⟩
  have hn : 0 ≤ dyadicSupportWeight t A :=
    Finset.prod_nonneg fun _ _ => Real.rpow_nonneg ENNReal.toReal_nonneg _
  rcases hn.eq_or_lt with h | h
  · rw [← h, div_zero]
    positivity
  · exact (div_le_iff₀ h).mpr (dyadicForm_crude_le b u T c hc t ht hs A
      (fun i => (hf i).1) (fun i => (hf i).2.1) f (fun i => (hf i).2.2.1)
      (fun i => (hf i).2.2.2.1) (fun i => (hf i).2.2.2.2))

theorem dyadicForm_le_constant {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1) (t : Option (Fin d) → ℝ)
    (ht : ∀ i, 0 < t i) (hs : ∑ i, t i = 1)
    {A : Option (Fin d) → Set (Fin d → ℝ)} {f : Option (Fin d) → (Fin d → ℝ) → ℝ}
    (hf : DyadicSupported A f) :
    |dyadicForm b u T c (f none) (fun i => f (some i))| ≤
      dyadicFormConstant b u T t * dyadicSupportWeight t A := by
  have hn : 0 ≤ dyadicSupportWeight t A :=
    Finset.prod_nonneg fun _ _ => Real.rpow_nonneg ENNReal.toReal_nonneg _
  rcases hn.eq_or_lt with h | h
  · rw [← h, mul_zero]
    simpa only [← h, mul_zero] using dyadicForm_crude_le b u T c hc t ht hs A
      (fun i => (hf i).1) (fun i => (hf i).2.1) f (fun i => (hf i).2.2.1)
      (fun i => (hf i).2.2.2.1) (fun i => (hf i).2.2.2.2)
  · exact (div_le_iff₀ h).mp
      (le_csSup ⟨2*T, dyadicFormConstant_upperBounds b u T t ht hs⟩ ⟨c, A, f, hc, hf, rfl⟩)

/-- The best constant is nonnegative and bounded by twice the number of levels. -/
theorem dyadicFormConstant_bounds {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (t : Option (Fin d) → ℝ) (ht : ∀ i, 0 < t i) (hs : ∑ i, t i = 1) :
    0 ≤ dyadicFormConstant b u T t ∧ dyadicFormConstant b u T t ≤ 2*T := by
  have hb := dyadicFormConstant_upperBounds b u T t ht hs
  have hF : DyadicSupported (d := d) (fun _ => ∅) (fun _ _ => 0) := by
    intro i
    simp [measurable_const]
  have h0 : (0 : ℝ) ∈ {r | ∃ (c : ℕ → ℝ) (A : Option (Fin d) → Set (Fin d → ℝ))
      (f : Option (Fin d) → (Fin d → ℝ) → ℝ),
    (∀ k, |c k| ≤ 1) ∧ DyadicSupported A f ∧
      r = |dyadicForm b u T c (f none) (fun i => f (some i))| / dyadicSupportWeight t A} := by
    exact ⟨fun _ => 0, fun _ => ∅, fun _ _ => 0, by simp, hF, by simp [dyadicForm]⟩
  exact ⟨le_csSup ⟨2*T, hb⟩ h0, csSup_le ⟨0, h0⟩ (fun _ hr => hb hr)⟩


theorem dyadicForm_integrand_integrable {d : ℕ} (b : Fin d) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℝ) (hm : ∀ i, Measurable (f i))
    (h1 : ∀ i x, |f i x| ≤ 1) (hH : Integrable (f none)) :
    Integrable (fun x => ∏ i, dyadicSlot b k f i x) := by
  have hprod (x : Fin d → ℝ) :
      |∏ i : {i : Fin d // i ≠ b}, coordinateAverage i k (f (some i)) x| ≤ 1 := by
    rw [Finset.abs_prod]
    exact Finset.prod_le_one₀ (fun _ _ => abs_nonneg _)
      (fun (i : {i : Fin d // i ≠ b}) _ => abs_coordinateAverage_le (i : Fin d) k (h1 (some (i : Fin d))) x)
  have hd (x : Fin d → ℝ) : |coordinateDifference b k (f (some b)) x| ≤ 2 := by
    unfold coordinateDifference
    refine (abs_sub _ _).trans ?_
    simpa only [one_add_one_eq_two] using add_le_add
      (abs_coordinateAverage_le b (k+1) (h1 (some b)) x)
      (abs_coordinateAverage_le b k (h1 (some b)) x)
  have hDm : Measurable (coordinateDifference b k (f (some b))) :=
    (measurable_coordinateAverage b (k+1) (hm (some b))).sub
      (measurable_coordinateAverage b k (hm (some b)))
  simp_rw [dyadicSlot_product]
  refine (hH.norm.const_mul 2).mono'
    (((hm none).mul hDm).mul (Finset.measurable_fun_prod (Finset.univ : Finset {i : Fin d // i ≠ b})
      (fun i _ => measurable_coordinateAverage i k (hm (some i))))).aestronglyMeasurable ?_
  filter_upwards with x
  rw [Real.norm_eq_abs, abs_mul, abs_mul]
  change _ ≤ 2 * |f none x|
  calc
    _ ≤ |f none x| * |coordinateDifference b k (f (some b)) x| :=
      mul_le_of_le_one_right (by positivity) (hprod x)
    _ ≤ |f none x| * 2 := mul_le_mul_of_nonneg_left (hd x) (abs_nonneg _)
    _ = _ := mul_comm _ _

private theorem dyadicSlot_update_add {d : ℕ} (b : Fin d) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℝ) (j : Fin d)
    {g h : (Fin d → ℝ) → ℝ} (hgm : Measurable g) (hhm : Measurable h)
    (hg1 : ∀ x, |g x| ≤ 1) (hh1 : ∀ x, |h x| ≤ 1) (x : Fin d → ℝ) :
    dyadicSlot b k (Function.update f (some j) (fun x => g x + h x)) (some j) x =
      dyadicSlot b k (Function.update f (some j) g) (some j) x +
      dyadicSlot b k (Function.update f (some j) h) (some j) x := by
  simp only [dyadicSlot, Function.update_self]
  split
  · unfold coordinateDifference
    rw [coordinateAverage_add_of_bounded j (k+1) hgm hhm hg1 hh1,
      coordinateAverage_add_of_bounded j k hgm hhm hg1 hh1]
    ring
  · exact coordinateAverage_add_of_bounded j k hgm hhm hg1 hh1 x

private theorem dyadicSlot_update_other {d : ℕ} (b : Fin d) (k : ℤ)
    (f : Option (Fin d) → (Fin d → ℝ) → ℝ) (j : Option (Fin d))
    (g : (Fin d → ℝ) → ℝ) (i : Option (Fin d)) (hi : i ≠ j) :
    dyadicSlot b k (Function.update f j g) i = dyadicSlot b k f i := by
  cases i <;> simp [dyadicSlot, Function.update_of_ne hi]

private theorem dyadicForm_update_add {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) (f : Option (Fin d) → (Fin d → ℝ) → ℝ) (j : Fin d)
    (hm : ∀ i, Measurable (f i)) (h1 : ∀ i x, |f i x| ≤ 1) (hH : Integrable (f none))
    {g h : (Fin d → ℝ) → ℝ} (hgm : Measurable g) (hhm : Measurable h)
    (hg1 : ∀ x, |g x| ≤ 1) (hh1 : ∀ x, |h x| ≤ 1) :
    let L (F : Option (Fin d) → (Fin d → ℝ) → ℝ) :=
      dyadicForm b u T c (F none) (fun i => F (some i))
    L (Function.update f (some j) (fun x => g x + h x)) =
      L (Function.update f (some j) g) + L (Function.update f (some j) h) := by
  classical
  dsimp only
  unfold dyadicForm
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro n _
  rw [← mul_add]
  congr 1
  simp_rw [← dyadicSlot_product]
  have hint (p : (Fin d → ℝ) → ℝ) (hpm : Measurable p) (hp1 : ∀ x, |p x| ≤ 1) :
      Integrable (fun x => ∏ i, dyadicSlot b (u+n) (Function.update f (some j) p) i x) := by
    apply dyadicForm_integrand_integrable
    · intro i
      by_cases hi : i = some j
      · subst i; simpa using hpm
      · simpa only [Function.update_of_ne hi] using hm i
    · intro i x
      by_cases hi : i = some j
      · subst i; simpa using hp1 x
      · simpa only [Function.update_of_ne hi] using h1 i x
    · simpa only [Function.update_of_ne (show none ≠ some j by simp)] using hH
  rw [← integral_add (hint g hgm hg1) (hint h hhm hh1)]
  apply integral_congr_ae
  filter_upwards with x
  have hout (p : (Fin d → ℝ) → ℝ) :
      (∏ i : {i : Option (Fin d) // i ≠ some j},
        dyadicSlot b (u+n) (Function.update f (some j) p) i x) =
      ∏ i : {i : Option (Fin d) // i ≠ some j}, dyadicSlot b (u+n) f i x := by
    apply Finset.prod_congr rfl
    intro i _
    rw [dyadicSlot_update_other b (u+n) f (some j) p i i.property]
  simp only [Fintype.prod_eq_mul_prod_subtype_ne _ (some j), hout,
    dyadicSlot_update_add b (u+n) f j hgm hhm hg1 hh1 x, add_mul]


private theorem indicator_restrict_supported {Ω : Type*} {A U : Set Ω} {f : Ω → ℝ}
    (h0 : ∀ x, 0 ≤ f x) (h1 : ∀ x, f x ≤ A.indicator (fun _ => 1) x) :
    (∀ x, 0 ≤ U.indicator f x) ∧
      ∀ x, U.indicator f x ≤ (A ∩ U).indicator (fun _ => 1) x := by
  constructor
  · intro x
    by_cases h : x ∈ U <;> simp [h, h0 x]
  · intro x
    by_cases h : x ∈ U
    · by_cases hx : x ∈ A <;> simpa [hx, h] using h1 x
    · simp [h]

private theorem supported_abs_le_one {d : ℕ}
    {A : Option (Fin d) → Set (Fin d → ℝ)} {f : Option (Fin d) → (Fin d → ℝ) → ℝ}
    (hf : DyadicSupported A f) (i : Option (Fin d)) (x : Fin d → ℝ) : |f i x| ≤ 1 := by
  rw [abs_of_nonneg ((hf i).2.2.2.1 x)]
  refine ((hf i).2.2.2.2 x).trans ?_
  by_cases hx : x ∈ A i <;> simp [hx]

private theorem update_supported {d : ℕ}
    {A : Option (Fin d) → Set (Fin d → ℝ)} {f : Option (Fin d) → (Fin d → ℝ) → ℝ}
    (hf : DyadicSupported A f) (j : Option (Fin d))
    {B : Set (Fin d → ℝ)} (hBm : MeasurableSet B) (hBf : volume B ≠ ⊤)
    {g : (Fin d → ℝ) → ℝ} (hgm : Measurable g) (hg0 : ∀ x, 0 ≤ g x)
    (hg1 : ∀ x, g x ≤ B.indicator (fun _ => 1) x) :
    DyadicSupported (Function.update A j B) (Function.update f j g) := by
  intro i
  by_cases hi : i = j
  · subst i
    simpa only [Function.update_self] using And.intro hBm (And.intro hBf (And.intro hgm ⟨hg0, hg1⟩))
  · simpa only [Function.update_of_ne hi] using hf i

private theorem supportWeight_update_le {d : ℕ}
    (A : Option (Fin d) → Set (Fin d → ℝ)) (t : Option (Fin d) → ℝ) (j : Option (Fin d))
    (ht : 0 ≤ t j) {B : Set (Fin d → ℝ)} {K : ℝ} (hK : 0 < K)
    (hB : (volume : Measure (Fin d → ℝ)).real B ≤ volume.real (A j) / K) :
    dyadicSupportWeight t (Function.update A j B) ≤ K^(-t j) * dyadicSupportWeight t A := by
  classical
  unfold dyadicSupportWeight
  rw [Fintype.prod_eq_mul_prod_subtype_ne _ j, Fintype.prod_eq_mul_prod_subtype_ne
    (fun i => (volume.real (A i))^(t i)) j]
  have hProd : (∏ i : {i : Option (Fin d) // i ≠ j},
      (volume.real (Function.update A j B i))^(t i)) =
      ∏ i : {i : Option (Fin d) // i ≠ j}, (volume.real (A i))^(t i) := by
    apply Finset.prod_congr rfl
    intro i _
    rw [Function.update_of_ne i.property]
  rw [hProd, Function.update_self, ← mul_assoc]
  apply mul_le_mul_of_nonneg_right _ (Finset.prod_nonneg fun _ _ => Real.rpow_nonneg ENNReal.toReal_nonneg _)
  exact (Real.rpow_le_rpow ENNReal.toReal_nonneg hB ht).trans_eq (by
    rw [Real.div_rpow (show 0 ≤ (volume : Measure (Fin d → ℝ)).real (A j) from ENNReal.toReal_nonneg) hK.le, Real.rpow_neg hK.le, div_eq_mul_inv, mul_comm])

private theorem pruningSet_real_le {d : ℕ} (i : Fin d) {A₀ : Set (Fin d → ℝ)}
    (hA₀ : MeasurableSet A₀) (hA₀f : volume A₀ ≠ ⊤)
    {a K : ℝ} (ha : 0 < a) (hK : 0 < K) (hh : 0 < (volume : Measure (Fin d → ℝ)).real A₀) :
    let U := pruningSet i A₀ (K * volume.real A₀ / a)
    volume U ≠ ⊤ ∧ (volume : Measure (Fin d → ℝ)).real U ≤ a/K := by
  dsimp only
  let τ := K * (volume : Measure (Fin d → ℝ)).real A₀ / a
  have hτ : 0 < τ := div_pos (mul_pos hK hh) ha
  have hb := volume_pruningSet_le i hA₀ hA₀f hτ
  have htop : (ENNReal.ofReal τ)⁻¹ * volume A₀ ≠ ⊤ :=
    ENNReal.mul_ne_top (ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hτ)) hA₀f
  refine ⟨(hb.trans_lt htop.lt_top).ne, ?_⟩
  have hc := ENNReal.toReal_mono htop hb
  rw [ENNReal.toReal_mul, ENNReal.toReal_inv, ENNReal.toReal_ofReal hτ.le] at hc
  refine hc.trans_eq ?_
  dsimp only [τ]
  change _ * ((volume : Measure (Fin d → ℝ)).real A₀) = _
  field_simp


private theorem dyadicForm_prune_one {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1) (t : Option (Fin d) → ℝ)
    (ht : ∀ i, 0 < t i) (hs : ∑ i, t i = 1)
    {A : Option (Fin d) → Set (Fin d → ℝ)} {f : Option (Fin d) → (Fin d → ℝ) → ℝ}
    (hf : DyadicSupported A f) (j : Fin d) {K : ℝ} (hK : 0 < K)
    (hh : 0 < (volume : Measure (Fin d → ℝ)).real (A none))
    (ha : 0 < (volume : Measure (Fin d → ℝ)).real (A (some j))) :
    let τ := K * volume.real (A none) / volume.real (A (some j))
    let f' := Function.update f (some j) (prunedInput j (A none) τ (f (some j)))
    DyadicSupported A f' ∧
    |dyadicForm b u T c (f none) (fun i => f (some i)) -
      dyadicForm b u T c (f' none) (fun i => f' (some i))| ≤
        K^(-t (some j)) * dyadicFormConstant b u T t * dyadicSupportWeight t A := by
  classical
  dsimp only
  let τ := K * (volume : Measure (Fin d → ℝ)).real (A none) / volume.real (A (some j))
  let U := pruningSet j (A none) τ
  let g := Uᶜ.indicator (f (some j))
  let h := U.indicator (f (some j))
  let F := Function.update f (some j) g
  let G := Function.update f (some j) h
  let B := Function.update A (some j) (A (some j) ∩ U)
  have hUm : MeasurableSet U := measurableSet_coordinateMaxLevel j
    (measurable_const.indicator (hf none).1) τ
  have hgm : Measurable g := (hf (some j)).2.2.1.indicator hUm.compl
  have hhm : Measurable h := (hf (some j)).2.2.1.indicator hUm
  have hg0 (x : Fin d → ℝ) : 0 ≤ g x := by
    by_cases hx : x ∈ U <;> simp [g, hx, (hf (some j)).2.2.2.1 x]
  have hg1 (x : Fin d → ℝ) : g x ≤ (A (some j)).indicator (fun _ => 1) x := by
    by_cases hx : x ∈ U
    · simpa [g, hx] using (hf (some j)).2.2.2.1 x |>.trans ((hf (some j)).2.2.2.2 x)
    · simpa [g, hx] using (hf (some j)).2.2.2.2 x
  have hF : DyadicSupported A F := by
    have htemp := update_supported hf (some j) (hf (some j)).1 (hf (some j)).2.1 hgm hg0 hg1
    rwa [Function.update_eq_self] at htemp
  have hH : Integrable (f none) := memLp_one_iff_integrable.mp (by simpa using
    (lpNorm_le_of_indicator (hf none).1 (hf none).2.1 (hf none).2.2.1
      (hf none).2.2.2.1 (hf none).2.2.2.2 (show (0 : ℝ) < 1 by norm_num)).1)
  have hU := pruningSet_real_le j (hf none).1 (hf none).2.1 ha hK hh
  have hBtop : volume (A (some j) ∩ U) ≠ ⊤ :=
    ne_top_of_le_ne_top hU.1 (measure_mono inter_subset_right)
  have hBA : volume.real (A (some j) ∩ U) ≤ volume.real (A (some j)) / K :=
    (ENNReal.toReal_mono hU.1 (measure_mono inter_subset_right)).trans hU.2
  have hh01 := indicator_restrict_supported (U := U) (hf (some j)).2.2.2.1 (hf (some j)).2.2.2.2
  have hG : DyadicSupported B G :=
    update_supported hf (some j) ((hf (some j)).1.inter hUm) hBtop hhm hh01.1 hh01.2
  have hgh : (fun x => g x + h x) = f (some j) := by
    funext x
    by_cases hx : x ∈ U <;> simp [g, h, hx]
  have hlin := dyadicForm_update_add b u T c f j (fun i => (hf i).2.2.1)
    (supported_abs_le_one hf) hH hgm hhm
    (fun x => by simpa [F] using supported_abs_le_one hF (some j) x)
    (fun x => by simpa [G] using supported_abs_le_one hG (some j) x)
  dsimp only at hlin
  rw [hgh, Function.update_eq_self] at hlin
  refine ⟨hF, ?_⟩
  change |dyadicForm b u T c (f none) (fun i => f (some i)) -
    dyadicForm b u T c (F none) (fun i => F (some i))| ≤ _
  rw [hlin, add_sub_cancel_left]
  have hW := supportWeight_update_le A t (some j) (ht (some j)).le hK hBA
  have hC := (dyadicFormConstant_bounds b u T t ht hs).1
  exact (dyadicForm_le_constant b u T c hc t ht hs hG).trans
    ((mul_le_mul_of_nonneg_left hW hC).trans_eq (by ring))


/-- The summed form cost of pruning the input slots. The lower bound `m`
for their exponents can be chosen as their minimum. -/
theorem prune {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1) (t : Option (Fin d) → ℝ)
    (ht : ∀ i, 0 < t i) (hs : ∑ i, t i = 1)
    {A : Option (Fin d) → Set (Fin d → ℝ)} {f : Option (Fin d) → (Fin d → ℝ) → ℝ}
    (hf : DyadicSupported A f) {K m : ℝ} (hK : 1 < K) (hm : ∀ j, m ≤ t (some j))
    (hh : 0 < (volume : Measure (Fin d → ℝ)).real (A none))
    (ha : ∀ j, 0 < (volume : Measure (Fin d → ℝ)).real (A (some j))) :
    let τ (j : Fin d) := K * volume.real (A none) / volume.real (A (some j))
    let G (j : Fin d) := prunedInput j (A none) (τ j) (f (some j))
    DyadicSupported A (fun i => i.elim (f none) G) ∧
    |dyadicForm b u T c (f none) (fun j => f (some j)) - dyadicForm b u T c (f none) G| ≤
      d * K^(-m) * dyadicFormConstant b u T t * dyadicSupportWeight t A := by
  classical
  dsimp only
  let τ (j : Fin d) := K * (volume : Measure (Fin d → ℝ)).real (A none) / volume.real (A (some j))
  let G (j : Fin d) := prunedInput j (A none) (τ j) (f (some j))
  let F (s : Finset (Fin d)) (i : Option (Fin d)) :=
    i.elim (f none) (fun j => if j ∈ s then G j else f (some j))
  let L (g : Option (Fin d) → (Fin d → ℝ) → ℝ) :=
    dyadicForm b u T c (g none) (fun i => g (some i))
  let W := dyadicSupportWeight t A
  let C := dyadicFormConstant b u T t
  have hC : 0 ≤ C := (dyadicFormConstant_bounds b u T t ht hs).1
  have hW : 0 ≤ W := Finset.prod_nonneg fun _ _ => Real.rpow_nonneg ENNReal.toReal_nonneg _
  have h (s : Finset (Fin d)) :
      DyadicSupported A (F s) ∧ |L f - L (F s)| ≤ s.card * K^(-m) * C * W := by
    induction s using Finset.induction_on with
    | empty =>
      have hF : F ∅ = f := by
        funext i
        cases i <;> simp [F]
      simp [hF, hf]
    | @insert j s hj ih =>
      have hFj : F s (some j) = f (some j) := by simp [F, hj]
      have hupdate : F (insert j s) = Function.update (F s) (some j) (G j) := by
        funext i
        cases i with
        | none => simp [F]
        | some i =>
          by_cases hi : i = j
          · subst i; simp [F]
          · simp [F, hi]
      obtain ⟨hSup, hCost⟩ := dyadicForm_prune_one b u T c hc t ht hs ih.1 j
        (zero_lt_one.trans hK) hh (ha j)
      rw [hFj] at hSup hCost
      have hStep : |L (F s) - L (F (insert j s))| ≤ K^(-m) * C * W := by
        rw [hupdate]
        refine hCost.trans ?_
        exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
          (Real.rpow_le_rpow_of_exponent_le hK.le (neg_le_neg (hm j))) hC) hW
      refine ⟨by rw [hupdate]; exact hSup, ?_⟩
      refine (abs_sub_le _ (L (F s)) _).trans ((add_le_add ih.2 hStep).trans_eq ?_)
      rw [Finset.card_insert_of_notMem hj, Nat.cast_add, Nat.cast_one]
      ring
  simpa [L, F, G, W, C] using h (Finset.univ : Finset (Fin d))


/-- Coordinate interval probabilities on a dyadic rectangle. -/
noncomputable def dyadicIntervalProbability (k n : ℤ) : Measure ℝ :=
  (ENNReal.ofReal ((2 : ℝ)^(-k)))⁻¹ • volume.restrict (dyadicInterval k n)

instance dyadicIntervalProbability_isProbability (k n : ℤ) :
    IsProbabilityMeasure (dyadicIntervalProbability k n) := by
  have hL : 0 < (2 : ℝ)^(-k) := by positivity
  have hvol : volume (dyadicInterval k n) = ENNReal.ofReal ((2 : ℝ)^(-k)) := by
    unfold dyadicInterval
    rw [Real.volume_Ico]
    congr 1
    ring
  refine ⟨?_⟩
  rw [dyadicIntervalProbability, Measure.smul_apply, Measure.restrict_apply_univ, hvol,
    smul_eq_mul, ENNReal.inv_mul_cancel (ENNReal.ofReal_ne_zero_iff.mpr hL) ENNReal.ofReal_ne_top]

/-- The product of the normalized interval measures on a dyadic rectangle. -/
noncomputable def rectangleProbability {d : ℕ} (k n : Fin d → ℤ) :
    Measure (Fin d → ℝ) :=
  Measure.pi fun i => dyadicIntervalProbability (k i) (n i)

private abbrev ReflectedSamples {d : ℕ} (J : Finset (Fin d)) := Fin d ⊕ {i : Fin d // i ∈ J}

private noncomputable def reflectedSampleMeasure {d : ℕ} {J : Finset (Fin d)}
    (k n : Fin d → ℤ) : ReflectedSamples J → Measure ℝ :=
  Sum.elim (fun j => dyadicIntervalProbability (k j) (n j))
    (fun (j : {i : Fin d // i ∈ J}) => dyadicIntervalProbability (k j) (n j))

private instance {d : ℕ} {J : Finset (Fin d)} (k n : Fin d → ℤ) (i : ReflectedSamples J) :
    IsProbabilityMeasure (reflectedSampleMeasure k n i) := by
  cases i <;> exact dyadicIntervalProbability_isProbability _ _

/-- A reflected coordinate receives a second independent sample. -/
noncomputable def cornerProbability {d : ℕ} (J : Finset (Fin d)) (k n : Fin d → ℤ) :
    Measure ((Fin d ⊕ {i : Fin d // i ∈ J}) → ℝ) :=
  Measure.pi fun i => Sum.elim
    (fun j => dyadicIntervalProbability (k j) (n j))
    (fun (j : {i : Fin d // i ∈ J}) => dyadicIntervalProbability (k j) (n j)) i

/-- Sample index selected by the bits of a corner. -/
def cornerIndex {d : ℕ} (J : Finset (Fin d)) (ω : {i : Fin d // i ∈ J} → Bool) :
    Fin d ↪ (Fin d ⊕ {i : Fin d // i ∈ J}) where
  toFun i := if hi : i ∈ J then
    if ω ⟨i, hi⟩ then Sum.inr ⟨i, hi⟩ else Sum.inl i
    else Sum.inl i
  inj' := by
    intro i j h
    have hleft (l : Fin d) :
        Sum.elim id Subtype.val
          (if hl : l ∈ J then if ω ⟨l, hl⟩ then Sum.inr ⟨l, hl⟩ else Sum.inl l else Sum.inl l) = l := by
      split
      · split <;> rfl
      · rfl
    exact (hleft i).symm.trans ((congrArg (Sum.elim id Subtype.val) h).trans (hleft j))

/-- The corner selected from the independent rectangle samples. -/
def cornerPoint {d : ℕ} (J : Finset (Fin d)) (ω : {i : Fin d // i ∈ J} → Bool)
    (x : (Fin d ⊕ {i : Fin d // i ∈ J}) → ℝ) : Fin d → ℝ :=
  x ∘ cornerIndex J ω

private theorem probability_pi_map_embedding {ι κ : Type*} [Fintype ι] [Fintype κ]
    (e : ι ↪ κ) (μ : κ → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)] :
    MeasurePreserving (fun x : κ → ℝ => x ∘ e) (Measure.pi μ) (Measure.pi fun i => μ (e i)) := by
  classical
  have hm : Measurable (fun x : κ → ℝ => x ∘ e) :=
    Measurable.of_eval (fun i => measurable_pi_apply (e i))
  refine ⟨hm, Eq.symm (Measure.pi_eq fun s hs => ?_)⟩
  let t := Function.extend e s (fun _ => Set.univ)
  have ht (i : ι) : t (e i) = s i := e.injective.extend_apply s _ i
  have hrect : (fun x : κ → ℝ => x ∘ e) ⁻¹' Set.pi Set.univ s =
      ((Finset.univ.map e : Finset κ) : Set κ).pi t := by
    ext x
    constructor
    · intro hx j hj
      obtain ⟨i, _, rfl⟩ := Finset.mem_map.mp hj
      rw [ht]
      exact hx i (Set.mem_univ i)
    · intro hx i _
      have hh := hx (e i) (Finset.mem_map.mpr ⟨i, Finset.mem_univ _, rfl⟩)
      rwa [ht] at hh
  rw [Measure.map_apply hm (MeasurableSet.pi Set.countable_univ (fun i _ => hs i)),
    hrect, Measure.pi_pi_finset, Finset.prod_map]
  exact Finset.prod_congr rfl (fun i _ => by rw [ht])

/-- Each corner has normalized rectangle measure as its marginal. -/
theorem marginal {d : ℕ} (J : Finset (Fin d)) (k n : Fin d → ℤ)
    (ω : {i : Fin d // i ∈ J} → Bool) :
    MeasurePreserving (cornerPoint J ω) (cornerProbability J k n) (rectangleProbability k n) := by
  let μ (i : Fin d ⊕ {i : Fin d // i ∈ J}) :=
    Sum.elim (fun j => dyadicIntervalProbability (k j) (n j))
      (fun (j : {i : Fin d // i ∈ J}) => dyadicIntervalProbability (k j) (n j)) i
  have (i : Fin d ⊕ {i : Fin d // i ∈ J}) : IsProbabilityMeasure (μ i) := by
    cases i <;> exact dyadicIntervalProbability_isProbability _ _
  have h := probability_pi_map_embedding (cornerIndex J ω) μ
  have hμ : (fun i => μ (cornerIndex J ω i)) = fun i => dyadicIntervalProbability (k i) (n i) := by
    funext i
    change μ (if hi : i ∈ J then
      if ω ⟨i, hi⟩ then Sum.inr ⟨i, hi⟩ else Sum.inl i else Sum.inl i) = _
    repeat' (split <;> try rfl)
  rw [hμ] at h
  exact h


/-- A dyadic rectangle with one integer level and interval index per coordinate. -/
noncomputable def dyadicRectangle {d : ℕ} (k n : Fin d → ℤ) : Set (Fin d → ℝ) :=
  Set.univ.pi fun i => dyadicInterval (k i) (n i)

theorem measurableSet_dyadicRectangle {d : ℕ} (k n : Fin d → ℤ) :
    MeasurableSet (dyadicRectangle k n) :=
  MeasurableSet.pi Set.countable_univ (fun _ _ => measurableSet_Ico)

theorem volume_dyadicRectangle {d : ℕ} (k n : Fin d → ℤ) :
    volume (dyadicRectangle k n) = ∏ i, ENNReal.ofReal ((2 : ℝ)^(-k i)) := by
  rw [dyadicRectangle, volume_pi_pi]
  apply Finset.prod_congr rfl
  intro i _
  unfold dyadicInterval
  rw [Real.volume_Ico]
  congr 1
  ring

/-- The product interval probability is normalized Lebesgue measure on the rectangle. -/
theorem rectangleProbability_eq {d : ℕ} (k n : Fin d → ℤ) :
    rectangleProbability k n = (volume (dyadicRectangle k n))⁻¹ •
      volume.restrict (dyadicRectangle k n) := by
  apply Measure.pi_eq
  intro s hs
  rw [Measure.smul_apply, Measure.restrict_apply (MeasurableSet.pi Set.countable_univ (fun i _ => hs i))]
  rw [show Set.univ.pi s ∩ dyadicRectangle k n =
      Set.univ.pi (fun i => s i ∩ dyadicInterval (k i) (n i)) by
    ext x
    simp [dyadicRectangle, forall_and]]
  simp_rw [volume_dyadicRectangle, volume_pi_pi, dyadicIntervalProbability,
    Measure.smul_apply, Measure.restrict_apply (hs _), smul_eq_mul]
  rw [ENNReal.prod_inv_distrib, Finset.prod_mul_distrib]
  exact fun _ _ _ _ _ => Or.inr ENNReal.ofReal_ne_top

/-- Box average for an ambient tester and the low paths on the unreflected coordinates. -/
noncomputable def reflectedBox {d : ℕ} (J : Finset (Fin d)) (k n : Fin d → ℤ)
    (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ) : ℝ :=
  ∫ x, ∏ ω : ({i : Fin d // i ∈ J} → Bool),
    H (cornerPoint J ω x) * ∏ i ∈ Jᶜ, L i (k i) (cornerPoint J ω x) ∂cornerProbability J k n

/-- The box difference under averaging the two children in a marked coordinate. -/
noncomputable def reflectedBoxDifference {d : ℕ} (J : Finset (Fin d)) (j : Fin d)
    (k n : Fin d → ℤ) (H : (Fin d → ℝ) → ℝ)
    (L : Fin d → ℤ → (Fin d → ℝ) → ℝ) : ℝ :=
  let k' := Function.update k j (k j + 1)
  (reflectedBox J k' (Function.update n j (2*n j)) H L +
    reflectedBox J k' (Function.update n j (2*n j+1)) H L) / 2 - reflectedBox J k n H L

/-- The marked energy over a finite scale window and its countable rectangle grids. -/
noncomputable def markedEnergy {d : ℕ} (J : Finset (Fin d)) (u : ℤ) (T : ℕ)
    (H : ℕ → (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (ν : Fin d → Fin J.card) (j : {i : Fin d // i ∈ J}) : ℝ :=
  ∑ l ∈ Finset.range T,
    ∑' n : Fin d → ℤ,
      let k (i : Fin d) := u + (l : ℤ) + (ν i : ℕ)
      (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
        reflectedBoxDifference J j k n (H l) L

/-- The maximum over offsets and marked coordinates used in the reflected estimates. -/
noncomputable def energyDef {d : ℕ} (J : Finset (Fin d)) (u : ℤ) (T : ℕ)
    (H : ℕ → (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ) : ℝ :=
  sSup (Set.range (fun p : (Fin d → Fin J.card) × {i : Fin d // i ∈ J} =>
    markedEnergy J u T H L p.1 p.2))


instance cornerProbability_isProbability {d : ℕ} (J : Finset (Fin d)) (k n : Fin d → ℤ) :
    IsProbabilityMeasure (cornerProbability J k n) := by
  have hm := marginal J k n (fun _ => false)
  have hR : rectangleProbability k n Set.univ = 1 :=
    by rw [rectangleProbability, Measure.pi_univ]; simp
  refine ⟨?_⟩
  rw [← Set.preimage_univ (f := cornerPoint J fun _ => false), ← Measure.map_apply hm.measurable
    MeasurableSet.univ, hm.map_eq]
  exact hR

/-- Rectangles of one coordinate grid form a partition. -/
theorem iUnion_dyadicRectangle {d : ℕ} (k : Fin d → ℤ) :
    (⋃ n : Fin d → ℤ, dyadicRectangle k n) = Set.univ := by
  apply Set.eq_univ_of_forall
  intro x
  refine Set.mem_iUnion.mpr ⟨fun i => dyadicIndex (k i) (x i), ?_⟩
  intro i _
  exact mem_dyadicInterval_iff.mpr rfl

theorem pairwiseDisjoint_dyadicRectangle {d : ℕ} (k : Fin d → ℤ) :
    Pairwise (Disjoint on dyadicRectangle k) := by
  intro n m hnm
  apply Set.disjoint_left.mpr
  intro x hx hy
  apply hnm
  funext i
  exact (mem_dyadicInterval_iff.mp (hx i trivial)).symm.trans
    (mem_dyadicInterval_iff.mp (hy i trivial))

/-- A single central factor controls the absolute value of a box integral. -/
theorem abs_reflectedBox_le {d : ℕ} (J : Finset (Fin d)) (k n : Fin d → ℤ)
    (H : (Fin d → ℝ) → ℝ) (hHm : Measurable H) (hH0 : ∀ x, 0 ≤ H x) (hH1 : ∀ x, H x ≤ 1)
    (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (hL : ∀ i r x, |L i r x| ≤ 1) :
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      |reflectedBox J k n H L| ≤ ∫ x in dyadicRectangle k n, H x := by
  classical
  let ι := {i : Fin d // i ∈ J} → Bool
  let ω₀ : ι := fun _ => false
  let F (ω : ι) (x : (Fin d ⊕ {i : Fin d // i ∈ J}) → ℝ) :=
    H (cornerPoint J ω x) * ∏ i ∈ Jᶜ, L i (k i) (cornerPoint J ω x)
  have hF (ω : ι) (x : (Fin d ⊕ {i : Fin d // i ∈ J}) → ℝ) : |F ω x| ≤ H (cornerPoint J ω x) := by
    unfold F
    rw [abs_mul, abs_of_nonneg (hH0 _), Finset.abs_prod]
    exact mul_le_of_le_one_right (hH0 _) (Finset.prod_le_one₀ (fun _ _ => abs_nonneg _)
      (fun i _ => hL i (k i) _))
  have hp (x : (Fin d ⊕ {i : Fin d // i ∈ J}) → ℝ) :
      |∏ ω, F ω x| ≤ H (cornerPoint J ω₀ x) := by
    rw [Fintype.prod_eq_mul_prod_subtype_ne _ ω₀, abs_mul, Finset.abs_prod]
    exact (mul_le_of_le_one_right (abs_nonneg _) (Finset.prod_le_one₀
      (fun _ _ => abs_nonneg _) (fun (ω : {ω : ι // ω ≠ ω₀}) _ => (hF ω x).trans (hH1 _)))).trans (hF ω₀ x)
  have hm := marginal J k n ω₀
  have hhi : Integrable (fun x => H (cornerPoint J ω₀ x)) (cornerProbability J k n) :=
    (MemLp.of_bound (p := 1) (hHm.comp hm.measurable).aestronglyMeasurable 1
      (Filter.Eventually.of_forall fun x => by
        change ‖H (cornerPoint J ω₀ x)‖ ≤ 1
        rw [Real.norm_of_nonneg (hH0 _)]; exact hH1 _)).integrable le_rfl
  have h := (abs_integral_le_integral_abs (f := fun x => ∏ ω, F ω x)
    (μ := cornerProbability J k n)).trans (integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun _ => abs_nonneg _) hhi (Filter.Eventually.of_forall hp))
  have he := integral_map (μ := cornerProbability J k n) hm.measurable.aemeasurable (f := H) hHm.aestronglyMeasurable
  rw [hm.map_eq] at he
  rw [← he, rectangleProbability_eq, integral_smul_measure, ENNReal.toReal_inv, smul_eq_mul] at h
  let V := dyadicRectangle k n
  have hV : 0 < (volume : Measure (Fin d → ℝ)).real V := by
    rw [measureReal_def, volume_dyadicRectangle, ENNReal.toReal_prod]
    exact Finset.prod_pos (fun i _ => by rw [ENNReal.toReal_ofReal (by positivity)]; positivity)
  exact (le_inv_mul_iff₀ hV).mp h


private theorem realVolume_child_dyadicRectangle {d : ℕ} (j : Fin d) (k n : Fin d → ℤ)
    (r : ℤ) :
    (volume : Measure (Fin d → ℝ)).real
      (dyadicRectangle (Function.update k j (k j+1)) (Function.update n j r)) =
      volume.real (dyadicRectangle k n) / 2 := by
  have hvol (l m : Fin d → ℤ) :
      (volume : Measure (Fin d → ℝ)).real (dyadicRectangle l m) =
        ∏ i, (2 : ℝ)^(-l i) := by
    rw [measureReal_def, volume_dyadicRectangle, ENNReal.toReal_prod]
    apply Finset.prod_congr rfl
    intro i _
    exact ENNReal.toReal_ofReal (by positivity)
  rw [hvol, hvol, Fintype.prod_eq_mul_prod_subtype_ne _ j,
    Fintype.prod_eq_mul_prod_subtype_ne (fun i => (2 : ℝ)^(-k i)) j]
  have he : (∏ i : {i : Fin d // i ≠ j}, (2 : ℝ)^(-Function.update k j (k j+1) i)) =
      ∏ i : {i : Fin d // i ≠ j}, (2 : ℝ)^(-k i) := by
    apply Finset.prod_congr rfl
    intro i _
    rw [Function.update_of_ne i.property]
  rw [he, Function.update_self, neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_neg_one]
  ring

private theorem child_dyadicRectangle_subset {d : ℕ} (j : Fin d) (k n : Fin d → ℤ)
    {e : ℤ} (he : e = 0 ∨ e = 1) :
    dyadicRectangle (Function.update k j (k j+1)) (Function.update n j (2*n j+e)) ⊆
      dyadicRectangle k n := by
  intro x hx i _
  have hi := hx i trivial
  dsimp only at hi ⊢
  by_cases hij : i = j
  · subst i
    rw [Function.update_self, Function.update_self] at hi
    rw [← dyadicInterval_children]
    rcases he with rfl | rfl
    · exact Or.inl (by simpa only [add_zero] using hi)
    · exact Or.inr hi
  · simpa only [Function.update_of_ne hij] using hi

/-- Marked energy terms are absolutely summable at each grid level. -/
theorem summable_reflectedBoxDifference_grid {d : ℕ} (J : Finset (Fin d)) (j : Fin d)
    (k : Fin d → ℤ) (H : (Fin d → ℝ) → ℝ) (hHm : Measurable H)
    (hHi : Integrable H) (hH0 : ∀ x, 0 ≤ H x) (hH1 : ∀ x, H x ≤ 1)
    (L : Fin d → ℤ → (Fin d → ℝ) → ℝ) (hL : ∀ i r x, |L i r x| ≤ 1) :
    Summable (fun n : Fin d → ℤ => |(volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      reflectedBoxDifference J j k n H L|) := by
  let V := dyadicRectangle k
  have hsum : Summable (fun n : Fin d → ℤ => ∫ x in V n, H x) :=
    (hasSum_integral_iUnion (measurableSet_dyadicRectangle k) (pairwiseDisjoint_dyadicRectangle k)
      hHi.integrableOn).summable
  refine (hsum.mul_left 3).of_nonneg_of_le (fun _ => abs_nonneg _) (fun n => ?_)
  let k' := Function.update k j (k j+1)
  let n₀ := Function.update n j (2*n j)
  let n₁ := Function.update n j (2*n j+1)
  let v := (volume : Measure (Fin d → ℝ)).real (V n)
  let B := reflectedBox J k n H L
  let B₀ := reflectedBox J k' n₀ H L
  let B₁ := reflectedBox J k' n₁ H L
  let A := ∫ x in V n, H x
  have hv : 0 ≤ v := ENNReal.toReal_nonneg
  have hB : v * |B| ≤ A := abs_reflectedBox_le J k n H hHm hH0 hH1 L hL
  have hchild (e : ℤ) (he : e = 0 ∨ e = 1) :
      v/2 * |reflectedBox J k' (Function.update n j (2*n j+e)) H L| ≤ A := by
    have hc := abs_reflectedBox_le J k' (Function.update n j (2*n j+e)) H hHm hH0 hH1 L hL
    rw [realVolume_child_dyadicRectangle j k n] at hc
    exact hc.trans (setIntegral_mono_set hHi.integrableOn (Filter.Eventually.of_forall hH0)
      (Filter.Eventually.of_forall (child_dyadicRectangle_subset j k n he)))
  have h₀ : v/2 * |B₀| ≤ A := by simpa only [add_zero] using hchild 0 (Or.inl rfl)
  have h₁ : v/2 * |B₁| ≤ A := hchild 1 (Or.inr rfl)
  change |v * ((B₀+B₁)/2 - B)| ≤ 3*A
  rw [abs_mul, abs_of_nonneg hv]
  refine (mul_le_mul_of_nonneg_left (abs_sub _ _) hv).trans ?_
  rw [abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  have hab := abs_add_le B₀ B₁
  have h := mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right hab (by norm_num : (0 : ℝ) ≤ 2)) hv
  nlinarith


private theorem dyadicIntervalProbability_children (k n : ℤ) :
    dyadicIntervalProbability k n =
      (2 : ℝ≥0∞)⁻¹ • (dyadicIntervalProbability (k+1) (2*n) +
        dyadicIntervalProbability (k+1) (2*n+1)) := by
  have hl : 0 < (2 : ℝ)^(-k) := by positivity
  have hlength : (2 : ℝ)^(-(k+1)) = (2 : ℝ)^(-k) / 2 := by
    rw [neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_neg_one, div_eq_mul_inv]
  have hcoeff : (2 : ℝ≥0∞)⁻¹ * (ENNReal.ofReal ((2 : ℝ)^(-(k+1))))⁻¹ =
      (ENNReal.ofReal ((2 : ℝ)^(-k)))⁻¹ := by
    rw [hlength, div_eq_mul_inv, ENNReal.ofReal_mul hl.le,
      ENNReal.ofReal_inv_of_pos (by norm_num : (0 : ℝ) < 2), ENNReal.ofReal_ofNat,
      ENNReal.mul_inv (Or.inr (by norm_num)) (Or.inl ENNReal.ofReal_ne_top), inv_inv]
    calc
      _ = ((2 : ℝ≥0∞)⁻¹ * 2) * (ENNReal.ofReal ((2 : ℝ)^(-k)))⁻¹ := by ac_rfl
      _ = _ := by rw [ENNReal.inv_mul_cancel (by norm_num) (by norm_num), one_mul]
  have hdisj := pairwiseDisjoint_dyadicInterval (k+1) (show 2*n ≠ 2*n+1 by omega)
  simp only [dyadicIntervalProbability, smul_add, smul_smul, hcoeff]
  rw [← smul_add, ← Measure.restrict_union hdisj measurableSet_Ico, dyadicInterval_children]

private theorem dyadicIntervalProbability_integral_children (k n : ℤ)
    (f : ℝ → ℝ) (hm : Measurable f) {C : ℝ} (hC : ∀ x, |f x| ≤ C) :
    (∫ x, f x ∂dyadicIntervalProbability k n) =
      ((∫ x, f x ∂dyadicIntervalProbability (k+1) (2*n)) +
        (∫ x, f x ∂dyadicIntervalProbability (k+1) (2*n+1))) / 2 := by
  have hi (l m : ℤ) : Integrable f (dyadicIntervalProbability l m) :=
    (MemLp.of_bound (p := 1) hm.aestronglyMeasurable C
      (Filter.Eventually.of_forall fun x => hC x)).integrable le_rfl
  rw [dyadicIntervalProbability_children k n, integral_smul_measure,
    integral_add_measure (hi _ _) (hi _ _), ENNReal.toReal_inv, ENNReal.toReal_ofNat,
    smul_eq_mul, mul_comm, ← div_eq_mul_inv]

private abbrev PairSpectators {S : Type*} (a b : S) := {s : S // s ≠ a ∧ s ≠ b}

private noncomputable def insertPairSamples {S : Type*} [DecidableEq S]
    (a b : S) (z : PairSpectators a b → ℝ) (r t : ℝ) (i : S) : ℝ :=
  if ha : i = a then r else if hb : i = b then t else z ⟨i, ha, hb⟩

private theorem insertPairSamples_measurable {S : Type*} [DecidableEq S] (a b : S) :
    Measurable (fun x : (PairSpectators a b → ℝ) × (ℝ × ℝ) =>
      insertPairSamples a b x.1 x.2.1 x.2.2) := by
  apply Measurable.of_eval
  intro i
  by_cases ha : i = a
  · simpa [insertPairSamples, ha, Function.comp_def] using
      (measurable_fst.comp measurable_snd : Measurable (fun x : (PairSpectators a b → ℝ) × (ℝ × ℝ) => x.2.1))
  by_cases hb : i = b
  · subst i
    simpa [insertPairSamples, ha, Function.comp_def] using
      (measurable_snd.comp measurable_snd : Measurable (fun x : (PairSpectators a b → ℝ) × (ℝ × ℝ) => x.2.2))
  · simpa [insertPairSamples, ha, hb, Function.comp_def] using (measurable_pi_apply (⟨i, ha, hb⟩ : PairSpectators a b)).comp
      (measurable_fst : Measurable (fun x : (PairSpectators a b → ℝ) × (ℝ × ℝ) => x.1))

private theorem insertPairSamples_measurePreserving {S : Type*} [Fintype S] [DecidableEq S]
    (a b : S) (hab : a ≠ b) (μ : S → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)] :
    let ν := Measure.pi (fun i : PairSpectators a b => μ i)
    MeasurePreserving (fun x : (PairSpectators a b → ℝ) × (ℝ × ℝ) =>
      insertPairSamples a b x.1 x.2.1 x.2.2) (ν.prod ((μ a).prod (μ b))) (Measure.pi μ) := by
  classical
  dsimp only
  let ι := PairSpectators a b
  let e (x : (ι → ℝ) × (ℝ × ℝ)) := insertPairSamples a b x.1 x.2.1 x.2.2
  have hm : Measurable e := insertPairSamples_measurable a b
  refine ⟨hm, (Measure.pi_eq fun s hs => ?_).symm⟩
  have hrect : e ⁻¹' Set.univ.pi s =
      (Set.univ.pi fun i : ι => s i) ×ˢ (s a ×ˢ s b) := by
    ext x
    constructor
    · intro hx
      refine ⟨fun i _ => ?_, ?_, ?_⟩
      · simpa [e, insertPairSamples, i.property.1, i.property.2] using hx i trivial
      · simpa [e, insertPairSamples] using hx a trivial
      · simpa [e, insertPairSamples, hab.symm] using hx b trivial
    · intro hx i _
      rcases hx with ⟨hz, hr, ht⟩
      by_cases ha : i = a
      · subst i; simpa [e, insertPairSamples] using hr
      by_cases hb : i = b
      · subst i; simpa [e, insertPairSamples, hab.symm] using ht
      · simpa [e, insertPairSamples, ha, hb] using hz (⟨i, ha, hb⟩ : ι) trivial
  rw [Measure.map_apply hm (MeasurableSet.pi Set.countable_univ fun i _ => hs i),
    hrect, Measure.prod_prod, Measure.prod_prod, Measure.pi_pi]
  rw [Fintype.prod_eq_mul_prod_subtype_ne (fun i => μ i (s i)) a,
    Fintype.prod_eq_mul_prod_subtype_ne (fun i : {i : S // i ≠ a} => μ i (s i))
      (⟨b, hab.symm⟩ : {i : S // i ≠ a})]
  let hE : ι ≃ {i : {i : S // i ≠ a} // i ≠ (⟨b, hab.symm⟩ : {i : S // i ≠ a})} := {
    toFun i := ⟨⟨i, i.property.1⟩, fun h => i.property.2 (congrArg Subtype.val h)⟩
    invFun i := ⟨i.1, i.1.property, fun h => i.property (Subtype.ext h)⟩
    left_inv _ := rfl
    right_inv _ := rfl }
  rw [← hE.prod_comp (fun i => μ i.1.1 (s i.1.1))]
  simp only [hE, Equiv.coe_fn_mk]
  ac_rfl


private noncomputable def reflectedHalfProduct {d : ℕ} (J : Finset (Fin d))
    (j : {i : Fin d // i ∈ J}) (k : Fin d → ℤ) (H : (Fin d → ℝ) → ℝ)
    (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (z : PairSpectators (Sum.inl (j : Fin d) : ReflectedSamples J) (Sum.inr j) → ℝ)
    (y : ℝ) : ℝ :=
  ∏ η : ({i : {i : Fin d // i ∈ J} // i ≠ j} → Bool),
    let x := cornerPoint J ((Equiv.funSplitAt j Bool).symm (false, η))
      (insertPairSamples (Sum.inl (j : Fin d)) (Sum.inr j) z y y)
    H x * ∏ i ∈ Jᶜ, L i (k i) x

private theorem cornerPoint_insertPair_eq {d : ℕ} (J : Finset (Fin d))
    (j : {i : Fin d // i ∈ J})
    (η : {i : {i : Fin d // i ∈ J} // i ≠ j} → Bool) (ε : Bool)
    (z : PairSpectators (Sum.inl (j : Fin d) : ReflectedSamples J) (Sum.inr j) → ℝ)
    (r t : ℝ) :
    let y := if ε then t else r
    cornerPoint J ((Equiv.funSplitAt j Bool).symm (ε, η))
      (insertPairSamples (Sum.inl (j : Fin d)) (Sum.inr j) z r t) =
    cornerPoint J ((Equiv.funSplitAt j Bool).symm (false, η))
      (insertPairSamples (Sum.inl (j : Fin d)) (Sum.inr j) z y y) := by
  dsimp only
  funext i
  by_cases h : i = (j : Fin d)
  · subst i
    have hj : (j : Fin d) ∈ J := j.property
    cases ε <;> simp [cornerPoint, cornerIndex, hj, Equiv.funSplitAt, Equiv.piSplitAt,
      insertPairSamples]
  · have hre (p : i ∈ J) : (⟨i, p⟩ : {i : Fin d // i ∈ J}) ≠ j :=
      fun he => h (congrArg Subtype.val he)
    by_cases hJ : i ∈ J
    · have hh : η ⟨⟨i, hJ⟩, hre hJ⟩ = true ∨ η ⟨⟨i, hJ⟩, hre hJ⟩ = false := by
        cases η ⟨⟨i, hJ⟩, hre hJ⟩ <;> simp
      rcases hh with hh | hh <;>
        simp [cornerPoint, cornerIndex, hJ, Equiv.funSplitAt, Equiv.piSplitAt, hre hJ,
          insertPairSamples, hh, h]
    · simp [cornerPoint, cornerIndex, hJ, insertPairSamples, h]

private theorem reflectedBox_pair_product {d : ℕ} (J : Finset (Fin d))
    (j : {i : Fin d // i ∈ J}) (k : Fin d → ℤ) (H : (Fin d → ℝ) → ℝ)
    (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (z : PairSpectators (Sum.inl (j : Fin d) : ReflectedSamples J) (Sum.inr j) → ℝ)
    (r t : ℝ) :
    (∏ ω : ({i : Fin d // i ∈ J} → Bool),
      let x := cornerPoint J ω (insertPairSamples (Sum.inl (j : Fin d)) (Sum.inr j) z r t)
      H x * ∏ i ∈ Jᶜ, L i (k i) x) =
      reflectedHalfProduct J j k H L z r * reflectedHalfProduct J j k H L z t := by
  classical
  let F (ω : {i : Fin d // i ∈ J} → Bool) :=
    let x := cornerPoint J ω (insertPairSamples (Sum.inl (j : Fin d)) (Sum.inr j) z r t)
    H x * ∏ i ∈ Jᶜ, L i (k i) x
  change (∏ ω, F ω) = _
  rw [← (Equiv.funSplitAt j Bool).symm.prod_comp F, Fintype.prod_prod_type, Fintype.prod_bool]
  have h (ε : Bool) : (∏ η, F ((Equiv.funSplitAt j Bool).symm (ε, η))) =
      reflectedHalfProduct J j k H L z (if ε then t else r) := by
    unfold reflectedHalfProduct
    apply Finset.prod_congr rfl
    intro η _
    unfold F
    rw [cornerPoint_insertPair_eq J j η ε z r t]
  rw [h true, h false]
  simp only [Bool.false_eq_true, ite_false, ite_true]
  exact mul_comm _ _


private theorem reflectedHalfProduct_measurable {d : ℕ} (J : Finset (Fin d))
    (j : {i : Fin d // i ∈ J}) (k : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ}
    (hHm : Measurable H) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l)) :
    Measurable (fun p : (PairSpectators (Sum.inl (j : Fin d) : ReflectedSamples J)
      (Sum.inr j) → ℝ) × ℝ => reflectedHalfProduct J j k H L p.1 p.2) := by
  classical
  unfold reflectedHalfProduct
  apply Finset.measurable_fun_prod
  intro η _
  have he := insertPairSamples_measurable (Sum.inl (j : Fin d) : ReflectedSamples J) (Sum.inr j)
  have hd : Measurable (fun p : (PairSpectators (Sum.inl (j : Fin d) : ReflectedSamples J)
      (Sum.inr j) → ℝ) × ℝ => (p.1, (p.2, p.2))) :=
    measurable_fst.prodMk (measurable_snd.prodMk measurable_snd)
  have hp := (marginal J k k ((Equiv.funSplitAt j Bool).symm (false, η))).measurable.comp
    (he.comp hd)
  exact (hHm.comp hp).mul (Finset.measurable_fun_prod _ fun i _ => (hLm i (k i)).comp hp)

private theorem abs_reflectedHalfProduct_le {d : ℕ} (J : Finset (Fin d))
    (j : {i : Fin d // i ∈ J}) (k : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ}
    (hH : ∀ x, |H x| ≤ 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hL : ∀ i l x, |L i l x| ≤ 1)
    (z : PairSpectators (Sum.inl (j : Fin d) : ReflectedSamples J) (Sum.inr j) → ℝ) (y : ℝ) :
    |reflectedHalfProduct J j k H L z y| ≤ 1 := by
  classical
  unfold reflectedHalfProduct
  rw [Finset.abs_prod]
  apply Finset.prod_le_one₀ (fun _ _ => abs_nonneg _)
  intro η _
  dsimp only
  rw [abs_mul, Finset.abs_prod]
  exact (mul_le_of_le_one_right (abs_nonneg _) (Finset.prod_le_one₀
    (fun _ _ => abs_nonneg _) (fun i _ => hL i (k i) _))).trans (hH _)

private noncomputable def reflectedSpectatorMeasure {d : ℕ} (J : Finset (Fin d))
    (j : {i : Fin d // i ∈ J}) (k n : Fin d → ℤ) :
    Measure (PairSpectators (Sum.inl (j : Fin d) : ReflectedSamples J) (Sum.inr j) → ℝ) :=
  Measure.pi (fun i => reflectedSampleMeasure k n (i : ReflectedSamples J))

private instance {d : ℕ} (J : Finset (Fin d)) (j : {i : Fin d // i ∈ J}) (k n : Fin d → ℤ) :
    IsProbabilityMeasure (reflectedSpectatorMeasure J j k n) := by
  unfold reflectedSpectatorMeasure
  infer_instance

private theorem reflectedBox_integral_sq {d : ℕ} (J : Finset (Fin d))
    (j : {i : Fin d // i ∈ J}) (k n : Fin d → ℤ)
    {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H) (hH : ∀ x, |H x| ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l)) (hL : ∀ i l x, |L i l x| ≤ 1) :
    reflectedBox J k n H L =
      ∫ z, (∫ y, reflectedHalfProduct J j k H L z y
        ∂dyadicIntervalProbability (k j) (n j))^2 ∂reflectedSpectatorMeasure J j k n := by
  classical
  let a : ReflectedSamples J := Sum.inl (j : Fin d)
  let b : ReflectedSamples J := Sum.inr j
  let μ := dyadicIntervalProbability (k j) (n j)
  let ν := reflectedSpectatorMeasure J j k n
  let Z := PairSpectators a b → ℝ
  let e (x : Z × (ℝ × ℝ)) := insertPairSamples a b x.1 x.2.1 x.2.2
  let C := reflectedHalfProduct J j k H L
  have hp : MeasurePreserving e (ν.prod (μ.prod μ)) (cornerProbability J k n) :=
    insertPairSamples_measurePreserving a b (by simp [a, b]) (reflectedSampleMeasure k n)
  let F (x : ReflectedSamples J → ℝ) := ∏ ω : ({i : Fin d // i ∈ J} → Bool),
    H (cornerPoint J ω x) * ∏ i ∈ Jᶜ, L i (k i) (cornerPoint J ω x)
  have hFm : Measurable F := Finset.measurable_fun_prod _ fun ω _ =>
    let hm := (marginal J k n ω).measurable
    (hHm.comp hm).mul (Finset.measurable_fun_prod _ fun i _ => (hLm i (k i)).comp hm)
  have hmap := integral_map (μ := ν.prod (μ.prod μ)) hp.measurable.aemeasurable
    (f := F) hFm.aestronglyMeasurable
  rw [hp.map_eq] at hmap
  change (∫ x, F x ∂cornerProbability J k n) = _
  rw [hmap]
  have he (p : Z × (ℝ × ℝ)) : F (e p) = C p.1 p.2.1 * C p.1 p.2.2 :=
    reflectedBox_pair_product J j k H L p.1 p.2.1 p.2.2
  have hbound (p : Z × (ℝ × ℝ)) : |F (e p)| ≤ 1 := by
    rw [he, abs_mul]
    exact (mul_le_of_le_one_right (abs_nonneg _)
      (abs_reflectedHalfProduct_le J j k hH hL _ _)).trans
      (abs_reflectedHalfProduct_le J j k hH hL _ _)
  have hi : Integrable (fun x => F (e x)) (ν.prod (μ.prod μ)) := by
    let _ : IsProbabilityMeasure μ := dyadicIntervalProbability_isProbability _ _
    let _ : IsProbabilityMeasure ν := inferInstanceAs (IsProbabilityMeasure (reflectedSpectatorMeasure J j k n))
    exact (MemLp.of_bound (p := 1) (hFm.comp hp.measurable).aestronglyMeasurable 1
      (Filter.Eventually.of_forall hbound)).integrable le_rfl
  rw [integral_prod _ hi]
  apply integral_congr_ae
  filter_upwards with z
  simp_rw [he]
  rw [integral_prod_mul, pow_two]


private theorem reflectedSpectatorMeasure_update {d : ℕ} (J : Finset (Fin d))
    (j : {i : Fin d // i ∈ J}) (k n : Fin d → ℤ) (l r : ℤ) :
    reflectedSpectatorMeasure J j (Function.update k j l) (Function.update n j r) =
      reflectedSpectatorMeasure J j k n := by
  unfold reflectedSpectatorMeasure
  congr 1
  funext i
  obtain ⟨i, hi, hi'⟩ := i
  cases i with
  | inl i =>
    have h : i ≠ (j : Fin d) := fun h => hi (congrArg Sum.inl h)
    simp [reflectedSampleMeasure, Function.update_of_ne h]
  | inr i =>
    have h : (i : Fin d) ≠ (j : Fin d) := fun h => hi' (congrArg Sum.inr (Subtype.ext h))
    simp [reflectedSampleMeasure, Function.update_of_ne h]

private theorem reflectedHalfProduct_update {d : ℕ} (J : Finset (Fin d))
    (j : {i : Fin d // i ∈ J}) (k : Fin d → ℤ) (l : ℤ)
    (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ) :
    reflectedHalfProduct J j (Function.update k j l) H L = reflectedHalfProduct J j k H L := by
  classical
  funext z y
  unfold reflectedHalfProduct
  apply Finset.prod_congr rfl
  intro η _
  dsimp only
  congr 1
  apply Finset.prod_congr rfl
  intro i hi
  have h : i ≠ (j : Fin d) := fun h => (Finset.mem_compl.mp hi) (h ▸ j.property)
  rw [Function.update_of_ne h]

private theorem reflectedBoxDifference_integral_sq {d : ℕ} (J : Finset (Fin d)) (j : {i : Fin d // i ∈ J})
    (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH : ∀ x, |H x| ≤ 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l)) (hL : ∀ i l x, |L i l x| ≤ 1) :
    reflectedBoxDifference J j k n H L =
      ∫ z, (((∫ y, reflectedHalfProduct J j k H L z y ∂dyadicIntervalProbability ((k j)+1) (2*n j)) -
        (∫ y, reflectedHalfProduct J j k H L z y ∂dyadicIntervalProbability ((k j)+1) (2*n j+1))) / 2)^2
          ∂reflectedSpectatorMeasure J j k n := by
  let C := reflectedHalfProduct J j k H L
  let ν := reflectedSpectatorMeasure J j k n
  let Z := PairSpectators (Sum.inl (j : Fin d) : ReflectedSamples J) (Sum.inr j) → ℝ
  let m (l r : ℤ) (z : Z) := ∫ y, C z y ∂dyadicIntervalProbability l r
  let l := k j
  let r := n j
  have hp : reflectedBox J k n H L = ∫ z, (m l r z)^2 ∂ν :=
    reflectedBox_integral_sq J j k n hHm hH hLm hL
  have hchild (a : ℤ) :
      reflectedBox J (Function.update k j (l+1)) (Function.update n j a) H L =
        ∫ z, (m (l+1) a z)^2 ∂ν := by
    rw [reflectedBox_integral_sq J j _ _ hHm hH hLm hL,
      reflectedSpectatorMeasure_update, reflectedHalfProduct_update, Function.update_self,
      Function.update_self]
  have hCm : Measurable (fun p : Z × ℝ => C p.1 p.2) :=
    reflectedHalfProduct_measurable J j k hHm hLm
  have hmi (a b : ℤ) : Integrable (fun z => (m a b z)^2) ν := by
    let _ : IsProbabilityMeasure ν :=
      inferInstanceAs (IsProbabilityMeasure (reflectedSpectatorMeasure J j k n))
    have hMe : Measurable (m a b) :=
      (hCm.stronglyMeasurable.integral_prod_right' (ν := dyadicIntervalProbability a b)).measurable
    apply (MemLp.of_bound (p := 1) (hMe.pow_const 2).aestronglyMeasurable 1 ?_).integrable le_rfl
    filter_upwards with z
    simp only [Real.norm_eq_abs, abs_pow]
    have hV := norm_integral_le_of_norm_le_const (μ := dyadicIntervalProbability a b)
      (C := 1) (f := C z) (Filter.Eventually.of_forall fun y => by
        rw [Real.norm_eq_abs]
        exact abs_reflectedHalfProduct_le J j k hH hL z y)
    have hV' : |m a b z| ≤ 1 := by simpa [m, measureReal_def] using hV
    exact pow_le_one₀ (abs_nonneg _) hV'
  have hmeans (z : Z) : m l r z = (m (l+1) (2*r) z + m (l+1) (2*r+1) z)/2 :=
    dyadicIntervalProbability_integral_children l r (C z)
      (hCm.comp (measurable_const.prodMk measurable_id))
      (abs_reflectedHalfProduct_le J j k hH hL z)
  unfold reflectedBoxDifference
  dsimp only
  rw [hchild (2*r), hchild (2*r+1), hp,
    ← integral_add (hmi _ _) (hmi _ _), div_eq_mul_inv, mul_comm _ ((2 : ℝ)⁻¹),
    ← integral_const_mul]
  have hmi2 : Integrable (fun z => (2 : ℝ)⁻¹ *
      ((m (l+1) (2*r) z)^2 + (m (l+1) (2*r+1) z)^2)) ν :=
    ((hmi (l+1) (2*r)).add (hmi (l+1) (2*r+1))).const_mul _
  rw [← integral_sub hmi2 (hmi l r)]
  apply integral_congr_ae
  filter_upwards with z
  change (2 : ℝ)⁻¹ * ((m (l+1) (2*r) z)^2 + (m (l+1) (2*r+1) z)^2) - (m l r z)^2 =
    ((m (l+1) (2*r) z - m (l+1) (2*r+1) z) / 2)^2
  rw [hmeans]
  ring

/-- A reflected box and every derivative in a reflected coordinate are nonnegative. -/
theorem boxSquare {d : ℕ} (J : Finset (Fin d)) (j : {i : Fin d // i ∈ J})
    (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH : ∀ x, |H x| ≤ 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l)) (hL : ∀ i l x, |L i l x| ≤ 1) :
    0 ≤ reflectedBox J k n H L ∧ 0 ≤ reflectedBoxDifference J j k n H L := by
  constructor
  · rw [reflectedBox_integral_sq J j k n hHm hH hLm hL]
    exact integral_nonneg fun _ => sq_nonneg _
  · rw [reflectedBoxDifference_integral_sq J j k n hHm hH hLm hL]
    exact integral_nonneg fun _ => sq_nonneg _


private theorem integral_dyadicHaar_probability {k n : ℤ} (f : ℝ → ℝ) (hm : Measurable f)
    {C : ℝ} (hC : ∀ x, |f x| ≤ C) :
    (∫ y, dyadicHaar k n y * f y ∂dyadicIntervalProbability k n) =
      ((∫ y, f y ∂dyadicIntervalProbability (k+1) (2*n)) -
        (∫ y, f y ∂dyadicIntervalProbability (k+1) (2*n+1))) / 2 := by
  let I := dyadicInterval (k+1) (2*n)
  let J := dyadicInterval (k+1) (2*n+1)
  let F (y : ℝ) := dyadicHaar k n y * f y
  have hI : MeasurableSet I := measurableSet_Ico
  have hJ : MeasurableSet J := measurableSet_Ico
  have hd : Disjoint I J := pairwiseDisjoint_dyadicInterval (k+1) (by omega : 2*n ≠ 2*n+1)
  have hFi (l m : ℤ) : Integrable F (dyadicIntervalProbability l m) := by
    have hmH : Measurable (dyadicHaar k n) :=
      (measurable_const.indicator hI).sub (measurable_const.indicator hJ)
    apply (MemLp.of_bound (p := 1) (hmH.mul hm).aestronglyMeasurable (2*C) ?_).integrable le_rfl
    filter_upwards with y
    change |dyadicHaar k n y * f y| ≤ _
    rw [abs_mul]
    have hh : |dyadicHaar k n y| ≤ 2 := by
      unfold dyadicHaar
      by_cases hi : y ∈ I <;> by_cases hj : y ∈ J <;> norm_num [hi, hj, I, J] at *
    exact mul_le_mul hh (hC y) (abs_nonneg _) (by norm_num)
  have hLeft : (∫ y, F y ∂dyadicIntervalProbability (k+1) (2*n)) =
      ∫ y, f y ∂dyadicIntervalProbability (k+1) (2*n) := by
    simp only [dyadicIntervalProbability, integral_smul_measure]
    congr 1
    apply setIntegral_congr_fun hI
    intro y hy
    have hn : y ∉ J := fun hj => Set.disjoint_left.mp hd hy hj
    unfold F dyadicHaar
    rw [indicator_of_mem hy, indicator_of_notMem hn, sub_zero, one_mul]
  have hRight : (∫ y, F y ∂dyadicIntervalProbability (k+1) (2*n+1)) =
      -(∫ y, f y ∂dyadicIntervalProbability (k+1) (2*n+1)) := by
    rw [← integral_neg]
    simp only [dyadicIntervalProbability, integral_smul_measure]
    congr 1
    apply setIntegral_congr_fun hJ
    intro y hy
    have hn : y ∉ I := fun hi => Set.disjoint_left.mp hd hi hy
    unfold F dyadicHaar
    rw [indicator_of_notMem hn, indicator_of_mem hy, zero_sub, neg_one_mul]
  change (∫ y, F y ∂dyadicIntervalProbability k n) = _
  rw [dyadicIntervalProbability_children k n, integral_smul_measure,
    integral_add_measure (hFi _ _) (hFi _ _), hLeft, hRight,
    ENNReal.toReal_inv, ENNReal.toReal_ofNat, smul_eq_mul]
  ring

private abbrev singletonMark {d : ℕ} (b : Fin d) : {i : Fin d // i ∈ ({b} : Finset (Fin d))} :=
  ⟨b, Finset.mem_singleton_self b⟩

private abbrev SingletonSpectators {d : ℕ} (b : Fin d) :=
  PairSpectators (Sum.inl b : ReflectedSamples {b}) (Sum.inr (singletonMark b))

private noncomputable def singletonCorner {d : ℕ} (b : Fin d)
    (z : SingletonSpectators b → ℝ) (y : ℝ) : Fin d → ℝ :=
  cornerPoint {b} (fun _ => false) (insertPairSamples (Sum.inl b) (Sum.inr (singletonMark b)) z y y)

private theorem singletonCorner_self {d : ℕ} (b : Fin d) (z : SingletonSpectators b → ℝ) (y : ℝ) :
    singletonCorner b z y b = y := by
  simp [singletonCorner, cornerPoint, cornerIndex, insertPairSamples]

private theorem singletonCorner_update {d : ℕ} (b : Fin d) (z : SingletonSpectators b → ℝ)
    (y t : ℝ) : Function.update (singletonCorner b z y) b t = singletonCorner b z t := by
  funext i
  by_cases hi : i = b
  · subst i
    rw [Function.update_self, singletonCorner_self]
  · simp [singletonCorner, cornerPoint, cornerIndex, insertPairSamples, hi]

private theorem reflectedHalfProduct_singleton {d : ℕ} (b : Fin d) (k : Fin d → ℤ)
    (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (z : SingletonSpectators b → ℝ) (y : ℝ) :
    reflectedHalfProduct {b} (singletonMark b) k H L z y =
      H (singletonCorner b z y) * ∏ i ∈ ({b} : Finset (Fin d))ᶜ, L i (k i) (singletonCorner b z y) := by
  classical
  have hEmpty : IsEmpty {i : {i : Fin d // i ∈ ({b} : Finset (Fin d))} // i ≠ singletonMark b} :=
    ⟨fun i => i.property (Subtype.ext (Finset.mem_singleton.mp i.val.property))⟩
  unfold reflectedHalfProduct
  rw [Fintype.prod_unique]
  have he (η : {i : {i : Fin d // i ∈ ({b} : Finset (Fin d))} // i ≠ singletonMark b} → Bool) :
      (Equiv.funSplitAt (singletonMark b) Bool).symm (false, η) = fun _ => false := by
    funext i
    have hi : i = singletonMark b := Subtype.ext (Finset.mem_singleton.mp i.property)
    simp [hi, Equiv.funSplitAt, Equiv.piSplitAt]
  dsimp only
  rw [he]
  rfl


private theorem singletonCorner_integral {d : ℕ} (b : Fin d) (k n : Fin d → ℤ)
    (g : (Fin d → ℝ) → ℝ) (hgm : Measurable g) {C : ℝ} (hg : ∀ x, |g x| ≤ C) :
    (∫ x, g x ∂rectangleProbability k n) =
      ∫ z, ∫ y, g (singletonCorner b z y) ∂dyadicIntervalProbability (k b) (n b)
        ∂reflectedSpectatorMeasure {b} (singletonMark b) k n := by
  classical
  let a : ReflectedSamples {b} := Sum.inl b
  let a' : ReflectedSamples {b} := Sum.inr (singletonMark b)
  let μ := dyadicIntervalProbability (k b) (n b)
  let ν := reflectedSpectatorMeasure {b} (singletonMark b) k n
  let Z := SingletonSpectators b → ℝ
  let e (x : Z × (ℝ × ℝ)) := insertPairSamples a a' x.1 x.2.1 x.2.2
  let _ : IsProbabilityMeasure μ := dyadicIntervalProbability_isProbability _ _
  let _ : IsProbabilityMeasure ν :=
    inferInstanceAs (IsProbabilityMeasure (reflectedSpectatorMeasure {b} (singletonMark b) k n))
  have hp : MeasurePreserving e (ν.prod (μ.prod μ)) (cornerProbability {b} k n) :=
    insertPairSamples_measurePreserving a a' (by simp [a, a']) (reflectedSampleMeasure k n)
  let ω : {i : Fin d // i ∈ ({b} : Finset (Fin d))} → Bool := fun _ => false
  let φ := cornerPoint {b} ω ∘ e
  have hφ : MeasurePreserving φ (ν.prod (μ.prod μ)) (rectangleProbability k n) :=
    (marginal {b} k n ω).comp hp
  have hmap := integral_map (μ := ν.prod (μ.prod μ)) hφ.measurable.aemeasurable
    (f := g) hgm.aestronglyMeasurable
  rw [hφ.map_eq] at hmap
  rw [hmap]
  have hi : Integrable (fun x => g (φ x)) (ν.prod (μ.prod μ)) :=
    (MemLp.of_bound (p := 1) (hgm.comp hφ.measurable).aestronglyMeasurable C
      (Filter.Eventually.of_forall fun x => hg (φ x))).integrable le_rfl
  rw [integral_prod _ hi]
  apply integral_congr_ae
  filter_upwards with z
  have hh (r t : ℝ) : φ (z, (r, t)) = singletonCorner b z r := by
    funext i
    by_cases h : i = b <;> simp [φ, ω, e, a, a', singletonCorner, cornerPoint,
      cornerIndex, insertPairSamples, h]
  simp_rw [hh]
  have hprod := integral_prod_mul (μ := μ) (ν := μ) (fun y => g (singletonCorner b z y))
    (fun _ : ℝ => (1 : ℝ))
  simpa only [mul_one, integral_const, measureReal_def, measure_univ, ENNReal.toReal_one,
    smul_eq_mul, one_mul] using hprod

private theorem singletonCorner_measurable {d : ℕ} (b : Fin d) :
    Measurable (fun p : (SingletonSpectators b → ℝ) × ℝ => singletonCorner b p.1 p.2) := by
  let Z := SingletonSpectators b → ℝ
  have he := insertPairSamples_measurable (Sum.inl b : ReflectedSamples {b}) (Sum.inr (singletonMark b))
  have hd : Measurable (fun p : Z × ℝ => (p.1, (p.2, p.2))) :=
    measurable_fst.prodMk (measurable_snd.prodMk measurable_snd)
  exact (marginal {b} (fun _ => 0) (fun _ => 0) (fun _ => false)).measurable.comp (he.comp hd)

private theorem singletonCorner_haar {d : ℕ} (b : Fin d) (k n : ℤ)
    (f : (Fin d → ℝ) → ℝ) (hfm : Measurable f) {C : ℝ} (hf : ∀ x, |f x| ≤ C)
    (z : SingletonSpectators b → ℝ) {y : ℝ} (hy : y ∈ dyadicInterval k n) :
    coordinateDifference b k f (singletonCorner b z y) =
      dyadicHaar k n y *
        (∫ t, dyadicHaar k n t * f (singletonCorner b z t) ∂dyadicIntervalProbability k n) := by
  have hi : IntegrableOn (fun t => f (singletonCorner b z t)) (dyadicInterval k n) := by
    let m := (volume : Measure ℝ).restrict (dyadicInterval k n)
    let _ : IsFiniteMeasure m :=
      ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
    have hm : Measurable (fun t => f (singletonCorner b z t)) :=
      hfm.comp ((singletonCorner_measurable b).comp (measurable_const.prodMk measurable_id))
    exact (MemLp.of_bound (μ := m) (p := 1) hm.aestronglyMeasurable C
      (Filter.Eventually.of_forall fun x => hf _)).integrable le_rfl
  have h := coordinateDifference_eq_haar b k n
    (show singletonCorner b z y b ∈ dyadicInterval k n by rwa [singletonCorner_self])
    (f := f) (by simpa only [singletonCorner_update] using hi)
  rw [singletonCorner_self] at h
  simp_rw [singletonCorner_update] at h
  simpa only [dyadicIntervalProbability, integral_smul_measure, ENNReal.toReal_inv,
    ENNReal.toReal_ofReal (show 0 ≤ (2 : ℝ)^(-k) by positivity), smul_eq_mul] using h


private theorem abs_dyadicHaar_le_one {k n : ℤ} (x : ℝ) : |dyadicHaar k n x| ≤ 1 := by
  unfold dyadicHaar
  by_cases h0 : x ∈ dyadicInterval (k+1) (2*n) <;>
    by_cases h1 : x ∈ dyadicInterval (k+1) (2*n+1) <;> norm_num [h0, h1]

private theorem dyadicHaar_sq_eq_one {k n : ℤ} {x : ℝ} (hx : x ∈ dyadicInterval k n) :
    (dyadicHaar k n x)^2 = 1 := by
  have hdisj := pairwiseDisjoint_dyadicInterval (k+1) (show 2*n ≠ 2*n+1 by omega)
  rw [← dyadicInterval_children] at hx
  rcases hx with h | h
  · have hn : x ∉ dyadicInterval (k+1) (2*n+1) := fun h' => Set.disjoint_left.mp hdisj h h'
    norm_num [dyadicHaar, h, hn]
  · have hn : x ∉ dyadicInterval (k+1) (2*n) := fun h' => Set.disjoint_left.mp hdisj h' h
    norm_num [dyadicHaar, h, hn]

private theorem abs_integral_mul_le_sqrt {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {f g : Ω → ℝ} (hf : MemLp f 2 μ) (hg : MemLp g 2 μ) :
    |∫ x, f x * g x ∂μ| ≤
      Real.sqrt (∫ x, (f x)^2 ∂μ) * Real.sqrt (∫ x, (g x)^2 ∂μ) := by
  refine abs_integral_le_integral_abs.trans ?_
  simp_rw [abs_mul]
  have hf' : MemLp (fun x => |f x|) (ENNReal.ofReal 2) μ := by simpa using hf.norm
  have hg' : MemLp (fun x => |g x|) (ENNReal.ofReal 2) μ := by simpa using hg.norm
  have h := integral_mul_le_Lp_mul_Lq_of_nonneg Real.HolderConjugate.two_two
    (Filter.Eventually.of_forall fun x => abs_nonneg (f x))
    (Filter.Eventually.of_forall fun x => abs_nonneg (g x)) hf' hg'
  simpa only [Real.rpow_two, sq_abs, Real.sqrt_eq_rpow] using h

private theorem realVolume_dyadicRectangle_pos {d : ℕ} (k n : Fin d → ℤ) :
    0 < (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) := by
  rw [measureReal_def, volume_dyadicRectangle, ENNReal.toReal_prod]
  exact Finset.prod_pos (fun i _ => by rw [ENNReal.toReal_ofReal (by positivity)]; positivity)

private theorem volume_mul_integral_rectangleProbability {d : ℕ} (k n : Fin d → ℤ)
    (g : (Fin d → ℝ) → ℝ) :
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      (∫ x, g x ∂rectangleProbability k n) = ∫ x in dyadicRectangle k n, g x := by
  rw [rectangleProbability_eq, integral_smul_measure, ENNReal.toReal_inv, smul_eq_mul, ← mul_assoc]
  change (volume.real (dyadicRectangle k n)) * (volume.real (dyadicRectangle k n))⁻¹ * _ = _
  rw [mul_inv_cancel₀ (realVolume_dyadicRectangle_pos k n).ne', one_mul]


/-- The local pairing bound from one reflected coordinate. -/
theorem boxSquare_local_pairing {d : ℕ} (b : Fin d) (k n : Fin d → ℤ)
    {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H) (hH : ∀ x, |H x| ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l)) (hL : ∀ i l x, |L i l x| ≤ 1)
    {f : (Fin d → ℝ) → ℝ} (hfm : Measurable f) (hf : ∀ x, |f x| ≤ 1) :
    let V := dyadicRectangle k n
    let v := (volume : Measure (Fin d → ℝ)).real V
    let g (x : Fin d → ℝ) := H x * ∏ i ∈ ({b} : Finset (Fin d))ᶜ, L i (k i) x
    |∫ x in V, g x * coordinateDifference b (k b) f x| ≤
      Real.sqrt ((∫ x in V, (coordinateDifference b (k b) f x)^2) *
        (v * reflectedBoxDifference {b} b k n H L)) := by
  classical
  dsimp only
  let l := k b
  let m := n b
  let V := dyadicRectangle k n
  let v := (volume : Measure (Fin d → ℝ)).real V
  let Z := SingletonSpectators b → ℝ
  let μ := dyadicIntervalProbability l m
  let ν := reflectedSpectatorMeasure {b} (singletonMark b) k n
  let haar := dyadicHaar l m
  let g (x : Fin d → ℝ) := H x * ∏ i ∈ ({b} : Finset (Fin d))ᶜ, L i (k i) x
  let dF := coordinateDifference b l f
  let A (z : Z) := ∫ y, haar y * f (singletonCorner b z y) ∂μ
  let B (z : Z) := ∫ y, haar y * g (singletonCorner b z y) ∂μ
  have hgm : Measurable g := hHm.mul (Finset.measurable_fun_prod _ (fun i _ => hLm i (k i)))
  have hg (x : Fin d → ℝ) : |g x| ≤ 1 := by
    unfold g
    rw [abs_mul, Finset.abs_prod]
    exact (mul_le_of_le_one_right (abs_nonneg _) (Finset.prod_le_one₀
      (fun _ _ => abs_nonneg _) (fun i _ => hL i (k i) x))).trans (hH x)
  have hDm : Measurable dF :=
    (measurable_coordinateAverage b (l+1) hfm).sub (measurable_coordinateAverage b l hfm)
  have hD (x : Fin d → ℝ) : |dF x| ≤ 2 := by
    refine (abs_sub _ _).trans ?_
    simpa only [one_add_one_eq_two] using add_le_add
      (abs_coordinateAverage_le b (l+1) hf x) (abs_coordinateAverage_le b l hf x)
  have hv : 0 < v := realVolume_dyadicRectangle_pos k n
  have hae : ∀ᵐ y ∂μ, y ∈ dyadicInterval l m :=
    Measure.ae_smul_measure (ae_restrict_mem measurableSet_Ico) _
  have hA (z : Z) :
      ∀ᵐ y ∂μ, dF (singletonCorner b z y) = haar y * A z :=
    hae.mono fun _ hy => singletonCorner_haar b l m f hfm hf z hy
  have hpair : (∫ x in V, g x * dF x) = v * (∫ z, A z * B z ∂ν) := by
    rw [← volume_mul_integral_rectangleProbability k n (fun x => g x * dF x),
      singletonCorner_integral b k n (fun x => g x * dF x) (hgm.mul hDm) (C := 2)
        (fun x => by simpa only [abs_mul, one_mul] using mul_le_mul (hg x) (hD x) (abs_nonneg _) zero_le_one)]
    congr 1
    apply integral_congr_ae
    filter_upwards with z
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [hA z] with y hy
    rw [hy]
    ring
  have hEnergy : (∫ x in V, (dF x)^2) = v * (∫ z, (A z)^2 ∂ν) := by
    rw [← volume_mul_integral_rectangleProbability k n (fun x => (dF x)^2),
      singletonCorner_integral b k n _ (hDm.pow_const 2) (C := 4)
        (fun x => by rw [abs_pow]; nlinarith [hD x, abs_nonneg (dF x)])]
    congr 1
    apply integral_congr_ae
    filter_upwards with z
    let _ : IsProbabilityMeasure μ := dyadicIntervalProbability_isProbability l m
    calc
      _ = ∫ _ : ℝ, (A z)^2 ∂μ := by
        apply integral_congr_ae
        filter_upwards [hae, hA z] with y hy hy'
        rw [hy', mul_pow, dyadicHaar_sq_eq_one hy, one_mul]
      _ = _ := by simp [measureReal_def]
  have hbox : reflectedBoxDifference {b} b k n H L = ∫ z, (B z)^2 ∂ν := by
    rw [reflectedBoxDifference_integral_sq {b} (singletonMark b) k n hHm hH hLm hL]
    apply integral_congr_ae
    filter_upwards with z
    unfold B
    rw [integral_dyadicHaar_probability (fun y => g (singletonCorner b z y))
      (hgm.comp ((singletonCorner_measurable b).comp (measurable_const.prodMk measurable_id)))
      (fun _ => hg _)]
    simp_rw [reflectedHalfProduct_singleton]
    rfl
  have hCoeffLp (g' : (Fin d → ℝ) → ℝ) (hgm' : Measurable g') (hg' : ∀ x, |g' x| ≤ 1) :
      MemLp (fun z : Z => ∫ y, haar y * g' (singletonCorner b z y) ∂μ) 2 ν := by
    let _ : IsProbabilityMeasure μ := dyadicIntervalProbability_isProbability l m
    let _ : IsProbabilityMeasure ν :=
      inferInstanceAs (IsProbabilityMeasure (reflectedSpectatorMeasure {b} (singletonMark b) k n))
    have hM : Measurable (fun p : Z × ℝ => haar p.2 * g' (singletonCorner b p.1 p.2)) := by
      have hhm : Measurable haar :=
        (measurable_const.indicator (measurableSet_Ico : MeasurableSet (dyadicInterval (l+1) (2*m)))).sub
          (measurable_const.indicator (measurableSet_Ico : MeasurableSet (dyadicInterval (l+1) (2*m+1))))
      exact (hhm.comp measurable_snd).mul (hgm'.comp (singletonCorner_measurable b))
    apply MemLp.of_bound (hM.stronglyMeasurable.integral_prod_right' (ν := μ)).aestronglyMeasurable 1
    filter_upwards with z
    have hb := norm_integral_le_of_norm_le_const (μ := μ) (C := 1)
      (f := fun y => haar y * g' (singletonCorner b z y))
      (Filter.Eventually.of_forall fun y => by
        rw [Real.norm_eq_abs, abs_mul]
        exact (mul_le_of_le_one_right (abs_nonneg _) (hg' _)).trans (abs_dyadicHaar_le_one y))
    simpa [measureReal_def] using hb
  change |∫ x in V, g x * dF x| ≤ Real.sqrt ((∫ x in V, (dF x)^2) *
    (v * reflectedBoxDifference {b} b k n H L))
  rw [hpair, hEnergy, hbox, abs_mul, abs_of_nonneg hv.le]
  have hEa : 0 ≤ ∫ z, (A z)^2 ∂ν := integral_nonneg fun z => sq_nonneg _
  rw [Real.sqrt_mul (mul_nonneg hv.le hEa), Real.sqrt_mul hv.le, Real.sqrt_mul hv.le]
  exact (mul_le_mul_of_nonneg_left (abs_integral_mul_le_sqrt (hCoeffLp f hfm hf)
    (hCoeffLp g hgm hg)) hv.le).trans_eq (by
      change v * (Real.sqrt (∫ z, (A z)^2 ∂ν) * Real.sqrt (∫ z, (B z)^2 ∂ν)) =
        (Real.sqrt v * Real.sqrt (∫ z, (A z)^2 ∂ν)) *
          (Real.sqrt v * Real.sqrt (∫ z, (B z)^2 ∂ν))
      rw [mul_mul_mul_comm, Real.mul_self_sqrt hv.le])


set_option maxHeartbeats 600000 in
private theorem abs_tsum_le_sqrt {ι : Type*} {f a b : ι → ℝ}
    (ha : Summable a) (hb : Summable b) (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (h : ∀ i, |f i| ≤ Real.sqrt (a i * b i)) :
    |∑' i, f i| ≤ Real.sqrt (∑' i, a i) * Real.sqrt (∑' i, b i) := by
  have hsum (s : Finset ι) :
      ∑ i ∈ s, |f i| ≤ Real.sqrt (∑' i, a i) * Real.sqrt (∑' i, b i) := by
    have hterm (i : ι) : |f i| ≤ Real.sqrt (a i) * Real.sqrt (b i) := by
      simpa only [Real.sqrt_mul (ha0 i)] using h i
    refine (Finset.sum_le_sum (fun i _ => hterm i)).trans ?_
    exact (Real.sum_sqrt_mul_sqrt_le s ha0 hb0).trans (mul_le_mul
      (Real.sqrt_le_sqrt (ha.sum_le_tsum s (fun i _ => ha0 i)))
      (Real.sqrt_le_sqrt (hb.sum_le_tsum s (fun i _ => hb0 i)))
      (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
  have hAbs := summable_of_sum_le (fun i => abs_nonneg (f i)) hsum
  have hn : Summable (fun i => ‖f i‖) := by simpa only [Real.norm_eq_abs] using hAbs
  have hh := norm_tsum_le_tsum_norm hn
  simp only [Real.norm_eq_abs] at hh
  exact hh.trans (hAbs.tsum_le_of_sum_le hsum)

/-- The one-reflected-coordinate estimate over the full finite scale window. -/
theorem boxSquare_pairing {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1)
    {H : ℕ → (Fin d → ℝ) → ℝ} (hHm : ∀ k, Measurable (H k))
    (hHi : ∀ k, Integrable (H k)) (hH0 : ∀ k x, 0 ≤ H k x) (hH1 : ∀ k x, H k x ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l)) (hL : ∀ i l x, |L i l x| ≤ 1)
    {f : (Fin d → ℝ) → ℝ} (hfm : Measurable f) (hf : ∀ x, |f x| ≤ 1)
    (hLp : MemLp f 2 volume) :
    |∑ l ∈ Finset.range T, c l * ∫ x, H l x *
      (∏ i ∈ ({b} : Finset (Fin d))ᶜ, L i (u+l) x) * coordinateDifference b (u+l) f x| ≤
      Real.sqrt ((∫ x, (f x)^2) * energyDef {b} u T H L) := by
  classical
  let k (l : ℕ) (_ : Fin d) := u + (l : ℤ)
  let V (l : ℕ) := dyadicRectangle (k l)
  let Δ (l : ℕ) := coordinateDifference b (u + l) f
  let P (l : ℕ) (x : Fin d → ℝ) := H l x *
    (∏ i ∈ ({b} : Finset (Fin d))ᶜ, L i (u+l) x) * Δ l x
  let e (l : ℕ) (x : Fin d → ℝ) := (Δ l x)^2
  let B (l : ℕ) (n : Fin d → ℤ) :=
    (volume : Measure (Fin d → ℝ)).real (V l n) *
      reflectedBoxDifference {b} b (k l) n (H l) L
  have hH (l : ℕ) (x : Fin d → ℝ) : |H l x| ≤ 1 := by
    rw [abs_of_nonneg (hH0 l x)]
    exact hH1 l x
  have hB (l : ℕ) (n : Fin d → ℤ) : 0 ≤ B l n :=
    mul_nonneg ENNReal.toReal_nonneg
      (boxSquare {b} (singletonMark b) (k l) n (hHm l) (hH l) hLm hL).2
  have hBs (l : ℕ) : Summable (B l) := by
    have h := summable_reflectedBoxDifference_grid {b} b (k l) (H l)
      (hHm l) (hHi l) (hH0 l) (hH1 l) L hL
    change Summable (fun n => |B l n|) at h
    simpa only [abs_of_nonneg (hB l _)] using h
  have hΔm (l : ℕ) : Measurable (Δ l) :=
    (measurable_coordinateAverage b (u+l+1) hfm).sub (measurable_coordinateAverage b (u+l) hfm)
  have heI (l : ℕ) : Integrable (e l) := by
    have hA (j : ℤ) : MemLp (coordinateAverage b j f) 2 volume := by
      have h := coordinateAverage_eLpNorm_le b j (p := 2) (by norm_num) hfm
        (by simpa using hLp)
      have hn : eLpNorm (coordinateAverage b j f) 2 volume ≤ eLpNorm f 2 volume := by simpa using h
      exact hn.trans_lt hLp.eLpNorm_lt_top
    have hD : MemLp (Δ l) 2 volume := (hA (u+l+1)).sub (hA (u+l))
    exact hD.integrable_sq
  have hP (l : ℕ) : Integrable (P l) := by
    have hm : Measurable (P l) := ((hHm l).mul (Finset.measurable_fun_prod _
      (fun i _ => hLm i (u+l)))).mul (hΔm l)
    apply ((hHi l).const_mul 2).mono' hm.aestronglyMeasurable
    filter_upwards with x
    unfold P
    rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_of_nonneg (hH0 l x), Finset.abs_prod]
    have hp : (∏ i ∈ ({b} : Finset (Fin d))ᶜ, |L i (u+l) x|) ≤ 1 :=
      Finset.prod_le_one₀ (fun _ _ => abs_nonneg _) (fun i _ => hL i _ x)
    have hd : |Δ l x| ≤ 2 := by
      refine (abs_sub _ _).trans ?_
      simpa only [one_add_one_eq_two] using add_le_add
        (abs_coordinateAverage_le b (u+l+1) hf x) (abs_coordinateAverage_le b (u+l) hf x)
    change _ ≤ 2 * H l x
    linarith [mul_le_mul
      (mul_le_of_le_one_right (hH0 l x) hp) hd (abs_nonneg (Δ l x)) (hH0 l x)]
  have hlevel (l : ℕ) : |∫ x, P l x| ≤
      Real.sqrt (∫ x, e l x) * Real.sqrt (∑' n, B l n) := by
    have hsum (g : (Fin d → ℝ) → ℝ) (hg : Integrable g) :
        HasSum (fun n : Fin d → ℤ => ∫ x in V l n, g x) (∫ x, g x) := by
      have h := hasSum_integral_iUnion (measurableSet_dyadicRectangle (k l))
        (pairwiseDisjoint_dyadicRectangle (k l)) (f := g) hg.integrableOn
      rw [iUnion_dyadicRectangle, setIntegral_univ] at h
      exact h
    rw [← (hsum _ (hP l)).tsum_eq, ← (hsum _ (heI l)).tsum_eq]
    exact abs_tsum_le_sqrt (hsum _ (heI l)).summable (hBs l)
      (fun n => integral_nonneg fun x => sq_nonneg (Δ l x)) (hB l)
      (fun n => boxSquare_local_pairing b (k l) n (hHm l) (hH l) hLm hL hfm hf)
  have hE (l : ℕ) : 0 ≤ ∫ x, e l x := integral_nonneg fun x => sq_nonneg (Δ l x)
  have hB0 (l : ℕ) : 0 ≤ ∑' n, B l n := tsum_nonneg (hB l)
  have hU : (∑ l ∈ Finset.range T, ∑' n, B l n) ≤ energyDef {b} u T H L := by
    let ν : Fin d → Fin ({b} : Finset (Fin d)).card :=
      fun _ => ⟨0, by simp⟩
    have hν (i : Fin d) : (ν i : ℕ) = 0 := rfl
    have hmem : markedEnergy {b} u T H L ν (singletonMark b) ∈ Set.range
        (fun p : (Fin d → Fin ({b} : Finset (Fin d)).card) × {i : Fin d // i ∈ ({b} : Finset (Fin d))} =>
          markedEnergy {b} u T H L p.1 p.2) := ⟨(ν, singletonMark b), rfl⟩
    have hUp := le_csSup (Set.finite_range _).bddAbove hmem
    unfold energyDef
    simpa only [markedEnergy, hν, Nat.cast_zero, add_zero, B, V, k, singletonMark] using hUp
  change |∑ l ∈ Finset.range T, c l * ∫ x, P l x| ≤ _
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  have hS := Real.sum_sqrt_mul_sqrt_le (Finset.range T) hE hB0
  refine (Finset.sum_le_sum (fun l _ => ?_)).trans (hS.trans ?_)
  · rw [abs_mul]
    exact (mul_le_of_le_one_left (abs_nonneg _) (hc l)).trans (hlevel l)
  · rw [Real.sqrt_mul (integral_nonneg fun x => sq_nonneg (f x))]
    exact mul_le_mul (Real.sqrt_le_sqrt (coordinateDifference_sum_integral_sq_le b u T hfm hLp))
      (Real.sqrt_le_sqrt hU) (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)


/-- The volume-weighted box sum at a fixed rectangle grid. -/
noncomputable def gridBoxSum {d : ℕ} (J : Finset (Fin d)) (k : Fin d → ℤ)
    (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ) : ℝ :=
  ∑' n : Fin d → ℤ, (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
    reflectedBox J k n H L

private theorem summable_gridBox {d : ℕ} (J : Finset (Fin d)) (k : Fin d → ℤ)
    {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H) (hHi : Integrable H)
    (hH0 : ∀ x, 0 ≤ H x) (hH1 : ∀ x, H x ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hL : ∀ i r x, |L i r x| ≤ 1) :
    Summable (fun n : Fin d → ℤ => (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      reflectedBox J k n H L) := by
  apply summable_norm_iff.mp
  have hsum := hasSum_integral_iUnion (measurableSet_dyadicRectangle k)
    (pairwiseDisjoint_dyadicRectangle k) (f := H) hHi.integrableOn
  refine hsum.summable.of_nonneg_of_le (fun _ => norm_nonneg _) fun n => ?_
  rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg
    (realVolume_dyadicRectangle_pos k n).le]
  exact abs_reflectedBox_le J k n H hHm hH0 hH1 L hL

private noncomputable def childRectangleIndexEquiv {d : ℕ} (j : Fin d) :
    ((Fin d → ℤ) × Bool) ≃ (Fin d → ℤ) where
  toFun p := Function.update p.1 j (2 * p.1 j + if p.2 then 1 else 0)
  invFun n := (Function.update n j (n j / 2), decide (n j % 2 = 1))
  left_inv := by
    rintro ⟨n, b⟩
    apply Prod.ext
    · funext i
      by_cases hi : i = j
      · subst i
        simp only [Function.update_self]
        cases b <;> simp <;> omega
      · simp [Function.update_of_ne hi]
    · simp only [Function.update_self]
      cases b <;> simp
  right_inv := by
    intro n
    funext i
    by_cases hi : i = j
    · subst i
      simp only [Function.update_self, decide_eq_true_eq]
      split <;> omega
    · simp [Function.update_of_ne hi]

/-- Child averaging with the original mask gives the weighted box sum on the refined grid. -/
theorem gridBoxSum_child_sub {d : ℕ} (J : Finset (Fin d)) (j : Fin d) (k : Fin d → ℤ)
    {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H) (hHi : Integrable H)
    (hH0 : ∀ x, 0 ≤ H x) (hH1 : ∀ x, H x ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hL : ∀ i r x, |L i r x| ≤ 1) :
    gridBoxSum J (Function.update k j (k j+1)) H L - gridBoxSum J k H L =
      ∑' n : Fin d → ℤ, (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
        reflectedBoxDifference J j k n H L := by
  let k' := Function.update k j (k j+1)
  let A (n : Fin d → ℤ) := (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
    reflectedBox J k n H L
  let A' (n : Fin d → ℤ) := (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k' n) *
    reflectedBox J k' n H L
  let e := childRectangleIndexEquiv j
  let C (n : Fin d → ℤ) := ∑ b : Bool, A' (e (n, b))
  have hA : Summable A := summable_gridBox J k hHm hHi hH0 hH1 hL
  have hA' : Summable A' := summable_gridBox J k' hHm hHi hH0 hH1 hL
  have hC : HasSum C (∑' n, A' n) := by
    have h := e.hasSum_iff.mpr hA'.hasSum
    have hh := h.prod_fiberwise (fun i => (h.summable.prod_factor i).hasSum)
    simpa only [C, Function.comp_apply, tsum_fintype] using hh
  have hD (n : Fin d → ℤ) :
      (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
        reflectedBoxDifference J j k n H L = C n - A n := by
    unfold C
    rw [Fintype.sum_bool]
    dsimp only [A', e, childRectangleIndexEquiv, Equiv.coe_fn_mk]
    simp only [ite_true, Bool.false_eq_true, ite_false, add_zero]
    rw [realVolume_child_dyadicRectangle j k n, realVolume_child_dyadicRectangle j k n]
    unfold A reflectedBoxDifference
    ring
  simp_rw [hD]
  rw [hC.summable.tsum_sub hA, hC.tsum_eq]
  rfl


private theorem abs_prod_sub_le_sum_unit {ι : Type*} (s : Finset ι) (f g : ι → ℝ)
    (hf : ∀ i ∈ s, |f i| ≤ 1) (hg : ∀ i ∈ s, |g i| ≤ 1) :
    |(∏ i ∈ s, f i) - (∏ i ∈ s, g i)| ≤ ∑ i ∈ s, |f i - g i| := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.prod_insert hi, Finset.sum_insert hi]
    let F := ∏ j ∈ s, f j
    let G := ∏ j ∈ s, g j
    change |f i*F-g i*G| ≤ _
    rw [show f i*F-g i*G = (f i-g i)*F+g i*(F-G) by ring]
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul, abs_mul]
    have hF : |F| ≤ 1 := by
      unfold F
      rw [Finset.abs_prod]
      exact Finset.prod_le_one₀ (fun _ _ => abs_nonneg _) fun j hj =>
        hf j (Finset.mem_insert_of_mem hj)
    have hDiff := ih (fun j hj => hf j (Finset.mem_insert_of_mem hj))
      (fun j hj => hg j (Finset.mem_insert_of_mem hj))
    have hLeft := mul_le_of_le_one_right (abs_nonneg (f i-g i)) hF
    have hRight := mul_le_of_le_one_left (abs_nonneg (F-G)) (hg i (Finset.mem_insert_self _ _))
    exact add_le_add hLeft (hRight.trans hDiff)

private theorem abs_reflectedBox_mask_sub_le {d : ℕ} (J : Finset (Fin d)) (k n : Fin d → ℤ)
    {H H' : (Fin d → ℝ) → ℝ} (hHm : Measurable H) (hHm' : Measurable H')
    (hH : ∀ x, H x ∈ Icc (0 : ℝ) 1) (hH' : ∀ x, H' x ∈ Icc (0 : ℝ) 1)
    (hord : ∀ x, H' x ≤ H x) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l))
    (σ : Fin d → ℝ) (hσ : ∀ i, σ i ∈ Icc (0 : ℝ) 1) (hL : ∀ i r x, |L i r x| ≤ σ i) :
    let V := dyadicRectangle k n
    let nJ : ℕ := 2^J.card
    (volume : Measure (Fin d → ℝ)).real V *
      |reflectedBox J k n H L - reflectedBox J k n H' L| ≤
      (nJ : ℝ) * (∏ i ∈ Jᶜ, (σ i)^nJ) * ∫ x in V, H x - H' x := by
  classical
  dsimp only
  let ι := {i : Fin d // i ∈ J} → Bool
  let S := ReflectedSamples J → ℝ
  let μ := cornerProbability J k n
  let V := dyadicRectangle k n
  let v := (volume : Measure (Fin d → ℝ)).real V
  let σ' := ∏ i ∈ Jᶜ, σ i
  let D := σ'^(Fintype.card ι)
  let P (ω : ι) (x : S) := ∏ i ∈ Jᶜ, L i (k i) (cornerPoint J ω x)
  let F (G : (Fin d → ℝ) → ℝ) (x : S) := ∏ ω : ι, G (cornerPoint J ω x) * P ω x
  let R (ω : ι) (x : S) := H (cornerPoint J ω x) - H' (cornerPoint J ω x)
  have hP (ω : ι) (x : S) : |P ω x| ≤ σ' := by
    unfold P
    rw [Finset.abs_prod]
    exact Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _) (fun i _ => hL i (k i) _)
  have hσ' : σ' ≤ 1 := Finset.prod_le_one₀ (fun i _ => (hσ i).1) (fun i _ => (hσ i).2)
  have hD : 0 ≤ D := pow_nonneg (Finset.prod_nonneg fun i _ => (hσ i).1) _
  have hM (ω : ι) : Measurable (cornerPoint J ω) := (marginal J k n ω).measurable
  have hFi (G : (Fin d → ℝ) → ℝ) (hGm : Measurable G) (hG : ∀ x, G x ∈ Icc (0 : ℝ) 1) :
      Integrable (F G) μ := by
    let _ : IsProbabilityMeasure μ := cornerProbability_isProbability J k n
    have hFm : Measurable (F G) := Finset.measurable_fun_prod _ (fun ω _ =>
      (hGm.comp (hM ω)).mul (Finset.measurable_fun_prod _ (fun i _ => (hLm i (k i)).comp (hM ω))))
    apply (MemLp.of_bound (p := 1) hFm.aestronglyMeasurable 1 ?_).integrable le_rfl
    filter_upwards with x
    unfold F
    rw [Real.norm_eq_abs, Finset.abs_prod]
    apply Finset.prod_le_one₀ (fun _ _ => abs_nonneg _)
    intro ω _
    rw [abs_mul, abs_of_nonneg (hG _).1]
    exact (mul_le_of_le_one_right (hG _).1 ((hP ω x).trans hσ')).trans (hG _).2
  have hRi (ω : ι) : Integrable (R ω) μ := by
    let _ : IsProbabilityMeasure μ := cornerProbability_isProbability J k n
    apply (MemLp.of_bound (p := 1) (((hHm.sub hHm').comp (hM ω)).aestronglyMeasurable) 1 ?_).integrable le_rfl
    filter_upwards with x
    change |R ω x| ≤ 1
    rw [abs_of_nonneg (sub_nonneg.mpr (hord _))]
    exact (sub_le_self _ (hH' _).1).trans (hH _).2
  have hpoint (x : S) : |F H x - F H' x| ≤ D * ∑ ω : ι, R ω x := by
    unfold F
    rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, ← sub_mul, abs_mul, mul_comm]
    have hdiff := abs_prod_sub_le_sum_unit Finset.univ
      (fun ω : ι => H (cornerPoint J ω x)) (fun ω : ι => H' (cornerPoint J ω x))
      (fun ω _ => (abs_of_nonneg (hH _).1).trans_le (hH _).2)
      (fun ω _ => (abs_of_nonneg (hH' _).1).trans_le (hH' _).2)
    simp_rw [abs_of_nonneg (sub_nonneg.mpr (hord _))] at hdiff
    have hprod : |∏ ω : ι, P ω x| ≤ D := by
      rw [Finset.abs_prod]
      change (∏ ω : ι, |P ω x|) ≤ σ'^(Fintype.card ι)
      rw [← Finset.card_univ, ← Finset.prod_const]
      exact Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _) (fun ω _ => hP ω x)
    exact mul_le_mul hprod hdiff (abs_nonneg _) hD
  have hRint (ω : ι) : (∫ x, R ω x ∂μ) = ∫ x, H x - H' x ∂rectangleProbability k n := by
    have h := integral_map (μ := μ) (hM ω).aemeasurable
      (f := fun x => H x-H' x) (hHm.sub hHm').aestronglyMeasurable
    rw [(marginal J k n ω).map_eq] at h
    exact h.symm
  have hi := (hFi H hHm hH).sub (hFi H' hHm' hH')
  have hle : |(∫ x, F H x ∂μ) - (∫ x, F H' x ∂μ)| ≤
      D * (Fintype.card ι : ℝ) * (∫ x, H x-H' x ∂rectangleProbability k n) := by
    rw [← integral_sub (hFi H hHm hH) (hFi H' hHm' hH')]
    refine abs_integral_le_integral_abs.trans ((integral_mono hi.norm
      ((integrable_finsetSum _ (fun ω _ => hRi ω)).const_mul D) hpoint).trans_eq ?_)
    rw [integral_const_mul, integral_finsetSum _ (fun ω _ => hRi ω)]
    rw [Finset.sum_congr rfl (fun ω _ => hRint ω)]
    simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_assoc]
  have hV : 0 ≤ v := (realVolume_dyadicRectangle_pos k n).le
  have hcard : Fintype.card ι = 2^J.card := by
    simp [ι, Fintype.card_pi]
  have he : D = ∏ i ∈ Jᶜ, (σ i)^(2^J.card) := by
    unfold D σ'
    rw [hcard, Finset.prod_pow]
  have h := mul_le_mul_of_nonneg_left hle hV
  change v * |reflectedBox J k n H L - reflectedBox J k n H' L| ≤ _
  refine h.trans_eq ?_
  rw [he, hcard]
  rw [show v * ((∏ i ∈ Jᶜ, σ i ^ (2^J.card)) * ↑(2^J.card : ℕ) *
      ∫ x, H x-H' x ∂rectangleProbability k n) =
      ↑(2^J.card : ℕ) * (∏ i ∈ Jᶜ, σ i ^ (2^J.card)) *
        (v * ∫ x, H x-H' x ∂rectangleProbability k n) by ring]
  rw [volume_mul_integral_rectangleProbability k n]


private theorem gridBoxSum_mask_sub_le {d : ℕ} (J : Finset (Fin d)) (k : Fin d → ℤ)
    {H H' : (Fin d → ℝ) → ℝ} (hHm : Measurable H) (hHm' : Measurable H')
    (hHi : Integrable H) (hHi' : Integrable H')
    (hH : ∀ x, H x ∈ Icc (0 : ℝ) 1) (hH' : ∀ x, H' x ∈ Icc (0 : ℝ) 1)
    (hord : ∀ x, H' x ≤ H x) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l))
    (σ : Fin d → ℝ) (hσ : ∀ i, σ i ∈ Icc (0 : ℝ) 1) (hL : ∀ i r x, |L i r x| ≤ σ i) :
    gridBoxSum J k H L - gridBoxSum J k H' L ≤
      ((2^J.card : ℕ) : ℝ) * (∏ i ∈ Jᶜ, (σ i)^(2^J.card : ℕ)) * ∫ x, H x - H' x := by
  let A (G : (Fin d → ℝ) → ℝ) (n : Fin d → ℤ) :=
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) * reflectedBox J k n G L
  let c := ((2^J.card : ℕ) : ℝ) * (∏ i ∈ Jᶜ, (σ i)^(2^J.card : ℕ))
  have hUnit (i : Fin d) (r : ℤ) (x : Fin d → ℝ) : |L i r x| ≤ 1 := (hL i r x).trans (hσ i).2
  have hAs : Summable (A H) := summable_gridBox J k hHm hHi (fun x => (hH x).1)
    (fun x => (hH x).2) hUnit
  have hAs' : Summable (A H') := summable_gridBox J k hHm' hHi' (fun x => (hH' x).1)
    (fun x => (hH' x).2) hUnit
  have hD := hasSum_integral_iUnion (measurableSet_dyadicRectangle k)
    (pairwiseDisjoint_dyadicRectangle k) (f := fun x => H x-H' x) (hHi.sub hHi').integrableOn
  rw [iUnion_dyadicRectangle, setIntegral_univ] at hD
  change (∑' n, A H n) - (∑' n, A H' n) ≤ c * ∫ x, H x - H' x
  rw [← hAs.tsum_sub hAs', ← hD.tsum_eq, ← tsum_mul_left]
  refine (hAs.sub hAs').tsum_mono (hD.summable.mul_left c) (fun n => ?_)
  change A H n - A H' n ≤ _
  unfold A
  rw [← mul_sub]
  refine (mul_le_mul_of_nonneg_left (le_abs_self _) (by exact ENNReal.toReal_nonneg)).trans ?_
  exact abs_reflectedBox_mask_sub_le J k n hHm hHm' hH hH' hord hLm σ hσ hL

private theorem gridBoxSum_zero {d : ℕ} (J : Finset (Fin d)) (k : Fin d → ℤ)
    (L : Fin d → ℤ → (Fin d → ℝ) → ℝ) : gridBoxSum J k (fun _ => 0) L = 0 := by
  unfold gridBoxSum
  have hB (n : Fin d → ℤ) : reflectedBox J k n (fun _ => 0) L = 0 := by
    unfold reflectedBox
    have he (x : ReflectedSamples J → ℝ) :
        (∏ ω : ({i : Fin d // i ∈ J} → Bool),
          (0 : ℝ) * ∏ i ∈ Jᶜ, L i (k i) (cornerPoint J ω x)) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ (fun _ => false))
      exact zero_mul _
    simp only [he, integral_zero]
  simp only [hB, mul_zero, tsum_zero]

/-- The full-grid refinement sum telescopes with the mass loss of the moving masks. -/
theorem boxBoundary {d : ℕ} (J : Finset (Fin d)) (hJ : J.Nonempty) (u : ℤ) (T : ℕ)
    (ν : Fin d → ℕ) (H : ℕ → (Fin d → ℝ) → ℝ) (hHm : ∀ l, Measurable (H l))
    (hHi : ∀ l, Integrable (H l)) (hH : ∀ l x, H l x ∈ Icc (0 : ℝ) 1)
    (hord : ∀ l x, H (l+1) x ≤ H l x) (hterminal : H T = fun _ => 0)
    {h : ℝ} (hLoss : (∑ l ∈ Finset.range T, ∫ x, H l x-H (l+1) x) ≤ h)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ i l, Measurable (L i l))
    (σ : Fin d → ℝ) (hσ : ∀ i, σ i ∈ Icc (0 : ℝ) 1) (hL : ∀ i r x, |L i r x| ≤ σ i) :
    let k (l : ℕ) (i : Fin d) := u + (l : ℤ) + (ν i : ℤ)
    (∑ l ∈ Finset.range T, (gridBoxSum J (k (l+1)) (H l) L - gridBoxSum J (k l) (H l) L)) ≤
      ((2^J.card : ℕ) : ℝ) * (∏ i ∈ Jᶜ, (σ i)^(2^J.card : ℕ)) * h := by
  dsimp only
  let k (l : ℕ) (i : Fin d) := u + (l : ℤ) + (ν i : ℤ)
  let E (l : ℕ) := gridBoxSum J (k l) (H l) L
  let c := ((2^J.card : ℕ) : ℝ) * (∏ i ∈ Jᶜ, (σ i)^(2^J.card : ℕ))
  have hc : 0 ≤ c := mul_nonneg (by positivity)
    (Finset.prod_nonneg fun i _ => pow_nonneg (hσ i).1 _)
  have hUnit (i : Fin d) (r : ℤ) (x : Fin d → ℝ) : |L i r x| ≤ 1 := (hL i r x).trans (hσ i).2
  obtain ⟨j, hj⟩ := hJ
  have hE0 : 0 ≤ E 0 := tsum_nonneg fun n =>
    mul_nonneg ENNReal.toReal_nonneg
      (boxSquare J ⟨j, hj⟩ (k 0) n (hHm 0)
        (fun x => (abs_of_nonneg (hH 0 x).1).trans_le (hH 0 x).2) hLm hUnit).1
  have hET : E T = 0 := by
    unfold E
    rw [hterminal]
    exact gridBoxSum_zero J (k T) L
  have hstep (l : ℕ) :
      gridBoxSum J (k (l+1)) (H l) L - E l ≤
        c * (∫ x, H l x-H (l+1) x) + (E (l+1) - E l) := by
    have h := gridBoxSum_mask_sub_le J (k (l+1)) (hHm l) (hHm (l+1))
      (hHi l) (hHi (l+1)) (hH l) (hH (l+1)) (hord l) hLm σ hσ hL
    change gridBoxSum J (k (l+1)) (H l) L - E (l+1) ≤ _ at h
    linarith
  change (∑ l ∈ Finset.range T, (gridBoxSum J (k (l+1)) (H l) L - E l)) ≤ c * h
  refine (Finset.sum_le_sum (fun l _ => hstep l)).trans ?_
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_range_sub, hET]
  linarith [mul_le_mul_of_nonneg_left hLoss hc]


private theorem refinement_sum_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    (J : Finset ι) (j : ι) (hj : j ∈ J) (F : Finset ι → ℝ) (E : ι → ℝ)
    (hpos : ∀ i ∈ J, ∀ s : Finset ι, i ∉ s → F s ≤ F (insert i s))
    (herr : ∀ i ∉ J, ∀ s : Finset ι, i ∉ s → F s - F (insert i s) ≤ E i) :
    F {j} - F ∅ ≤ F Finset.univ - F ∅ + ∑ i ∈ Jᶜ, E i := by
  have htel (r s : Finset ι) (hdis : Disjoint r s) :
      F s - F (r ∪ s) ≤ ∑ i ∈ r \ J, E i := by
    induction r using Finset.induction_on generalizing s with
    | empty => simp
    | @insert i r hir ih =>
      have his : i ∉ s := fun his => Finset.disjoint_left.mp hdis (Finset.mem_insert_self i r) his
      have hdis' : Disjoint r (insert i s) := by
        apply Finset.disjoint_left.mpr
        intro k hk hks
        rcases Finset.mem_insert.mp hks with he | he
        · subst k; exact hir hk
        · exact Finset.disjoint_left.mp hdis (Finset.mem_insert_of_mem hk) he
      have ht := ih (insert i s) hdis'
      have he : r ∪ insert i s = insert i r ∪ s := by
        ext k
        simp only [Finset.mem_union, Finset.mem_insert]
        tauto
      rw [he] at ht
      by_cases hi : i ∈ J
      · have hs : insert i r \ J = r \ J := by
          ext k
          by_cases hk : k = i <;> simp [hk, hi]
        rw [hs]
        linarith [hpos i hi s his]
      · have hs : insert i r \ J = insert i (r \ J) := by
          ext k
          by_cases hk : k = i <;> simp [hk, hi]
        rw [hs, Finset.sum_insert (fun h => hir (Finset.mem_sdiff.mp h).1)]
        linarith [herr i hi s his]
  have h := htel ({j} : Finset ι)ᶜ {j} (by simp)
  have hset : ({j} : Finset ι)ᶜ \ J = Jᶜ := by
    ext i
    simp only [Finset.mem_sdiff, Finset.mem_compl, Finset.mem_singleton]
    constructor
    · exact And.right
    · intro hi
      exact ⟨fun e => hi (e.symm ▸ hj), hi⟩
  have he : ({j} : Finset ι)ᶜ ∪ {j} = Finset.univ := by
    ext i
    simp
  rw [hset, he] at h
  linarith

set_option maxHeartbeats 700000 in
/-- A marked derivative is bounded by the full refinement and the unreflected refinement errors. -/
theorem boxBoundary_marked {d : ℕ} (J : Finset (Fin d)) (j : {i : Fin d // i ∈ J}) (u : ℤ) (T : ℕ)
    (ν : Fin d → ℕ) (H : ℕ → (Fin d → ℝ) → ℝ) (hHm : ∀ l, Measurable (H l))
    (hHi : ∀ l, Integrable (H l)) (hH : ∀ l x, H l x ∈ Icc (0 : ℝ) 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ i l, Measurable (L i l))
    (hL : ∀ i r x, |L i r x| ≤ 1) (E : Fin d → ℝ)
    (hE : ∀ i ∉ J, ∀ s : Finset (Fin d), i ∉ s →
      (∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
        let k (r : Fin d) := u + (l : ℤ) + (ν r : ℤ) + if r ∈ s then 1 else 0
        |(volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
          reflectedBoxDifference J i k n (H l) L|) ≤ E i) :
    let k (l : ℕ) (i : Fin d) := u + (l : ℤ) + (ν i : ℤ)
    (∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
      (volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k l) n) *
        reflectedBoxDifference J j (k l) n (H l) L) ≤
      (∑ l ∈ Finset.range T, (gridBoxSum J (k (l+1)) (H l) L - gridBoxSum J (k l) (H l) L)) +
        ∑ i ∈ Jᶜ, E i := by
  classical
  dsimp only
  let k (l : ℕ) (i : Fin d) := u + (l : ℤ) + (ν i : ℤ)
  let k' (s : Finset (Fin d)) (l : ℕ) (i : Fin d) := k l i + if i ∈ s then 1 else 0
  let F (s : Finset (Fin d)) := ∑ l ∈ Finset.range T, gridBoxSum J (k' s l) (H l) L
  have hEmpty (l : ℕ) : k' ∅ l = k l := by funext i; simp [k']
  have hAll (l : ℕ) : k' Finset.univ l = k (l+1) := by
    funext i
    simp only [k', k, Finset.mem_univ, ite_true, Nat.cast_add, Nat.cast_one]
    omega
  have hstep (i : Fin d) (s : Finset (Fin d)) (hi : i ∉ s) (l : ℕ) :
      k' (insert i s) l = Function.update (k' s l) i (k' s l i + 1) := by
    funext r
    by_cases hr : r = i
    · subst r; simp [k', hi]
    · simp [k', hr]
  have hdiff (i : Fin d) (s : Finset (Fin d)) (hi : i ∉ s) :
      F (insert i s) - F s = ∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
        (volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k' s l) n) *
          reflectedBoxDifference J i (k' s l) n (H l) L := by
    unfold F
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro l _
    rw [hstep i s hi l]
    exact gridBoxSum_child_sub J i _ (hHm l) (hHi l) (fun x => (hH l x).1) (fun x => (hH l x).2) hL
  have hN (i : Fin d) (hi : i ∈ J) (s : Finset (Fin d)) (his : i ∉ s) : F s ≤ F (insert i s) := by
    apply sub_nonneg.mp
    rw [hdiff i s his]
    exact Finset.sum_nonneg fun l _ => tsum_nonneg fun n => mul_nonneg ENNReal.toReal_nonneg
      (boxSquare J ⟨i, hi⟩ (k' s l) n (hHm l)
        (fun x => (abs_of_nonneg (hH l x).1).trans_le (hH l x).2) hLm hL).2
  have hErr (i : Fin d) (hi : i ∉ J) (s : Finset (Fin d)) (his : i ∉ s) :
      F s - F (insert i s) ≤ E i := by
    rw [← neg_sub, hdiff i s his, ← Finset.sum_neg_distrib]
    refine (Finset.sum_le_sum (fun l _ => ?_)).trans (hE i hi s his)
    let g (n : Fin d → ℤ) := (volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k' s l) n) *
      reflectedBoxDifference J i (k' s l) n (H l) L
    have hs : Summable (fun n => |g n|) := summable_reflectedBoxDifference_grid J i (k' s l)
      (H l) (hHm l) (hHi l) (fun x => (hH l x).1) (fun x => (hH l x).2) L hL
    have hn : Summable (fun n => ‖g n‖) := by simpa only [Real.norm_eq_abs] using hs
    have hh := norm_tsum_le_tsum_norm hn
    simp only [Real.norm_eq_abs] at hh
    exact (neg_le_abs (∑' n, g n)).trans hh
  have hmain := refinement_sum_le J j j.property F E hN hErr
  have hj := hdiff j ∅ (Finset.notMem_empty _)
  rw [show insert (j : Fin d) (∅ : Finset (Fin d)) = {(j : Fin d)} from by simp] at hj
  rw [hj] at hmain
  change _ ≤ _ + ∑ i ∈ Jᶜ, E i at hmain
  simp only [hEmpty] at hmain
  unfold F at hmain
  simp_rw [hAll, hEmpty, ← Finset.sum_sub_distrib] at hmain
  exact hmain


private noncomputable def childExpansionTerm {ι : Type*} [Fintype ι]
    (A P D : ι → ℝ) (h : ℝ) (s : ι → Fin 3) : ℝ :=
  ∏ i, (if s i = 0 then A i else if s i = 1 then P i else h * D i)

private theorem childExpansion_product_sub {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A P D : ι → ℝ) (h : ℝ) :
    (∏ i, (A i+P i+h*D i)) - (∏ i, A i) =
      ∑ s ∈ Finset.univ.erase (fun _ : ι => (0 : Fin 3)), childExpansionTerm A P D h s := by
  classical
  have hsum (i : ι) : A i+P i+h*D i =
      ∑ j : Fin 3, (if j = 0 then A i else if j = 1 then P i else h * D i) := by
    simp [Fin.sum_univ_three]
  simp_rw [hsum] at ⊢
  rw [Fintype.prod_sum, ← Finset.sum_erase_add _ _ (Finset.mem_univ (fun _ : ι => (0 : Fin 3)))]
  simp only [ite_true, add_sub_cancel_right, childExpansionTerm]

private theorem childExpansionTerm_eq_factor {ι : Type*} [Fintype ι]
    (A P D : ι → ℝ) (h : ℝ) (s : ι → Fin 3) :
    childExpansionTerm A P D h s =
      h^((Finset.univ.filter (fun i => s i = (2 : Fin 3))).card) * childExpansionTerm A P D 1 s := by
  classical
  have hEq (i : ι) :
      (if s i = 0 then A i else if s i = 1 then P i else h * D i) =
        (if s i = 2 then h else 1) *
          (if s i = 0 then A i else if s i = 1 then P i else 1 * D i) := by
    generalize s i = j
    fin_cases j <;> simp
  unfold childExpansionTerm
  simp_rw [hEq]
  rw [Finset.prod_mul_distrib, ← Finset.prod_filter (p := fun i => s i = 2)]
  simp only [Finset.prod_const]


private abbrev SingleSpectators {S : Type*} (a : S) := {i : S // i ≠ a}

private noncomputable def insertSingleSample {S : Type*} [DecidableEq S]
    (a : S) (z : SingleSpectators a → ℝ) (y : ℝ) (i : S) : ℝ :=
  if hi : i = a then y else z ⟨i, hi⟩

private theorem insertSingleSample_preserving {S : Type*} [Fintype S] [DecidableEq S]
    (a : S) (μ : S → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)] :
    let ν := Measure.pi (fun i : SingleSpectators a => μ i)
    MeasurePreserving (fun x : (SingleSpectators a → ℝ) × ℝ =>
      insertSingleSample a x.1 x.2) (ν.prod (μ a)) (Measure.pi μ) := by
  classical
  dsimp only
  let e (x : (SingleSpectators a → ℝ) × ℝ) := insertSingleSample a x.1 x.2
  have hm : Measurable e := by
    apply Measurable.of_eval
    intro i
    by_cases hi : i = a
    · simpa [e, insertSingleSample, hi] using
        (measurable_snd : Measurable (fun x : (SingleSpectators a → ℝ) × ℝ => x.2))
    · simpa [e, insertSingleSample, hi, Function.comp_def] using
        (measurable_pi_apply (⟨i, hi⟩ : SingleSpectators a)).comp
          (measurable_fst : Measurable (fun x : (SingleSpectators a → ℝ) × ℝ => x.1))
  refine ⟨hm, (Measure.pi_eq fun s hs => ?_).symm⟩
  have hrect : e ⁻¹' Set.univ.pi s = (Set.univ.pi fun i : SingleSpectators a => s i) ×ˢ s a := by
    ext x
    constructor
    · intro hx
      refine ⟨fun i _ => ?_, ?_⟩
      · simpa [e, insertSingleSample, i.property] using hx i trivial
      · simpa [e, insertSingleSample] using hx a trivial
    · intro hx i _
      rcases hx with ⟨hz, hy⟩
      by_cases hi : i = a
      · subst i; simpa [e, insertSingleSample] using hy
      · simpa [e, insertSingleSample, hi] using hz (⟨i, hi⟩ : SingleSpectators a) trivial
  rw [Measure.map_apply hm (MeasurableSet.pi Set.countable_univ fun i _ => hs i),
    hrect, Measure.prod_prod, Measure.pi_pi, Fintype.prod_eq_mul_prod_subtype_ne (fun i => μ i (s i)) a]
  exact mul_comm _ _

private abbrev UnreflectedSpectators {d : ℕ} (J : Finset (Fin d)) (i : Fin d) :=
  SingleSpectators (Sum.inl i : ReflectedSamples J)

private noncomputable def unreflectedSpectatorMeasure {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (k n : Fin d → ℤ) : Measure (UnreflectedSpectators J i → ℝ) :=
  Measure.pi (fun x => reflectedSampleMeasure k n (x : ReflectedSamples J))

private instance {d : ℕ} (J : Finset (Fin d)) (i : Fin d) (k n : Fin d → ℤ) :
    IsProbabilityMeasure (unreflectedSpectatorMeasure J i k n) := by
  unfold unreflectedSpectatorMeasure
  infer_instance

private noncomputable def unreflectedCorner {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (ω : {j : Fin d // j ∈ J} → Bool) (z : UnreflectedSpectators J i → ℝ) (y : ℝ) :
    Fin d → ℝ :=
  cornerPoint J ω (insertSingleSample (Sum.inl i) z y)

private theorem unreflectedCorner_measurable {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (ω : {j : Fin d // j ∈ J} → Bool) :
    Measurable (fun p : (UnreflectedSpectators J i → ℝ) × ℝ => unreflectedCorner J i ω p.1 p.2) :=
  (marginal J (fun _ => 0) (fun _ => 0) ω).measurable.comp
    (insertSingleSample_preserving (Sum.inl i) (reflectedSampleMeasure (fun _ => 0) (fun _ => 0))).measurable

private theorem unreflectedCorner_self {d : ℕ} (J : Finset (Fin d)) {i : Fin d} (hi : i ∉ J)
    (ω : {j : Fin d // j ∈ J} → Bool) (z : UnreflectedSpectators J i → ℝ) (y : ℝ) :
    unreflectedCorner J i ω z y i = y := by
  simp [unreflectedCorner, cornerPoint, cornerIndex, hi, insertSingleSample]

private theorem unreflectedCorner_update {d : ℕ} (J : Finset (Fin d)) {i : Fin d} (hi : i ∉ J)
    (ω : {j : Fin d // j ∈ J} → Bool) (z : UnreflectedSpectators J i → ℝ) (y t : ℝ) :
    Function.update (unreflectedCorner J i ω z y) i t = unreflectedCorner J i ω z t := by
  funext j
  by_cases hj : j = i
  · subst j
    rw [Function.update_self, unreflectedCorner_self J hi]
  · simp [unreflectedCorner, cornerPoint, cornerIndex, insertSingleSample, hj]
    by_cases hJ : j ∈ J <;> simp [hJ, hj]
    by_cases hω : ω ⟨j, hJ⟩ = true <;> simp [hω, hj]

private theorem unreflectedSpectatorMeasure_update {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) (k n : Fin d → ℤ) (l r : ℤ) :
    unreflectedSpectatorMeasure J i (Function.update k i l) (Function.update n i r) =
      unreflectedSpectatorMeasure J i k n := by
  unfold unreflectedSpectatorMeasure
  congr 1
  funext a
  obtain ⟨a, ha⟩ := a
  cases a with
  | inl j =>
    have h : j ≠ i := fun e => ha (congrArg Sum.inl e)
    simp [reflectedSampleMeasure, Function.update_of_ne h]
  | inr j =>
    have h : (j : Fin d) ≠ i := fun e => hi (e ▸ j.property)
    simp [reflectedSampleMeasure, Function.update_of_ne h]


private theorem integrable_of_measurable_abs_le {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} [IsFiniteMeasure μ] {g : Ω → ℝ} (hgm : Measurable g) {C : ℝ}
    (hC : ∀ x, |g x| ≤ C) : Integrable g μ :=
  (MemLp.of_bound (p := 1) hgm.aestronglyMeasurable C
    (Filter.Eventually.of_forall fun x => hC x)).integrable le_rfl

private noncomputable def unreflectedProduct {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (k : Fin d → ℤ) (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (z : UnreflectedSpectators J i → ℝ) (y : ℝ) : ℝ :=
  ∏ ω : ({j : Fin d // j ∈ J} → Bool),
    let x := unreflectedCorner J i ω z y
    H x * ∏ j ∈ Jᶜ, L j (k j) x

private theorem unreflectedProduct_measurable {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (k : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ i l, Measurable (L i l)) :
    Measurable (fun p : (UnreflectedSpectators J i → ℝ) × ℝ =>
      unreflectedProduct J i k H L p.1 p.2) := by
  unfold unreflectedProduct
  apply Finset.measurable_fun_prod
  intro ω _
  have hm := unreflectedCorner_measurable J i ω
  exact (hHm.comp hm).mul (Finset.measurable_fun_prod _ fun r _ => (hLm r (k r)).comp hm)

private theorem abs_unreflectedProduct_le {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (k : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hH : ∀ x, |H x| ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hL : ∀ i l x, |L i l x| ≤ 1)
    (z : UnreflectedSpectators J i → ℝ) (y : ℝ) :
    |unreflectedProduct J i k H L z y| ≤ 1 := by
  unfold unreflectedProduct
  rw [Finset.abs_prod]
  apply Finset.prod_le_one₀ (fun _ _ => abs_nonneg _)
  intro ω _
  dsimp only
  rw [abs_mul, Finset.abs_prod]
  exact (mul_le_of_le_one_right (abs_nonneg _) (Finset.prod_le_one₀
    (fun _ _ => abs_nonneg _) (fun r _ => hL r (k r) _))).trans (hH _)

private theorem reflectedBox_integral_unreflected {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH : ∀ x, |H x| ≤ 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l)) (hL : ∀ i l x, |L i l x| ≤ 1) :
    reflectedBox J k n H L = ∫ z, ∫ y, unreflectedProduct J i k H L z y
      ∂dyadicIntervalProbability (k i) (n i) ∂unreflectedSpectatorMeasure J i k n := by
  let a : ReflectedSamples J := Sum.inl i
  let ν := unreflectedSpectatorMeasure J i k n
  let μ := dyadicIntervalProbability (k i) (n i)
  let Z := UnreflectedSpectators J i → ℝ
  let e (p : Z × ℝ) := insertSingleSample a p.1 p.2
  have hp : MeasurePreserving e (ν.prod μ) (cornerProbability J k n) :=
    insertSingleSample_preserving a (reflectedSampleMeasure k n)
  let F (x : ReflectedSamples J → ℝ) := ∏ ω : ({j : Fin d // j ∈ J} → Bool),
    H (cornerPoint J ω x) * ∏ r ∈ Jᶜ, L r (k r) (cornerPoint J ω x)
  have hFm : Measurable F := Finset.measurable_fun_prod _ (fun ω _ =>
    let hm := (marginal J k n ω).measurable
    (hHm.comp hm).mul (Finset.measurable_fun_prod _ (fun r _ => (hLm r (k r)).comp hm)))
  have hmap := integral_map (μ := ν.prod μ) hp.measurable.aemeasurable (f := F) hFm.aestronglyMeasurable
  rw [hp.map_eq] at hmap
  change (∫ x, F x ∂cornerProbability J k n) = _
  rw [hmap]
  let _ : IsProbabilityMeasure ν := inferInstanceAs (IsProbabilityMeasure (unreflectedSpectatorMeasure J i k n))
  let _ : IsProbabilityMeasure μ := dyadicIntervalProbability_isProbability _ _
  have hi : Integrable (fun p => F (e p)) (ν.prod μ) :=
    integrable_of_measurable_abs_le (hFm.comp hp.measurable)
      (fun p => abs_unreflectedProduct_le J i k hH hL p.1 p.2)
  exact integral_prod _ hi

private theorem reflectedBoxDifference_integral_unreflected {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ}
    (hHm : Measurable H) (hH : ∀ x, |H x| ≤ 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i l, Measurable (L i l)) (hL : ∀ i l x, |L i l x| ≤ 1) :
    let k' := Function.update k i (k i+1)
    reflectedBoxDifference J i k n H L =
      ∫ z, ∫ y, unreflectedProduct J i k' H L z y - unreflectedProduct J i k H L z y
        ∂dyadicIntervalProbability (k i) (n i) ∂unreflectedSpectatorMeasure J i k n := by
  dsimp only
  let k' := Function.update k i (k i+1)
  let ν := unreflectedSpectatorMeasure J i k n
  let Z := UnreflectedSpectators J i → ℝ
  let M (l r : ℤ) := dyadicIntervalProbability l r
  let C (l : Fin d → ℤ) (z : Z) (y : ℝ) := unreflectedProduct J i l H L z y
  let _ : IsProbabilityMeasure ν := inferInstanceAs (IsProbabilityMeasure (unreflectedSpectatorMeasure J i k n))
  have hprod (l : Fin d → ℤ) (r s : ℤ) :
      Integrable (fun z => ∫ y, C l z y ∂M r s) ν := by
    have hm := unreflectedProduct_measurable J i l hHm hLm
    apply integrable_of_measurable_abs_le (hm.stronglyMeasurable.integral_prod_right' (ν := M r s)).measurable
    intro z
    have h := norm_integral_le_of_norm_le_const (μ := M r s) (C := 1) (f := C l z)
      (Filter.Eventually.of_forall fun y => by rw [Real.norm_eq_abs]; exact abs_unreflectedProduct_le J i l hH hL z y)
    simpa [M, measureReal_def] using h
  have hf (l : Fin d → ℤ) (r s : ℤ) (z : Z) : Integrable (C l z) (M r s) :=
    integrable_of_measurable_abs_le ((unreflectedProduct_measurable J i l hHm hLm).comp
      (measurable_const.prodMk measurable_id)) (fun y => abs_unreflectedProduct_le J i l hH hL z y)
  unfold reflectedBoxDifference
  dsimp only
  rw [reflectedBox_integral_unreflected J i k' (Function.update n i (2*n i)) hHm hH hLm hL,
    reflectedBox_integral_unreflected J i k' (Function.update n i (2*n i+1)) hHm hH hLm hL,
    reflectedBox_integral_unreflected J i k n hHm hH hLm hL,
    unreflectedSpectatorMeasure_update J i hi, unreflectedSpectatorMeasure_update J i hi]
  have hk' : k' i = k i+1 := Function.update_self i _ _
  simp only [Function.update_self, hk']
  change ((∫ z, ∫ y, C k' z y ∂M (k i+1) (2*n i) ∂ν) +
    (∫ z, ∫ y, C k' z y ∂M (k i+1) (2*n i+1) ∂ν))/2 -
    (∫ z, ∫ y, C k z y ∂M (k i) (n i) ∂ν) = _
  rw [← integral_add (hprod _ _ _) (hprod _ _ _), div_eq_mul_inv,
    mul_comm _ ((2 : ℝ)⁻¹), ← integral_const_mul]
  have hchild : (∫ z, (2 : ℝ)⁻¹ *
      ((∫ y, C k' z y ∂M (k i+1) (2*n i)) + (∫ y, C k' z y ∂M (k i+1) (2*n i+1))) ∂ν) =
      ∫ z, ∫ y, C k' z y ∂M (k i) (n i) ∂ν := by
    apply integral_congr_ae
    filter_upwards with z
    change _ = ∫ y, C k' z y ∂dyadicIntervalProbability (k i) (n i)
    rw [dyadicIntervalProbability_integral_children (k i) (n i) (C k' z)
      ((unreflectedProduct_measurable J i k' hHm hLm).comp (measurable_const.prodMk measurable_id))
      (fun y => abs_unreflectedProduct_le J i k' hH hL z y)]
    rw [div_eq_mul_inv, mul_comm]
  rw [hchild, ← integral_sub (hprod _ _ _) (hprod _ _ _)]
  apply integral_congr_ae
  filter_upwards with z
  exact (integral_sub (hf _ _ _ z) (hf _ _ _ z)).symm


private noncomputable def unreflectedCore {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (k : Fin d → ℤ) (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (z : UnreflectedSpectators J i → ℝ) (y : ℝ) : ℝ :=
  ∏ ω : ({j : Fin d // j ∈ J} → Bool),
    let x := unreflectedCorner J i ω z y
    H x * ∏ j ∈ Jᶜ.erase i, L j (k j) x

private theorem unreflectedProduct_factor {d : ℕ} (J : Finset (Fin d)) (i : Fin d) (hi : i ∉ J)
    (k : Fin d → ℤ) (l : ℤ) (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (z : UnreflectedSpectators J i → ℝ) (y : ℝ) :
    unreflectedProduct J i (Function.update k i l) H L z y =
      unreflectedCore J i k H L z y *
        ∏ ω : ({j : Fin d // j ∈ J} → Bool), L i l (unreflectedCorner J i ω z y) := by
  classical
  unfold unreflectedProduct unreflectedCore
  rw [← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro ω _
  dsimp only
  let x := unreflectedCorner J i ω z y
  have h : (∏ j ∈ Jᶜ.erase i, L j (Function.update k i l j) x) =
      ∏ j ∈ Jᶜ.erase i, L j (k j) x := by
    apply Finset.prod_congr rfl
    intro j hj
    rw [Function.update_of_ne (Finset.mem_erase.mp hj).1]
  rw [← Finset.mul_prod_erase Jᶜ _ (Finset.mem_compl.mpr hi), Function.update_self, h]
  ring

private noncomputable def dyadicLeftEndpoint (k n : ℤ) : ℝ := (n : ℝ) * (2 : ℝ)^(-k)

private theorem dyadicLeftEndpoint_mem (k n : ℤ) :
    dyadicLeftEndpoint k n ∈ dyadicInterval k n := by
  constructor
  · exact le_rfl
  · unfold dyadicLeftEndpoint
    exact mul_lt_mul_of_pos_right (lt_add_one (n : ℝ)) (by positivity)

private theorem unreflectedCorner_const_on_cell {d : ℕ} (J : Finset (Fin d))
    {i : Fin d} (hi : i ∉ J) {k n : ℤ} {g : (Fin d → ℝ) → ℝ}
    (hg : constantOnCoordinateCells i k g) (ω : {j : Fin d // j ∈ J} → Bool)
    (z : UnreflectedSpectators J i → ℝ) {y : ℝ} (hy : y ∈ dyadicInterval k n) :
    g (unreflectedCorner J i ω z y) = g (unreflectedCorner J i ω z (dyadicLeftEndpoint k n)) := by
  rw [← unreflectedCorner_update J hi ω z (dyadicLeftEndpoint k n) y]
  apply hg
  rw [unreflectedCorner_self J hi]
  exact (mem_dyadicInterval_iff.mp hy).trans (mem_dyadicInterval_iff.mp
    (dyadicLeftEndpoint_mem k n)).symm

private theorem unreflectedProduct_sub_expand {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) (k n : Fin d → ℤ)
    (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (P D : (Fin d → ℝ) → ℝ) (hA : constantOnCoordinateCells i (k i) (L i (k i)))
    (hP : constantOnCoordinateCells i (k i) P) (hD : constantOnCoordinateCells i (k i) D)
    (hchild : ∀ x : Fin d → ℝ, x i ∈ dyadicInterval (k i) (n i) →
      L i (k i+1) x = L i (k i) x + P x + dyadicHaar (k i) (n i) (x i) * D x)
    (z : UnreflectedSpectators J i → ℝ) {y : ℝ} (hy : y ∈ dyadicInterval (k i) (n i)) :
    let I := {j : Fin d // j ∈ J} → Bool
    let x (ω : I) := unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i))
    unreflectedProduct J i (Function.update k i (k i+1)) H L z y -
       unreflectedProduct J i k H L z y =
      unreflectedCore J i k H L z y *
        ∑ s ∈ (Finset.univ : Finset (I → Fin 3)).erase (fun _ => 0),
          childExpansionTerm (fun ω => L i (k i) (x ω)) (fun ω => P (x ω)) (fun ω => D (x ω))
            (dyadicHaar (k i) (n i) y) s := by
  classical
  dsimp only
  let I := {j : Fin d // j ∈ J} → Bool
  let x (ω : I) := unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i))
  let xy (ω : I) := unreflectedCorner J i ω z y
  have hp : unreflectedProduct J i k H L z y =
      unreflectedCore J i k H L z y * ∏ ω : I, L i (k i) (xy ω) := by
    have h := unreflectedProduct_factor J i hi k (k i) H L z y
    rwa [Function.update_eq_self] at h
  rw [unreflectedProduct_factor J i hi k (k i+1) H L z y, hp, ← mul_sub]
  congr 1
  have hAx (ω : I) : L i (k i) (xy ω) = L i (k i) (x ω) :=
    unreflectedCorner_const_on_cell J hi hA ω z hy
  have hCh (ω : I) : L i (k i+1) (xy ω) =
      L i (k i) (x ω) + P (x ω) + dyadicHaar (k i) (n i) y * D (x ω) := by
    have he : (xy ω) i = y := unreflectedCorner_self J hi ω z y
    rw [hchild _ (he.symm ▸ hy), he, hAx,
      unreflectedCorner_const_on_cell J hi hP ω z hy,
      unreflectedCorner_const_on_cell J hi hD ω z hy]
  change (∏ ω : I, L i (k i+1) (xy ω)) - (∏ ω : I, L i (k i) (xy ω)) = _
  simp_rw [hCh, hAx]
  exact childExpansion_product_sub _ _ _ _


private theorem unreflectedCore_measurable {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (k : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ j r, Measurable (L j r)) :
    Measurable (fun p : (UnreflectedSpectators J i → ℝ) × ℝ => unreflectedCore J i k H L p.1 p.2) := by
  unfold unreflectedCore
  apply Finset.measurable_fun_prod
  intro ω _
  have hm := unreflectedCorner_measurable J i ω
  exact (hHm.comp hm).mul (Finset.measurable_fun_prod _ fun j _ => (hLm j (k j)).comp hm)

private theorem unreflectedCore_abs_le {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (k : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hH : ∀ x, |H x| ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (σ : Fin d → ℝ) (_hσ : ∀ j, 0 ≤ σ j) (hL : ∀ j r x, |L j r x| ≤ σ j)
    (z : UnreflectedSpectators J i → ℝ) (y : ℝ) :
    |unreflectedCore J i k H L z y| ≤ ∏ j ∈ Jᶜ.erase i, σ j ^ (2^J.card : ℕ) := by
  classical
  let θ : ℝ := ∏ j ∈ Jᶜ.erase i, σ j
  let ι := {j : Fin d // j ∈ J} → Bool
  have hc : Fintype.card ι = 2^J.card := by simp [ι, Fintype.card_pi]
  unfold unreflectedCore
  rw [Finset.abs_prod, Finset.prod_pow, ← hc, ← Finset.card_univ, ← Finset.prod_const]
  apply Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _)
  intro ω _
  dsimp only
  rw [abs_mul, Finset.abs_prod]
  have hh : (∏ j ∈ Jᶜ.erase i, |L j (k j) (unreflectedCorner J i ω z y)|) ≤ θ :=
    Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _) (fun j _ => hL j (k j) _)
  exact (mul_le_of_le_one_left (Finset.prod_nonneg fun _ _ => abs_nonneg _) (hH _)).trans hh

private theorem childExpansionTerm_measurable {ι Z : Type*} [Fintype ι] [MeasurableSpace Z]
    {A P D : ι → Z → ℝ} (hA : ∀ i, Measurable (A i)) (hP : ∀ i, Measurable (P i))
    (hD : ∀ i, Measurable (D i)) (s : ι → Fin 3) :
    Measurable (fun z => childExpansionTerm (fun i => A i z) (fun i => P i z) (fun i => D i z) 1 s) := by
  unfold childExpansionTerm
  apply Finset.measurable_fun_prod
  intro i _
  split
  · exact hA i
  split
  · exact hP i
  · exact measurable_const.mul (hD i)

private theorem childExpansionTerm_abs_le {ι : Type*} [Fintype ι]
    (A P D : ι → ℝ) {B : ℝ}
    (hA : ∀ i, |A i| ≤ B) (hP : ∀ i, |P i| ≤ B) (hD : ∀ i, |D i| ≤ B) (s : ι → Fin 3) :
    |childExpansionTerm A P D 1 s| ≤ B^(Fintype.card ι) := by
  unfold childExpansionTerm
  rw [Finset.abs_prod, ← Finset.card_univ, ← Finset.prod_const]
  apply Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _)
  intro i _
  split
  · exact hA i
  split
  · exact hP i
  · simpa only [one_mul] using hD i

private theorem measurable_dyadicHaar (k n : ℤ) : Measurable (dyadicHaar k n) :=
  (measurable_const.indicator (measurableSet_Ico : MeasurableSet (dyadicInterval (k+1) (2*n)))).sub
    (measurable_const.indicator (measurableSet_Ico : MeasurableSet (dyadicInterval (k+1) (2*n+1))))

private noncomputable def anchoredChildTerm {d : ℕ} (J : Finset (Fin d)) (i : Fin d) (k n : Fin d → ℤ)
    (L : Fin d → ℤ → (Fin d → ℝ) → ℝ) (P D : (Fin d → ℝ) → ℝ)
    (s : ({j : Fin d // j ∈ J} → Bool) → Fin 3) (z : UnreflectedSpectators J i → ℝ) : ℝ :=
  let x (ω : {j : Fin d // j ∈ J} → Bool) := unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i))
  childExpansionTerm (fun ω => L i (k i) (x ω)) (fun ω => P (x ω)) (fun ω => D (x ω)) 1 s

private noncomputable def unreflectedTest {d : ℕ} (J : Finset (Fin d)) (i : Fin d) (k n : Fin d → ℤ)
    (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (m : ℕ) (z : UnreflectedSpectators J i → ℝ) : ℝ :=
  ∫ y, unreflectedCore J i k H L z y * (dyadicHaar (k i) (n i) y)^m
    ∂dyadicIntervalProbability (k i) (n i)

private noncomputable def unreflectedExpansionContribution {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (k n : Fin d → ℤ) (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (P D : (Fin d → ℝ) → ℝ) (s : ({j : Fin d // j ∈ J} → Bool) → Fin 3) : ℝ :=
  ∫ z, anchoredChildTerm J i k n L P D s z *
    unreflectedTest J i k n H L ((Finset.univ.filter (fun ω => s ω = 2)).card) z
      ∂unreflectedSpectatorMeasure J i k n


private theorem anchoredChildTerm_measurable {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (k n : Fin d → ℤ) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ j r, Measurable (L j r)) {P D : (Fin d → ℝ) → ℝ}
    (hPm : Measurable P) (hDm : Measurable D)
    (s : ({j : Fin d // j ∈ J} → Bool) → Fin 3) :
    Measurable (anchoredChildTerm J i k n L P D s) := by
  have hx (ω : {j : Fin d // j ∈ J} → Bool) :
      Measurable (fun z : UnreflectedSpectators J i → ℝ =>
        unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i))) :=
    (unreflectedCorner_measurable J i ω).comp (measurable_id.prodMk measurable_const)
  exact childExpansionTerm_measurable (fun ω => (hLm i (k i)).comp (hx ω))
    (fun ω => hPm.comp (hx ω)) (fun ω => hDm.comp (hx ω)) s

private theorem unreflectedTest_measurable {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ j r, Measurable (L j r)) (m : ℕ) :
    Measurable (unreflectedTest J i k n H L m) := by
  have hm := (unreflectedCore_measurable J i k hHm hLm).mul
    (((measurable_dyadicHaar (k i) (n i)).comp measurable_snd).pow_const m)
  exact (hm.stronglyMeasurable.integral_prod_right' (ν := dyadicIntervalProbability (k i) (n i))).measurable

private theorem abs_unreflectedTest_le {d : ℕ} (J : Finset (Fin d)) (i : Fin d) (k n : Fin d → ℤ)
    {H : (Fin d → ℝ) → ℝ} (hH : ∀ x, |H x| ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (σ : Fin d → ℝ) (hσ : ∀ j, 0 ≤ σ j) (hL : ∀ j r x, |L j r x| ≤ σ j)
    (m : ℕ) (z : UnreflectedSpectators J i → ℝ) :
    |unreflectedTest J i k n H L m z| ≤ ∏ j ∈ Jᶜ.erase i, σ j ^ (2^J.card : ℕ) := by
  have h := norm_integral_le_of_norm_le_const (μ := dyadicIntervalProbability (k i) (n i))
    (C := ∏ j ∈ Jᶜ.erase i, σ j ^ (2^J.card : ℕ))
    (f := fun y => unreflectedCore J i k H L z y * (dyadicHaar (k i) (n i) y)^m)
    (Filter.Eventually.of_forall fun y => by
      rw [Real.norm_eq_abs, abs_mul, abs_pow]
      exact (mul_le_of_le_one_right (abs_nonneg _) (pow_le_one₀ (abs_nonneg _)
        (abs_dyadicHaar_le_one y))).trans (unreflectedCore_abs_le J i k hH σ hσ hL z y))
  simpa only [measureReal_def, measure_univ, ENNReal.toReal_one, mul_one, Real.norm_eq_abs,
    unreflectedTest] using h

private theorem unreflectedExpansion_exact {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ}
    (hHm : Measurable H) (hH : ∀ x, |H x| ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ j r, Measurable (L j r))
    (hL : ∀ j r x, |L j r x| ≤ 1) {P D : (Fin d → ℝ) → ℝ}
    (hPm : Measurable P) (hDm : Measurable D)
    (hP2 : ∀ x, |P x| ≤ 2) (hD1 : ∀ x, |D x| ≤ 1)
    (hA : constantOnCoordinateCells i (k i) (L i (k i)))
    (hP : constantOnCoordinateCells i (k i) P) (hD : constantOnCoordinateCells i (k i) D)
    (hchild : ∀ x : Fin d → ℝ, x i ∈ dyadicInterval (k i) (n i) →
      L i (k i+1) x = L i (k i) x + P x + dyadicHaar (k i) (n i) (x i) * D x) :
    reflectedBoxDifference J i k n H L =
      ∑ s ∈ (Finset.univ : Finset (({j : Fin d // j ∈ J} → Bool) → Fin 3)).erase (fun _ => 0),
        unreflectedExpansionContribution J i k n H L P D s := by
  classical
  let k' := Function.update k i (k i+1)
  let μ := dyadicIntervalProbability (k i) (n i)
  let ν := unreflectedSpectatorMeasure J i k n
  let Z := UnreflectedSpectators J i → ℝ
  let I := {j : Fin d // j ∈ J} → Bool
  let S : Finset (I → Fin 3) := Finset.univ.erase (fun _ => 0)
  let C := unreflectedCore J i k H L
  let haar := dyadicHaar (k i) (n i)
  let a (s : I → Fin 3) := (Finset.univ.filter fun ω => s ω = 2).card
  let E (s : I → Fin 3) := anchoredChildTerm J i k n L P D s
  let T (s : I → Fin 3) := unreflectedTest J i k n H L (a s)
  let _ : IsProbabilityMeasure μ := dyadicIntervalProbability_isProbability _ _
  let _ : IsProbabilityMeasure ν := inferInstanceAs (IsProbabilityMeasure (unreflectedSpectatorMeasure J i k n))
  have hC0 (z : Z) (y : ℝ) : |C z y| ≤ 1 := by
    simpa using unreflectedCore_abs_le J i k hH (fun _ => 1) (fun _ => zero_le_one) hL z y
  have hE0 (s : I → Fin 3) (z : Z) : |E s z| ≤ (2 : ℝ)^Fintype.card I := by
    unfold E anchoredChildTerm
    exact childExpansionTerm_abs_le _ _ _
      (fun ω => (hL i (k i) _).trans (by norm_num)) (fun ω => hP2 _)
      (fun ω => (hD1 _).trans (by norm_num)) s
  have hT0 (s : I → Fin 3) (z : Z) : |T s z| ≤ 1 := by
    simpa using abs_unreflectedTest_le J i k n hH (fun _ => 1) (fun _ => zero_le_one) hL (a s) z
  have hai (s : I → Fin 3) : Integrable (fun z => E s z * T s z) ν :=
    integrable_of_measurable_abs_le
      ((anchoredChildTerm_measurable J i k n hLm hPm hDm s).mul
        (unreflectedTest_measurable J i k n hHm hLm (a s))) (fun z => by
      rw [abs_mul]
      exact (mul_le_of_le_one_right (abs_nonneg _) (hT0 s z)).trans (hE0 s z))
  have hgi (s : I → Fin 3) (z : Z) :
      Integrable (fun y => E s z * (C z y * (haar y)^(a s))) μ := by
    have hCm : Measurable (C z) := (unreflectedCore_measurable J i k hHm hLm).comp
      (measurable_const.prodMk measurable_id)
    apply integrable_of_measurable_abs_le (measurable_const.mul
      (hCm.mul ((measurable_dyadicHaar (k i) (n i)).pow_const (a s))))
    intro y
    change |E s z * (C z y * (haar y)^(a s))| ≤ (2 : ℝ)^Fintype.card I
    rw [abs_mul, abs_mul, abs_pow]
    exact (mul_le_of_le_one_right (abs_nonneg _)
      ((mul_le_of_le_one_right (abs_nonneg _) (pow_le_one₀ (abs_nonneg _)
        (abs_dyadicHaar_le_one y))).trans (hC0 z y))).trans (hE0 s z)
  have hae : ∀ᵐ y ∂μ, y ∈ dyadicInterval (k i) (n i) :=
    Measure.ae_smul_measure (ae_restrict_mem measurableSet_Ico) _
  have hlocal (z : Z) :
      (∫ y, unreflectedProduct J i k' H L z y - unreflectedProduct J i k H L z y ∂μ) =
        ∑ s ∈ S, E s z * T s z := by
    have hterm (s : I → Fin 3) : E s z * T s z =
        ∫ y, E s z * (C z y * (haar y)^(a s)) ∂μ :=
      (integral_const_mul _ _).symm
    simp_rw [hterm]
    rw [← integral_finsetSum _ (fun s _ => hgi s z)]
    apply integral_congr_ae
    filter_upwards [hae] with y hy
    rw [unreflectedProduct_sub_expand J i hi k n H L P D hA hP hD hchild z hy]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro s _
    rw [childExpansionTerm_eq_factor]
    change C z y * ((haar y)^(a s) * E s z) = E s z * (C z y * (haar y)^(a s))
    ring
  rw [reflectedBoxDifference_integral_unreflected J i hi k n hHm hH hLm hL]
  change (∫ z : Z, ∫ y, unreflectedProduct J i k' H L z y - unreflectedProduct J i k H L z y ∂μ ∂ν) = _
  simp_rw [hlocal]
  rw [integral_finsetSum _ (fun s _ => hai s)]
  rfl


private theorem unreflectedCorner_integral_anchor {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) (k n : Fin d → ℤ)
    (ω : {j : Fin d // j ∈ J} → Bool) {g : (Fin d → ℝ) → ℝ}
    (hgm : Measurable g) {C : ℝ} (hg : ∀ x, |g x| ≤ C)
    (hconst : constantOnCoordinateCells i (k i) g) :
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      (∫ z, g (unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i)))
        ∂unreflectedSpectatorMeasure J i k n) =
      ∫ x in dyadicRectangle k n, g x := by
  let Z := UnreflectedSpectators J i → ℝ
  let μ := dyadicIntervalProbability (k i) (n i)
  let ν := unreflectedSpectatorMeasure J i k n
  let v := (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n)
  let _ : IsProbabilityMeasure μ := dyadicIntervalProbability_isProbability _ _
  let _ : IsProbabilityMeasure ν := inferInstanceAs (IsProbabilityMeasure (unreflectedSpectatorMeasure J i k n))
  let φ (p : Z × ℝ) := unreflectedCorner J i ω p.1 p.2
  have hφ : MeasurePreserving φ (ν.prod μ) (rectangleProbability k n) :=
    (marginal J k n ω).comp (insertSingleSample_preserving (Sum.inl i) (reflectedSampleMeasure k n))
  have hgI : Integrable (fun p => g (φ p)) (ν.prod μ) :=
    integrable_of_measurable_abs_le (hgm.comp hφ.measurable)
    (fun p => hg (φ p))
  have he := integral_map (μ := ν.prod μ) hφ.measurable.aemeasurable (f := g) hgm.aestronglyMeasurable
  rw [hφ.map_eq, integral_prod _ hgI] at he
  rw [← volume_mul_integral_rectangleProbability k n g, he]
  congr 1
  apply integral_congr_ae
  filter_upwards with z
  have hae : ∀ᵐ y ∂μ, y ∈ dyadicInterval (k i) (n i) :=
    Measure.ae_smul_measure (ae_restrict_mem measurableSet_Ico) _
  symm
  calc
    _ = ∫ _ : ℝ, g (unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i))) ∂μ := by
      apply integral_congr_ae
      filter_upwards [hae] with y hy
      exact unreflectedCorner_const_on_cell J hi hconst ω z hy
    _ = _ := by simp [measureReal_def]

private theorem abs_childExpansion_drift_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A P D : ι → ℝ) {σ : ℝ} (hσ : 0 ≤ σ)
    (hA : ∀ i, |A i| ≤ σ) (hP : ∀ i, |P i| ≤ 2*σ) (hD : ∀ i, |D i| ≤ σ)
    (s : ι → Fin 3) (α : ι) (hα : s α = 1) :
    |childExpansionTerm A P D 1 s| ≤ |P α| * (2*σ)^(Fintype.card ι-1) := by
  unfold childExpansionTerm
  rw [Fintype.prod_eq_mul_prod_subtype_ne _ α, abs_mul]
  simp only [hα, show (1 : Fin 3) ≠ 0 by decide, ite_false, ite_true, Finset.abs_prod]
  apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
  rw [show Fintype.card ι - 1 = Fintype.card {i : ι // i ≠ α} by
    rw [Fintype.card_subtype_compl (fun i : ι => i = α)]; simp]
  rw [← Finset.card_univ, ← Finset.prod_const]
  apply Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _)
  intro i _
  split
  · exact (hA i).trans (by linarith)
  split
  · exact hP i
  · simpa only [one_mul] using (hD i).trans (show σ ≤ 2*σ by linarith)

private theorem abs_childExpansion_two_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A P D : ι → ℝ) {σ : ℝ} (hσ : 0 ≤ σ)
    (hA : ∀ i, |A i| ≤ σ) (hD : ∀ i, |D i| ≤ σ)
    (s : ι → Fin 3) (hnoP : ∀ i, s i ≠ 1)
    (α β : ι) (hαβ : α ≠ β) (hα : s α = 2) (hβ : s β = 2) :
    |childExpansionTerm A P D 1 s| ≤
      σ^(Fintype.card ι-2) * ((D α)^2 + (D β)^2)/2 := by
  let ι' := {i : ι // i ≠ α}
  let β' : ι' := ⟨β, hαβ.symm⟩
  let F (i : ι) := if s i = 0 then A i else if s i = 1 then P i else 1 * D i
  let ι'' := {i : ι' // i ≠ β'}
  have hFα : F α = D α := by simp [F, hα]
  have hFβ : F β = D β := by simp [F, hβ]
  have hF (i : ι) : |F i| ≤ σ := by
    by_cases h : s i = 0
    · simpa only [F, ite_eq_left h] using hA i
    · simpa only [F, ite_eq_right h, ite_eq_right (hnoP i), one_mul] using hD i
  have hcard : Fintype.card ι'' = Fintype.card ι - 2 := by
    have h₁ : Fintype.card ι' = Fintype.card ι - 1 := by
      change Fintype.card {i : ι // i ≠ α} = _
      rw [Fintype.card_subtype_compl (fun i : ι => i = α)]
      simp
    change Fintype.card {i : ι' // i ≠ β'} = _
    rw [Fintype.card_subtype_compl (fun i : ι' => i = β')]
    simp only [Fintype.card_unique, h₁]
    omega
  change |∏ i, F i| ≤ _
  rw [Fintype.prod_eq_mul_prod_subtype_ne F α, Fintype.prod_eq_mul_prod_subtype_ne
    (fun i : ι' => F i) β', hFα, show F (β' : ι) = D β from hFβ, abs_mul, abs_mul]
  have hp : |∏ i : ι'', F i.val.val| ≤ σ ^ (Fintype.card ι - 2) := by
    rw [Finset.abs_prod, ← hcard, ← Finset.card_univ, ← Finset.prod_const]
    exact Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _) (fun i _ => hF i.val.val)
  have hq : |D α| * |D β| ≤ ((D α)^2 + (D β)^2)/2 := by
    nlinarith [sq_abs (D α), sq_abs (D β), sq_nonneg (|D α|-|D β|)]
  rw [← mul_assoc]
  exact (mul_le_mul hq hp (abs_nonneg _) (by positivity [hσ])).trans_eq (by ring)


private theorem weighted_unreflectedExpansion_majorant {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ}
    (hH : ∀ x, |H x| ≤ 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (σ : Fin d → ℝ) (hσ : ∀ j, 0 ≤ σ j) (hL : ∀ j r x, |L j r x| ≤ σ j)
    (P D : (Fin d → ℝ) → ℝ) (s : ({j : Fin d // j ∈ J} → Bool) → Fin 3)
    (S : Finset ({j : Fin d // j ∈ J} → Bool)) {g : (Fin d → ℝ) → ℝ} (hgm : Measurable g)
    (hgn : ∀ x, 0 ≤ g x) {M : ℝ} (hgM : ∀ x, |g x| ≤ M)
    (hg : constantOnCoordinateCells i (k i) g) {K : ℝ} (hK : 0 ≤ K)
    (hE : ∀ z, |anchoredChildTerm J i k n L P D s z| ≤
      K * ∑ ω ∈ S, g (unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i)))) :
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      |unreflectedExpansionContribution J i k n H L P D s| ≤
      (∏ j ∈ Jᶜ.erase i, σ j ^ (2^J.card : ℕ)) * K * S.card * ∫ x in dyadicRectangle k n, g x := by
  let ι := {j : Fin d // j ∈ J} → Bool
  let Z := UnreflectedSpectators J i → ℝ
  let ν := unreflectedSpectatorMeasure J i k n
  let a := (Finset.univ.filter fun ω => s ω = 2).card
  let C := ∏ j ∈ Jᶜ.erase i, σ j ^ (2^J.card : ℕ)
  let v := (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n)
  let R (ω : ι) (z : Z) :=
    g (unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i)))
  let E := anchoredChildTerm J i k n L P D s
  let T := unreflectedTest J i k n H L a
  have hC : 0 ≤ C := Finset.prod_nonneg fun j _ => pow_nonneg (hσ j) _
  have hv : 0 ≤ v := (realVolume_dyadicRectangle_pos k n).le
  let _ : IsProbabilityMeasure ν := inferInstanceAs (IsProbabilityMeasure (unreflectedSpectatorMeasure J i k n))
  have hRi (ω : ι) : Integrable (R ω) ν :=
    integrable_of_measurable_abs_le (hgm.comp ((unreflectedCorner_measurable J i ω).comp
      (measurable_id.prodMk measurable_const))) (fun z => hgM _)
  have hPoint (z : Z) : |E z * T z| ≤ (C*K) * ∑ ω ∈ S, R ω z := by
    rw [abs_mul]
    have h := mul_le_mul (hE z) (abs_unreflectedTest_le J i k n hH σ hσ hL a z)
      (abs_nonneg _) (mul_nonneg hK (Finset.sum_nonneg fun _ _ => hgn _))
    exact h.trans_eq (by ring)
  have hR (ω : ι) : v * (∫ z : Z, R ω z ∂ν) = ∫ x in dyadicRectangle k n, g x :=
    unreflectedCorner_integral_anchor J i hi k n ω hgm hgM hg
  have h := abs_integral_le_integral_abs.trans (integral_mono_of_nonneg
    (Filter.Eventually.of_forall fun z => abs_nonneg (E z * T z))
    ((integrable_finsetSum S (fun ω _ => hRi ω)).const_mul (C*K))
    (Filter.Eventually.of_forall hPoint))
  change v * |∫ z, E z * T z ∂ν| ≤ _
  refine (mul_le_mul_of_nonneg_left h hv).trans_eq ?_
  rw [integral_const_mul, integral_finsetSum _ (fun ω _ => hRi ω)]
  change v * ((C*K) * ∑ ω ∈ S, ∫ z : Z, R ω z ∂ν) = _
  rw [mul_left_comm v, Finset.mul_sum]
  simp only [hR, Finset.sum_const, nsmul_eq_mul, mul_assoc, C]


private theorem unreflectedExpansion_drift_le {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (hi : i ∉ J) (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hH : ∀ x, |H x| ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (σ : Fin d → ℝ) (hσ : ∀ j, 0 ≤ σ j)
    (hL : ∀ j r x, |L j r x| ≤ σ j) {P D : (Fin d → ℝ) → ℝ}
    (hPm : Measurable P) (hP : constantOnCoordinateCells i (k i) P)
    (hP2 : ∀ x, |P x| ≤ 2*σ i) (hD1 : ∀ x, |D x| ≤ σ i)
    (s : ({j : Fin d // j ∈ J} → Bool) → Fin 3)
    (α : {j : Fin d // j ∈ J} → Bool) (hα : s α = 1) :
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      |unreflectedExpansionContribution J i k n H L P D s| ≤
      (∏ j ∈ Jᶜ.erase i, σ j ^ (2^J.card : ℕ)) * (2*σ i)^((2^J.card : ℕ)-1) *
        ∫ x in dyadicRectangle k n, |P x| := by
  classical
  let ι := {j : Fin d // j ∈ J} → Bool
  have hc : Fintype.card ι = 2^J.card := by simp [ι, Fintype.card_pi]
  have hp : constantOnCoordinateCells i (k i) (fun x => |P x|) := by
    intro x t ht
    exact congrArg abs (hP x t ht)
  have hK : 0 ≤ (2*σ i)^((2^J.card : ℕ)-1) := by positivity [hσ i]
  have he := weighted_unreflectedExpansion_majorant J i hi k n hH σ hσ hL P D s
    {α} (g := fun x => |P x|) (continuous_abs.measurable.comp hPm) (fun x => abs_nonneg (P x))
    (fun x => (abs_abs _).le.trans (hP2 x)) hp hK
  refine (he ?_).trans_eq (by simp)
  intro z
  let x (ω : ι) := unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i))
  have h := abs_childExpansion_drift_le (fun ω => L i (k i) (x ω)) (fun ω => P (x ω))
    (fun ω => D (x ω)) (hσ i) (fun ω => hL i (k i) (x ω)) (fun ω => hP2 (x ω))
    (fun ω => hD1 (x ω)) s α hα
  simpa only [anchoredChildTerm, Finset.sum_singleton, mul_comm, hc, x] using h

private theorem unreflectedExpansion_two_le {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (hi : i ∉ J) (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hH : ∀ x, |H x| ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (σ : Fin d → ℝ) (hσ : ∀ j, 0 ≤ σ j)
    (hL : ∀ j r x, |L j r x| ≤ σ j) {P D : (Fin d → ℝ) → ℝ}
    (hDm : Measurable D) (hD : constantOnCoordinateCells i (k i) D)
    (hD1 : ∀ x, |D x| ≤ σ i)
    (s : ({j : Fin d // j ∈ J} → Bool) → Fin 3) (hnoP : ∀ j, s j ≠ 1)
    (α β : {j : Fin d // j ∈ J} → Bool) (hαβ : α ≠ β) (hα : s α = 2) (hβ : s β = 2) :
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      |unreflectedExpansionContribution J i k n H L P D s| ≤
      (∏ j ∈ Jᶜ.erase i, σ j ^ (2^J.card : ℕ)) * (σ i)^((2^J.card : ℕ)-2) *
        ∫ x in dyadicRectangle k n, (D x)^2 := by
  classical
  let ι := {j : Fin d // j ∈ J} → Bool
  have hc : Fintype.card ι = 2^J.card := by simp [ι, Fintype.card_pi]
  have hd : constantOnCoordinateCells i (k i) (fun x => (D x)^2) := by
    intro x t ht
    exact congrArg (fun a : ℝ => a^2) (hD x t ht)
  have hK : 0 ≤ (σ i)^((2^J.card : ℕ)-2) / 2 := by positivity [hσ i]
  have he := weighted_unreflectedExpansion_majorant J i hi k n hH σ hσ hL P D s
    {α, β} (hDm.pow_const 2) (fun x => sq_nonneg (D x))
    (fun x => (abs_of_nonneg (sq_nonneg (D x))).le.trans (by
      rw [← sq_abs (D x)]
      exact pow_le_pow_left₀ (abs_nonneg _) (hD1 x) _)) hd hK
  have hmem : α ∉ ({β} : Finset (ι)) := fun h => hαβ (Finset.mem_singleton.mp h)
  refine (he ?_).trans_eq ?_
  · intro z
    let x (ω : ι) := unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i))
    have h := abs_childExpansion_two_le (fun ω => L i (k i) (x ω)) (fun ω => P (x ω))
      (fun ω => D (x ω)) (hσ i) (fun ω => hL i (k i) (x ω)) (fun ω => hD1 (x ω))
      s hnoP α β hαβ hα hβ
    simp only [Finset.sum_insert hmem, Finset.sum_singleton]
    change |childExpansionTerm (fun ω => L i (k i) (x ω)) (fun ω => P (x ω))
      (fun ω => D (x ω)) 1 s| ≤ _
    exact h.trans_eq (by rw [hc]; ring)
  · rw [Finset.card_insert_of_notMem hmem,
      Finset.card_singleton]
    push_cast
    ring


private abbrev addedMark {d : ℕ} (J : Finset (Fin d)) (i : Fin d) :
    {j : Fin d // j ∈ insert i J} := ⟨i, Finset.mem_insert_self i J⟩

private def addedMarkTailEquiv {d : ℕ} (J : Finset (Fin d)) (i : Fin d) (hi : i ∉ J) :
    {j : {r : Fin d // r ∈ insert i J} // j ≠ addedMark J i} ≃ {j : Fin d // j ∈ J} where
  toFun j := ⟨j.1, (Finset.mem_insert.mp j.1.property).resolve_left
    (fun h => j.property (Subtype.ext h))⟩
  invFun j := ⟨⟨j, Finset.mem_insert_of_mem j.property⟩,
    fun h => hi (by
      have he : (j : Fin d) = i := congrArg Subtype.val h
      simpa only [he] using j.property)⟩
  left_inv _ := rfl
  right_inv _ := rfl

private def addedReflectSpectatorEquiv {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) :
    UnreflectedSpectators J i ≃ PairSpectators
      (Sum.inl i : ReflectedSamples (insert i J)) (Sum.inr (addedMark J i)) where
  toFun x := match x.val, x.property with
    | .inl j, hj => ⟨Sum.inl j, fun h => hj (congrArg Sum.inl (Sum.inl.inj h)), by simp⟩
    | .inr j, _ => ⟨Sum.inr ⟨j, Finset.mem_insert_of_mem j.property⟩, by simp,
        fun h => hi (by
          have he : (j : Fin d) = i := congrArg Subtype.val (Sum.inr.inj h)
          simpa only [he] using j.property)⟩
  invFun x := match x.val, x.property with
    | .inl j, hj => ⟨Sum.inl j, fun h => hj.1 (congrArg Sum.inl (Sum.inl.inj h))⟩
    | .inr j, hj => ⟨Sum.inr ((addedMarkTailEquiv J i hi) ⟨j, fun h =>
        hj.2 (congrArg Sum.inr h)⟩), by simp⟩
  left_inv := by rintro ⟨(_ | _), _⟩ <;> rfl
  right_inv := by rintro ⟨(_ | _), _⟩ <;> rfl

private theorem addedReflectSpectator_preserving {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) (k n : Fin d → ℤ) :
    MeasurePreserving (fun z : UnreflectedSpectators J i → ℝ =>
      z ∘ (addedReflectSpectatorEquiv J i hi).symm)
      (unreflectedSpectatorMeasure J i k n) (reflectedSpectatorMeasure (insert i J) (addedMark J i) k n) := by
  let e := addedReflectSpectatorEquiv J i hi
  let μ (j : UnreflectedSpectators J i) := reflectedSampleMeasure k n j.val
  have (j : UnreflectedSpectators J i) : IsProbabilityMeasure (μ j) :=
    inferInstanceAs (IsProbabilityMeasure (reflectedSampleMeasure k n j.val))
  have hp := probability_pi_map_embedding e.symm.toEmbedding μ
  have hμ : (fun j => μ (e.symm.toEmbedding j)) = (fun j : PairSpectators
      (Sum.inl i : ReflectedSamples (insert i J)) (Sum.inr (addedMark J i)) =>
      reflectedSampleMeasure k n j.val) := by
    funext j
    obtain ⟨(_ | _), _⟩ := j <;> rfl
  rw [hμ] at hp
  exact hp

private theorem addedReflectedHalfProduct_eq {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) (k : Fin d → ℤ)
    (H : (Fin d → ℝ) → ℝ) (L : Fin d → ℤ → (Fin d → ℝ) → ℝ)
    (z : UnreflectedSpectators J i → ℝ) (y : ℝ) :
    reflectedHalfProduct (insert i J) (addedMark J i) k H L
      (z ∘ (addedReflectSpectatorEquiv J i hi).symm) y = unreflectedCore J i k H L z y := by
  classical
  let K := insert i J
  let j := addedMark J i
  let ι := {r : Fin d // r ∈ J}
  let κ := {r : {a : Fin d // a ∈ K} // r ≠ j}
  let e := addedMarkTailEquiv J i hi
  let e' := addedReflectSpectatorEquiv J i hi
  let F (η : κ → Bool) :=
    let x := cornerPoint K ((Equiv.funSplitAt j Bool).symm (false, η))
      (insertPairSamples (Sum.inl i) (Sum.inr j) (z ∘ e'.symm) y y)
    H x * ∏ r ∈ Kᶜ, L r (k r) x
  have hset : Kᶜ = Jᶜ.erase i := by
    ext r
    simp only [K, Finset.mem_erase, Finset.mem_compl, Finset.mem_insert, not_or]
  change (∏ η, F η) = _
  rw [← (Equiv.arrowCongr e.symm (Equiv.refl Bool)).prod_comp F]
  unfold unreflectedCore
  apply Finset.prod_congr rfl
  intro ω _
  have hx :
      cornerPoint K ((Equiv.funSplitAt j Bool).symm
        (false, Equiv.arrowCongr e.symm (Equiv.refl Bool) ω))
          (insertPairSamples (Sum.inl i) (Sum.inr j) (z ∘ e'.symm) y y) =
        unreflectedCorner J i ω z y := by
    funext r
    by_cases hr : r = i
    · subst r
      rw [unreflectedCorner_self J hi]
      simp [cornerPoint, cornerIndex, K, j, Equiv.funSplitAt, Equiv.piSplitAt,
        insertPairSamples]
    · by_cases hJ : r ∈ J
      · have hK : r ∈ K := Finset.mem_insert_of_mem hJ
        have hj : (⟨r, hK⟩ : {a : Fin d // a ∈ K}) ≠ j :=
          fun h => hr (congrArg Subtype.val h)
        by_cases hω : ω ⟨r, hJ⟩ = true <;>
          simp [unreflectedCorner, cornerPoint, cornerIndex, insertSingleSample, insertPairSamples,
            K, j, hJ, hj, Equiv.funSplitAt, Equiv.piSplitAt, e, e', Equiv.arrowCongr,
            addedMarkTailEquiv, addedReflectSpectatorEquiv, hr, hω]
      · have hK : r ∉ K := by simp [K, hJ, hr]
        simp [unreflectedCorner, cornerPoint, cornerIndex, insertSingleSample, insertPairSamples,
          K, j, hJ, e', addedReflectSpectatorEquiv, hr]
  unfold F
  rw [hx, hset]


private theorem unreflectedTest_sq_eq_addedDerivative {d : ℕ} (J : Finset (Fin d))
    (i : Fin d) (hi : i ∉ J) (k n : Fin d → ℤ)
    {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H) (hH : ∀ x, |H x| ≤ 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ j r, Measurable (L j r))
    (hL : ∀ j r x, |L j r x| ≤ 1) :
    (∫ z, (unreflectedTest J i k n H L 1 z)^2 ∂unreflectedSpectatorMeasure J i k n) =
      reflectedBoxDifference (insert i J) i k n H L := by
  let K := insert i J
  let j := addedMark J i
  let Z := UnreflectedSpectators J i → ℝ
  let Z' := PairSpectators (Sum.inl i : ReflectedSamples K) (Sum.inr j) → ℝ
  let ν := unreflectedSpectatorMeasure J i k n
  let ν' := reflectedSpectatorMeasure K j k n
  let e (z : Z) : Z' := z ∘ (addedReflectSpectatorEquiv J i hi).symm
  let Q := reflectedHalfProduct K j k H L
  let μL := dyadicIntervalProbability (k i+1) (2*n i)
  let μR := dyadicIntervalProbability (k i+1) (2*n i+1)
  let G (z : Z') := (((∫ y, Q z y ∂μL) - (∫ y, Q z y ∂μR)) / 2)^2
  have hQm : Measurable (fun p : Z' × ℝ => Q p.1 p.2) :=
    reflectedHalfProduct_measurable K j k hHm hLm
  have hGm : Measurable G := by
    have hL := (hQm.stronglyMeasurable.integral_prod_right' (ν := μL)).measurable
    have hR := (hQm.stronglyMeasurable.integral_prod_right' (ν := μR)).measurable
    exact (((hL.sub hR).div_const 2).pow_const 2)
  have hp : MeasurePreserving e ν ν' := addedReflectSpectator_preserving J i hi k n
  have hmap := integral_map (μ := ν) hp.measurable.aemeasurable (f := G) hGm.aestronglyMeasurable
  rw [hp.map_eq] at hmap
  rw [reflectedBoxDifference_integral_sq K j k n hHm hH hLm hL]
  change _ = ∫ z, G z ∂ν'
  rw [hmap]
  apply integral_congr_ae
  filter_upwards with z
  have he (y : ℝ) : Q (e z) y = unreflectedCore J i k H L z y :=
    addedReflectedHalfProduct_eq J i hi k H L z y
  have hCm : Measurable (unreflectedCore J i k H L z) :=
    (unreflectedCore_measurable J i k hHm hLm).comp (measurable_const.prodMk measurable_id)
  have hb (y : ℝ) : |unreflectedCore J i k H L z y| ≤ 1 := by
    simpa using unreflectedCore_abs_le J i k hH (fun _ => 1) (fun _ => zero_le_one) hL z y
  unfold G unreflectedTest
  simp_rw [he, pow_one, mul_comm (unreflectedCore J i k H L z _)]
  rw [integral_dyadicHaar_probability _ hCm hb]

private theorem childExpansionTerm_singleton {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A P D : ι → ℝ) (α : ι) :
    childExpansionTerm A P D 1 (fun j => if j = α then 2 else 0) =
      D α * ∏ j : {j : ι // j ≠ α}, A j := by
  unfold childExpansionTerm
  rw [Fintype.prod_eq_mul_prod_subtype_ne _ α]
  have h (j : {j : ι // j ≠ α}) : (if (j : ι) = α then (2 : Fin 3) else 0) = 0 :=
    ite_eq_right j.property
  simp only [ite_true, show (2 : Fin 3) ≠ 0 by decide, show (2 : Fin 3) ≠ 1 by decide,
    ite_false, one_mul]
  congr 1
  apply Finset.prod_congr rfl
  intro j _
  simp only [h j, ite_true]

private theorem childExpansionTerm_singleton_count {ι : Type*} [Fintype ι] [DecidableEq ι] (α : ι) :
    (Finset.univ.filter (fun j => (if j = α then (2 : Fin 3) else 0) = 2)).card = 1 := by
  have h : Finset.univ.filter (fun j => (if j = α then (2 : Fin 3) else 0) = 2) = {α} := by
    ext j
    by_cases hj : j = α <;> simp [hj]
  rw [h, Finset.card_singleton]


private theorem unreflectedExpansion_single_le {d : ℕ} (J : Finset (Fin d)) (i : Fin d)
    (hi : i ∉ J) (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH : ∀ x, |H x| ≤ 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ j r, Measurable (L j r))
    (σ : Fin d → ℝ) (hσ : ∀ j, σ j ∈ Icc (0 : ℝ) 1)
    (hL : ∀ j r x, |L j r x| ≤ σ j) {P D : (Fin d → ℝ) → ℝ}
    (hDm : Measurable D) (hD : constantOnCoordinateCells i (k i) D)
    (hD1 : ∀ x, |D x| ≤ σ i)
    (α : {j : Fin d // j ∈ J} → Bool) :
    let V := dyadicRectangle k n
    let v := (volume : Measure (Fin d → ℝ)).real V
    v * |unreflectedExpansionContribution J i k n H L P D (fun ω => if ω = α then 2 else 0)| ≤
      (σ i)^((2^J.card : ℕ)-1) *
        Real.sqrt ((∫ x in V, (D x)^2) * (v * reflectedBoxDifference (insert i J) i k n H L)) := by
  classical
  dsimp only
  let ι := {j : Fin d // j ∈ J} → Bool
  let Z := UnreflectedSpectators J i → ℝ
  let V := dyadicRectangle k n
  let v := (volume : Measure (Fin d → ℝ)).real V
  let ν := unreflectedSpectatorMeasure J i k n
  let K := (σ i)^((2^J.card : ℕ)-1)
  let s : ι → Fin 3 := fun ω => if ω = α then 2 else 0
  let x (ω : ι) (z : Z) := unreflectedCorner J i ω z (dyadicLeftEndpoint (k i) (n i))
  let E := anchoredChildTerm J i k n L P D s
  let F (z : Z) := D (x α z)
  let G := unreflectedTest J i k n H L 1
  have hv : 0 ≤ v := (realVolume_dyadicRectangle_pos k n).le
  have hK : 0 ≤ K := pow_nonneg (hσ i).1 _
  have hn : Fintype.card ι = 2^J.card := by simp [ι, Fintype.card_pi]
  have hFs (z : Z) : |F z| ≤ 1 := (hD1 (x α z)).trans (hσ i).2
  have hE (z : Z) : |E z| ≤ |F z| * K := by
    unfold E anchoredChildTerm
    dsimp only
    rw [childExpansionTerm_singleton, abs_mul, Finset.abs_prod]
    apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
    have hc : Fintype.card {ω : ι // ω ≠ α} = (2^J.card : ℕ)-1 := by
      rw [Fintype.card_subtype_compl (fun ω : ι => ω = α)]
      simp [hn]
    change (∏ ω : {ω : ι // ω ≠ α}, |L i (k i) (x ω z)|) ≤ K
    unfold K
    rw [← hc, ← Finset.card_univ, ← Finset.prod_const]
    exact Finset.prod_le_prod₀ (fun _ _ => abs_nonneg _) (fun ω _ => hL i (k i) _)
  have hG (z : Z) : |G z| ≤ 1 := by
    simpa using abs_unreflectedTest_le J i k n hH (fun _ => 1) (fun _ => zero_le_one)
      (fun j r x => (hL j r x).trans (hσ j).2) 1 z
  have hFm : Measurable F :=
    hDm.comp ((unreflectedCorner_measurable J i α).comp (measurable_id.prodMk measurable_const))
  have hGm : Measurable G := unreflectedTest_measurable J i k n hHm hLm 1
  let _ : IsProbabilityMeasure ν := inferInstanceAs (IsProbabilityMeasure (unreflectedSpectatorMeasure J i k n))
  have hBound : |∫ z, E z * G z ∂ν| ≤
      K * (Real.sqrt (∫ z, (F z)^2 ∂ν) * Real.sqrt (∫ z, (G z)^2 ∂ν)) := by
    have hF1 : MemLp (fun z => |F z|) 2 ν := MemLp.of_bound
      (continuous_abs.measurable.comp hFm).aestronglyMeasurable 1
        (Filter.Eventually.of_forall fun z => by simpa only [Real.norm_eq_abs, abs_abs] using hFs z)
    have hG1 : MemLp (fun z => |G z|) 2 ν := MemLp.of_bound
      (continuous_abs.measurable.comp hGm).aestronglyMeasurable 1
        (Filter.Eventually.of_forall fun z => by simpa only [Real.norm_eq_abs, abs_abs] using hG z)
    have hprod : Integrable (fun z => |F z| * |G z|) ν :=
      integrable_of_measurable_abs_le ((continuous_abs.measurable.comp hFm).mul
        (continuous_abs.measurable.comp hGm))
        (fun z => by
          rw [abs_mul, abs_abs, abs_abs]
          exact (mul_le_mul (hFs z) (hG z) (abs_nonneg _) zero_le_one).trans_eq (one_mul 1))
    have hpoint (z : Z) : |E z * G z| ≤ K * (|F z| * |G z|) := by
      rw [abs_mul]
      exact (mul_le_mul_of_nonneg_right (hE z) (abs_nonneg _)).trans_eq (by ring)
    refine abs_integral_le_integral_abs.trans ((integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun _ => abs_nonneg _) (hprod.const_mul K)
      (Filter.Eventually.of_forall hpoint)).trans ?_)
    rw [integral_const_mul]
    have hcs := abs_integral_mul_le_sqrt hF1 hG1
    rw [abs_of_nonneg (integral_nonneg fun z => mul_nonneg (abs_nonneg (F z)) (abs_nonneg (G z)))] at hcs
    simpa only [sq_abs] using mul_le_mul_of_nonneg_left hcs hK
  have hF2 : v * (∫ z, (F z)^2 ∂ν) = ∫ x in V, (D x)^2 :=
    unreflectedCorner_integral_anchor J i hi k n α (g := fun x => (D x)^2) (hDm.pow_const 2)
      (fun x => by
        rw [abs_pow]
        exact pow_le_one₀ (abs_nonneg _) ((hD1 x).trans (hσ i).2))
      (fun x t ht => congrArg (fun y : ℝ => y^2) (hD x t ht))
  have hG2 : (∫ z, (G z)^2 ∂ν) = reflectedBoxDifference (insert i J) i k n H L :=
    unreflectedTest_sq_eq_addedDerivative J i hi k n hHm hH hLm
      (fun j r x => (hL j r x).trans (hσ j).2)
  have hcon : unreflectedExpansionContribution J i k n H L P D s = ∫ z, E z * G z ∂ν := by
    unfold unreflectedExpansionContribution
    have hc : (Finset.univ.filter fun ω => s ω = 2).card = 1 := childExpansionTerm_singleton_count α
    rw [hc]
  change v * |unreflectedExpansionContribution J i k n H L P D s| ≤ _
  rw [hcon, ← hF2, ← hG2]
  refine (mul_le_mul_of_nonneg_left hBound hv).trans_eq ?_
  have he : 0 ≤ ∫ z, (F z)^2 ∂ν := integral_nonneg fun _ => sq_nonneg _
  rw [Real.sqrt_mul (mul_nonneg hv he), Real.sqrt_mul hv, Real.sqrt_mul hv, mul_mul_mul_comm,
    Real.mul_self_sqrt hv]
  ring


private theorem hasSum_integral_dyadicRectangle {d : ℕ} (k : Fin d → ℤ)
    {f : (Fin d → ℝ) → ℝ} (hf : Integrable f) :
    HasSum (fun n : Fin d → ℤ => ∫ x in dyadicRectangle k n, f x) (∫ x, f x) := by
  have h := hasSum_integral_iUnion (measurableSet_dyadicRectangle k)
    (pairwiseDisjoint_dyadicRectangle k) hf.integrableOn
  rw [iUnion_dyadicRectangle, setIntegral_univ] at h
  exact h

private theorem sum_grid_le_integral {ι Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} {a : ι → ℝ} {f : Ω → ℝ} {V : ι → Set Ω}
    (hf : HasSum (fun i => ∫ x in V i, f x ∂μ) (∫ x, f x ∂μ))
    {C : ℝ} (ha : ∀ i, 0 ≤ a i)
    (hle : ∀ i, a i ≤ C * ∫ x in V i, f x ∂μ) :
    Summable a ∧ (∑' i, a i) ≤ C * ∫ x, f x ∂μ := by
  have hs := hf.summable.mul_left C
  have h := hs.of_nonneg_of_le ha hle
  exact ⟨h, (h.tsum_mono hs hle).trans_eq (by rw [tsum_mul_left, hf.tsum_eq])⟩

private theorem sum_abs_le_sqrt_grid {ι : Type*} {f a b : ι → ℝ} {C : ℝ}
    (ha : Summable a) (hb : Summable b) (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (hC : 0 ≤ C) (h : ∀ i, |f i| ≤ C * Real.sqrt (a i * b i)) :
    Summable (fun i => |f i|) ∧ (∑' i, |f i|) ≤
      C * (Real.sqrt (∑' i, a i) * Real.sqrt (∑' i, b i)) := by
  have hsum (s : Finset ι) :
      ∑ i ∈ s, |f i| ≤ C * (Real.sqrt (∑' i, a i) * Real.sqrt (∑' i, b i)) := by
    have ht (i : ι) : |f i| ≤ C * (Real.sqrt (a i) * Real.sqrt (b i)) := by
      simpa only [Real.sqrt_mul (ha0 i)] using h i
    refine (Finset.sum_le_sum (fun i _ => ht i)).trans ?_
    rw [← Finset.mul_sum]
    apply mul_le_mul_of_nonneg_left _ hC
    exact (Real.sum_sqrt_mul_sqrt_le s ha0 hb0).trans (mul_le_mul
      (Real.sqrt_le_sqrt (ha.sum_le_tsum s (fun i _ => ha0 i)))
      (Real.sqrt_le_sqrt (hb.sum_le_tsum s (fun i _ => hb0 i)))
      (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
  have hs := summable_of_sum_le (fun i => abs_nonneg (f i)) hsum
  exact ⟨hs, hs.tsum_le_of_sum_le hsum⟩

private theorem childExpansion_classify {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : ι → Fin 3) (hs : s ≠ fun _ => 0) :
    (∃ α, s α = 1) ∨
      (∀ α, s α ≠ 1) ∧
        ((∃ α β, α ≠ β ∧ s α = 2 ∧ s β = 2) ∨
          ∃ α, s = fun j => if j = α then 2 else 0) := by
  classical
  by_cases hP : ∃ α, s α = 1
  · exact Or.inl hP
  push Not at hP
  refine Or.inr ⟨hP, ?_⟩
  by_cases hD : ∃ α β, α ≠ β ∧ s α = 2 ∧ s β = 2
  · exact Or.inl hD
  have hne : ∃ α, s α = 2 := by
    by_contra! hn
    apply hs
    funext i
    have hp := hP i
    have hd := hn i
    generalize s i = v at hp hd ⊢
    fin_cases v <;> simp_all
  obtain ⟨α, hα⟩ := hne
  refine Or.inr ⟨α, ?_⟩
  funext j
  by_cases hj : j = α
  · simp [hj, hα]
  · have hd : s j ≠ 2 := fun h => hD ⟨j, α, hj, h, hα⟩
    have hp := hP j
    generalize s j = v at hp hd ⊢
    fin_cases v <;> simp_all


set_option maxHeartbeats 1200000 in
private theorem boxExpand_of_majorants {d : ℕ} (J : Finset (Fin d)) (i : Fin d) (hi : i ∉ J)
    (u : ℤ) (T : ℕ) (ν : Fin d → ℕ) (hν : ∀ j, ν j < (insert i J).card)
    {H : ℕ → (Fin d → ℝ) → ℝ} (hHm : ∀ l, Measurable (H l))
    (hHi : ∀ l, Integrable (H l)) (hH : ∀ l x, H l x ∈ Icc (0 : ℝ) 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ j r, Measurable (L j r))
    (σ : Fin d → ℝ) (hσ : ∀ j, σ j ∈ Icc (0 : ℝ) 1)
    (hL : ∀ j r x, |L j r x| ≤ σ j)
    (P D : ℤ → (Fin d → ℝ) → ℝ) (hPm : ∀ r, Measurable (P r)) (hDm : ∀ r, Measurable (D r))
    (hPi : ∀ r, Integrable (P r)) (hDi : ∀ r, Integrable (fun x => (D r x)^2))
    (hP2 : ∀ r x, |P r x| ≤ 2*σ i) (hD1 : ∀ r x, |D r x| ≤ σ i)
    (hA : ∀ r, constantOnCoordinateCells i r (L i r))
    (hPc : ∀ r, constantOnCoordinateCells i r (P r)) (hDc : ∀ r, constantOnCoordinateCells i r (D r))
    (hchild : ∀ r : ℤ, ∀ n x, x i ∈ dyadicInterval r n →
      L i (r+1) x = L i r x + P r x + dyadicHaar r n (x i) * D r x)
    (kp kd : ℝ) (hkp : 0 ≤ kp) (hkd : 0 ≤ kd)
    (hDrift : ∀ l : ℕ, ∀ n : Fin d → ℤ, ∀ (s : ({j : Fin d // j ∈ J} → Bool) → Fin 3) α,
      s α = 1 →
      let k (j : Fin d) := u + (l : ℤ) + (ν j : ℤ)
      (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
        |unreflectedExpansionContribution J i k n (H l) L (P (k i)) (D (k i)) s| ≤
          kp * ∫ x in dyadicRectangle k n, |P (k i) x|)
    (hMultiple : ∀ l : ℕ, ∀ n : Fin d → ℤ, ∀ (s : ({j : Fin d // j ∈ J} → Bool) → Fin 3),
      (∀ ω, s ω ≠ 1) → ∀ α β, α ≠ β → s α = 2 → s β = 2 →
      let k (j : Fin d) := u + (l : ℤ) + (ν j : ℤ)
      (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
        |unreflectedExpansionContribution J i k n (H l) L (P (k i)) (D (k i)) s| ≤
          kd * ∫ x in dyadicRectangle k n, (D (k i) x)^2) :
    let k (l : ℕ) (j : Fin d) := u + (l : ℤ) + (ν j : ℤ)
    let mp := ∑ l ∈ Finset.range T, ∫ x, |P (k l i) x|
    let md := ∑ l ∈ Finset.range T, ∫ x, (D (k l i) x)^2
    (∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
      |(volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k l) n) *
        reflectedBoxDifference J i (k l) n (H l) L|) ≤
      (3 : ℝ)^(2^J.card : ℕ) *
        (kp * mp + kd * md +
          (σ i)^((2^J.card : ℕ)-1) * Real.sqrt (md * energyDef (insert i J) u T H L)) := by
  classical
  dsimp only
  let k (l : ℕ) (j : Fin d) := u + (l : ℤ) + (ν j : ℤ)
  let r (l : ℕ) := k l i
  let I := {j : Fin d // j ∈ J} → Bool
  let S : Finset (I → Fin 3) := Finset.univ.erase (fun _ => 0)
  let K := insert i J
  let v (l : ℕ) (n : Fin d → ℤ) := (volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k l) n)
  let term (s : I → Fin 3) (l : ℕ) (n : Fin d → ℤ) := v l n *
    unreflectedExpansionContribution J i (k l) n (H l) L (P (r l)) (D (r l)) s
  let E (l : ℕ) (n : Fin d → ℤ) := v l n * reflectedBoxDifference K i (k l) n (H l) L
  let ks := (σ i)^((2^J.card : ℕ)-1)
  let mp := ∑ l ∈ Finset.range T, ∫ x, |P (r l) x|
  let md := ∑ l ∈ Finset.range T, ∫ x, (D (r l) x)^2
  let mE := ∑ l ∈ Finset.range T, ∑' n, E l n
  let B := kp * mp + kd * md + ks * Real.sqrt (md * energyDef K u T H L)
  have hks : 0 ≤ ks := pow_nonneg (hσ i).1 _
  have hmp : 0 ≤ mp := Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => abs_nonneg _
  have hmd : 0 ≤ md := Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => sq_nonneg _
  have hB : 0 ≤ B := add_nonneg (add_nonneg (mul_nonneg hkp hmp) (mul_nonneg hkd hmd))
    (mul_nonneg hks (Real.sqrt_nonneg _))
  have hHa (l : ℕ) (x : Fin d → ℝ) : |H l x| ≤ 1 :=
    (abs_of_nonneg (hH l x).1).trans_le (hH l x).2
  have hL1 (j : Fin d) (r : ℤ) (x : Fin d → ℝ) : |L j r x| ≤ 1 := (hL j r x).trans (hσ j).2
  have hD0 (l : ℕ) (n : Fin d → ℤ) :
      0 ≤ ∫ x in dyadicRectangle (k l) n, (D (r l) x)^2 := integral_nonneg fun _ => sq_nonneg _
  have hE0 (l : ℕ) (n : Fin d → ℤ) : 0 ≤ E l n :=
    mul_nonneg ENNReal.toReal_nonneg
      (boxSquare K (addedMark J i) (k l) n (hHm l) (hHa l) hLm hL1).2
  have hEs (l : ℕ) : Summable (E l) := by
    have h := summable_reflectedBoxDifference_grid K i (k l) (H l)
      (hHm l) (hHi l) (fun x => (hH l x).1) (fun x => (hH l x).2) L hL1
    change Summable (fun n => |E l n|) at h
    simpa only [abs_of_nonneg (hE0 l _)] using h
  have hU : mE ≤ energyDef K u T H L := by
    let v' (j : Fin d) : Fin K.card := ⟨ν j, hν j⟩
    have he : mE = markedEnergy K u T H L v' (addedMark J i) := rfl
    rw [he]
    exact le_csSup (Set.finite_range _).bddAbove ⟨(v', addedMark J i), rfl⟩
  have hterm (s : I → Fin 3) (hs : s ∈ S) :
      (∀ l, Summable (fun n => |term s l n|)) ∧
        (∑ l ∈ Finset.range T, ∑' n, |term s l n|) ≤ B := by
    have hs0 : s ≠ fun _ => 0 := (Finset.mem_erase.mp hs).1
    rcases childExpansion_classify s hs0 with hp | ⟨hnoP, hm | hsingle⟩
    · obtain ⟨α, hα⟩ := hp
      have ht (l : ℕ) := sum_grid_le_integral
        (hasSum_integral_dyadicRectangle (k l) (hPi (r l)).norm)
        (fun n => abs_nonneg (term s l n)) (C := kp)
        (fun n => by
          unfold term
          rw [abs_mul, abs_of_nonneg (realVolume_dyadicRectangle_pos (k l) n).le]
          exact hDrift l n s α hα)
      refine ⟨fun l => (ht l).1, (Finset.sum_le_sum (fun l _ => (ht l).2)).trans ?_⟩
      rw [← Finset.mul_sum]
      change kp * mp ≤ B
      unfold B
      linarith [mul_nonneg hkd hmd, mul_nonneg hks (Real.sqrt_nonneg (md * energyDef K u T H L))]
    · obtain ⟨α, β, hαβ, hα, hβ⟩ := hm
      have ht (l : ℕ) := sum_grid_le_integral
        (hasSum_integral_dyadicRectangle (k l) (hDi (r l)))
        (fun n => abs_nonneg (term s l n)) (C := kd)
        (fun n => by
          unfold term
          rw [abs_mul, abs_of_nonneg (realVolume_dyadicRectangle_pos (k l) n).le]
          exact hMultiple l n s hnoP α β hαβ hα hβ)
      refine ⟨fun l => (ht l).1, (Finset.sum_le_sum (fun l _ => (ht l).2)).trans ?_⟩
      rw [← Finset.mul_sum]
      change kd * md ≤ B
      unfold B
      linarith [mul_nonneg hkp hmp, mul_nonneg hks (Real.sqrt_nonneg (md * energyDef K u T H L))]
    · obtain ⟨α, rfl⟩ := hsingle
      have ht (l : ℕ) := sum_abs_le_sqrt_grid (f := term (fun ω => if ω = α then 2 else 0) l)
        (hasSum_integral_dyadicRectangle (k l) (hDi (r l))).summable (hEs l) (hD0 l) (hE0 l) hks
        (fun n => by
          unfold term
          rw [abs_mul, abs_of_nonneg (realVolume_dyadicRectangle_pos (k l) n).le]
          exact unreflectedExpansion_single_le J i hi (k l) n (hHm l) (hHa l) hLm σ hσ hL
            (hDm (r l)) (hDc (r l)) (hD1 (r l)) α)
      refine ⟨fun l => (ht l).1, (Finset.sum_le_sum (fun l _ => (ht l).2)).trans ?_⟩
      have hm (l : ℕ) := (hasSum_integral_dyadicRectangle (k l) (hDi (r l))).tsum_eq
      simp_rw [hm, ← Finset.mul_sum]
      have hs := Real.sum_sqrt_mul_sqrt_le (Finset.range T)
        (f := fun l => ∫ x, (D (r l) x)^2) (g := fun l => ∑' n, E l n)
        (fun _ => integral_nonneg fun _ => sq_nonneg _) (fun l => tsum_nonneg (hE0 l))
      refine (mul_le_mul_of_nonneg_left hs hks).trans ?_
      change ks * (Real.sqrt md * Real.sqrt mE) ≤ B
      rw [← Real.sqrt_mul hmd]
      exact (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt
        (mul_le_mul_of_nonneg_left hU hmd)) hks).trans (le_add_of_nonneg_left
          (add_nonneg (mul_nonneg hkp hmp) (mul_nonneg hkd hmd)))
  have hexpand (l : ℕ) (n : Fin d → ℤ) :
      v l n * reflectedBoxDifference J i (k l) n (H l) L = ∑ s ∈ S, term s l n := by
    rw [unreflectedExpansion_exact J i hi (k l) n (hHm l) (hHa l) hLm hL1
      (hPm (r l)) (hDm (r l)) (fun x => (hP2 (r l) x).trans
        (by linarith [(hσ i).2])) (fun x => (hD1 (r l) x).trans (hσ i).2)
      (hA (r l)) (hPc (r l)) (hDc (r l)) (fun x hx => hchild (r l) (n i) x hx)]
    exact Finset.mul_sum _ _ _
  have htotal (l : ℕ) : (∑' n, |v l n * reflectedBoxDifference J i (k l) n (H l) L|) ≤
      ∑ s ∈ S, ∑' n, |term s l n| := by
    have hsum : Summable (fun n => ∑ s ∈ S, |term s l n|) :=
      summable_sum fun s hs => (hterm s hs).1 l
    have hB := summable_reflectedBoxDifference_grid J i (k l) (H l)
      (hHm l) (hHi l) (fun x => (hH l x).1) (fun x => (hH l x).2) L hL1
    refine (hB.tsum_mono hsum (fun n => ?_)).trans_eq ?_
    · rw [hexpand]
      exact Finset.abs_sum_le_sum_abs _ _
    · exact Summable.tsum_finsetSum (fun s hs => (hterm s hs).1 l)
  change (∑ l ∈ Finset.range T, ∑' n, |v l n * reflectedBoxDifference J i (k l) n (H l) L|) ≤
    (3 : ℝ)^(2^J.card : ℕ) * B
  refine (Finset.sum_le_sum (fun l _ => htotal l)).trans ?_
  rw [Finset.sum_comm]
  refine (Finset.sum_le_sum (fun s hs => (hterm s hs).2)).trans ?_
  rw [Finset.sum_const, nsmul_eq_mul]
  apply mul_le_mul_of_nonneg_right _ hB
  exact_mod_cast (show S.card ≤ 3^(2^J.card : ℕ) from by
    have h := Finset.card_le_univ S
    simpa [Fintype.card_pi, I] using h)


set_option maxHeartbeats 1200000 in
/-- The unreflected-coordinate expansion bound over a staggered rectangle grid. -/
theorem boxExpand {d : ℕ} (J : Finset (Fin d)) (i : Fin d) (hi : i ∉ J)
    (u : ℤ) (T : ℕ) (ν : Fin d → ℕ) (hν : ∀ j, ν j < (insert i J).card)
    {H : ℕ → (Fin d → ℝ) → ℝ} (hHm : ∀ l, Measurable (H l))
    (hHi : ∀ l, Integrable (H l)) (hH : ∀ l x, H l x ∈ Icc (0 : ℝ) 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ j r, Measurable (L j r))
    (σ : Fin d → ℝ) (hσ : ∀ j, σ j ∈ Icc (0 : ℝ) 1)
    (hL : ∀ j r x, |L j r x| ≤ σ j)
    (P D : ℤ → (Fin d → ℝ) → ℝ) (hPm : ∀ r, Measurable (P r)) (hDm : ∀ r, Measurable (D r))
    (hPi : ∀ r, Integrable (P r)) (hDi : ∀ r, Integrable (fun x => (D r x)^2))
    (hP2 : ∀ r x, |P r x| ≤ 2*σ i) (hD1 : ∀ r x, |D r x| ≤ σ i)
    (hA : ∀ r, constantOnCoordinateCells i r (L i r))
    (hPc : ∀ r, constantOnCoordinateCells i r (P r)) (hDc : ∀ r, constantOnCoordinateCells i r (D r))
    (hchild : ∀ r : ℤ, ∀ n x, x i ∈ dyadicInterval r n →
      L i (r+1) x = L i r x + P r x + dyadicHaar r n (x i) * D r x) :
    let k (l : ℕ) (j : Fin d) := u + (l : ℤ) + (ν j : ℤ)
    let θ := ∏ j ∈ Jᶜ.erase i, (σ j)^(2^J.card : ℕ)
    let mp := ∑ l ∈ Finset.range T, ∫ x, |P (k l i) x|
    let md := ∑ l ∈ Finset.range T, ∫ x, (D (k l i) x)^2
    (∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
      |(volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k l) n) *
        reflectedBoxDifference J i (k l) n (H l) L|) ≤
      (3 : ℝ)^(2^J.card : ℕ) *
        (θ * (2*σ i)^((2^J.card : ℕ)-1) * mp + θ * (σ i)^((2^J.card : ℕ)-2) * md +
          (σ i)^((2^J.card : ℕ)-1) * Real.sqrt (md * energyDef (insert i J) u T H L)) := by
  classical
  let θ := ∏ j ∈ Jᶜ.erase i, (σ j)^(2^J.card : ℕ)
  let kp := θ * (2*σ i)^((2^J.card : ℕ)-1)
  let kd := θ * (σ i)^((2^J.card : ℕ)-2)
  have hθ : 0 ≤ θ := Finset.prod_nonneg fun j _ => pow_nonneg (hσ j).1 _
  have hkp : 0 ≤ kp := mul_nonneg hθ (pow_nonneg (mul_nonneg (by norm_num) (hσ i).1) _)
  have hkd : 0 ≤ kd := mul_nonneg hθ (pow_nonneg (hσ i).1 _)
  exact boxExpand_of_majorants J i hi u T ν hν hHm hHi hH hLm σ hσ hL P D hPm hDm hPi hDi
    hP2 hD1 hA hPc hDc hchild kp kd hkp hkd
    (fun l n s α hα =>
      unreflectedExpansion_drift_le J i hi _ n
        (fun x => (abs_of_nonneg (hH l x).1).trans_le (hH l x).2)
        σ (fun j => (hσ j).1) hL (hPm _) (hPc _) (hP2 _) (hD1 _) s α hα)
    (fun l n s hnoP α β hαβ hα hβ =>
      unreflectedExpansion_two_le J i hi _ n
        (fun x => (abs_of_nonneg (hH l x).1).trans_le (hH l x).2)
        σ (fun j => (hσ j).1) hL (hDm _) (hDc _) (hD1 _) s hnoP α β hαβ hα hβ)

private theorem singletonCorner_product_eq {M : Type*} [CommMonoid M] {d : ℕ}
    (b : Fin d) (F : ({i : Fin d // i ∈ ({b} : Finset (Fin d))} → Bool) → M)
    (α : {i : Fin d // i ∈ ({b} : Finset (Fin d))} → Bool) :
    (∏ ω, F ω) = F α * F (fun j => !α j) := by
  classical
  let β := fun j : {i : Fin d // i ∈ ({b} : Finset (Fin d))} => !α j
  have hne : α ≠ β := by
    intro h
    have he := congrFun h (singletonMark b)
    change α (singletonMark b) = !α (singletonMark b) at he
    cases α (singletonMark b) <;> simp_all
  have he (ω : {i : Fin d // i ∈ ({b} : Finset (Fin d))} → Bool) : ω = α ∨ ω = β := by
    have hconst : ∀ f : {i : Fin d // i ∈ ({b} : Finset (Fin d))} → Bool,
        ∀ j, f j = f (singletonMark b) :=
      fun f j => congrArg f (Subtype.ext (Finset.mem_singleton.mp j.property))
    by_cases h : ω (singletonMark b) = α (singletonMark b)
    · exact Or.inl (funext fun j => (hconst ω j).trans (h.trans (hconst α j).symm))
    · refine Or.inr (funext fun j => (hconst ω j).trans ?_)
      rw [hconst β j]
      change ω (singletonMark b) = !α (singletonMark b)
      have hb (p q : Bool) (hpq : p ≠ q) : p = !q := by
        cases p <;> cases q <;> simp_all
      exact hb _ _ h
  have hs : (Finset.univ : Finset ({i : Fin d // i ∈ ({b} : Finset (Fin d))} → Bool)) = {α, β} := by
    ext ω
    simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, true_iff]
    exact he ω
  rw [hs, Finset.prod_insert (fun h => hne (Finset.mem_singleton.mp h)), Finset.prod_singleton]

private abbrev SingletonBits {d : ℕ} (b : Fin d) :=
  {i : Fin d // i ∈ ({b} : Finset (Fin d))} → Bool

private def oppositeSample {d : ℕ} (b i : Fin d) (hib : i ≠ b) (α : SingletonBits b) :
    UnreflectedSpectators {b} i :=
  ⟨cornerIndex {b} (fun j => !α j) b, by
    have hb : b ∈ ({b} : Finset (Fin d)) := Finset.mem_singleton_self b
    simp only [cornerIndex, Function.Embedding.coeFn_mk, dite_eq_left hb]
    split <;> simp [hib.symm]⟩

private theorem twoCopy_corner_split {d : ℕ} (b i : Fin d) (hib : i ≠ b) (α : SingletonBits b)
    (z : SingleSpectators (oppositeSample b i hib α) → ℝ) (y t : ℝ) :
    let c := oppositeSample b i hib α
    let x (ω : SingletonBits b) (r : ℝ) :=
      unreflectedCorner {b} i ω (insertSingleSample c z r) y
    x α t = x α 0 ∧
      x (fun j => !α j) t = Function.update (x (fun j => !α j) 0) b t := by
  dsimp only
  have hb : b ∈ ({b} : Finset (Fin d)) := Finset.mem_singleton_self b
  by_cases ha : α (singletonMark b) = true
  · constructor
    · funext r
      by_cases hrb : r = b
      · subst r
        simp [unreflectedCorner, oppositeSample, cornerPoint, cornerIndex, insertSingleSample,
          hb, ha, hib.symm]
      · simp [unreflectedCorner, oppositeSample, cornerPoint, cornerIndex, insertSingleSample,
          hrb, ha]
    · funext r
      by_cases hrb : r = b
      · subst r
        simp [unreflectedCorner, oppositeSample, cornerPoint, cornerIndex, insertSingleSample,
          hb, ha, hib.symm]
      · simp [unreflectedCorner, oppositeSample, cornerPoint, cornerIndex, insertSingleSample,
          hrb, ha]
  · have ha' : α (singletonMark b) = false := Bool.eq_false_iff.mpr ha
    constructor
    · funext r
      by_cases hrb : r = b
      · subst r
        simp [unreflectedCorner, oppositeSample, cornerPoint, cornerIndex, insertSingleSample,
          hb, ha', hib.symm]
      · simp [unreflectedCorner, oppositeSample, cornerPoint, cornerIndex, insertSingleSample,
          hrb, ha']
    · funext r
      by_cases hrb : r = b
      · subst r
        simp [unreflectedCorner, oppositeSample, cornerPoint, cornerIndex, insertSingleSample,
          hb, ha', hib.symm]
      · simp [unreflectedCorner, oppositeSample, cornerPoint, cornerIndex, insertSingleSample,
          hrb, ha']


private theorem twoCopy_weightedIntegral_le {d : ℕ} (b i : Fin d) (hib : i ≠ b)
    (k n : Fin d → ℤ) (α : SingletonBits b)
    {H G : (Fin d → ℝ) → ℝ} (hHm : Measurable H) (hGm : Measurable G)
    (hH : ∀ x, H x ∈ Icc (0 : ℝ) 1) (hG0 : ∀ x, 0 ≤ G x)
    {B : ℝ} (hGB : ∀ x, |G x| ≤ B) (hGc : constantOnCoordinateCells i (k i) G)
    {ρb ρi : ℝ} (hρb : 0 ≤ ρb) (hρi : 0 ≤ ρi)
    (hHb : ∀ x : Fin d → ℝ,
      (∫ t, H (Function.update x b t) ∂dyadicIntervalProbability (k b) (n b)) ≤ ρb)
    (hHi : ∀ x : Fin d → ℝ,
      (∫ y, H (Function.update x i y) ∂dyadicIntervalProbability (k i) (n i)) ≤ ρi) :
    let V := dyadicRectangle k n
    let v := (volume : Measure (Fin d → ℝ)).real V
    let x (ω : SingletonBits b) := unreflectedCorner {b} i ω
    let ν := unreflectedSpectatorMeasure {b} i k n
    v * (∫ z, G (x α z (dyadicLeftEndpoint (k i) (n i))) *
      (∫ y, H (x α z y) * H (x (fun j => !α j) z y) ∂dyadicIntervalProbability (k i) (n i)) ∂ν) ≤
      ρb * ρi * ∫ x in V, G x := by
  classical
  dsimp only
  let Z := UnreflectedSpectators {b} i → ℝ
  let ν := unreflectedSpectatorMeasure {b} i k n
  let μb := dyadicIntervalProbability (k b) (n b)
  let μi := dyadicIntervalProbability (k i) (n i)
  let β : SingletonBits b := fun j => !α j
  let y₀ := dyadicLeftEndpoint (k i) (n i)
  let x (ω : SingletonBits b) := unreflectedCorner {b} i ω
  let R (z : Z) := G (x α z y₀)
  let v := (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n)
  let c := oppositeSample b i hib α
  let Z' := SingleSpectators c → ℝ
  let μ (j : UnreflectedSpectators {b} i) := reflectedSampleMeasure k n j.val
  let ν' := Measure.pi (fun j : SingleSpectators c => μ j.val)
  let φ (p : Z' × ℝ) := insertSingleSample c p.1 p.2
  let _ : IsProbabilityMeasure μb := dyadicIntervalProbability_isProbability _ _
  let _ : IsProbabilityMeasure μi := dyadicIntervalProbability_isProbability _ _
  let _ : IsProbabilityMeasure ν :=
    inferInstanceAs (IsProbabilityMeasure (unreflectedSpectatorMeasure {b} i k n))
  have (j : UnreflectedSpectators {b} i) : IsProbabilityMeasure (μ j) :=
    inferInstanceAs (IsProbabilityMeasure (reflectedSampleMeasure k n j.val))
  let _ : IsProbabilityMeasure ν' := Measure.pi.instIsProbabilityMeasure _
  have hμ : μ c = μb := by
    unfold μ c oppositeSample
    simp only [cornerIndex, Function.Embedding.coeFn_mk, dite_eq_left (Finset.mem_singleton_self b)]
    split <;> rfl
  have hφ : MeasurePreserving φ (ν'.prod μb) ν := by
    have h := insertSingleSample_preserving c μ
    dsimp only at h
    rw [hμ] at h
    exact h
  have hx (ω : SingletonBits b) : Measurable (fun p : Z × ℝ => x ω p.1 p.2) :=
    unreflectedCorner_measurable {b} i ω
  have hRm : Measurable R := hGm.comp ((hx α).comp (measurable_id.prodMk measurable_const))
  have hRmB (z : Z) : |R z| ≤ B := hGB _
  let F (z : Z) (y : ℝ) := H (x α z y) * H (x β z y)
  have hFm : Measurable (fun p : Z × ℝ => F p.1 p.2) :=
    (hHm.comp (hx α)).mul (hHm.comp (hx β))
  have hF (z : Z) (y : ℝ) : |F z y| ≤ 1 := by
    unfold F
    rw [abs_mul, abs_of_nonneg (hH _).1, abs_of_nonneg (hH _).1]
    simpa only [one_mul] using mul_le_mul (hH _).2 (hH _).2 (hH _).1 zero_le_one
  let A (z : Z) := R z * ∫ y, F z y ∂μi
  have hAm : Measurable A :=
    hRm.mul (hFm.stronglyMeasurable.integral_prod_right' (ν := μi)).measurable
  have hA (z : Z) : |A z| ≤ B := by
    unfold A
    rw [abs_mul]
    have he := norm_integral_le_of_norm_le_const (μ := μi) (C := 1) (f := F z)
      (Filter.Eventually.of_forall fun y => by rw [Real.norm_eq_abs]; exact hF z y)
    have hh : |∫ y, F z y ∂μi| ≤ 1 := by simpa [measureReal_def, Real.norm_eq_abs] using he
    exact (mul_le_of_le_one_right (abs_nonneg _) hh).trans (hRmB z)
  have heA := integral_map (μ := ν'.prod μb) hφ.measurable.aemeasurable (f := A) hAm.aestronglyMeasurable
  have heR := integral_map (μ := ν'.prod μb) hφ.measurable.aemeasurable (f := R) hRm.aestronglyMeasurable
  rw [hφ.map_eq] at heA heR
  have hφA : Integrable (fun p => A (φ p)) (ν'.prod μb) :=
    integrable_of_measurable_abs_le (hAm.comp hφ.measurable) (fun p => hA (φ p))
  have hφR : Integrable (fun p => R (φ p)) (ν'.prod μb) :=
    integrable_of_measurable_abs_le (hRm.comp hφ.measurable) (fun p => hRmB (φ p))
  rw [integral_prod _ hφA] at heA
  rw [integral_prod _ hφR] at heR
  have hsplit (z : Z') (y t : ℝ) :
      x α (φ (z,t)) y = x α (φ (z,0)) y ∧
      x β (φ (z,t)) y = Function.update (x β (φ (z,0)) y) b t :=
    twoCopy_corner_split b i hib α z y t
  have hS (z : Z') : (∫ t, A (φ (z,t)) ∂μb) ≤
      (ρb*ρi) * (∫ t, R (φ (z,t)) ∂μb) := by
    let u := φ (z,0)
    have hR (t : ℝ) : R (φ (z,t)) = R u := congrArg G (hsplit z y₀ t).1
    have hF' (t y : ℝ) : F (φ (z,t)) y =
        H (x α u y) * H (Function.update (x β u y) b t) := by
      unfold F
      rw [(hsplit z y t).1, (hsplit z y t).2]
    have hGm' : Measurable (fun p : ℝ × ℝ => F (φ (z,p.1)) p.2) :=
      hFm.comp (((hφ.measurable.comp (measurable_const.prodMk measurable_fst))).prodMk measurable_snd)
    have hGi : Integrable (fun p : ℝ × ℝ => F (φ (z,p.1)) p.2) (μb.prod μi) :=
      integrable_of_measurable_abs_le hGm' (fun p => hF (φ (z,p.1)) p.2)
    have hswap := integral_integral_swap (f := fun t y => F (φ (z,t)) y) hGi
    change (∫ t, ∫ y, F (φ (z,t)) y ∂μi ∂μb) =
      (∫ y, ∫ t, F (φ (z,t)) y ∂μb ∂μi) at hswap
    change (∫ t, R (φ (z,t)) * (∫ y, F (φ (z,t)) y ∂μi) ∂μb) ≤ _
    simp_rw [hR, integral_const, measureReal_def, measure_univ, ENNReal.toReal_one, smul_eq_mul, one_mul]
    rw [integral_const_mul, hswap]
    have hmid (y : ℝ) : (∫ t, F (φ (z,t)) y ∂μb) ≤ ρb * H (x α u y) := by
      simp_rw [hF']
      rw [integral_const_mul, mul_comm]
      exact mul_le_mul_of_nonneg_right (hHb _) (hH _).1
    have hHmi : Integrable (fun y => ρb * H (x α u y)) μi := by
      apply Integrable.const_mul
      exact integrable_of_measurable_abs_le
        (hHm.comp ((hx α).comp (measurable_const.prodMk measurable_id)))
        (fun y => (abs_of_nonneg (hH _).1).trans_le (hH _).2)
    have hh : (∫ y, ∫ t, F (φ (z,t)) y ∂μb ∂μi) ≤ ρb * ρi := by
      have h := integral_mono hGi.integral_prod_right hHmi hmid
      rw [integral_const_mul] at h
      refine h.trans (mul_le_mul_of_nonneg_left ?_ hρb)
      have hX (y : ℝ) : Function.update (x α u 0) i y = x α u y :=
        unreflectedCorner_update {b} (show i ∉ ({b} : Finset (Fin d)) by simpa using hib) α u 0 y
      have hI : (∫ y, H (x α u y) ∂μi) ≤ ρi := by
        have he := integral_congr_ae (μ := μi) (Filter.Eventually.of_forall fun y =>
          congrArg H (hX y).symm)
        rw [he]
        exact hHi (x α u 0)
      exact hI
    exact (mul_le_mul_of_nonneg_left hh (hG0 _)).trans_eq (mul_comm _ _)
  have hInner := integral_mono hφA.integral_prod_left
    (hφR.integral_prod_left.const_mul (ρb*ρi)) hS
  change (∫ z, ∫ t, A (φ (z,t)) ∂μb ∂ν') ≤
    ∫ z, (ρb*ρi) * (∫ t, R (φ (z,t)) ∂μb) ∂ν' at hInner
  rw [integral_const_mul, ← heA, ← heR] at hInner
  have hRint := unreflectedCorner_integral_anchor {b} i
    (show i ∉ ({b} : Finset (Fin d)) by simpa using hib) k n α hGm hGB hGc
  change v * (∫ z, A z ∂ν) ≤ _
  refine (mul_le_mul_of_nonneg_left hInner (realVolume_dyadicRectangle_pos k n).le).trans_eq ?_
  rw [mul_left_comm v, hRint]


private theorem twoCopy_expansion_majorant {d : ℕ} (b i : Fin d) (hib : i ≠ b)
    (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH : ∀ x, H x ∈ Icc (0 : ℝ) 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hL : ∀ j r x, |L j r x| ≤ 1)
    (P D : (Fin d → ℝ) → ℝ) (s : SingletonBits b → Fin 3) (S : Finset (SingletonBits b))
    {G : (Fin d → ℝ) → ℝ} (hGm : Measurable G) (hG0 : ∀ x, 0 ≤ G x)
    {B : ℝ} (hGB : ∀ x, |G x| ≤ B) (hGc : constantOnCoordinateCells i (k i) G)
    {ρb ρi : ℝ} (hρb : 0 ≤ ρb) (hρi : 0 ≤ ρi)
    (hHb : ∀ x : Fin d → ℝ,
      (∫ t, H (Function.update x b t) ∂dyadicIntervalProbability (k b) (n b)) ≤ ρb)
    (hHi : ∀ x : Fin d → ℝ,
      (∫ y, H (Function.update x i y) ∂dyadicIntervalProbability (k i) (n i)) ≤ ρi)
    {K : ℝ} (hK : 0 ≤ K)
    (hE : ∀ z, |anchoredChildTerm {b} i k n L P D s z| ≤
      K * ∑ ω ∈ S, G (unreflectedCorner {b} i ω z (dyadicLeftEndpoint (k i) (n i)))) :
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      |unreflectedExpansionContribution {b} i k n H L P D s| ≤
      K * S.card * (ρb*ρi) * ∫ x in dyadicRectangle k n, G x := by
  classical
  let V := dyadicRectangle k n
  let v := (volume : Measure (Fin d → ℝ)).real V
  let x := unreflectedCorner ({b} : Finset (Fin d)) i
  let y₀ := dyadicLeftEndpoint (k i) (n i)
  let ν := unreflectedSpectatorMeasure {b} i k n
  let μ := dyadicIntervalProbability (k i) (n i)
  let Z := UnreflectedSpectators ({b} : Finset (Fin d)) i → ℝ
  let a := (Finset.univ.filter fun ω => s ω = 2).card
  let E := anchoredChildTerm {b} i k n L P D s
  let T := unreflectedTest {b} i k n H L a
  let F (α : SingletonBits b) (z : Z) (y : ℝ) := H (x α z y) * H (x (fun j => !α j) z y)
  let R (α : SingletonBits b) (z : Z) := G (x α z y₀) * ∫ y, F α z y ∂μ
  let _ : IsProbabilityMeasure μ := dyadicIntervalProbability_isProbability _ _
  let _ : IsProbabilityMeasure ν :=
    inferInstanceAs (IsProbabilityMeasure (unreflectedSpectatorMeasure {b} i k n))
  have hx (ω : SingletonBits b) : Measurable (fun p : Z × ℝ => x ω p.1 p.2) :=
    unreflectedCorner_measurable {b} i ω
  have hFm (α : SingletonBits b) : Measurable (fun p : Z × ℝ => F α p.1 p.2) :=
    (hHm.comp (hx α)).mul (hHm.comp (hx (fun j => !α j)))
  have hF0 (α : SingletonBits b) (z : Z) (y : ℝ) : 0 ≤ F α z y :=
    mul_nonneg (hH _).1 (hH _).1
  have hF1 (α : SingletonBits b) (z : Z) (y : ℝ) : F α z y ≤ 1 := by
    unfold F
    exact (mul_le_of_le_one_right (hH _).1 (hH _).2).trans (hH _).2
  have hTle (α : SingletonBits b) (z : Z) : |T z| ≤ ∫ y, F α z y ∂μ := by
    unfold T unreflectedTest
    have hi : Integrable (F α z) μ :=
      integrable_of_measurable_abs_le ((hFm α).comp (measurable_const.prodMk measurable_id))
        (fun y => (abs_of_nonneg (hF0 α z y)).trans_le (hF1 α z y))
    refine abs_integral_le_integral_abs.trans (integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun _ => abs_nonneg _) hi (Filter.Eventually.of_forall fun y => ?_))
    change |unreflectedCore {b} i k H L z y * (dyadicHaar (k i) (n i) y)^a| ≤ F α z y
    rw [abs_mul, abs_pow]
    refine (mul_le_of_le_one_right (abs_nonneg _) (pow_le_one₀ (abs_nonneg _)
      (abs_dyadicHaar_le_one y))).trans ?_
    unfold unreflectedCore F
    rw [singletonCorner_product_eq b _ α, abs_mul, abs_mul, abs_mul]
    have hp (ω : SingletonBits b) :
        |∏ j ∈ (({b} : Finset (Fin d))ᶜ.erase i), L j (k j) (x ω z y)| ≤ 1 := by
      rw [Finset.abs_prod]
      exact Finset.prod_le_one₀ (fun _ _ => abs_nonneg _) (fun j _ => hL j (k j) _)
    rw [abs_of_nonneg (hH _).1, abs_of_nonneg (hH _).1]
    exact mul_le_mul (mul_le_of_le_one_right (hH _).1 (hp α))
      (mul_le_of_le_one_right (hH _).1 (hp (fun j => !α j)))
      (mul_nonneg (hH (x (fun j => !α j) z y)).1 (abs_nonneg _)) (hH _).1
  have hRi (α : SingletonBits b) : Integrable (R α) ν := by
    have hm : Measurable (fun z : Z => G (x α z y₀)) :=
      hGm.comp ((hx α).comp (measurable_id.prodMk measurable_const))
    have hIm := ((hFm α).stronglyMeasurable.integral_prod_right' (ν := μ)).measurable
    apply integrable_of_measurable_abs_le (hm.mul hIm) (C := B)
    intro z
    change |G (x α z y₀) * (∫ y, F α z y ∂μ)| ≤ B
    rw [abs_mul]
    have hh := norm_integral_le_of_norm_le_const (μ := μ) (f := F α z) (C := 1)
      (Filter.Eventually.of_forall fun y => by
        rw [Real.norm_of_nonneg (hF0 α z y)]
        exact hF1 α z y)
    have hI : |∫ y, F α z y ∂μ| ≤ 1 := by simpa [measureReal_def, Real.norm_eq_abs] using hh
    exact (mul_le_of_le_one_right (abs_nonneg _) hI).trans (hGB _)
  have hm (z : Z) : |E z*T z| ≤ K * ∑ α ∈ S, R α z := by
    rw [abs_mul]
    refine (mul_le_mul_of_nonneg_right (hE z) (abs_nonneg _)).trans ?_
    rw [mul_assoc, Finset.sum_mul]
    apply mul_le_mul_of_nonneg_left _ hK
    exact Finset.sum_le_sum (fun α _ => mul_le_mul_of_nonneg_left (hTle α z) (hG0 _))
  have h := abs_integral_le_integral_abs.trans (integral_mono_of_nonneg
    (Filter.Eventually.of_forall fun z => abs_nonneg (E z*T z))
    ((integrable_finsetSum S (fun α _ => hRi α)).const_mul K) (Filter.Eventually.of_forall hm))
  change v * |∫ z, E z * T z ∂ν| ≤ _
  refine (mul_le_mul_of_nonneg_left h (realVolume_dyadicRectangle_pos k n).le).trans ?_
  rw [integral_const_mul, integral_finsetSum _ (fun α _ => hRi α)]
  change v * (K * ∑ α ∈ S, ∫ z : Z, R α z ∂ν) ≤ _
  rw [mul_left_comm v, Finset.mul_sum]
  have hR (α : SingletonBits b) :
      v * (∫ z : Z, R α z ∂ν) ≤ (ρb*ρi) * ∫ x in V, G x :=
    twoCopy_weightedIntegral_le b i hib k n α hHm hGm hH hG0 hGB hGc hρb hρi hHb hHi
  refine (mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun α _ => hR α)) hK).trans_eq ?_
  rw [Finset.sum_const, nsmul_eq_mul]
  ring


private theorem twoCopy_drift_le {d : ℕ} (b i : Fin d) (hib : i ≠ b)
    (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH : ∀ x, H x ∈ Icc (0 : ℝ) 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hL : ∀ j r x, |L j r x| ≤ 1) {δ : ℝ} (hδ : 0 ≤ δ)
    (hLi : ∀ x, |L i (k i) x| ≤ δ) {P D : (Fin d → ℝ) → ℝ}
    (hPm : Measurable P) (hPc : constantOnCoordinateCells i (k i) P)
    (hP2 : ∀ x, |P x| ≤ 2*δ) (hD1 : ∀ x, |D x| ≤ δ)
    {ρb ρi : ℝ} (hρb : 0 ≤ ρb) (hρi : 0 ≤ ρi)
    (hHb : ∀ x : Fin d → ℝ,
      (∫ t, H (Function.update x b t) ∂dyadicIntervalProbability (k b) (n b)) ≤ ρb)
    (hHi : ∀ x : Fin d → ℝ,
      (∫ y, H (Function.update x i y) ∂dyadicIntervalProbability (k i) (n i)) ≤ ρi)
    (s : SingletonBits b → Fin 3) (α : SingletonBits b) (hα : s α = 1) :
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      |unreflectedExpansionContribution {b} i k n H L P D s| ≤
      (2*δ) * (ρb*ρi) * ∫ x in dyadicRectangle k n, |P x| := by
  classical
  have he := twoCopy_expansion_majorant b i hib k n hHm hH hL P D s {α}
    (G := fun x => |P x|) (continuous_abs.measurable.comp hPm) (fun _ => abs_nonneg _)
    (fun x => (abs_abs (P x)).le.trans (hP2 x))
    (fun x t ht => congrArg abs (hPc x t ht)) hρb hρi hHb hHi
    (K := 2*δ) (by positivity)
  refine (he ?_).trans_eq (by simp)
  intro z
  let x (ω : SingletonBits b) := unreflectedCorner {b} i ω z (dyadicLeftEndpoint (k i) (n i))
  have h := abs_childExpansion_drift_le (fun ω => L i (k i) (x ω)) (fun ω => P (x ω))
    (fun ω => D (x ω)) hδ (fun ω => hLi (x ω)) (fun ω => hP2 (x ω)) (fun ω => hD1 (x ω)) s α hα
  have hc : Fintype.card (SingletonBits b) = 2 := by simp [SingletonBits, Fintype.card_pi]
  simpa only [anchoredChildTerm, Finset.sum_singleton, hc, Nat.reduceSub, pow_one, mul_comm, x] using h

private theorem twoCopy_multiple_le {d : ℕ} (b i : Fin d) (hib : i ≠ b)
    (k n : Fin d → ℤ) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH : ∀ x, H x ∈ Icc (0 : ℝ) 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hL : ∀ j r x, |L j r x| ≤ 1) {δ : ℝ} (hδ : 0 ≤ δ)
    (hLi : ∀ x, |L i (k i) x| ≤ δ) {P D : (Fin d → ℝ) → ℝ}
    (hDm : Measurable D) (hDc : constantOnCoordinateCells i (k i) D)
    (hD1 : ∀ x, |D x| ≤ δ) {ρb ρi : ℝ} (hρb : 0 ≤ ρb) (hρi : 0 ≤ ρi)
    (hHb : ∀ x : Fin d → ℝ,
      (∫ t, H (Function.update x b t) ∂dyadicIntervalProbability (k b) (n b)) ≤ ρb)
    (hHi : ∀ x : Fin d → ℝ,
      (∫ y, H (Function.update x i y) ∂dyadicIntervalProbability (k i) (n i)) ≤ ρi)
    (s : SingletonBits b → Fin 3) (hnoP : ∀ ω, s ω ≠ 1)
    (α β : SingletonBits b) (hαβ : α ≠ β) (hα : s α = 2) (hβ : s β = 2) :
    (volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
      |unreflectedExpansionContribution {b} i k n H L P D s| ≤
      (ρb*ρi) * ∫ x in dyadicRectangle k n, (D x)^2 := by
  classical
  have hmem : α ∉ ({β} : Finset (SingletonBits b)) := fun h => hαβ (Finset.mem_singleton.mp h)
  have he := twoCopy_expansion_majorant b i hib k n hHm hH hL P D s {α, β}
    (G := fun x => (D x)^2) (hDm.pow_const 2) (fun _ => sq_nonneg _)
    (fun x => (abs_of_nonneg (sq_nonneg (D x))).le.trans (by
      rw [← sq_abs (D x)]
      exact pow_le_pow_left₀ (abs_nonneg _) (hD1 x) _))
    (fun x t ht => congrArg (fun y : ℝ => y^2) (hDc x t ht))
    hρb hρi hHb hHi (K := 1/2) (by norm_num)
  refine (he ?_).trans_eq ?_
  · intro z
    let x (ω : SingletonBits b) := unreflectedCorner {b} i ω z (dyadicLeftEndpoint (k i) (n i))
    have h := abs_childExpansion_two_le (fun ω => L i (k i) (x ω)) (fun ω => P (x ω))
      (fun ω => D (x ω)) hδ (fun ω => hLi (x ω)) (fun ω => hD1 (x ω)) s hnoP α β hαβ hα hβ
    have hc : Fintype.card (SingletonBits b) = 2 := by simp [SingletonBits, Fintype.card_pi]
    simp only [Finset.sum_insert hmem, Finset.sum_singleton]
    change |childExpansionTerm (fun ω => L i (k i) (x ω)) (fun ω => P (x ω))
      (fun ω => D (x ω)) 1 s| ≤ _
    exact h.trans_eq (by rw [hc]; ring)
  · rw [Finset.card_insert_of_notMem hmem, Finset.card_singleton]
    norm_num


set_option maxHeartbeats 1000000 in
/-- With two corners, the drift and multiple-difference costs gain both tester densities. -/
theorem twoCopy {d : ℕ} (b i : Fin d) (hib : i ≠ b)
    (u : ℤ) (T : ℕ) (ν : Fin d → ℕ)
    (hν : ∀ j, ν j < (insert i ({b} : Finset (Fin d))).card)
    {H : ℕ → (Fin d → ℝ) → ℝ} (hHm : ∀ l, Measurable (H l))
    (hHi : ∀ l, Integrable (H l)) (hH : ∀ l x, H l x ∈ Icc (0 : ℝ) 1)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ j r, Measurable (L j r))
    (σ : Fin d → ℝ) (hσ : ∀ j, σ j ∈ Icc (0 : ℝ) 1)
    (hL : ∀ j r x, |L j r x| ≤ σ j)
    (P D : ℤ → (Fin d → ℝ) → ℝ)
    (hPm : ∀ r, Measurable (P r)) (hDm : ∀ r, Measurable (D r))
    (hPi : ∀ r, Integrable (P r)) (hDi : ∀ r, Integrable (fun x => (D r x)^2))
    (hP2 : ∀ r x, |P r x| ≤ 2*σ i) (hD1 : ∀ r x, |D r x| ≤ σ i)
    (hA : ∀ r, constantOnCoordinateCells i r (L i r))
    (hPc : ∀ r, constantOnCoordinateCells i r (P r)) (hDc : ∀ r, constantOnCoordinateCells i r (D r))
    (hchild : ∀ r : ℤ, ∀ n x, x i ∈ dyadicInterval r n →
      L i (r+1) x = L i r x + P r x + dyadicHaar r n (x i) * D r x)
    {ρb ρi : ℝ} (hρb : 0 ≤ ρb) (hρi : 0 ≤ ρi)
    (hHb : ∀ (l : ℕ) n x, (∫ t, H l (Function.update x b t)
      ∂dyadicIntervalProbability (u + (l : ℤ) + (ν b : ℤ)) n) ≤ ρb)
    (hHfiberI : ∀ (l : ℕ) n x, (∫ y, H l (Function.update x i y)
      ∂dyadicIntervalProbability (u + (l : ℤ) + (ν i : ℤ)) n) ≤ ρi) :
    let k (l : ℕ) (j : Fin d) := u + (l : ℤ) + (ν j : ℤ)
    let mp := ∑ l ∈ Finset.range T, ∫ x, |P (k l i) x|
    let md := ∑ l ∈ Finset.range T, ∫ x, (D (k l i) x)^2
    (∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
      |(volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k l) n) *
        reflectedBoxDifference {b} i (k l) n (H l) L|) ≤
      9 * ((2*σ i)*(ρb*ρi) * mp + (ρb*ρi) * md +
        σ i * Real.sqrt (md * energyDef (insert i {b}) u T H L)) := by
  classical
  have hL1 (j : Fin d) (r : ℤ) (x : Fin d → ℝ) : |L j r x| ≤ 1 := (hL j r x).trans (hσ j).2
  have hσi : 0 ≤ σ i := (hσ i).1
  let k (l : ℕ) (j : Fin d) := u + (l : ℤ) + (ν j : ℤ)
  have hp (l : ℕ) (n : Fin d → ℤ) (s : SingletonBits b → Fin 3)
      (α : SingletonBits b) (hα : s α = 1) :
      (volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k l) n) *
        |unreflectedExpansionContribution {b} i (k l) n (H l) L (P (k l i)) (D (k l i)) s| ≤
          ((2*σ i)*(ρb*ρi)) * ∫ x in dyadicRectangle (k l) n, |P (k l i) x| :=
    twoCopy_drift_le b i hib (k l) n (hHm l) (hH l) hL1 hσi (hL i (k l i))
      (hPm (k l i)) (hPc (k l i)) (hP2 (k l i)) (hD1 (k l i))
      hρb hρi (hHb l (n b)) (hHfiberI l (n i)) s α hα
  have hq (l : ℕ) (n : Fin d → ℤ) (s : SingletonBits b → Fin 3)
      (hn : ∀ ω, s ω ≠ 1) (α β : SingletonBits b) (hαβ : α ≠ β)
      (hα : s α = 2) (hβ : s β = 2) :
      (volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k l) n) *
        |unreflectedExpansionContribution {b} i (k l) n (H l) L (P (k l i)) (D (k l i)) s| ≤
          (ρb*ρi) * ∫ x in dyadicRectangle (k l) n, (D (k l i) x)^2 :=
    twoCopy_multiple_le b i hib (k l) n (hHm l) (hH l) hL1 hσi (hL i (k l i))
      (hDm (k l i)) (hDc (k l i)) (hD1 (k l i)) hρb hρi (hHb l (n b))
      (hHfiberI l (n i)) s hn α β hαβ hα hβ
  have h := boxExpand_of_majorants {b} i (by simpa using hib) u T ν hν hHm hHi hH hLm
    σ hσ hL P D hPm hDm hPi hDi hP2 hD1 hA hPc hDc hchild
    ((2*σ i)*(ρb*ρi)) (ρb*ρi) (by positivity) (mul_nonneg hρb hρi) hp hq
  dsimp only at h
  simpa only [Finset.card_singleton, pow_one, Nat.reduceSub, show (3 : ℝ)^2 = 9 by norm_num] using h

/-- The pruning density bound on any descendant interval of the tester's cube. -/
theorem pruningTester_fiberProbability_le {d : ℕ} (i : Fin d) (u : ℤ) (T l q : ℕ)
    {A₀ : Set (Fin d → ℝ)} (hA₀ : MeasurableSet A₀) (threshold : Fin d → ℝ)
    (hthreshold : 0 ≤ threshold i) {H : (Fin d → ℝ) → ℝ} (hHm : Measurable H)
    (hH0 : ∀ x, 0 ≤ H x) (hH1 : ∀ x, H x ≤ A₀.indicator (fun _ => 1) x)
    (n : ℤ) (x : Fin d → ℝ) :
    (∫ y, pruningTester u T A₀ threshold H l (Function.update x i y)
      ∂dyadicIntervalProbability (u + (l : ℤ) + (q : ℤ)) n) ≤ (2 : ℝ)^q * threshold i := by
  let r := u + (l : ℤ)
  let k := r + (q : ℤ)
  let a := dyadicLeftEndpoint k n
  let b := ((n : ℝ)+1) * (2 : ℝ)^(-k)
  let x' := Function.update x i a
  have hpos : 0 < (2 : ℝ)^(-k) := by positivity
  have hlen : b-a = (2 : ℝ)^(-k) := by unfold a b dyadicLeftEndpoint; ring
  have hab : a < b := sub_pos.mp (hlen.symm ▸ hpos)
  have hA : a ∈ dyadicInterval k n := dyadicLeftEndpoint_mem k n
  have hsub : Ico a b ⊆ dyadicInterval r (dyadicIndex r (x' i)) := by
    change dyadicInterval k n ⊆ _
    apply dyadicInterval_subset_of_mem (k := r) (x := a) (by dsimp [r, k]; omega) hA
    simpa only [x', Function.update_self] using (mem_dyadicInterval_iff.mpr (rfl :
      dyadicIndex r a = dyadicIndex r a))
  have hC : (2 : ℝ)^(-r) ≤ (2 : ℝ)^q * (b-a) := by
    rw [hlen, show -k = -r + -(q : ℤ) by unfold k; ring,
      zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_neg (2 : ℝ) (q : ℤ), zpow_natCast, mul_left_comm,
      mul_inv_cancel₀ (by positivity), mul_one]
  have ht := pruningTester_fiberAverage_le i u T l hA₀ threshold hthreshold hHm hH0 hH1 x'
    hab hsub hC
  unfold intervalAverage at ht
  rw [hlen] at ht
  simp only [x', Function.update_idem] at ht
  change (∫ y, pruningTester u T A₀ threshold H l (Function.update x i y)
    ∂dyadicIntervalProbability k n) ≤ _
  simpa only [dyadicIntervalProbability, integral_smul_measure, ENNReal.toReal_inv,
    ENNReal.toReal_ofReal hpos.le, smul_eq_mul, dyadicInterval, a, b, dyadicLeftEndpoint] using ht


private structure LowPathEstimate {d : ℕ} (i : Fin d) (σ : ℝ) where
  path : ℤ → (Fin d → ℝ) → ℝ
  drift : ℤ → (Fin d → ℝ) → ℝ
  detail : ℤ → (Fin d → ℝ) → ℝ
  pathMeasurable : ∀ k, Measurable (path k)
  driftMeasurable : ∀ k, Measurable (drift k)
  detailMeasurable : ∀ k, Measurable (detail k)
  driftIntegrable : ∀ k, Integrable (drift k)
  detailIntegrable : ∀ k, Integrable (fun x => (detail k x)^2)
  pathBound : ∀ k x, |path k x| ≤ σ
  driftBound : ∀ k x, |drift k x| ≤ 2*σ
  detailBound : ∀ k x, |detail k x| ≤ σ
  pathConstant : ∀ k, constantOnCoordinateCells i k (path k)
  driftConstant : ∀ k, constantOnCoordinateCells i k (drift k)
  detailConstant : ∀ k, constantOnCoordinateCells i k (detail k)
  expansion : ∀ k n x, x i ∈ dyadicInterval k n →
    path (k+1) x = path k x + drift k x + dyadicHaar k n (x i) * detail k x

private theorem zero_constantOnCoordinateCells {d : ℕ} (i : Fin d) (k : ℤ) :
    constantOnCoordinateCells i k (fun _ => 0) := fun _ _ _ => rfl

private theorem integral_sq_le_support {d : ℕ} {A : Set (Fin d → ℝ)}
    (hA : MeasurableSet A) (hAf : volume A ≠ ⊤) {f : (Fin d → ℝ) → ℝ}
    (hf : MemLp f 2 volume) (h0 : ∀ x, 0 ≤ f x) (h1 : ∀ x, f x ≤ A.indicator (fun _ => 1) x) :
    (∫ x, (f x)^2) ≤ (volume : Measure (Fin d → ℝ)).real A := by
  have hi : Integrable (A.indicator (fun _ => (1 : ℝ))) :=
    (integrable_indicator_iff hA).mpr (integrableOn_const hAf)
  have h := integral_mono hf.integrable_sq hi (fun x => ?_)
  · rwa [integral_indicator hA, setIntegral_const, smul_eq_mul, mul_one] at h
  · by_cases hx : x ∈ A
    · have h := h1 x
      simp only [indicator_of_mem hx] at h ⊢
      exact pow_le_one₀ (h0 x) h
    · have hf0 : f x = 0 := le_antisymm ((h1 x).trans_eq (indicator_of_notMem hx _)) (h0 x)
      simp [hx, hf0]

private noncomputable def ordinaryLowPath {d : ℕ} (i : Fin d)
    (f : (Fin d → ℝ) → ℝ) (hm : Measurable f) (hF : ∀ x, |f x| ≤ 1) (hLp : MemLp f 2 volume) :
    LowPathEstimate i 1 := by
  have hC (k : ℤ) := coordinateHaarCoefficient_regular i k hm hF hLp
  refine
    { path := fun k => coordinateAverage i k f
      drift := fun _ _ => 0
      detail := fun k => coordinateHaarCoefficient i k f
      pathMeasurable := fun k => measurable_coordinateAverage i k hm
      driftMeasurable := fun _ => measurable_const
      detailMeasurable := fun k => (hC k).1
      driftIntegrable := fun _ => integrable_zero _ _ _
      detailIntegrable := fun k => (hC k).2
      pathBound := fun k => abs_coordinateAverage_le i k hF
      driftBound := by simp
      detailBound := (truePath_haar_bounds i 0 hm hF hLp 0).1
      pathConstant := fun k => coordinateAverage_constantOnCells i k f
      driftConstant := zero_constantOnCoordinateCells i
      detailConstant := fun k => coordinateHaarCoefficient_constantOnCells i k f
      expansion := ?_ }
  intro k n x hx
  have h := coordinateDifference_eq_haar i k n (f := f) hx (boundedFiber_integrable i hm hF x k n)
  have hc : coordinateHaarCoefficient i k f x = ((2 : ℝ)^(-k))⁻¹ *
      ∫ y in dyadicInterval k n, dyadicHaar k n y * f (Function.update x i y) := by
    simp only [coordinateHaarCoefficient, mem_dyadicInterval_iff.mp hx]
  rw [← hc] at h
  unfold coordinateDifference at h
  linarith

private theorem coordinateResidual_zero_level {d : ℕ} (i : Fin d) (u : ℤ)
    (δ : ℝ) (f : (Fin d → ℝ) → ℝ) :
    coordinateResidual i u δ f 0 = fun _ => 0 := by
  funext x
  exact sub_self _


private noncomputable def recordedResidualLowPath {d : ℕ} (i : Fin d) (u : ℤ)
    {δ : ℝ} (hδ : 0 ≤ δ) (f : (Fin d → ℝ) → ℝ) (hfm : Measurable f)
    (hF1 : Integrable f) (hF2 : MemLp f 2 volume) : LowPathEstimate i δ := by
  classical
  let R := coordinateResidual i u δ f
  let n (k : ℤ) := (k-u).toNat
  let P (k : ℤ) := if u ≤ k then coordinateResidualDrift i u δ f (n k) else fun _ => 0
  let D (k : ℤ) := if u ≤ k then coordinateHaarCoefficient i k (R (n k+1)) else fun _ => 0
  have hRm (N : ℕ) : Measurable (R N) := measurable_coordinateResidual i u δ hfm N
  have hR2 (N : ℕ) : MemLp (R N) 2 volume := by
    have h := memLp_coordinateResidual i u δ (p := 2) (by norm_num) hfm (by simpa using hF2) N
    simpa using h
  have hR (N : ℕ) (x : Fin d → ℝ) : |R N x| ≤ δ :=
    recordedPath_tracking (coordinateLowPath i u f) hδ true N x
  have hP (k : ℤ) := coordinateResidualDrift_regular i u δ hfm hF1 (n k)
  have hD (k : ℤ) := coordinateHaarCoefficient_regular i k (hRm (n k+1)) (hR (n k+1)) (hR2 (n k+1))
  have hk (k : ℤ) (h : u ≤ k) : u + (n k : ℤ) = k := by
    simp only [n, Int.toNat_of_nonneg (show 0 ≤ k-u by omega)]
    omega
  have hn (k : ℤ) (h : u ≤ k) : n (k+1) = n k + 1 := by
    have h' := hk (k+1) (by omega)
    have h'' := hk k h
    omega
  have hN (k : ℤ) (h : k ≤ u) : n k = 0 := by
    exact Int.toNat_of_nonpos (by omega)
  refine
    { path := fun k => R (n k)
      drift := P
      detail := D
      pathMeasurable := fun k => hRm (n k)
      driftMeasurable := by intro k; unfold P; split; exact (hP k).1; exact measurable_const
      detailMeasurable := by intro k; unfold D; split; exact (hD k).1; exact measurable_const
      driftIntegrable := by intro k; unfold P; split; exact (hP k).2; exact integrable_zero _ _ _
      detailIntegrable := ?_
      pathBound := fun k => hR (n k)
      driftBound := ?_
      detailBound := ?_
      pathConstant := ?_
      driftConstant := ?_
      detailConstant := ?_
      expansion := ?_ }
  · intro k
    simp only [D]
    split
    · exact (hD k).2
    · simpa using (integrable_zero (α := (Fin d → ℝ)) ℝ)
  · intro k x
    unfold P
    split
    · exact (residualDrift_pointwise_bounds i u hδ f (n k) x).1
    · simp [hδ]
  · intro k x
    unfold D
    split
    · rename_i h
      have hh := (residualDrift_pointwise_bounds i u hδ f (n k) x).2
      rwa [hk k h] at hh
    · simpa using hδ
  · intro k
    by_cases h : u ≤ k
    · have hh := coordinateResidual_constantOnCells i u δ f (n k)
      rwa [hk k h] at hh
    · rw [hN k (by omega), show R 0 = fun _ => 0 from coordinateResidual_zero_level i u δ f]
      exact zero_constantOnCoordinateCells i k
  · intro k
    unfold P
    split
    · rename_i h
      have hh := coordinateResidualDrift_constantOnCells i u δ f (n k)
      rwa [hk k h] at hh
    · exact zero_constantOnCoordinateCells i k
  · intro k
    unfold D
    split
    · exact coordinateHaarCoefficient_constantOnCells i k _
    · exact zero_constantOnCoordinateCells i k
  · intro k m x hx
    by_cases h : u ≤ k
    · have he := residualDrift_expansion i u δ f (n k) x
        (boundedFiber_integrable i (hRm (n k+1)) (hR (n k+1)) x _ _)
      change R (n k+1) x = R (n k) x + _ + _ at he
      rw [hk k h, mem_dyadicInterval_iff.mp hx] at he
      simpa only [P, D, ite_eq_left h, hn k h] using he
    · simp only [P, D, ite_eq_right h, hN k (by omega), hN (k+1) (by omega), R,
        coordinateResidual_zero_level, mul_zero, add_zero]


private theorem energyDef_le_of_markedEnergy_le {d : ℕ} (J : Finset (Fin d)) (hJ : J.Nonempty)
    (u : ℤ) (T : ℕ) (H : ℕ → (Fin d → ℝ) → ℝ)
    (L : Fin d → ℤ → (Fin d → ℝ) → ℝ) {B : ℝ}
    (hB : ∀ (ν : Fin d → Fin J.card) (j : {i : Fin d // i ∈ J}),
      markedEnergy J u T H L ν j ≤ B) :
    energyDef J u T H L ≤ B := by
  obtain ⟨j, hj⟩ := hJ
  let z : Fin J.card := ⟨0, Finset.card_pos.mpr ⟨j, hj⟩⟩
  refine csSup_le ⟨markedEnergy J u T H L (fun _ => z) ⟨j, hj⟩, ⟨(fun _ => z, ⟨j, hj⟩), rfl⟩⟩ ?_
  rintro _ ⟨⟨ν, i⟩, rfl⟩
  exact hB ν i

private theorem energyDef_nonneg {d : ℕ} (J : Finset (Fin d)) (hJ : J.Nonempty)
    (u : ℤ) (T : ℕ) {H : ℕ → (Fin d → ℝ) → ℝ} (hHm : ∀ l, Measurable (H l))
    (hH : ∀ l x, |H l x| ≤ 1) {L : Fin d → ℤ → (Fin d → ℝ) → ℝ}
    (hLm : ∀ i r, Measurable (L i r)) (hL : ∀ i r x, |L i r x| ≤ 1) :
    0 ≤ energyDef J u T H L := by
  obtain ⟨j, hj⟩ := hJ
  let ν : Fin d → Fin J.card := fun _ => ⟨0, Finset.card_pos.mpr ⟨j, hj⟩⟩
  have hp : 0 ≤ markedEnergy J u T H L ν ⟨j, hj⟩ := by
    unfold markedEnergy
    apply Finset.sum_nonneg
    intro l _
    apply tsum_nonneg
    intro n
    exact mul_nonneg ENNReal.toReal_nonneg
      (boxSquare J ⟨j, hj⟩ _ n (hHm l) (hH l) hLm hL).2
  exact hp.trans (le_csSup (Set.finite_range _).bddAbove ⟨(ν, ⟨j, hj⟩), rfl⟩)

private theorem finite_sum_offset_le {g : ℕ → ℝ} (h0 : ∀ k, 0 ≤ g k) (T q S : ℕ) (h : q+T ≤ S) :
    (∑ l ∈ Finset.range T, g (l+q)) ≤ ∑ l ∈ Finset.range S, g l := by
  have he := Finset.sum_range_add g q T
  have hs : (∑ l ∈ Finset.range q, g l) ≥ 0 := Finset.sum_nonneg fun l _ => h0 l
  have ht : (∑ l ∈ Finset.range (q+T), g l) ≤ ∑ l ∈ Finset.range S, g l :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono h) (fun l _ _ => h0 l)
  simp only [Nat.add_comm q] at he
  rw [Nat.add_comm q T] at ht
  linarith

private theorem residualLowPath_budget {d : ℕ} (i : Fin d) (u : ℤ) (S : ℕ)
    {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1) {A : Set (Fin d → ℝ)}
    (hA : MeasurableSet A) (hAf : volume A ≠ ⊤)
    {f : (Fin d → ℝ) → ℝ} (hm : Measurable f) (hf1 : Integrable f) (hf2 : MemLp f 2 volume)
    (h0 : ∀ x, 0 ≤ f x) (h1 : ∀ x, f x ≤ A.indicator (fun _ => 1) x) :
    let R := recordedResidualLowPath i u hδ.le f hm hf1 hf2
    let C := 2 + recordingVariationConstant 1
    let a := (volume : Measure (Fin d → ℝ)).real A
    δ * (∑ l ∈ Finset.range S, ∫ x, |R.drift (u+(l : ℤ)) x|) ≤ C*a ∧
      (∑ l ∈ Finset.range S, ∫ x, (R.detail (u+(l : ℤ)) x)^2) ≤ C*a := by
  dsimp only
  let R := recordedResidualLowPath i u hδ.le f hm hf1 hf2
  have hku (l : ℕ) : u ≤ u+(l : ℤ) := by omega
  have he (l : ℕ) : (u+(l : ℤ)-u).toNat = l := by omega
  have hp (l : ℕ) : R.drift (u+(l : ℤ)) = coordinateResidualDrift i u δ f l := by
    simp only [R, recordedResidualLowPath, ite_eq_left (hku l), he]
  have hd (l : ℕ) : R.detail (u+(l : ℤ)) =
      coordinateHaarCoefficient i (u+l) (coordinateResidual i u δ f (l+1)) := by
    simp only [R, recordedResidualLowPath, ite_eq_left (hku l), he]
  have h := residualDrift i u S hA hAf hm h0 h1 hδ hδ1
  dsimp only at h
  constructor
  · have hel (l : ℕ) :
        (∫ x, |R.drift (u+(l : ℤ)) x|) =
          lpNorm (coordinateResidualDrift i u δ f l) 1 volume := by
      rw [hp, lpNorm_one_eq_integral_norm
        (coordinateResidualDrift_regular i u δ hm hf1 l).1.aestronglyMeasurable]
      rfl
    change δ * (∑ l ∈ Finset.range S, ∫ x, |R.drift (u+(l : ℤ)) x|) ≤ _
    simp_rw [hel]
    have hh := (le_div_iff₀ hδ).mp h.1
    rw [mul_comm δ]
    refine hh.trans ?_
    linarith [show 0 ≤ (volume : Measure (Fin d → ℝ)).real A from ENNReal.toReal_nonneg]
  · change (∑ l ∈ Finset.range S, ∫ x, (R.detail (u+(l : ℤ)) x)^2) ≤ _
    simp_rw [hd]
    exact h.2


private theorem energyDef_le_of_refinement_cost {d : ℕ} (J : Finset (Fin d)) (hJ : J.Nonempty)
    (u : ℤ) (T : ℕ) (H : ℕ → (Fin d → ℝ) → ℝ) (hHm : ∀ l, Measurable (H l))
    (hHi : ∀ l, Integrable (H l)) (hH : ∀ l x, H l x ∈ Icc (0 : ℝ) 1)
    (hord : ∀ l x, H (l+1) x ≤ H l x) (hterminal : H T = fun _ => 0)
    {h : ℝ} (hLoss : (∑ l ∈ Finset.range T, ∫ x, H l x-H (l+1) x) ≤ h)
    {L : Fin d → ℤ → (Fin d → ℝ) → ℝ} (hLm : ∀ i l, Measurable (L i l))
    (σ : Fin d → ℝ) (hσ : ∀ i, σ i ∈ Icc (0 : ℝ) 1) (hL : ∀ i r x, |L i r x| ≤ σ i)
    (E : Fin d → ℝ)
    (hCost : ∀ i ∉ J, ∀ ν : Fin d → ℕ, (∀ j, ν j ≤ J.card) →
      (∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
        let k (r : Fin d) := u + (l : ℤ) + (ν r : ℤ)
        |(volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
          reflectedBoxDifference J i k n (H l) L|) ≤ E i) :
    energyDef J u T H L ≤
      ((2^J.card : ℕ) : ℝ) * (∏ i ∈ Jᶜ, (σ i)^(2^J.card : ℕ)) * h + ∑ i ∈ Jᶜ, E i := by
  apply energyDef_le_of_markedEnergy_le J hJ u T H L
  intro ν j
  let offset (i : Fin d) := (ν i : ℕ)
  have hb := boxBoundary J hJ u T offset H hHm hHi hH hord hterminal hLoss hLm σ hσ hL
  have hL1 (i : Fin d) (r : ℤ) (x : Fin d → ℝ) : |L i r x| ≤ 1 := (hL i r x).trans (hσ i).2
  have hmark := boxBoundary_marked J j u T offset H hHm hHi hH hLm hL1 E
  have hmark' := hmark (fun i hi s _ => by
    let q (r : Fin d) := offset r + if r ∈ s then 1 else 0
    have hq (r : Fin d) : q r ≤ J.card := by
      have h := (ν r).isLt
      unfold q offset
      split <;> omega
    have he := hCost i hi q hq
    simpa only [q, Nat.cast_add, Nat.cast_ite, Nat.cast_zero, Nat.cast_one, add_assoc] using he)
  exact hmark'.trans (add_le_add_left hb _)

private theorem product_pow_unit_le_one {d : ℕ} (s : Finset (Fin d))
    (σ : Fin d → ℝ) (hσ : ∀ i, σ i ∈ Icc (0 : ℝ) 1) (n : ℕ) :
    ∏ i ∈ s, (σ i)^n ≤ 1 :=
  Finset.prod_le_one₀ (fun i _ => pow_nonneg (hσ i).1 _) (fun i _ => pow_le_one₀ (hσ i).1 (hσ i).2)

private theorem product_pow_gain {d : ℕ} (s : Finset (Fin d))
    (σ : Fin d → ℝ) (hσ : ∀ i, σ i ∈ Icc (0 : ℝ) 1)
    {i : Fin d} (hi : i ∈ s) {δ : ℝ} (hδ : σ i = δ) {n : ℕ} (hn : 1 ≤ n) :
    ∏ r ∈ s, (σ r)^n ≤ δ := by
  classical
  rw [← Finset.mul_prod_erase s _ hi]
  refine (mul_le_of_le_one_right (pow_nonneg (hσ i).1 _) (product_pow_unit_le_one _ σ hσ n)).trans ?_
  exact (pow_le_pow_of_le_one (hσ i).1 (hσ i).2 hn).trans_eq (by rw [pow_one, hδ])

private theorem recordedGain_nonneg {δ : ℝ} (hδ : 0 ≤ δ) (r : ℕ) :
    0 ≤ δ^((1/2 : ℝ)^r) := Real.rpow_nonneg hδ _

private theorem recordedGain_ge_threshold {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1) (r : ℕ) :
    δ ≤ δ^((1/2 : ℝ)^r) := by
  nth_rw 1 [← Real.rpow_one δ]
  exact Real.rpow_le_rpow_of_exponent_ge hδ hδ1 (pow_le_one₀ (by norm_num) (by norm_num))

private theorem recordedGain_succ {δ : ℝ} (hδ : 0 ≤ δ) (r : ℕ) :
    δ^((1/2 : ℝ)^(r+1)) = Real.sqrt (δ^((1/2 : ℝ)^r)) := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hδ, pow_succ]


private theorem sqrt_le_self_of_one_le {a : ℝ} (ha : 1 ≤ a) : Real.sqrt a ≤ a := by
  apply (Real.sqrt_le_left (zero_le_one.trans ha)).mpr
  nlinarith

private theorem residual_induction_bound {d : ℕ} (b : Fin d) (hd : 2 ≤ d)
    (D : Finset (Fin d)) (hD : D.Nonempty) (hbD : b ∉ D)
    {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1)
    (U : Finset (Fin d) → ℝ) (hU : ∀ J, b ∈ J → 0 ≤ U J)
    {A ρ : ℝ} (hA : 1 ≤ A) (hρ : 0 ≤ ρ)
    (hBasic : ∀ J : Finset (Fin d), b ∈ J →
      U J ≤ A * (1 + ∑ i ∈ Jᶜ, Real.sqrt (U (insert i J))))
    (hStrong : ∀ J : Finset (Fin d), b ∈ J → 2 ≤ J.card → (D \ J).Nonempty →
      U J ≤ A * (δ + ∑ i ∈ Jᶜ, (if i ∈ D then δ else 1) * Real.sqrt (U (insert i J))))
    (hRoot : U {b} ≤ A * (ρ + δ +
      ∑ i ∈ ({b} : Finset (Fin d))ᶜ, (if i ∈ D then δ else 1) * Real.sqrt (U (insert i {b})))) :
    let C := (A * (d+1))^(d+1)
    U {b} ≤ C * (ρ + δ^((1/2 : ℝ)^(d-1))) := by
  classical
  dsimp only
  let B := A * ((d : ℝ)+1)
  let G (r : ℕ) := δ^((1/2 : ℝ)^r)
  have hd1 : 1 ≤ (d : ℝ)+1 := by linarith [Nat.cast_nonneg (α := ℝ) d]
  have hB : 1 ≤ B := hA.trans (le_mul_of_one_le_right (zero_le_one.trans hA) hd1)
  have hA0 : 0 ≤ A := zero_le_one.trans hA
  have hBpow (r : ℕ) : 1 ≤ B^r := one_le_pow₀ hB
  have hG0 (r : ℕ) : 0 ≤ G r := recordedGain_nonneg hδ.le r
  have hGδ (r : ℕ) : δ ≤ G r := recordedGain_ge_threshold hδ hδ1 r
  have hGs (r : ℕ) : G (r+1) = Real.sqrt (G r) := recordedGain_succ hδ.le r
  have hcard (J : Finset (Fin d)) : J.card ≤ d := by
    simpa using Finset.card_le_univ J
  have hdim (J : Finset (Fin d)) (i : Fin d) (hi : i ∉ J) (r : ℕ)
      (hr : d-J.card = r+1) : d-(insert i J).card = r := by
    rw [Finset.card_insert_of_notMem hi]
    omega
  have hcrude (r : ℕ) (J : Finset (Fin d)) (hj : b ∈ J) (hr : d-J.card = r) : U J ≤ B^(r+1) := by
    induction r generalizing J with
    | zero =>
      have hfull : J = Finset.univ := Finset.eq_univ_of_card J (by rw [Fintype.card_fin]; have hh := hcard J; omega)
      have h := hBasic J hj
      rw [hfull] at h ⊢
      simp only [Finset.compl_univ, Finset.sum_empty, add_zero, zero_add, pow_one, mul_one] at h ⊢
      exact h.trans (le_mul_of_one_le_right hA0 hd1)
    | succ r ih =>
      have hc (i : Fin d) (hi : i ∈ Jᶜ) : Real.sqrt (U (insert i J)) ≤ B^(r+1) :=
        (Real.sqrt_le_sqrt (ih (insert i J) (Finset.mem_insert_of_mem hj)
          (hdim J i (Finset.mem_compl.mp hi) r hr))).trans (sqrt_le_self_of_one_le (hBpow _))
      have hsum := Finset.sum_le_sum hc
      rw [Finset.sum_const, nsmul_eq_mul] at hsum
      have hm : ((Jᶜ.card : ℕ) : ℝ) ≤ d := by exact_mod_cast hcard Jᶜ
      have hb0 : 0 ≤ B^(r+1) := zero_le_one.trans (hBpow _)
      have h' := (hBasic J hj).trans (mul_le_mul_of_nonneg_left (add_le_add_right hsum 1) hA0)
      refine h'.trans ?_
      rw [pow_succ]
      have hmul := mul_le_mul_of_nonneg_right hm hb0
      calc
        _ ≤ A * (B^(r+1) + (d : ℝ)*B^(r+1)) :=
          mul_le_mul_of_nonneg_left (add_le_add (hBpow _) hmul) hA0
        _ = _ := by unfold B; ring
  have hstrong (r : ℕ) (J : Finset (Fin d)) (hj : b ∈ J) (hr : d-J.card = r)
      (hJ2 : 2 ≤ J.card) (hDJ : (D \ J).Nonempty) : U J ≤ B^(r+1) * G r := by
    induction r generalizing J with
    | zero =>
      have hfull : J = Finset.univ := Finset.eq_univ_of_card J (by rw [Fintype.card_fin]; have hh := hcard J; omega)
      obtain ⟨j, hjD⟩ := hDJ
      exact False.elim ((Finset.mem_sdiff.mp hjD).2 (hfull.symm ▸ Finset.mem_univ j))
    | succ r ih =>
      have hc (i : Fin d) (hi : i ∈ Jᶜ) :
          (if i ∈ D then δ else 1) * Real.sqrt (U (insert i J)) ≤ B^(r+1)*G (r+1) := by
        have hr' := hdim J i (Finset.mem_compl.mp hi) r hr
        by_cases ht : i ∈ D
        · rw [ite_eq_left ht]
          have h := (Real.sqrt_le_sqrt (hcrude r (insert i J) (Finset.mem_insert_of_mem hj) hr')).trans
            (sqrt_le_self_of_one_le (hBpow _))
          exact (mul_le_mul_of_nonneg_left h hδ.le).trans
            (by rw [mul_comm δ]; exact mul_le_mul_of_nonneg_left (hGδ _) ((zero_le_one.trans (hBpow _))))
        · rw [ite_eq_right ht, one_mul]
          obtain ⟨e, he⟩ := hDJ
          have he' := Finset.mem_sdiff.mp he
          have hDJ' : (D \ insert i J).Nonempty := ⟨e, Finset.mem_sdiff.mpr
            ⟨he'.1, fun h => (Finset.mem_insert.mp h).elim (fun h' => ht (h' ▸ he'.1)) he'.2⟩⟩
          have h2 : 2 ≤ (insert i J).card := (hJ2.trans (Finset.card_le_card (Finset.subset_insert _ _)))
          have h := Real.sqrt_le_sqrt (ih (insert i J) (Finset.mem_insert_of_mem hj) hr' h2 hDJ')
          rw [Real.sqrt_mul (zero_le_one.trans (hBpow _)), ← hGs] at h
          exact h.trans (mul_le_mul_of_nonneg_right (sqrt_le_self_of_one_le (hBpow _)) (hG0 _))
      have hsum := Finset.sum_le_sum hc
      rw [Finset.sum_const, nsmul_eq_mul] at hsum
      have hb0 : 0 ≤ B^(r+1) := zero_le_one.trans (hBpow _)
      have hm : ((Jᶜ.card : ℕ) : ℝ) ≤ d := by exact_mod_cast hcard Jᶜ
      have hδ' : δ ≤ B^(r+1)*G (r+1) :=
        (hGδ _).trans (le_mul_of_one_le_left (hG0 _) (hBpow _))
      refine (hStrong J hj hJ2 hDJ).trans (mul_le_mul_of_nonneg_left
        (add_le_add hδ' (hsum.trans (mul_le_mul_of_nonneg_right hm (mul_nonneg hb0 (hG0 _))))) hA0) |>.trans_eq ?_
      rw [pow_succ]
      unfold B
      ring
  have hrootTerm (i : Fin d) (hi : i ∈ ({b} : Finset (Fin d))ᶜ) :
      (if i ∈ D then δ else 1) * Real.sqrt (U (insert i {b})) ≤ B^(d-1)*G (d-1) := by
    have hib : i ≠ b := by simpa using hi
    have hsize : (insert i ({b} : Finset (Fin d))).card = 2 := by simp [hib]
    have hr : d - (insert i ({b} : Finset (Fin d))).card = d-2 := by rw [hsize]
    have hb : b ∈ insert i ({b} : Finset (Fin d)) := by simp
    have h0 : d-2+1 = d-1 := by omega
    by_cases ht : i ∈ D
    · rw [ite_eq_left ht]
      have h := hcrude (d-2) (insert i {b}) hb hr
      rw [h0] at h
      have he := (Real.sqrt_le_sqrt h).trans (sqrt_le_self_of_one_le (hBpow _))
      exact (mul_le_mul_of_nonneg_left he hδ.le).trans
        (by rw [mul_comm δ]; exact mul_le_mul_of_nonneg_left (hGδ _) (zero_le_one.trans (hBpow _)))
    · rw [ite_eq_right ht, one_mul]
      obtain ⟨j, hj⟩ := hD
      have hj' : j ∉ insert i ({b} : Finset (Fin d)) := by
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
        exact ⟨fun e => ht (e ▸ hj), fun e => hbD (e ▸ hj)⟩
      have hh := hstrong (d-2) (insert i {b}) hb hr (by rw [hsize])
        ⟨j, Finset.mem_sdiff.mpr ⟨hj, hj'⟩⟩
      rw [← h0, hGs]
      exact (Real.sqrt_le_sqrt hh).trans (by
        rw [Real.sqrt_mul (zero_le_one.trans (hBpow _))]
        exact mul_le_mul_of_nonneg_right (sqrt_le_self_of_one_le (hBpow _)) (Real.sqrt_nonneg _))
  have hsum := Finset.sum_le_sum hrootTerm
  rw [Finset.sum_const, nsmul_eq_mul] at hsum
  have hm : ((({b} : Finset (Fin d))ᶜ.card : ℕ) : ℝ) ≤ d := by exact_mod_cast hcard ({b} : Finset (Fin d))ᶜ
  have hb0 : 0 ≤ B^(d-1) := zero_le_one.trans (hBpow _)
  have hδ' : δ ≤ B^(d-1)*G (d-1) :=
    (hGδ _).trans (le_mul_of_one_le_left (hG0 _) (hBpow _))
  have hsum' := hsum.trans (mul_le_mul_of_nonneg_right hm (mul_nonneg hb0 (hG0 _)))
  refine (hRoot.trans (mul_le_mul_of_nonneg_left (add_le_add (add_le_add_right hδ' ρ) hsum') hA0)).trans ?_
  have hP : B^(d-1+1) ≤ B^(d+1) := pow_le_pow_right₀ hB (by omega)
  have hA' : A ≤ B^(d+1) := (le_mul_of_one_le_right hA0 hd1).trans
    (by simpa only [pow_one] using pow_le_pow_right₀ hB (by omega : 1 ≤ d+1))
  change _ ≤ B^(d+1) * (ρ + G (d-1))
  rw [mul_add (B^(d+1)) ρ]
  calc
    _ = A*ρ + B^(d-1+1)*G (d-1) := by rw [pow_succ]; unfold B; ring
    _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_right hA' hρ) (mul_le_mul_of_nonneg_right hP (hG0 _))


private theorem sqrt_mul_le_scaled {M A C U : ℝ} (hM : 0 < M) (hC : 1 ≤ C)
    (hA : A ≤ C*M) (hU : 0 ≤ U) :
    Real.sqrt (A*U) ≤ C*M*Real.sqrt (U/M) := by
  have hQ : 0 ≤ U/M := div_nonneg hU hM.le
  have h := Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_right hA hU)
  have he : C*M*U = (M^2) * (C * (U/M)) := by
    field_simp
  rw [he, Real.sqrt_mul (sq_nonneg M), Real.sqrt_sq hM.le, Real.sqrt_mul (zero_le_one.trans hC)] at h
  refine h.trans ?_
  rw [mul_assoc C M]
  calc
    _ ≤ M * (C * Real.sqrt (U/M)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (sqrt_le_self_of_one_le hC) (Real.sqrt_nonneg _))
        hM.le
    _ = _ := by ring

private theorem expansion_algebra_le {m : ℕ} (hm : 2 ≤ m)
    {σ θ P D A C M U : ℝ} (hσ : 0 ≤ σ) (hθ : 0 ≤ θ)
    (hC : 1 ≤ C) (hM : 0 < M) (hA : A ≤ M) (hD : D ≤ C*A) (hP : σ*P ≤ C*A) (hU : 0 ≤ U) :
    θ*(2*σ)^(m-1)*P + θ*σ^(m-2)*D + σ^(m-1)*Real.sqrt (D*U) ≤
      ((2 : ℝ)^(m-1) + 1)*C * (M * (θ * σ^(m-2) + σ^(m-1)*Real.sqrt (U/M))) := by
  have hp : (2*σ)^(m-1)*P = (2 : ℝ)^(m-1)*σ^(m-2) * (σ*P) := by
    rw [mul_pow, show m-1 = m-2+1 by omega, pow_succ σ]
    ring
  rw [mul_assoc θ _ P, hp]
  have hn : 0 ≤ σ^(m-2) := pow_nonneg hσ _
  have ho : 0 ≤ σ^(m-1) := pow_nonneg hσ _
  have hC0 := zero_le_one.trans hC
  have hD' := hD.trans (mul_le_mul_of_nonneg_left hA hC0)
  have hP' := hP.trans (mul_le_mul_of_nonneg_left hA hC0)
  have hs := sqrt_mul_le_scaled hM hC hD' hU
  have hp' := mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_left hP' (mul_nonneg (show 0 ≤ (2 : ℝ)^(m-1) by positivity) hn)) hθ
  have hd' := mul_le_mul_of_nonneg_left hD' (mul_nonneg hθ hn)
  refine (add_le_add (add_le_add hp' hd') (mul_le_mul_of_nonneg_left hs ho)).trans ?_
  have hS : σ^(m-1)*Real.sqrt (U/M) * (C*M) ≥ 0 := by positivity
  have hE : 0 ≤ (2 : ℝ)^(m-1) * (σ^(m-1)*Real.sqrt (U/M) * (C*M)) := by positivity
  nlinarith

private theorem twoCopy_expansion_algebra_le {σ P D a ab h C M U ρ : ℝ}
    (hσ : 0 ≤ σ) (hab : 0 < ab) (ha : 0 < a) (hh : 0 ≤ h) (hρ : 0 ≤ ρ)
    (hC : 1 ≤ C) (hM : 0 < M) (haM : a ≤ M) (hD : D ≤ C*a) (hP : σ*P ≤ C*a) (hU : 0 ≤ U) :
    9 * ((2*σ)*((ρ*h/ab)*(ρ*h/a))*P + ((ρ*h/ab)*(ρ*h/a))*D +
        σ * Real.sqrt (D*U)) ≤
      (27*C*ρ^2 + 9*C) * (M * (h^2/(ab*M) + σ*Real.sqrt (U/M))) := by
  let R := (ρ*h/ab)*(ρ*h/a)
  have hR : 0 ≤ R := by positivity
  have hC0 := zero_le_one.trans hC
  have he : R * (C*a) = C*ρ^2 * (h^2/ab) := by
    unfold R
    field_simp
  have hP' : (2*σ)*R*P ≤ 2*(C*ρ^2 * (h^2/ab)) := by
    calc
      _ = 2*(R*(σ*P)) := by ring
      _ ≤ 2*(R*(C*a)) := by gcongr
      _ = _ := by rw [he]
  have hD' := (mul_le_mul_of_nonneg_left hD hR).trans_eq he
  have hU' := mul_le_mul_of_nonneg_left (sqrt_mul_le_scaled hM hC
    (hD.trans (mul_le_mul_of_nonneg_left haM hC0)) hU) hσ
  have hh' : M * (h^2/(ab*M)) = h^2/ab := by field_simp
  change 9 * ((2*σ)*R*P + R*D + σ*Real.sqrt (D*U)) ≤ _
  refine (mul_le_mul_of_nonneg_left (add_le_add (add_le_add hP' hD') hU') (by norm_num)).trans ?_
  rw [mul_add M, hh']
  have h₁ : 0 ≤ (9*C) * (h^2/ab) := by positivity
  have h₂ : 0 ≤ (27*C*ρ^2) * (M * (σ*Real.sqrt (U/M))) := by positivity
  nlinarith


/-- The size bound for the unreflected expansion. -/
noncomputable def expansionSizeConstant (d : ℕ) (C : ℝ) : ℝ :=
  (3 : ℝ)^((2 : ℕ)^d) * ((2 : ℝ)^((2 : ℕ)^d) + 1)*C

/-- The base constant in the reflected energy induction. -/
noncomputable def residualEnergyBase (d : ℕ) (C ρ : ℝ) : ℝ :=
  1 + (2 : ℝ)^d + expansionSizeConstant d C + (27*C*ρ^2+9*C)

private theorem residualEnergyBase_ge_one (d : ℕ) {C ρ : ℝ} (hC : 0 ≤ C) :
    1 ≤ residualEnergyBase d C ρ := by
  unfold residualEnergyBase expansionSizeConstant
  have hN : 0 ≤ (2 : ℝ)^d := by positivity
  have hE : 0 ≤ (3 : ℝ)^((2 : ℕ)^d) * ((2 : ℝ)^((2 : ℕ)^d) + 1) * C := by positivity
  have hT : 0 ≤ 27*C*ρ^2 + 9*C := by positivity
  linarith

private theorem standard_refinement_cost_le {d : ℕ} (J : Finset (Fin d)) (hJ : J.Nonempty)
    (i : Fin d) (hi : i ∉ J) (u : ℤ) (T : ℕ)
    (ν : Fin d → ℕ) (hν : ∀ j, ν j ≤ J.card)
    {H : ℕ → (Fin d → ℝ) → ℝ} (hHm : ∀ l, Measurable (H l))
    (hHi : ∀ l, Integrable (H l)) (hH : ∀ l x, H l x ∈ Icc (0 : ℝ) 1)
    (σ : Fin d → ℝ) (hσ : ∀ j, σ j ∈ Icc (0 : ℝ) 1) (L : ∀ j, LowPathEstimate j (σ j))
    {a C M : ℝ} (hC : 1 ≤ C) (hM : 0 < M) (ha : a ≤ M)
    (hP : σ i * (∑ l ∈ Finset.range T, ∫ x, |(L i).drift (u + (l : ℤ) + (ν i : ℤ)) x|) ≤ C*a)
    (hD : (∑ l ∈ Finset.range T, ∫ x, ((L i).detail (u + (l : ℤ) + (ν i : ℤ)) x)^2) ≤ C*a) :
    let k (l : ℕ) (r : Fin d) := u + (l : ℤ) + (ν r : ℤ)
    let m : ℕ := 2^J.card
    let U := energyDef (insert i J) u T H (fun j => (L j).path)
    let θ := ∏ j ∈ Jᶜ.erase i, (σ j)^m
    (∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
      |(volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k l) n) *
        reflectedBoxDifference J i (k l) n (H l) (fun j => (L j).path)|) ≤
      expansionSizeConstant d C * (M * (θ * (σ i)^(m-2) + (σ i)^(m-1)*Real.sqrt (U/M))) := by
  dsimp only
  let m : ℕ := 2^J.card
  let K := insert i J
  let U := energyDef K u T H (fun j => (L j).path)
  let θ := ∏ j ∈ Jᶜ.erase i, (σ j)^m
  have hν' (j : Fin d) : ν j < K.card := by
    unfold K
    rw [Finset.card_insert_of_notMem hi]
    exact Nat.lt_succ_of_le (hν j)
  have hU : 0 ≤ U := energyDef_nonneg K ⟨i, Finset.mem_insert_self _ _⟩ u T hHm
    (fun l x => (abs_of_nonneg (hH l x).1).trans_le (hH l x).2)
    (fun j => (L j).pathMeasurable) (fun j r x => ((L j).pathBound r x).trans (hσ j).2)
  have hm : 2 ≤ m := by
    have hJc := Finset.card_pos.mpr hJ
    exact (pow_one (2 : ℕ)) ▸ pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) hJc
  have hmmax : m ≤ 2^d := by
    have hcard : J.card ≤ d := by simpa using Finset.card_le_univ J
    exact pow_le_pow_right₀ (by norm_num) hcard
  have hθ : 0 ≤ θ := Finset.prod_nonneg fun j _ => pow_nonneg (hσ j).1 _
  have hσi := (hσ i).1
  have hExp := boxExpand J i hi u T ν hν' hHm hHi hH
    (fun j => (L j).pathMeasurable) σ hσ (fun j => (L j).pathBound)
    (L i).drift (L i).detail (L i).driftMeasurable (L i).detailMeasurable
    (L i).driftIntegrable (L i).detailIntegrable (L i).driftBound (L i).detailBound
    (L i).pathConstant (L i).driftConstant (L i).detailConstant (L i).expansion
  have h := expansion_algebra_le hm hσi hθ hC hM ha hD hP hU
  have hC0 := zero_le_one.trans hC
  have hC' : (3 : ℝ)^m * (((2 : ℝ)^(m-1)+1)*C) ≤ expansionSizeConstant d C := by
    unfold expansionSizeConstant
    rw [mul_assoc]
    exact mul_le_mul
      (pow_le_pow_right₀ (by norm_num) hmmax)
      (mul_le_mul_of_nonneg_right (add_le_add_left
        (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) ((Nat.sub_le _ _).trans hmmax)) 1) hC0)
      (mul_nonneg (by positivity) hC0) (by positivity)
  refine hExp.trans ((mul_le_mul_of_nonneg_left h (by positivity)).trans ?_)
  rw [← mul_assoc]
  exact mul_le_mul_of_nonneg_right hC' (mul_nonneg hM.le (add_nonneg (mul_nonneg hθ
    (pow_nonneg hσi _)) (mul_nonneg (pow_nonneg hσi _) (Real.sqrt_nonneg _))))

private theorem density_refinement_cost_le {d : ℕ} (b i : Fin d) (hib : i ≠ b)
    (u : ℤ) (T : ℕ) (ν : Fin d → ℕ) (hν : ∀ j, ν j ≤ 1)
    {H : ℕ → (Fin d → ℝ) → ℝ} (hHm : ∀ l, Measurable (H l))
    (hHi : ∀ l, Integrable (H l)) (hH : ∀ l x, H l x ∈ Icc (0 : ℝ) 1)
    (σ : Fin d → ℝ) (hσ : ∀ j, σ j ∈ Icc (0 : ℝ) 1)
    (L : ∀ j, LowPathEstimate j (σ j))
    {a ab C M h ρ : ℝ} (hC : 1 ≤ C) (hM : 0 < M) (ha : 0 < a) (hab : 0 < ab)
    (haM : a ≤ M) (hh : 0 ≤ h) (hρ : 0 ≤ ρ)
    (hP : σ i * (∑ l ∈ Finset.range T, ∫ x, |(L i).drift (u + (l : ℤ) + (ν i : ℤ)) x|) ≤ C*a)
    (hD : (∑ l ∈ Finset.range T, ∫ x, ((L i).detail (u + (l : ℤ) + (ν i : ℤ)) x)^2) ≤ C*a)
    (hHb : ∀ (l : ℕ) n x, (∫ t, H l (Function.update x b t)
      ∂dyadicIntervalProbability (u + (l : ℤ) + (ν b : ℤ)) n) ≤ ρ*h/ab)
    (hHf : ∀ (l : ℕ) n x, (∫ y, H l (Function.update x i y)
      ∂dyadicIntervalProbability (u + (l : ℤ) + (ν i : ℤ)) n) ≤ ρ*h/a) :
    let k (l : ℕ) (r : Fin d) := u + (l : ℤ) + (ν r : ℤ)
    let U := energyDef (insert i {b}) u T H (fun j => (L j).path)
    (∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
      |(volume : Measure (Fin d → ℝ)).real (dyadicRectangle (k l) n) *
        reflectedBoxDifference {b} i (k l) n (H l) (fun j => (L j).path)|) ≤
      (27*C*ρ^2+9*C) * (M * (h^2/(ab*M) + σ i*Real.sqrt (U/M))) := by
  dsimp only
  have hν' (j : Fin d) : ν j < (insert i ({b} : Finset (Fin d))).card := by
    have hcard : (insert i ({b} : Finset (Fin d))).card = 2 := by simp [hib]
    rw [hcard]
    exact Nat.lt_succ_of_le (hν j)
  have hU : 0 ≤ energyDef (insert i {b}) u T H (fun j => (L j).path) :=
    energyDef_nonneg _ ⟨i, Finset.mem_insert_self _ _⟩ u T hHm
      (fun l x => (abs_of_nonneg (hH l x).1).trans_le (hH l x).2)
      (fun j => (L j).pathMeasurable) (fun j r x => ((L j).pathBound r x).trans (hσ j).2)
  have h := twoCopy b i hib u T ν hν' hHm hHi hH
    (fun j => (L j).pathMeasurable) σ hσ (fun j => (L j).pathBound)
    (L i).drift (L i).detail (L i).driftMeasurable (L i).detailMeasurable
    (L i).driftIntegrable (L i).detailIntegrable (L i).driftBound (L i).detailBound
    (L i).pathConstant (L i).driftConstant (L i).detailConstant (L i).expansion
    (show 0 ≤ ρ*h/ab by positivity) (show 0 ≤ ρ*h/a by positivity) hHb hHf
  exact h.trans (twoCopy_expansion_algebra_le (hσ i).1 hab ha hh hρ hC hM haM hD hP hU)


set_option maxHeartbeats 1800000 in
private theorem residualEnergy_le {d : ℕ} (hd : 2 ≤ d) (b : Fin d)
    (D : Finset (Fin d)) (hD : D.Nonempty) (hbD : b ∉ D) {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1)
    (u : ℤ) (T : ℕ) (H : ℕ → (Fin d → ℝ) → ℝ) (hHm : ∀ l, Measurable (H l))
    (hHi : ∀ l, Integrable (H l)) (hH : ∀ l x, H l x ∈ Icc (0 : ℝ) 1)
    (hord : ∀ l x, H (l+1) x ≤ H l x) (hterminal : H T = fun _ => 0)
    {h M C ρ : ℝ} (hh : 0 ≤ h) (hM : 0 < M) (hhM : h ≤ M) (hC : 1 ≤ C) (hρ : 0 ≤ ρ)
    (hLoss : (∑ l ∈ Finset.range T, ∫ x, H l x-H (l+1) x) ≤ h)
    (a : Fin d → ℝ) (ha : ∀ i, 0 < a i) (haM : ∀ i, a i ≤ M)
    (L : ∀ i : Fin d, LowPathEstimate i (if i ∈ D then δ else 1))
    (hDrift : ∀ i q, q ≤ d → (if i ∈ D then δ else 1) *
      (∑ l ∈ Finset.range T, ∫ x, |(L i).drift (u + (l : ℤ) + (q : ℤ)) x|) ≤ C*a i)
    (hDetail : ∀ i q, q ≤ d →
      (∑ l ∈ Finset.range T, ∫ x, ((L i).detail (u + (l : ℤ) + (q : ℤ)) x)^2) ≤ C*a i)
    (hDensity : ∀ (l q : ℕ), q ≤ 1 → ∀ i n x,
      (∫ y, H l (Function.update x i y) ∂dyadicIntervalProbability (u+(l : ℤ)+(q : ℤ)) n) ≤
        ρ*h/a i) :
    let P (i : Fin d) := (L i).path
    let B := residualEnergyBase d C ρ * ((d : ℝ)+1)^2
    energyDef {b} u T H P ≤ (B^(d+1)) * (h^2/a b + M*δ^((1/2 : ℝ)^(d-1))) := by
  classical
  dsimp only
  let σ (i : Fin d) := if i ∈ D then δ else 1
  let P (i : Fin d) := (L i).path
  let U (J : Finset (Fin d)) := energyDef J u T H P
  let W (J : Finset (Fin d)) := U J/M
  let A₀ := residualEnergyBase d C ρ
  let A := A₀ * ((d : ℝ)+1)
  let r := h^2/(a b*M)
  have hσ (i : Fin d) : σ i ∈ Icc (0 : ℝ) 1 := by
    unfold σ
    split
    · exact ⟨hδ.le, hδ1⟩
    · exact ⟨zero_le_one, le_rfl⟩
  have hσD (i : Fin d) (hi : i ∈ D) : σ i = δ := ite_eq_left hi
  have hA₀ : 1 ≤ A₀ := residualEnergyBase_ge_one d (zero_le_one.trans hC)
  have hA₀0 := zero_le_one.trans hA₀
  have hA : 1 ≤ A := hA₀.trans (le_mul_of_one_le_right hA₀0 (by linarith [Nat.cast_nonneg (α := ℝ) d]))
  have hr : 0 ≤ r := by dsimp [r]; positivity [ha b]
  have hN : (2 : ℝ)^d ≤ A₀ := by
    unfold A₀ residualEnergyBase expansionSizeConstant
    have hE : 0 ≤ (3 : ℝ)^((2 : ℕ)^d) * ((2 : ℝ)^((2 : ℕ)^d) + 1) * C := by positivity
    have hT : 0 ≤ 27*C*ρ^2+9*C := by positivity
    linarith
  have hE : expansionSizeConstant d C ≤ A₀ := by
    unfold A₀ residualEnergyBase
    have hT : 0 ≤ 27*C*ρ^2+9*C := by positivity
    linarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) d]
  have hT : 27*C*ρ^2+9*C ≤ A₀ := by
    unfold A₀ residualEnergyBase expansionSizeConstant
    have hE : 0 ≤ (3 : ℝ)^((2 : ℕ)^d) * ((2 : ℝ)^((2 : ℕ)^d) + 1) * C := by positivity
    linarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) d]
  have hLm (i : Fin d) := (L i).pathMeasurable
  have hLp (i : Fin d) := (L i).pathBound
  have hW (J : Finset (Fin d)) (hj : b ∈ J) : 0 ≤ W J := div_nonneg
    (energyDef_nonneg J ⟨b,hj⟩ u T hHm
      (fun l x => (abs_of_nonneg (hH l x).1).trans_le (hH l x).2) hLm
      (fun i k x => (hLp i k x).trans (hσ i).2)) hM.le
  let cost (J : Finset (Fin d)) (i : Fin d) (ν : Fin d → ℕ) :=
    ∑ l ∈ Finset.range T, ∑' n : Fin d → ℤ,
      let k (j : Fin d) := u + (l : ℤ) + (ν j : ℤ)
      |(volume : Measure (Fin d → ℝ)).real (dyadicRectangle k n) *
        reflectedBoxDifference J i k n (H l) P|
  let θ (J : Finset (Fin d)) (i : Fin d) :=
    (∏ j ∈ Jᶜ.erase i, (σ j)^((2 : ℕ)^J.card)) * (σ i)^((2^J.card : ℕ)-2)
  have hcost (J : Finset (Fin d)) (hj : b ∈ J) (i : Fin d) (hi : i ∉ J)
      (ν : Fin d → ℕ) (hν : ∀ j, ν j ≤ J.card) :
      cost J i ν ≤ A₀ * (M * (θ J i + (σ i)^((2^J.card : ℕ)-1)*Real.sqrt (W (insert i J)))) := by
    have hq : ν i ≤ d := (hν i).trans (by simpa using Finset.card_le_univ J)
    have h := standard_refinement_cost_le J ⟨b,hj⟩ i hi u T ν hν hHm hHi hH σ hσ L hC hM
      (haM i) (hDrift i (ν i) hq) (hDetail i (ν i) hq)
    refine h.trans (mul_le_mul_of_nonneg_right hE ?_)
    have hθ : 0 ≤ θ J i := mul_nonneg (Finset.prod_nonneg fun j _ => pow_nonneg (hσ j).1 _)
      (pow_nonneg (hσ i).1 _)
    exact mul_nonneg hM.le (add_nonneg hθ (mul_nonneg (pow_nonneg (hσ i).1 _) (Real.sqrt_nonneg _)))
  have hdensity (i : Fin d) (hi : i ≠ b) (ν : Fin d → ℕ) (hν : ∀ j, ν j ≤ 1) :
      cost {b} i ν ≤ A₀ * (M * (r + σ i*Real.sqrt (W (insert i {b})))) := by
    have hq : ν i ≤ d := (hν i).trans (by omega)
    have h := density_refinement_cost_le b i hi u T ν hν hHm hHi hH σ hσ L hC hM
      (ha i) (ha b) (haM i) hh hρ (hDrift i (ν i) hq) (hDetail i (ν i) hq)
      (fun l => hDensity l (ν b) (hν b) b) (fun l => hDensity l (ν i) (hν i) i)
    exact h.trans (mul_le_mul_of_nonneg_right hT (mul_nonneg hM.le
      (add_nonneg hr (mul_nonneg (hσ i).1 (Real.sqrt_nonneg _)))))
  have hrec (J : Finset (Fin d)) (hj : b ∈ J) {t : ℝ} (ht : 0 ≤ t)
      (hAmp : (∏ i ∈ Jᶜ, (σ i)^((2 : ℕ)^J.card)) ≤ t) (g : Fin d → ℝ)
      (hg : ∀ i, 0 ≤ g i)
      (hCost : ∀ i ∉ J, ∀ ν : Fin d → ℕ, (∀ j, ν j ≤ J.card) →
        cost J i ν ≤ A₀ * (M*(t+g i))) :
      W J ≤ A * (t + ∑ i ∈ Jᶜ, g i) := by
    have hb := energyDef_le_of_refinement_cost J ⟨b,hj⟩ u T H hHm hHi hH hord hterminal hLoss
      hLm σ hσ hLp (fun i => A₀*(M*(t+g i))) hCost
    let c := ((2^J.card : ℕ) : ℝ)
    have hc : c ≤ A₀ := by
      have hjd : J.card ≤ d := by simpa using Finset.card_le_univ J
      refine (le_trans ?_ hN)
      unfold c
      exact_mod_cast (pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) hjd)
    have hBoundary : c*(∏ i ∈ Jᶜ, (σ i)^((2 : ℕ)^J.card))*h ≤ A₀*M*t := by
      have hθ : 0 ≤ ∏ i ∈ Jᶜ, (σ i)^((2 : ℕ)^J.card) :=
        Finset.prod_nonneg fun i _ => pow_nonneg (hσ i).1 _
      have hm := mul_le_mul (mul_le_mul hc hAmp hθ hA₀0) hhM hh (mul_nonneg hA₀0 ht)
      exact hm.trans_eq (by ring)
    apply (div_le_iff₀ hM).mpr
    refine (hb.trans (add_le_add_left hBoundary _)).trans ?_
    simp_rw [← mul_assoc (a := A₀), ← Finset.mul_sum, Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul]
    have hd' : ((Jᶜ.card : ℕ) : ℝ) ≤ d := by exact_mod_cast
      (show Jᶜ.card ≤ d from by simpa using Finset.card_le_univ Jᶜ)
    have hsum0 : 0 ≤ ∑ i ∈ Jᶜ, g i := Finset.sum_nonneg fun i _ => hg i
    have hmul := mul_le_mul_of_nonneg_right hd' (mul_nonneg (mul_nonneg hA₀0 hM.le) ht)
    change _ ≤ A₀ * ((d : ℝ)+1) * (t + ∑ i ∈ Jᶜ, g i) * M
    nlinarith [mul_nonneg (mul_nonneg hA₀0 hM.le) (mul_nonneg (Nat.cast_nonneg (α := ℝ) d) hsum0)]
  have hpow (J : Finset (Fin d)) (hj : b ∈ J) (i : Fin d) :
      (σ i)^((2^J.card : ℕ)-1) ≤ σ i := by
    have hm : 2 ≤ (2 : ℕ)^J.card := by
      simpa only [pow_one] using pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2)
        (Finset.card_pos.mpr ⟨b,hj⟩)
    exact (pow_le_pow_of_le_one (hσ i).1 (hσ i).2 (show 1 ≤ (2^J.card : ℕ)-1 by omega)).trans_eq (pow_one _)
  have hθone (J : Finset (Fin d)) (i : Fin d) : θ J i ≤ 1 :=
    (mul_le_of_le_one_right (Finset.prod_nonneg fun j _ => pow_nonneg (hσ j).1 _)
      (pow_le_one₀ (hσ i).1 (hσ i).2)).trans (product_pow_unit_le_one _ σ hσ _)
  have hθgain (J : Finset (Fin d)) (i : Fin d) (hJ : (D \ J).Nonempty)
      (hn : 1 ≤ (2^J.card : ℕ)-2 ∨ i ∉ D) : θ J i ≤ δ := by
    obtain ⟨j,hj⟩ := hJ
    obtain ⟨hjD,hjJ⟩ := Finset.mem_sdiff.mp hj
    unfold θ
    by_cases hji : j = i
    · subst j
      have he : 1 ≤ (2^J.card : ℕ)-2 := hn.resolve_right (not_not.mpr hjD)
      have hp := (pow_le_pow_of_le_one (hσ i).1 (hσ i).2 he).trans_eq (by rw [pow_one,hσD i hjD])
      exact (mul_le_of_le_one_left (pow_nonneg (hσ i).1 _) (product_pow_unit_le_one _ σ hσ _)).trans hp
    · have he := product_pow_gain (Jᶜ.erase i) σ hσ
        (Finset.mem_erase.mpr ⟨hji,Finset.mem_compl.mpr hjJ⟩) (hσD j hjD)
        (show 1 ≤ (2 : ℕ)^J.card from one_le_pow₀ (by norm_num))
      exact (mul_le_of_le_one_right (Finset.prod_nonneg fun j _ => pow_nonneg (hσ j).1 _)
        (pow_le_one₀ (hσ i).1 (hσ i).2)).trans he
  have hBgain (J : Finset (Fin d)) (h : (D \ J).Nonempty) :
      (∏ i ∈ Jᶜ, (σ i)^((2 : ℕ)^J.card)) ≤ δ := by
    obtain ⟨i,hi⟩ := h
    obtain ⟨hiD,hiJ⟩ := Finset.mem_sdiff.mp hi
    exact product_pow_gain _ σ hσ (Finset.mem_compl.mpr hiJ) (hσD i hiD) (one_le_pow₀ (by norm_num))
  have hBasic (J : Finset (Fin d)) (hj : b ∈ J) :
      W J ≤ A*(1 + ∑ i ∈ Jᶜ, Real.sqrt (W (insert i J))) := by
    apply hrec J hj zero_le_one (product_pow_unit_le_one _ σ hσ _) _ (fun _ => Real.sqrt_nonneg _)
    intro i hi ν hν
    refine (hcost J hj i hi ν hν).trans ?_
    exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (add_le_add (hθone J i)
      (mul_le_of_le_one_left (Real.sqrt_nonneg _) (pow_le_one₀ (hσ i).1 (hσ i).2))) hM.le) hA₀0
  have hStrong (J : Finset (Fin d)) (hj : b ∈ J) (hj2 : 2 ≤ J.card) (hjD : (D \ J).Nonempty) :
      W J ≤ A*(δ + ∑ i ∈ Jᶜ, σ i*Real.sqrt (W (insert i J))) := by
    apply hrec J hj hδ.le (hBgain J hjD) _ (fun i => mul_nonneg (hσ i).1 (Real.sqrt_nonneg _))
    intro i hi ν hν
    have hn : 4 ≤ (2 : ℕ)^J.card := by
      simpa using pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) hj2
    refine (hcost J hj i hi ν hν).trans ?_
    exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (add_le_add
      (hθgain J i hjD (Or.inl (by omega))) (mul_le_mul_of_nonneg_right (hpow J hj i)
        (Real.sqrt_nonneg _))) hM.le) hA₀0
  have hb : b ∈ ({b} : Finset (Fin d)) := Finset.mem_singleton_self b
  have hDroot : (D \ ({b} : Finset (Fin d))).Nonempty := by
    obtain ⟨j,hj⟩ := hD
    exact ⟨j,Finset.mem_sdiff.mpr ⟨hj, fun h => hbD ((Finset.mem_singleton.mp h) ▸ hj)⟩⟩
  have hRoot : W {b} ≤ A*(r+δ + ∑ i ∈ ({b} : Finset (Fin d))ᶜ, σ i*Real.sqrt (W (insert i {b}))) := by
    have hδr : δ ≤ r+δ := le_add_of_nonneg_left hr
    apply hrec {b} hb (add_nonneg hr hδ.le) ((hBgain {b} hDroot).trans hδr)
      _ (fun i => mul_nonneg (hσ i).1 (Real.sqrt_nonneg _))
    intro i hi ν hν
    by_cases hiD : i ∈ D
    · refine (hdensity i (by simpa using hi) ν (by simpa using hν)).trans ?_
      exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (add_le_add_left
        (le_add_of_nonneg_right hδ.le) _) hM.le) hA₀0
    · refine (hcost {b} hb i hi ν hν).trans ?_
      exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (add_le_add
        ((hθgain {b} i hDroot (Or.inr hiD)).trans hδr)
        (mul_le_mul_of_nonneg_right (hpow {b} hb i) (Real.sqrt_nonneg _))) hM.le) hA₀0
  have hu := residual_induction_bound b hd D hD hbD hδ hδ1 W hW hA hr hBasic hStrong hRoot
  dsimp only at hu
  change U {b}/M ≤ (A*((d : ℝ)+1))^(d+1) * (r+δ^((1/2 : ℝ)^(d-1))) at hu
  have hu' := (div_le_iff₀ hM).mp hu
  refine hu'.trans_eq ?_
  have hm : M*r = h^2/a b := by dsimp [r]; field_simp [hM.ne', (ha b).ne']
  rw [mul_assoc, mul_comm (r+_), mul_add M r, hm]
  have he : A*((d : ℝ)+1) = A₀*((d : ℝ)+1)^2 := by unfold A; ring
  rw [he]


private def LowPathEstimate.withAmplitude {d : ℕ} {i : Fin d} {a b : ℝ}
    (h : a = b) (P : LowPathEstimate i a) : LowPathEstimate i b :=
  cast (congrArg (LowPathEstimate i) h) P

private theorem LowPathEstimate.cast_path {d : ℕ} {i : Fin d} {a b : ℝ}
    (h : a=b) (P : LowPathEstimate i a) :
    (LowPathEstimate.withAmplitude h P).path = P.path := by cases h; rfl

private theorem LowPathEstimate.cast_drift {d : ℕ} {i : Fin d} {a b : ℝ}
    (h : a=b) (P : LowPathEstimate i a) :
    (LowPathEstimate.withAmplitude h P).drift = P.drift := by cases h; rfl

private theorem LowPathEstimate.cast_detail {d : ℕ} {i : Fin d} {a b : ℝ}
    (h : a=b) (P : LowPathEstimate i a) :
    (LowPathEstimate.withAmplitude h P).detail = P.detail := by cases h; rfl

/-- The mixed low path uses a zero-reset residual in the marked residual slots. -/
noncomputable def mixedLowPath {d : ℕ} (u : ℤ) (δ : ℝ) (D : Finset (Fin d))
    (f : Fin d → (Fin d → ℝ) → ℝ) (i : Fin d) (k : ℤ) : (Fin d → ℝ) → ℝ :=
  if i ∈ D then coordinateResidual i u δ (f i) (k-u).toNat else coordinateAverage i k (f i)

/-- A dimension- and pruning-dependent constant for the residual estimate. -/
noncomputable def residualBoundConstant (d : ℕ) (K : ℝ) : ℝ :=
  (residualEnergyBase d (2 + recordingVariationConstant 1) ((2:ℝ)^(d+1)*K) *
    ((d : ℝ)+1)^2)^(d+1)

theorem residualBoundConstant_ge_one (d : ℕ) (K : ℝ) : 1 ≤ residualBoundConstant d K := by
  unfold residualBoundConstant
  have h₀ : 1 ≤ residualEnergyBase d (2 + recordingVariationConstant 1) ((2 : ℝ)^(d+1)*K) :=
    residualEnergyBase_ge_one d (by linarith [recordingVariationConstant_pos 1])
  have h₁ : 1 ≤ ((d : ℝ)+1)^2 := one_le_pow₀ (le_add_of_nonneg_left (Nat.cast_nonneg d))
  exact one_le_pow₀ (h₀.trans (le_mul_of_one_le_right (zero_le_one.trans h₀) h₁))

private theorem residual_sqrt_bound {a h M B δ : ℝ} {d : ℕ} (hd : 0 < d)
    (ha : 0 < a) (hh : 0 ≤ h) (hM : a ≤ M) (hB : 1 ≤ B) (hδ : 0 ≤ δ) {U : ℝ}
    (hU : U ≤ B * (h^2/a + M*δ^((1/2 : ℝ)^(d-1)))) :
    Real.sqrt (a*U) ≤ B*(h + M*δ^((1/2 : ℝ)^d)) := by
  let G := δ^((1/2 : ℝ)^(d-1))
  have hG : 0 ≤ G := recordedGain_nonneg hδ _
  have hM0 := ha.le.trans hM
  have he : a * (B*(h^2/a+M*G)) ≤ B*(h^2+M^2*G) := by
    have hp := mul_le_mul_of_nonneg_right hM (mul_nonneg hM0 hG)
    have hm : a * (h^2/a) = h^2 := by field_simp
    calc
      _ = B * (h^2 + a*(M*G)) := by rw [mul_left_comm, mul_add, hm]
      _ ≤ _ := by
        apply mul_le_mul_of_nonneg_left _ (zero_le_one.trans hB)
        rw [pow_two M, mul_assoc M M G]
        exact add_le_add le_rfl hp
  have hs := Real.sqrt_le_sqrt ((mul_le_mul_of_nonneg_left hU ha.le).trans he)
  have he' : Real.sqrt (h^2+M^2*G) ≤ h + M*δ^((1/2 : ℝ)^d) := by
    have hy : 0 ≤ M^2*G := mul_nonneg (sq_nonneg M) hG
    have hs' : Real.sqrt (h^2+M^2*G) ≤ Real.sqrt (h^2) + Real.sqrt (M^2*G) := by
      apply (Real.sqrt_le_left (add_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))).mpr
      nlinarith [Real.sq_sqrt (sq_nonneg h), Real.sq_sqrt hy,
        mul_nonneg (Real.sqrt_nonneg (h^2)) (Real.sqrt_nonneg (M^2*G))]
    refine hs'.trans_eq ?_
    rw [Real.sqrt_sq hh, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hM0]
    have h := (recordedGain_succ hδ (d-1)).symm
    change Real.sqrt G = _ at h
    rw [show d-1+1 = d by omega] at h
    rw [h]
  rw [Real.sqrt_mul (zero_le_one.trans hB)] at hs
  exact hs.trans (mul_le_mul (sqrt_le_self_of_one_le hB) he' (Real.sqrt_nonneg _) (zero_le_one.trans hB))


/-- The masked mixed-path form on a finite scale window. -/
noncomputable def maskedMixedDyadicForm {d : ℕ} (b : Fin d) (u : ℤ) (T : ℕ) (c : ℕ → ℝ)
    (H : ℕ → (Fin d → ℝ) → ℝ) (f : Fin d → (Fin d → ℝ) → ℝ)
    (δ : ℝ) (D : Finset (Fin d)) : ℝ :=
  ∑ l ∈ Finset.range T, c l * ∫ x, H l x *
    (∏ i ∈ ({b} : Finset (Fin d))ᶜ, mixedLowPath u δ D f i (u+l) x) *
    coordinateDifference b (u+l) (f b) x

set_option maxHeartbeats 1500000 in
/-- The residual estimate of the reflected-rectangle argument. -/
theorem residual {d : ℕ} (hd : 2 ≤ d) (b : Fin d) (u : ℤ) (T : ℕ)
    (c : ℕ → ℝ) (hc : ∀ k, |c k| ≤ 1)
    (A : Option (Fin d) → Set (Fin d → ℝ)) (H : (Fin d → ℝ) → ℝ)
    (G : Fin d → (Fin d → ℝ) → ℝ) (hG : DyadicSupported A (fun i => i.elim H G))
    (ha : ∀ i, 0 < (volume : Measure (Fin d → ℝ)).real (A i))
    {M : ℝ} (hM : ∀ i, (volume : Measure (Fin d → ℝ)).real (A i) ≤ M)
    {K : ℝ} (hK : 0 < K) {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1)
    (D : Finset (Fin d)) (hD : D.Nonempty) (hbD : b ∉ D) :
    let h := (volume : Measure (Fin d → ℝ)).real (A none)
    let τ (i : Fin d) := K*h / volume.real (A (some i))
    let H' := pruningTester u T (A none) τ H
    |maskedMixedDyadicForm b u T c H' G δ D| ≤
      residualBoundConstant d K * (h + M*δ^((1/2 : ℝ)^d)) := by
  classical
  dsimp only
  let h := (volume : Measure (Fin d → ℝ)).real (A none)
  let a (i : Fin d) := (volume : Measure (Fin d → ℝ)).real (A (some i))
  let τ (i : Fin d) := K*h/a i
  let H' := pruningTester u T (A none) τ H
  let C := 2 + recordingVariationConstant 1
  let ρ := (2 : ℝ)^(d+1)*K
  let σ (i : Fin d) := if i ∈ D then δ else 1
  have hh : 0 < h := ha none
  have hM0 : 0 < M := hh.trans_le (hM none)
  have hC : 1 ≤ C := by dsimp [C]; linarith [recordingVariationConstant_pos 1]
  have hρ : 0 ≤ ρ := by dsimp [ρ]; positivity
  have hτ (i : Fin d) : 0 ≤ τ i := by dsimp [τ]; positivity [ha (some i)]
  have hHm : Measurable H := (hG none).2.2.1
  have hH0 : ∀ x, 0 ≤ H x := (hG none).2.2.2.1
  have hH1 : ∀ x, H x ≤ (A none).indicator (fun _ => 1) x := (hG none).2.2.2.2
  have hGM (i : Fin d) : Measurable (G i) := (hG (some i)).2.2.1
  have hG1 (i : Fin d) (x : Fin d → ℝ) : |G i x| ≤ 1 := supported_abs_le_one hG (some i) x
  have hGI (i : Fin d) : Integrable (G i) := by
    have hi := lpNorm_le_of_indicator (hG (some i)).1 (hG (some i)).2.1 (hGM i)
      (hG (some i)).2.2.2.1 (hG (some i)).2.2.2.2 (p := 1) (by norm_num)
    exact memLp_one_iff_integrable.mp (by simpa only [ENNReal.ofReal_one] using hi.1)
  have hG2 (i : Fin d) : MemLp (G i) 2 volume := by
    have hi := lpNorm_le_of_indicator (hG (some i)).1 (hG (some i)).2.1 (hGM i)
      (hG (some i)).2.2.2.1 (hG (some i)).2.2.2.2 (p := 2) (by norm_num)
    simpa using hi.1
  have hGarea (i : Fin d) : (∫ x, (G i x)^2) ≤ a i :=
    integral_sq_le_support (hG (some i)).1 (hG (some i)).2.1 (hG2 i)
      (hG (some i)).2.2.2.1 (hG (some i)).2.2.2.2
  have hH'm (l : ℕ) : Measurable (H' l) := pruningTester_measurable u T (hG none).1 τ hHm l
  have hH'0 (l : ℕ) (x : Fin d → ℝ) : 0 ≤ H' l x :=
    pruningTester_nonneg u T (A none) τ hH0 l x
  have hH'1 (l : ℕ) (x : Fin d → ℝ) : H' l x ≤ (A none).indicator (fun _ => 1) x :=
    (pruningTester_le u T (A none) τ hH0 l x).trans (hH1 x)
  have hH' (l : ℕ) (x : Fin d → ℝ) : H' l x ∈ Icc (0 : ℝ) 1 := by
    refine ⟨hH'0 l x, (hH'1 l x).trans ?_⟩
    by_cases hx : x ∈ A none <;> simp [hx]
  have hH'I (l : ℕ) : Integrable (H' l) := by
    have h := lpNorm_le_of_indicator (hG none).1 (hG none).2.1 (hH'm l) (hH'0 l)
      (hH'1 l) (p := 1) (by norm_num)
    exact memLp_one_iff_integrable.mp (by simpa only [ENNReal.ofReal_one] using h.1)
  have hH'mono (l : ℕ) (x : Fin d → ℝ) : H' (l+1) x ≤ H' l x :=
    pruningTester_antitone u T (A none) τ hH0 x (Nat.le_succ _)
  have hH'T : H' T = fun _ => 0 := by funext x; simp [H', pruningTester]
  have hLoss : (∑ l ∈ Finset.range T, ∫ x, H' l x-H' (l+1) x) ≤ h := by
    have h := pruningTester_integral_loss_le u T (hG none).1 (hG none).2.1 τ hHm hH0 hH1
    change (∑ l ∈ Finset.range T, ∫ x, |H' l x - H' (l+1) x|) ≤ _ at h
    simpa only [abs_of_nonneg (sub_nonneg.mpr (hH'mono _ _))] using h
  have hDensity (l q : ℕ) (hq : q ≤ 1) (i : Fin d) (n : ℤ) (x : Fin d → ℝ) :
      (∫ y, H' l (Function.update x i y) ∂dyadicIntervalProbability (u+(l : ℤ)+(q : ℤ)) n) ≤
        ρ*h/a i := by
    have he := pruningTester_fiberProbability_le i u T l q (hG none).1 τ (hτ i) hHm hH0 hH1 n x
    refine he.trans (le_trans (mul_le_mul_of_nonneg_right
      (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) (by omega : q ≤ d+1)) (hτ i)) ?_)
    unfold τ ρ
    ring_nf
    exact le_rfl
  let L (i : Fin d) : LowPathEstimate i (σ i) :=
    if hi : i ∈ D then LowPathEstimate.withAmplitude (ite_eq_left hi).symm
      (recordedResidualLowPath i u hδ.le (G i) (hGM i) (hGI i) (hG2 i))
    else LowPathEstimate.withAmplitude (ite_eq_right hi).symm
      (ordinaryLowPath i (G i) (hGM i) (hG1 i) (hG2 i))
  have hLPath : (fun i => (L i).path) = mixedLowPath u δ D G := by
    funext i k
    by_cases hi : i ∈ D
    · simp only [L, dite_eq_left hi, LowPathEstimate.cast_path, mixedLowPath, ite_eq_left hi,
        recordedResidualLowPath]
    · simp only [L, dite_eq_right hi, LowPathEstimate.cast_path, mixedLowPath, ite_eq_right hi,
        ordinaryLowPath]
  have hbudget (i : Fin d) (q : ℕ) (hq : q ≤ d) :
      σ i * (∑ l ∈ Finset.range T, ∫ x, |(L i).drift (u+(l : ℤ)+(q : ℤ)) x|) ≤ C*a i ∧
      (∑ l ∈ Finset.range T, ∫ x, ((L i).detail (u+(l : ℤ)+(q : ℤ)) x)^2) ≤ C*a i := by
    by_cases hi : i ∈ D
    · let R := recordedResidualLowPath i u hδ.le (G i) (hGM i) (hGI i) (hG2 i)
      have hp : (L i).drift = R.drift := by
        simp only [L, dite_eq_left hi, LowPathEstimate.cast_drift, R]
      have hq' : (L i).detail = R.detail := by
        simp only [L, dite_eq_left hi, LowPathEstimate.cast_detail, R]
      have he := residualLowPath_budget i u (T+d+1) hδ hδ1 (hG (some i)).1 (hG (some i)).2.1
        (hGM i) (hGI i) (hG2 i) (hG (some i)).2.2.2.1 (hG (some i)).2.2.2.2
      have hS : q+T ≤ T+d+1 := by omega
      have hP := finite_sum_offset_le (g := fun l => ∫ x, |R.drift (u+(l : ℤ)) x|)
        (fun _ => integral_nonneg fun _ => abs_nonneg _) T q (T+d+1) hS
      have hQ := finite_sum_offset_le (g := fun l => ∫ x, (R.detail (u+(l : ℤ)) x)^2)
        (fun _ => integral_nonneg fun _ => sq_nonneg _) T q (T+d+1) hS
      rw [hp,hq',show σ i = δ from ite_eq_left hi]
      push_cast at hP hQ
      simp only [← add_assoc] at hP hQ
      exact ⟨(mul_le_mul_of_nonneg_left hP hδ.le).trans he.1, hQ.trans he.2⟩
    · have hp : (L i).drift = fun _ _ => 0 := by
        simp only [L, dite_eq_right hi, LowPathEstimate.cast_drift, ordinaryLowPath]
      have hq' : (L i).detail = fun k => coordinateHaarCoefficient i k (G i) := by
        simp only [L, dite_eq_right hi, LowPathEstimate.cast_detail, ordinaryLowPath]
      rw [hp,hq']
      constructor
      · simp only [abs_zero, integral_zero, Finset.sum_const_zero, mul_zero]
        exact mul_nonneg (zero_le_one.trans hC) (ha (some i)).le
      · have hn := (truePath_haar_bounds i (u+(q : ℤ)) (hGM i) (hG1 i) (hG2 i) T).2
        have he (l : ℕ) : u+(l : ℤ)+(q : ℤ) = u+(q : ℤ)+(l : ℤ) := by omega
        simp_rw [he]
        exact hn.trans ((hGarea i).trans (le_mul_of_one_le_left (ha (some i)).le hC))
  have hEnergy := residualEnergy_le hd b D hD hbD hδ hδ1 u T H' hH'm hH'I hH'
    hH'mono hH'T hh.le hM0 (hM none) hC hρ hLoss a (fun i => ha (some i))
    (fun i => hM (some i)) L (fun i q hq => (hbudget i q hq).1)
    (fun i q hq => (hbudget i q hq).2) hDensity
  dsimp only at hEnergy
  rw [hLPath] at hEnergy
  have hPathM (i : Fin d) : ∀ k, Measurable (mixedLowPath u δ D G i k) := by
    rw [← hLPath]
    exact (L i).pathMeasurable
  have hPathB (i : Fin d) (k : ℤ) (x : Fin d → ℝ) : |mixedLowPath u δ D G i k x| ≤ 1 := by
    rw [← hLPath]
    exact ((L i).pathBound k x).trans (by change σ i ≤ 1; unfold σ; split <;> simp [hδ1])
  have hform := boxSquare_pairing b u T c hc hH'm hH'I hH'0 (fun l x => (hH' l x).2)
    hPathM hPathB (hGM b) (hG1 b) (hG2 b)
  have hU : 0 ≤ energyDef {b} u T H' (mixedLowPath u δ D G) :=
    energyDef_nonneg _ ⟨b,Finset.mem_singleton_self _⟩ u T hH'm
      (fun l x => (abs_of_nonneg (hH'0 l x)).trans_le (hH' l x).2) hPathM hPathB
  change energyDef {b} u T H' (mixedLowPath u δ D G) ≤
    residualBoundConstant d K * (h^2 / a b + M * δ^((1/2 : ℝ)^(d-1))) at hEnergy
  have hSqrt := residual_sqrt_bound (show 0 < d by omega) (ha (some b)) hh.le (hM (some b))
    (residualBoundConstant_ge_one d K) hδ.le hEnergy
  exact hform.trans ((Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_right (hGarea b) hU)).trans hSqrt)

