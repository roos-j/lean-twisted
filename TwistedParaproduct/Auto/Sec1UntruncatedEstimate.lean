/-- The Fourier estimate stated in the blueprint's Lean appendix. -/
def BanachTarget : Prop :=
  ∀ (d : ℕ), 2 ≤ d → ∀ (p : Fin d → ℝ) (r : ℝ),
    (∀ j, 1 < p j) → 1 < r → r⁻¹ = ∑ j, (p j)⁻¹ →
    ∃ (N : ℕ) (C : ℝ), 0 < C ∧ ∀ (m : E d → ℂ) (B : ℝ),
      0 ≤ B → (∀ n : ℕ, ContDiffOn ℝ n m {x | x ≠ 0}) →
      (∀ k ≤ N, ∀ z : E d, z ≠ 0 →
        ‖z‖ ^ k * ‖iteratedFDeriv ℝ k m z‖ ≤ B) →
      ∀ f : Fin d → SchwartzMap (E d) ℂ,
        eLpNorm (twisted m f) (ENNReal.ofReal r) volume ≤
          ENNReal.ofReal (C * B) *
            ∏ j, eLpNorm (fun x => f j x) (ENNReal.ofReal (p j)) volume

private theorem continuous_diagonalFrequency {d : ℕ} :
    Continuous (@diagonalFrequency d) := by
  unfold diagonalFrequency
  exact Continuous.comp (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ)) (continuous_pi fun j =>
    (PiLp.continuous_apply 2 _ j).comp (continuous_apply j))

theorem ae_diagonalFrequency_ne_zero {d : ℕ} (j : Fin d) :
    ∀ᵐ ξ : Fin d → E d ∂volume, diagonalFrequency ξ ≠ 0 := by
  have hcoord : QuasiMeasurePreserving (fun x : E d => x j) volume volume :=
    (Measure.quasiMeasurePreserving_eval (fun _ : Fin d => (volume : Measure ℝ)) j).comp
      (PiLp.volume_preserving_ofLp (Fin d)).quasiMeasurePreserving
  have h := (hcoord.comp
    (Measure.quasiMeasurePreserving_eval (fun _ : Fin d => (volume : Measure (E d))) j))
  change QuasiMeasurePreserving (fun ξ : Fin d → E d => ξ j j) volume volume at h
  have hj : ∀ᵐ ξ : Fin d → E d ∂volume, ξ j j ≠ 0 :=
    h.ae (ae_ne (volume : Measure ℝ) 0)
  filter_upwards [hj] with ξ hξ he
  exact hξ (congrArg (fun z : E d => z j) he)

theorem fourierIntegrand_measurable {d : ℕ} {m : E d → ℂ}
    (hm : Measurable m) (f : Fin d → SchwartzMap (E d) ℂ) (x : E d) :
    Measurable (fourierIntegrand m f x) := by
  unfold fourierIntegrand
  refine ((hm.comp continuous_diagonalFrequency.measurable).mul ?_).mul ?_
  · exact Finset.measurable_prod _ fun j _ =>
      (𝓕 (f j)).continuous.measurable.comp (measurable_pi_apply j)
  · fun_prop

theorem integrable_fourierMajorant {d : ℕ}
    (f : Fin d → SchwartzMap (E d) ℂ) (B : ℝ) :
    Integrable (fun ξ : Fin d → E d => B * ∏ j, ‖(𝓕 (f j)) (ξ j)‖) := by
  exact (Integrable.fintype_prod (μ := fun _ : Fin d => (volume : Measure (E d)))
    (fun j => ((𝓕 (f j)).integrable (μ := volume)).norm)).const_mul B

theorem norm_fourierIntegrand_le {d : ℕ} {m : E d → ℂ} {B : ℝ}
    (f : Fin d → SchwartzMap (E d) ℂ) (x : E d)
    (ξ : Fin d → E d) (hB : ‖m (diagonalFrequency ξ)‖ ≤ B) :
    ‖fourierIntegrand m f x ξ‖ ≤ B * ∏ j, ‖(𝓕 (f j)) (ξ j)‖ := by
  simp only [fourierIntegrand, norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one, norm_prod]
  exact mul_le_mul_of_nonneg_right hB (Finset.prod_nonneg fun _ _ => norm_nonneg _)

/-- Absolute convergence and continuity in `bp:schwartz-Fourier`, for a bounded symbol. -/
theorem schwartzFourier_convergence {d : ℕ} (hd : 0 < d) {m : E d → ℂ} {B : ℝ}
    (hm : ContinuousOn m {x | x ≠ 0}) (hB : ∀ z ≠ 0, ‖m z‖ ≤ B)
    (f : Fin d → SchwartzMap (E d) ℂ) :
    (∀ x, Integrable (fourierIntegrand m f x)) ∧ Continuous (twisted m f) := by
  have hmm : Measurable m := measurable_of_continuousOn_compl_singleton 0 hm
  have hmeas x : AEStronglyMeasurable (fourierIntegrand m f x) volume :=
    (fourierIntegrand_measurable hmm f x).aestronglyMeasurable
  have hbound x : ∀ᵐ ξ : Fin d → E d ∂volume,
      ‖fourierIntegrand m f x ξ‖ ≤ B * ∏ j, ‖(𝓕 (f j)) (ξ j)‖ :=
    (ae_diagonalFrequency_ne_zero ⟨0, hd⟩).mono fun ξ hξ =>
      norm_fourierIntegrand_le f x ξ (hB _ hξ)
  have hint := integrable_fourierMajorant f B
  refine ⟨fun x => hint.mono' (hmeas x) (hbound x), ?_⟩
  refine continuous_of_dominated hmeas hbound hint (Filter.Eventually.of_forall fun ξ => ?_)
  fun_prop

/-- Changing the multiplier at the origin leaves equation `bp:op` unchanged. -/
theorem twisted_congr_off_origin {d : ℕ} (hd : 0 < d) {m m' : E d → ℂ}
    (h : ∀ z ≠ 0, m z = m' z) (f : Fin d → SchwartzMap (E d) ℂ) (x : E d) :
    twisted m f x = twisted m' f x := by
  apply integral_congr_ae
  filter_upwards [ae_diagonalFrequency_ne_zero ⟨0, hd⟩] with ξ hξ
  simp only [h _ hξ]

/-- Equivalence of coordinate and Fréchet derivative bounds in `bp:frechet`.
The coordinate bounds use ordered tuples of standard basis directions. -/
theorem frechet {d N : ℕ} [NeZero d] {m : E d → ℂ} {B : ℝ} (hB : 0 ≤ B) :
    (MikhlinHormander.MikhlinCondition N m B →
      MikhlinHormander.CoordinateMikhlinCondition N m B) ∧
    (MikhlinHormander.CoordinateMikhlinCondition N m B →
      MikhlinHormander.MikhlinCondition N m ((d : ℝ) ^ N * B)) := by
  refine ⟨?_, MikhlinHormander.coordinateMikhlinCondition_to_mikhlinCondition⟩
  intro ⟨hsmooth, hderiv⟩
  refine ⟨hB, hsmooth, fun k hk z hz σ => ?_⟩
  refine (mul_le_mul_of_nonneg_left ?_ (pow_nonneg (norm_nonneg z) k)).trans
    (hderiv k hk z hz)
  simpa only [(EuclideanSpace.basisFun (Fin d) ℝ).orthonormal.norm_eq_one,
    Finset.prod_const_one, mul_one] using
    (iteratedFDeriv ℝ k m z).le_opNorm
      (fun i => EuclideanSpace.basisFun (Fin d) ℝ (σ i))

/-- The Schwartz Fourier model is absolutely convergent, continuous, and invariant
under changes at the origin. -/
theorem schwartzFourier {d : ℕ} (hd : 0 < d) {m : E d → ℂ} {B : ℝ}
    (hm : ContinuousOn m {x | x ≠ 0}) (hB : ∀ z ≠ 0, ‖m z‖ ≤ B)
    (f : Fin d → SchwartzMap (E d) ℂ) :
    (∀ x, Integrable (fourierIntegrand m f x)) ∧ Continuous (twisted m f) ∧
      ∀ m' : E d → ℂ, (∀ z ≠ 0, m z = m' z) → twisted m f = twisted m' f :=
  ⟨(schwartzFourier_convergence hd hm hB f).1, (schwartzFourier_convergence hd hm hB f).2,
    fun _ he => funext (twisted_congr_off_origin hd he f)⟩

